+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn text_checkpoint_key_is_the_historical_fingerprint() {
+        let toks: Vec<u32> = (0..256).map(|i| i * 7 + 3).collect();
+        assert_eq!(
+            checkpoint_fingerprint(&toks, None),
+            prefix_fingerprint(&toks)
