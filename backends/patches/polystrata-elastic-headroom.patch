+        check(e.vram_free_mib()>=256,"KV expansion did not repay borrowed budget");
+        e.trim_kv(e.memory().visible_tokens());
+        for(int fault:{4,3,1,2}) {
+            e.elastic_budget_fault_=0;e.elastic_headroom_blocked_=false;
+            for(int i=0;i<512;++i)e.elastic_tick();
+            if(fault==3){e.shrink_cache(256ULL<<20);e.held_is_budget();}
+            const size_t before=e.arena_.mapped;
+            const auto prior_backoffs=e.elastic_oom_backoffs_;
+            const auto prior_limit=e.elastic_headroom_limit_mib_;
+            e.elastic_budget_fault_=fault;e.elastic_ticks_=256;e.elastic_tick();
+            if(fault==4)check(e.arena_.mapped<before,"physical pressure did not reclaim experts");
+            else if(fault==3) {
