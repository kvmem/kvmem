diff --git a/src/poly/windows_vram.hpp b/src/poly/windows_vram.hpp
new file mode 100644
index 00000000..8647e7d2
--- /dev/null
+++ b/src/poly/windows_vram.hpp
@@ -0,0 +1,78 @@
+#pragma once
+#include <cstdint>
+
+namespace strata::poly {
+struct VramBudget {
+    bool valid = false;
+    int64_t budget = 0, local = 0, shared = 0, physical_free = 0;
+};
+}
+
+#if defined(_WIN32) && !defined(__HIP_PLATFORM_AMD__)
+#ifndef NOMINMAX
+#define NOMINMAX
+#endif
+#include <windows.h>
+#include <dxgi1_4.h>
+#include <cuda.h>
+#include <cstring>
+
+namespace strata::poly {
+// Both sources must identify the CUDA adapter. No GPU-index assumptions and no allocation probes here.
+// DXGI usage belongs to this worker; NVML also sees competing processes on the adapter.
+class WindowsVram {
+    HMODULE dxgi_ = nullptr, nvml_ = nullptr;
+    IDXGIAdapter3* adapter_ = nullptr;
+    void* device_ = nullptr;
+    using Init = int(*)();
+    using Handle = int(*)(const char*,void**);
+    struct Memory { unsigned long long total, free, used; };
+    using Info = int(*)(void*,Memory*);
+    Info info_ = nullptr;
+    Init shutdown_ = nullptr;
+    bool initialized_ = false;
+    int ordinal_;
+public:
+    explicit WindowsVram(int ordinal) : ordinal_(ordinal) {
+        CUdevice dev; char luid[8]{}, bus[32]{}; unsigned mask=0;
+        if(cuDeviceGet(&dev,ordinal)!=CUDA_SUCCESS || cuDeviceGetLuid(luid,&mask,dev)!=CUDA_SUCCESS ||
+           cuDeviceGetPCIBusId(bus,sizeof(bus),dev)!=CUDA_SUCCESS)return;
+        dxgi_=LoadLibraryExA("dxgi.dll",nullptr,LOAD_LIBRARY_SEARCH_SYSTEM32);
+        nvml_=LoadLibraryExA("nvml.dll",nullptr,LOAD_LIBRARY_SEARCH_SYSTEM32);
+        if(!dxgi_ || !nvml_)return;
+        using Factory=HRESULT(WINAPI*)(REFIID,void**);
+        auto create=reinterpret_cast<Factory>(GetProcAddress(dxgi_,"CreateDXGIFactory1"));
+        auto init=reinterpret_cast<Init>(GetProcAddress(nvml_,"nvmlInit_v2"));
+        auto handle=reinterpret_cast<Handle>(GetProcAddress(nvml_,"nvmlDeviceGetHandleByPciBusId_v2"));
+        info_=reinterpret_cast<Info>(GetProcAddress(nvml_,"nvmlDeviceGetMemoryInfo"));
+        shutdown_=reinterpret_cast<Init>(GetProcAddress(nvml_,"nvmlShutdown"));
+        if(!create || !init || !handle || !info_ || !shutdown_ || init()!=0)return;
+        initialized_=true;
+        if(handle(bus,&device_)!=0)return;
+        IDXGIFactory1* factory=nullptr;
+        if(FAILED(create(__uuidof(IDXGIFactory1),reinterpret_cast<void**>(&factory))))return;
+        for(UINT i=0;;++i){
+            IDXGIAdapter1* a=nullptr;if(factory->EnumAdapters1(i,&a)!=S_OK)break;
+            DXGI_ADAPTER_DESC1 d{};
+            if(SUCCEEDED(a->GetDesc1(&d)) && std::memcmp(&d.AdapterLuid,luid,8)==0)
+                a->QueryInterface(__uuidof(IDXGIAdapter3),reinterpret_cast<void**>(&adapter_));
+            a->Release();if(adapter_)break;
+        }
+        factory->Release();
+    }
+    ~WindowsVram(){if(adapter_)adapter_->Release();if(initialized_)shutdown_();if(nvml_)FreeLibrary(nvml_);if(dxgi_)FreeLibrary(dxgi_);}
+    VramBudget sample(int ordinal) const {
+        VramBudget r;DXGI_QUERY_VIDEO_MEMORY_INFO local{},shared{};Memory m{};
+        if(ordinal!=ordinal_ || !adapter_ || !device_ || !info_ ||
+           FAILED(adapter_->QueryVideoMemoryInfo(0,DXGI_MEMORY_SEGMENT_GROUP_LOCAL,&local)) ||
+           FAILED(adapter_->QueryVideoMemoryInfo(0,DXGI_MEMORY_SEGMENT_GROUP_NON_LOCAL,&shared)) ||
+           info_(device_,&m)!=0 || !local.Budget || m.free>m.total)return r;
+        r.valid=true;r.budget=int64_t(local.Budget);r.local=int64_t(local.CurrentUsage);
+        r.shared=int64_t(shared.CurrentUsage);r.physical_free=int64_t(m.free);return r;
+    }
+};
+inline VramBudget windows_vram(int device){static thread_local WindowsVram monitor(device);return monitor.sample(device);}
+}
+#else
+namespace strata::poly { inline VramBudget windows_vram(int){return {};} }
+#endif
