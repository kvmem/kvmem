+                    const auto learned=e.elastic_headroom_limit_mib_;
+                    e.elastic_budget_fault_=0;
+                    for(int i=0;i<512;++i)e.elastic_tick();
+                    check(e.elastic_oom_backoffs_==prior_backoffs+1 && e.elastic_headroom_limit_mib_==learned,
