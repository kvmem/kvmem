+namespace {
+void check(cudaError_t code) { if (code != cudaSuccess) throw std::runtime_error(cudaGetErrorString(code)); }
+template<class T> T* allocate(size_t n) { T* p = nullptr; check(cudaMalloc(&p, n * sizeof(T))); return p; }
+void close(float a, float b, float tolerance, const char* label) {
+    if (!std::isfinite(a) || !std::isfinite(b) || std::abs(a-b) > tolerance * std::max(1.f, std::abs(b)))
+        throw std::runtime_error(label);
+}
+}
+void feedback_reference_test() {
+    constexpr int dim=32,heads=4,kvheads=2,rows=3,count=128,kw=dim*kvheads,qw=dim*heads;
+    std::vector<float> queries(rows*qw),keys(count*kw);
+    for(size_t i=0;i<queries.size();++i)queries[i]=float(int(i%29)-14)/20;
+    for(size_t i=0;i<keys.size();++i)keys[i]=float(int(i%43)-21)/18;
+    auto* dq=allocate<float>(queries.size());auto* dk=allocate<float>(keys.size());
+    auto* hk=allocate<uint16_t>(keys.size());auto* codes=allocate<int8_t>(keys.size());
+    auto* scales=allocate<uint16_t>(keys.size()/32);auto* config=allocate<int64_t>(7);
+    auto* samples=allocate<int32_t>(2);auto* mass=allocate<float>(4);
+    check(cudaMemcpy(dq,queries.data(),queries.size()*4,cudaMemcpyHostToDevice));
+    check(cudaMemcpy(dk,keys.data(),keys.size()*4,cudaMemcpyHostToDevice));
+    const int32_t sample_rows[2]={0,2};
+    check(cudaMemcpy(samples,sample_rows,sizeof(sample_rows),cudaMemcpyHostToDevice));
+    for(bool quantized:{false,true}) {
+        std::vector<float> actual_keys(keys.size());
+        if(quantized) {
