+            std::vector<int8_t> hc(keys.size());std::vector<__half> hs(keys.size()/32);
+            check(cudaMemcpy(hc.data(),codes,hc.size(),cudaMemcpyDeviceToHost));
+            check(cudaMemcpy(hs.data(),scales,hs.size()*2,cudaMemcpyDeviceToHost));
+            for(size_t i=0;i<hc.size();++i)actual_keys[i]=float(hc[i])*__half2float(hs[i/32]);
+        } else {
+            strata::poly::store_f16(dk,hk,kw,0,count,nullptr);
+            std::vector<__half> host(keys.size());
+            check(cudaMemcpy(host.data(),hk,host.size()*2,cudaMemcpyDeviceToHost));
+            for(size_t i=0;i<host.size();++i)actual_keys[i]=__half2float(host[i]);
+        }
