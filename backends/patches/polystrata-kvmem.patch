@@ -0,0 +1,61 @@
+#include "../src/poly/kvmem_sessions.hpp"
+#include <iostream>
+#include <numeric>
+#include <stdexcept>
+
+using namespace strata::poly;
+void check(bool value, const char* message) { if (!value) throw std::runtime_error(message); }
+std::vector<int32_t> prompt(int base) {
+    std::vector<int32_t> ids(128);
+    std::iota(ids.begin(),ids.end(),base);
+    ids.push_back(99999);
+    return ids;
+}
+std::unique_ptr<KvmemSessions::Entry> entry(kvmem::HostKvStorage& storage, uint64_t id, int base) {
+    auto saved = std::make_unique<KvmemSessions::Entry>();
+    kvmem::MemoryStamp stamp{true,{id,1},1,1,128,1};
+    saved->history.bind(stamp);
+    auto ids = prompt(base);
+    saved->history.append(ids.data(),128);
+    auto cp = std::make_shared<KvmemCheckpoint>();
+    cp->identity.stamp = stamp;
+    saved->history.remember(cp);
+    saved->memory.identity.stamp = stamp;
+    saved->memory.archive.push_back(storage.allocate(64));
+    saved->memory.archive.back().seal();
+    return saved;
+}
+int main() {
+    try {
+        kvmem::HostKvStorage shared(192);
+        KvmemSessions cache;
+        cache.configure(2);
+        cache.save(entry(shared,1,1000));
+        cache.save(entry(shared,2,2000));
+        auto pick = cache.choose(prompt(1000),128);
+        check(pick.resume.at == 128 && bool(pick.resume.checkpoint), "idle continuation forgot recurrent restore");
+        auto protected_source = cache.take(pick.slot);
+        check(shared.charged_bytes() == 128, "taking the source lost its RAM charge");
+        cache.save(entry(shared,3,3000));
+        check(shared.charged_bytes() == 192 && cache.payload_bytes() == 128, "active and idle RAM accounts were split");
+        check(cache.evict_one(), "LRU could not reclaim an idle source");
+        check(shared.charged_bytes() == 128, "LRU did not release shared native payload");
+        check(cache.choose(prompt(2000),128).resume.at == 0, "LRU evicted the wrong conversation");
+        check(cache.choose(prompt(3000),128).resume.at == 128, "LRU evicted the newer source");
+        cache.save(std::move(protected_source));
+        cache.save(entry(shared,4,4000));
+        check(cache.parked() == 2 && cache.evictions() == 2, "retained slot limit was not enforced");
+        check(cache.choose(prompt(3000),128).resume.at == 0, "slot pressure did not evict the least recently used source");
+        check(cache.choose(prompt(1000),0).resume.at == 0, "query scope was bypassed by an idle hit");
+        auto invalid = entry(shared,5,5000);
+        ++invalid->memory.identity.stamp.session.incarnation;
+        cache.save(std::move(invalid));
+        check(cache.choose(prompt(5000),128).resume.at == 0, "incompatible idle incarnation was selected");
+        cache.configure(0);
+        check(shared.charged_bytes() == 0 && cache.parked() == 0, "clearing idle sessions leaked RAM records");
+        std::cout << "KVMem retained-session planner and shared quota PASS\n";
+    } catch (const std::exception& e) {
+        std::cerr << e.what() << '\n';
+        return 1;
+    }
+}
diff --git a/tools/test_kvmem_prompt.py b/tools/test_kvmem_prompt.py
new file mode 100644
index 00000000..b0e57b74
--- /dev/null
+++ b/tools/test_kvmem_prompt.py
@@ -0,0 +1,129 @@
+"""Model-free checks that query metadata never changes a rendered prompt."""
+import sys
+import unittest
+from pathlib import Path
+from types import SimpleNamespace
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+from serve import kvmem
+from serve.frontend import LITERAL_TAGS
+
+
+class Tokenizer:
+    def encode(self, text, parse_special=True, plain=()):
+        return list(text.encode("utf-8"))
+
+
+class Service:
+    literals = LITERAL_TAGS
+    tok = Tokenizer()
+
+    def __init__(self, trim=False):
+        self.trim = trim
+
+    def render_prompt(self, messages, tools, kwargs):
+        out = []
+        for message in messages:
+            body = message.get("content", "")
+            if isinstance(body, list):
+                body = "".join(p.get("text", "") for p in body)
+            out.append(message["role"] + "\n" + (body.strip() if self.trim else body) + "\nEND\n")
+        return "".join(out) + "assistant\n"
+
+
+class QueryTest(unittest.TestCase):
+    def query(self, messages, expected, trim=False):
+        service = Service(trim)
+        prompt = kvmem.encode(service, messages, None, {})
+        self.assertEqual(prompt, service.tok.encode(service.render_prompt(messages, None, {})))
+        first, last = prompt.kvmem_query
+        self.assertEqual(bytes(prompt[first:last]).decode(), expected)
+        return prompt
+
+    def test_tool_continuation_cannot_reselect_with_explicit_old_user_range(self):
+        service=Service()
+        messages=[{"role":"user","content":"old question"},{"role":"tool","content":"result"}]
+        ids=kvmem.encode(service,messages,None,{})
+        self.assertEqual(ids.kvmem_query,(0,0))
+        self.assertEqual(ids[:].kvmem_query,(0,0))
+        for spec in ({"message":0,"start":0,"end":3},{"tokens":[1,2]}):
+            with self.subTest(spec=spec),self.assertRaises(ValueError):
+                kvmem.resolve_query(service,messages,None,{},ids,spec)
+
+    def test_last_user_and_duplicate_text(self):
+        self.query([{"role": "system", "content": "same"}, {"role": "user", "content": "old"},
+                    {"role": "assistant", "content": "same"}, {"role": "user", "content": "same"}], "same")
+
+    def test_unicode_and_template_trim(self):
+        self.query([{"role": "user", "content": "  中文查询  "}], "中文查询", trim=True)
+
+    def test_text_parts(self):
+        self.query([{"role": "user", "content": [{"type": "text", "text": "a"},
+                    {"type": "text", "text": "b"}]}], "ab")
+
+    def test_tool_continuation(self):
+        prompt = self.query([{"role": "user", "content": "question"},
+                            {"role": "assistant", "content": "call"}, {"role": "tool", "content": "result"}], "")
+        self.assertEqual((prompt + [1, 2]).kvmem_query, prompt.kvmem_query)
+        first, last = prompt.kvmem_query
+        self.assertEqual(prompt[first:last].kvmem_query, (0, last - first))
+
+    def test_images_and_empty_query_rejected(self):
+        for content in ("", [], [{"type": "image", "source": "x"}]):
+            with self.assertRaises(ValueError):
+                kvmem.encode(Service(), [{"role": "user", "content": content}], None, {})
+
+    def test_mode_detection_survives_restart(self):
+        self.assertTrue(kvmem.enabled(SimpleNamespace(info={}, spawn=("worker", ["--kvmem-budget", "128"]))))
+        self.assertFalse(kvmem.enabled(SimpleNamespace(info={}, spawn=("worker", ["--kvmem-budget", "0"]))))
+        self.assertFalse(kvmem.enabled(SimpleNamespace(info={}, spawn=None)))
+
+    def test_explicit_unicode_range_does_not_change_prompt(self):
+        messages = [{"role":"user", "content":"中文文档：问题也曾出现在这里。\n\n真正的问题是什么？"}]
+        service = Service()
+        ids = kvmem.encode(service, messages, None, {})
+        start = messages[0]["content"].index("真正")
+        selected = kvmem.resolve_query(service, messages, None, {}, ids,
+                                       {"message":0, "start":start, "end":len(messages[0]["content"])})
+        self.assertEqual(selected, ids)
+        self.assertEqual(bytes(selected[slice(*selected.kvmem_query)]).decode(), "真正的问题是什么？")
+        self.assertEqual(ids.kvmem_query, kvmem.encode(service, messages, None, {}).kvmem_query)
+        by_tokens = kvmem.resolve_query(service, messages, None, {}, ids, {"tokens":list(selected.kvmem_query)})
+        self.assertEqual(by_tokens.kvmem_query, selected.kvmem_query)
+
+    def test_explicit_trimmed_string(self):
+        service = Service(trim=True)
+        messages = [{"role":"user", "content":"  document\nquestion  "}]
+        ids = kvmem.encode(service, messages, None, {})
+        selected = kvmem.resolve_query(service, messages, None, {}, ids, {"message":0,"start":11,"end":19})
+        self.assertEqual(selected, ids)
+        self.assertEqual(bytes(selected[slice(*selected.kvmem_query)]).decode(), "question")
+
+    def test_invalid_explicit_ranges(self):
+        service = Service()
+        messages = [{"role":"system", "content":"document"}, {"role":"user", "content":"question"}]
+        ids = kvmem.encode(service, messages, None, {})
+        for spec in (None, {}, {"message":0,"start":0,"end":2}, {"message":1,"start":0,"end":9},
+                     {"message":1,"start":1,"end":1}, {"message":True,"start":0,"end":2},
+                     {"message":1,"start":0,"end":2,"extra":0}, {"tokens":[0,2]},
+                     {"tokens":[True,2]}, {"tokens":[ids.kvmem_query[0],ids.kvmem_query[0]]}):
+            with self.subTest(spec=spec), self.assertRaises(ValueError):
+                kvmem.resolve_query(service, messages, None, {}, ids, spec)
+
+    def test_literal_tags_and_emoji_offsets(self):
+        service = Service()
+        content = "😀document\n<think>literal</think>"
+        messages = [{"role":"user","content":content}]
+        ids = kvmem.encode(service, messages, None, {})
+        start = content.index("<think>")
+        selected = kvmem.resolve_query(service, messages, None, {}, ids,
+                                       {"message":0,"start":start,"end":len(content)})
+        self.assertEqual(selected, ids)
+        self.assertEqual(bytes(selected[slice(*selected.kvmem_query)]).decode(), "<think>literal</think>")
+        with self.assertRaises(ValueError):
+            kvmem.resolve_query(service, messages, None, {}, ids,
+                                {"message":0,"start":start+1,"end":len(content)})
+
+
+if __name__ == "__main__":
+    unittest.main()
