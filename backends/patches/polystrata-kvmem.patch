diff --git a/src/poly/kvmem_sessions.hpp b/src/poly/kvmem_sessions.hpp
new file mode 100644
index 00000000..898128e3
--- /dev/null
+++ b/src/poly/kvmem_sessions.hpp
@@ -0,0 +1,83 @@
+// Idle histories share KvmemMemory's RAM account. Only resume() knows Engine;
+// prefix choice, slot limits, ownership and LRU eviction are model-free.
+#pragma once
+#include "kvmem_history.hpp"
+#include <limits>
+
+namespace strata::poly {
+class KvmemSessions {
+public:
+    struct Entry {
+        KvmemHistory history;
+        KvmemParked memory;
+        uint64_t used = 0;
+    };
+    struct Choice {
+        size_t slot = SIZE_MAX;
+        KvmemHistory::Resume resume;
+    };
+    void configure(size_t idle_slots) {
+        if (idle_slots > 15) throw std::logic_error("KVMem supports at most 16 retained histories");
+        slots_ = idle_slots;
+        entries_.reserve(slots_);
+        while (entries_.size() > slots_) evict_one();
+    }
+    Choice choose(const std::vector<int32_t>& ids, int64_t query_begin) const {
+        Choice best;
+        for (size_t i = 0; i < entries_.size(); ++i) {
+            auto candidate = entries_[i]->history.choose(ids, query_begin, entries_[i]->memory.identity.stamp);
+            if (candidate.at > best.resume.at) {
+                // An idle frontier is not live GPU state. Even an exact
+                // continuation needs its saved recurrent checkpoint.
+                if (!candidate.checkpoint) candidate.checkpoint = entries_[i]->history.latest();
+                if (candidate.checkpoint) best = {i, std::move(candidate)};
+            }
+        }
+        return best;
+    }
+    size_t observed_prefix(const std::vector<int32_t>& ids) const {
+        size_t common = 0;
+        for (const auto& entry : entries_) common = std::max(common, entry->history.observed_prefix(ids));
+        return common;
+    }
+    std::unique_ptr<Entry> take(size_t slot) {
+        if (slot >= entries_.size()) throw std::logic_error("KVMem idle slot disappeared");
+        auto entry = std::move(entries_[slot]);
+        entries_.erase(entries_.begin()+std::ptrdiff_t(slot));
+        return entry;
+    }
+    void save(std::unique_ptr<Entry> entry) {
+        if (!slots_) return;
+        while (entries_.size() >= slots_) evict_one();
+        entry->used = ++clock_;
+        entries_.push_back(std::move(entry));
+    }
+    bool evict_one() {
+        if (entries_.empty()) return false;
+        const auto oldest = std::min_element(entries_.begin(), entries_.end(), [](const auto& a, const auto& b) {
+            return a->used < b->used;
+        });
+        entries_.erase(oldest);
+        ++evictions_;
+        return true;
+    }
+    uint64_t payload_bytes() const {
+        uint64_t bytes = 0;
+        for (const auto& entry : entries_) bytes += entry->memory.payload_bytes();
+        return bytes;
+    }
+    size_t parked() const noexcept { return entries_.size(); }
+    size_t evictions() const noexcept { return evictions_; }
+    size_t restores() const noexcept { return restores_; }
+    size_t skipped() const noexcept { return skipped_; }
+    int64_t resume(Engine&, KvmemHistory&, const std::vector<int32_t>&, int64_t query_begin, uint64_t total_tokens);
+    void metrics(const KvmemMemory&) const;
+    bool make_archive_room(const KvmemMemory&);
+private:
+    void admit_active(const KvmemMemory&, uint64_t total_tokens);
+    size_t slots_ = 0, evictions_ = 0, restores_ = 0, skipped_ = 0;
+    uint64_t clock_ = 0;
+    std::vector<std::unique_ptr<Entry>> entries_;
+};
+} // namespace strata::poly
