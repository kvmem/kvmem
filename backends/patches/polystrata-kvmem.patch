diff --git a/serve/kvmem.py b/serve/kvmem.py
new file mode 100644
index 00000000..8b4ecca2
--- /dev/null
+++ b/serve/kvmem.py
@@ -0,0 +1,164 @@
+"""Exact frontend query spans for the opt-in KVMem worker."""
+from __future__ import annotations
+
+import copy
+import uuid
+
+
+def enabled(engine) -> bool:
+    if (getattr(engine, "info", {}) or {}).get("kvmem") in (1, "1"):
+        return True
+    try:
+        args = getattr(engine, "spawn", (None, []))[1]
+        return int(args[args.index("--kvmem-budget") + 1]) > 0
+    except (ValueError, IndexError, TypeError, AttributeError, KeyError):
+        return False
+
+
+class Prompt(list):
+    """Request-local metadata survives appended generation-control tokens."""
+    def __init__(self, ids, query):
+        super().__init__(ids)
+        self.kvmem_query = tuple(query)
+
+    def __add__(self, tail):
+        return Prompt(super().__add__(tail), self.kvmem_query)
+
+    def __getitem__(self, key):
+        result = super().__getitem__(key)
+        if isinstance(key, slice):
+            first, last, step = key.indices(len(self))
+            begin, end = self.kvmem_query
+            if step==1 and begin==end==0:
+                return Prompt(result,(0,0))
+            if step == 1 and first <= begin < end <= last:
+                return Prompt(result, (begin - first, end - first))
+        return result
+
+
+def _common(a, b):
+    i = 0
+    while i < min(len(a), len(b)) and a[i] == b[i]:
+        i += 1
+    return i
+
+
+def _bounds(service, original, first, last, ids):
+    from .frontend import unmark_think_literals
+    def tokenize(text):
+        plain_text, plain = unmark_think_literals(text, service.literals)
+        return service.tok.encode(plain_text, parse_special=True, plain=plain)
+    prefix = tokenize(original[:first])
+    through = tokenize(original[:last])
+    begin, end = _common(ids, prefix), _common(ids, through)
+    if end < len(through):
+        end += 1
+    if not 0 <= begin < end <= len(ids):
+        raise ValueError("the tokenizer cannot prove a nonempty KVMem query span")
+    return begin, end
+
+
+def resolve_query(service, messages, tools, kwargs, ids, spec):
+    """Explicit, half-open last-user character or rendered-token range.
+
+    Only query metadata changes: the actual rendered prompt and its token IDs
+    remain identical. Character indices count Unicode code points, not bytes.
+    """
+    from .frontend import mark_think_literals
+    if not messages or messages[-1].get("role")!="user":
+        raise ValueError("tool/assistant continuation has no new user Query")
+    if not isinstance(spec, dict):
+        raise ValueError("kvmem_query must be a range object")
+    if set(spec) == {"tokens"}:
+        span = spec["tokens"]
+        if not isinstance(span, list) or len(span) != 2 or any(type(x) is not int for x in span):
+            raise ValueError("kvmem_query.tokens must be [begin, end] integer token indices")
+        first, last = ids.kvmem_query
+        if not first <= span[0] < span[1] <= last:
+            raise ValueError("kvmem_query.tokens must be nonempty and within the last user message")
+        return Prompt(ids, span)
+    if set(spec) != {"message", "start", "end"} or any(type(spec[k]) is not int for k in spec):
+        raise ValueError("kvmem_query requires integer message/start/end, or a tokens range")
+    user = next((i for i in range(len(messages)-1, -1, -1) if messages[i].get("role") == "user"), None)
+    if spec["message"] != user:
+        raise ValueError("kvmem_query.message must identify the last user message")
+    content = messages[user].get("content")
+    if not isinstance(content, str):
+        raise ValueError("character query ranges require string user content; use tokens for text parts")
+    start, end = spec["start"], spec["end"]
+    if not 0 <= start < end <= len(content) or not content[start:end].strip():
+        raise ValueError("kvmem_query character range is empty or outside the user content")
+    marked, marked_tools, _ = mark_think_literals(messages, tools, service.literals)
+    original = service.render_prompt(marked, marked_tools, kwargs)
+    tag = uuid.uuid4().hex
+    bm, em = f"\x01kvmem-begin-{tag}\x01", f"\x01kvmem-end-{tag}\x01"
+    for trim in (False, True):
+        body = content.strip() if trim else content
+        left = len(content) - len(content.lstrip()) if trim else 0
+        a, b = max(0, start-left), min(len(body), end-left)
+        if a >= b:
+            continue
+        probe = copy.deepcopy(messages)
+        probe[user]["content"] = body[:a] + bm + body[a:b] + em + body[b:]
+        guarded, guarded_tools, _ = mark_think_literals(probe, tools, service.literals)
+        rendered = service.render_prompt(guarded, guarded_tools, kwargs)
+        if rendered.count(bm) != 1 or rendered.count(em) != 1:
+            continue
+        first, last = rendered.index(bm), rendered.index(em)-len(bm)
+        if rendered.replace(bm, "", 1).replace(em, "", 1) != original:
+            continue
+        return Prompt(ids, _bounds(service, original, first, last, ids))
+    raise ValueError("the template cannot prove an unchanged explicit KVMem query; do not split literal control tags")
+
+
+def encode(service, messages, tools, kwargs):
+    from .frontend import mark_think_literals, unmark_think_literals
+
+    marked, marked_tools, _ = mark_think_literals(messages, tools, service.literals)
+    if messages and messages[-1].get("role")!="user":
+        original=service.render_prompt(marked,marked_tools,kwargs)
+        text,plain=unmark_think_literals(original,service.literals)
+        return Prompt(service.tok.encode(text,parse_special=True,plain=plain),(0,0))
+    user = next((i for i in range(len(marked) - 1, -1, -1) if marked[i].get("role") == "user"), None)
+    if user is None:
+        raise ValueError("KVMem retrieval needs a user message")
+    content = marked[user].get("content")
+    if isinstance(content, list):
+        text_parts = [i for i, part in enumerate(content) if part.get("text")]
+        if not text_parts:
+            raise ValueError("KVMem query needs text beside the image")
+    elif not isinstance(content, str) or not content.strip():
+        raise ValueError("KVMem query must contain text")
+
+    original = service.render_prompt(marked, marked_tools, kwargs)
+    tag = uuid.uuid4().hex
+    begin_marker, end_marker = f"\x01kvmem-begin-{tag}\x01", f"\x01kvmem-end-{tag}\x01"
+    rendered = None
+    for trim in (False, True):
+        probe = copy.deepcopy(marked)
+        if isinstance(content, str):
+            body = content.strip() if trim else content
+            probe[user]["content"] = begin_marker + body + end_marker
+        else:
+            first, last = text_parts[0], text_parts[-1]
+            probe[user]["content"][first]["text"] = begin_marker + probe[user]["content"][first]["text"]
+            probe[user]["content"][last]["text"] += end_marker
+        candidate = service.render_prompt(probe, marked_tools, kwargs)
+        if candidate.count(begin_marker) != 1 or candidate.count(end_marker) != 1:
+            continue
+        first, last = candidate.index(begin_marker), candidate.index(end_marker)
+        clean = candidate.replace(begin_marker, "", 1).replace(end_marker, "", 1)
+        if clean == original and last > first + len(begin_marker):
+            rendered = (first, last - len(begin_marker))
+            break
+    if rendered is None:
+        raise ValueError("the chat template cannot prove an unchanged KVMem user-query span")
+
+    def tokenize(text):
+        plain_text, plain = unmark_think_literals(text, service.literals)
+        return service.tok.encode(plain_text, parse_special=True, plain=plain)
+
+    ids = tokenize(original)
+    # BPE can merge text on either side of a character boundary. Include the
+    # boundary token that contains query text rather than changing the prompt.
+    return Prompt(ids, _bounds(service, original, *rendered, ids))
diff --git a/serve/kvmem_monitor.py b/serve/kvmem_monitor.py
new file mode 100644
index 00000000..0406723c
--- /dev/null
+++ b/serve/kvmem_monitor.py
@@ -0,0 +1,140 @@
+"""Read-only KVMem monitor schema; no prompts, answers or reasoning are exposed."""
+import math
+import os
+import re
+import threading
+import time
+
+
+def number(value):
+    return isinstance(value, (int, float)) and not isinstance(value, bool) and math.isfinite(value)
+
+
+def execution(service):
+    device = getattr(service, 'kvmem_monitor_gpu_uuid', None)
+    return {'mode': 'single', 'monitor_devices': [{'uuid': device}]} if device else {}
+
+
+class StorageLog:
+    """Bounded incremental reads of native counters, including partial log lines."""
+    def __init__(self):
+        self.lock = threading.Lock()
+        self.key = None
+        self.pos = 0
+        self.values = {}
+        self.sampled_at_ms = None
+
+    def poll(self, engine):
+        path, start = getattr(engine, 'log_path', None), getattr(engine, 'log_start', 0) or 0
+        if not path:
+            return {}
+        with self.lock:
+            if self.key != (path, start):
+                self.key, self.pos, self.values = (path, start), start, {}
+                self.sampled_at_ms = None
+            try:
+                size = os.path.getsize(path)
+                if size < self.pos:
+                    self.pos, self.values = 0, {}
+                    self.sampled_at_ms = None
+                skipped = size - self.pos > 262144
+                self.pos = max(self.pos, size - 262144)
+                with open(path, 'rb') as stream:
+                    stream.seek(self.pos)
+                    data = stream.read(min(262144, size - self.pos))
+            except OSError:
+                return dict(self.values)
+            end = data.rfind(b'\n') + 1
+            self.pos += end
+            lines = data[:end].decode('utf-8', 'replace').splitlines()
+            for line in lines[1:] if skipped else lines:
+                if line.startswith(('KVMEM_STORAGE ', 'KVMEM_SESSIONS ')):
+                    self.values.update({k: int(v) for k, v in re.findall(r'(\w+)=(\d+)', line)})
+                    self.sampled_at_ms = time.time() * 1000
+            return dict(self.values)
+
+
+def snapshot(service):
+    now = time.time()
+    with service.status_lock:
+        live = [(dict(st), list(rate)) for st, rate in service.live_reqs.values()]
+        if not live and service.status.get('busy'):
+            live = [(dict(service.status), list(service.rate))]
+        history = list(service.history)
+        totals = dict(service.totals)
+        queued = service.status.get('queued', 0)
+    active = []
+    solo = not getattr(service.engine, 'batch', 0)
+    for st, rate in live:
+        started = st.get('started', now)
+        generating = st.get('first_token') is not None
+        count = st.get('generated', 0)
+        active.append({'id': st.get('kvmem_monitor_id', str(started)),
+                       'client_request_id': st.get('kvmem_client_request_id'),
+                       'started_at_ms': started * 1000, 'elapsed_ms': max(0, (now-started)*1000),
+                       'status': 'generating' if generating else 'reading', 'phase': st.get('phase'),
+                       'endpoint': 'generation', 'prompt_tokens': st.get('prompt_tokens'),
+                       'generated_tokens': count,
+                       'cached_tokens': getattr(service.engine, 'reused', None) if solo and generating else None,
+                       'limit': st.get('max_tokens'),
+                       'ttft_ms': (st['first_token']-started)*1000 if generating else None,
+                       'ttft_scope': 'execution',
+                       'prefill_ms': getattr(service.engine, 'progress_ms', None) if solo else None,
+                       'decode_tps': service._rate_of(st, rate) if generating and count > 1 else None,
+                       'decode_tps_mean': count / max(1e-6, now-st['first_token']) if generating and count > 1 else None,
+                       'prefill_tps': getattr(service.engine, 'prefill_tok_s_mean', None) if solo else None})
+    recent = []
+    for row in reversed(history):
+        started = row['time']
+        generated = row.get('output_tokens')
+        read, ms = row.get('prompt_read'), row.get('prompt_ms')
+        finish = row.get('finish')
+        recent.append({'id': row.get('kvmem_monitor_id') or str(started),
+                       'client_request_id': row.get('kvmem_client_request_id'),
+                       'started_at_ms': started*1000, 'elapsed_ms': row.get('duration_s', 0)*1000,
+                       'status': 'error' if finish == 'error' else 'disconnected' if finish in ('disconnect', 'cancelled', 'cancel') else 'completed',
+                       'finish_reason': finish, 'finish_phase': row.get('finish_phase'),
+                       'ttft_ms': row.get('ttft_ms'), 'ttft_scope': 'execution',
+                       'prefill_ms': ms, 'prompt_new_tokens': read,
+                       'drafts_offered': row.get('drafts_offered'), 'drafts_accepted': row.get('drafts_accepted'),
+                       'expert_hit_rate': row.get('hit_rate'),
+                       'endpoint': 'generation', 'limit': row.get('kvmem_monitor_limit'),
+                       'prompt_tokens': row.get('prompt_tokens'), 'cached_tokens': row.get('reused'),
+                       'generated_tokens': generated,
+                       'decode_tps': 0 if number(generated) and generated <= 1 else row.get('decode_tok_s'),
+                       'decode_tps_mean': 0 if number(generated) and generated <= 1 else row.get('decode_tok_s'),
+                       'prefill_tps': read*1000/ms if number(read) and number(ms) and ms > 0 else None})
+    telemetry = getattr(service, 'telemetry', None)
+    tel = telemetry.snapshot() if telemetry else {}
+    raw, static = tel.get('now', {}), tel.get('static', {})
+    device = getattr(service, 'kvmem_monitor_gpu_uuid', None)
+    gpu = {'uuid': device, 'name': static.get('gpu_name')}
+    for target, source in {'utilization_percent':'gpu_util', 'used_bytes':'gpu_mem_used',
+                           'total_bytes':'gpu_mem_total', 'temperature_c':'gpu_temp', 'power_w':'gpu_power',
+                           'pcie_generation':'gpu_pcie_gen', 'pcie_width':'gpu_pcie_width'}.items():
+        gpu[target] = raw.get(source)
+    rx = raw.get('gpu_pcie_rx_mb')
+    gpu['pcie_rx_bytes_per_second'] = rx*1048576 if number(rx) else None
+    hardware = {'sampled_at_ms': tel.get('sampled_at_ms'), 'cpu_percent': raw.get('cpu'),
+                'ram_used_bytes': raw.get('ram_used'), 'ram_total_bytes': raw.get('ram_total'),
+                'ram_available_bytes': raw['ram_total']-raw['ram_used'] if number(raw.get('ram_total')) and number(raw.get('ram_used')) else None,
+                'system_disk_read_bytes_per_second': raw['disk_read_mb']*1048576 if number(raw.get('disk_read_mb')) else None,
+                'gpus': [gpu] if device else []}
+    counters = service.kvmem_monitor_log.poll(service.engine)
+    info = getattr(service.engine, 'info', {}) or {}
+    usage = {target: counters.get(source) for target, source in {
+        'host_payload_bytes':'host_bytes', 'disk_payload_bytes':'disk_bytes',
+        'disk_read_bytes':'read_bytes', 'disk_written_bytes':'written_bytes'}.items()}
+    usage.update(sampled_at_ms=service.kvmem_monitor_log.sampled_at_ms,
+                 sampling_scope='request_end',
+                 host_payload_budget_bytes=int(info.get('kvmem_host_mib', 0))*1048576,
+                 disk_payload_budget_bytes=int(info.get('kvmem_disk_mib', 0))*1048576,
+                 retained_sessions=counters.get('parked') if solo else None,
+                 history_evictions=counters.get('evictions') if solo else None,
+                 history_hits=counters.get('restores') if solo else None)
+    if info.get('ssd') in (0, '0'):
+        usage.update(disk_payload_bytes=0, disk_read_bytes=0, disk_written_bytes=0)
+    return {'schema_version': 1, 'backend': 'polystrata', 'server_instance': str(service.started_at),
+            'sampled_at_ms': now*1000, 'active': active, 'recent': recent, 'queued_count': queued,
+            'dropped_records': max(0, totals.get('requests', 0)-len(history)),
+            'hardware': hardware, 'kvmem': usage}
