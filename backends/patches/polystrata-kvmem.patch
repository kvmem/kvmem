+                                            nullptr, nullptr, 1, at+1);
+        strata::poly::store_f16_at(b, cache, width, at, 1, 0, stream);
+        strata::poly::kvmem_key_sums(r, s, width, 1, 0, 0, groups, stream, at+1);
+        check(cudaStreamEndCapture(stream, &graph));
+        check(cudaGraphInstantiate(&executable, graph, nullptr, nullptr, 0));
+        for (auto positions : {std::vector<long long>{0, 1000}, std::vector<long long>{128, 30000}}) {
+            check(cudaMemsetAsync(s, 0, groups * width * sizeof(float), stream));
+            check(cudaMemcpyAsync(at, positions.data(), 2 * sizeof(long long), cudaMemcpyHostToDevice, stream));
+            check(cudaGraphLaunch(executable, stream));
+            check(cudaStreamSynchronize(stream));
+            strata::poly::head_norm_rope(x, dim, w, a, dim, heads, 64, 0.9f, positions[1], 1, 1e-6f, nullptr);
+            check(cudaMemcpy(native.data(), a, width * sizeof(float), cudaMemcpyDeviceToHost));
+            check(cudaMemcpy(rotated.data(), b, width * sizeof(float), cudaMemcpyDeviceToHost));
+            for (int d = 0; d < width; ++d) close(rotated[d], native[d], 2e-6f, "graph used a compact RoPE position");
+            std::vector<uint16_t> expected(width), actual(width);
+            strata::poly::store_f16(a, cache, width, 255, 1, nullptr);
+            check(cudaMemcpy(expected.data(), cache+255*width, width*sizeof(uint16_t), cudaMemcpyDeviceToHost));
+            check(cudaMemcpy(actual.data(), cache+positions[0]*width, width*sizeof(uint16_t), cudaMemcpyDeviceToHost));
+            if (actual != expected) throw std::runtime_error("graph wrote KV to an original rather than compact row");
+        }
+        cudaGraphExecDestroy(executable); cudaGraphDestroy(graph); cudaStreamDestroy(stream);
+        for (auto p : {x,w,a,b,r,s,q}) cudaFree(p);
+        cudaFree(at); cudaFree(cache);
+        {
+            // Packing must omit unused groups and preserve both layer and
+            // partial-block coordinates, including a non-warp-aligned width.
+            constexpr int width=37,groups=2,layers=3,source_groups=5;
+            std::vector<float> source(width*source_groups*layers),packed(width*groups*layers);
+            for(size_t i=0;i<source.size();++i)source[i]=float(i);
+            float *device=nullptr,*compact=nullptr;
+            check(cudaMalloc(&device,source.size()*sizeof(float)));
+            check(cudaMalloc(&compact,packed.size()*sizeof(float)));
+            check(cudaMemcpy(device,source.data(),source.size()*sizeof(float),cudaMemcpyHostToDevice));
+            strata::poly::kvmem_pack_key_sums(device,compact,width,groups,layers,source_groups,nullptr);
+            check(cudaMemcpy(packed.data(),compact,packed.size()*sizeof(float),cudaMemcpyDeviceToHost));
+            for(int layer=0;layer<layers;++layer)for(int i=0;i<width*groups;++i)
+                if(packed[layer*width*groups+i]!=source[layer*width*source_groups+i])
+                    throw std::runtime_error("packed MeanK statistics changed layer/group layout");
+            cudaFree(device);cudaFree(compact);
+        }
+        std::puts("PASS: normalized capture, partial blocks, query spans, independent graph positions, F16/Q8 causal page-mass reference, packed MeanK layout");
+        return 0;
+    } catch (const std::exception& error) { std::fprintf(stderr, "%s\n", error.what()); return 1; }
+}
diff --git a/tools/poly_kvmem_mtp_test.cpp b/tools/poly_kvmem_mtp_test.cpp
new file mode 100644
index 00000000..e918edf8
--- /dev/null
+++ b/tools/poly_kvmem_mtp_test.cpp
@@ -0,0 +1,170 @@
+#include "../src/poly/engine.hpp"
+#include <algorithm>
+#include <cmath>
+#include <cstring>
+#include <cstdlib>
+#include <filesystem>
+#include <iostream>
+#include <stdexcept>
+#include <vector>
+#include <cuda_fp16.h>
+
+using namespace strata::poly;
+namespace strata::poly {
+struct KvmemTestAccess {
+    static std::vector<uint8_t> kv(KvmemMemory& m) {
+        std::vector<uint8_t> bytes(m.visible_ * (m.descriptor_.layout.record_bytes/KvmemMemory::block_tokens));
+        m.save_view(bytes.data());
+        return bytes;
+    }
+    static std::vector<float> means(KvmemMemory& m) {
+        std::vector<float> values(m.versions_.size() * m.planes_.size() * m.key_width_);
+        for (uint32_t b = 0; b < m.versions_.size(); ++b)
+            for (uint32_t il = 0; il < m.planes_.size(); ++il)
+                m.statistics_->mean_k(b,il,values.data()+(b*m.planes_.size()+il)*m.key_width_);
+        return values;
+    }
+    static void diagnose(KvmemMemory& m,const std::vector<uint8_t>& a,const std::vector<uint8_t>& b) {
+        size_t offset=0;
+        for(const auto& plane:m.descriptor_.layout.planes) {
+            const size_t size=m.visible_*plane.token_stride;
+            size_t different=0,first=0;float worst=0;
+            for(size_t i=0;i<size;++i)if(a[offset+i]!=b[offset+i]) {if(!different)first=i;++different;}
+            if(m.descriptor_.layout.format.find("f16")!=std::string::npos)
+                for(size_t i=0;i+1<size;i+=2) {__half x,y;std::memcpy(&x,a.data()+offset+i,2);std::memcpy(&y,b.data()+offset+i,2);worst=std::max(worst,std::abs(__half2float(x)-__half2float(y)));}
+            if(different)std::cerr<<"KV_DELTA layer="<<plane.layer<<" kind="<<int(plane.kind)<<" bytes="<<different<<" first_row="<<first/plane.token_stride<<" first_byte="<<first%plane.token_stride<<" f16_max_abs="<<worst<<'\n';
+            offset+=size;
+        }
+    }
+    static void make_cold(KvmemMemory& m) { m.storage_->trim(0); }
+};
+}
+void check(bool ok, const char* message) { if (!ok) throw std::runtime_error(message); }
+void close(const std::vector<float>& a, const std::vector<float>& b, const char* label) {
+    check(a.size() == b.size(),"float comparison shape changed");
+    float worst = 0;
+    for (size_t i=0; i<a.size(); ++i) {
+        const float relative = std::abs(a[i]-b[i])/std::max({1.f,std::abs(a[i]),std::abs(b[i])});
+        if (!std::isfinite(relative) || relative > 2e-5f)
+            throw std::runtime_error(std::string(label)+" differs at "+std::to_string(i)+" by "+std::to_string(relative));
+        worst = std::max(worst,relative);
+    }
+    std::cout << label << " max_relative=" << worst << '\n';
+}
+std::vector<float> floats(const std::vector<uint8_t>& bytes) {
+    std::vector<float> result(bytes.size()/sizeof(float));
+    std::memcpy(result.data(),bytes.data(),bytes.size());
+    return result;
+}
+int main(int argc,char** argv) {
+    try {
+        if (argc < 2) throw std::runtime_error(
+            "usage: poly_kvmem_mtp_test MODEL.gguf [--window 2..4] [--no-graphs] [--disk-path DIR]");
+        bool one_case=false;
+        Options opt;
+        opt.model=argv[1]; opt.max_context=1024; opt.threads=8; opt.stage_mib=512;
+        opt.prompt_batch=64; opt.window=4; opt.draft=true; opt.expert_swaps=0;
+        opt.graphs=true;
+        opt.memory.budget=128; opt.memory.reserve=64; opt.memory.host_mib=1024;
+        opt.memory.verify=true; opt.memory.mtp=true;
+        for (int i=2;i<argc;++i) {
+            const std::string arg=argv[i];
+            if(arg=="--one-case")one_case=true;
+            else if (arg == "--no-graphs") opt.graphs=false;
+            else if(arg=="--q8")opt.kv_format=KvFmt::kQ8_0;
+            else if (arg == "--window" && i+1 < argc) {
+                opt.window=std::atoi(argv[++i]);
+                if (opt.window < 2 || opt.window > 4) throw std::runtime_error("--window must be 2..4");
+            }
+            else if (arg == "--disk-path" && i+1 < argc) {
+                opt.memory.disk_path=argv[++i]; opt.memory.disk_mib=64; opt.memory.host_mib=8;
+                std::filesystem::create_directories(std::filesystem::u8path(opt.memory.disk_path));
+            } else throw std::runtime_error("unknown or incomplete argument: "+arg);
+        }
+        auto engine=Engine::open(opt);
+        check(engine->drafts(),"model has no usable MTP block");
+        auto prefix=[&](int length) {
+            engine->reset();
+            std::vector<int32_t> tokens(length);
+            for (int i=0;i<length;++i) tokens[i]=100+i%32;
+            for (int at=0;at<length;at+=64) engine->eval(tokens.data()+at,std::min(64,length-at),false);
+        };
+        // Known token plus up to three forced guesses. Acceptance is deliberately
+        // independent of the model's guesses so every accepted-prefix branch runs.
+        const int32_t w[4]={1000,1001,1002,1003};
+        struct Case { int prefix, window, accepted; };
+        const Case cases[]={{63,2,1},{191,2,2},{63,4,4},{191,4,1},{191,4,2},{191,4,3},{319,4,4}};
+        const auto draft=[&](int window) {
+            for (int i=0;i<window-1;++i) { float p=0; engine->draft(w[i],i,&p); }
+        };
+        bool fault_seen=false;
+        for (const auto test : cases) {
+            if (test.window > opt.window) continue;
+            const int length=test.prefix, accepted=test.accepted, window=test.window;
+            prefix(length);
+            const auto before=engine->memory().stamp().frontier;
+            draft(window);
+            check(engine->memory().stamp().frontier == before,"draft advanced accepted frontier");
+            engine->window(w,window);
+            check(engine->memory().stamp().frontier == before,"window published provisional tokens");
+            bool rejected=false;
+            try { engine->memory().checkpoint(); } catch (const std::exception&) { rejected=true; }
+            check(rejected,"checkpoint accepted a provisional recurrent state");
+            try { engine->keep(accepted); }
+            catch (const std::exception& e) {
+                if (std::string(e.what()).find("accept") == std::string::npos) throw;
+                fault_seen=true;
+                check(!engine->memory().stamp().valid,"failed acceptance stayed valid");
+                prefix(length); draft(window); engine->window(w,window); engine->keep(accepted);
+            }
+            check(engine->pos() == length+accepted && engine->memory().stamp().frontier == uint64_t(length+accepted),
+                  "keep committed rejected tokens or omitted accepted ones");
+            const auto speculative=engine->memory().checkpoint();
+            const auto kv=KvmemTestAccess::kv(engine->memory());
+            const auto means=KvmemTestAccess::means(engine->memory());
+            const auto selected=engine->memory().selected();
+            prefix(length);
+            engine->memory().before(opt.window); // same view as MTP's maximum-window reservation
+            for (int i=0;i<accepted;++i) engine->eval(w+i,1,true);
+            const auto serial=engine->memory().checkpoint();
+            check(selected == engine->memory().selected(),"comparison did not preserve the sparse view");
+            const auto serial_kv=KvmemTestAccess::kv(engine->memory());
+            if(kv!=serial_kv)KvmemTestAccess::diagnose(engine->memory(),kv,serial_kv);
+            check(kv == serial_kv,"accepted native K/V differs from serial evaluation");
+            close(floats(speculative.state),floats(serial.state),"recurrent_and_draft_hidden");
+            close(means,KvmemTestAccess::means(engine->memory()),"accepted_mean_keys");
+            if (opt.memory.disk_mib) {
+                const auto before_io=engine->memory().io_stats();
+                auto parked=engine->memory().park(serial);
+                KvmemTestAccess::make_cold(engine->memory());
+                check(engine->memory().host_bytes() == 0,"cold parked history retained RAM payload");
+                check(engine->memory().disk_bytes() > 0,"cold parked history wrote no SSD payload");
+                engine->memory().enter(std::move(parked),serial);
+                const auto restored=engine->memory().checkpoint();
+                check(restored.state == serial.state,"cold restore changed recurrent checkpoint bytes");
+                const auto after_io=engine->memory().io_stats();
+                check(after_io.written_bytes > before_io.written_bytes,"cold transition performed no SSD write");
+                check(after_io.read_bytes > before_io.read_bytes,"cold transition performed no SSD read");
+            }
+            std::cout << "PASS prefix=" << length << " window=" << window << " accepted=" << accepted
+                      << " graphs=" << opt.graphs << '\n';
+            if(one_case)break;
+        }
+        // Cancellation discards an unaccepted verification window; reset/fresh
+        // evaluation must not inherit its rows, recurrent state or statistics.
+        prefix(191); draft(opt.window); engine->window(w,opt.window); prefix(63); engine->eval(w,1,true);
+        check(engine->memory().stamp().frontier == 64,"reset retained a cancelled window");
+        check(engine->memory().host_bytes() <= engine->memory().host_limit(),"MTP exceeded shared native payload quota");
+        if (opt.memory.disk_mib) {
+            const auto io=engine->memory().io_stats();
+            check(engine->memory().disk_bytes() <= engine->memory().disk_limit(),"SSD payload exceeded configured quota");
+            check(io.read_bytes && io.written_bytes,"SSD test completed without physical I/O");
+            std::cout << "PASS ssd read_bytes=" << io.read_bytes << " written_bytes=" << io.written_bytes << '\n';
+        }
+        if (const char* fault=std::getenv("KVMEM_POLY_TEST_FAULT"); fault && std::string(fault) == "accept") {
+            check(fault_seen,"requested acceptance fault never fired");
+            std::cout << "PASS accept_fault_invalidated_and_rebuilt\n";
+        }
+        std::cout << "PASS cancellation_reset and accepted-state checks\n";
+    } catch (const std::exception& e) { std::cerr << e.what() << '\n'; return 1; }
+}
diff --git a/tools/poly_kvmem_sessions_test.cpp b/tools/poly_kvmem_sessions_test.cpp
