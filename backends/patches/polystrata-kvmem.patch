diff --git a/src/poly/kvmem_sessions.cpp b/src/poly/kvmem_sessions.cpp
new file mode 100644
index 00000000..2e8a6fa4
--- /dev/null
+++ b/src/poly/kvmem_sessions.cpp
@@ -0,0 +1,84 @@
+#include "kvmem_sessions.hpp"
+#include "engine.hpp"
+#include <cstdio>
+#include <cstdlib>
+
+namespace strata::poly {
+bool KvmemSessions::make_archive_room(const KvmemMemory& memory) {
+    const auto needed = memory.archive_pending_bytes();
+    if (needed > memory.host_limit()) return false;
+    while (needed > memory.payload_limit()-memory.payload_bytes())
+        if (!evict_one()) return false;
+    return true;
+}
+void KvmemSessions::admit_active(const KvmemMemory& memory, uint64_t total_tokens) {
+    memory.admit(total_tokens); // rejects impossible requests before eviction
+    const auto records = (total_tokens+KvmemMemory::block_tokens-1)/KvmemMemory::block_tokens+1;
+    const auto required = records*memory.descriptor().layout.record_bytes;
+    while (payload_bytes() > memory.payload_limit()-required)
+        if (!evict_one()) throw std::logic_error("KVMem active admission did not fit after clearing idle histories");
+}
+int64_t KvmemSessions::resume(Engine& engine, KvmemHistory& current, const std::vector<int32_t>& ids,
+                              int64_t query_begin, uint64_t total_tokens) {
+    auto& memory = engine.memory();
+    configure(engine.memory_options().sessions-1);
+    memory.admit(total_tokens);
+    const auto live = current.choose(ids, query_begin, memory.stamp());
+    const auto idle = choose(ids, query_begin);
+    if (live.at > 0 && live.at >= idle.resume.at) {
+        admit_active(memory, total_tokens);
+        if (!live.checkpoint || make_archive_room(memory)) {
+            if (live.checkpoint) memory.restore_prefix(*live.checkpoint);
+            current.truncate(live.at);
+            return live.at;
+        }
+        // Cache pressure need not fail a request that fits by itself.
+        ++skipped_;
+        current.clear();
+        engine.reset();
+        current.bind(memory.stamp());
+        return 0;
+    }
+
+    // Protect the selected source while LRU pressure frees other idle records.
+    auto target = idle.slot != SIZE_MAX ? take(idle.slot) : nullptr;
+    try {
+        const auto cp = current.latest();
+        if (cp && memory.stamp().valid && cp->identity.stamp.session == memory.stamp().session && make_archive_room(memory)) {
+            auto leaving = std::make_unique<Entry>();
+            leaving->memory = memory.park(*cp);
+            current.truncate(int64_t(cp->identity.stamp.frontier));
+            leaving->history = std::move(current);
+            save(std::move(leaving));
+        } else {
+            if (cp) ++skipped_;
+            current.clear();
+            engine.reset();
+        }
+    } catch (...) {
+        // A failed park has not consumed the protected source. Other idle
+        // catalogs remain valid; the caller drops/resets only the GPU owner.
+        if (target) save(std::move(target));
+        throw;
+    }
+    admit_active(memory, total_tokens);
+    if (target) {
+        current = std::move(target->history);
+        memory.enter(std::move(target->memory), *idle.resume.checkpoint);
+        current.truncate(idle.resume.at);
+        ++restores_;
+        return idle.resume.at;
+    }
+    engine.reset();
+    current.clear();
+    current.bind(memory.stamp());
+    return 0;
+}
+void KvmemSessions::metrics(const KvmemMemory& memory) const {
+    if (!std::getenv("KVMEM_POLY_SESSION_METRICS")) return;
+    std::fprintf(stderr, "KVMEM_SESSIONS parked=%zu evictions=%zu restores=%zu skipped=%zu host_bytes=%llu host_limit=%llu session=%llu incarnation=%llu\n",
+        parked(), evictions(), restores(), skipped(), (unsigned long long)memory.host_bytes(),
+        (unsigned long long)memory.host_limit(), (unsigned long long)memory.stamp().session.id,
+        (unsigned long long)memory.stamp().session.incarnation);
+}
