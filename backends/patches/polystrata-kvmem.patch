diff --git a/src/poly/kvmem_capture.cu b/src/poly/kvmem_capture.cu
new file mode 100644
index 00000000..07cdd13b
--- /dev/null
+++ b/src/poly/kvmem_capture.cu
@@ -0,0 +1,103 @@
+#include "kvmem_capture.hpp"
+#include <cuda_fp16.h>
+#include <cuda_runtime.h>
+#include <math_constants.h>
+#include <cmath>
+
+namespace strata::poly {
+namespace {
+struct CaptureConfig { int64_t values[7]; };
+__global__ void pack_key_sums(const float* source,float* packed,int width,int groups,int layers,int source_groups) {
+    const size_t at=size_t(blockIdx.x)*blockDim.x+threadIdx.x;
+    const size_t stride=size_t(groups)*width;
+    if(at<size_t(layers)*stride)
+        packed[at]=source[(at/stride)*size_t(source_groups)*width+at%stride];
+}
+__global__ void set_config(int64_t* device,CaptureConfig config) {
+    for(int i=0;i<7;++i)device[i]=config.values[i];
+}
+__device__ float sum_warp(float value) {
+    for(int offset=16;offset;offset>>=1)value+=__shfl_down_sync(0xffffffff,value,offset);
+    return __shfl_sync(0xffffffff,value,0);
+}
+__device__ float max_warp(float value) {
+    for(int offset=16;offset;offset>>=1)value=fmaxf(value,__shfl_down_sync(0xffffffff,value,offset));
+    return __shfl_sync(0xffffffff,value,0);
+}
+__global__ void page_mass(const float* q,const uint16_t* keys,Kvq8 quant,int dim,int heads,int kv_heads,
+    const int64_t* cfg,const int32_t* map,float* mass,int stride,int layers) {
+    const int head=int(blockIdx.x),lane=int(threadIdx.x)&31,warp=int(threadIdx.x)>>5;
+    if(int64_t(blockIdx.y)>=cfg[6])return;
+    const int sample=int(cfg[5])+int(blockIdx.y);
+    const int64_t relative=map[sample];
+    const int row=int(relative-(cfg[0]-cfg[2]));
+    if(relative<0 || relative>=cfg[3] || row<0)return;
+    const int end=int(cfg[1])+row+1,pages=int(cfg[4]),kv=head/(heads/kv_heads);
+    extern __shared__ float shared[];
+    float* query=shared;
+    float* page=shared+dim;
+    __shared__ float reduce[8];
+    __shared__ float maximum,denominator;
+    for(int d=int(threadIdx.x);d<dim;d+=256)query[d]=q[(size_t(row)*heads+head)*dim+d];
+    for(int p=int(threadIdx.x);p<pages;p+=256)page[p]=0;
+    __syncthreads();
+    const float scale=rsqrtf(float(dim));
+    float biggest=-CUDART_INF_F;
+    for(int key=warp;key<end;key+=8) {
+        float dot=0;
+        const size_t base=(size_t(key)*kv_heads+kv)*dim;
+        for(int d=lane;d<dim;d+=32) {
+            const size_t at=base+d;
+            const float k=quant.codes ? float(quant.codes[at])*__half2float(reinterpret_cast<const __half*>(quant.scales)[at/32])
+                                      : __half2float(reinterpret_cast<const __half*>(keys)[at]);
+            dot+=query[d]*k;
+        }
+        biggest=fmaxf(biggest,sum_warp(dot)*scale);
+    }
+    if(lane==0)reduce[warp]=biggest;
+    __syncthreads();
+    if(warp==0) {
+        const float value=lane<8?reduce[lane]:-CUDART_INF_F;
+        const float top=max_warp(value);
+        if(lane==0)maximum=top;
+    }
+    __syncthreads();
+    float total=0;
+    for(int key=warp;key<end;key+=8) {
+        float dot=0;
+        const size_t base=(size_t(key)*kv_heads+kv)*dim;
+        for(int d=lane;d<dim;d+=32) {
+            const size_t at=base+d;
+            const float k=quant.codes ? float(quant.codes[at])*__half2float(reinterpret_cast<const __half*>(quant.scales)[at/32])
+                                      : __half2float(reinterpret_cast<const __half*>(keys)[at]);
+            dot+=query[d]*k;
+        }
+        const float weight=expf(sum_warp(dot)*scale-maximum);
+        if(lane==0) {atomicAdd(page+key/64,weight);total+=weight;}
+    }
+    if(lane==0)reduce[warp]=total;
+    __syncthreads();
+    if(threadIdx.x==0) {
+        float sum=0;for(int i=0;i<8;++i)sum+=reduce[i];
+        denominator=sum*float(heads*layers);
+    }
+    __syncthreads();
+    for(int p=int(threadIdx.x);p<pages;p+=256)
+        if(denominator>0)atomicAdd(mass+size_t(sample)*stride+p,page[p]/denominator);
+}
+}
+void kvmem_capture_config(int64_t* device,const int64_t* values,void* stream) {
+    CaptureConfig config{};for(int i=0;i<7;++i)config.values[i]=values[i];
+    set_config<<<1,1,0,static_cast<cudaStream_t>(stream)>>>(device,config);
+}
+void kvmem_pack_key_sums(const float* source,float* packed,int width,int groups,int layers,int source_groups,void* stream) {
+    const size_t count=size_t(width)*groups*layers;
+    pack_key_sums<<<unsigned((count+255)/256),256,0,static_cast<cudaStream_t>(stream)>>>(
+        source,packed,width,groups,layers,source_groups);
+}
+void kvmem_page_mass(const float* query,const uint16_t* keys,Kvq8 q8,int dim,int heads,int kv_heads,
+    int rows,const int64_t* cfg,const int32_t* map,float* mass,int stride,int layers,void* stream) {
+    page_mass<<<dim3(heads,rows),256,size_t(dim+stride)*sizeof(float),static_cast<cudaStream_t>(stream)>>>(
+        query,keys,q8,dim,heads,kv_heads,cfg,map,mass,stride,layers);
+}
+}
