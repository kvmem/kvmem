+// Optional native F16 memory adapter. The portable core owns policy and Host
+// records; Engine retains its device allocations, stream and recurrent state.
+#pragma once
+
+#include "kvmem/host_kv_storage.hpp"
+#include "kvmem/kvmem_store.hpp"
+#include "kvmem/memory_contract.hpp"
+#include "kvmem/raw_kv_store.hpp"
+#include "kvmem/mean_key_retrieval.hpp"
+#include "kvmem/spill_io.hpp"
+#include "kvmem/query_policy.hpp"
+#include "kvmem/retrieval_options.hpp"
+#include "kvmem/graph_recall.hpp"
+#include "kvmem/page_softmax_cuda.hpp"
+
+#include <cstdint>
+#include <memory>
+#include <string>
+#include <vector>
+
+namespace strata::poly {
+class Engine;
+
+struct KvmemOptions {
+    uint32_t budget = 0, reserve = 1024;
+    uint32_t sink = 64, recent = 64;
+    uint32_t sessions = 1; // total retained histories, including the GPU owner
+    uint64_t host_mib = 4096;
+    uint64_t disk_mib = 0;
+    std::string disk_path;
+    bool verify = false, lrfu = false, history_reuse = false, mtp = false;
+    double lrfu_lambda = 0.5, lrfu_top_fraction = 0.9;
+    kvmem::GqaScoreAggregation aggregation = kvmem::GqaScoreAggregation::Mean;
+    kvmem::QueryScorer scorer = kvmem::QueryScorer::PageSoftmax;
+    double graph_alpha = .2;
+    uint32_t query_max_tokens = kvmem::default_query_tokens;
+    uint32_t replay_max_tokens = kvmem::default_query_replay_tokens;
+    int64_t query_begin = -1, query_end = -1;
+    void validate(int context, int batch, int window, bool draft) const;
+};
+
+struct KvmemPlane {
+    uint32_t layer;
+    uint16_t* keys;
+    uint16_t* values;
+    int8_t* key_codes = nullptr;
+    uint16_t* key_scales = nullptr;
+    int8_t* value_codes = nullptr;
+    uint16_t* value_scales = nullptr;
+};
+
+struct KvmemCheckpoint {
+    kvmem::CheckpointIdentity identity;
+    std::vector<uint8_t> state;
+    std::vector<float> mean_tail;
+    kvmem::LrfuState retrieval;
+    uint64_t transfers = 0;
+    std::vector<uint64_t> resident;
+    kvmem::GraphSnapshot graph;
+    kvmem::AttentionFeedbackSnapshot feedback;
+    kvmem::OutputSampleState output_samples;
+};
+
+// An idle history owns opaque RAM records and its retrieval index, never GPU
+// allocations. Moving this catalog retains the same global Host account.
+struct KvmemParked {
+    kvmem::CheckpointIdentity identity;
+    std::unique_ptr<kvmem::RawKvStore> statistics;
+    std::unique_ptr<kvmem::KvMemStore> selector;
+    std::vector<kvmem::HostKvRecord> archive;
+    std::vector<uint64_t> versions, host_versions;
+    kvmem::GraphSnapshot graph;
+    kvmem::AttentionFeedbackSnapshot feedback;
+    kvmem::OutputSampleState output_samples;
+    uint64_t payload_bytes() const {
+        uint64_t bytes = 0;
+        for (const auto& record : archive) bytes += record.size();
+        return bytes;
+    }
+};
+
+class KvmemMemory final : public kvmem::MemoryBackend,
+                          public std::enable_shared_from_this<KvmemMemory> {
+public:
+    static constexpr uint32_t block_tokens = 64;
+    KvmemMemory(Engine&, std::vector<KvmemPlane>, uint32_t heads, uint32_t kv_heads, uint32_t head_dim);
+    ~KvmemMemory() override;
+    void rebind(std::vector<KvmemPlane>);
+    kvmem::MemoryDescriptor descriptor() const override;
+    kvmem::MemorySnapshot snapshot() const override;
+    kvmem::MemoryStamp stamp() const noexcept override;
+    std::unique_ptr<kvmem::MemoryTransfer> prepare(const kvmem::WorkingSetPlan&) override;
+    void invalidate() noexcept override;
+
+    void reset();
+    void before(int n);
+    void admit(uint64_t tokens) const;
+    void commit(int n, const float* keys, size_t key_layer_stride, const float* query, const float* query_rows = nullptr, size_t query_stride = 0);
+    int64_t compact_position(int64_t logical) const;
+    int64_t visible_tokens() const noexcept { return visible_; }
+    int capacity() const;
+    int append_room() const;
+    bool complete_prefix() const noexcept { return resident_.size() == versions_.size(); }
+    int query_first(int64_t first, int n) const;
+    int query_last(int64_t first, int n) const;
+    bool capture_query() const noexcept { return query_capture_; }
+    void begin_query(int64_t first, int64_t last);
+    KvmemCheckpoint checkpoint();
+    void start_request();
+    void restore_prefix(const KvmemCheckpoint&);
+    KvmemParked park(const KvmemCheckpoint&);
+    void enter(KvmemParked&&, const KvmemCheckpoint&);
+    uint64_t archive_pending_bytes() const;
+    uint64_t active_host_bytes() const;
+    uint64_t host_limit() const { return storage_->capacity_bytes(); }
+    uint64_t payload_limit() const {
+        if (!disk_limit()) return host_limit();
+        const auto record=descriptor_.layout.record_bytes;
+        return (host_limit()/record+disk_limit()/record)*record; // do not promise unusable per-tier fragments
+    }
+    uint64_t payload_bytes() const { return host_bytes()+storage_->disk_bytes(); }
+    uint64_t disk_bytes() const { return storage_->disk_bytes(); }
+    uint64_t disk_limit() const { return storage_->disk_capacity_bytes(); }
+    kvmem::SpillIoStats io_stats() const { return storage_->io_stats(); }
+    void storage_metrics() const;
+    bool freeze_and_rewind(const KvmemCheckpoint&, uint64_t prompt_end = 0);
+    void freeze_full_query();
+    void finish_query();
+    void archive_resident();
+    void trace(const char* event) const;
+    const std::vector<uint64_t>& selected() const noexcept { return resident_; }
+    uint64_t host_bytes() const { return storage_->charged_bytes(); }
+    uint64_t transfers() const noexcept { return transfers_; }
+    uint64_t restored_bytes() const noexcept { return restored_bytes_; }
+    int query_tokens() const noexcept { return query_tokens_; }
+    int query_rows() const noexcept { return int(std::max<int64_t>(0,query_end_-query_begin_)); }
+    int query_offset(int64_t first) const noexcept { return int(first-query_begin_); }
+    bool replaying() const noexcept { return replaying_; }
+    void prepare_capture(const int32_t* tokens,int n);
+    void accept_capture(int accepted,const float* mass,uint32_t stride);
+    const std::vector<int32_t>& capture_map() const noexcept { return capture_map_; }
+    const std::vector<uint32_t>& capture_samples() const noexcept { return capture_samples_; }
+    const std::vector<uint64_t>& capture_pages() const noexcept { return capture_pages_; }
+    int64_t capture_begin() const noexcept { return capture_begin_; }
+
+private:
+    friend class KvmemTransfer;
+    friend struct KvmemTestAccess;
+    kvmem::BlockDescriptor block(uint32_t id) const;
+    std::vector<uint64_t> select(bool retrieval) const;
+    std::vector<uint64_t> mandatory() const;
+    void exchange(const std::vector<uint64_t>&);
+    void save_view(uint8_t* dst);
+    void restore_view(const uint8_t* src, uint64_t rows);
+    void copy_to_record(uint32_t id, kvmem::HostKvRecord&, const uint8_t* src, uint64_t rows);
+    void check_fault(const char* stage);
+    void rewind_state(const KvmemCheckpoint&);
+    void truncate_catalog(const KvmemCheckpoint&);
+    uint64_t host_entitlement() const;
+
+    Engine& engine_;
+    KvmemOptions options_;
+    std::vector<KvmemPlane> planes_;
+    std::vector<uint8_t*> payload_;
+    uint32_t heads_, kv_heads_, dim_, key_width_, query_width_;
+    kvmem::MemoryDescriptor descriptor_;
+    kvmem::MemoryStamp stamp_;
+    kvmem::MemoryStamp query_base_stamp_;
+    std::shared_ptr<kvmem::HostKvStorage> storage_;
+    std::unique_ptr<kvmem::StorageIoQueue> io_queue_;
+    std::unique_ptr<kvmem::RawKvStore> statistics_;
+    std::unique_ptr<kvmem::KvMemStore> selector_;
+    std::vector<kvmem::HostKvRecord> archive_;
+    std::vector<uint64_t> versions_, host_versions_, resident_;
+    uint64_t visible_ = 0, transfers_ = 0, restored_bytes_ = 0;
+    uint8_t *out_ = nullptr, *in_ = nullptr;
+    struct PinnedDelete { void operator()(uint8_t*) const noexcept; };
+    std::unique_ptr<uint8_t,PinnedDelete> out_owner_,in_owner_;
+    int64_t query_begin_ = -1, query_end_ = -1;
+    bool query_capture_ = false, query_frozen_ = false, transaction_ = false;
+    int query_tokens_ = 0;
+    std::vector<float> query_sum_;
+    std::vector<float> query_rows_;
+    kvmem::QueryScoreFrame query_frame_;
+    kvmem::GraphSnapshot graph_;
+    kvmem::AttentionFeedback feedback_;
+    kvmem::OutputSampleState output_samples_;
+    std::shared_ptr<kvmem::PageSoftmaxCuda> cuda_recall_;
+    bool replaying_ = false;
+    bool restoring_view_ = false;
+    bool output_phase_ = false;
+    int32_t think_open_=-1,think_close_=-1;
+    int64_t capture_begin_=0;
+    std::vector<int32_t> capture_tokens_,capture_map_;
+    std::vector<uint32_t> capture_samples_;
+    std::vector<uint64_t> capture_pages_;
+    std::vector<kvmem::AcceptedAttentionRow> accepted_attention_;
+    std::string fault_;
+    bool fault_used_ = false;
+};
