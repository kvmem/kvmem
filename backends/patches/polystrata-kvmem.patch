+void KvmemMemory::reset() {
+    require(!transaction_, "cannot reset a pending KVMem transaction");
+    archive_.clear(); versions_.clear(); host_versions_.clear(); resident_.clear();
+    statistics_->clear();
+    selector_ = std::make_unique<kvmem::KvMemStore>(selector_->config());
+    const auto incarnation = stamp_.session.incarnation + 1;
+    // A restored old incarnation can be followed by a new conversation. Its
+    // ID must not collide with another parked incarnation from that past.
+    const auto id = options_.sessions > 1 || !stamp_.session.id ? next_session.fetch_add(1) : stamp_.session.id;
+    stamp_ = {true, {id, incarnation}, 1, 0, 0, 1};
+    graph_=kvmem::GraphSnapshot{};
+    graph_.block_tokens=block_tokens;
+    if(!engine_.shared_graph_budget_) engine_.shared_graph_budget_=std::make_shared<kvmem::GraphStatisticsBudget>(256u<<20);
+    graph_.set_budget(engine_.shared_graph_budget_);
+    feedback_.restore({});output_samples_={};
+    query_rows_.clear();replaying_=output_phase_=false;
+    visible_ = 0;
+    query_begin_ = query_end_ = -1;
+    query_capture_ = query_frozen_ = false;
+    query_tokens_ = 0;
+    std::fill(query_sum_.begin(), query_sum_.end(), 0.f);
+}
+void KvmemMemory::invalidate() noexcept { stamp_.valid = false; ++stamp_.history_revision; }
+kvmem::BlockDescriptor KvmemMemory::block(uint32_t id) const {
+    require(id < versions_.size() && uint64_t(id) * block_tokens < stamp_.frontier, "unknown KVMem block");
+    return {stamp_.session, id, uint64_t(id) * block_tokens,
+            uint32_t(std::min<uint64_t>(block_tokens, stamp_.frontier - uint64_t(id) * block_tokens)),
+            versions_[id], versions_[id]};
+}
+kvmem::MemorySnapshot KvmemMemory::snapshot() const {
+    kvmem::MemorySnapshot result;
+    result.stamp = stamp_;
+    result.resident = resident_;
+    for (uint32_t id = 0; id < versions_.size(); ++id) result.blocks.push_back({block(id), host_versions_[id]});
+    return result;
+}
+int64_t KvmemMemory::compact_position(int64_t logical) const {
+    require(stamp_.valid && logical >= int64_t(stamp_.frontier), "KVMem execution is outside its committed prefix");
+    const uint64_t result = visible_ + uint64_t(logical) - stamp_.frontier;
+    require(result <= uint64_t(capacity()), "KVMem compact address exceeds B+R");
+    return int64_t(result);
+}
+std::vector<uint64_t> KvmemMemory::mandatory() const {
+    std::vector<uint32_t> media;
+    for(const auto& image:engine_.images_) {
+        const uint64_t end=std::min<uint64_t>(stamp_.frontier,uint64_t(image.at)+uint64_t(image.n));
+        if(image.at<0 || uint64_t(image.at)>=end)continue;
+        for(uint64_t page=uint64_t(image.at)/block_tokens;page<pages(end);++page)media.push_back(uint32_t(page));
+    }
+    const auto required=kvmem::query_prefix_required(stamp_.frontier,block_tokens,
+        options_.sink/block_tokens,options_.recent/block_tokens,media);
+    return {required.begin(),required.end()};
+}
+std::vector<uint64_t> KvmemMemory::select(bool retrieval) const {
+    if (retrieval && query_tokens_>0) {
+        const uint32_t count=uint32_t(query_frame_.starts.size());
+        std::vector<uint32_t> rows(planes_.size(),uint32_t(query_tokens_));
+        for(size_t il=0;il<planes_.size();++il) if(planes_[il].layer>=uint32_t(engine_.n_layer_)) rows[il]=0;
+        kvmem::PageQueryView query{query_rows_.data(),rows.data(),uint32_t(planes_.size()),uint32_t(query_tokens_),heads_,kv_heads_,dim_};
+        auto scores=options_.scorer==kvmem::QueryScorer::PageSoftmax
+            ? cuda_recall_->score(*statistics_,query,query_frame_,options_.aggregation)
+            : kvmem::mean_query_cosine_scores(*statistics_,query,count,options_.aggregation);
+        if (options_.graph_alpha)
+            scores=kvmem::propagate_query_scores(scores,query_frame_,graph_,options_.graph_alpha);
+        selector_->set_retrieval_scores(scores);
+        const auto required=mandatory();
+        const std::vector<uint32_t> small(required.begin(),required.end());
+        const auto chosen=selector_->pick_topk_blocks(small);
+        return {chosen.begin(),chosen.end()};
+    }
+    // Pressure can only retain current accepted resident pages. It never
+    // imports a cached Query or reselects a cold historical page.
+    std::vector<uint32_t> candidates(resident_.begin(),resident_.end()),required;
+    for (auto id:mandatory())
+        if (std::binary_search(resident_.begin(),resident_.end(),id)) required.push_back(uint32_t(id));
+    std::vector<uint64_t> starts;
+    for (auto id:resident_) starts.push_back(id*block_tokens);
+    auto chosen=kvmem::pressure_selection(candidates,feedback_.pressure_scores(starts),required,options_.budget/block_tokens);
+    return {chosen.begin(),chosen.end()};
+}
+void KvmemMemory::before(int n) {
+    require(stamp_.valid && !transaction_, "KVMem session is invalid or busy");
+    require(n > 0 && engine_.pos_ == int64_t(stamp_.frontier) &&
+            (uint32_t(n) <= options_.reserve ||
+             (resident_.size() == versions_.size() && visible_ + uint64_t(n) <= uint64_t(capacity()))),
+            "KVMem append must fit R or unused capacity of a full resident prefix");
+    const uint64_t end = stamp_.frontier + uint64_t(n);
+    require(end <= descriptor_.capabilities.max_position, "KVMem logical context is full");
+    if (uint64_t(pages(end)) * descriptor_.layout.record_bytes > host_entitlement())
+        throw kvmem::MemoryError(kvmem::MemoryErrorCode::BudgetExceeded, "KVMem history exceeds Host payload budget");
+    if (visible_+uint64_t(n)>uint64_t(capacity())) {
+        require(!replaying_,"Query replay exceeded its admitted fixed working set");
+        exchange(select(false));
+    }
+    require(visible_ + uint64_t(n) <= uint64_t(capacity()), "KVMem selected view leaves insufficient append space");
+}
+void KvmemMemory::admit(uint64_t tokens) const {
+    require(tokens <= descriptor_.capabilities.max_position, "KVMem request exceeds its logical context");
+    // One extra tail record covers atomic replacement of a versioned Host copy.
+    if ((uint64_t(pages(tokens)) + 1) * descriptor_.layout.record_bytes > payload_limit())
+        throw kvmem::MemoryError(kvmem::MemoryErrorCode::BudgetExceeded,
+                                 "KVMem request exceeds Host payload capacity including replacement margin");
+}
+void KvmemMemory::commit(int n, const float* keys, size_t stride, const float* query, const float* query_rows, size_t query_stride) {
+    if (engine_.memory_window_) check_fault("accept");
+    require(stamp_.valid && !transaction_ && engine_.pos_ == int64_t(stamp_.frontier) + n,
+            "KVMem commit is not a complete evaluated prefix");
+    const uint64_t first = stamp_.frontier, end = first + uint64_t(n);
+    const uint32_t old_count = uint32_t(versions_.size()), count = pages(end);
+    archive_.resize(count); versions_.resize(count, 0); host_versions_.resize(count, 0);
+    statistics_->ensure_blocks(count);
+    for (size_t layer = 0; layer < planes_.size(); ++layer) {
+        uint64_t at = first;
+        size_t group = 0;
+        while (at < end) {
+            const uint32_t take = uint32_t(std::min<uint64_t>(block_tokens - at % block_tokens, end - at));
+            statistics_->write_layer_mean_sum(uint32_t(at), take, uint32_t(layer), keys + layer * stride + group * key_width_);
+            at += take; ++group;
+        }
+    }
+    if (query_capture_) {
+        const int from = query_first(int64_t(first), n), to = query_last(int64_t(first), n);
+        if (to > from) {
+            require(query != nullptr, "KVMem query capture is missing");
+            for (size_t i = 0; i < query_sum_.size(); ++i) query_sum_[i] += query[i];
+            query_tokens_ += to - from;
+            require(query_rows!=nullptr,"KVMem per-token Query rows are missing");
+            const size_t rows=size_t(query_end_-query_begin_)*query_width_;
+            if(!query_stride)query_stride=rows;
+            require(query_stride>=rows,"KVMem Query staging stride is too short");
+            query_rows_.resize(planes_.size()*rows);
+            for(size_t layer=0;layer<planes_.size();++layer)
+                std::memcpy(query_rows_.data()+layer*rows,query_rows+layer*query_stride,rows*sizeof(float));
+        }
+    }
+    graph_=kvmem::prepare_graph_accept(graph_,first,end,accepted_attention_,256u<<20);
+    accepted_attention_.clear();
+    selector_->register_append(uint32_t(n));
+    for (uint32_t id = uint32_t(first / block_tokens); id < count; ++id) ++versions_[id];
+    for (uint32_t id = old_count; id < count; ++id) {
+        resident_.push_back(id);
+        selector_->set_block_gpu_slot(id, int32_t(resident_.size() - 1));
+    }
+    visible_ += uint64_t(n);
+    stamp_.frontier = end;
+    ++stamp_.history_revision; ++stamp_.view_version; ++stamp_.execution_history;
+}
+
+void KvmemMemory::save_view(uint8_t* dst) {
+    for (size_t p=0;p<payload_.size();++p) {
+        const size_t bytes=size_t(visible_)*descriptor_.layout.planes[p].token_stride;
+        if (bytes) ck(cudaMemcpyAsync(dst,payload_[p],bytes,cudaMemcpyDeviceToHost,cs(engine_.st_)),"KVMem spill");
+        dst+=bytes;
+    }
+    ck(cudaStreamSynchronize(cs(engine_.st_)), "KVMem spill");
+}
+void KvmemMemory::restore_view(const uint8_t* src, uint64_t rows) {
+    for (size_t p=0;p<payload_.size();++p) {
+        const size_t bytes=size_t(rows)*descriptor_.layout.planes[p].token_stride;
+        if (bytes) ck(cudaMemcpyAsync(payload_[p],src,bytes,cudaMemcpyHostToDevice,cs(engine_.st_)),"KVMem restore");
+        src+=bytes;
+    }
+    ck(cudaStreamSynchronize(cs(engine_.st_)), "KVMem restore");
+    restored_bytes_ += rows * descriptor_.layout.record_bytes / block_tokens;
+}
+void KvmemMemory::copy_to_record(uint32_t id, kvmem::HostKvRecord& record, const uint8_t* src, uint64_t rows) {
+    uint64_t at = 0;
+    for (const auto resident : resident_) { if (resident == id) break; at += block(uint32_t(resident)).valid_tokens; }
+    require(at < rows, "KVMem spill source is not resident");
+    const auto b = block(id);
+    uint8_t* dst = record.writable_data();
+    std::memset(dst, 0, record.size());
+    size_t offset=0;
+    for (const auto& plane:descriptor_.layout.planes) {
+        const size_t row=size_t(plane.token_stride);
+        std::memcpy(dst+plane.offset,src+offset+at*row,size_t(b.valid_tokens)*row);
+        offset+=size_t(rows)*row;
+    }
+    record.seal();
+}
+void KvmemMemory::archive_resident() {
+    uint64_t missing = 0;
+    for (auto id : resident_) if (host_versions_[size_t(id)] != versions_[size_t(id)]) missing += descriptor_.layout.record_bytes;
+    if (!missing) return;
+    if (options_.verify) std::fprintf(stderr, "KVMEM_POLY archive frontier=%llu missing_bytes=%llu rows=%llu\n",
+        (unsigned long long)stamp_.frontier, (unsigned long long)missing, (unsigned long long)visible_);
+    const auto writes = io_stats().written_bytes;
+    auto reserved = storage_->reserve(missing);
+    // Reserving RAM can synchronously demote sealed records. Inject only after
+    // the write completed, while the old Host sources and GPU view are intact.
+    if (io_stats().written_bytes > writes) check_fault("disk_write");
+    std::vector<std::pair<uint32_t, kvmem::HostKvRecord>> fresh;
+    for (auto id : resident_)
+        if (host_versions_[size_t(id)] != versions_[size_t(id)])
+            fresh.emplace_back(uint32_t(id), reserved.allocate(size_t(descriptor_.layout.record_bytes)));
+    // Checkpoint archiving needs only dirty blocks. Coalesce adjacent compact
+    // rows, especially the one-page query tail, rather than downloading the
+    // entire selected view again. Transfer packing still uses save_view().
+    std::vector<std::pair<uint64_t, uint64_t>> ranges;
+    uint64_t at = 0;
+    for (auto id : resident_) {
+        const auto b = block(uint32_t(id));
+        if (host_versions_[size_t(id)] != versions_[size_t(id)]) {
+            if (!ranges.empty() && ranges.back().first + ranges.back().second == at)
+                ranges.back().second += b.valid_tokens;
+            else ranges.emplace_back(at, b.valid_tokens);
+        }
+        at += b.valid_tokens;
+    }
+    auto* dst = out_;
+    for (size_t p=0;p<payload_.size();++p) {
+        const size_t row=descriptor_.layout.planes[p].token_stride;
+        for (const auto& range:ranges)
+            ck(cudaMemcpyAsync(dst+range.first*row,payload_[p]+range.first*row,range.second*row,
+                cudaMemcpyDeviceToHost,cs(engine_.st_)),"KVMem dirty archive");
+        dst+=size_t(visible_)*row;
+    }
+    ck(cudaStreamSynchronize(cs(engine_.st_)), "KVMem dirty archive");
+    for (auto& item : fresh) {
+        copy_to_record(item.first, item.second, out_, visible_);
+        archive_[item.first] = std::move(item.second);
+        host_versions_[item.first] = versions_[item.first];
+    }
+}
+
+uint64_t KvmemMemory::archive_pending_bytes() const {
+    uint64_t bytes = 0;
+    for (auto id : resident_) if (host_versions_[size_t(id)] != versions_[size_t(id)])
+        bytes += descriptor_.layout.record_bytes;
+    return bytes;
+}
+uint64_t KvmemMemory::active_host_bytes() const {
+    uint64_t bytes = 0;
+    for (const auto& record : archive_) bytes += record.size();
+    return bytes;
+}
+uint64_t KvmemMemory::host_entitlement() const {
+    if (options_.sessions == 1) return payload_limit();
+    const uint64_t own = active_host_bytes(), total = payload_bytes();
+    require(own <= total, "KVMem active payload exceeds its shared Host charge");
+    return payload_limit() - (total - own);
+}
+
+class KvmemTransfer final : public kvmem::MemoryTransfer {
+public:
+    KvmemTransfer(KvmemMemory& owner, const kvmem::WorkingSetPlan& plan) : owner_(owner), plan_(plan) {
+        require(!owner.transaction_ && owner.stamp_ == plan.expected, "KVMem transfer has a stale owner");
+        const auto writes = owner.io_stats().written_bytes;
+        auto reservation = owner.storage_->reserve(uint64_t(plan.spill.size()) * owner.descriptor_.layout.record_bytes);
+        if (owner.io_stats().written_bytes > writes) owner.check_fault("disk_write");
+        for (const auto& b : plan.spill) staged_.emplace_back(uint32_t(b.id), reservation.allocate(size_t(owner.descriptor_.layout.record_bytes)));
+        for (const auto& b : plan.restore) {
+            require(b.id < owner.archive_.size() && owner.host_versions_[size_t(b.id)] == b.content_version,
+                    "KVMem restore has no current Host source");
+            leases_.emplace(b.id, owner.archive_[size_t(b.id)].lease());
+        }
+        owner.check_fault("prepare");
+        // Stable VMM addresses remain engine-owned. Commit the physical
+        // entitlement before starting any transfer, including future R rows.
+        owner.engine_.cover(owner.capacity());
+        owner.transaction_ = true;
+    }
+    ~KvmemTransfer() override { if (!finished_) abort(); }
+    void start_spill() override {
+        require(phase_ == 0 && !finished_, "KVMem spill started outside the prepared phase");
+        owner_.save_view(owner_.out_);
+        for (auto& item : staged_) owner_.copy_to_record(item.first, item.second, owner_.out_, owner_.visible_);
+        owner_.check_fault("spill");
+        phase_ = 1;
+    }
+    kvmem::TransferPoll poll() override {
+        if (phase_ == 2) {
+            if (!read_.ready()) return {kvmem::TransferStatus::Pending,{}};
+            read_.wait(); // CPU/file failure before any GPU publication
+            finish_restore(); // engine thread alone owns CUDA and view publication
+        }
+        return {phase_ ? kvmem::TransferStatus::Complete : kvmem::TransferStatus::Pending, {}};
+    }
+    void start_restore() override {
+        require(phase_ == 1 && !finished_, "KVMem restore started before spill completed");
+        if (owner_.io_queue_) {
+            const uint64_t bytes=2*uint64_t(owner_.capacity())*owner_.descriptor_.layout.record_bytes/KvmemMemory::block_tokens;
+            read_=owner_.io_queue_->submit(bytes,[this] { fill_restore(); });
+            require(bool(read_),"KVMem cold-read queue exceeded its bounded capacity");
+            phase_=2;
+        } else { fill_restore(); finish_restore(); }
+    }
+    void fill_restore() {
+        std::unordered_map<uint64_t, uint64_t> old;
+        uint64_t at = 0;
+        for (auto id : owner_.resident_) { old.emplace(id, at); at += owner_.block(uint32_t(id)).valid_tokens; }
+        for (const auto& chosen : plan_.next.blocks) {
+            const auto& b = chosen.block;
+            size_t offset=0;
+            for (size_t p = 0; p < owner_.descriptor_.layout.planes.size(); ++p) {
+                const auto& plane=owner_.descriptor_.layout.planes[p];
+                const size_t row=plane.token_stride;
+                auto* dst = owner_.in_ + offset*plan_.next.visible_tokens + chosen.compact_start*row;
+                const auto found = old.find(b.id);
+                if (found != old.end())
+                    std::memcpy(dst, owner_.out_ + offset*owner_.visible_ + found->second*row, size_t(b.valid_tokens)*row);
+                else {
+                    if (!leases_.at(b.id).data()) owner_.check_fault("disk_read");
+                    leases_.at(b.id).read(size_t(plane.offset),dst,size_t(b.valid_tokens)*row);
+                }
+                offset+=row;
+            }
+        }
+    }
+    void finish_restore() {
+        // Publish current Host sources before any destructive device writes.
+        for (auto& item : staged_) {
+            owner_.archive_[item.first] = std::move(item.second);
+            owner_.host_versions_[item.first] = owner_.versions_[item.first];
+        }
+        destructive_ = true;
+        owner_.restore_view(owner_.in_, plan_.next.visible_tokens);
+        owner_.check_fault("restore");
+        if (owner_.options_.verify) {
+            const uint64_t old_visible = owner_.visible_;
+            owner_.visible_ = plan_.next.visible_tokens;
+            try { owner_.save_view(owner_.out_); } catch (...) { owner_.visible_ = old_visible; throw; }
+            owner_.visible_ = old_visible;
+            require(std::memcmp(owner_.in_, owner_.out_, size_t(plan_.next.visible_tokens) * owner_.descriptor_.layout.record_bytes / KvmemMemory::block_tokens) == 0,
+                    "KVMem restored native bytes differ");
+        }
+        phase_ = 3;
+    }
+    void publish(const kvmem::ExecutionView& view) override {
+        require(phase_ == 3 && !finished_, "KVMem view published before restore completed");
+        owner_.check_fault("publish");
+        require(view.stamp == plan_.next.stamp, "KVMem publish stamp differs from prepared plan");
+        for (auto id : owner_.resident_) {
+            owner_.selector_->set_block_gpu_slot(uint32_t(id), -1);
+            owner_.selector_->set_block_tier(uint32_t(id), kvmem::KvTier::CPU, int32_t(id));
+        }
+        owner_.resident_.clear();
+        for (const auto& b : view.blocks) owner_.resident_.push_back(b.block.id);
+        owner_.visible_ = view.visible_tokens;
+        owner_.stamp_ = view.stamp;
+        std::vector<uint32_t> ids(owner_.resident_.begin(), owner_.resident_.end());
+        for (size_t slot = 0; slot < ids.size(); ++slot) {
+            owner_.selector_->set_block_tier(ids[slot], kvmem::KvTier::GPU);
+            owner_.selector_->set_block_gpu_slot(ids[slot], int32_t(slot));
+        }
+        require(owner_.selector_->commit_resident_selection(ids), "KVMem selector rejected the published view");
+        ++owner_.transfers_;
+        owner_.transaction_ = false;
+        finished_ = true;
+        leases_.clear();
+        owner_.trace("publish");
+    }
+    kvmem::AbortResult abort() noexcept override {
+        if (finished_) return destructive_ ? kvmem::AbortResult::SessionInvalidated : kvmem::AbortResult::PreviousViewPreserved;
+        if (read_) { read_.cancel(); try { read_.wait(); } catch (...) {} }
+        const bool drained = cudaStreamSynchronize(cs(owner_.engine_.st_)) == cudaSuccess;
+        leases_.clear(); staged_.clear();
+        owner_.transaction_ = false;
+        finished_ = true;
+        if (destructive_ || !drained) { owner_.invalidate(); return kvmem::AbortResult::SessionInvalidated; }
+        return kvmem::AbortResult::PreviousViewPreserved;
+    }
+private:
+    KvmemMemory& owner_;
+    kvmem::WorkingSetPlan plan_;
+    std::vector<std::pair<uint32_t, kvmem::HostKvRecord>> staged_;
+    std::unordered_map<uint64_t, kvmem::HostKvLease> leases_;
+    kvmem::StorageTicket read_;
+    bool destructive_ = false, finished_ = false;
+    int phase_ = 0;
+};
+
+std::unique_ptr<kvmem::MemoryTransfer> KvmemMemory::prepare(const kvmem::WorkingSetPlan& plan) {
+    require(!engine_.memory_window_ && !engine_.memory_drafting_, "cannot exchange a provisional KVMem window");
+    require(plan.budget.selected_tokens == (restoring_view_?uint64_t(capacity()):options_.budget) &&
+            plan.budget.reserve_tokens == (restoring_view_?0:options_.reserve) &&
+            plan.budget.device_tokens == uint64_t(capacity()) && plan.budget.host_payload_bytes == host_entitlement(),
+            "KVMem transfer budget differs from the bound backend");
+    std::vector<uint64_t> chosen;
+    for (const auto& b : plan.next.blocks) chosen.push_back(b.block.id);
+    const auto checked = kvmem::plan_working_set(descriptor_, snapshot(), chosen, plan.mandatory, plan.budget);
+    require(plan.expected == checked.expected && plan.next.stamp == checked.next.stamp &&
+            plan.next.visible_tokens == checked.next.visible_tokens && plan.evict == checked.evict &&
+            plan.spill == checked.spill && plan.restore == checked.restore &&
+            plan.device_tokens_required == checked.device_tokens_required &&
+            plan.host_payload_bytes_required == checked.host_payload_bytes_required,
+            "KVMem transfer differs from the validated native plan");
+    for (size_t i = 0; i < checked.next.blocks.size(); ++i)
+        require(plan.next.blocks[i].block == checked.next.blocks[i].block &&
+                plan.next.blocks[i].compact_start == checked.next.blocks[i].compact_start,
+                "KVMem transfer has an invalid compact mapping");
+    require(plan.device_tokens_required <= uint64_t(capacity()), "KVMem plan exceeds native allocation");
+    return std::make_unique<KvmemTransfer>(*this, plan);
+}
+void KvmemMemory::exchange(const std::vector<uint64_t>& selected) {
+    if (selected == resident_) return;
+    kvmem::MemorySession session(shared_from_this());
+    session.prepare(stamp_, selected, mandatory(),
+        {restoring_view_?uint64_t(capacity()):options_.budget, restoring_view_?0:options_.reserve,
+         uint64_t(capacity()), host_entitlement()});
+    while (session.advance() != kvmem::MemoryPhase::Ready) {}
+    session.publish();
+}
+int KvmemMemory::query_first(int64_t first, int n) const {
+    return int(std::clamp<int64_t>(query_begin_ - first, 0, n));
+}
+int KvmemMemory::query_last(int64_t first, int n) const {
+    return int(std::clamp<int64_t>(query_end_ - first, 0, n));
+}
+void KvmemMemory::begin_query(int64_t first, int64_t last) {
+    require(first >= int64_t(stamp_.frontier) && last > first && last <= engine_.max_context() &&
+            uint64_t(last-first)<=options_.query_max_tokens, "invalid KVMem query boundary");
+    query_begin_ = first; query_end_ = last;
+    query_base_stamp_ = stamp_;
+    query_capture_ = true; query_frozen_ = false; query_tokens_ = 0;
+    std::fill(query_sum_.begin(), query_sum_.end(), 0.f);
+    query_frame_=kvmem::query_score_frame(stamp_.frontier,block_tokens,options_.budget/block_tokens,
+        options_.sink/block_tokens,options_.recent/block_tokens,{});
+    std::fprintf(stderr,"KVMEM_QUERY query_begin=%lld query_end=%lld prefix=%llu scorer=%s\n",
+        (long long)first,(long long)last,(unsigned long long)stamp_.frontier,kvmem::query_scorer_name(options_.scorer));
+}
+void KvmemMemory::start_request() {
+    feedback_.finish_output();
+    replaying_=output_phase_=false;
+    query_rows_.clear();
+    require(stamp_.valid && !transaction_, "cannot start a query in an invalid KVMem session");
+    query_begin_ = query_end_ = -1;
+    query_capture_ = query_frozen_ = false;
+    query_tokens_ = 0;
+    std::fill(query_sum_.begin(), query_sum_.end(), 0.f);
+}
+KvmemCheckpoint KvmemMemory::checkpoint() {
+    require(stamp_.valid && !transaction_ && !engine_.memory_window_ && !engine_.memory_drafting_ &&
+            engine_.pos_ == int64_t(stamp_.frontier), "cannot checkpoint incomplete KVMem execution");
+    archive_resident();
+    KvmemCheckpoint cp;
+    cp.identity = {descriptor_.identity, descriptor_.layout, stamp_};
+    if (options_.verify) std::fprintf(stderr, "KVMEM_POLY checkpoint frontier=%llu state_bytes=%llu\n",
+        (unsigned long long)stamp_.frontier, (unsigned long long)engine_.state_bytes());
+    cp.state.resize(engine_.state_bytes());
+    require(cp.state.size() == engine_.state_n_ * sizeof(float), "KVMem M1 checkpoint has unsupported extra state");
+    ck(cudaMemcpyAsync(cp.state.data(), engine_.state_, cp.state.size(), cudaMemcpyDeviceToHost, cs(engine_.st_)),
+       "KVMem recurrent checkpoint");
+    ck(cudaStreamSynchronize(cs(engine_.st_)), "KVMem recurrent checkpoint");
+    if (options_.verify) {
+        std::vector<uint8_t> reference(cp.state.size());
+        engine_.save_state(reference.data());
+        require(reference == cp.state, "KVMem contiguous checkpoint differs from native layer checkpoints");
+    }
+    cp.mean_tail = statistics_->mean_checkpoint(uint32_t(stamp_.frontier));
+    cp.retrieval = selector_->retrieval_checkpoint();
+    cp.transfers = transfers_;
+    cp.resident=resident_;cp.graph=graph_;cp.feedback=feedback_.snapshot();cp.output_samples=output_samples_;
+    return cp;
+}
+bool KvmemMemory::freeze_and_rewind(const KvmemCheckpoint& cp,uint64_t prompt_end) {
+    require(query_capture_ && query_tokens_==query_end_-query_begin_ && stamp_.frontier==uint64_t(query_end_),
+            "KVMem Query probe is incomplete");
+    require(cp.identity.stamp==query_base_stamp_ && cp.identity.backend==descriptor_.identity &&
+            cp.identity.layout==descriptor_.layout && cp.identity.stamp.session==stamp_.session &&
+            cp.identity.stamp.frontier==uint64_t(query_begin_) && cp.state.size()==engine_.state_bytes(),
+            "KVMem Query checkpoint identity mismatch");
+    query_capture_=false;
+    if (!prompt_end) prompt_end=uint64_t(query_end_);
+    const auto plan=kvmem::query_replay_plan({uint64_t(query_begin_),uint64_t(query_end_)},
+        cp.identity.stamp.frontier,prompt_end,options_.replay_max_tokens,block_tokens,
+        std::min<uint64_t>(pages(cp.identity.stamp.frontier),options_.budget/block_tokens),
+        uint64_t(capacity())/block_tokens,options_.mtp?uint32_t(engine_.max_window()):0);
+    if (!plan.admitted) {
+        std::fprintf(stderr,"KVMEM_QUERY replay=0 reason=%s begin=%llu end=%llu\n",plan.reason,
+            (unsigned long long)plan.begin,(unsigned long long)plan.end);
+        return false;
+    }
+    // Freeze scores over the exact pre-Query prefix, including its partial
+    // Mean-K page. No probe suffix becomes a historical recall candidate.
+    rewind_state(cp);
+    selector_->begin_retrieval_round();
+    query_frozen_=true;
+    exchange(select(true));
+    replaying_=true;
+    std::fprintf(stderr,"KVMEM_QUERY replay=1 reason=%s begin=%llu end=%llu\n",plan.reason,
+        (unsigned long long)plan.begin,(unsigned long long)plan.end);
+    trace("query_rewind");
+    return true;
+}
+void KvmemMemory::restore_prefix(const KvmemCheckpoint& cp) {
+    require(stamp_.valid && !transaction_ && cp.identity.stamp.valid &&
+            cp.identity.backend == descriptor_.identity && cp.identity.layout == descriptor_.layout &&
+            cp.identity.stamp.session == stamp_.session && cp.identity.stamp.frontier <= stamp_.frontier &&
+            cp.state.size() == engine_.state_bytes(), "KVMem history checkpoint identity mismatch");
+    // The caller proved an identical token prefix and discarded checkpoints
+    // after a fork. Later appends never change the KV bytes before this point.
+    start_request();
+    try {
+        rewind_state(cp);
+        check_fault("history_restore");
+        std::vector<uint64_t> chosen;
+        for (auto id:cp.resident) if (id<versions_.size()) chosen.push_back(id);
+        // This restores an already accepted view, including any occupied R
+        // rows. It makes no fresh append reservation; before() governs the next
+        // execution. Cold retrieval still selects at most B and reserves R.
+        restoring_view_=true;
+        exchange(chosen);
+        restoring_view_=false;
+        trace("history_rewind");
+    } catch (...) {
+        restoring_view_=false;
+        invalidate();
+        throw;
+    }
+}
+void KvmemMemory::rewind_state(const KvmemCheckpoint& cp) {
+    archive_resident();
+    truncate_catalog(cp);
+    engine_.load_state(cp.state.data(), int64_t(stamp_.frontier));
+    if (options_.verify) {
+        std::vector<uint8_t> restored(engine_.state_bytes());
+        engine_.save_state(restored.data());
+        require(restored == cp.state, "KVMem recurrent checkpoint bytes differ after restore");
+    }
+}
+void KvmemMemory::truncate_catalog(const KvmemCheckpoint& cp) {
+    const uint64_t frontier = cp.identity.stamp.frontier;
+    const auto count = pages(frontier);
+    resident_.erase(std::remove_if(resident_.begin(), resident_.end(), [count](uint64_t id) { return id >= count; }), resident_.end());
+    archive_.resize(count); versions_.resize(count); host_versions_.resize(count);
+    stamp_.frontier = frontier;
+    if (count && frontier % block_tokens) {
+        ++versions_.back();
+        if (archive_.back()) host_versions_.back() = versions_.back();
+    }
+    statistics_->truncate_to(uint32_t(frontier));
+    statistics_->restore_mean_checkpoint(uint32_t(frontier), cp.mean_tail);
+    selector_->truncate_to(uint32_t(frontier));
+    selector_->restore_retrieval(cp.retrieval);
+    graph_=cp.graph;feedback_.restore(cp.feedback);output_samples_=cp.output_samples;
+    visible_ = 0;
+    for (auto id : resident_) visible_ += block(uint32_t(id)).valid_tokens;
+    ++stamp_.history_revision; ++stamp_.view_version; ++stamp_.execution_history;
+}
+KvmemParked KvmemMemory::park(const KvmemCheckpoint& cp) {
+    require(stamp_.valid && !transaction_ && !engine_.memory_window_ && !engine_.memory_drafting_ && cp.identity.backend == descriptor_.identity &&
+            cp.identity.layout == descriptor_.layout && cp.identity.stamp.session == stamp_.session &&
+            cp.identity.stamp.frontier <= stamp_.frontier && cp.state.size() == engine_.state_bytes(),
+            "KVMem parked checkpoint identity mismatch");
+    // Allocate the empty next catalog before detaching any authoritative data.
+    auto fresh_statistics = std::make_unique<kvmem::RawKvStore>(statistics_->config());
+    auto fresh_selector = std::make_unique<kvmem::KvMemStore>(selector_->config());
+    archive_resident();
+    check_fault("session_park");
+    truncate_catalog(cp);
+    for (uint32_t id = 0; id < versions_.size(); ++id) {
+        require(bool(archive_[id]) && host_versions_[id] == versions_[id], "KVMem parked history has no current Host source");
+        selector_->set_block_gpu_slot(id, -1);
+        selector_->set_block_tier(id, kvmem::KvTier::CPU, int32_t(id));
+    }
+    KvmemParked parked;
+    parked.identity = {descriptor_.identity, descriptor_.layout, stamp_};
+    parked.graph=graph_;parked.feedback=feedback_.snapshot();parked.output_samples=output_samples_;
+    parked.statistics = std::move(statistics_);
+    parked.selector = std::move(selector_);
+    parked.archive = std::move(archive_);
+    parked.versions = std::move(versions_);
+    parked.host_versions = std::move(host_versions_);
+    archive_.clear(); versions_.clear(); host_versions_.clear();
+    statistics_ = std::move(fresh_statistics);
+    selector_ = std::move(fresh_selector);
+    resident_.clear();
+    visible_ = 0;
+    invalidate(); // Engine state belongs to the detached history until reset/enter.
+    return parked;
+}
+void KvmemMemory::enter(KvmemParked&& parked, const KvmemCheckpoint& cp) {
+    require(!transaction_ && archive_.empty() && versions_.empty() && resident_.empty() &&
+            parked.identity.backend == descriptor_.identity && parked.identity.layout == descriptor_.layout &&
+            parked.identity.stamp.valid && parked.identity.stamp.session == cp.identity.stamp.session &&
+            parked.identity.stamp.frontier >= cp.identity.stamp.frontier && parked.statistics && parked.selector &&
+            parked.versions.size() == parked.archive.size() && parked.host_versions == parked.versions,
+            "KVMem idle history is incompatible or the GPU owner was not detached");
+    statistics_ = std::move(parked.statistics);
+    selector_ = std::move(parked.selector);
+    archive_ = std::move(parked.archive);
+    versions_ = std::move(parked.versions);
+    host_versions_ = std::move(parked.host_versions);
+    stamp_ = parked.identity.stamp;
+    graph_=std::move(parked.graph);feedback_.restore(std::move(parked.feedback));output_samples_=parked.output_samples;
+    try {
+        check_fault("session_enter");
+        restore_prefix(cp);
+        trace("session_enter");
+    } catch (...) {
+        invalidate();
+        throw;
+    }
+}
+void KvmemMemory::freeze_full_query() {
+    // A proved complete resident pass has no Query consumer or replay.
+    query_capture_=false;
+}
+void KvmemMemory::finish_query() {
+    if (query_frozen_) {
+        require(stamp_.frontier>=uint64_t(query_end_),"KVMem Query replay is incomplete");
+        selector_->commit_retrieval_round();
+    }
+    query_capture_=query_frozen_=replaying_=false;
+    output_phase_=true;
+    trace("query_complete");
+}
+void KvmemMemory::prepare_capture(const int32_t* tokens,int n) {
+    require(n>0 && n<=capacity() && tokens,"invalid native statistics frame");
+    capture_begin_=int64_t(stamp_.frontier);
+    capture_tokens_.assign(tokens,tokens+n);
+    capture_map_.assign(size_t(n),-1);
+    capture_pages_.clear();accepted_attention_.clear();capture_samples_.clear();
+    for(auto id:resident_)capture_pages_.push_back(id*block_tokens);
+    for(uint32_t id=pages(stamp_.frontier);id<pages(stamp_.frontier+uint64_t(n));++id)
+        capture_pages_.push_back(uint64_t(id)*block_tokens);
+    require(capture_pages_.size()==pages(visible_+uint64_t(n)),"native statistics physical page geometry differs");
+    if(!replaying_) {
+        if(output_phase_)capture_samples_=kvmem::accepted_output_samples(output_samples_,tokens,uint32_t(n),think_open_,think_close_).rows;
+        else capture_samples_=kvmem::prefill_sample_rows(stamp_.frontier,uint32_t(n),feedback_.snapshot().prefill_end,
+            visible_,uint64_t(capacity()));
+    }
+    for(size_t i=0;i<capture_samples_.size();++i)capture_map_.at(capture_samples_[i])=int32_t(i);
+}
+void KvmemMemory::accept_capture(int n,const float* mass,uint32_t stride) {
+    require(n>0 && size_t(n)<=capture_tokens_.size() && capture_begin_==int64_t(stamp_.frontier),
+            "native attention statistics do not match accepted tokens");
+    for(size_t sample=0;sample<capture_samples_.size();++sample) {
+        if(capture_samples_[sample]>=uint32_t(n))continue;
+        kvmem::AcceptedAttentionRow row;
+        row.source_position=uint64_t(capture_begin_)+capture_samples_[sample];
+        for(size_t page=0;page<capture_pages_.size();++page) {
+            const double value=mass[sample*stride+page];
+            require(std::isfinite(value) && value>=0,"native attention feedback is non-finite");
+            if(value>0)row.mass.push_back({capture_pages_[page],value});
+        }
+        double total=0;for(const auto& edge:row.mass)total+=edge.mass;
+        if(!row.mass.empty() && std::abs(total-1)>.005)
+            throw std::runtime_error("native attention sample mass="+std::to_string(total)+
+                " at token="+std::to_string(row.source_position)+" does not cover its complete visible window");
+        if(!row.mass.empty())accepted_attention_.push_back(std::move(row));
+    }
+    if(output_phase_) {
+        const auto accepted=kvmem::accepted_output_samples(output_samples_,capture_tokens_.data(),uint32_t(n),think_open_,think_close_);
+        output_samples_=accepted.state;
+        for(const auto& row:accepted_attention_)feedback_.observe_output(row.mass);
+    } else {
+        for(int i=0;i<n;++i) {
+            if(capture_tokens_[size_t(i)]==think_open_)output_samples_.thinking=true;
+            if(capture_tokens_[size_t(i)]==think_close_)output_samples_.thinking=false;
+        }
+        if(!replaying_ && !accepted_attention_.empty())
+            feedback_.observe_prefill(uint64_t(capture_begin_),uint64_t(capture_begin_)+uint64_t(n),uint32_t(n),
+                accepted_attention_,capture_pages_);
+    }
+    graph_.include_feedback(feedback_.snapshot().bytes());
+}
+void KvmemMemory::trace(const char* event) const {
+    if (!options_.verify) return;
+    std::fprintf(stderr, "KVMEM_POLY event=%s frontier=%llu visible=%llu capacity=%d host_bytes=%llu query_tokens=%d selected=",
+        event, (unsigned long long)stamp_.frontier, (unsigned long long)visible_, capacity(),
+        (unsigned long long)storage_->charged_bytes(), query_tokens_);
+    for (size_t i = 0; i < resident_.size(); ++i) std::fprintf(stderr, "%s%llu", i ? "," : "", (unsigned long long)resident_[i]);
+    std::fprintf(stderr, "\n");
+}
+void KvmemMemory::storage_metrics() const {
+    if (!std::getenv("KVMEM_POLY_STORAGE_METRICS")) return;
+    const auto io=io_stats();
+    std::fprintf(stderr,"KVMEM_STORAGE host_bytes=%llu host_limit=%llu disk_bytes=%llu disk_limit=%llu read_bytes=%llu written_bytes=%llu errors=%llu\n",
+        (unsigned long long)host_bytes(),(unsigned long long)host_limit(),(unsigned long long)disk_bytes(),
+        (unsigned long long)disk_limit(),(unsigned long long)io.read_bytes,(unsigned long long)io.written_bytes,(unsigned long long)io.errors);
+}
+void KvmemMemory::check_fault(const char* stage) {
+    if (!fault_used_ && fault_ == stage) {
+        fault_used_ = true;
+        throw kvmem::MemoryError(kvmem::MemoryErrorCode::TransferFailed, std::string("injected KVMem failure at ") + stage);
+    }
+}
+} // namespace strata::poly
