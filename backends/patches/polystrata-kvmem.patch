+void KvmemOptions::validate(int context, int batch, int window, bool draft) const {
+    require(sessions >= 1 && sessions <= 16 && (sessions == 1 || (history_reuse && budget)),
+            "KVMem sessions must be 1..16; multiple histories require history reuse and a nonzero budget");
+    if (!budget) {
+        require(!history_reuse, "KVMem history reuse requires a nonzero KVMem budget");
+        require(!mtp, "KVMem MTP requires a nonzero KVMem budget");
+        require(!disk_mib && disk_path.empty(), "KVMem SSD requires a nonzero KVMem budget");
+        return;
+    }
+    require(budget >= 128 && budget % 64 == 0 && reserve >= 64 && reserve % 64 == 0,
+            "KVMem B/R must be positive multiples of 64, B >= 128");
+    require(uint64_t(budget) + reserve <= uint64_t(context), "KVMem B+R exceeds the logical context");
+    require(batch > 0 && uint64_t(batch) <= reserve, "KVMem prompt batch must not exceed R");
+    require(sink % 64 == 0 && recent >= 64 && recent % 64 == 0 && uint64_t(sink) + recent <= budget,
+            "KVMem sink/recent must align to 64, recent >= 64, and fit B");
+    require(host_mib > 0 && host_mib <= (uint64_t(1) << 24), "invalid KVMem Host MiB budget");
+    require(disk_mib <= (uint64_t(1) << 24) && (disk_mib > 0) == !disk_path.empty(),
+            "KVMem SSD requires both a directory and positive Disk MiB budget");
+    require(std::isfinite(lrfu_lambda) && lrfu_lambda >= 0 && lrfu_lambda <= 1 &&
+            std::isfinite(lrfu_top_fraction) && lrfu_top_fraction > 0 && lrfu_top_fraction <= 1,
+            "invalid KVMem LRFU coefficients");
+    require(mtp ? (window >= 2 && window <= 4 && draft) : (window == 1 && !draft),
+            "KVMem requires --window 1 --no-draft, or --kvmem-mtp with --window 2..4 (one to three drafts)");
+    require(query_max_tokens>0 && query_max_tokens<=8192 && replay_max_tokens>0 && replay_max_tokens<=65536,
+            "invalid bounded Query/replay limits");
+    kvmem::validate_query_scoring(scorer,int(aggregation),graph_alpha);
+    require(query_begin >= -1 && query_end >= -1 && ((query_begin < 0) == (query_end < 0)),
+            "KVMem query begin/end must be specified together");
+    require(query_begin < 0 || query_end > query_begin, "KVMem query must be nonempty");
+}
