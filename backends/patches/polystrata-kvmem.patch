+            float got[4];check(cudaMemcpy(got,mass,sizeof(got),cudaMemcpyDeviceToHost));
+            for(int sample=0;sample<2;++sample) {
+                double expected[2]={0,0};const int row=sample_rows[sample],end=compact+row+1;
