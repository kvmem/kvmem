+KvmemMemory::KvmemMemory(Engine& engine, std::vector<KvmemPlane> planes,
+                         uint32_t heads, uint32_t kv_heads, uint32_t dim)
+    : engine_(engine), options_(engine.opt_.memory), planes_(std::move(planes)),
+      heads_(heads), kv_heads_(kv_heads), dim_(dim), key_width_(kv_heads * dim), query_width_(heads * dim),
+      storage_(engine.shared_storage_ ? engine.shared_storage_ : (engine.shared_storage_=storage(options_))) {
+    require(!planes_.empty(), "KVMem requires at least one full-attention layer");
+    descriptor_.identity = {"polystrata", "974552f+kvmem-v2",
+        std::filesystem::absolute(engine.opt_.model).string(),
+        "qwen35-gdn-f32-v1"};
+    auto& layout = descriptor_.layout;
+    const bool q8 = engine.opt_.kv_format == KvFmt::kQ8_0;
+    layout.format = q8 ? "polystrata-qwen35-native-q8_0-v1" : "polystrata-qwen35-native-f16-v1";
+    layout.version = 1;
+    layout.block_tokens = block_tokens;
+    layout.alignment = alignof(uint16_t);
+    const auto add = [&](uint32_t layer, kvmem::PayloadPlaneKind kind, void* pointer, uint64_t row, uint64_t alignment) {
+        require(pointer != nullptr, "KVMem native plane has no device allocation");
+        layout.planes.push_back({layer,kind,layout.record_bytes,row*block_tokens,alignment,row});
+        layout.record_bytes += row*block_tokens;
+        payload_.push_back(static_cast<uint8_t*>(pointer));
+    };
+    for (const auto& plane : planes_) {
+        if (q8) {
+            add(plane.layer,kvmem::PayloadPlaneKind::Key,plane.key_codes,key_width_,1);
+            add(plane.layer,kvmem::PayloadPlaneKind::KeyScale,plane.key_scales,key_width_/32*2,2);
+            add(plane.layer,kvmem::PayloadPlaneKind::Value,plane.value_codes,key_width_,1);
+            add(plane.layer,kvmem::PayloadPlaneKind::ValueScale,plane.value_scales,key_width_/32*2,2);
+        } else {
+            add(plane.layer,kvmem::PayloadPlaneKind::Key,plane.keys,uint64_t(key_width_)*2,2);
+            add(plane.layer,kvmem::PayloadPlaneKind::Value,plane.values,uint64_t(key_width_)*2,2);
+        }
+    }
+    descriptor_.capabilities = {block_tokens, uint64_t(engine.max_context()), true, true, true, true, true, false};
+    descriptor_.validate();
+    if (options_.disk_mib)
+        require(layout.record_bytes <= disk_limit() && (uint64_t(pages(capacity()))+1)*layout.record_bytes <= host_limit(),
+                "KVMem SSD RAM must cover B+R native staging and one replacement record");
+    kvmem::RawKvStoreConfig stats;
+    stats.n_layer = uint32_t(planes_.size());
+    stats.n_embd_k = key_width_;
+    stats.n_embd_v = key_width_;
+    stats.block_tokens = block_tokens;
+    statistics_ = std::make_unique<kvmem::RawKvStore>(stats);
+    kvmem::KvMemStoreConfig policy;
+    policy.block_tokens = block_tokens;
+    policy.select_budget = options_.budget;
+    policy.prefill_budget = options_.budget;
+    policy.gen_budget = options_.reserve;
+    policy.sink_blocks = options_.sink / block_tokens;
+    policy.recent_blocks = options_.recent / block_tokens;
+    policy.lrfu = options_.lrfu;
+    policy.lrfu_lambda = options_.lrfu_lambda;
+    policy.lrfu_top_fraction = options_.lrfu_top_fraction;
+    selector_ = std::make_unique<kvmem::KvMemStore>(policy);
+    const size_t staging = size_t(capacity()) * size_t(layout.record_bytes / block_tokens);
+    ck(cudaMallocHost(reinterpret_cast<void**>(&out_),staging),"KVMem native transfer staging");
+    out_owner_.reset(out_);
+    ck(cudaMallocHost(reinterpret_cast<void**>(&in_),staging),"KVMem native transfer staging");
+    in_owner_.reset(in_);
+    if (options_.disk_mib) io_queue_ = std::make_unique<kvmem::StorageIoQueue>(1,2*staging,1);
+    query_sum_.resize(planes_.size() * query_width_);
+    if(const auto* vocabulary=engine_.gg_->get("tokenizer.ggml.tokens"))
+        for(size_t i=0;i<vocabulary->items.size();++i) {
+            if(vocabulary->items[i].s=="<think>")think_open_=int32_t(i);
+            if(vocabulary->items[i].s=="</think>")think_close_=int32_t(i);
+        }
+    if (options_.scorer==kvmem::QueryScorer::PageSoftmax) {
+        if (!engine_.shared_recall_) {
+            const auto bytes=kvmem::PageSoftmaxCuda::workspace_bytes(pages(engine.max_context()),heads_,kv_heads_,dim_);
+            engine_.shared_recall_=std::make_shared<kvmem::PageSoftmaxCuda>(engine_.device_,engine_.dmalloc(bytes,"KVMem Query scoring"),
+                bytes,pages(engine.max_context()),heads_,kv_heads_,dim_);
+        }
+        cuda_recall_=engine_.shared_recall_;
+    }
+    if (const char* fault = std::getenv("KVMEM_POLY_TEST_FAULT")) fault_ = fault;
+    reset();
+}
