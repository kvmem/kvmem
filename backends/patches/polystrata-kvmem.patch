diff --git a/src/poly/kvmem_history.hpp b/src/poly/kvmem_history.hpp
new file mode 100644
index 00000000..920e1c2d
--- /dev/null
+++ b/src/poly/kvmem_history.hpp
@@ -0,0 +1,75 @@
+// A managed conversation's evaluated tokens and bounded native state marks.
+// Planning is model-free. KV stays in KvmemMemory's existing bounded archive;
+// this class never copies a full attention cache or owns GPU memory.
+#pragma once
+#include "kvmem.hpp"
+#include "kvmem/prefix_checkpoint.hpp"
+
+#include <algorithm>
+#include <memory>
+#include <stdexcept>
+#include <vector>
+
+namespace strata::poly {
+class KvmemHistory {
+    struct Mark {
+        kvmem::CheckpointPurpose purposes = kvmem::CheckpointPurpose::Endpoint;
+        std::shared_ptr<const KvmemCheckpoint> data;
+        kvmem::CheckpointInfo checkpoint_info() const {
+            return {data->identity.stamp.frontier, purposes, data.get(),
+                    data->state.size() + data->mean_tail.size() * sizeof(float) +
+                    data->resident.capacity()*sizeof(uint64_t) + data->graph.bytes() + data->feedback.bytes()};
+        }
+    };
+public:
+    struct Resume {
+        int64_t at = 0;
+        std::shared_ptr<const KvmemCheckpoint> checkpoint;
+    };
+    void clear() { tokens_.clear(); marks_.clear(); session_ = {}; }
+    void bind(const kvmem::MemoryStamp& stamp) { session_ = stamp.session; }
+    size_t size() const noexcept { return tokens_.size(); }
+    const std::vector<int32_t>& tokens() const noexcept { return tokens_; }
+    size_t marks() const noexcept { return marks_.size(); }
+    std::shared_ptr<const KvmemCheckpoint> latest() const { return marks_.empty() ? nullptr : marks_.back().data; }
+    size_t observed_prefix(const std::vector<int32_t>& ids) const {
+        size_t common = 0;
+        while (common < std::min(ids.size(), tokens_.size()) && ids[common] == tokens_[common]) ++common;
+        return common;
+    }
+    void append(const int32_t* ids, size_t count) { tokens_.insert(tokens_.end(), ids, ids + count); }
+    void truncate(int64_t at) {
+        if (at < 0 || uint64_t(at) > tokens_.size()) throw std::logic_error("KVMem history truncation exceeds its prefix");
+        tokens_.resize(size_t(at));
+        marks_.truncate(uint64_t(at));
+    }
+    Resume choose(const std::vector<int32_t>& ids, int64_t query_begin, const kvmem::MemoryStamp& stamp) const {
+        if (!stamp.valid || !(stamp.session == session_) || stamp.frontier != tokens_.size() || ids.empty()) return {};
+        const auto common = observed_prefix(ids);
+        // Query Q must be recaptured, even for an identical request or an
+        // explicitly enlarged query span. Always leave the last token for logits.
+        const int64_t limit = std::min<int64_t>(query_begin,
+            kvmem::prefix_restore_limit(common, tokens_.size(), ids.size(), true));
+        if (limit > 0 && common == tokens_.size() && int64_t(common) <= limit)
+            return {int64_t(common), nullptr};
+        if (limit < 0) return {};
+        const auto best = marks_.select(uint64_t(limit), [&](const auto& mark) {
+            const auto& saved = mark.data->identity.stamp;
+            return saved.valid && saved.session == session_;
+        });
+        return best ? Resume{int64_t(best->data->identity.stamp.frontier), best->data} : Resume{};
+    }
+    void remember(std::shared_ptr<const KvmemCheckpoint> cp,
+                  kvmem::CheckpointPurpose purpose = kvmem::CheckpointPurpose::Endpoint) {
