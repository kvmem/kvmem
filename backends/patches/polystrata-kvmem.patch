+void KvmemMemory::rebind(std::vector<KvmemPlane> planes) {
+    require(!transaction_ && planes.size()==planes_.size(),"cannot rebind incompatible or busy KVMem planes");
+    planes_=std::move(planes);payload_.clear();
+    const bool q8=descriptor_.layout.format.find("q8_0")!=std::string::npos;
+    for(const auto& p:planes_) {
+        if(q8) {
+            payload_.push_back(reinterpret_cast<uint8_t*>(p.key_codes));
+            payload_.push_back(reinterpret_cast<uint8_t*>(p.key_scales));
+            payload_.push_back(reinterpret_cast<uint8_t*>(p.value_codes));
+            payload_.push_back(reinterpret_cast<uint8_t*>(p.value_scales));
+        } else {
+            payload_.push_back(reinterpret_cast<uint8_t*>(p.keys));
+            payload_.push_back(reinterpret_cast<uint8_t*>(p.values));
+        }
+    }
+    for(auto* p:payload_) require(p!=nullptr,"rebound KVMem plane has no device allocation");
+}
+int KvmemMemory::capacity() const { return int(options_.budget + options_.reserve); }
+int KvmemMemory::append_room() const {
+    return resident_.size() == versions_.size() ? std::max(int(options_.reserve), capacity() - int(visible_))
+                                               : int(options_.reserve);
