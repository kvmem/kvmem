+// cfg: logical/compact call starts, frame start/count, physical page count,
+// first sample and sample count for this call. Indices are frame-relative rows.
+void kvmem_page_mass(const float* query,const uint16_t* keys,Kvq8 q8,int dim,int heads,int kv_heads,
