+    assert_eq!(
+        legacy.layerwise_keep_set(0),
+        Some(&[][..]),
+        "Legacy: empty keep-set"
+    );
+    assert!(
+        legacy
+            .ensure_layerwise_pressure(0, 0, 0, &fa_layers)
