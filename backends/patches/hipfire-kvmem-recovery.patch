+/// 期2.3: KeepSelected only with a proven, already-effective query that
+/// fits; a new query keeps Pressure and reserves the Query envelope.
+#[test]
+fn import_decision_keep_selected_vs_new_query() {
+    let q = (1000u64, 1100u64);
