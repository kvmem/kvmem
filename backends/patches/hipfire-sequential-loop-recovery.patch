+    pub stopped: bool,
+    /// The detector tripped but `Recover` declined; the pass kept generating.
+    pub unavailable: Option<&'static str>,
+    /// `(output tokens, coverage)` of the last tripped look.
+    pub trip: Option<(usize, f64)>,
+}
