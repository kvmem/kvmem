+void phase_credit_covers_real_captures() {
+    using namespace ninfer::models::qwen3_5::detail;
+    constexpr size_t stride=16, page_tokens=64;
+    for (const size_t frontier : {size_t(1),size_t(8),size_t(63),size_t(64),size_t(65)}) {
+        HostKvStorage storage(12*stride);
+        std::vector<HostKvRecord> archive;
+        const auto pages=(frontier+page_tokens-1)/page_tokens;
+        for (size_t i=0;i<pages;++i) { archive.push_back(storage.allocate(stride));archive.back().seal(); }
+        const auto primary=storage.charged_bytes();
+        auto query=capture_kvmem_snapshot(archive,pages,frontier%page_tokens!=0,storage);
+        const auto private_bytes=storage.charged_bytes()-primary;
+        require(private_bytes==(frontier%page_tokens ? stride : 0));
+
+        // Real partial-tail capture consumes future-growth slack, not another
+        // whole-page charge above an already larger complete-history quote.
+        const auto envelope=kvmem_payload_envelope(8*stride,primary,private_bytes);
+        require(envelope==8*stride);
+        KvmemPayloadBudget budget;
+        budget.reserve(envelope);
+        uint64_t credit=envelope;
+        for (const auto& record:archive) budget.require(record.storage_identity(),record.size(),credit);
+        query->account([&](const void* id,size_t bytes){budget.require(id,bytes,credit);});
+        require(budget.used()==envelope && credit==envelope-storage.charged_bytes());
+        auto alias=query;
+        const auto after_capture=credit;
+        alias->account([&](const void* id,size_t bytes){budget.require(id,bytes,credit);});
+        require(credit==after_capture && budget.used()==envelope);
+
+        // At a short output frontier the temporary real allocation is instead
+        // the phase peak. It cannot disappear behind a smaller history quote.
+        const auto short_envelope=kvmem_payload_envelope(primary,primary,private_bytes);
+        require(short_envelope==storage.charged_bytes());
+        KvmemPayloadBudget short_budget;
+        short_budget.reserve(short_envelope);
+        uint64_t short_credit=short_envelope;
+        for (const auto& record:archive) short_budget.require(record.storage_identity(),record.size(),short_credit);
+        query->account([&](const void* id,size_t bytes){short_budget.require(id,bytes,short_credit);});
+        require(short_credit==0 && short_budget.used()==storage.charged_bytes());
+        alias.reset();query.reset();archive.clear();require(storage.charged_bytes()==0);
+    }
+
+    // Multiple optional versions can exhaust the same future-growth envelope.
+    // Distinct real tail identities above that envelope remain fully charged.
+    HostKvStorage storage(8*stride);
+    std::vector<HostKvRecord> archive;
+    archive.push_back(storage.allocate(stride));archive.back().seal();
+    KvmemPayloadBudget budget;budget.reserve(4*stride);
+    budget.cover(archive.front().storage_identity());
+    uint64_t credit=3*stride;
+    std::vector<std::shared_ptr<const KvSnapshot>> captures;
+    for (size_t count=1;count<=4;++count) {
+        captures.push_back(capture_kvmem_snapshot(archive,1,true,storage));
+        captures.back()->account([&](const void* id,size_t bytes){budget.require(id,bytes,credit);});
+        require(storage.charged_bytes()==(count+1)*stride);
+        require(budget.used()==(count<=3 ? 4 : 5)*stride);
+        require(budget.fits(4*stride)==(count<=3));
+    }
+    require(credit==0);
+    // A foreign reader is a real surviving owner after this request releases
+    // its reservations and every checkpoint directory. It gets no old credit.
+    auto work=captures.back()->blocks().front()->record();
+    const auto work_id=work.storage_identity();
+    captures.clear();archive.clear();require(storage.charged_bytes()==stride);
+    KvmemPayloadBudget cancelled;
+    cancelled.require(work_id,work.size());cancelled.require(work_id,work.size());
+    require(cancelled.used()==storage.charged_bytes());
+    work={};require(storage.charged_bytes()==0);
+
+    const auto maximum=std::numeric_limits<uint64_t>::max();
+    bool rejected=false;
+    try { (void)kvmem_payload_envelope(maximum,maximum,1); }
+    catch(const std::overflow_error&) { rejected=true; }
+    require(rejected); // max(history, ...) cannot conceal an overflowing phase.
+    KvmemPayloadBudget overflow;overflow.reserve(maximum-3);
+    uint64_t allowance=2;int identity=0;
+    rejected=false;
+    try { overflow.require(&identity,6,allowance); }
+    catch(const std::overflow_error&) { rejected=true; }
+    require(rejected && overflow.used()==maximum-3 && allowance==2);
+    overflow.require(&identity,5,allowance);
+    require(overflow.used()==maximum && allowance==0);
+    allowance=2;overflow.require(&identity,5,allowance);
+    require(allowance==2); // A duplicate cannot spend a second owner's credit.
+    rejected=false;
+    try { overflow.reserve(3,allowance); }
+    catch(const std::overflow_error&) { rejected=true; }
+    require(rejected && overflow.used()==maximum && allowance==2);
+    overflow.reserve(2,allowance);require(overflow.used()==maximum && allowance==0);
+}
