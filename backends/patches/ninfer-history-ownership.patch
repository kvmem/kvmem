+void only_storage_budget_becomes_request_overload() {
+    using ninfer::runtime::request_storage_failure;
+    HostKvStorage storage(16);
+    std::array<uint8_t,16> expected{};expected.fill(71);
+    auto peer=storage.allocate(expected.size(),expected.data());peer.seal();
+    std::exception_ptr exhausted;
+    try { (void)storage.allocate(1); }
+    catch(const MemoryError& error) {
+        require(error.code()==MemoryErrorCode::BudgetExceeded);
+        exhausted=std::current_exception();
+    }
+    require(bool(exhausted));
+    std::string original;
+    try { std::rethrow_exception(exhausted); }
+    catch(const MemoryError& error) { original=error.what(); }
+    bool overloaded=false;
+    try { std::rethrow_exception(request_storage_failure(exhausted)); }
+    catch(const ninfer::RequestError& error) {
+        overloaded=error.kind()==ninfer::RequestErrorKind::Overloaded && original==error.what();
+    }
+    require(overloaded && storage.charged_bytes()==16);
+    require(std::equal(expected.begin(),expected.end(),peer.data()));
+    require(!request_storage_failure({}));
+    for(const auto code : {MemoryErrorCode::InvalidPlan,MemoryErrorCode::Unsupported,
+            MemoryErrorCode::Stale,MemoryErrorCode::Pending,MemoryErrorCode::TransferFailed,
+            MemoryErrorCode::Disconnected,MemoryErrorCode::InvalidSession}) {
+        const auto error=std::make_exception_ptr(MemoryError(code,"preserve storage failure"));
+        require(request_storage_failure(error)==error);
+        try { std::rethrow_exception(request_storage_failure(error)); }
+        catch(const MemoryError& value) { require(value.code()==code); }
+    }
+    const auto invariant=std::make_exception_ptr(std::logic_error("checkpoint invariant"));
+    const auto nonstandard=std::make_exception_ptr(17);
+    const auto already_classified=std::make_exception_ptr(ninfer::RequestError(
+        ninfer::RequestErrorKind::Unavailable,"worker unavailable"));
+    require(request_storage_failure(invariant)==invariant);
+    require(request_storage_failure(nonstandard)==nonstandard);
+    require(request_storage_failure(already_classified)==already_classified);
+}
