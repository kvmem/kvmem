+void evicted_source_running_read_keeps_exact_charge() {
+    constexpr size_t stride=16, history_pages=48;
+    auto disk=std::make_shared<SpillFile>(std::filesystem::temp_directory_path(),history_pages*stride);
+    HostKvStorage storage(stride,disk);
+    std::array<uint8_t,stride> expected{};expected.fill(43);
+    std::vector<HostKvRecord> directory_archive;
+    directory_archive.push_back(storage.allocate(stride,expected.data()));directory_archive.back().seal();
+    auto selected=capture_kvmem_snapshot(directory_archive,1,false,storage);
+    for(size_t i=1;i<history_pages;++i) {
+        directory_archive.push_back(storage.allocate(stride));directory_archive.back().seal();
+    }
+    auto branch=fork_kvmem_snapshot(*selected);
+    const auto read_identity=branch[0].storage_identity();
+    auto read_source=branch[0].source();
+    storage.trim(0);
+    require(storage.charged_bytes()==0 && disk->charged_bytes()==history_pages*stride);
+    std::promise<void> started,release;
+    auto gate=release.get_future().share();
+    std::array<uint8_t,stride> actual{};
+    StorageIoQueue queue(2,2*stride,1);
+    OpenGateOnExit release_on_error{release};
+    auto running=queue.submit(stride,[source=read_source,&started,gate,&actual] {
+        auto lease=source.lease();started.set_value();gate.wait();
+        lease.read(0,actual.data(),actual.size());
+    });
+    started.get_future().wait();
+    // The pending copy also owns its source, but cancellation releases it.
+    std::atomic<bool> queued_published{false};
+    auto queued=queue.submit(stride,[source=read_source,&queued_published] { queued_published=true; });
+    require(queued.cancel());
+    require(!running.cancel()); // Started work must drain; it is not freed early.
+    directory_archive.clear();selected.reset();branch.clear();read_source={};
+    require(storage.charged_bytes()==0 && disk->charged_bytes()==stride);
+    require(queue.pinned_bytes()==stride);
+    ninfer::models::qwen3_5::detail::KvmemPayloadBudget cancelled;
+    cancelled.require(read_identity,stride);
+    require(cancelled.used()==disk->charged_bytes());
+    release.set_value();running.wait();
+    try { queued.wait(); } catch(const MemoryError&) {}
+    require(actual==expected && !queued_published);
+    require(storage.charged_bytes()==0 && disk->charged_bytes()==0 && queue.pinned_bytes()==0);
+}
