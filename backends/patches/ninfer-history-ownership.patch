@@ -0,0 +1,55 @@
+#pragma once
+
+#include <cstdint>
+#include <algorithm>
+#include <limits>
+#include <stdexcept>
+#include <unordered_set>
+
+namespace ninfer::models::qwen3_5::detail {
+// A future archive and a temporary prefill checkpoint have different lifetimes.
+// Reserve their largest simultaneous live set, not their sum across phases.
+inline std::uint64_t kvmem_payload_envelope(std::uint64_t history,
+        std::uint64_t prefill, std::uint64_t execution_private) {
+    if (execution_private > std::numeric_limits<std::uint64_t>::max() - prefill)
+        throw std::overflow_error("KVMem payload phase overflow");
+    return std::max(history, prefill + execution_private);
+}
+// A reservation pays for its archive once. Immutable snapshots and in-flight
+// readers can share those records, but private versions retain their own charge.
+// Establish every covered identity before adding the remaining owners.
+class KvmemPayloadBudget {
+public:
+    void reserve(std::uint64_t bytes) {
+        if (bytes > std::numeric_limits<std::uint64_t>::max() - used_)
+            throw std::overflow_error("KVMem payload reservation overflow");
+        used_ += bytes;
+    }
+    void cover(const void* identity) { if (identity) identities_.insert(identity); }
+    void require(const void* identity, std::uint64_t bytes) {
+        std::uint64_t credit = 0;
+        require(identity, bytes, credit);
+    }
+    // Credit is an already-reserved, finite phase envelope. Each physical
+    // identity consumes it once; exhausted credit never hides additional bytes.
+    void require(const void* identity, std::uint64_t bytes, std::uint64_t& credit) {
+        if (!identity || identities_.find(identity)!=identities_.end()) return;
+        const auto funded = std::min(bytes, credit);
+        if (bytes - funded > std::numeric_limits<std::uint64_t>::max() - used_)
+            throw std::overflow_error("KVMem payload reservation overflow");
+        identities_.insert(identity);
+        credit -= funded;
+        used_ += bytes - funded;
+    }
+    void reserve(std::uint64_t bytes, std::uint64_t& credit) {
+        const auto funded = std::min(bytes, credit);
+        reserve(bytes - funded);
+        credit -= funded;
+    }
+    std::uint64_t used() const noexcept { return used_; }
+    bool fits(std::uint64_t limit) const noexcept { return used_ <= limit; }
+private:
+    std::uint64_t used_ = 0;
+    std::unordered_set<const void*> identities_;
+};
+} // namespace ninfer::models::qwen3_5::detail
