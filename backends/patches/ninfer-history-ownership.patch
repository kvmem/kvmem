+void prepared_payload_budget_counts_real_owners() {
+    using ninfer::models::qwen3_5::detail::KvmemPayloadBudget;
+    constexpr size_t stride=16;
+    HostKvStorage storage(128);
+    std::vector<HostKvRecord> archive;
+    for(size_t i=0;i<2;++i) { archive.push_back(storage.allocate(stride));archive.back().seal(); }
+    auto checkpoint=capture_kvmem_snapshot(archive,2,true,storage);
+    auto prepared=fork_kvmem_snapshot(*checkpoint);
+    // An old-tail reader outlives eviction of the archive that created it.
+    const auto old_tail=archive[1].storage_identity();
+    auto reader=archive[1].source();
+    archive.clear();
+    require(storage.charged_bytes()==3*stride);
+    KvmemPayloadBudget before;
+    before.reserve(4*stride); // Complete request archive, including future growth.
+    for(const auto& record:prepared) before.cover(record.storage_identity());
+    checkpoint->account([&](const void* id,size_t bytes){before.require(id,bytes);});
+    before.require(old_tail,stride);before.require(old_tail,stride);
+    require(before.used()==5*stride && before.fits(5*stride) && !before.fits(5*stride-1));
+
+    // Writing a shared partial tail creates a distinct version. The sealed CP
+    // and an in-flight old-tail reader each cost one additional record, even
+    // though the source's cache directory is already gone.
+    const uint8_t replacement=51;
+    prepared.back().write(0,&replacement,1);prepared.back().seal();
+    require(storage.charged_bytes()==4*stride);
+    KvmemPayloadBudget after;
+    after.reserve(4*stride);
+    for(const auto& record:prepared) after.cover(record.storage_identity());
+    checkpoint->account([&](const void* id,size_t bytes){after.require(id,bytes);});
+    after.require(old_tail,stride);
+    require(after.used()==6*stride && !after.fits(5*stride));
+    reader={};require(storage.charged_bytes()==3*stride);
+    KvmemPayloadBudget drained;
+    drained.reserve(4*stride);
+    for(const auto& record:prepared) drained.cover(record.storage_identity());
+    checkpoint->account([&](const void* id,size_t bytes){drained.require(id,bytes);});
+    require(drained.used()==5*stride && drained.fits(5*stride));
+    checkpoint.reset();prepared.clear();require(storage.charged_bytes()==0);
+
+    KvmemPayloadBudget overflow;
+    const auto maximum=std::numeric_limits<uint64_t>::max();
+    overflow.reserve(maximum-7);
+    bool rejected=false;
+    try { overflow.reserve(8); } catch(const std::overflow_error&) { rejected=true; }
+    require(rejected && overflow.used()==maximum-7);
+    int allocation_identity=0;
+    rejected=false;
+    try { overflow.require(&allocation_identity,8); } catch(const std::overflow_error&) { rejected=true; }
+    require(rejected && overflow.used()==maximum-7);
+    // A rejected addition cannot poison de-duplication for the same identity.
+    overflow.require(&allocation_identity,7);
+    require(overflow.used()==maximum && overflow.fits(maximum));
+    overflow.require(&allocation_identity,7);
+    require(overflow.used()==maximum);
+}
