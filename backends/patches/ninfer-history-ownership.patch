+// Exercise the same native capture/fork helpers used by history preparation.
+// A selected prefix must not keep the unrelated suffix alive through its parent
+// directory owner, including when the selected frontier is a partial KV page.
+void evict_long_source_after_fork() {
+    constexpr size_t stride=16, history_pages=320, page_tokens=64;
+    for (const size_t frontier : {size_t(1),size_t(8),size_t(63),size_t(64),size_t(65),size_t(4097),size_t(18000)}) {
+        HostKvStorage storage((history_pages+3)*stride);
+        const auto prefix_pages=(frontier+page_tokens-1)/page_tokens;
+        std::vector<HostKvRecord> directory_archive;
+        const auto append=[&](size_t page) {
+            std::array<uint8_t,stride> value{};
+            for(size_t i=0;i<stride;++i) value[i]=uint8_t(page*11+i);
+            directory_archive.push_back(storage.allocate(stride,value.data()));
+            directory_archive.back().seal();
+        };
+        for(size_t page=0;page<prefix_pages;++page) append(page);
+        auto selected=capture_kvmem_snapshot(directory_archive,prefix_pages,frontier%page_tokens!=0,storage);
+        const auto expected=selected->read();
+        for(size_t page=prefix_pages;page<history_pages;++page) append(page);
+        auto endpoint=capture_kvmem_snapshot(directory_archive,history_pages,false,storage);
+        auto first=fork_kvmem_snapshot(*selected), second=fork_kvmem_snapshot(*selected);
+        const auto before=storage.charged_bytes();
+        require(before>=history_pages*stride);
+
+        // Evict the parent entry, not the immutable data held by each request.
+        directory_archive.clear();endpoint.reset();
+        require(storage.charged_bytes()==prefix_pages*stride);
+        require(before-storage.charged_bytes()>=(history_pages-prefix_pages)*stride);
+        require(selected->read()==expected);
+        for(size_t page=0;page<prefix_pages;++page) {
+            std::array<uint8_t,stride> got{};
+            second[page].read(0,got.data(),stride);
+            require(std::equal(got.begin(),got.end(),expected.begin()+page*stride));
+        }
+        // Reusing the directory's containers must not redirect either branch.
+        append(999);
+        auto replacement=capture_kvmem_snapshot(directory_archive,1,false,storage);
+        require(replacement->read()!=std::vector<uint8_t>(expected.begin(),expected.begin()+stride));
+        require(selected->read()==expected);
+        directory_archive.clear();replacement.reset();
+
+        const uint8_t changed=uint8_t(expected.back()^0xff);
+        first.back().write(stride-1,&changed,1);first.back().seal();
+        require(storage.charged_bytes()==(prefix_pages+1)*stride);
+        require(selected->read()==expected);
+        first.clear(); // Cancelling one request preserves the other and its CP.
+        require(storage.charged_bytes()==prefix_pages*stride);
+        selected.reset();
+        require(storage.charged_bytes()==prefix_pages*stride);
+        second.clear();require(storage.charged_bytes()==0);
+    }
+}
