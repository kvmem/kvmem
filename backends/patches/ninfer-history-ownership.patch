+#pragma once
+
+#include "kvmem/memory_contract.hpp"
+#include "ninfer/request.h"
+#include <exception>
+
+namespace ninfer::runtime {
+// Only the already-owned storage-failure path uses this conversion. Capacity
+// is an expected request failure; corruption, I/O and invariants keep their type.
+inline std::exception_ptr request_storage_failure(std::exception_ptr error) {
+    if (!error) return error;
+    try { std::rethrow_exception(error); }
+    catch (const kvmem::MemoryError& failure) {
+        if (failure.code() == kvmem::MemoryErrorCode::BudgetExceeded)
+            return std::make_exception_ptr(RequestError(RequestErrorKind::Overloaded, failure.what()));
+    } catch (...) {}
+    return error;
+}
+} // namespace ninfer::runtime
