diff --git a/src/models/qwen3_5/program/storage/unique_query_anchor.h b/src/models/qwen3_5/program/storage/unique_query_anchor.h
new file mode 100644
index 0000000000000000000000000000000000000000..ec363a1308eb571d93c4c1c056b3874472b3076d
--- /dev/null
+++ b/src/models/qwen3_5/program/storage/unique_query_anchor.h
@@ -0,0 +1,65 @@
+#pragma once
+
+#include <algorithm>
+#include <array>
+#include <cstdint>
+#include <span>
+#include <stdexcept>
+
+namespace ninfer::models::qwen3_5::detail {
+
+struct UniqueQueryAnchor {
+    std::array<std::uint32_t, 2> pages{};
+    std::uint32_t count = 0;
+};
+
+// An optional exact-text companion for short queries. Work is bounded by one
+// pass over history and 64 comparisons per history token. No history-sized
+// table, tokenizer, document labels, decoded strings or model outputs are used.
+inline UniqueQueryAnchor unique_query_anchor(std::span<const std::int32_t> history,
+        std::span<const std::int32_t> query, std::uint32_t page_tokens,
+        std::uint32_t budget_pages, std::uint32_t sink_pages, std::uint32_t recent_pages) {
+    if (!page_tokens || page_tokens % 2 || sink_pages > budget_pages ||
+        recent_pages > budget_pages - sink_pages || history.size() % page_tokens ||
+        history.size() > UINT32_MAX)
+        throw std::invalid_argument("invalid native exact Query anchor geometry");
+    constexpr std::size_t limit = 64;
+    const auto threshold = page_tokens / 2;
+    const auto history_pages = static_cast<std::uint32_t>(history.size() / page_tokens);
+    if (query.size() < threshold || query.size() > limit || history_pages <= budget_pages ||
+        budget_pages == sink_pages + recent_pages)
+        return {};
+
+    // row[j] is the length of the matching suffix ending at query[j-1] and
+    // the current history token. Descending order preserves the preceding row.
+    std::array<std::uint8_t, limit+1> row{};
+    std::uint32_t best = 0, best_end = 0;
+    bool unique = false;
+    for (std::uint32_t i = 0; i < history.size(); ++i) {
+        for (std::size_t j = query.size(); j > 0; --j) {
+            const std::uint32_t length = history[i] == query[j-1] ? row[j-1] + 1 : 0;
+            row[j] = static_cast<std::uint8_t>(length);
+            if (length > best) {
+                best = length;
+                best_end = i + 1;
+                unique = true;
+            } else if (length == best && best_end != i + 1) {
+                unique = false;
+            }
+        }
+    }
+    if (!unique || best < threshold) return {};
+    const auto first = (best_end - best) / page_tokens;
+    const auto last = (best_end - 1) / page_tokens;
+    // Only pages actually touched by the matched passage are candidates.
+    // Never expand to neighboring text or displace a mandatory sink/recent page.
+    UniqueQueryAnchor anchor;
+    if (last - first + 1 > anchor.pages.size()) return {};
+    for (auto page = first; page <= last; ++page) {
+        if (page >= sink_pages && page < history_pages - recent_pages)
+            anchor.pages[anchor.count++] = page;
+    }
+    if (anchor.count > budget_pages - sink_pages - recent_pages) return {};
+    return anchor;
+}
+} // namespace ninfer::models::qwen3_5::detail
