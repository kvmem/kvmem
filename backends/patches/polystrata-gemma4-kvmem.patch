+void Gemma4::prepare_memory_capture(const int32_t* tokens,int n) {
+    // Full resident requests never consume captured Query rows. Avoid locking
+    // their maximum host workspace until an actual bounded Query needs it.
+    if(memory_->capture_query() && !h_memory_queries_)
+        h_memory_queries_=static_cast<float*>(hmalloc(size_t(n_attn_)*opt_.memory.query_max_tokens*n_head_*head_dim_*sizeof(float),
+                                                    "KVMem bounded Query staging"));
+    memory_->prepare_capture(tokens,n);
+    auto& capture=memory_feedback_.at(size_t(bound_));
+    const auto& rows=memory_->capture_samples();
+    if(!rows.empty()) {
+        ck(cudaMemcpyAsync(capture.rows,rows.data(),rows.size()*sizeof(uint32_t),cudaMemcpyHostToDevice,cs(st_)),
+            "KVMem attention sample rows");
+        ck(cudaMemsetAsync(capture.mass,0,rows.size()*memory_page_stride_*sizeof(float),cs(st_)),
+            "KVMem attention feedback clear");
+    }
+    feedback_call(*memory_,bound_,pos_,n);
+}
+void Gemma4::feedback_call(KvmemMemory& memory,int seq,int64_t first,int n) {
+    auto& capture=memory_feedback_.at(size_t(seq));
+    const auto& samples=memory.capture_samples();
+    const int64_t relative=first-memory.capture_begin();
+    const auto lo=std::lower_bound(samples.begin(),samples.end(),uint32_t(std::max<int64_t>(0,relative)));
+    const auto hi=std::lower_bound(lo,samples.end(),uint32_t(std::max<int64_t>(0,relative+n)));
+    const std::array<int64_t,7> config={first,memory.compact_position(first),memory.capture_begin(),
+        int64_t(memory.capture_map().size()),int64_t(memory.capture_pages().size()),lo-samples.begin(),memory_reaccept_?0:hi-lo};
+    // An empty sample range does not read any coordinates. Keep the device's
+    // zero-count sentinel across unsampled halves instead of launching a
+    // setter at every layer. The first call still initializes that sentinel.
+    if(config[6]==0 && capture.last[6]==0)return;
+    if(config!=capture.last) {
+        capture.last=config;
+        kvmem_capture_config(capture.config,config.data(),st_);
+    }
+}
+void Gemma4::memory_capture_call(int64_t first,int n) {
+    if(memory_ && !memory_drafting_)feedback_call(*memory_,bound_,first,n);
+}
+void Gemma4::clear_memory_capture() {
+    memory_capture_staged_ = false;
+    const size_t total = memory_groups_ * n_attn_ * n_kv_ * head_dim_ + size_t(n_attn_) * n_head_ * head_dim_;
+    ck(cudaMemsetAsync(memory_ksums_, 0, total * sizeof(float), cs(st_)), "KVMem statistics clear");
+}
+void Gemma4::stage_memory_capture(int n) {
+    const size_t groups = (size_t(memory_batch_start_ % opt_.memory.block_tokens) + n + opt_.memory.block_tokens-1) / opt_.memory.block_tokens;
+    const size_t width = groups * n_kv_ * head_dim_;
+    // A pitched D2H copy submits a separate transfer for each attention layer.
+    // At this boundary score_ is dead; pack there and submit one small transfer.
+    const size_t count=width*n_attn_;
+    if(count<=size_t(chunk_)*n_head_*cache_capacity()) {
+        kvmem_pack_key_sums(memory_ksums_,score_,n_kv_*head_dim_,int(groups),n_attn_,int(memory_groups_),st_);
+        ck(cudaMemcpyAsync(h_memory_stats_,score_,count*sizeof(float),cudaMemcpyDeviceToHost,cs(st_)),
+           "KVMem packed key statistics");
+    } else
+        ck(cudaMemcpy2DAsync(h_memory_stats_, width * sizeof(float), memory_ksums_,
+            memory_groups_ * n_kv_ * head_dim_ * sizeof(float), width * sizeof(float), n_attn_,
+            cudaMemcpyDeviceToHost, cs(st_)), "KVMem key statistics");
+    float* query = h_memory_stats_ + width * n_attn_;
+    const bool capture = memory_->capture_query();
+    if (capture)
+        ck(cudaMemcpyAsync(query, memory_qsums_, size_t(n_attn_) * n_head_ * head_dim_ * sizeof(float),
+            cudaMemcpyDeviceToHost, cs(st_)), "KVMem query statistics");
+    const auto& attention=memory_feedback_.at(size_t(bound_));
+    const size_t samples=memory_->capture_samples().size(),pages=memory_->capture_pages().size();
+    if(samples)ck(cudaMemcpy2DAsync(attention.host,pages*sizeof(float),attention.mass,
+        memory_page_stride_*sizeof(float),pages*sizeof(float),samples,cudaMemcpyDeviceToHost,cs(st_)),
+        "KVMem native attention feedback");
+    memory_capture_staged_ = true;
+}
+void Gemma4::commit_memory_capture(int n) {
+    if (!memory_capture_staged_) {
+        stage_memory_capture(n);
+        ck(cudaStreamSynchronize(cs(st_)), "KVMem accepted capture");
+    }
+    // eval() staged these copies before its existing logits synchronization;
+    // read() reaches here without that synchronization and takes the branch
+    // above. Never publish CPU statistics from an incomplete device pass.
+    const size_t groups = (size_t(memory_batch_start_ % opt_.memory.block_tokens) + n + opt_.memory.block_tokens-1) / opt_.memory.block_tokens;
+    const size_t width = groups * n_kv_ * head_dim_;
+    float* query = h_memory_stats_ + width * n_attn_;
+    const bool capture = memory_->capture_query();
+    memory_->accept_capture(n,memory_feedback_.at(size_t(bound_)).host,uint32_t(memory_->capture_pages().size()));
+    memory_->commit(n,h_memory_stats_,width,capture?query:nullptr,capture?h_memory_queries_:nullptr,
+        capture?size_t(opt_.memory.query_max_tokens)*n_head_*head_dim_:0);
+}
+void Gemma4::commit_memory_window(int n) {
+    // Provisional rows are kept individually, including separate halves of a
+    // recorded window. Transfer the tiny window once and reduce its accepted
+    // prefix on the CPU, avoiding a kernel per layer followed by a pitched copy.
+    // Rejected rows are transferred but never enter authoritative statistics.
+    const size_t width = size_t(n_kv_) * head_dim_;
+    ck(cudaMemcpyAsync(h_memory_window_keys_,memory_window_keys_,size_t(n_attn_)*opt_.window*width*sizeof(float),
+                       cudaMemcpyDeviceToHost,cs(st_)),"KVMem accepted window keys");
+    const auto& attention=memory_feedback_.at(size_t(bound_));
+    const size_t samples=memory_->capture_samples().size(),pages=memory_->capture_pages().size();
+    if(samples)ck(cudaMemcpy2DAsync(attention.host,pages*sizeof(float),attention.mass,
+        memory_page_stride_*sizeof(float),pages*sizeof(float),samples,cudaMemcpyDeviceToHost,cs(st_)),
+        "KVMem accepted window attention");
+    ck(cudaStreamSynchronize(cs(st_)),"KVMem accepted window");
+    const size_t groups=(size_t(memory_batch_start_%opt_.memory.block_tokens)+n+opt_.memory.block_tokens-1)/opt_.memory.block_tokens;
+    std::fill_n(h_memory_stats_,size_t(n_attn_)*groups*width,0.f);
+    for(int il=0;il<n_attn_;++il)for(int row=0;row<n;++row) {
+        const size_t group=(size_t(memory_batch_start_%opt_.memory.block_tokens)+row)/opt_.memory.block_tokens;
+        float* sum=h_memory_stats_+(size_t(il)*groups+group)*width;
+        const float* key=h_memory_window_keys_+(size_t(il)*opt_.window+row)*width;
+        for(size_t d=0;d<width;++d)sum[d]+=key[d];
+    }
+    memory_capture_staged_=true;
+    commit_memory_capture(n);
+}
