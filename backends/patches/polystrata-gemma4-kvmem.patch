+                 <<" block="<<opt.memory.block_tokens<<" kv="<<int(opt.kv_format)<<" mtp="<<opt.memory.mtp<<'\n';
+    } catch(const std::exception& error) {std::cerr<<error.what()<<'\n';return 1;}
+}
