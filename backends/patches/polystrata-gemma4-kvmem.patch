+#include "../src/poly/engine.hpp"
+#include <algorithm>
+#include <cmath>
+#include <cstring>
+#include <iostream>
+#include <stdexcept>
+#include <vector>
+
+using namespace strata::poly;
+namespace strata::poly {
+struct KvmemTestAccess {
+    static void cold(KvmemMemory& m) {m.storage_->trim(0);}
+    static std::vector<uint8_t> kv(KvmemMemory& m) {
+        std::vector<uint8_t> bytes(m.visible_*m.descriptor_.layout.record_bytes/m.block_tokens);
+        m.save_view(bytes.data()); return bytes;
+    }
+};
+}
+void check(bool ok,const char* message) { if(!ok)throw std::runtime_error(message); }
+void logits_close(const std::vector<float>& expected,const float* actual) {
+    float worst=0;
+    for(size_t i=0;i<expected.size();++i) {
+        const float error=std::abs(expected[i]-actual[i])/std::max({1.f,std::abs(expected[i]),std::abs(actual[i])});
+        if(!std::isfinite(error) || error>2e-5f)throw std::runtime_error("checkpoint continuation logits mismatch");
+        worst=std::max(worst,error);
+    }
+    std::cout<<"logits max_relative="<<worst<<'\n';
+}
+void scorer_reference() {
+    kvmem::RawKvStore keys({1,1024,0,32});
+    std::vector<float> sums(1024,0),query(8192,0);
+    sums[0]=32;sums[512]=32;
+    keys.write_layer_mean_sum(0,32,0,sums.data());
+    std::fill(sums.begin(),sums.end(),0);
+    keys.write_layer_mean_sum(32,32,0,sums.data());
+    for(int head=0;head<16;++head)query[size_t(head)*512]=2;
+    const uint32_t rows[]{1};
+    kvmem::PageQueryView view{query.data(),rows,1,1,16,2,512};
+    const auto frame=kvmem::query_score_frame(64,32,1,0,0,{});
+    kvmem::PageSoftmaxCuda gpu(0);
+    for(float scale:{0.f,1.f}) {
+        view.attention_scale=scale;
+        const double temperature=scale>0 ? 1. : 1/std::sqrt(512.);
+        const double expected=1/(1+std::exp(-2*temperature));
+        const auto cpu=kvmem::page_softmax_scores(keys,view,frame);
+        const auto actual=gpu.score(keys,view,frame);
+        check(std::abs(cpu[0]-expected)<1e-12,"CPU scorer has incorrect model scale");
+        check(std::abs(actual[0]-expected)<2e-6,"CUDA scorer has incorrect model scale");
+    }
+    std::cout<<"Gemma 512-dim scorer independent reference PASS\n";
+}
+int main(int argc,char** argv) {
+    try {
+        scorer_reference();
+        if(argc==2 && std::string(argv[1])=="--scorer-only")return 0;
+        check(argc>=2,"usage: poly_gemma_kvmem_test MODEL [--graphs] [--block64]");
+        Options opt;
+        opt.model=argv[1];opt.max_context=4096;opt.prompt_batch=64;opt.threads=8;
+        opt.stage_mib=256;opt.stage_ahead=0;opt.cpu_share=0;opt.expert_swaps=0;
+        opt.window=1;opt.draft=false;opt.graphs=false;opt.vram_reserve_mib=512;
+        opt.memory.budget=256;opt.memory.reserve=128;opt.memory.host_mib=2048;
+        opt.memory.sink=32;opt.memory.recent=64;opt.memory.verify=true;
+        for(int i=2;i<argc;++i) {
+            if(std::string(argv[i])=="--graphs")opt.graphs=true;
+            else if(std::string(argv[i])=="--wide")opt.memory.budget=512;
+            else if(std::string(argv[i])=="--block64") {opt.memory.block_tokens=64;opt.memory.sink=64;}
+            else if(std::string(argv[i])=="--int8")opt.kv_format=KvFmt::kInt8;
+            else if(std::string(argv[i])=="--int8k")opt.kv_format=KvFmt::kInt8K;
+            else if(std::string(argv[i])=="--batch")opt.batch=1;
+            else if(std::string(argv[i])=="--elastic")opt.elastic_experts=true;
+            else if(std::string(argv[i])=="--draft" && i+1<argc) {
+                opt.draft_model=argv[++i];opt.draft=true;opt.window=4;opt.memory.mtp=true;
+            }
+            else if(std::string(argv[i])=="--disk" && i+1<argc) {opt.memory.disk_path=argv[++i];opt.memory.disk_mib=256;}
+            else throw std::runtime_error("unknown test option");
+        }
+        auto engine=Engine::open(opt);
+        std::vector<int32_t> tokens(1280);
+        for(size_t i=0;i<tokens.size();++i)tokens[i]=100+int(i%37);
+        for(size_t i=0;i<1152;) {
+            const int n=std::min({engine->max_read(),int(opt.memory.reserve),int(1152-i)});
+            check(engine->read(tokens.data()+i,n),"layer-major Gemma prefill was cancelled");i+=n;
+        }
+        auto& memory=engine->memory();
+        check(memory.visible_tokens()<=int64_t(opt.memory.budget+opt.memory.reserve),"physical KV exceeds B+R");
+        check(!memory.complete_prefix(),"fixture never evicted a global page");
+        auto cp=memory.checkpoint();
+        const auto native=KvmemTestAccess::kv(memory);
+        const size_t window_state=opt.kv_format==KvFmt::kInt8 ? 111411200 : opt.kv_format==KvFmt::kInt8K ? 160563200 : 209715200;
+        check(cp.state.size()==window_state+(opt.draft?2816*4:0),"Gemma sliding-window state was not captured completely");
+        check(bool(cp.state_reservation),"Gemma window state was not charged to the shared RAM budget");
+        engine->eval(tokens.data()+1152,32,true);
+        const std::vector<float> expected(engine->logits(),engine->logits()+engine->n_vocab());
+        const auto accepted=memory.checkpoint();
+        if(opt.memory.disk_mib) {
+            KvmemTestAccess::cold(memory);
+            check(memory.disk_bytes()>0,"SSD fixture did not spill native records");
+        }
+        memory.restore_prefix(cp);
+        check(engine->pos()==1152,"restore lost logical position");
+        check(KvmemTestAccess::kv(memory)==native,"restore changed accepted native global KV bytes");
+        if(opt.memory.disk_mib)check(memory.io_stats().read_bytes>0,"SSD restore never read spilled native records");
+        check(memory.checkpoint().state==cp.state,"restore changed sliding-window bytes");
+        engine->eval(tokens.data()+1152,32,true);
+        logits_close(expected,engine->logits());
+        check(memory.checkpoint().state==accepted.state,"restored continuation left different sliding-window state");
+        cp=memory.checkpoint();
+        const auto begin=engine->pos();
+        memory.begin_query(begin,begin+16);
+        engine->eval(tokens.data()+1184,16,true);
+        check(memory.freeze_and_rewind(cp,begin+16),"bounded Query replay was not admitted");
+        check(engine->pos()==begin,"Query probe did not rewind logical position");
+        check(memory.checkpoint().state==cp.state,"Query rewind lost the exact sliding window");
+        engine->eval(tokens.data()+1184,16,true);
+        memory.finish_query();
+        check(engine->pos()==begin+16,"Query replay has wrong accepted frontier");
+        {
+            auto saved=memory.checkpoint();
+            auto parked=memory.park(saved);
+            engine->reset();
+            engine->eval(tokens.data()+7,64,false);
+            engine->reset();
+            memory.enter(std::move(parked),saved);
+            check(memory.checkpoint().state==saved.state,"park/enter lost sliding-window state");
+            check(engine->pos()==begin+16,"park/enter lost logical position");
+        }
+        if(opt.batch) {
+            const auto home=memory.checkpoint();
+            engine->bind(1);
+            for(int i=0;i<1088;i+=64)engine->eval(tokens.data()+i,64,false);
+            auto other=engine->memory().checkpoint();
+            engine->bind(0);
+            const int seqs[]{0,1};const int32_t next[]{137,151};
+            engine->step(seqs,next,2);
+            const std::vector<float> expected0(engine->logits_of(0),engine->logits_of(0)+engine->n_vocab());
+            const std::vector<float> expected1(engine->logits_of(1),engine->logits_of(1)+engine->n_vocab());
+            engine->memory().restore_prefix(home);
+            engine->eval(next,1,true);
+            logits_close(expected0,engine->logits());
+            engine->bind(1);
+            engine->memory().restore_prefix(other);
+            engine->eval(next+1,1,true);
+            logits_close(expected1,engine->logits());
+            engine->bind(0);
+        }
+        if(opt.memory.mtp) {
+            check(engine->drafts(),"external Gemma assistant was not enabled");
+            for(int accepted=1;accepted<=4;++accepted) {
+                auto before=engine->memory().checkpoint();
+                int32_t window[4]={131,139,149,157};
+                float probability=0;
+                const auto native_before=KvmemTestAccess::kv(engine->memory());
+                window[1]=engine->draft(window[0],0,&probability);
+                window[2]=engine->draft(window[1],1,&probability);
+                window[3]=engine->draft(window[2],2,&probability);
+                check(KvmemTestAccess::kv(engine->memory())==native_before,"assistant changed authoritative target KV");
+                engine->window(window,4);
