+    const auto extra = required > own ? required - own : memory.checkpoint_charge();
+    const auto fits = [&] { return extra <= memory.payload_limit() &&
+        memory.payload_bytes() <= memory.payload_limit() - extra; };
+    while (!fits() && evict_one()) {}
+    if (!fits() && extra <= memory.payload_limit())
+        history.reclaim_state(memory.payload_bytes() - (memory.payload_limit() - extra), purpose);
+    return fits();
+}
+std::shared_ptr<KvmemCheckpoint> KvmemSessions::checkpoint(KvmemMemory& memory, KvmemHistory& history,
+                                                          uint64_t total_tokens, bool required, kvmem::CheckpointPurpose purpose) {
+    if (!memory.checkpoint_charge()) return std::make_shared<KvmemCheckpoint>(memory.checkpoint());
+    const auto exhausted = [] { return kvmem::MemoryError(kvmem::MemoryErrorCode::BudgetExceeded,
+        "KVMem required checkpoint exceeds remaining Host state capacity"); };
+    if (required) purpose = kvmem::CheckpointPurpose::None;
+    if (make_state_room(memory, history, total_tokens, purpose)) {
+        // With SSD enabled, aggregate space alone does not guarantee RAM for
+        // the non-spillable state. Reclaim optional marks on reserve failure.
+        for (int attempt = 0; attempt != 2; ++attempt) {
+            try { return std::make_shared<KvmemCheckpoint>(memory.checkpoint()); }
+            catch (const kvmem::MemoryError& error) {
+                if (error.code() != kvmem::MemoryErrorCode::BudgetExceeded) throw;
+                if (attempt) break;
+                while (evict_one()) {}
+                const auto free = memory.host_limit() - memory.host_bytes();
+                if (free < memory.checkpoint_charge()) history.reclaim_state(memory.checkpoint_charge() - free, purpose);
+            }
+        }
+    }
+    if (required) throw exhausted();
+    std::fprintf(stderr, "KVMEM_CHECKPOINT optional capture skipped: Host state capacity\n");
+    return {};
+}
 bool KvmemSessions::make_archive_room(const KvmemMemory& memory) {
     const auto needed = memory.archive_pending_bytes();
     if (needed > memory.host_limit()) return false;
