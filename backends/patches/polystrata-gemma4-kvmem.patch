+        engine->reset();engine->eval(tokens.data(),64,false);
+        check(engine->memory().checkpoint().state==clean.state,"cancel/reset retained local or assistant state");
+        check(KvmemTestAccess::kv(engine->memory())==clean_kv,"cancel/reset retained provisional global KV");
