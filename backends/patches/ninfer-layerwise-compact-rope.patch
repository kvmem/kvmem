+        const float gpu_scale = f16_bits_to_f32(actual_scales[row]);
+        for (int dim = 0; dim < kFullHeadDim; ++dim) {
+            const auto idx = row * kFullHeadDim + dim;
+            const auto ref = expected_codes[idx], act = actual_codes[idx];
+            if (!touched) {
+                if (act != ref) ++failures;
