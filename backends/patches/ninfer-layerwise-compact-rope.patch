+    auto direct_s = to_device(std::vector<std::uint16_t>(expected_scales.size(), scale_sentinel));
+    auto direct_v = to_device(std::vector<std::uint8_t>(expected_codes.size(), code_sentinel));
+    auto direct_vs = to_device(std::vector<std::uint16_t>(expected_scales.size(), scale_sentinel));
