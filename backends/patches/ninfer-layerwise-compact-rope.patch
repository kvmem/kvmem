+            }
+            const float want = (ref & 0x80 ? -cpu_scale : cpu_scale) * decode_e4m3fn_positive(ref & 0x7f);
+            const float got = (act & 0x80 ? -gpu_scale : gpu_scale) * decode_e4m3fn_positive(act & 0x7f);
+            const float tolerance = 0.125F * std::max(std::abs(want), std::abs(got)) +
+                0.003F * 448.0F * cpu_scale;
+            if (!(std::abs(want - got) <= tolerance)) ++failures;
+        }
+    }
+    if (failures) std::cerr << label << ": " << failures << " validation errors\n";
+    return failures;
