+        std::to_string(begin) + " count=" + std::to_string(count);
+    int failures = verify_exact((label + " raw").c_str(), from_device<std::uint16_t>(raw, expected_raw.size()), expected_raw) +
+        verify_exact((label + " native keys").c_str(), actual_codes, from_device<std::uint8_t>(direct_k, actual_codes.size())) +
+        verify_exact((label + " native scales").c_str(), actual_scales, from_device<std::uint16_t>(direct_s, actual_scales.size()));
