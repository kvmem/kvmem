+int compact_key_case(int heads, int begin, int count) {
+    const int first_page = begin / kPage;
+    const int logical_pages = (begin + count + kPage - 1) / kPage;
+    constexpr int physical_pages = 8;
+    constexpr auto code_sentinel = std::uint8_t{0x55};
+    constexpr auto scale_sentinel = std::uint16_t{0x4321};
