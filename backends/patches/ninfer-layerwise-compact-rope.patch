diff --git a/src/ops/kv_cache/re_rope.cu b/src/ops/kv_cache/re_rope.cu
new file mode 100644
index 0000000..14edf80
--- /dev/null
+++ b/src/ops/kv_cache/re_rope.cu
@@ -0,0 +1,126 @@
+#include "ops/kv_cache/re_rope.h"
+
+#include "core/device.h"
+#include "ops/common/warp.cuh"
+#include "ops/kernel/rope.cuh"
+#include "ops/kv_cache/fp8_e4m3_row_codec.cuh"
+#include "ops/kv_cache/hadamard_d256.cuh"
+
+#include <stdexcept>
+
+namespace ninfer::ops {
+namespace {
+
+constexpr int kTokensPerBlock = 4;
+
+__global__ void write_raw(const __nv_bfloat16* key, __nv_bfloat16* raw, const int* positions,
+                          const int* tables, int table_stride, const int* rows,
+                          const int* valid, int width, int tokens, int heads) {
+    const int token = blockIdx.x * kTokensPerBlock + threadIdx.y;
+    if (token >= tokens) return;
+    const int sequence = token / width;
+    if (valid && token % width >= valid[sequence]) return;
+    const int* table = tables + (rows ? static_cast<std::int64_t>(rows[sequence]) * table_stride : 0);
+    const int pos = positions[token];
+    const int page = paged_kv_physical_page(table, pos);
+    const int head = blockIdx.y;
+    const int lane = threadIdx.x;
+#pragma unroll
+    for (int group = 0; group < 8; ++group) {
+        const int dim = lane + 32 * group;
+        raw[kv_cache_fp8_code_index(page, head, dim, pos & kPagedKVPageMask, heads)] =
+            key[kv_cache_fp8_src_index(head, dim, token, heads)];
+    }
+}
+
+__global__ void rebuild_keys(const __nv_bfloat16* raw, std::uint8_t* keys, __half* scales,
+                             const int* table, int begin, int count, int heads) {
+    const int token = blockIdx.x * kTokensPerBlock + threadIdx.y;
+    if (token >= count) return;
+    const int pos = begin + token;
+    const int page = paged_kv_physical_page(table, pos);
+    const int offset = pos & kPagedKVPageMask;
+    const int head = blockIdx.y;
+    const int lane = threadIdx.x;
+    float values[8];
+#pragma unroll
+    for (int group = 0; group < 8; ++group) {
+        values[group] = __bfloat162float(
+            raw[kv_cache_fp8_code_index(page, head, lane + 32 * group, offset, heads)]);
+    }
+    float sine, cosine;
+    sincosf(static_cast<float>(pos) * kTextRopeInvFrequency[lane], &sine, &cosine);
+    const float first = values[0], second = values[1];
+    values[0] = __bfloat162float(__float2bfloat16_rn(first * cosine - second * sine));
+    values[1] = __bfloat162float(__float2bfloat16_rn(first * sine + second * cosine));
+    normalized_hadamard_d256_inplace(values, lane);
+    float maximum = 0.0F;
+    for (float v : values) maximum = fmaxf(maximum, fabsf(v));
+    const auto quant = kv_cache_fp8_quant_params(warp_max(maximum, 0xffffffffU));
+#pragma unroll
+    for (int group = 0; group < 8; ++group) {
+        keys[kv_cache_fp8_code_index(page, head, lane + 32 * group, offset, heads)] =
+            kv_cache_fp8_quant_code(values[group], quant.inverse_scale);
+    }
+    if (!lane) scales[kv_cache_fp8_scale_index(page, head, offset, heads)] = quant.scale;
+}
+
+bool is_page_plane(const Tensor& plane, int leading, int heads, int pages) {
+    return plane.data && plane.is_contiguous() && plane.ne[0] == leading &&
+        plane.ne[1] == kPagedKVPageSize && plane.ne[2] == heads && plane.ne[3] == pages;
+}
+
+bool is_i32_input(const Tensor& tensor, std::int64_t size) {
+    return tensor.data && tensor.dtype == DType::I32 && tensor.is_contiguous() &&
+        tensor.numel() == size;
+}
+
+} // namespace
+
+void write_raw_keys(const RawKeyWrite& output, const Tensor& normalized_key, cudaStream_t stream) {
+    if (!output) return;
+    const auto& raw = *output.pages;
+    const int heads = raw.ne[2], tokens = normalized_key.ne[2];
+    const int width = output.columns_per_sequence;
+    const auto& table = output.page_tables;
+    if (raw.dtype != DType::BF16 || !is_page_plane(raw, 256, heads, raw.ne[3]) ||
+        normalized_key.dtype != DType::BF16 || !normalized_key.is_contiguous() ||
+        normalized_key.ne[0] != 256 || normalized_key.ne[1] != heads ||
+        width <= 0 || tokens <= 0 || tokens % width ||
+        !is_i32_input(output.positions, tokens) ||
+        !table.data || table.dtype != DType::I32 || !table.is_contiguous() ||
+        (output.table_rows && !is_i32_input(*output.table_rows, tokens / width)) ||
+        (output.valid_columns && (!output.table_rows ||
+            !is_i32_input(*output.valid_columns, tokens / width))) ||
+        (!output.table_rows && width != tokens)) {
+        throw std::invalid_argument("invalid pre-RoPE key write geometry");
+    }
+    write_raw<<<dim3((tokens + kTokensPerBlock - 1) / kTokensPerBlock, heads),
+                dim3(32, kTokensPerBlock), 0, stream>>>(
+        static_cast<const __nv_bfloat16*>(normalized_key.data),
+        static_cast<__nv_bfloat16*>(raw.data),
+        static_cast<const int*>(output.positions.data), static_cast<const int*>(table.data), table.ne[0],
+        output.table_rows ? static_cast<const int*>(output.table_rows->data) : nullptr,
+        output.valid_columns ? static_cast<const int*>(output.valid_columns->data) : nullptr,
+        width, tokens, heads);
+    CUDA_CHECK(cudaGetLastError());
+}
+
+void materialize_compact_keys(const Tensor& raw, const Tensor& key, const Tensor& scale,
+                              const Tensor& table, int begin, int count, cudaStream_t stream) {
+    const int heads = raw.ne[2], pages = raw.ne[3];
+    if (begin < 0 || count <= 0 || (std::int64_t(begin) + count - 1) / kPagedKVPageSize >= table.ne[0] ||
+        raw.dtype != DType::BF16 || !is_page_plane(raw, 256, heads, pages) ||
+        key.dtype != DType::FP8_E4M3FN || !is_page_plane(key, 256, heads, pages) ||
+        scale.dtype != DType::FP16 || !is_page_plane(scale, 1, heads, pages) ||
+        table.dtype != DType::I32 || !table.is_contiguous() || !table.data) {
+        throw std::invalid_argument("invalid compact FP8 key materialization");
+    }
+    rebuild_keys<<<dim3((count + kTokensPerBlock - 1) / kTokensPerBlock, heads),
+                   dim3(32, kTokensPerBlock), 0, stream>>>(
+        static_cast<const __nv_bfloat16*>(raw.data), static_cast<std::uint8_t*>(key.data),
+        static_cast<__half*>(scale.data), static_cast<const int*>(table.data), begin, count, heads);
+    CUDA_CHECK(cudaGetLastError());
+}
+
+} // namespace ninfer::ops
