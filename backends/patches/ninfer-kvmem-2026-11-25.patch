+kvmem::LayerwisePrefillOptions native_layerwise_prefill_options(
+    std::uint64_t selected_tokens,std::uint64_t reserve_tokens) {
+    kvmem::LayerwisePrefillOptions options{64,selected_tokens,reserve_tokens};
+    if (const char* mode=std::getenv("NINFER_LAYERWISE_PRESSURE_SCORER")) {
+        if (std::strcmp(mode,"lift")==0) options.scorer=kvmem::LayerwisePrefillScorer::Lift;
+        else if (std::strcmp(mode,"attention")!=0)
+            throw std::invalid_argument("NINFER_LAYERWISE_PRESSURE_SCORER must be attention or lift");
+    }
+    if (options.scorer==kvmem::LayerwisePrefillScorer::Lift) options.half_life=32768.;
+    if (const char* value=std::getenv("NINFER_LAYERWISE_PREFILL_HALF_LIFE")) {
+        char* end=nullptr;const double half_life=std::strtod(value,&end);
+        if (end==value || *end || !std::isfinite(half_life) || half_life<=0.)
+            throw std::invalid_argument("NINFER_LAYERWISE_PREFILL_HALF_LIFE must be finite and positive");
+        options.half_life=half_life;
+    }
+    return options;
+}
