+TextContext::TensorQueryScope::TensorQueryScope(TextContext& owner,
+    std::uint32_t rank,Tensor* partial)
+    :owner_(&owner),previous_rank_(owner.tensor_rank_),previous_partial_(owner.residual_partial_) {
+    const auto* stage=owner.stage_runtime_;
+    if (!stage || !stage->tensor_parallel || !owner.parameters_.text.tensor_parallel() ||
+        rank>=stage->tensor_parallel->shares.size() ||
+        stage->tensor_parallel->shares.size()!=owner.ctx_.size() ||
+        stage->tensor_parallel->shards.size()!=owner.ctx_.size() ||
+        stage->tensor_parallel->shares[rank].attention_positions ||
+        owner.ctx_.active_rank()!=rank || owner.work_.active_rank()!=rank ||
+        previous_rank_!=0 || previous_partial_!=nullptr ||
+        owner.attention_partial_!=nullptr || owner.active_sequence_batch_!=0 ||
+        !owner.active_segments_.empty() ||
+        owner.gdn_state_action_!=GdnStateAction::UpdateInPlace)
+        throw std::logic_error("Query tensor share lacks its eager heads/rank/partial owner");
+    require_current_layer_query_eager(owner.ctx_.stream);
+    if (partial) {
+        if (partial->dtype!=DType::FP32 || partial->ne[0]!=dimension(owner.config_.hidden_size) ||
+            partial->ne[1]<=0 || partial->ne[2]!=1 || partial->ne[3]!=1)
+            throw std::invalid_argument("Query tensor residual partial must be stable FP32 [hidden,rows]");
+        owner.require_stable_query_tensor(*partial,"Query tensor residual partial");
+        const auto* exchange=stage->tensor_parallel->exchange.get();
+        bool owned=false;
+        if (exchange && partial->bytes()<=exchange->slot_bytes())
+            for (std::size_t slot=0;slot<TensorParallelExchange::kSlots;++slot)
+                owned|=partial->data==exchange->partial(rank,slot);
+        if (!owned) throw std::invalid_argument("Query tensor partial is not its owning native exchange slot");
+    }
+    owner.tensor_rank_=rank;owner.residual_partial_=partial;
+}
+
+TextContext::TensorQueryScope::TensorQueryScope(TensorQueryScope&& other) noexcept
+    :owner_(std::exchange(other.owner_,nullptr)),previous_rank_(other.previous_rank_),
+     previous_partial_(other.previous_partial_) {}
+
+TextContext::TensorQueryScope::~TensorQueryScope() {
+    if (owner_) {owner_->tensor_rank_=previous_rank_;owner_->residual_partial_=previous_partial_;}
+}
+
+TextContext::TensorQueryScope TextContext::query_tensor_scope(std::uint32_t rank,Tensor* partial) {
+    return TensorQueryScope(*this,rank,partial);
+}
+
+void TextContext::require_layer_major_query(bool head) const {
+    const auto rank=ctx_.active_rank();
+    const bool pipeline=stage_runtime_ != nullptr && !stage_runtime_->tensor_parallel &&
+        parameters_.text.rank_count==ctx_.size() &&
+        stage_runtime_->state_first_layer.size()==stage_runtime_->state.size();
+    const bool tensor=stage_runtime_ && stage_runtime_->tensor_parallel &&
+        parameters_.text.tensor_parallel() && parameters_.text.rank_count==ctx_.size() &&
+        stage_runtime_->tensor_parallel->shares.size()==ctx_.size() &&
+        stage_runtime_->tensor_parallel->shards.size()==ctx_.size() && tensor_rank_==rank &&
+        !stage_runtime_->tensor_parallel->shares[rank].attention_positions;
+    if ((!pipeline && !tensor && (parameters_.text.rank_count != 1 || rank != 0 || stage_runtime_ != nullptr)) ||
+        (head && rank!=0) || work_.active_rank()!=rank ||
+        active_sequence_batch_ != 0 || !active_segments_.empty() || attention_partial_ != nullptr ||
+        (residual_partial_ != nullptr && (!tensor || head)) || gdn_state_action_ != GdnStateAction::UpdateInPlace)
+        throw std::logic_error("layer-major Query primitive lacks its eager owning rank");
+    require_current_layer_query_eager(ctx_.stream);
+}
+
+void TextContext::require_query_layer_owner(std::uint32_t layer) const {
+    require_layer_major_query();
+    const bool tensor=stage_runtime_ && stage_runtime_->tensor_parallel;
+    if (layer>=parameters_.text.layers.size() || (!tensor && parameters_.text.layers[layer].rank!=ctx_.active_rank()))
+        throw std::logic_error("layer-major Query block is owned by another pipeline rank");
+}
+
+const BlockParameters& TextContext::query_block(std::uint32_t layer) const {
+    require_query_layer_owner(layer);
+    return stage_runtime_ && stage_runtime_->tensor_parallel && tensor_rank_!=0
+        ?parameters_.text.rank_layers.at(tensor_rank_-1).at(layer):parameters_.text.layers.at(layer);
+}
+
+void TextContext::validate_query_partial(const Tensor& residual) const {
+    if (!residual_partial_) return;
+    if (!stage_runtime_ || !stage_runtime_->tensor_parallel || tensor_rank_!=ctx_.active_rank())
+        throw std::logic_error("Query residual partial is outside its native tensor share");
+    require_tensor_shape(*residual_partial_,DType::FP32,
+        {dimension(config_.hidden_size),residual.ne[1]},"Query tensor residual partial");
+    require_stable_query_tensor(*residual_partial_,"Query tensor residual partial");
+    const auto* exchange=stage_runtime_->tensor_parallel->exchange.get();
+    bool owned=false;
+    if (exchange && residual_partial_->bytes()<=exchange->slot_bytes())
+        for (std::size_t slot=0;slot<TensorParallelExchange::kSlots;++slot)
+            owned|=residual_partial_->data==exchange->partial(tensor_rank_,slot);
+    if (!owned) throw std::invalid_argument("Query tensor partial lost its owning native exchange slot");
+    if (query_storage_overlaps(residual_partial_->data,residual_partial_->bytes(),residual.data,residual.bytes()))
+        throw std::invalid_argument("Query tensor output partial aliases its input residual");
+}
+
+void TextContext::validate_query_partial(const PreparedLayerQueryStorage& storage) const {
+    validate_query_partial(storage.residual);
+    if (!residual_partial_) return;
+    const Tensor* planes[]{&storage.query,&storage.key,&storage.value,&storage.gate,
+        &storage.cache_positions,&storage.rope_positions};
+    for (const auto* plane:planes)
+        if (query_storage_overlaps(residual_partial_->data,residual_partial_->bytes(),plane->data,plane->bytes()))
+            throw std::invalid_argument("Query tensor output partial aliases its prepared native operands");
+}
