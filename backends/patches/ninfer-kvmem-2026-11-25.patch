diff --git a/src/models/qwen3_5/program/storage/kvmem_payload_budget.h b/src/models/qwen3_5/program/storage/kvmem_payload_budget.h
new file mode 100644
index 0000000000000000000000000000000000000000..e07817aa8963824e734d22567ce84cf36028bc03
--- /dev/null
+++ b/src/models/qwen3_5/program/storage/kvmem_payload_budget.h
@@ -0,0 +1,55 @@
+#pragma once
+
+#include <cstdint>
+#include <algorithm>
+#include <limits>
+#include <stdexcept>
+#include <unordered_set>
+
+namespace ninfer::models::qwen3_5::detail {
+// A future archive and a temporary prefill checkpoint have different lifetimes.
+// Reserve their largest simultaneous live set, not their sum across phases.
+inline std::uint64_t kvmem_payload_envelope(std::uint64_t history,
+        std::uint64_t prefill, std::uint64_t execution_private) {
+    if (execution_private > std::numeric_limits<std::uint64_t>::max() - prefill)
+        throw std::overflow_error("KVMem payload phase overflow");
+    return std::max(history, prefill + execution_private);
+}
+// A reservation pays for its archive once. Immutable snapshots and in-flight
+// readers can share those records, but private versions retain their own charge.
+// Establish every covered identity before adding the remaining owners.
+class KvmemPayloadBudget {
+public:
+    void reserve(std::uint64_t bytes) {
+        if (bytes > std::numeric_limits<std::uint64_t>::max() - used_)
+            throw std::overflow_error("KVMem payload reservation overflow");
+        used_ += bytes;
+    }
+    void cover(const void* identity) { if (identity) identities_.insert(identity); }
+    void require(const void* identity, std::uint64_t bytes) {
+        std::uint64_t credit = 0;
+        require(identity, bytes, credit);
+    }
+    // Credit is an already-reserved, finite phase envelope. Each physical
+    // identity consumes it once; exhausted credit never hides additional bytes.
+    void require(const void* identity, std::uint64_t bytes, std::uint64_t& credit) {
+        if (!identity || identities_.find(identity)!=identities_.end()) return;
+        const auto funded = std::min(bytes, credit);
+        if (bytes - funded > std::numeric_limits<std::uint64_t>::max() - used_)
+            throw std::overflow_error("KVMem payload reservation overflow");
+        identities_.insert(identity);
+        credit -= funded;
+        used_ += bytes - funded;
+    }
+    void reserve(std::uint64_t bytes, std::uint64_t& credit) {
+        const auto funded = std::min(bytes, credit);
+        reserve(bytes - funded);
+        credit -= funded;
+    }
+    std::uint64_t used() const noexcept { return used_; }
+    bool fits(std::uint64_t limit) const noexcept { return used_ <= limit; }
+private:
+    std::uint64_t used_ = 0;
+    std::unordered_set<const void*> identities_;
+};
+} // namespace ninfer::models::qwen3_5::detail
diff --git a/src/models/qwen3_5/program/storage/kvmem_snapshot.h b/src/models/qwen3_5/program/storage/kvmem_snapshot.h
new file mode 100644
index 0000000000000000000000000000000000000000..570dca8e2ad19a742355d3fa5670df7b4a80da05
--- /dev/null
+++ b/src/models/qwen3_5/program/storage/kvmem_snapshot.h
@@ -0,0 +1,142 @@
+#pragma once
+#include "kvmem/kv_snapshot.hpp"
+#include <unordered_map>
+
+namespace ninfer::models::qwen3_5 {
+// The native manifest is one complete, sealed record per logical page. Check
+// this without allocating owner handles, reading SSD, or promoting cold data.
+inline bool kvmem_snapshot_covers(const std::shared_ptr<const kvmem::KvSnapshot>& snapshot,
+                                  size_t pages, size_t stride) {
+    if (!snapshot || !pages || !stride || pages > SIZE_MAX / stride ||
+        snapshot->size() != pages * stride || snapshot->blocks().size() != pages ||
+        snapshot->spans().size() != pages) return false;
+    for (size_t page = 0; page < pages; ++page) {
+        const auto& block = snapshot->blocks()[page];
+        const auto& span = snapshot->spans()[page];
+        if (block->size() != stride || !block->ready() || span.block != page ||
+            span.source || span.destination != page * stride || span.bytes != stride) return false;
+    }
+    return true;
+}
+
+// Called after native accepted-boundary capture. Archive records include all
+// attention/scale/MTP planes. Only live allocation identity proves reuse.
+inline std::shared_ptr<const kvmem::KvSnapshot> capture_kvmem_snapshot(
+    const std::vector<kvmem::HostKvRecord>& archive, size_t pages, bool partial_tail,
+    kvmem::HostKvStorage& storage,
+    const std::shared_ptr<const kvmem::KvSnapshot>& previous = {}) {
+    if (!pages || pages > archive.size())
+        throw std::logic_error("NInfer snapshot has incomplete archive coverage");
+    std::unordered_map<const void*, std::shared_ptr<kvmem::SealedKvBlock>> inherited;
+    if (previous) for (const auto& origin : previous->blocks()) {
+        auto record = origin->record();
+        if (record) inherited.emplace(record.storage_identity(), origin);
+    }
+    std::vector<std::shared_ptr<kvmem::SealedKvBlock>> blocks;
+    std::vector<kvmem::KvSnapshot::Span> spans;
+    blocks.reserve(pages); spans.reserve(pages);
+    size_t bytes = 0;
+    for (size_t page = 0; page < pages; ++page) {
+        const auto& record = archive[page];
+        if (!record || record.size() > SIZE_MAX - bytes)
+            throw std::logic_error("NInfer snapshot has invalid native record");
+        std::shared_ptr<kvmem::SealedKvBlock> origin;
+        if (!(partial_tail && page + 1 == pages)) {
+            auto found = inherited.find(record.storage_identity());
+            if (found != inherited.end()) origin = found->second;
+        }
+        if (partial_tail && page + 1 == pages) {
+            // Pay for the private tail now, not during the next append. The
+            // active archive keeps its independent mutable allocation.
+            auto source=record.lease();
+            auto tail=storage.allocate(record.size());
+            source.read(0,tail.writable_data(),tail.size());
+            tail.seal();
+            origin=std::make_shared<kvmem::SealedKvBlock>(tail);
+        } else if (!origin) origin = std::make_shared<kvmem::SealedKvBlock>(record);
+        blocks.push_back(std::move(origin));
+        spans.push_back({page, 0, bytes, record.size()});
+        bytes += record.size();
+    }
+    return std::make_shared<kvmem::KvSnapshot>(std::move(blocks), std::move(spans), bytes);
+}
+
+// Prepare private owner handles before publication; cold records stay cold.
+inline std::vector<kvmem::HostKvRecord> fork_kvmem_snapshot(const kvmem::KvSnapshot& snapshot) {
+    std::vector<kvmem::HostKvRecord> result;
+    result.reserve(snapshot.blocks().size());
+    for (const auto& block : snapshot.blocks()) {
+        auto record = block->record();
+        if (!record) throw std::logic_error("NInfer snapshot is not sealed");
+        result.push_back(std::move(record));
+    }
+    return result;
+}
+
+// A layerwise checkpoint also owns exact pre-RoPE Mean-K and per-layer source
+// provenance. Its immutable canonical version is the payload owner; a second
+// manifest/tail capture would duplicate ownership outside its Waiting credits.
+// Directory lookup, eviction and restoration must use either immutable owner,
+// never the active window's mutable archive as a substitute.
+template<class Checkpoint>
+size_t kvmem_checkpoint_payload_pages(const Checkpoint& cp) {
+    return cp.canonical_source ? cp.canonical_source->records.size() :
+        cp.kv_snapshot ? cp.kv_snapshot->blocks().size() : 0;
+}
+
+template<class Checkpoint>
+bool kvmem_checkpoint_payload_covers(const Checkpoint& cp,size_t pages,size_t stride) {
+    if (!cp.canonical_source) return kvmem_snapshot_covers(cp.kv_snapshot,pages,stride);
+    if (!pages || !stride || pages>SIZE_MAX/stride) return false;
+    try {
+        const auto& source=*cp.canonical_source;
+        source.validate();
+        return source.records.size()==pages && source.frontier==cp.prefix.size() &&
+            source.descriptor.identity==cp.identity.backend && source.descriptor.layout==cp.identity.layout &&
+            source.descriptor.layout.record_bytes==stride &&
+            (!cp.layer_views.active() || cp.layer_views.source_epoch==source.epoch);
+    } catch (const std::exception&) {return false;}
+}
+
+template<class Checkpoint>
+kvmem::HostKvRecord kvmem_checkpoint_payload_record(const Checkpoint& cp,size_t page) {
+    if (page>=kvmem_checkpoint_payload_pages(cp)) return {};
+    return cp.canonical_source ? cp.canonical_source->records[page].fork() :
+        cp.kv_snapshot->blocks()[page]->record();
+}
+
+template<class Checkpoint>
+size_t kvmem_checkpoint_payload_bytes(const Checkpoint& cp) {
+    if (!cp.canonical_source) return cp.kv_snapshot ? cp.kv_snapshot->size() : 0;
+    const auto pages=cp.canonical_source->records.size(),stride=cp.canonical_source->descriptor.layout.record_bytes;
+    if (stride && pages>SIZE_MAX/stride) throw std::overflow_error("checkpoint payload byte count overflow");
+    return pages*stride;
+}
+
+template<class Checkpoint>
+std::vector<kvmem::HostKvRecord> fork_kvmem_checkpoint_payload(const Checkpoint& cp) {
+    if (!cp.canonical_source) {
+        if (!cp.kv_snapshot) throw std::logic_error("checkpoint has no immutable native payload");
+        return fork_kvmem_snapshot(*cp.kv_snapshot);
+    }
+    std::vector<kvmem::HostKvRecord> records;
+    records.reserve(cp.canonical_source->records.size());
+    for (const auto& record:cp.canonical_source->records) records.push_back(record.fork());
+    return records;
+}
+
+template<class Checkpoint,class Visitor>
+void account_kvmem_checkpoint_payload(const Checkpoint& cp,Visitor&& visitor) {
+    if (cp.canonical_source) {
+        for (const auto& record:cp.canonical_source->records)
+            visitor(record.storage_identity(),record.size());
+    } else if (cp.kv_snapshot) cp.kv_snapshot->account(std::forward<Visitor>(visitor));
+}
+
+template<class Checkpoint>
+bool same_kvmem_checkpoint_payload(const Checkpoint& left,const Checkpoint& right) {
+    if (left.canonical_source || right.canonical_source)
+        return left.canonical_source && left.canonical_source==right.canonical_source;
+    return left.kv_snapshot && left.kv_snapshot==right.kv_snapshot;
+}
+} // namespace ninfer::models::qwen3_5
diff --git a/src/models/qwen3_5/program/storage/kvmem_transfer_trace.h b/src/models/qwen3_5/program/storage/kvmem_transfer_trace.h
new file mode 100644
index 0000000000000000000000000000000000000000..17052b71a874111621aca5bc6eb1d868b466afac
--- /dev/null
+++ b/src/models/qwen3_5/program/storage/kvmem_transfer_trace.h
@@ -0,0 +1,135 @@
+#pragma once
+
+#include "core/paged_kv_cache.h"
+#include "core/host_kv_arena.h"
+
+#include <algorithm>
+#include <chrono>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <memory>
+#include <vector>
+
+namespace ninfer::models::qwen3_5::detail {
+
+// Opt-in transfer diagnostics. All event reads follow the caller's existing batch fence.
+// Event spans include stream idle time during host submission; they are not copy-engine busy
+// time. Across ranks report the longest span per batch, rather than adding concurrent spans.
+class KvmemTransferTrace {
+    using Clock = std::chrono::steady_clock;
+    struct RankTimer {
+        int device;
+        cudaStream_t stream;
+        cudaEvent_t start = nullptr, stop = nullptr;
+        RankTimer(int device, cudaStream_t stream) : device(device), stream(stream) {
+            const DeviceBinding bind(device);
+            CUDA_CHECK(cudaEventCreate(&start));
+            const auto status = cudaEventCreate(&stop);
+            if (status != cudaSuccess) {
+                (void)cudaEventDestroy(start);
+                CUDA_CHECK(status);
+            }
+        }
+        ~RankTimer() {
+            int previous = device;
+            (void)cudaGetDevice(&previous);
+            (void)cudaSetDevice(device);
+            (void)cudaEventDestroy(stop);
+            (void)cudaEventDestroy(start);
+            (void)cudaSetDevice(previous);
+        }
+    };
+public:
+    KvmemTransferTrace(const DeviceContext& device, RankStreams streams,
+                       const char* direction, std::size_t pages, std::size_t staging_bytes,
+                       bool asynchronous)
+        : enabled_(enabled()), direction_(direction), pages_(pages), staging_bytes_(staging_bytes),
+          asynchronous_(asynchronous) {
+        if (!enabled_) return;
+        started_ = last_ = Clock::now();
+        for (std::size_t rank = 0; rank < device.size(); ++rank) {
+            timers_.push_back(std::make_unique<RankTimer>(device.rank(rank).device, streams[rank]));
+        }
+    }
+    void add_copy(const DeviceKVPagePool& pool, std::span<const DeviceKVPageHandle> pages,
+                   std::span<const std::byte* const> records,
+                   const HostKVPageLayout& layout,
+                   std::span<const std::uint32_t> groups = {}) {
+        if (!enabled_) return;
+        const auto stats = pool.host_record_copy_stats(pages, records, groups, layout);
+        runs_ += stats.runs;
+        copies_ += stats.copies;
+        payload_bytes_ += stats.payload_bytes;
+    }
+    void host_done() { checkpoint(host_us_); }
+    void prepare_done() { checkpoint(prepare_us_); }
+    void begin_copy() {
+        if (!enabled_) return;
+        prepare_done();
+        for (const auto& timer : timers_) {
+            const DeviceBinding bind(timer->device);
+            CUDA_CHECK(cudaEventRecord(timer->start, timer->stream));
+        }
+    }
+    void end_copy() {
+        if (!enabled_) return;
+        for (const auto& timer : timers_) {
+            const DeviceBinding bind(timer->device);
+            CUDA_CHECK(cudaEventRecord(timer->stop, timer->stream));
+        }
+        checkpoint(submit_us_);
+    }
+    void batch_complete() {
+        if (!enabled_) return;
+        checkpoint(wait_us_);
+        float longest = 0;
+        for (const auto& timer : timers_) {
+            const DeviceBinding bind(timer->device);
+            float ms = 0;
+            CUDA_CHECK(cudaEventElapsedTime(&ms, timer->start, timer->stop));
+            longest = std::max(longest, ms);
+        }
+        gpu_span_ms_ += longest;
+        ++batches_;
+        prepare_done();
+    }
+    void finish() {
+        if (!enabled_) return;
+        prepare_done();
+        const auto total = std::chrono::duration_cast<std::chrono::microseconds>(last_ - started_).count();
+        std::fprintf(stderr,
+            "KVMEM_TRANSFER direction=%s async=%d pages=%zu batches=%llu pool_runs=%llu "
+            "copy_calls=%llu payload_bytes=%llu staging_bytes=%zu prepare_us=%lld host_us=%lld "
+            "submit_us=%lld wait_us=%lld gpu_span_ms=%.3f total_us=%lld\n",
+            direction_, int(asynchronous_), pages_, static_cast<unsigned long long>(batches_),
+            static_cast<unsigned long long>(runs_), static_cast<unsigned long long>(copies_),
+            static_cast<unsigned long long>(payload_bytes_), staging_bytes_, prepare_us_, host_us_,
+            submit_us_, wait_us_, gpu_span_ms_, static_cast<long long>(total));
+    }
+private:
+    static bool enabled() {
+        static const bool value = [] {
+            const char* flag = std::getenv("KVMEM_TRANSFER_TRACE");
+            return flag && std::strcmp(flag, "1") == 0;
+        }();
+        return value;
+    }
+    void checkpoint(long long& accumulated) {
+        if (!enabled_) return;
+        const auto now = Clock::now();
+        accumulated += std::chrono::duration_cast<std::chrono::microseconds>(now - last_).count();
+        last_ = now;
+    }
+    bool enabled_;
+    const char* direction_;
+    std::size_t pages_, staging_bytes_;
+    bool asynchronous_;
+    Clock::time_point started_{}, last_{};
+    std::vector<std::unique_ptr<RankTimer>> timers_;
+    std::uint64_t batches_ = 0, runs_ = 0, copies_ = 0, payload_bytes_ = 0;
+    long long prepare_us_ = 0, host_us_ = 0, submit_us_ = 0, wait_us_ = 0;
+    double gpu_span_ms_ = 0;
+};
