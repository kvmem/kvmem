+// Logical [kv_head, token, dimension] view for this layer and call only.
+__global__ void widen_prompt_fp8_kv(const std::uint8_t* keys, const std::uint8_t* values,
+    const __half* key_scales, const __half* value_scales, const int* tables,
+    const int* table_row, int table_stride, const int* positions, int width, int stride,
+    __nv_bfloat16* wide_keys, __half* wide_values) {
+    constexpr int heads = 4, dim = 256;
+    constexpr int lanes = dim/8;
+    const int head = blockIdx.y;
+    const int token = blockIdx.x*(blockDim.x/lanes) + threadIdx.x/lanes;
+    const int d = (threadIdx.x%lanes)*8;
+    if (token >= stride) return;
+    const int visible = positions[0] + width;
+    const size_t destination = (size_t(head)*stride + token)*dim+d;
+    int4 key = make_int4(0,0,0,0), value = make_int4(0,0,0,0);
+    if (token < visible) {
+        const int physical = tables[size_t(*table_row)*table_stride + token/64];
+        const auto scale = kv_cache_fp8_scale_index(physical,head,token%64,heads);
+        const auto src = kv_cache_fp8_code_index(physical,head,d,token%64,heads);
+        key = kv_cache_fp8_dequant_bf16x8(keys+src,key_scales[scale]);
+        value = kv_cache_fp8_dequant_f16x8(values+src,value_scales[scale]);
+    }
+    store_vec(wide_keys+destination,key);
+    store_vec(wide_values+destination,value);
+}
