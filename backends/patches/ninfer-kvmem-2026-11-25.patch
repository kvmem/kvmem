+#include "models/qwen3_5/program/storage/layerwise_kv_transfer.h"
+#include "models/qwen3_5/program/storage/layerwise_refresh_profile.h"
+#include <algorithm>
+#include <array>
+#include <cstring>
+#include <limits>
+
+namespace ninfer::models::qwen3_5::detail {
+LayerRestoreTrace*& active_layer_restore_trace() noexcept {
+    static thread_local LayerRestoreTrace* active=nullptr;return active;
+}
+namespace {
+bool same_history(const kvmem::MemoryStamp& a,const kvmem::MemoryStamp& b) {
+    auto left=a,right=b;left.view_version=right.view_version=0;return left==right;
+}
+bool same_view(const kvmem::ExecutionView& a,const kvmem::ExecutionView& b) {
+    if (!(a.stamp==b.stamp) || a.visible_tokens!=b.visible_tokens || a.blocks.size()!=b.blocks.size()) return false;
+    for (std::size_t i=0;i<a.blocks.size();++i)
+        if (!(a.blocks[i].block==b.blocks[i].block) || a.blocks[i].compact_start!=b.blocks[i].compact_start) return false;
+    return true;
+}
+// A source half remains live until its own producing streams have consumed
+// it. Exceptional submission (including failure before event recording) drains
+// those streams before the caller may recycle the pinned buffer.
+struct StripeUploadFences {
+    DeviceContext& device;RankStreams streams;
+    RankFenceSet first,second;
+    std::array<bool,2> pending{};bool submitted=false;
+    StripeUploadFences(DeviceContext& d,RankStreams s):device(d),streams(s),first(d),second(d) {}
+    ~StripeUploadFences() {
+        if (submitted) for (std::size_t rank=0;rank<device.size();++rank) {
+            DeviceBinding binding(device.rank(rank).device);(void)cudaStreamSynchronize(streams[rank]);
+        }
+    }
+    RankFenceSet& fence(std::size_t slot) {return slot?second:first;}
+    void wait(std::size_t slot) {if (pending[slot]) {fence(slot).synchronize();pending[slot]=false;}}
+    void record(std::size_t slot) {fence(slot).record(streams);pending[slot]=true;}
+    void finish() {wait(0);wait(1);submitted=false;}
+};
+struct Drain {
+    DeviceContext& device;bool armed=false;
+    ~Drain() { if (armed) try { device.synchronize(); } catch (...) {} }
+    void finish() { device.synchronize();armed=false; }
+};
+}
+
+kvmem::ExecutionView restore_native_layer_stripe(
+    const NativeFrozenLayerArchive& archive,const kvmem::MemorySnapshot& current,
+    const kvmem::LayerWorkingSetPlan& layer,DeviceKVPagePool& pool,KVAddressSpaceStore& addresses,
+    KVAddressSpaceHandle address,DeviceContext& device,RankStreams streams,PinnedHostBuffer& staging,
+    std::uint64_t pool_offset,bool verify) {
+    archive.descriptor.validate();
+    if (!(current.stamp==layer.plan.expected) || !same_history(current.stamp,archive.canonical.stamp) ||
+        current.blocks.size()!=archive.canonical.blocks.size() || archive.records.size()!=current.blocks.size() ||
+        !layer.plan.spill.empty() || streams.size()!=device.size() || pool.rank_count()>device.size())
+        throw std::logic_error("native stripe restore has stale or incomplete canonical history");
+    const auto& canonical=archive.descriptor.layout;
+    for (std::size_t i=0;i<current.blocks.size();++i) {
+        const auto& source=archive.canonical.blocks[i];
+        if (!(current.blocks[i].block==source.block) || source.block.id!=i ||
+            source.block.original_start!=std::uint64_t(i)*64 ||
+            source.host_version!=source.block.content_version || !archive.records[i] ||
+            archive.records[i].size()!=canonical.record_bytes)
+            throw std::logic_error("native stripe restore lacks a complete current canonical record");
+    }
+    std::vector<std::uint64_t> selected;selected.reserve(layer.plan.next.blocks.size());
+    for (const auto& item:layer.plan.next.blocks) selected.push_back(item.block.id);
+    const auto checked=kvmem::plan_working_set(archive.descriptor,current,selected,
+        layer.plan.mandatory,layer.plan.budget);
+    if (!same_view(checked.next,layer.plan.next) || !checked.spill.empty() ||
+        canonical.block_tokens!=64 || layer.plan.next.blocks.size()>UINT32_MAX)
+        throw std::logic_error("native stripe plan differs from its canonical source");
+    const kvmem::NativeKvLayerRegions regions(canonical,layer.model_layer);
+    if (regions.packed_bytes()!=layer.payload.packed_bytes() ||
+        regions.regions().size()!=layer.payload.regions().size())
+        throw std::logic_error("native stripe payload differs from the model-layer layout");
+    for (std::size_t i=0;i<regions.regions().size();++i)
+        if (!(regions.regions()[i].plane==layer.payload.regions()[i].plane) ||
+            regions.regions()[i].packed_offset!=layer.payload.regions()[i].packed_offset)
+            throw std::logic_error("native stripe payload changed a native region");
+
+    auto host=plan_host_kv_page_layout(pool.geometry());
+    const auto full_host=host;
+    if (pool_offset>canonical.record_bytes || host.page_stride>canonical.record_bytes-pool_offset ||
+        regions.packed_bytes()>std::numeric_limits<std::size_t>::max() ||
+        staging.size()<regions.packed_bytes() || (verify && staging.size()<full_host.page_stride))
+        throw std::invalid_argument("native stripe staging or canonical pool extent is too small");
+    std::vector<std::size_t> planes;planes.reserve(regions.regions().size());
+    for (const auto& region:regions.regions()) {
+        std::size_t found=host.planes.size();
+        for (std::size_t i=0;i<full_host.planes.size();++i)
+            if (full_host.planes[i].offset+pool_offset==region.plane.offset) {found=i;break;}
+        if (found==host.planes.size() || host.planes[found].page_payload_bytes!=region.plane.bytes ||
+            pool.plane_rank(found)!=region.plane.rank ||
+            std::find(planes.begin(),planes.end(),found)!=planes.end())
+            throw std::logic_error("native stripe region does not match its pool/rank plane");
+        planes.push_back(found);host.planes[found].offset=static_cast<std::size_t>(region.packed_offset);
+    }
+    // Keep the complete native geometry inventory; only selected offsets and
+    // the host record pitch differ. The pool's existing restricted-plane copy
+    // accesses exactly these regions, preserving native codes/scales verbatim.
+    host.page_stride=static_cast<std::size_t>(regions.packed_bytes());
+    KVLayerStripeWrite::require_unpublished_destination(addresses,address,pool,
+        static_cast<std::uint32_t>(selected.size()));
+    for (std::size_t rank=0;rank<device.size();++rank) {
+        DeviceBinding binding(device.rank(rank).device);
+        cudaStreamCaptureStatus status=cudaStreamCaptureStatusNone;
+        CUDA_CHECK(cudaStreamIsCapturing(streams[rank],&status));
+        if (status!=cudaStreamCaptureStatusNone)
+            throw std::logic_error("native stripe restore requires an eager Program boundary");
+    }
+    // All metadata and geometry checks precede the first native mutation.
+    // Pack several immutable layer stripes into the already admitted pinned
+    // buffer. Consecutive destination pages can then use the pool's strided
+    // native copy, with one producer fence per batch instead of per page.
+    // Both metadata and transfer memory stay bounded independently of history.
+    constexpr std::size_t max_batch=64;
+    const auto* pipeline_flag=std::getenv("NINFER_LAYER_RESTORE_PIPELINE");
+    const bool pipeline=!verify && staging.size()/host.page_stride>=2 &&
+        (!pipeline_flag || std::strcmp(pipeline_flag,"0")!=0);
+    const std::size_t slots=pipeline?2:1;
+    const auto capacity=std::min(max_batch,staging.size()/host.page_stride/slots);
+    StripeUploadFences uploads(device,streams);
+    std::array<const std::byte*,max_batch> records{};
+    std::array<DeviceKVPageHandle,max_batch> destinations{};
+    Drain drain{device};
+    auto* trace=active_layer_restore_trace();
+    for (std::size_t first=0,batch=0;first<selected.size();++batch) {
+        const auto slot=batch%slots;
+        auto phase=trace?LayerRestoreTrace::Clock::now():LayerRestoreTrace::Clock::time_point{};
+        uploads.wait(slot);
+        if (trace) {trace->wait_ms+=LayerRestoreTrace::elapsed(phase);phase=LayerRestoreTrace::Clock::now();}
+        const auto count=std::min(capacity,selected.size()-first);
+        for (std::size_t i=0;i<count;++i) {
+            auto* packed=static_cast<std::byte*>(staging.data())+(slot*capacity+i)*host.page_stride;
+            const auto& source=archive.records.at(static_cast<std::size_t>(selected[first+i]));
+            regions.read(source,0,packed,host.page_stride);
+            records[i]=packed;
+            destinations[i]=addresses.physical_page(address,static_cast<std::uint32_t>(first+i));
+        }
+        if(trace) {trace->pack_ms+=LayerRestoreTrace::elapsed(phase);phase=LayerRestoreTrace::Clock::now();}
+        uploads.submitted=true;
+        for (auto plane:planes)
+            pool.copy_from_host_records({records.data(),count},{},{destinations.data(),count},
+                host,plane,plane+1,streams);
+        uploads.record(slot);
+        if(trace) {trace->submit_ms+=LayerRestoreTrace::elapsed(phase);phase=LayerRestoreTrace::Clock::now();}
+        if (verify) uploads.wait(slot);
+        if(trace) {trace->wait_ms+=LayerRestoreTrace::elapsed(phase);++trace->batches;trace->pages+=count;trace->bytes+=count*host.page_stride;}
+        // All uploads must finish before diagnostic readback overwrites any
+        // packed source in this same buffer, including a partial final batch.
+        if (verify) for (std::size_t i=0;i<count;++i) {
+            const auto& source=archive.records.at(static_cast<std::size_t>(selected[first+i]));
+            // Diagnostic readback uses the existing full-page native API; it
+            // compares only the selected stripes, never calls them a canonical
+            // composite record and never inserts them into Host storage.
+            const std::array outputs{static_cast<std::byte*>(staging.data())};
+            drain.armed=true;pool.copy_to_host_records({destinations.data()+i,1},outputs,{},full_host,streams);drain.finish();
+            std::array<std::byte,4096> reference;
+            for (const auto& region:regions.regions()) {
+                std::uint64_t offset=0;
+                while (offset<region.plane.bytes) {
+                    const auto count=static_cast<std::size_t>(std::min<std::uint64_t>(reference.size(),region.plane.bytes-offset));
+                    source.read(static_cast<std::size_t>(region.plane.offset+offset),reference.data(),count);
+                    const auto* native=static_cast<const std::byte*>(staging.data())+
+                        static_cast<std::size_t>(region.plane.offset-pool_offset+offset);
+                    if (std::memcmp(native,reference.data(),count))
+                        throw std::runtime_error("native layer stripe readback differs from sealed source bytes");
+                    offset+=count;
+                }
+            }
+        }
+        first+=count;
+    }
+    const auto final_wait=trace?LayerRestoreTrace::Clock::now():LayerRestoreTrace::Clock::time_point{};
+    uploads.finish();if (trace) trace->wait_ms+=LayerRestoreTrace::elapsed(final_wait);
+    return checked.next;
+}
+NativeResidentStripe plan_native_resident_stripe(const kvmem::MemoryDescriptor& descriptor,
+    const kvmem::MemorySnapshot& current,const kvmem::LayerWorkingSetPlan& layer,
+    const DeviceKVPagePool& pool) {
+    std::vector<std::uint64_t> selected;
+    for (const auto& item:layer.plan.next.blocks) selected.push_back(item.block.id);
+    const auto checked=kvmem::plan_working_set(descriptor,current,selected,layer.plan.mandatory,layer.plan.budget);
+    if (descriptor.layout.block_tokens!=64 || current.stamp!=layer.plan.expected ||
+        !same_view(checked.next,layer.plan.next) || !checked.spill.empty() ||
+        !std::is_sorted(current.resident.begin(),current.resident.end()) ||
+        std::adjacent_find(current.resident.begin(),current.resident.end())!=current.resident.end() ||
+        !std::includes(current.resident.begin(),current.resident.end(),selected.begin(),selected.end()))
+        throw std::logic_error("resident stripe is not an exact chronological resident subset");
+    NativeResidentStripe result;
+    for (auto id:selected) {
+        const auto slot=std::lower_bound(current.resident.begin(),current.resident.end(),id)-current.resident.begin();
+        if (slot<result.source_slots.size() || slot>UINT32_MAX)
+            throw std::logic_error("resident stripe would overwrite an unread source");
+        result.source_slots.push_back(static_cast<std::uint32_t>(slot));
+    }
+    const auto host=plan_host_kv_page_layout(pool.geometry());
+    const kvmem::NativeKvLayerRegions regions(descriptor.layout,layer.model_layer);
+    if (regions.packed_bytes()!=layer.payload.packed_bytes() || regions.regions().size()!=layer.payload.regions().size())
+        throw std::logic_error("resident stripe payload does not match its layer");
+    for (std::size_t r=0;r<regions.regions().size();++r) {
+        const auto& region=regions.regions()[r];
+        if (!(region.plane==layer.payload.regions()[r].plane) ||
+            region.packed_offset!=layer.payload.regions()[r].packed_offset)
+            throw std::logic_error("resident stripe changed a native plane");
+        const auto found=std::find_if(host.planes.begin(),host.planes.end(),[&](const auto& p){return p.offset==region.plane.offset;});
+        const auto index=std::size_t(found-host.planes.begin());
+        if (found==host.planes.end() || found->page_payload_bytes!=region.plane.bytes ||
+            pool.geometry().planes[index].page_stride!=1 || pool.plane_rank(index)!=region.plane.rank ||
+            std::find(result.planes.begin(),result.planes.end(),index)!=result.planes.end())
+            throw std::logic_error("resident stripe does not match its physical pool");
+        result.planes.push_back(index);
+    }
+    return result;
+}
+
+void submit_native_resident_stripe(const NativeResidentStripe& recipe,DeviceKVPagePool& pool,
+    KVAddressSpaceStore& addresses,KVAddressSpaceHandle address,RankStreams streams,LayerRestoreTrace* trace) {
+    KVLayerStripeWrite::require_unpublished_destination(addresses,address,pool,
+        static_cast<std::uint32_t>(recipe.source_slots.size()));
+    const auto mapped=addresses.mapped_pages(address);
+    // Validate the entire recipe before mutation. Physical uniqueness follows
+    // from the complete address's exclusive writer-reference proof above.
+    for (std::size_t i=0;i<recipe.source_slots.size();++i)
+        if (recipe.source_slots[i]<i || recipe.source_slots[i]>=mapped ||
+            (i && recipe.source_slots[i]<=recipe.source_slots[i-1]))
+            throw std::logic_error("resident stripe has an unsafe source ordering");
+    std::uint64_t stripe_bytes=0;
+    if (trace) {
+        const auto host=plan_host_kv_page_layout(pool.geometry());
+        for (auto p:recipe.planes) stripe_bytes+=host.planes[p].page_payload_bytes;
+    }
+    std::array<DeviceKVPageHandle,64> from{},to{};
+    for (std::size_t first=0;first<recipe.source_slots.size();) {
+        if (recipe.source_slots[first]==first) {++first;continue;}
+        std::size_t count=0;
+        const auto gap=recipe.source_slots[first]-first;
+        // A physical contiguous run may still overlap its source. Bound it by
+        // the logical gap, then split again on either physical discontinuity.
+        for (;count<std::min<std::size_t>({64,gap,recipe.source_slots.size()-first});++count) {
+            if (recipe.source_slots[first+count]!=recipe.source_slots[first]+count) break;
+            const auto a=addresses.physical_page(address,recipe.source_slots[first+count]);
+            const auto b=addresses.physical_page(address,static_cast<std::uint32_t>(first+count));
+            from[count]=a;to[count]=b;
+            if (count && (pool.contiguous_run_count({from.data(),count+1})!=1 ||
+                pool.contiguous_run_count({to.data(),count+1})!=1)) break;
+        }
+        pool.copy_page_run_planes({from.data(),count},{to.data(),count},recipe.planes,streams);
+        if (trace) {
+            ++trace->batches;trace->pages+=count;
+            trace->bytes+=count*stripe_bytes;
+        }
+        first+=count;
+    }
+}
+} // namespace ninfer::models::qwen3_5::detail
diff --git a/src/models/qwen3_5/program/storage/layerwise_kv_transfer.h b/src/models/qwen3_5/program/storage/layerwise_kv_transfer.h
new file mode 100644
index 0000000000000000000000000000000000000000..c51516fafa166fdd6f4258f4c770c39ee887d78f
--- /dev/null
+++ b/src/models/qwen3_5/program/storage/layerwise_kv_transfer.h
@@ -0,0 +1,53 @@
+#pragma once
+
+#include "core/host_kv_arena.h"
+#include "models/qwen3_5/program/storage/layerwise_kv_write.h"
+#include "kvmem/host_kv_storage.hpp"
+#include "kvmem/layerwise_memory.hpp"
+
+namespace ninfer::models::qwen3_5::detail {
+
+// The Program owner freezes the complete, sealed canonical archive before any
+// stripe mutation. Sources retain immutable native bytes and the storage quota;
+// this descriptor does not duplicate the records or promote cold records.
+// Native block IDs are original 64-token page ordinals, never compact slots.
+struct NativeFrozenLayerArchive {
+    kvmem::MemoryDescriptor descriptor;
+    kvmem::MemorySnapshot canonical;
+    std::vector<kvmem::HostKvSource> records;
+};
+
+// Restore every selected page of one model layer, including retained pages whose
+// compact slot may have changed. Other layer/rank stripes are untouched. The
+// caller has already reserved COW overlap, frozen an exact State checkpoint and
+// established the explicit unpublished destination over the complete address.
+//
+// staging is pinned caller-owned transfer memory, separately admitted from the
+// canonical KV storage. Only the packed layer record must fit (or the full pool
+// record when diagnostic_readback is requested). The call drains native copies
+// before reusing staging or returning a receipt. A failed transfer can leave the
+// unpublished destination partially written; its owner must restore/invalidate
+// the whole execution, never publish only old metadata.
+kvmem::ExecutionView restore_native_layer_stripe(
+    const NativeFrozenLayerArchive&, const kvmem::MemorySnapshot& current_layer,
+    const kvmem::LayerWorkingSetPlan&, DeviceKVPagePool&, KVAddressSpaceStore&,
+    KVAddressSpaceHandle, DeviceContext&, RankStreams, PinnedHostBuffer& staging,
+    std::uint64_t canonical_pool_offset=0, bool diagnostic_readback=false);
+
+// Build this recipe against the accepted view BEFORE revoking its coverage.
+// Only chronological resident subsets qualify; every destination's source slot
+// is at least that destination. Ascending copies therefore cannot destroy a
+// later unread source. COW changes physical handles, never these logical slots.
+struct LayerRestoreTrace;
+struct NativeResidentStripe {
+    std::vector<std::uint32_t> source_slots;
+    std::vector<std::size_t> planes;
+};
+NativeResidentStripe plan_native_resident_stripe(const kvmem::MemoryDescriptor&,
+    const kvmem::MemorySnapshot&,const kvmem::LayerWorkingSetPlan&,const DeviceKVPagePool&);
+// Does not wait or publish. Caller retains the entire private address until its
+// own completion fence, including cancellation and all error paths.
+void submit_native_resident_stripe(const NativeResidentStripe&,DeviceKVPagePool&,
+    KVAddressSpaceStore&,KVAddressSpaceHandle,RankStreams,LayerRestoreTrace* trace=nullptr);
+
+} // namespace ninfer::models::qwen3_5::detail
diff --git a/src/models/qwen3_5/program/storage/layerwise_kv_write.h b/src/models/qwen3_5/program/storage/layerwise_kv_write.h
new file mode 100644
index 0000000000000000000000000000000000000000..8e84b189f056e25d6fc30f408765546730f4b891
--- /dev/null
+++ b/src/models/qwen3_5/program/storage/layerwise_kv_write.h
@@ -0,0 +1,243 @@
+#pragma once
+
+#include "core/device.h"
+#include "models/qwen3_5/program/storage/kv_store.h"
+
+namespace ninfer::models::qwen3_5::detail {
+
+// A Program-owned safe-boundary write lease over existing compact page slots.
+// It copies a whole native page before detaching any immutable/shared/Host
+// version, even though the caller subsequently changes only one layer stripe.
+// Every page retains the existing pool/layout/table ABI. This is not a second
+// allocation policy: its physical reservation comes from that pool and must be
+// admitted by Program's ordinary pressure/resource transaction.
+class KVLayerStripeWrite {
+public:
+    // A new append page can be used as bounded transfer scratch without
+    // revoking or pretending to re-commit any accepted historical page.
+    static void require_unpublished_suffix_destination(KVAddressSpaceStore& owner,
+        KVAddressSpaceHandle address,const DeviceKVPagePool& pool,
+        std::uint32_t first,std::uint32_t count) {
+        const auto& a=owner.require_active(address);
+        if (&owner.pages_->physical_pool()!=&pool || !a.row || first>a.page_count || count>a.page_count-first ||
+            std::uint64_t(first)*kPagedKVPageSize<a.committed_frontier ||
+            std::uint64_t(first)*kPagedKVPageSize<a.checkpoint_frontier)
+            throw std::logic_error("native transfer scratch overlaps accepted/checkpoint coverage");
+        for (std::uint32_t i=0;i<count;++i) {
+            const auto& page=owner.pages_->require(owner.membership(a,first+i));
+            if (!in_place(page) || page.writer_references!=1 || page.committed_columns)
+                throw std::logic_error("native transfer scratch is not an exclusive unpublished suffix");
+        }
+    }
+
+    // A stripe write cannot borrow the public committed-coverage API to make
+    // accepted pages mutable. Only the explicit complete-address transition
+    // below establishes this Program-private destination; newly mapped suffix
+    // pages have the same exclusive, unpublished ownership.
+    static void require_unpublished_destination(KVAddressSpaceStore& owner,
+        KVAddressSpaceHandle address, const DeviceKVPagePool& pool, std::uint32_t count) {
+        const auto& a=owner.require_active(address);
+        if (&owner.pages_->physical_pool()!=&pool || !a.row || a.committed_frontier ||
+            a.checkpoint_frontier || count>a.page_count)
+            throw std::logic_error("native stripe destination is not an unpublished address");
+        for (std::uint32_t i=0;i<a.page_count;++i) {
+            const auto& page=owner.pages_->require(owner.membership(a,i));
+            if (!in_place(page) || page.writer_references!=1 || page.committed_columns)
+                throw std::logic_error("native stripe destination is not exclusively unpublished");
+        }
+    }
+
+    static std::uint32_t copy_pages_required(KVAddressSpaceStore& owner,
+        KVAddressSpaceHandle address, std::uint32_t first, std::uint32_t count) {
+        const auto& a=owner.require_active(address);
+        if (!a.row || first>a.page_count || count>a.page_count-first)
+            throw std::invalid_argument("native layer stripe range is outside its address space");
+        std::uint32_t copies=0;
+        for (std::uint32_t i=0;i<count;++i) {
+            const auto handle=owner.membership(a,first+i);
+            const auto& page=owner.pages_->require(handle);
+            if (!page.device_replica || page.pending_device_replica || page.destination_pinned ||
+                page.source_pins || !page.active_references || !page.references || page.writer_references>1 ||
+                (page.writer_references && page.references!=1))
+                throw std::logic_error("native stripe source is pending or not a stable committed page");
+            if (!in_place(page) && !page.committed_columns)
+                throw std::logic_error("an uncommitted shared native page cannot establish a COW source");
+            copies+=!in_place(page);
+        }
+        return copies;
+    }
+
+    KVLayerStripeWrite(KVAddressSpaceStore& owner, KVAddressSpaceHandle address,
+        std::uint32_t first, std::uint32_t count, DeviceContext& device, RankStreams streams)
+        : owner_(&owner), address_(address), device_(&device), streams_(streams),
+          reservation_(owner.pages_->physical_pool().make_empty_reservation()) {
+        if (streams_.size()!=device.size())
+            throw std::invalid_argument("native stripe write must name every producing rank stream");
+        for (std::size_t rank=0;rank<device.size();++rank) {
+            DeviceBinding binding(device.rank(rank).device);
+            cudaStreamCaptureStatus status=cudaStreamCaptureStatusNone;
+            CUDA_CHECK(cudaStreamIsCapturing(streams_[rank],&status));
+            if (status!=cudaStreamCaptureStatusNone)
+                throw std::logic_error("native layer stripe mutation requires an eager Program boundary");
+        }
+        const auto required=copy_pages_required(owner,address,first,count);
+        entries_.reserve(count);
+        auto& a=owner.require_active(address);
+        for (std::uint32_t i=0;i<count;++i) {
+            const auto source=owner.membership(a,first+i);
+            const auto& page=owner.pages_->require(source);
+            entries_.push_back({first+i,source,{},page.content_epoch,page.committed_columns,
+                                page.writer_references!=0,!in_place(page),false});
+        }
+        // Quota admission and every metadata allocation precede source pins and
+        // the first native copy. A failure preserves the previous native view.
+        owner.pages_->physical_pool().resize_reservation(reservation_,required);
+        try {
+            for (auto& entry:entries_) {
+                owner.pages_->pin_source(entry.source);entry.pinned=true;
+                if (entry.copy)
+                    entry.destination=owner.pages_->materialize_transfer_destination(reservation_,entry.columns);
+            }
+        } catch (...) { (void)abort();throw; }
+    }
+    ~KVLayerStripeWrite() { (void)abort(); }
+    KVLayerStripeWrite(const KVLayerStripeWrite&)=delete;
+    KVLayerStripeWrite& operator=(const KVLayerStripeWrite&)=delete;
+
+    std::uint32_t copied_pages() const noexcept {
+        return static_cast<std::uint32_t>(std::count_if(entries_.begin(),entries_.end(),
+            [](const auto& entry){return entry.copy;}));
+    }
+
+    void copy_native_pages() {
+        require_open();
+        if (copies_started_) throw std::logic_error("native stripe COW copies were already issued");
+        validate_sources();
+        copies_started_=true;
+        for (const auto& entry:entries_) if (entry.copy)
+            owner_->pages_->physical_pool().copy_page(owner_->pages_->physical(entry.source),
+                owner_->pages_->physical(entry.destination),streams_);
+    }
+
+    // Completes the producer streams itself. No metadata claim can substitute
+    // for copying the other layer/rank planes and preserving their represented
+    // bytes before publication of the replacement physical table entries.
+    void commit() { commit_impl(false); }
+
+    // Explicit Program-private materialization destination. The caller already
+    // holds sealed canonical history and an exact rollback State checkpoint,
+    // and excludes this owner from capture/Pressure/session offers. Preserve
+    // every mapped byte/table slot but revoke whole-page accepted coverage while
+    // different model stripes are being restored. The accepted Sequence/window
+    // frontier is not changed here. Only after all target/GDN/auxiliary work may
+    // Program use the ordinary final commit_frontier on this destination.
+    void commit_unpublished_destination() { commit_impl(true); }
+
+private:
+    void commit_impl(bool unpublished) {
+        require_open();
+        if (!copies_started_) throw std::logic_error("native stripe COW has not completed its copy stage");
+        device_->synchronize();
+        validate_sources();
+        auto& a=owner_->require_active(address_);
+        if (unpublished && (entries_.size()!=a.page_count ||
+            (!entries_.empty() && (entries_.front().slot!=0 || entries_.back().slot+1!=a.page_count))))
+            throw std::logic_error("private layerwise destination must revoke the complete native address coverage");
+        auto& pages=*owner_->pages_;
+        // All remaining operations below use already reserved native metadata.
+        // A table upload failure leaves coherent new ownership for the caller
+        // to invalidate/restore; it never restores only old metadata.
+        for (auto& entry:entries_) {
+            pages.unpin_source(entry.source);entry.pinned=false;
+            if (entry.copy) {
+                pages.publish_transfer_destination(entry.destination,true);
+                pages.retain_active_reference(entry.destination);
+                owner_->membership(a,entry.slot)=entry.destination;
+                pages.release_active_reference(entry.source);
+                if (!pages.release_reference(entry.source,entry.writer)) std::terminate();
+                entry.destination={};
+            } else {
+                auto& page=pages.require(entry.source);
+                if (!in_place(page)) std::terminate();
+                if (!page.writer_references) pages.set_writer(entry.source,true);
+                page.content_epoch=LogicalKVPageStore::next_epoch(page.content_epoch);
+            }
+            if (unpublished) {
+                auto& destination=pages.require(owner_->membership(a,entry.slot));
+                destination.committed_columns=0;
+            }
+        }
+        if (unpublished) { a.committed_frontier=0;a.checkpoint_frontier=0; }
+        // Disarm before the fallible CUDA table upload. Every destination is
+        // already owned by this active address; abort cannot free it as staging.
+        auto* owner=std::exchange(owner_,nullptr);
+        owner->publish_membership(a,streams_);
+    }
+
+public:
+
+    // False means a device failure prevented a proved drain. Pending native
+    // destinations/sources stay quarantined in the original stores, rather than
+    // becoming reusable while a copy might still access them. Program must then
+    // invalidate its native continuation; the immutable canonical archive lives
+    // independently of this lease.
+    bool abort() noexcept {
+        if (!owner_) return true;
+        if (copies_started_) {
+            try { device_->synchronize(); }
+            catch (...) { owner_=nullptr;return false; }
+        }
+        auto& pages=*owner_->pages_;
+        for (auto& entry:entries_) {
+            if (entry.destination.valid()) pages.abort_transfer_destination(entry.destination,reservation_);
+            entry.destination={};
+            if (entry.pinned) {
+                try { pages.unpin_source(entry.source); }
+                catch (...) { std::terminate(); }
+                entry.pinned=false;
+            }
+        }
+        owner_=nullptr;
+        return true;
+    }
+private:
+    struct Entry {
+        std::uint32_t slot;
+        LogicalKVPageHandle source,destination;
+        std::uint64_t epoch;
+        std::uint32_t columns;
+        bool writer,copy,pinned;
+    };
+    template<class Page> static bool exclusive_page(const Page& page) noexcept {
+        return page.references==1 && page.active_references==1 && page.writer_references<=1 &&
+            !page.protected_columns && !page.destination_pinned &&
+            !page.host_replica && !page.pending_device_replica && page.device_replica.has_value();
+    }
+    template<class Page> static bool in_place(const Page& page) noexcept {
+        return exclusive_page(page) && !page.source_pins;
+    }
+    void require_open() const {
+        if (!owner_) throw std::logic_error("native stripe write lease is closed");
+    }
+    void validate_sources() const {
+        const auto& a=owner_->require_active(address_);
+        for (const auto& entry:entries_) {
+            if (!(owner_->membership(a,entry.slot)==entry.source))
+                throw std::logic_error("native stripe compact membership changed before COW commit");
+            const auto& page=owner_->pages_->require(entry.source);
+            if (page.content_epoch!=entry.epoch || page.committed_columns!=entry.columns ||
+                page.writer_references!=std::uint8_t(entry.writer) || page.source_pins!=1 ||
+                !entry.pinned || !page.active_references || page.destination_pinned ||
+                (!entry.copy && !exclusive_page(page)))
+                throw std::logic_error("native stripe source changed before COW commit");
+        }
+    }
+    KVAddressSpaceStore* owner_;
+    KVAddressSpaceHandle address_;
+    DeviceContext* device_;
+    RankStreams streams_;
+    DeviceKVPageReservation reservation_;
+    std::vector<Entry> entries_;
+    bool copies_started_=false;
+};
+} // namespace ninfer::models::qwen3_5::detail
