diff --git a/src/models/qwen3_5/execution/layerwise_graph_capture.cpp b/src/models/qwen3_5/execution/layerwise_graph_capture.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..181bfdb83709f328797da3b389d4177a551735d2
--- /dev/null
+++ b/src/models/qwen3_5/execution/layerwise_graph_capture.cpp
@@ -0,0 +1,77 @@
+#include "models/qwen3_5/execution/layerwise_graph_capture.h"
+#include "core/device.h"
+#include <algorithm>
+#include <limits>
+#include <stdexcept>
+
+namespace ninfer::models::qwen3_5::execution {
+namespace {
+bool plane(const Tensor& t,DType dtype,std::uint64_t count) {
+    if (!t.data || t.dtype!=dtype) return false;
+    std::uint64_t size=1;
+    for (auto extent:t.ne) {
+        if (extent<=0 || size>std::uint64_t(INT64_MAX)/static_cast<std::uint32_t>(extent)) return false;
+        size*=static_cast<std::uint32_t>(extent);
+    }
+    return size==count && t.is_contiguous();
+}
+}
+void LayerwiseGraphCaptureView::validate() const {
+    if (slots.empty() || !max_physical_rows || max_physical_rows>64 || !max_batch_size ||
+        std::uint64_t(max_physical_rows)*max_batch_size>std::uint64_t(INT32_MAX))
+        throw std::logic_error("layerwise graph capture has an invalid native physical extent");
+    const auto rows=std::uint64_t(max_physical_rows)*max_batch_size;
+    for (std::size_t i=0;i<slots.size();++i) {
+        const auto& s=slots[i];
+        if (s.query.ne[0]<=0 || !s.query_heads ||
+            std::uint64_t(s.query.ne[0])>std::uint64_t(INT64_MAX)/s.query_heads/rows)
+            throw std::length_error("layerwise graph Q descriptor extent overflows");
+        if (!s.query_heads || !s.global_query_heads || s.first_query_head>s.global_query_heads ||
+            s.query_heads>s.global_query_heads-s.first_query_head || s.query.ne[0]<=0 ||
+            !plane(s.query,DType::BF16,std::uint64_t(s.query.ne[0])*s.query_heads*rows) ||
+            s.query.ne[1]!=s.query_heads || s.query.ne[2]!=rows || s.query.ne[3]!=1 ||
+            !plane(s.positions,DType::I32,rows) || !plane(s.table_rows,DType::I32,max_batch_size) ||
+            !plane(s.completed_epoch,DType::I64,1) || !plane(s.ingress_epoch,DType::I64,1))
+            throw std::logic_error("layerwise graph capture has incomplete native Q/control backing");
+        if (std::uint64_t(s.query.ne[0])>std::uint64_t(INT64_MAX)/s.query_heads/rows)
+            throw std::length_error("layerwise graph Q tensor extent overflows its native byte domain");
+        std::uint64_t covered=0;
+        for (std::size_t j=0;j<slots.size();++j) {
+            const auto& t=slots[j];
+            if (t.model_layer!=s.model_layer) continue;
+            if (t.attention_layer!=s.attention_layer || t.global_query_heads!=s.global_query_heads ||
+                t.query.ne[0]!=s.query.ne[0])
+                throw std::logic_error("layerwise graph target head descriptors disagree");
+            if (i!=j && (t.rank==s.rank ||
+                (t.first_query_head<s.first_query_head+s.query_heads &&
+                 s.first_query_head<t.first_query_head+t.query_heads)))
+                throw std::logic_error("layerwise graph target heads overlap");
+            covered+=t.query_heads;
+        }
+        if (covered!=s.global_query_heads)
+            throw std::logic_error("layerwise graph target heads are not complete");
+        if (i && (slots[i-1].model_layer>s.model_layer ||
+            (slots[i-1].model_layer==s.model_layer && slots[i-1].first_query_head>=s.first_query_head)))
+            throw std::logic_error("layerwise graph capture targets are out of native head order");
+    }
+}
+void capture_layerwise_graph_attention(const LayerwiseGraphCaptureView& view,
+    std::uint32_t model,std::uint32_t ordinal,std::size_t rank,const Tensor& q,
+    const Tensor& positions,const Tensor& tables,cudaStream_t stream) {
+    const auto found=std::find_if(view.slots.begin(),view.slots.end(),[&](const auto& s) {
+        return s.model_layer==model && s.attention_layer==ordinal && s.rank==rank;
+    });
+    if (found==view.slots.end() || !q.data || q.dtype!=DType::BF16 || !q.is_contiguous() ||
+        q.ne[0]!=found->query.ne[0] || q.ne[1]!=found->query_heads || q.ne[2]<=0 || q.ne[3]!=1 ||
+        q.ne[2]>found->query.ne[2] || !positions.data || positions.dtype!=DType::I32 ||
+        !positions.is_contiguous() || positions.numel()!=q.ne[2] || !tables.data ||
+        tables.dtype!=DType::I32 || !tables.is_contiguous() || tables.numel()<=0 ||
+        tables.numel()>view.max_batch_size || q.ne[2]%tables.numel() ||
+        q.ne[2]/tables.numel()>view.max_physical_rows)
+        throw std::logic_error("native graph Q/control differs from its admitted target capture");
+    CUDA_CHECK(cudaMemcpyAsync(found->query.data,q.data,q.bytes(),cudaMemcpyDeviceToDevice,stream));
+    CUDA_CHECK(cudaMemcpyAsync(found->positions.data,positions.data,positions.bytes(),cudaMemcpyDeviceToDevice,stream));
+    CUDA_CHECK(cudaMemcpyAsync(found->table_rows.data,tables.data,tables.bytes(),cudaMemcpyDeviceToDevice,stream));
+    CUDA_CHECK(cudaMemcpyAsync(found->completed_epoch.data,found->ingress_epoch.data,sizeof(std::uint64_t),cudaMemcpyDeviceToDevice,stream));
+}
+} // namespace ninfer::models::qwen3_5::execution
diff --git a/src/models/qwen3_5/execution/layerwise_graph_capture.h b/src/models/qwen3_5/execution/layerwise_graph_capture.h
new file mode 100644
index 0000000000000000000000000000000000000000..54c1b638cfda4625d246c8a23853ae1446d09659
--- /dev/null
+++ b/src/models/qwen3_5/execution/layerwise_graph_capture.h
@@ -0,0 +1,52 @@
+#pragma once
+#include "core/tensor.h"
+#include <cuda_runtime_api.h>
+#include <cstddef>
+#include <cstdint>
+#include <span>
+#include <stdexcept>
+
+namespace ninfer::models::qwen3_5::detail {class NativeLayerwiseGraphFeedbackStorage;}
+
+namespace ninfer::models::qwen3_5::execution {
+// Immutable descriptors and all backing addresses belong to Program. They outlive
+// every cached graph definition/executable, independently of request retirement.
+struct LayerwiseGraphAttentionSlot {
+    std::uint32_t model_layer=0,attention_layer=0;
+    std::size_t rank=0;
+    std::uint32_t first_query_head=0,query_heads=0,global_query_heads=0;
+    Tensor query,positions,table_rows,completed_epoch,ingress_epoch;
+};
+struct LayerwiseGraphCaptureView {
+    std::span<const LayerwiseGraphAttentionSlot> slots;
+    std::uint32_t max_physical_rows=0,max_batch_size=0;
+    // Allocation-free descriptor validation; call before capture or native work.
+    void validate() const;
+};
+// Issued only by the Program's stable storage. Startup capture/warmup carries
+// no request identity; replay requires an already armed whole-cohort epoch.
+// A non-null observer cannot grant this execution contract.
+class LayerwiseGraphExecutionPermit {
+public:
+    LayerwiseGraphExecutionPermit(const LayerwiseGraphExecutionPermit&)=default;
+    void validate(const LayerwiseGraphCaptureView* view,std::uint32_t physical,std::uint32_t batch) const {
+        if (!view || view!=view_ || physical!=physical_ || batch!=batch_ ||
+            !physical || physical>view->max_physical_rows || !batch || batch>view->max_batch_size ||
+            (replay_ && !epoch_) || (!replay_ && epoch_))
+            throw std::logic_error("native graph copy has no exact Program/cohort execution permit");
+    }
+private:
+    friend class ::ninfer::models::qwen3_5::detail::NativeLayerwiseGraphFeedbackStorage;
+    LayerwiseGraphExecutionPermit(const LayerwiseGraphCaptureView* view,std::uint32_t physical,
+        std::uint32_t batch,std::uint64_t epoch,bool replay):view_(view),physical_(physical),batch_(batch),epoch_(epoch),replay_(replay) {}
+    const LayerwiseGraphCaptureView* view_;
+    std::uint32_t physical_,batch_;
+    std::uint64_t epoch_;
+    bool replay_;
+};
+// Capture-safe D2D copies only. No Host owner callback, allocation, mass Op,
+// parser, sampled-row decision or accepted-state publication runs here.
+void capture_layerwise_graph_attention(const LayerwiseGraphCaptureView&,
+    std::uint32_t model_layer,std::uint32_t attention_layer,std::size_t rank,
+    const Tensor& query,const Tensor& positions,const Tensor& table_rows,cudaStream_t);
+} // namespace ninfer::models::qwen3_5::execution
diff --git a/src/models/qwen3_5/execution/memory_statistics.h b/src/models/qwen3_5/execution/memory_statistics.h
new file mode 100644
index 0000000000000000000000000000000000000000..2259a3d7a4c9e51a3921f589086617407d2aed87
--- /dev/null
+++ b/src/models/qwen3_5/execution/memory_statistics.h
@@ -0,0 +1,145 @@
+#pragma once
+#include "core/tensor.h"
+#include <algorithm>
+#include <stdexcept>
+#include <vector>
+
+namespace ninfer::models::qwen3_5::execution {
+// Stable Program-owned buffers, borrowed by eager execution and graph capture.
+// Each shard holds a stage's layers or a TP rank's heads of all layers.
+// Host stores use global layer and head order, independent of device partition.
+// Key sums: FP32 [key_width,buckets,layers]. Query values are either compact
+// BF16 [query_width,query_capacity,layers] or seeded FP32 [query_width,1,layers]
+// for Mean-Q; attention feedback uses its separate post-RoPE capture.
+// Ranges: [K begin,end,Q begin,end].
+// Only normalized, represented BF16 values BEFORE RoPE enter these reductions.
+struct MemoryStatisticsShard {
+    Tensor key_sums;
+    Tensor query_values;
+    Tensor attention_queries; // BF16 post-RoPE target Q, three global spread3 slots
+    Tensor attention_tokens;
+    Tensor attention_rows, attention_positions, attention_scratch, attention_norms, attention_output;
+    Tensor ranges;
+    // Prefill aggregates complete logical blocks; speculative verification keeps
+    // one column per candidate until the Frontend commits an exact prefix.
+    std::uint32_t block_tokens = 64;
+    Tensor candidate_origin;
+    Tensor prefill_origin;
+    std::uint32_t first_layer = 0;
+    // Feature offsets in a whole layer, derived from the rank's KV/query head range.
+    std::uint32_t key_offset = 0;
+    std::uint32_t query_offset = 0;
+    // Consecutive TP prefill pieces share one whole-chunk statistics record.
+    std::int32_t input_offset = 0;
+    std::int32_t chunk_tokens = 0;
+};
+
+// One contiguous shard's columns scattered into the complete host head order.
+// Sources have width_bytes pitch; destinations have destination_pitch. Keeping
+// this geometry independent of CUDA lets the host tests check actual values in
+// the same layout used by the asynchronous device copies.
+struct MemoryStatisticsCopy {
+    std::size_t rank;
+    const void* source;
+    std::size_t destination_offset;
+    std::size_t width_bytes;
+    std::size_t destination_pitch;
+    std::size_t rows;
+};
+
+struct MemoryStatistics {
+    std::vector<MemoryStatisticsShard> ranks;
+    std::uint32_t key_width = 0;
+    std::uint32_t query_width = 0;
+    std::uint32_t layers = 0;
+    std::uint32_t columns = 0;
+    std::uint32_t query_columns = 0;
+    bool mean_query = false;
+
+    void validate_layout() const {
+        if (!layers || !key_width || !query_width || !columns || !query_columns ||
+            query_width % key_width)
+            throw std::logic_error("KVMem statistics have an invalid global geometry");
+        const auto ratio = query_width / key_width;
+        std::vector<std::vector<std::pair<std::uint32_t, std::uint32_t>>> coverage(layers);
+        for (const auto& shard : ranks) {
+            if (!shard.key_sums.data) continue; // rank with no attention heads/layers
+            const auto& key = shard.key_sums;
+            const auto& query = shard.query_values;
+            if (key.dtype != DType::FP32 || !key.is_contiguous() || key.ne[3] != 1 ||
+                key.ne[0] <= 0 || key.ne[1] != columns || key.ne[2] <= 0 ||
+                std::uint64_t(shard.first_layer) + key.ne[2] > layers ||
+                std::uint64_t(shard.key_offset) + key.ne[0] > key_width ||
+                !query.data || query.dtype != (mean_query ? DType::FP32 : DType::BF16) ||
+                !query.is_contiguous() || query.ne[3] != 1 ||
+                query.ne[2] != key.ne[2] || query.ne[1] != query_columns ||
+                query.ne[0] != std::uint64_t(key.ne[0]) * ratio ||
+                shard.query_offset != std::uint64_t(shard.key_offset) * ratio)
+                throw std::logic_error("KVMem statistics shard disagrees with its global geometry");
+            for (std::int32_t i = 0; i < key.ne[2]; ++i)
+                coverage[shard.first_layer + i].emplace_back(shard.key_offset,
+                    shard.key_offset + static_cast<std::uint32_t>(key.ne[0]));
+        }
+        for (auto& layer : coverage) {
+            std::sort(layer.begin(), layer.end());
+            std::uint32_t next = 0;
+            for (const auto& range : layer) {
+                if (range.first != next)
+                    throw std::logic_error("KVMem statistics heads overlap or leave a gap");
+                next = range.second;
+            }
+            if (next != key_width)
+                throw std::logic_error("KVMem statistics do not cover every model head");
+        }
+    }
+
+    [[nodiscard]] std::size_t query_element_bytes() const noexcept {
+        return mean_query ? sizeof(float) : sizeof(std::uint16_t);
+    }
+
+    [[nodiscard]] std::size_t key_bytes() const noexcept {
+        return std::size_t(key_width) * columns * layers * sizeof(float);
+    }
+    [[nodiscard]] std::size_t query_elements() const noexcept {
+        return std::size_t(query_width) * query_columns * layers;
+    }
+    [[nodiscard]] std::size_t query_bytes() const noexcept {
+        return query_elements() * query_element_bytes();
+    }
+
+    // validate_layout() runs when the Program binds its buffers. query_count is
+    // the accepted capture prefix; unused candidate/query columns are not read.
+    template<class Visit>
+    void for_each_host_copy(bool include_query, std::uint32_t query_count, Visit&& visit) const {
+        const auto count = mean_query ? 1U : query_count;
+        if (include_query && (!count || count > query_columns))
+            throw std::logic_error("KVMem Query capture exceeds its planned capacity");
+        const auto key_pitch = std::size_t(key_width) * sizeof(float);
+        const auto query_pitch = std::size_t(query_width) * query_element_bytes();
+        for (std::size_t rank = 0; rank < ranks.size(); ++rank) {
+            const auto& shard = ranks[rank];
+            if (!shard.key_sums.data) continue;
+            if (std::uint64_t(shard.first_layer) + shard.key_sums.ne[2] > layers ||
+                std::uint64_t(shard.key_offset) + shard.key_sums.ne[0] > key_width ||
+                std::uint64_t(shard.query_offset) + shard.query_values.ne[0] > query_width)
+                throw std::logic_error("KVMem statistics shard is outside the global head layout");
+            for (std::int32_t layer = 0; layer < shard.key_sums.ne[2]; ++layer) {
+                const auto key = shard.key_sums.slice(2, layer, 1);
+                visit(MemoryStatisticsCopy{
+                    rank, key.data,
+                    (shard.first_layer + layer) * key_pitch * columns +
+                        std::size_t(shard.key_offset) * sizeof(float),
+                    std::size_t(key.ne[0]) * sizeof(float), key_pitch, columns});
+                if (include_query) {
+                    const auto query = shard.query_values.slice(2, layer, 1);
+                    visit(MemoryStatisticsCopy{
+                        rank, query.data,
+                        key_bytes() + (shard.first_layer + layer) * query_pitch * query_columns +
+                            std::size_t(shard.query_offset) * query_element_bytes(),
+                        std::size_t(query.ne[0]) * query_element_bytes(), query_pitch, count});
+                }
+            }
+        }
+    }
+};
+} // namespace ninfer::models::qwen3_5::execution
