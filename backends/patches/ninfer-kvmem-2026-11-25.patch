+constexpr std::uint32_t page_tokens = 64;
+constexpr std::size_t transfer_staging_limit = 64ULL << 20;
+std::atomic<std::uint64_t> next_window_session{1};
+std::atomic<std::uint64_t> next_history_access{1};
+std::atomic<std::uint64_t> next_checkpoint_origin{1};
+std::atomic<std::uint64_t> next_snapshot_group{1};
+std::atomic<std::uint64_t> next_canonical_epoch{1};
+
+std::uint32_t valid_columns(std::uint32_t logical_page, std::uint32_t frontier) {
+    return std::min(page_tokens, frontier - logical_page * page_tokens);
+}
+
+// Enumerate backend-owned checkpoint attachments into the existing physical
+// identity accounts. Repeated slots are intentional; callers deduplicate the
+// public allocation identity, including records shared with the active archive.
+template<class Visitor>
+void visit_memory_checkpoints(const KvmemWindowState& window, Visitor&& visitor) {
+    if (window.execution_checkpoint) visitor(*window.execution_checkpoint);
+    for (const auto& entry : window.checkpoints) if (entry.data) visitor(*entry.data);
+    for (const auto& entry : window.coverage)
+        if (entry.info.identity && entry.record.data) visitor(*entry.record.data);
+}
+
+struct CanonicalSnapshotInput {
+    std::size_t frontier = 0;
+    const KvmemPrefixCheckpoint* checkpoint = nullptr;
+    explicit operator bool() const noexcept { return checkpoint != nullptr; }
+};
+
+// Capacity lineage is the complete accepted input, excluding only the proven
+// rendering opener. A short edit to a real user/tool input is still a branch;
+// the anonymous continuation tail allowance is not an input-identity proof.
+CanonicalSnapshotInput canonical_snapshot_input(const KvmemWindowState& window,
+                                                std::size_t image_bytes) {
+    if (!window.stamp.valid || !window.statistics || !window.selector || !image_bytes) return {};
+    std::size_t frontier = window.output_begin;
+    bool found = false;
+    if (window.request_messages) for (const auto& span : *window.request_messages) if (!span.end_known) {
+        if (!span.begin || span.begin > window.output_begin || (found && frontier != span.begin)) return {};
+        frontier = span.begin; found = true;
+    }
+    if (!frontier) return {};
+    const KvmemPrefixCheckpoint* latest = nullptr;
+    const auto consider = [&](const std::shared_ptr<KvmemPrefixCheckpoint>& candidate) {
+        if (!candidate) return;
+        const auto& cp = *candidate;
+        const auto end = cp.prefix.size();
+        if (end < frontier || end > UINT32_MAX || end > window.statistics_frontier ||
+            !cp.identity.stamp.valid || cp.identity.stamp.frontier != end ||
+            !(cp.identity.stamp.session == window.stamp.session) ||
+            cp.state_bytes() != image_bytes || cp.prefix_identity.size() < end ||
+            cp.graph.accepted_through != end || cp.graph.block_tokens != page_tokens) return;
+        const auto pages = (end + page_tokens - 1) / page_tokens;
+        if (!kvmem_checkpoint_payload_covers(cp, pages, cp.identity.layout.record_bytes)) return;
+        if (!std::all_of(cp.resident_pages.begin(), cp.resident_pages.end(),
+                        [pages](auto page) { return page < pages; })) return;
+        if (!latest || end > latest->prefix.size()) latest = &cp;
+    };
+    for (const auto& record : window.checkpoints) consider(record.data);
+    for (const auto& entry : window.coverage) if (entry.info.identity) consider(entry.record.data);
+    return latest ? CanonicalSnapshotInput{frontier, latest} : CanonicalSnapshotInput{};
+}
+
+bool snapshot_input_matches(const CanonicalSnapshotInput& source, const PreparedPromptData& prompt) {
+    return source && source.frontier <= prompt.token_ids.size() &&
+        std::equal(source.checkpoint->prefix.begin(), source.checkpoint->prefix.begin() + source.frontier,
+                   prompt.token_ids.begin()) &&
+        source.checkpoint->prefix_identity.matches(prompt, source.frontier);
+}
+
+bool snapshot_inputs_comparable(const CanonicalSnapshotInput& left, const CanonicalSnapshotInput& right) {
+    if (!left || !right) return false;
+    const auto common = std::min(left.frontier, right.frontier);
+    return std::equal(left.checkpoint->prefix.begin(), left.checkpoint->prefix.begin() + common,
+                      right.checkpoint->prefix.begin()) &&
+        left.checkpoint->prefix_identity.prefix_equals(right.checkpoint->prefix_identity, common);
+}
+
+std::uint64_t snapshot_content_group(const CanonicalSnapshotInput& input, std::uint64_t previous,
+        const std::vector<std::optional<KvmemWindowState>>& histories, std::size_t image_bytes) {
+    if (!input) return next_snapshot_group.fetch_add(1);
+    std::vector<std::uint64_t> checked(histories.size());
+    std::size_t count = 0, deepest = 0;
+    std::uint64_t selected = 0;
+    for (const auto& history : histories) {
+        if (!history || !history->cache_group || std::find(checked.begin(), checked.begin() + count,
+                history->cache_group) != checked.begin() + count) continue;
+        const auto group = history->cache_group;
+        checked[count++] = group;
+        bool comparable = true;
+        std::size_t depth = 0;
+        for (const auto& member : histories) if (member && member->cache_group == group) {
+            const auto other = canonical_snapshot_input(*member, image_bytes);
+            if (!snapshot_inputs_comparable(input, other)) { comparable = false; break; }
+            depth = std::max(depth, std::min(input.frontier, other.frontier));
+        }
+        if (comparable && (!selected || depth > deepest ||
+                (depth == deepest && group == previous && selected != previous) ||
+                (depth == deepest && selected != previous && group < selected))) {
+            selected = group; deepest = depth;
+        }
+    }
+    return selected ? selected : next_snapshot_group.fetch_add(1);
+}
+
+void publish_memory_checkpoint_source(KvmemWindowState& window,
+                                     std::shared_ptr<KvmemPrefixCheckpoint> checkpoint,
+                                     bool query_source) {
+    // Create both entries before borrowing their vector-backed references. A
+    // forked catalog's capacity can be smaller than its configured slot limit.
+    (void)window.checkpoints.slot(kvmem::CheckpointPurpose::QueryReplay);
+    (void)window.checkpoints.slot(kvmem::CheckpointPurpose::PromptTail);
+    publish_checkpoint_execution_source(
+        window.checkpoints.slot(kvmem::CheckpointPurpose::QueryReplay).data,
+        window.checkpoints.slot(kvmem::CheckpointPurpose::PromptTail).data,
+        std::move(checkpoint), query_source, window.query_replay_active);
+    if (query_source) window.execution_checkpoint = window.checkpoints.slot(kvmem::CheckpointPurpose::QueryReplay).data;
+}
