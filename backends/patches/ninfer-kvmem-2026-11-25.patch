+
+namespace ninfer::models::qwen3_5::detail {
+namespace {
+enum Plane : std::uint32_t { Query, Key, Value, Gate, Residual, CachePosition, RopePosition, KeySum,
+                            RopePosition1, RopePosition2 };
+std::uint32_t rope_plane(std::uint32_t axis) {
+    if (axis>2) throw std::logic_error("invalid native Query RoPE axis");
+    return axis?RopePosition1+axis-1:RopePosition;
+}
+void validate_axes(std::uint32_t axes) {
+    if (axes!=1 && axes!=3) throw std::invalid_argument("native Query requires one or three native RoPE axes");
+}
+std::uint64_t add(std::uint64_t a, std::uint64_t b) {
+    if (b > UINT64_MAX - a) throw std::length_error("native Query activation extent overflow");
+    return a + b;
+}
+std::uint64_t multiply(std::uint64_t a, std::uint64_t b) {
+    if (b && a > UINT64_MAX / b) throw std::length_error("native Query activation extent overflow");
+    return a * b;
+}
+std::size_t addressable(std::uint64_t bytes) {
+    if (bytes > SIZE_MAX) throw std::length_error("native Query activation exceeds host addressing");
+    return static_cast<std::size_t>(bytes);
+}
+std::int32_t dim(std::uint64_t n) {
+    if (!n || n > INT32_MAX) throw std::invalid_argument("native Query tensor dimension exceeds int32");
+    return static_cast<std::int32_t>(n);
+}
+std::uint64_t row_bytes(const kvmem::QueryProjectionLayout& layout) {
+    std::uint64_t bytes = 0;
+    for (const auto& plane : layout.planes) bytes = add(bytes, plane.row_stride);
+    return bytes;
+}
+} // namespace
+
+std::uint64_t native_query_device_bound(const TextConfig& config,std::uint32_t chunk) {
+    return native_query_device_bound(config,chunk,1);
+}
+std::uint64_t native_query_staging_bytes(const TextConfig& config,std::uint32_t chunk) {
+    return native_query_staging_bytes(config,chunk,1);
+}
+std::uint64_t native_query_tensor_staging_bytes(const TextConfig& config,std::uint32_t chunk,std::uint32_t ranks) {
+    return native_query_tensor_staging_bytes(config,chunk,ranks,1);
+}
+std::uint64_t native_query_mtp_device_bound(const TextConfig& config,std::uint32_t chunk) {
+    return native_query_mtp_device_bound(config,chunk,1);
+}
+
+std::uint64_t native_query_device_bound(const TextConfig& config,std::uint32_t chunk,std::uint32_t axes) {
+    validate_axes(axes);
+    if (!config.attention || !chunk) throw std::invalid_argument("native Query storage requires attention geometry");
+    const auto row=add(add(multiply(4,config.attention->query_width()),multiply(4,config.attention->key_width())),
+        add(multiply(4,config.hidden_size),8+4*axes));
+    // Stable native planes plus rank-local table/origin controls. Each rank
+    // has its own allocation; no rank follows a pointer into another device.
+    return add(add(multiply(row,chunk),multiply(4,config.vocab_size)),13*256);
+}
+std::uint64_t native_query_staging_bytes(const TextConfig& config,std::uint32_t chunk,std::uint32_t axes) {
+    validate_axes(axes);
+    if (!config.attention || !chunk) throw std::invalid_argument("native Query staging requires attention geometry");
+    return multiply(chunk,add(add(multiply(4,config.attention->query_width()),multiply(8,config.attention->key_width())),
+        add(multiply(2,config.hidden_size),4+4*axes)));
+}
+std::uint64_t native_query_tensor_staging_bytes(const TextConfig& config,std::uint32_t chunk,std::uint32_t ranks,std::uint32_t axes) {
+    validate_axes(axes);
+    if (!config.attention || !chunk || !ranks) throw std::invalid_argument("native tensor Query staging requires attention geometry");
+    // One local native projection frame plus an exact full-head Query/sum
+    // tile. No floating conversion or rank-average score is stored here.
+    return add(add(native_query_staging_bytes(config,chunk,axes),multiply(multiply(chunk,ranks-1),
+        add(multiply(2,config.hidden_size),4+4*axes))),multiply(chunk,
+        std::max(multiply(2,config.attention->query_width()),multiply(4,config.attention->key_width()))));
+}
+std::uint64_t native_query_mtp_device_bound(const TextConfig& config,std::uint32_t chunk,std::uint32_t axes) {
+    validate_axes(axes);
+    const auto base=native_query_device_bound(config,chunk,axes);
+    LayoutBuilder controls;
+    controls.add_tensor(DType::I32,{dim(chunk)},256,"MTP stable IDs");
+    controls.add_tensor(DType::I32,{dim(chunk)},256,"MTP stable cache positions");
+    controls.add_tensor(DType::I32,{dim(chunk),dim(axes)},256,"MTP stable RoPE positions");
+    if (axes==3) controls.add_tensor(DType::BF16,{dim(config.hidden_size),dim(chunk)},256,"MTP shifted composed input");
+    return add(add(base,255)/256*256,controls.finish(256));
+}
+
+struct NativeLayerwiseQueryExecution::Impl {
+    execution::Parameters const* parameters;
+    const TextConfig& config;
+    DeviceContext& device;
+    WorkspaceArena& execution_workspace;
+    kvmem::LayerwiseQueryRequest& request;
+    const kvmem::LayerwiseQueryIdentity identity;
+    NativeQueryRunnerBindings bindings;
+    NativeQueryPromptInput prompt_input;
+    std::uint32_t rope_axes=1;
+    std::uint32_t mean_block=64;
+    struct InputTile {std::uint64_t begin;std::uint32_t count;};
+    std::vector<InputTile> tiles;
+    NativeQueryRunnerStage stage = NativeQueryRunnerStage::Embedding;
+    std::uint32_t chunk, layer = 0, attention = 0;
+    std::int32_t rope_delta, source_slot, destination_slot;
+    std::uint64_t cursor, tape_peak = 0, pin_bytes = 0, gpu_bytes = 0;
+    bool use_disk = false, took_landing_events = false;
+    execution::StageRuntime* stages;
+    bool tensor = false;
+    std::size_t attention_ranks=0, exchange_slot=0;
+    std::uint64_t tensor_staging_offset=0;
+    bool tensor_table_valid=false;
+    std::int32_t tensor_table_row=-1;
+    std::array<std::int32_t, 4> ranges{};
+    kvmem::QueryProjectionLayout residual_layout, projected_layout;
+    std::unique_ptr<kvmem::HostKvStorage> activation_ram;
+    std::unique_ptr<kvmem::HostKvStorage> activation_metadata;
+    std::unique_ptr<kvmem::HostKvReservation> metadata_controls;
+    std::uint64_t max_chunks=0;
+    std::unique_ptr<kvmem::SpillFile> activation_disk;
+    std::unique_ptr<DeviceArena> stable;
+    std::unique_ptr<PinnedHostBuffer> staging;
+    struct RankStorage {
+        execution::PreparedLayerQueryStorage capacity;
+        Tensor ids, hidden, logits, table_row, origin;
+    };
+    std::vector<RankStorage> ranks;
+    Tensor tail;
+    std::shared_ptr<kvmem::QueryProjectionTape> input,output,original_input;
+    std::unique_ptr<kvmem::QueryProjectionTape> projection;
+    std::vector<std::unique_ptr<execution::PreparedLayerQuery>> prepared;
+    struct TensorProjection {
+        std::uint32_t query_begin=0,query_heads=0,key_begin=0,key_heads=0;
+        std::uint64_t staging_offset=0;
+        kvmem::QueryProjectionLayout layout;
+        std::unique_ptr<kvmem::QueryProjectionTape> tape;
+        std::vector<std::unique_ptr<execution::PreparedLayerQuery>> prepared;
+    };
+    std::vector<TensorProjection> tensor_projection;
+
+    Impl(execution::PrefillContext& context, kvmem::LayerwiseQueryRequest& transaction,
+         NativeQueryActivationLimits limits, NativeQueryRunnerBindings hooks, std::int32_t delta,NativeQueryPromptInput source)
+        : parameters(&context.execution.parameters), config(parameters->model.config().text),
+          device(context.execution.device),execution_workspace(context.execution.work), request(transaction), identity(request.identity()),
+          bindings(std::move(hooks)), prompt_input(source),rope_axes(source.prompt?3:1),chunk(context.execution.prefill_chunk), rope_delta(delta),
+          source_slot(context.state_source_slot), destination_slot(context.state_destination_slot),
+          cursor(identity.evaluation.begin),stages(context.execution.stages),
+          tensor(stages && stages->tensor_parallel.has_value()) {
+        if (!kvmem::valid_layerwise_query_identity(identity) || identity.evaluation.begin % 64 ||
+            identity.evaluation.end > INT32_MAX || !chunk || !config.attention ||
+            !config.full_attention_layers || !bindings.score || !bindings.restore ||
+            bindings.historical_tokens > UINT32_MAX - (identity.evaluation.end - identity.evaluation.begin) ||
+            std::int64_t(identity.evaluation.begin) + rope_delta < 0 ||
+            std::int64_t(identity.evaluation.end - 1) + rope_delta > INT32_MAX)
+            throw std::invalid_argument("native Query requires an admitted aligned source and bounded native geometry");
+        if ((!source.prompt && source.vision) || (source.prompt &&
+            (source.prompt->positions.size()!=3*source.prompt->token_ids.size() ||
+             source.prompt->token_types.size()!=source.prompt->token_ids.size() ||
+             identity.evaluation.end!=source.prompt->token_ids.size())))
+            throw std::invalid_argument("native Query composed input lost its complete trusted prompt/positions");
+        if (source.prompt && !source.vision && std::any_of(
+            source.prompt->token_types.begin()+static_cast<std::ptrdiff_t>(identity.evaluation.begin),
+            source.prompt->token_types.end(),[](auto type){return type!=0;}))
+            throw std::invalid_argument("native Query visual rows require their real Vision input session");
+        if (source.prompt) for (auto value:source.prompt->positions)
+            if (value<0) throw std::invalid_argument("native Query original RoPE position is negative");
+        validate_context(context);
+        DeviceBinding device_binding(device.device);
+        if (context.execution.memory_statistics)
+            mean_block = context.execution.memory_statistics->ranks.at(0).block_tokens;
+        if (mean_block != 32 && mean_block != 64)
+            throw std::invalid_argument("native Query has unsupported Mean-K capture geometry");
+        if (bindings.commit_mean && context.execution.memory_statistics == nullptr)
+            throw std::invalid_argument("native Query Mean-K publication requires native statistics buffers");
+        const auto rows = identity.evaluation.end - identity.evaluation.begin;
+        chunk = std::min(chunk, static_cast<std::uint32_t>(rows));
+        const std::uint64_t h = config.hidden_size, q = config.attention->query_width(),
+                            k = config.attention->key_width();
+        residual_layout = {"ninfer.layerwise.bf16-residual", 1, {{Residual, multiply(h, 2)}}};
+        projected_layout = {"ninfer.layerwise.pre-rope-bf16-qkv-gate-residual-i32-fp32-sums", 1,
+            {{Query, multiply(q, 2)}, {Key, multiply(k, 2)}, {Value, multiply(k, 2)},
+             {Gate, multiply(q, 2)}, {Residual, multiply(h, 2)}, {CachePosition, 4},
+             {RopePosition, 4}, {KeySum, multiply(k, 4)}}};
+        if (rope_axes==3) {
+            projected_layout.planes.insert(projected_layout.planes.end()-1,
+                {{RopePosition1,4},{RopePosition2,4}});
+            projected_layout.format += ".mrope-3axis";
+        }
+        // Count without allocating: native item boundaries can produce more
+        // tiles than ceil(P/chunk). Reserve their entire directory first.
+        for (auto begin=identity.evaluation.begin;begin<identity.evaluation.end;) {
+            const auto nominal=static_cast<std::uint32_t>(std::min<std::uint64_t>(chunk,identity.evaluation.end-begin));
+            const auto count=source.vision?source.vision->planned_chunk_length(static_cast<std::uint32_t>(begin),nominal):nominal;
+            if (!count || count>nominal) throw std::logic_error("native Query input tile made invalid progress");
+            ++max_chunks;begin+=count;
+        }
+        auto projection_rows=row_bytes(projected_layout);
+        auto projection_metadata=kvmem::QueryProjectionTape::metadata_bound(projected_layout,max_chunks);
+        std::uint64_t tensor_controls=0;
+        if (tensor) {
+            const auto& tp=*stages->tensor_parallel;
+            const auto group=config.attention->num_attention_heads/config.attention->num_key_value_heads;
+            tensor_projection.resize(device.size());projection_rows=0;projection_metadata=0;
+            std::uint32_t query_next=0,key_next=0;
