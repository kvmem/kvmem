+            std::size_t(prompt_columns)*sizeof(TokenId),cudaMemcpyHostToDevice,p.device.stream));
+        if (logits) CUDA_CHECK(cudaMemcpyAsync(ids.slice(0,dimension(n)-1,1).data,p.io.token.data,sizeof(TokenId),cudaMemcpyDeviceToDevice,p.device.stream));
