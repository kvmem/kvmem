+        const auto prior_work=probe_work;
+        probe_history.emplace(native_layerwise_probe(private_context,input->token_ids,identity,physical,
+            *policy,*frozen_keys,targets,[this]{return identity.history;},*probe_metadata,score,prepare,restore,probe_work,query_pins,
+            p.parameters.text.tensor_parallel()?&tensor_query:nullptr,tensor_host,
+            rope_axes==3?runner.get():nullptr,rope_axes==3?input:nullptr));
+        if (p.kvmem_options.verify_transfers) {
+            const auto elapsed=std::chrono::duration_cast<std::chrono::microseconds>(
+                std::chrono::steady_clock::now()-probe_started).count();
+            std::fprintf(stderr,"KVMEM_LAYERWISE_PROBE evaluation_rows=%llu projected_target_rows=%llu scored_query_rows=%llu restored=1 elapsed_us=%lld source_h=%llu source_l=%u\n",
+                static_cast<unsigned long long>(probe_work.evaluated_rows-prior_work.evaluated_rows),
+                static_cast<unsigned long long>(probe_work.projected_target_rows-prior_work.projected_target_rows),
+                static_cast<unsigned long long>(probe_work.scored_query_rows-prior_work.scored_query_rows),
+                static_cast<long long>(elapsed),static_cast<unsigned long long>(identity.evaluation.begin),physical);
+        }
+    }
+    void validate_owner(const execution::PrefillContext& context) const {
+        if (!input_owner || !input || request.lifecycle!=Lifecycle::Prefilling || !request.prefill ||
+            &*request.prefill!=input_owner || &request.prefill->prompt!=input ||
+            sequence.lane>=program.max_concurrency || &program.requests[sequence.lane]!=&request ||
+            &context.execution.device!=&program.device || &context.execution.parameters!=&program.parameters)
+            throw std::logic_error("native layerwise Query public-input owner or native request identity changed");
+    }
+    kvmem::ExecutionView actual_view(std::uint32_t model,kvmem::MemoryStamp stamp) const {
+        kvmem::ExecutionView view{stamp,{},0};
+        for (auto id:pending_maps.layer(model).pages) {
+            const auto& block=archive.canonical.blocks.at(id).block;
+            view.blocks.push_back({block,view.visible_tokens});view.visible_tokens+=block.valid_tokens;
+        }
+        return view;
+    }
+    void bind_auxiliary_selection(const std::vector<std::uint32_t>& selected) {
+        auto& p=program;const auto begin=static_cast<std::uint32_t>(identity.evaluation.begin);
+        if (!p.backend_kv_pages || auxiliary_plan ||
