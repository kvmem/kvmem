index 0000000000000000000000000000000000000000..da34fa419979da49c82b3f99d07b1bbab85e0f6f
--- /dev/null
+++ b/src/ops/softmax_attention/dense/causal_cache/prompt_page_lse_tile.cu
@@ -0,0 +1,38 @@
+#include "ops/softmax_attention/dense/causal_cache/prompt_page_lse_tile.cuh"
+
+namespace ninfer::ops {
+
+static __global__ void clear_prompt_page_lse(float* values, std::size_t n) {
+    const std::size_t stride = std::size_t(gridDim.x) * blockDim.x;
+    for (std::size_t i = std::size_t(blockIdx.x) * blockDim.x + threadIdx.x; i < n; i += stride)
+        values[i] = -CUDART_INF_F;
+}
+
+bool prepare_prompt_page_lse_tile(const Tensor& q, PagedKVBatchLayerView cache,
+                                        std::uint32_t max_visible, const PromptPageLse& capture,
+                                        PromptPageLseTile& tile, cudaStream_t stream) {
+    const auto& scratch = capture.scratch;
+    const auto& rows = capture.rows;
+    const auto& device_rows = capture.device_rows;
+    if (rows.empty() || rows.size() > std::size_t(q.ne[2]) || scratch.dtype != DType::FP32 ||
+        !scratch.data || !scratch.is_contiguous() || scratch.ne[0] <= 0 ||
+        scratch.ne[0] > cache.block_tables.ne[0] || std::uint64_t(scratch.ne[0]) * 64 < max_visible ||
+        scratch.ne[1] != q.ne[1] || std::size_t(scratch.ne[2]) != rows.size() || scratch.ne[3] != 1 ||
+        !device_rows.data || device_rows.dtype != DType::I32 || !device_rows.is_contiguous() ||
+        device_rows.numel() < rows.size())
+        return false;
+    if (rows.front() < capture.row_offset ||
+        rows.back() - capture.row_offset >= std::uint32_t(q.ne[2]) ||
+        std::adjacent_find(rows.begin(), rows.end(), std::greater_equal<>()) != rows.end())
+        return false;
+    CUDA_CHECK(cudaMemcpyAsync(device_rows.data, rows.data(), rows.size_bytes(),
+                               cudaMemcpyHostToDevice, stream));
+    tile = {static_cast<float*>(scratch.data), static_cast<const std::uint32_t*>(device_rows.data),
+            capture.row_offset, scratch.ne[0], static_cast<int>(rows.size())};
+    // Pages beyond a sampled row's causal frontier have zero probability.
+    const auto blocks = std::min<std::size_t>((scratch.numel() - 1) / 256 + 1, 65535);
+    clear_prompt_page_lse<<<static_cast<unsigned>(blocks), 256, 0, stream>>>(tile.values, scratch.numel());
+    return true;
+}
