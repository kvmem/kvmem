+                const auto lq=local.attention->query_width(),lk=local.attention->key_width();
+                target.layout={"ninfer.layerwise.tensor-rank"+std::to_string(rank)+".q"+
+                    std::to_string(target.query_begin)+".k"+std::to_string(target.key_begin)+".pre-rope-native",1,
+                    {{Query,multiply(lq,2)},{Key,multiply(lk,2)},{Value,multiply(lk,2)},
+                     {Gate,multiply(lq,2)},{Residual,multiply(h,2)},{CachePosition,4},{RopePosition,4},{KeySum,multiply(lk,4)}}};
