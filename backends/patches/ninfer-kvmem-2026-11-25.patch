+// One private stream/event per in-flight request, bounded by max_concurrency.
+// It borrows neither the shared Host staging nor model scratch across a yield.
+class NativeLayerwiseResidentPressure final : public NativeLayerwisePressure {
+public:
+    NativeLayerwiseResidentPressure(ProgramImpl& program,SequenceState& sequence,
+        NativeSourceVersionCharge metadata)
+        : p_(program),sequence_(sequence),metadata_(std::move(metadata)),
+          source_(sequence.window.stamp),epoch_(p_.lane_epochs.at(sequence.lane)),
+          address_(sequence.kv->text),producer_(p_.device),done_(p_.device) {
+        const auto* flag=std::getenv("NINFER_TIME_LAYER_REFRESH");timed_=flag && flag[0]=='1';
+        if (timed_) started_=phase_=LayerRestoreTrace::Clock::now();
+        DeviceBinding binding(p_.device.rank(0).device);
+        CUDA_CHECK(cudaStreamCreateWithFlags(&stream_,cudaStreamNonBlocking));
+    }
+    ~NativeLayerwiseResidentPressure() override {
+        if (stream_) {
+            DeviceBinding binding(p_.device.rank(0).device);
+            // Also covers partial submission/failed event recording in begin().
+            (void)cudaStreamSynchronize(stream_);(void)cudaStreamDestroy(stream_);
+        }
+        if (mutated_ && !published_) {
+            sequence_.window.stamp.valid=false;
+            sequence_.window.layerwise_rewrite_pending=false;
+        }
+        if (timed_)
+            std::fprintf(stderr,"REFRESH_RESIDENT lane=%u frontier=%llu complete=%d archive_ms=%.3f plan_ms=%.3f cow_ms=%.3f submit_ms=%.3f publish_ms=%.3f active_ms=%.3f elapsed_ms=%.3f wait_ms=%.3f batches=%llu pages=%llu bytes=%llu polls=%llu\n",
+                sequence_.lane,(unsigned long long)source_.frontier,published_,archive_ms_,plan_ms_,cow_ms_,submit_ms_,publish_ms_,
+                archive_ms_+plan_ms_+cow_ms_+submit_ms_+publish_ms_,LayerRestoreTrace::elapsed(started_),wait_ms_,
+                (unsigned long long)copies_.batches,(unsigned long long)copies_.pages,
+                (unsigned long long)copies_.bytes,(unsigned long long)polls_);
+    }
+    void begin(const std::vector<kvmem::LayerwisePressureChoice>& choices) {
+        auto& window=sequence_.window;
+        if (window.layerwise_rewrite_pending || !window.layer_views.active() ||
+            choices.size()!=window.layer_views.target.size() || p_.backend_kv_pages)
+            throw std::logic_error("resident Pressure requires an accepted complete target-only boundary");
+        p_.archive_memory_window(sequence_);archive_ms_=lap();
+        const auto catalog=p_.layerwise_catalog(sequence_);
+        WindowMemoryBackend backend(p_,sequence_,sequence_.text_kv_valid);
+        const auto descriptor=backend.descriptor();
+        std::vector<kvmem::LayerWorkingSetSelection> selections;
+        for (const auto& choice:choices) {
+            const auto& source=catalog.snapshot(choice.model_layer);
+            if (choice.candidates!=source.resident ||
+                !std::includes(source.resident.begin(),source.resident.end(),choice.selected.begin(),choice.selected.end()) ||
+                (sequence_.text_kv_valid%64 && (choice.selected.empty() || choice.selected.back()!=sequence_.text_kv_valid/64)))
+                throw std::logic_error("resident Pressure changed its resident source or partial tail");
+            selections.push_back({choice.model_layer,source.stamp,choice.selected,choice.fixed,
+                {p_.kvmem_window_tokens,0,p_.kvmem_window_tokens,p_.memory_retained_budget}});
+        }
+        const auto planned=catalog.plan(selections);
+        auto& pool=p_.text_kv_pages->physical_pool();
+        std::vector<NativeResidentStripe> recipes;
+        maps_=window.layer_views;
+        for (const auto& plan:planned.layers) {
+            recipes.push_back(plan_native_resident_stripe(descriptor,catalog.snapshot(plan.model_layer),plan,pool));
+            // These maps remain private until the event has completed.
+            maps_.restored(plan.model_layer,plan.plan.next);
+        }
+        extent_=static_cast<std::uint32_t>(maps_.validate(sequence_.text_kv_valid));
+        pages_=maps_.target.front().pages;
+        const auto held=sizeof(*this)+maps_.allocated_bytes()-(maps_.feedback?maps_.feedback->allocated_bytes():0)+
+            pages_.capacity()*sizeof(std::uint32_t);
+        if (held>metadata_.bytes()) throw std::length_error("resident Pressure exceeded its admitted metadata");
+        plan_ms_=lap();
+        KVLayerStripeWrite writer(*p_.text_kv_addresses,address_,0,
+            p_.text_kv_addresses->mapped_pages(address_),p_.device,p_.compute_streams);
+        window.layerwise_rewrite_pending=true;mutated_=true;
+        writer.copy_native_pages();writer.commit_unpublished_destination();
+        cow_ms_=lap();
+        // COW publication uploads the table on the producing stream. The copy
+        // stream must wait for that boundary, but never borrows a peer's stream.
+        producer_.record(p_.compute_streams[0]);producer_.wait(stream_);
+        for (const auto& recipe:recipes)
+            submit_native_resident_stripe(recipe,pool,*p_.text_kv_addresses,address_,RankStreams(stream_),timed_?&copies_:nullptr);
+        done_.record(stream_);submitted_=true;submit_ms_=lap();
+    }
+    bool ready() const override {
+        ++polls_;return submitted_ && done_.ready();
+    }
+    void wait() override {
+        const auto start=timed_?LayerRestoreTrace::Clock::now():LayerRestoreTrace::Clock::time_point{};
+        if (!submitted_) throw std::logic_error("resident Pressure has no completion fence");
+        done_.synchronize();if (timed_) wait_ms_+=LayerRestoreTrace::elapsed(start);
+    }
+    void finish() override {
+        if (published_ || !ready() || source_!=sequence_.window.stamp ||
+            epoch_!=p_.lane_epochs.at(sequence_.lane) || !sequence_.kv ||
+            !(address_==sequence_.kv->text) || sequence_.text_kv_valid!=source_.frontier)
+            throw std::logic_error("resident Pressure lost its exact accepted owner before publication");
+        const auto start=timed_?LayerRestoreTrace::Clock::now():LayerRestoreTrace::Clock::time_point{};
+        KVLayerStripeWrite::require_unpublished_destination(*p_.text_kv_addresses,address_,
+            p_.text_kv_pages->physical_pool(),static_cast<std::uint32_t>(pages_.size()));
+        p_.text_kv_addresses->commit_frontier(address_,extent_);
+        p_.text_kv_addresses->destructive_truncate(address_,extent_);
+        auto& window=sequence_.window;
+        window.layer_views=std::move(maps_);window.pages=std::move(pages_);
+        window.removed_tokens=sequence_.text_kv_valid-extent_;
+        ++window.stamp.view_version;++window.swaps;
+        window.layerwise_rewrite_pending=false;
+        p_.bind_sequence_kv(sequence_);published_=true;
+        if (timed_) publish_ms_=LayerRestoreTrace::elapsed(start);
+    }
+private:
+    double lap() {
+        if (!timed_) return 0;
+        const auto elapsed=LayerRestoreTrace::elapsed(phase_);phase_=LayerRestoreTrace::Clock::now();return elapsed;
+    }
+    ProgramImpl& p_;SequenceState& sequence_;
+    NativeSourceVersionCharge metadata_;
+    kvmem::MemoryStamp source_;
+    std::uint64_t epoch_;
+    KVAddressSpaceHandle address_;
+    CudaCompletionEvent producer_,done_;
+    cudaStream_t stream_=nullptr;
+    KvmemLayerViews maps_;
+    std::vector<std::uint32_t> pages_;
+    std::uint32_t extent_=0;
+    bool timed_=false,mutated_=false,submitted_=false,published_=false;
+    mutable std::uint64_t polls_=0;
+    LayerRestoreTrace copies_;
+    LayerRestoreTrace::Clock::time_point started_,phase_;
+    double archive_ms_=0,plan_ms_=0,cow_ms_=0,submit_ms_=0,publish_ms_=0,wait_ms_=0;
+};
+
+std::unique_ptr<NativeLayerwisePressure> ProgramImpl::start_layerwise_pressure(SequenceState& sequence,
+    const std::vector<kvmem::LayerwisePressureChoice>& choices,NativeSourceVersionCharge& metadata) {
+    const auto* flag=std::getenv("NINFER_RESIDENT_LAYER_PRESSURE");
+    // MTP has an independently selected auxiliary map which may require cold
+    // recall. TP residue layouts and diagnostic readback keep the proven path.
+    if ((flag && std::strcmp(flag,"0")==0) || device.size()!=1 || backend_kv_pages || kvmem_options.verify_transfers)
+        return {};
+    const auto& maps=sequence.window.layer_views;
+    const auto bytes=sizeof(NativeLayerwiseResidentPressure)+maps.allocated_bytes()-
+        (maps.feedback?maps.feedback->allocated_bytes():0)+
+        (kvmem_window_tokens/64+1)*sizeof(std::uint32_t);
+    auto work=std::make_unique<NativeLayerwiseResidentPressure>(*this,sequence,metadata.split(bytes));
+    work->begin(choices);return work;
+}
+
+void ProgramImpl::compact_layerwise_pressure(SequenceState& sequence,const std::vector<kvmem::LayerwisePressureChoice>& choices) {
+    LayerwiseRefreshProfile profile(sequence.lane,sequence.text_kv_valid);
+    auto& window=sequence.window;
+    if (window.layerwise_rewrite_pending || !window.layer_views.active() ||
+        choices.size()!=window.layer_views.target.size() ||
+        (backend_kv_pages && speculative_backend!=SpeculativeBackend::Mtp))
+        throw std::logic_error("native layerwise Pressure requires an accepted complete native boundary");
+    // Full canonical records are sealed before mixed-stripe destinations exist.
+    // Previously mixed historical pages must already have their sealed source;
+    // archive_memory_window refuses manufacturing one from unlike layer IDs.
+    archive_memory_window(sequence);
+    profile.archive_ms=profile.lap();
+    const auto catalog=layerwise_catalog(sequence);
+    WindowMemoryBackend backend(*this,sequence,sequence.text_kv_valid);
+    NativeFrozenLayerArchive archive{backend.descriptor(),backend.snapshot(),{}};
+    for (std::size_t id=0;id<archive.canonical.blocks.size();++id) {
+        const auto& b=archive.canonical.blocks[id];
+        if (!window.archive[id] || b.host_version!=b.block.content_version)
+            throw std::logic_error("native Pressure source is not complete canonical history");
+        // Import Pressure may start at a partial accepted tail. Its complete
+        // native page image is immutable during stripe restoration; future
+        // accepted appends detach through HostKvRecord's existing COW owner.
+        window.archive[id].seal();archive.records.push_back(window.archive[id].source());
+    }
+    std::vector<kvmem::LayerWorkingSetSelection> selections;
+    for (const auto& choice:choices) {
+        const auto& source=catalog.snapshot(choice.model_layer);
+        if (choice.candidates!=source.resident || !std::includes(source.resident.begin(),source.resident.end(),choice.selected.begin(),choice.selected.end()))
+            throw std::logic_error("native Pressure attempted cold-history recall");
+        if (sequence.text_kv_valid%64 && (choice.selected.empty() || choice.selected.back()!=sequence.text_kv_valid/64))
+            throw std::logic_error("native import Pressure must preserve its exact accepted partial tail");
+        selections.push_back({choice.model_layer,source.stamp,choice.selected,choice.fixed,
+            {kvmem_window_tokens,0,kvmem_window_tokens,memory_retained_budget}});
+    }
+    const auto planned=catalog.plan(selections);auto maps=window.layer_views;
+    std::unique_ptr<kvmem::LayerWorkingSetPlan> auxiliary;
+    auto aux=archive.canonical;
+    if (backend_kv_pages) {
+        if (!sequence.kv->backend || !maps.has_auxiliary)
+            throw std::logic_error("native MTP Pressure lost its independently owned historical map");
+        aux.resident.assign(maps.auxiliary_pages.begin(),maps.auxiliary_pages.end());
+        aux.stamp.view_version=maps.auxiliary_view_version;
+        const auto model=static_cast<std::uint32_t>(parameters.model.config().text.layer_types.size());
+        const kvmem::LayerwiseMemoryCatalog aux_catalog(archive.descriptor,{{model,aux}});
+        // Pinned Pressure follows target chosen[0] original IDs. These are
+        // resident-only TARGET choices; draft restores its own archived bytes,
+        // which need not already be in its independently selected old map.
+        auxiliary=std::make_unique<kvmem::LayerWorkingSetPlan>(aux_catalog.plan_layer(
+            {model,aux.stamp,choices.front().selected,{},
+             {kvmem_window_tokens,0,kvmem_window_tokens,memory_retained_budget}}));
+    }
+    const auto bytes=std::max(backend.layout.page_stride,backend.mtp_layout?backend.mtp_layout->page_stride:0);
+    const auto limit=window.layerwise_request?window.layerwise_request->options().query.transfer_staging_host_bytes:transfer_staging_limit;
+    if (bytes>limit) throw std::length_error("native Pressure layer staging exceeds its explicit pinned resources");
+    if (!memory_kv_staging || memory_kv_staging->size()<bytes || memory_kv_staging->size()>limit) {
+        memory_kv_staging.reset();memory_kv_staging=std::make_unique<PinnedHostBuffer>(bytes);
+    }
+    profile.plan_ms=profile.lap();
+    KVLayerStripeWrite writer(*text_kv_addresses,sequence.kv->text,0,text_kv_addresses->mapped_pages(sequence.kv->text),device,compute_streams);
+    std::unique_ptr<KVLayerStripeWrite> auxiliary_writer;
+    if (auxiliary) auxiliary_writer=std::make_unique<KVLayerStripeWrite>(*backend_kv_addresses,*sequence.kv->backend,
+        0,backend_kv_addresses->mapped_pages(*sequence.kv->backend),device,compute_streams);
+    window.layerwise_rewrite_pending=true;
+    try {
+        writer.copy_native_pages();if (auxiliary_writer) auxiliary_writer->copy_native_pages();
+        writer.commit_unpublished_destination();if (auxiliary_writer) auxiliary_writer->commit_unpublished_destination();
+        profile.cow_ms=profile.lap();
+        for (const auto& plan:planned.layers) {
+            const auto view=restore_native_layer_stripe(archive,catalog.snapshot(plan.model_layer),plan,text_kv_pages->physical_pool(),
+                *text_kv_addresses,sequence.kv->text,device,compute_streams,*memory_kv_staging,0,kvmem_options.verify_transfers);
+            maps.restored(plan.model_layer,view);
+        }
+        if (auxiliary) {
+            const auto view=restore_native_layer_stripe(archive,aux,*auxiliary,backend_kv_pages->physical_pool(),
+                *backend_kv_addresses,*sequence.kv->backend,device,compute_streams,*memory_kv_staging,
+                backend.layout.page_stride,kvmem_options.verify_transfers);
+            maps.auxiliary_pages.clear();
+            for (const auto& item:view.blocks) maps.auxiliary_pages.push_back(static_cast<std::uint32_t>(item.block.id));
+            maps.auxiliary_view_version=view.stamp.view_version;
+            maps.auxiliary_removed_tokens=sequence.text_kv_valid-static_cast<std::uint32_t>(view.visible_tokens);
+        }
+        profile.restore_ms=profile.lap();
+        device.synchronize();const auto extent=static_cast<std::uint32_t>(maps.validate(sequence.text_kv_valid));
+        text_kv_addresses->commit_frontier(sequence.kv->text,extent);text_kv_addresses->destructive_truncate(sequence.kv->text,extent);
+        if (auxiliary) {
+            const auto auxiliary_extent=sequence.text_kv_valid-maps.auxiliary_removed_tokens;
+            backend_kv_addresses->commit_frontier(*sequence.kv->backend,auxiliary_extent);
+            backend_kv_addresses->destructive_truncate(*sequence.kv->backend,auxiliary_extent);
+        }
+        window.layer_views=std::move(maps);window.pages=window.layer_views.target.front().pages;
+        window.removed_tokens=sequence.text_kv_valid-extent;++window.stamp.view_version;++window.swaps;window.layerwise_rewrite_pending=false;
+        bind_sequence_kv(sequence);
+        profile.publish_ms=profile.lap();profile.complete=true;
+    } catch (...) {try {device.synchronize();} catch (...) {}window.stamp.valid=false;throw;}
+}
