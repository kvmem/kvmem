+#include "kvmem/cli_options.h"
+
+#include <filesystem>
+
+namespace ninfer::product {
+
+// The shared parser validates finite worker-independent resource values. Resolve
+// NInfer's model-dependent auto setting separately after parsing all arguments.
+struct NativeRetentionOptions {
+    std::uint64_t metadata_bytes = 0;
+    std::uint32_t target = kDefaultLayerwiseCheckpointTarget;
+    bool query_anchor = false;
+    std::uint32_t score_tokens = 64;
+    bool half_max = false;
+
+    template<class Need>
+    bool parse(const std::string& arg, const Need& need, kvmem::CliOptions& memory) {
+        if (arg == "--kvmem-layerwise-unique-query-anchor") {
+            query_anchor = true;
+        } else if (arg == "--kvmem-layerwise-checkpoint-target") {
+            target = memory.integer(arg, need(arg.c_str()), 1);
+            if (target > kMaxLayerwiseCheckpointTarget)
+                throw std::invalid_argument("checkpoint target exceeds 256");
+        } else if (arg == "--kvmem-layerwise-half-reduce") {
+            const std::string value(need(arg.c_str()));
+            if (value != "sum" && value != "max")
+                throw std::invalid_argument("--kvmem-layerwise-half-reduce must be sum or max");
+            half_max = value == "max";
+        } else if (arg == "--kvmem-layerwise-score-tokens") {
+            score_tokens = memory.integer(arg, need(arg.c_str()), 1);
+            if (score_tokens != 32 && score_tokens != 64)
+                throw std::invalid_argument("native layerwise score tokens must be 32 or 64");
+        } else if (arg == "--kvmem-layerwise-metadata-mib") {
+            const std::string value(need(arg.c_str()));
+            metadata_bytes = value == "auto" ? 0 : std::uint64_t(memory.integer(arg, value.c_str(), 1)) << 20;
+        } else return false;
+        memory.layerwise_limits_set = memory.auxiliary_set = true;
+        return true;
+    }
+};
+
+// Product adapters share the public spelling and defaults, then let the
+// native Engine validate its actual page, execution and resource geometry.
+inline void apply_kvmem_cli_options(const kvmem::CliOptions& source,KvmemOptions& target) {
+    target.selected_tokens=source.budget;
+    target.reserve_tokens=source.gen_reserve;
+    target.host_bytes=source.payload_host_bytes;
+    target.disk_bytes=source.payload_disk_bytes;
+    target.disk_path=std::filesystem::u8path(source.payload_disk_dir);
+    target.sink_tokens=source.sink_tokens;
+    target.recent_tokens=source.recent_tokens;
+    target.retained_sessions=source.sessions;
+    target.cache_min_tokens=source.cache_min_tokens;
+    target.lrfu=source.lrfu;
+    target.lrfu_lambda=source.lrfu_lambda;
+    target.lrfu_top_fraction=source.lrfu_top_fraction;
+    target.score_agg_max=source.score_agg==1;
+    target.query_meanq_cosine=source.query_scorer==kvmem::QueryScorer::MeanQCosine;
+    target.graph_alpha=source.graph_alpha;
+    target.recall_strategy=source.recall_strategy;
+    target.layerwise=source.layerwise;
+    target.layerwise_mtp_history=source.layerwise_mtp_history;
+    if (source.sink_tokens_set) target.layerwise_sink_tokens=source.sink_tokens;
+    if (source.recent_tokens_set) target.layerwise_recent_tokens=source.recent_tokens;
+}
+
+} // namespace ninfer::product
