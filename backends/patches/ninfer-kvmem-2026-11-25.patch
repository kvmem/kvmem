+// Native physical text-unit geometry, independent of session/encode state.
+// An item may span units; the next item may cap this one at an unaligned row.
+inline std::uint32_t planned_vision_chunk_length(const VisionPrefillPlan& plan,
+    std::uint32_t prompt_tokens,std::uint32_t begin,std::uint32_t nominal) {
+    if (!nominal || begin>=prompt_tokens)
+        throw std::invalid_argument("Vision chunk range is empty or outside the prompt");
+    auto end=static_cast<std::uint32_t>(std::min<std::uint64_t>(std::uint64_t(begin)+nominal,prompt_tokens));
+    const auto use=std::lower_bound(plan.uses.begin(),plan.uses.end(),begin,
+        [](const VisionUseSpan& item,std::uint32_t value){return item.end<=value;});
+    if (use!=plan.uses.end() && use->begin<end && use+1!=plan.uses.end()) end=std::min(end,(use+1)->begin);
+    if (end<=begin) throw std::logic_error("Vision chunk cap made no forward progress");
+    return end-begin;
+}
 } // namespace ninfer::models::qwen3_5::detail
