index 0000000000000000000000000000000000000000..64ab2f4deff5f7f208c4c386fe7b33bb5fdab9bd
--- /dev/null
+++ b/src/models/qwen3_5/program/storage/memory_statistics.cpp
@@ -0,0 +1,468 @@
+#include "models/qwen3_5/program/program_impl.h"
+#include "models/qwen3_5/program/planning/memory_statistics_copy_plan.h"
+#include "models/qwen3_5/program/planning/attention_feedback_readback.h"
+#include "models/qwen3_5/program/storage/attention_feedback_mass.h"
+#ifdef NINFER_KVMEM_QUERY_TEST_HOOKS
+#include "models/qwen3_5/program/query_test_support.h"
+#endif
+#include <bit>
+#include <cmath>
+#include <cstdio>
+#include <cstring>
+#include "ninfer/ops/attention_page_mass.h"
+#include "core/nvtx.h"
+
+namespace ninfer::models::qwen3_5::detail {
+namespace {
+// Keep post-processing phases visible without changing shared CUDA headers.
+class StatisticsRange {
+public:
+    explicit StatisticsRange(const char* name) noexcept { nvtxRangePushA(name); }
+    ~StatisticsRange() noexcept { nvtxRangePop(); }
+    StatisticsRange(const StatisticsRange&)=delete;
+    StatisticsRange& operator=(const StatisticsRange&)=delete;
+};
+#ifdef NINFER_KVMEM_QUERY_TEST_HOOKS
+std::uint64_t query_test_fingerprint(const KvmemWindowState& state, bool mean) {
+    std::uint64_t hash=14695981039346656037ULL;
+    if (mean) {
+        for (auto value:state.query_sums) query_test_hash(hash,value);
+    } else {
+        for (const auto& layer:state.query_rows)
+            for (auto value:layer) query_test_hash(hash,value);
+    }
+    return hash;
+}
+#endif
+void read_statistics(DeviceContext& device, const execution::MemoryStatistics& statistics,
+                     void* destination, bool include_query, std::uint32_t query_count=0) {
+    const StatisticsRange range("kvmem.statistics.readback");
+    auto* host = static_cast<std::byte*>(destination);
+    for_each_coalesced_statistics_copy(statistics, include_query, query_count,
+        [&](const execution::MemoryStatisticsCopy& copy) {
+            DeviceBinding binding(device.rank(copy.rank).device);
+            CUDA_CHECK(cudaMemcpy2DAsync(host + copy.destination_offset, copy.destination_pitch,
+                copy.source, copy.width_bytes, copy.width_bytes, copy.rows,
+                cudaMemcpyDeviceToHost, device.stream_for_rank(copy.rank)));
+        });
+    device.synchronize();
+}
+
+} // namespace
+
+void ProgramImpl::prepare_memory_statistics(SequenceState& sequence, std::uint32_t query_begin,
+                                            std::uint32_t query_end, std::uint32_t prompt_tokens) {
+    if (!memory_statistics) { return; }
+    auto& state = sequence.window;
+    if (!state.statistics) {
+        state.graph.set_budget(std::make_shared<kvmem::GraphStatisticsBudget>(32u<<20,memory_graph_budget));
+        const auto& config = parameters.model.config().text;
+        state.statistics = std::make_unique<kvmem::RawKvStore>(kvmem::RawKvStoreConfig{
+            .n_layer = config.full_attention_layers,
+            .n_embd_k = memory_statistics->key_width,
+            .block_tokens = kvmem_options.mean_key_block_tokens()});
+        kvmem::KvMemStoreConfig selection;
+        selection.lrfu = kvmem_options.lrfu;
+        selection.lrfu_lambda = kvmem_options.lrfu_lambda;
+        selection.lrfu_top_fraction = kvmem_options.lrfu_top_fraction;
+        selection.block_tokens = 64;
+        selection.select_budget = kvmem_options.selected_tokens;
+        selection.sink_blocks = kvmem_options.sink_blocks();
+        selection.recent_blocks = kvmem_options.recent_blocks();
+        if (kvmem_options.recall_strategy==kvmem::RecallStrategy::Layerwise) {
+            // This object supplies original-coordinate block identities only.
+            // Its legacy retention defaults/history never constrain or score
+            // the independent per-layer Request/Pressure policy.
+            selection.lrfu=false;
+            selection.sink_blocks=layerwise_keep_bands.sink_blocks;
+            selection.recent_blocks=layerwise_keep_bands.recent_blocks;
+        }
+        state.selector = std::make_unique<kvmem::KvMemStore>(selection);
+        state.selector->begin_retrieval_round();
+        state.query_rows.resize(memory_statistics->layers);
+        state.query_begin = query_begin;
+        state.query_end = query_end;
+    }
+    if (state.query_begin != query_begin || state.query_end != query_end) {
+        throw std::logic_error("KVMem query range changed inside one prefill");
+    }
+    // Tools never use old Q. A proved resident view or refused replay has no
+    // Query consumer either: avoid per-token/head D2H, validation and copies.
+    // Mean-K and the separate native attention-feedback capture stay enabled.
+    state.query_capture=memory_query_probe(sequence,prompt_tokens);
+    if (memory_statistics->mean_query && state.query_capture && !state.query_replayed) {
+        const auto elements=std::size_t(memory_statistics->layers)*memory_statistics->query_width;
+        if (state.query_sums.empty()) state.query_sums.assign(elements,0.0F);
+        if (state.query_sums.size()!=elements)
+            throw std::logic_error("KVMem Mean-Q layer coverage mismatch");
+    }
+    memory_statistics_ranges = {0, static_cast<std::int32_t>(capacity),
+        state.query_capture ? static_cast<std::int32_t>(query_begin) : 0,
+        state.query_capture ? static_cast<std::int32_t>(query_end) : 0};
+    for (std::size_t rank = 0; rank < memory_statistics->ranks.size(); ++rank) {
+        const auto& shard = memory_statistics->ranks[rank];
+        if (shard.ranges.data == nullptr) { continue; }
+        DeviceBinding binding(device.rank(rank).device);
+        CUDA_CHECK(cudaMemcpyAsync(shard.ranges.data, memory_statistics_ranges.data(),
+            sizeof(memory_statistics_ranges), cudaMemcpyHostToDevice, device.stream_for_rank(rank)));
+        if (memory_statistics->mean_query && state.query_capture && !state.query_replayed) {
+            // A Program buffer can have been used by another sequence, an aborted
+            // forward, or graph preparation. Seed it from this accepted prefix
+            // before every step; the kernel never owns conversation state.
+            for (std::int32_t layer=0; layer<shard.query_values.ne[2]; ++layer) {
+                auto query=shard.query_values.slice(2,layer,1);
+                CUDA_CHECK(cudaMemcpyAsync(query.data,
+                    state.query_sums.data()+std::size_t(shard.first_layer+layer)*memory_statistics->query_width+
+                        shard.query_offset,
+                    query.bytes(),cudaMemcpyHostToDevice,device.stream_for_rank(rank)));
+            }
+        }
+    }
+}
+
+void ProgramImpl::commit_memory_statistics(SequenceState& sequence, std::uint32_t begin,
+                                           std::uint32_t end) {
+    if (!memory_statistics) { return; }
+    const StatisticsRange range("kvmem.statistics.commit");
+    auto& state = sequence.window;
+    if (!state.statistics || begin != state.statistics_frontier || end <= begin ||
+        end - begin > prefill_chunk) {
+        throw std::logic_error("KVMem statistics require exactly one append at the evaluated frontier");
+    }
+    const auto& buffers = *memory_statistics;
+    auto* host = static_cast<std::byte*>(memory_statistics_host->data());
+    const auto query_first = std::max(begin, state.query_begin);
+    const auto query_last = std::min(end, state.query_end);
+    const bool read_query=state.query_capture && !state.query_replayed && query_last>query_first;
+    read_statistics(device,buffers,host,read_query,read_query?query_last-query_first:0);
+    const auto width = buffers.key_width;
+    const auto mean_block = state.statistics->config().block_tokens;
+    const auto layer_stride = static_cast<std::size_t>(width) * buffers.columns;
+    const auto* keys = reinterpret_cast<const float*>(host);
+    for (std::uint32_t layer = 0; layer < state.statistics->config().n_layer; ++layer) {
+        for (auto at = begin; at < end;) {
+            const auto count = std::min(end - at, mean_block - at % mean_block);
+            const auto bucket = at / mean_block - begin / mean_block;
+            const auto* sum = keys + layer * layer_stride + bucket * width;
+            for (std::uint32_t channel = 0; channel < width; ++channel) {
+                if (!std::isfinite(sum[channel])) { throw std::runtime_error("Nonfinite KVMem key sum"); }
+            }
+            state.statistics->write_layer_mean_sum(at, count, layer, sum);
+            at += count;
+        }
+    }
+    if (read_query) {
+        if (buffers.mean_query) {
+            const auto* sums=reinterpret_cast<const float*>(host+buffers.key_bytes());
+            const auto elements=std::size_t(buffers.layers)*buffers.query_width;
+            for (std::size_t i=0;i<elements;++i) {
+                if (!std::isfinite(sums[i])) throw std::runtime_error("Nonfinite KVMem Mean-Q sum");
+            }
+            state.query_sums.assign(sums,sums+elements);
+        } else {
+            const auto* query=reinterpret_cast<const std::uint16_t*>(host+buffers.key_bytes());
+            for (std::uint32_t layer=0;layer<buffers.layers;++layer) {
+                const auto* first=query+std::size_t(layer)*buffers.query_columns*buffers.query_width;
+                const auto elements=std::size_t(query_last-query_first)*buffers.query_width;
+                auto& rows=state.query_rows[layer];
+                const auto at=rows.size();
+                rows.resize(at+elements);
+                for(std::size_t i=0;i<elements;++i) {
+                    const float value=std::bit_cast<float>(std::uint32_t(first[i])<<16);
+                    if(!std::isfinite(value)) throw std::runtime_error("Nonfinite KVMem Query row");
+                    rows[at+i]=value;
+                }
+            }
+        }
+        state.query_tokens += query_last - query_first;
+#ifdef NINFER_KVMEM_QUERY_TEST_HOOKS
+        std::fprintf(stderr,"KVMEM_QUERY_TEST phase=accepted lane=%u begin=%u end=%u query_begin=%u query_end=%u rows=%u hash=%016llx\n",
+            sequence.lane,begin,end,state.query_begin,state.query_end,state.query_tokens,
+            static_cast<unsigned long long>(query_test_fingerprint(state,buffers.mean_query)));
+#endif
+    }
+    if (state.selector->total_tokens() != begin) {
+        throw std::logic_error("KVMem block catalog lost its statistics frontier");
+    }
+    state.selector->register_append(end - begin);
+    observe_memory_attention(sequence,begin,end,0,end-begin,true);
+    state.statistics_frontier = end;
+    if (kvmem_options.verify_transfers && (end == state.query_end || end % 64 == 0)) {
+        std::fprintf(stderr, "KVMEM_STATISTICS frontier=%u query_tokens=%u query_begin=%u query_end=%u layers=%u mean_bytes=%zu\n",
+            end, state.query_tokens, state.query_begin, state.query_end,
+            state.statistics->config().n_layer, state.statistics->allocated_bytes());
+    }
+}
+
+void ProgramImpl::score_memory_query(SequenceState& sequence,
+                                    const std::vector<std::uint32_t>& mandatory, const KvmemPrefixCheckpoint* prefix) {
+    auto& state=sequence.window;
+    if (state.layerwise_request) return; // all target layers publish through their native accepted owner
+    if(!state.query_tokens || !state.statistics || !state.selector)
+        throw std::logic_error("KVMem Query scoring has no accepted index");
+    const auto& config=parameters.model.config().text;
+    std::vector<const float*> layers(config.full_attention_layers);
+    std::vector<std::uint32_t> counts(config.full_attention_layers,state.query_tokens);
+    const auto width=config.attention->query_width();
+    if (kvmem_options.query_meanq_cosine) {
+        if (state.query_sums.size()!=layers.size()*width)
+            throw std::logic_error("KVMem Mean-Q layer coverage mismatch");
+    } else {
+        if(state.query_rows.size()!=layers.size()) throw std::logic_error("KVMem Query layer coverage mismatch");
+        for(std::size_t layer=0;layer<layers.size();++layer) {
+            if(state.query_rows[layer].size()!=std::size_t(state.query_tokens)*width)
+                throw std::logic_error("KVMem Query token coverage mismatch");
+            layers[layer]=state.query_rows[layer].data();
+        }
+    }
+    const auto& policy=*state.selector;
+    const auto& options=policy.config();
+    const auto frontier=prefix ? uint32_t(prefix->prefix.size()) : state.statistics_frontier;
+    const auto frame=kvmem::query_score_frame(frontier,64,policy.budget_blocks(),
+        options.sink_blocks,options.recent_blocks,mandatory);
+    if(!kvmem_options.query_meanq_cosine && !memory_query_scorer)
+        throw std::logic_error("KVMem Query scorer lost its startup workspace");
+    const auto previous=prefix ? state.statistics->mean_checkpoint(frontier) : std::vector<float>{};
+    if(prefix) state.statistics->restore_mean_checkpoint(frontier,prefix->mean_tail);
+    std::vector<double> scores;
+    try {
+        const auto aggregation=kvmem_options.score_agg_max ? kvmem::GqaScoreAggregation::Max : kvmem::GqaScoreAggregation::Mean;
+        if (kvmem_options.query_meanq_cosine) {
+            scores=kvmem::mean_key_retrieval_scores(*state.statistics,uint32_t(frame.starts.size()),
+                {state.query_sums.data(),counts.data(),config.full_attention_layers,
+                 config.attention->head_dim,config.attention->num_attention_heads,
+                 config.attention->num_key_value_heads,aggregation});
+        } else {
+            const kvmem::PageQueryView query{nullptr,counts.data(),
+                config.full_attention_layers,state.query_tokens,config.attention->num_attention_heads,
+                config.attention->num_key_value_heads,config.attention->head_dim,layers.data()};
+            scores=memory_query_scorer->score(*state.statistics,query,frame,aggregation);
+        }
+        if (kvmem_options.graph_alpha > 0)
+            scores=kvmem::propagate_query_scores(scores,frame,prefix ? prefix->graph : state.graph,kvmem_options.graph_alpha);
+    } catch (...) {
+        if(prefix) state.statistics->restore_mean_checkpoint(frontier,previous);
+        throw;
+    }
+    if(prefix) state.statistics->restore_mean_checkpoint(frontier,previous);
+    state.selector->set_retrieval_scores(scores);
+#ifdef NINFER_KVMEM_QUERY_TEST_HOOKS
+    std::uint64_t score_hash=14695981039346656037ULL;
+    for (double value:scores) {
+        const auto bits=std::bit_cast<std::uint64_t>(value);
+        for (unsigned shift=0;shift<64;shift+=8) {
+            score_hash^=(bits>>shift)&255U; score_hash*=1099511628211ULL;
+        }
+    }
+    std::fprintf(stderr,"KVMEM_QUERY_TEST phase=scored lane=%u rows=%u hash=%016llx scores=%016llx\n",
+        sequence.lane,state.query_tokens,
+        static_cast<unsigned long long>(query_test_fingerprint(state,kvmem_options.query_meanq_cosine)),
+        static_cast<unsigned long long>(score_hash));
+#endif
+    if(kvmem_options.verify_transfers) std::fprintf(stderr,"KVMEM_QUERY scorer=%s agg=%s lrfu=%d graph_alpha=%.6g rows=%u blocks=%zu\n",
+        kvmem_options.query_meanq_cosine ? "meanq-cosine" : "page-softmax",
+        kvmem_options.score_agg_max ? "max" : "mean",int(kvmem_options.lrfu),kvmem_options.graph_alpha,
+        state.query_tokens,scores.size());
+}
+void ProgramImpl::read_memory_candidates() {
+    if (!memory_candidate_statistics) return;
+    read_statistics(device, *memory_candidate_statistics, memory_candidate_host->data(), false);
+}
+
+void ProgramImpl::commit_memory_candidates(SequenceState& sequence, std::uint32_t begin,
+                                            std::uint32_t end, std::uint32_t first_column,
+                                            std::uint32_t row_width) {
+    if (!memory_candidate_statistics) { return; }
+    auto& state = sequence.window;
+    const auto& keys = *memory_candidate_statistics;
+    if (!state.statistics || !state.selector || begin != state.statistics_frontier ||
+        state.selector->total_tokens() != begin || end <= begin ||
+        end - begin > row_width || first_column + row_width > keys.columns) {
+        throw std::logic_error("KVMem speculative statistics have an invalid committed prefix");
+    }
+    const auto width = static_cast<std::size_t>(keys.key_width);
+    const auto stride = width * keys.columns;
+    const auto* values = static_cast<const float*>(memory_candidate_host->data());
+    // Each represented BF16 key was copied into its own FP32 column by
+    // token_sums(block_tokens=1). Rejected and output-truncated columns never
+    // enter the persistent mean-K store, including a partial logical page.
+    for (std::uint32_t layer = 0; layer < state.statistics->config().n_layer; ++layer) {
+        for (auto position = begin; position < end; ++position) {
+            const auto* value = values + layer * stride + (first_column + position - begin) * width;
+            for (std::size_t channel = 0; channel < width; ++channel) {
+                if (!std::isfinite(value[channel])) {
+                    throw std::runtime_error("Nonfinite committed KVMem candidate key");
+                }
+            }
+            state.statistics->write_layer_mean_sum(position, 1, layer, value);
+        }
+    }
+    state.selector->register_append(end - begin);
+    observe_memory_attention(sequence,begin,end,first_column,row_width,false);
+    state.statistics_frontier = end;
+#ifdef NINFER_KVMEM_QUERY_TEST_HOOKS
+    std::fprintf(stderr,"KVMEM_QUERY_TEST phase=decode lane=%u begin=%u end=%u\n",sequence.lane,begin,end);
+#endif
+}
+
+void ProgramImpl::observe_memory_attention(SequenceState& sequence,std::uint32_t begin,std::uint32_t end,
+    std::uint32_t first_column,std::uint32_t row_width,bool prefill) {
+    const StatisticsRange range("kvmem.attention.feedback");
+    auto& state=sequence.window;
+    if (state.layerwise_request) return;
+    if(!memory_statistics || end<=begin || end<=state.graph.accepted_through) return;
+    const auto& config=parameters.model.config().text;
+    const auto accepted=end-begin;
+    auto next_scope=state.attention_scope;
+    std::vector<std::uint32_t> rows;
+    const auto output_first=state.output_begin && state.output_begin>begin ?
+        std::min(accepted,state.output_begin-begin) : 0u;
+    const bool output=state.output_begin && output_first<accepted;
+    if(output) {
+        std::vector<std::int32_t> tokens(accepted);
+        const auto& captured=memory_statistics->ranks.front().attention_tokens;
+        DeviceBinding binding(device.rank(0).device);
+        CUDA_CHECK(cudaMemcpyAsync(tokens.data(),static_cast<const std::int32_t*>(captured.data)+first_column,
+            tokens.size()*sizeof(tokens[0]),cudaMemcpyDeviceToHost,device.stream_for_rank(0)));
+        CUDA_CHECK(cudaStreamSynchronize(device.stream_for_rank(0)));
+        auto plan=kvmem::accepted_output_samples(next_scope,tokens.data()+output_first,accepted-output_first,
+            state.think_open,state.think_close);
+        rows=std::move(plan.rows); next_scope=plan.state;
+        for(auto& row:rows) row+=output_first;
+    } else if(prefill && !state.query_replay_active) {
+        // query_replayed also marks an already evaluated user Query on restore.
+        // Its new assistant prefix still needs feedback; suppress only actual replay.
+        rows=kvmem::prefill_sample_rows(begin,accepted,state.feedback.snapshot().prefill_end,
+            compact_position(sequence,begin),kvmem_window_tokens);
+    }
+    rows.erase(std::remove_if(rows.begin(),rows.end(),[&](auto row) {
+        return begin+row<state.graph.accepted_through;
+    }),rows.end());
+    std::vector<kvmem::AcceptedAttentionRow> observations(rows.size());
+    auto logical_pages=state.pages;
+    for(auto id=begin/64;id<(end+63)/64;++id)
+        if(std::find(logical_pages.begin(),logical_pages.end(),id)==logical_pages.end()) logical_pages.push_back(id);
+    const auto selected_count=std::min<std::uint32_t>(3,config.full_attention_layers);
+    for(std::size_t i=0;i<rows.size();++i) observations[i].source_position=begin+rows[i];
+    for(std::size_t first=0;first<rows.size();first+=64) {
+        const StatisticsRange mass_range("kvmem.attention.mass-and-readback");
+        const auto count=std::min<std::size_t>(64,rows.size()-first);
+        AttentionPageMassAccumulator page_mass(
+            std::span<kvmem::AcceptedAttentionRow>(observations).subspan(first,count),logical_pages,
+            selected_count,config.attention->num_attention_heads);
+        std::vector<std::int32_t> columns(count),positions(count);
+        for(std::size_t i=0;i<count;++i) {
+            columns[i]=static_cast<std::int32_t>(first_column+rows[first+i]);
+            positions[i]=static_cast<std::int32_t>(compact_position(sequence,begin+rows[first+i]));
+        }
+        const auto readback=attention_feedback_readback(*memory_statistics,
+            config.attention->head_dim,static_cast<std::uint32_t>(count));
+        if(!memory_statistics_host || readback.bytes>memory_statistics_host->size())
+            throw std::logic_error("KVMem attention readback exceeds its planned host storage");
+        // Main Mean-K/Query data has already been consumed into owned sequence
+        // stores. Candidate data uses a different buffer, which other lanes can
+        // still need. No pending transfer may outlive the reused pinned storage.
+        auto* host=static_cast<std::byte*>(memory_statistics_host->data());
+        std::vector<bool> submitted(memory_statistics->ranks.size(),false);
+        const auto product=[&](const AttentionFeedbackCopy& copy) {
+            auto& shard=memory_statistics->ranks[copy.rank];
+            const auto stream=device.stream_for_rank(copy.rank);
+            auto row_tensor=shard.attention_rows.slice(0,0,static_cast<std::int32_t>(count));
+            auto position_tensor=shard.attention_positions.slice(0,0,static_cast<std::int32_t>(count));
+            const auto capacity=shard.attention_queries.ne[1];
+            auto query=shard.attention_queries.slice(2,copy.slot,1).view({
+                static_cast<std::int32_t>(config.attention->head_dim),
+                static_cast<std::int32_t>(copy.local_heads),capacity});
+            auto scratch=shard.attention_scratch.slice(2,0,static_cast<std::int32_t>(count));
+            auto norms=shard.attention_norms.slice(2,0,static_cast<std::int32_t>(count));
+            auto mass=shard.attention_output.slice(1,0,static_cast<std::int32_t>(count));
+            auto cache=decoder->text_kv.batch_layer_view(static_cast<std::size_t>(copy.layer),
+                parameters.text.tensor_parallel() ? copy.rank : 0);
+            const auto table_row=text_kv_addresses->bound_row(sequence.kv->text);
+            ops::attention_page_mass(query,row_tensor,position_tensor,table_row,cache,scratch,norms,mass,stream);
+            return mass;
+        };
+        try {
+            for(const auto& copy:readback.copies) {
+                auto& shard=memory_statistics->ranks[copy.rank];
+                DeviceBinding binding(device.rank(copy.rank).device);
+                const auto stream=device.stream_for_rank(copy.rank);
+                if(!submitted[copy.rank]) {
+                    submitted[copy.rank]=true;
+                    // These indices are read-only inputs shared by sampled layers.
+                    auto row_tensor=shard.attention_rows.slice(0,0,static_cast<std::int32_t>(count));
+                    auto position_tensor=shard.attention_positions.slice(0,0,static_cast<std::int32_t>(count));
+                    CUDA_CHECK(cudaMemcpyAsync(row_tensor.data,columns.data(),count*sizeof(columns[0]),cudaMemcpyHostToDevice,stream));
+                    CUDA_CHECK(cudaMemcpyAsync(position_tensor.data,positions.data(),count*sizeof(positions[0]),cudaMemcpyHostToDevice,stream));
+                }
+                const auto mass=product(copy);
+                CUDA_CHECK(cudaMemcpyAsync(host+copy.host_offset,mass.data,
+                    copy.elements*sizeof(float),cudaMemcpyDeviceToHost,stream));
+            }
+            for(std::size_t rank=0;rank<submitted.size();++rank) if(submitted[rank]) {
+                DeviceBinding binding(device.rank(rank).device);
+                CUDA_CHECK(cudaStreamSynchronize(device.stream_for_rank(rank)));
+            }
+        } catch (...) {
+            // Drain every submitted rank before index vectors can be released or
+            // the Program can reuse the host buffer after a failed operation.
+            for(std::size_t rank=0;rank<submitted.size();++rank) if(submitted[rank]) {
+                try {
+                    DeviceBinding binding(device.rank(rank).device);
+                    (void)cudaStreamSynchronize(device.stream_for_rank(rank));
+                } catch (...) {}
+            }
+            throw;
+        }
+        if(kvmem_options.verify_transfers) {
+            // Independent transfer schedule: the previous pageable, per-layer
+            // path reruns each identical Op and waits before inspecting it.
+            for(const auto& copy:readback.copies) {
+                DeviceBinding binding(device.rank(copy.rank).device);
+                const auto stream=device.stream_for_rank(copy.rank);
+                const auto mass=product(copy);
+                std::vector<float> reference(copy.elements);
+                CUDA_CHECK(cudaMemcpyAsync(reference.data(),mass.data,
+                    reference.size()*sizeof(float),cudaMemcpyDeviceToHost,stream));
+                CUDA_CHECK(cudaStreamSynchronize(stream));
+                if(std::memcmp(reference.data(),host+copy.host_offset,reference.size()*sizeof(float)))
+                    throw std::logic_error("KVMem batched attention readback changed native bytes");
+            }
+            std::fprintf(stderr,"KVMEM_ATTENTION_READBACK copies=%zu bytes=%zu ranks=%zu bytes_exact=1\n",
+                readback.copies.size(),readback.bytes,
+                static_cast<std::size_t>(std::count(submitted.begin(),submitted.end(),true)));
+        }
+        // Keep the original layer-then-rank floating-point addition order.
+        for(const auto& copy:readback.copies)
+            page_mass.add({reinterpret_cast<const float*>(host+copy.host_offset),copy.elements},
+                copy.native_pages,copy.local_heads);
+        page_mass.finish();
+    }
+    const StatisticsRange graph_range("kvmem.attention.graph-publication");
+    if(observations.empty()) {
+        state.graph=kvmem::prepare_graph_accept(state.graph,state.graph.accepted_through,end,{},32u<<20);
+        state.attention_scope=next_scope;
+        return;
+    }
+    auto next_graph=kvmem::prepare_graph_accept(state.graph,state.graph.accepted_through,end,observations,32u<<20);
+    const auto extra=state.feedback.snapshot().bytes()+attention_feedback_workspace_bytes(observations);
+    next_graph.reserve_extra(extra);
+    auto next_feedback=state.feedback;
+    if(output) for(const auto& row:observations) next_feedback.observe_output(row.mass);
+    else if(!observations.empty()) {
+        std::vector<std::uint64_t> exposed;
+        for(auto page:logical_pages) exposed.push_back(std::uint64_t(page)*64);
+        std::sort(exposed.begin(),exposed.end());
+        exposed.erase(std::unique(exposed.begin(),exposed.end()),exposed.end());
+        next_feedback.observe_prefill(begin,end,accepted,observations,exposed);
+    }
+    next_graph.include_feedback(next_feedback.snapshot().bytes());
+    state.graph=std::move(next_graph);
+    state.feedback=std::move(next_feedback);
+    state.attention_scope=next_scope;
+    if(kvmem_options.verify_transfers) std::fprintf(stderr,
+        "KVMEM_ATTENTION phase=%s begin=%u end=%u samples=%zu graph_revision=%llu\n",
+        output?"output":"prefill",begin,end,rows.size(),static_cast<unsigned long long>(state.graph.revision));
+    (void)row_width;
+}
+} // namespace ninfer::models::qwen3_5::detail
