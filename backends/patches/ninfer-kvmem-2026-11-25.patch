+const MemoryStatisticsShard* TextContext::memory_statistics_for_layer(int fidx,
+    MemoryStatisticsShard& local, std::int32_t& statistics_layer) const {
+    statistics_layer = fidx;
+    if (statistics_ == nullptr) return nullptr;
+    local = statistics_->ranks.at(ctx_.active_rank());
+    local.input_offset = active_memory_input_offset_;
+    local.chunk_tokens = active_memory_chunk_tokens_;
+    if (active_memory_prefill_origin_ != nullptr) local.prefill_origin = *active_memory_prefill_origin_;
+    statistics_layer -= static_cast<std::int32_t>(local.first_layer);
+    if (statistics_layer < 0 || statistics_layer >= local.key_sums.ne[2])
+        throw std::logic_error("KVMem statistics layer is outside its owning stage");
+    return &local;
+}
