+    }
+    execution::PrefillContext* active_context=nullptr;
+    kvmem::PageSoftmaxCuda& layer_scorer(std::uint32_t attention_layer) const {
+        for (const auto& layer:source_layers) {
+            const auto model=layer.model_layer;
+            if (program.parameters.model.config().text.compact_layer_indices[model]!=attention_layer) continue;
+            // Heads-TP assembles represented native Q in original global head
+            // order on rank 0 before invoking the unchanged full-head scorer.
+            const auto rank=program.parameters.text.tensor_parallel()?0:program.parameters.text.layers[model].rank;
+            if (rank!=program.device.active_rank())
+                throw std::logic_error("native current-Q scorer called outside its layer's owning rank");
+            auto* selected=rank?program.memory_query_extra_scorers.at(rank-1).get():scorer;
+            if (!selected) throw std::logic_error("native pipeline stage has no startup-admitted current-Q scorer");
+            return *selected;
+        }
+        throw std::logic_error("native current-Q scorer received a foreign attention ordinal");
+    }
+    void verify_probe_state() const {
+        auto& p=program;
+        if (!checkpoint || !checkpoint->state || !p.memory_kv_staging)
+            throw std::logic_error("native private probe has no exact retained source StateImage");
+        for (std::size_t offset=0;offset<checkpoint->state_bytes();) {
+            const auto count=std::min<std::size_t>(checkpoint->state_bytes()-offset,p.memory_kv_staging->size());
+            auto bytes=std::span(static_cast<std::byte*>(p.memory_kv_staging->data()),count);
+            p.state_images->copy_to_host_range(p.state_store->physical_slot(sequence.state.write),offset,bytes,p.compute_streams);
+            p.device.synchronize();
+            if (std::memcmp(bytes.data(),static_cast<const std::byte*>(checkpoint->state->data())+offset,count))
+                throw std::logic_error("private probe source/rollback differs from its complete native StateImage");
+            offset+=count;
+        }
+    }
+    void run_private_probe(execution::PrefillContext& context,std::uint64_t frozen_limit,float scale) {
