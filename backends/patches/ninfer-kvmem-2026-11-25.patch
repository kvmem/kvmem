+                        !std::equal(tokens.begin(),tokens.end(),capture->consumed_preview.begin()) ||
+                        mask!=(*capture->sampled_preview & prefix))
+                        throw std::logic_error("accepted Output differs from its verified sampling preview");
+                }
+                rows.clear();for (std::uint32_t i=0;i<accepted;++i) if (mask&(std::uint64_t(1)<<i)) rows.push_back(i);
+            } else if (!consumed.empty()) throw std::logic_error("native Output supplied deferred IDs to an already bound token frame");
+            std::vector<kvmem::LayerwiseOutputMass> layers;
+            for (const auto& layer:capture->layers) {
+                if (!capture->deferred_output) layers.push_back({layer.model_layer,layer.history,layer.masses});
+                else {
+                    kvmem::LayerwiseOutputMass mass{layer.model_layer,layer.history,{}};
+                    const auto values=rows.size()*layer.history.size();mass.masses.reserve(values);
+                    if (mass.masses.capacity()>values) throw std::length_error("native deferred Output packet exceeded its admitted matrix");
+                    for (auto row:rows) {
+                        const auto first=std::size_t(row)*layer.history.size();
+                        mass.masses.insert(mass.masses.end(),layer.masses.begin()+first,layer.masses.begin()+first+layer.history.size());
+                    }
+                    layers.push_back(std::move(mass));
+                }
+            }
+            if (measure) {counters.verified+=capture->count;counters.accepted+=accepted;counters.sampled+=rows.size();}
+            if (measure && capture->deferred_output && capture->count>1) {
+                if (accepted==capture->count) ++counters.all_drafts;
+                else if (accepted==1) ++counters.no_drafts;
+                else ++counters.partial_drafts;
+            }
+            if (verify_candidates) {
+                auto mix=[&](std::uint64_t v){counters.candidate_hash=(counters.candidate_hash^v)*1099511628211ULL;};
+                mix(capture->begin);mix(capture->count);
+                for (const auto& layer:capture->layers) {
+                    mix(layer.model_layer);
+                    for (auto page:layer.history) mix(page);
+                    for (double value:layer.masses) {
+                        std::uint64_t bits;std::memcpy(&bits,&value,sizeof(bits));mix(bits);
+                    }
+                }
+            }
+            if (verify_feedback) {
+                auto mix=[&](std::uint64_t x){counters.hash=(counters.hash^x)*1099511628211ULL;};
+                mix(stamp.frontier);mix(accepted);for (auto row:rows) mix(row);
+                for (const auto& layer:layers) {
+                    mix(layer.model_layer);
+                    for (auto page:layer.history) mix(page);
+                    for (double v:layer.masses) {std::uint64_t bits;std::memcpy(&bits,&v,sizeof(bits));mix(bits);}
+                }
+            }
+            next_output->accept({stamp,request_id,accepted,rows,std::move(layers)});
+        } else {
+            next.accept({stamp,capture->count,capture->count,capture->local_begin,capture->rows,capture->layers});
+            if (next_output && !capture->no_refresh && !capture->split_prefill) next_output->accept_prefill(stamp,request_id,capture->begin);
+        }
+        // Prepare the full immutable value before replacing the accepted owner.
+        if (measure) {counters.accept_ms+=milliseconds(clock);clock=FeedbackClock::now();}
+        auto saved=std::make_shared<NativeLayerwiseFeedbackSnapshot>();saved->options=options.prefill;
+        saved->prefill=next.snapshot();saved->output_options=options.output;saved->markers=options.markers;saved->original_query=original_query;
+        if (next_output) saved->output=next_output->snapshot();
+        if (measure) {
+            counters.snapshot_ms+=milliseconds(clock);
+            counters.snapshot_bytes+=saved->allocated_bytes();
+        }
+        if (head_geometry_bytes>runtime_metadata.bytes() || saved->allocated_bytes()>runtime_metadata.bytes()-head_geometry_bytes)
+            throw std::length_error("native accepted feedback exceeds its explicit host account");
+        saved->metadata=runtime_metadata.split(saved->allocated_bytes());
+        auto graph=kvmem::prepare_graph_accept(sequence.window.graph,sequence.window.graph.accepted_through,stamp.frontier,{},32u<<20);
+        // Native Rawresolve has now established the accepted frontiers. Drain
+        // future proposal rows before publishing any checkpointable feedback.
+        close_physical_grant();
+        *prefill=std::move(next);output=std::move(next_output);sequence.window.layer_views.feedback=std::move(saved);
+        if (capture->output) output_work.accepted_consumed_tokens+=accepted;
+        sequence.window.graph=std::move(graph);
+        capture.reset();credit.reset();credit_count=0;native_started=false;
+    }
+};
