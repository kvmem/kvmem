+// Row-scale slot of row r: rows r and r + 8 of a 16-row tile are adjacent (one load per tile).
+__device__ __forceinline__ int scale_index(int r) {
+    return (r & ~15) | ((r & 7) << 1) | ((r >> 3) & 1);
