diff --git a/src/models/qwen3_5/program/storage/attention_feedback_mass.h b/src/models/qwen3_5/program/storage/attention_feedback_mass.h
new file mode 100644
index 0000000000000000000000000000000000000000..bb081cdb8cc73d19c2a59c66fbf8a4394b883e6e
--- /dev/null
+++ b/src/models/qwen3_5/program/storage/attention_feedback_mass.h
@@ -0,0 +1,80 @@
+#pragma once
+
+#include "kvmem/graph_recall.hpp"
+
+#include <algorithm>
+#include <cmath>
+#include <span>
+#include <stdexcept>
+
+namespace ninfer::models::qwen3_5::detail {
+
+// Native page mass is a mean over one rank's local heads. Keep one slot per
+// compact page while adding sampled layers/ranks, in the same addition order
+// as the native calls. Repeating GraphEdges per rank retains no extra information
+// and makes the host graph budget grow with the tensor-parallel rank count.
+class AttentionPageMassAccumulator {
+public:
+    AttentionPageMassAccumulator(std::span<kvmem::AcceptedAttentionRow> rows,
+                                std::span<const std::uint32_t> logical_pages,
+                                std::uint32_t sampled_layers, std::uint32_t global_heads)
+        : rows_(rows), pages_(logical_pages.size()), global_heads_(global_heads),
+          divisor_(double(sampled_layers) * global_heads) {
+        if (!sampled_layers || !global_heads)
+            throw std::logic_error("KVMem attention mass has no sampled layers or heads");
+        for (auto& row : rows_) {
+            if (!row.mass.empty())
+                throw std::logic_error("KVMem attention mass was initialized twice");
+            row.mass.reserve(pages_);
+            for (const auto page : logical_pages)
+                row.mass.push_back({std::uint64_t(page) * 64, 0.0});
+        }
+    }
+
+    void add(std::span<const float> native_mass, std::size_t native_pages,
+             std::uint32_t local_heads) {
+        if (!native_pages || native_pages < pages_ || !local_heads || local_heads > global_heads_ ||
+            native_mass.size() / native_pages != rows_.size() ||
+            native_mass.size() % native_pages)
+            throw std::logic_error("KVMem attention mass has invalid shard geometry");
+        for (std::size_t i = 0; i < rows_.size(); ++i) {
+            for (std::size_t p = 0; p < native_pages; ++p) {
+                const auto value = native_mass[i * native_pages + p] * double(local_heads) / divisor_;
+                if (!std::isfinite(value) || value < 0)
+                    throw std::runtime_error("KVMem sampled invalid attention mass");
+                if (p >= pages_) {
+                    if (value > 1e-7)
+                        throw std::runtime_error("KVMem sampled an unmapped compact page");
+                    continue;
+                }
+                rows_[i].mass[p].mass += value;
+            }
+        }
+    }
+
+    void finish() {
+        for (auto& row : rows_)
+            std::erase_if(row.mass, [](const kvmem::GraphEdge& edge) { return edge.mass == 0; });
+    }
+
+private:
+    std::span<kvmem::AcceptedAttentionRow> rows_;
+    std::size_t pages_;
+    std::uint32_t global_heads_;
+    double divisor_;
+};
+
+inline std::size_t attention_feedback_workspace_bytes(
+    std::span<const kvmem::AcceptedAttentionRow> rows) {
+    std::size_t bytes = 0;
+    for (const auto& row : rows) {
+        // finish() removes zero entries but retains their allocated storage.
+        // Count that capacity once and the two normalized/feedback working
+        // copies by their positive entries; do not hide sparse-row allocation.
+        bytes += row.mass.capacity() * sizeof(kvmem::GraphEdge) +
+                 row.mass.size() * 2 * sizeof(std::pair<std::uint64_t, double>);
+    }
+    return bytes;
+}
+
+} // namespace ninfer::models::qwen3_5::detail
diff --git a/src/models/qwen3_5/program/storage/checkpoint_buffer_pool.h b/src/models/qwen3_5/program/storage/checkpoint_buffer_pool.h
new file mode 100644
index 0000000000000000000000000000000000000000..a1fcf442f872699a49e85f05a2a246c91ae2dbbd
--- /dev/null
+++ b/src/models/qwen3_5/program/storage/checkpoint_buffer_pool.h
@@ -0,0 +1,89 @@
+#pragma once
+#include "core/arena.h"
+#include "models/qwen3_5/program/storage/layerwise_source.h"
+#include <memory>
+#include <mutex>
+#include <array>
+#include <limits>
+#include <stdexcept>
+
+namespace ninfer::models::qwen3_5::detail {
+
+// Only released StateImages may enter the cache. Live checkpoints keep exclusive
+// buffer leases; the pool can outlive Program while a lease is still referenced.
+class KvmemCheckpointBufferPool : public std::enable_shared_from_this<KvmemCheckpointBufferPool> {
+public:
+    void configure_metadata(std::shared_ptr<NativeSourceVersionAccount> account) {
+        std::lock_guard lock(mutex_);
+        if (metadata_.account()) {
+            if (metadata_.account()!=account) throw std::logic_error("checkpoint pool belongs to another Program metadata account");
+        } else if (account) metadata_=account->reserve(accounted_bytes());
+    }
+    void configure(std::size_t limit, std::size_t idle_count) {
+        std::lock_guard lock(mutex_);
+        limit_ = limit; idle_count_ = std::min(idle_count, idle_.size());
+    }
+    void trim() {
+        std::lock_guard lock(mutex_);
+        for (auto& idle : idle_) if (idle) { allocated_ -= idle->size();--buffers_;idle.reset(); }
+        if (metadata_.account()) metadata_.resize(accounted_bytes());
+    }
+    std::size_t allocated_bytes() const {
+        std::lock_guard lock(mutex_); return allocated_;
+    }
+    std::shared_ptr<PinnedHostBuffer> acquire(std::size_t bytes) {
+        auto pool = shared_from_this();
+        std::unique_ptr<PinnedHostBuffer> buffer;
+        {
+            std::lock_guard lock(mutex_);
+            for (auto& idle : idle_) if (idle && idle->size() == bytes) {
+                buffer = std::move(idle); break;
+            }
+        }
+        if (!buffer) {
+            std::lock_guard lock(mutex_);
+            if (allocated_ > limit_ || bytes > limit_ - allocated_)
+                throw std::runtime_error("checkpoint pinned Host budget exhausted");
+            if (metadata_.account()) {
+                if (accounted_bytes()>UINT64_MAX-128 || bytes>UINT64_MAX-accounted_bytes()-128)
+                    throw std::length_error("checkpoint metadata bound overflows");
+                metadata_.resize(accounted_bytes()+bytes+128);
+            }
+            try {buffer = std::make_unique<PinnedHostBuffer>(bytes);}
+            catch (...) {if (metadata_.account()) metadata_.resize(accounted_bytes());throw;}
+            allocated_ += bytes;++buffers_;
+        }
+        return {buffer.release(), [pool = std::move(pool)](PinnedHostBuffer* value) noexcept {
+            std::unique_ptr<PinnedHostBuffer> released(value);
+            try {
+                std::lock_guard lock(pool->mutex_);
+                for (std::size_t i=0; i<pool->idle_count_; ++i) if (!pool->idle_[i]) {
+                    pool->idle_[i] = std::move(released); break;
+                }
+                if (released) {
+                    pool->allocated_ -= released->size();
+                    --pool->buffers_;
+                    released.reset();
+                    if (pool->metadata_.account()) pool->metadata_.resize(pool->accounted_bytes());
+                }
+            } catch (...) {} // Releasing a checkpoint must remain noexcept.
+        }};
+    }
+    std::size_t idle_bytes() const {
+        std::lock_guard lock(mutex_);
+        std::size_t bytes = 0;
+        for (const auto& idle : idle_) if (idle) bytes += idle->size();
+        return bytes;
+    }
+private:
+    mutable std::mutex mutex_;
+    std::size_t allocated_ = 0, limit_ = std::numeric_limits<std::size_t>::max(), idle_count_ = 2;
+    std::size_t buffers_=0;
+    // Includes the buffer object and shared lease's bounded control metadata.
+    std::uint64_t accounted_bytes() const noexcept {return allocated_+std::uint64_t(buffers_)*128;}
+    NativeSourceVersionCharge metadata_;
+    // A restored anchor can release both its input and endpoint snapshots.
+    // Keep that pair; live snapshots can never enter these slots.
+    std::array<std::unique_ptr<PinnedHostBuffer>, 2> idle_;
+};
+} // namespace ninfer::models::qwen3_5::detail
diff --git a/src/models/qwen3_5/program/storage/checkpoint_recompute_policy.h b/src/models/qwen3_5/program/storage/checkpoint_recompute_policy.h
new file mode 100644
index 0000000000000000000000000000000000000000..c2ed61ed31a8542f7384b2af6461c73163400a46
--- /dev/null
+++ b/src/models/qwen3_5/program/storage/checkpoint_recompute_policy.h
@@ -0,0 +1,121 @@
+#pragma once
+
+#include <algorithm>
+#include <cstddef>
+#include <cstdint>
+#include <limits>
+#include <memory>
+#include <numeric>
+#include <span>
+#include <vector>
+
+namespace ninfer::models::qwen3_5::detail {
+
+// The Frontend has already mapped both boundaries exactly through tokenization
+// and media expansion. Add a deeper input source only when conservative rewrite
+// recovery moved earlier; ordinary same-boundary requests keep their old policy.
+inline std::uint32_t structural_input_reuse_frontier(std::uint32_t prompt_tokens,
+                                                     std::uint32_t input_end,
+                                                     std::uint32_t rewrite_frontier) {
+    return rewrite_frontier && rewrite_frontier < input_end && input_end < prompt_tokens
+        ? input_end : 0U;
+}
+
+// Publish only after capture/restore succeeded. The two roles replace the old
+// single Base role across requests, so splitting their names must not retain
+// an obsolete extra image. During a real replay its exact Query source remains
+// protected even if a separate ordinary tail is captured by the second pass.
+template<class State>
+void publish_checkpoint_execution_source(std::shared_ptr<State>& query,
+                                         std::shared_ptr<State>& tail,
+                                         std::shared_ptr<State> source,
+                                         bool query_source, bool query_active) {
+    if (query_source) {
+        query = std::move(source);
+        tail.reset();
+    } else {
+        tail = std::move(source);
+        if (!query_active) query.reset();
+    }
+}
+
+struct CheckpointReplayCompletion {
+    bool prefill_committed = false;
+    bool replay_active = false;
+    bool tail_complete = false;
+    std::uint64_t tail_frontier = 0;
+    std::uint64_t query_end = 0;
+};
+
+// Retire a consumed execution role at accepted Begin, not at final reply. A
+// subsequent decode cancellation then keeps the same single-Base footprint as
+// T=0 previously did. An unfinished replay or incomplete recovery tail cannot
+// release it; T>0 retention remains the separate successful-finish policy.
+template<class State>
+bool retire_query_checkpoint_after_prefill(std::shared_ptr<State>& query,
+                                           const std::shared_ptr<State>& tail,
+                                           std::uint64_t limit,
+                                           const CheckpointReplayCompletion& completion) {
+    if (limit || !query || !tail || !completion.prefill_committed || completion.replay_active ||
+        !completion.tail_complete || completion.tail_frontier < completion.query_end) return false;
+    query.reset();
+    return true;
+}
+
+// This is an extra-token budget, not a time, I/O or StateImage-copy budget.
+inline bool checkpoint_recompute_allowed(std::uint64_t earlier, std::uint64_t frontier,
+                                         std::uint64_t limit, std::uint64_t minimum) {
+    return limit && earlier && earlier < frontier && earlier >= minimum &&
+           frontier - earlier <= limit;
+}
+
+// A same-boundary native image can be shared even with thinning disabled. The
+// caller still has to prove complete native identity, state and KV coverage.
+inline bool input_reuse_source_allowed(std::uint64_t source, std::uint64_t frontier,
+                                       std::uint64_t limit, std::uint64_t query_end) {
+    return source && source >= query_end &&
+        (source == frontier || checkpoint_recompute_allowed(source, frontier, limit, query_end));
+}
+
+struct CheckpointRecomputePoint {
+    std::uint64_t frontier = 0;
+    // A post-Query input point must retain an alternative that also contains the
+    // whole Query. A consumed pre-Query execution point has no such requirement.
+    std::uint64_t minimum_surrogate = 0;
+    bool complete = false;
+    bool protected_point = false;
+};
+
+inline constexpr auto no_checkpoint_surrogate = std::numeric_limits<std::size_t>::max();
+
+// The caller proves native identity/KV completeness and removes payload aliases.
+// A result entry names a retained earlier point, or no_checkpoint_surrogate when
+// this point stays. Removed neighbours never become representatives: 100/110/120
+// with a budget of 16 retains 100 and 120, rather than silently accumulating 20.
+inline std::vector<std::size_t> checkpoint_recompute_plan(
+        std::span<const CheckpointRecomputePoint> points, std::uint64_t limit) {
+    std::vector<std::size_t> result(points.size(), no_checkpoint_surrogate);
+    if (!limit) return result;
+    std::vector<std::size_t> order(points.size()), retained;
+    std::iota(order.begin(), order.end(), 0);
+    std::stable_sort(order.begin(), order.end(), [&](auto a, auto b) {
+        return points[a].frontier < points[b].frontier;
+    });
+    for (auto index : order) {
+        const auto& point = points[index];
+        if (point.complete && !point.protected_point) {
+            for (auto it = retained.rbegin(); it != retained.rend(); ++it) {
+                const auto& earlier = points[*it];
+                if (earlier.complete && checkpoint_recompute_allowed(
+                        earlier.frontier, point.frontier, limit, point.minimum_surrogate)) {
+                    result[index] = *it;
+                    break;
+                }
+            }
+        }
+        if (result[index] == no_checkpoint_surrogate) retained.push_back(index);
+    }
+    return result;
+}
+
+} // namespace ninfer::models::qwen3_5::detail
