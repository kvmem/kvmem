+    void validate_context(const execution::PrefillContext& c) const {
+        const bool pipeline=device.size()>1 && c.execution.stages && !c.execution.stages->tensor_parallel &&
+            parameters->text.rank_count==device.size();
+        if (&c.execution.parameters != parameters || &c.execution.device != &device ||
+            c.execution.stages!=stages ||
+            (!pipeline && !tensor && (device.size()!=1 || c.execution.stages!=nullptr)) ||
+            (tensor && (!stages || !stages->tensor_parallel || !parameters->text.tensor_parallel() ||
+                parameters->text.rank_count!=device.size() || stages->tensor_parallel->shares.size()!=device.size() ||
+                stages->tensor_parallel->shards.size()!=device.size() || !stages->tensor_parallel->exchange)) ||
+            device.active_rank() != 0 || c.execution.work.active_rank() != 0 ||
+            c.state_source_slot != source_slot || c.state_destination_slot != destination_slot ||
+            c.execution.prefill_chunk < chunk)
+            throw std::logic_error("native Query execution owner/rank or state binding changed");
+        if (tensor && !tensor_projection.empty()) {
+            const auto& tp=*stages->tensor_parallel;
+            const auto group=config.attention->num_attention_heads/config.attention->num_key_value_heads;
+            for (std::size_t rank=0;rank<tensor_projection.size();++rank) {
+                const auto& saved=tensor_projection[rank];const auto& share=tp.shares.at(rank);
+                const auto& local=tp.shards.at(rank);
+                if (saved.query_begin!=share.kv_head_begin*group || saved.query_heads!=(share.kv_head_end-share.kv_head_begin)*group ||
+                    saved.key_begin!=share.kv_head_begin || saved.key_heads!=share.kv_head_end-share.kv_head_begin ||
+                    share.attention_positions || (saved.key_heads && (!local.attention ||
+                        local.attention->num_attention_heads!=saved.query_heads ||
+                        local.attention->num_key_value_heads!=saved.key_heads || local.attention->head_dim!=config.attention->head_dim)))
+                    throw std::logic_error("native tensor Query partition changed after resource admission");
+            }
+        }
+        execution::require_current_layer_query_eager(device.stream);
+    }
+    std::unique_ptr<kvmem::QueryProjectionTape> tape(std::uint32_t model_layer,
+                                                   const kvmem::QueryProjectionLayout& layout) {
+        if (use_disk) return std::make_unique<kvmem::QueryProjectionTape>(*activation_disk,*activation_metadata,max_chunks,identity,model_layer,layout);
+        return std::make_unique<kvmem::QueryProjectionTape>(*activation_ram,*activation_metadata,max_chunks,identity,model_layer,layout);
+    }
+    std::size_t ordinal(std::uint64_t begin) const {
+        const auto found=std::lower_bound(tiles.begin(),tiles.end(),begin,
+            [](const InputTile& tile,std::uint64_t value){return tile.begin<value;});
+        if (found==tiles.end() || found->begin!=begin)
+            throw std::logic_error("native Query stage changed its frozen native tile boundary");
+        return static_cast<std::size_t>(found-tiles.begin());
+    }
+    std::uint32_t rows() const { return tiles.at(ordinal(cursor)).count; }
+    void original_rope(std::int32_t* destination,std::uint64_t begin,std::uint32_t n,std::uint32_t axis) const {
+        if (prompt_input.prompt) std::copy_n(prompt_input.prompt->positions.data()+
+            std::uint64_t(axis)*prompt_input.prompt->token_ids.size()+begin,n,destination);
+        else for (std::uint32_t i=0;i<n;++i) destination[i]=static_cast<std::int32_t>(begin+i+rope_delta);
+    }
+    void copy_composed(std::uint64_t begin,std::uint32_t n,Tensor destination) const {
+        if (!original_input || !original_input->complete() || !n || begin<identity.evaluation.begin ||
+            begin>identity.evaluation.end || n>identity.evaluation.end-begin || device.active_rank()!=0 ||
+            execution_workspace.active_rank()!=0 || !destination.data || destination.dtype!=DType::BF16 || destination.ne[0]!=config.hidden_size ||
+            destination.ne[1]!=n || destination.ne[2]!=1 || destination.ne[3]!=1 ||
+            !destination.is_contiguous() || destination.bytes()>pin_bytes)
+            throw std::invalid_argument("native composed input read is outside its sealed admitted source");
+        const auto d=reinterpret_cast<std::uintptr_t>(destination.data);
+        const auto w=reinterpret_cast<std::uintptr_t>(execution_workspace.base());
+        const bool aliases=d>=w?d-w<execution_workspace.capacity():w-d<destination.bytes();
+        if (aliases) throw std::invalid_argument("composed input read requires stable storage outside native workspace");
+        CUDA_CHECK(cudaStreamSynchronize(device.stream));
+        original_input->read_rows(identity,0,Residual,begin,n,staging->data(),destination.bytes());
+        CUDA_CHECK(cudaMemcpyAsync(destination.data,staging->data(),destination.bytes(),cudaMemcpyHostToDevice,device.stream));
+        CUDA_CHECK(cudaStreamSynchronize(device.stream));
+    }
+    Tensor with_rows(Tensor t, std::uint32_t n, int axis = 1) const {
+        auto shape = std::array{t.ne[0], t.ne[1], t.ne[2], t.ne[3]}; shape[axis] = dim(n);
+        return Tensor(t.data, t.dtype, {shape[0], shape[1], shape[2], shape[3]});
+    }
+    execution::PreparedLayerQueryStorage storage(std::uint32_t n) const {
+        const auto& capacity=ranks.at(device.active_rank()).capacity;
+        return {with_rows(capacity.query,n,2), with_rows(capacity.key,n,2), with_rows(capacity.value,n,2),
+                with_rows(capacity.gate,n,2), with_rows(capacity.residual,n),
+                with_rows(capacity.cache_positions,n,0), with_rows(capacity.rope_positions,n,0)};
+    }
+    execution::PreparedLayerQueryStorage tensor_storage(std::size_t rank,std::uint32_t n) const {
+        const auto& p=tensor_projection.at(rank);const auto& capacity=ranks.at(rank).capacity;
+        const auto d=dim(config.attention->head_dim);
+        return {Tensor(capacity.query.data,DType::BF16,{d,dim(p.query_heads),dim(n)}),
+            Tensor(capacity.key.data,DType::BF16,{d,dim(p.key_heads),dim(n)}),
+            Tensor(capacity.value.data,DType::BF16,{d,dim(p.key_heads),dim(n)}),
+            Tensor(capacity.gate.data,DType::BF16,{d,dim(p.query_heads),dim(n)}),
+            with_rows(capacity.residual,n),with_rows(capacity.cache_positions,n,0),
+            with_rows(capacity.rope_positions,n,0)};
+    }
+    std::size_t offset(std::uint32_t id, std::uint32_t n) const {
+        std::uint64_t at = 0;
+        for (const auto& p : projected_layout.planes) {
+            if (p.id == id) return addressable(at);
+            at = add(at, multiply(p.row_stride,n));
+        }
+        throw std::logic_error("unknown native Query plane");
+    }
+    std::byte* host(std::uint32_t id, std::uint32_t n) const {
+        return static_cast<std::byte*>(staging->data()) + offset(id,n);
+    }
+    std::byte* tensor_host(std::size_t rank,std::uint32_t id,std::uint32_t n) const {
+        std::uint64_t at=0;
+        for (const auto& plane:tensor_projection.at(rank).layout.planes) {
+            if (plane.id==id) return static_cast<std::byte*>(staging->data())+
+                addressable(add(tensor_projection[rank].staging_offset,at));
+            at=add(at,multiply(plane.row_stride,n));
+        }
+        throw std::logic_error("unknown native tensor Query plane");
+    }
+    std::byte* tensor_extension() const {
+        return static_cast<std::byte*>(staging->data())+addressable(tensor_staging_offset);
+    }
+    void transfer_planes(execution::PreparedLayerQueryStorage& storage,std::uint32_t n,
+                         bool download,std::size_t rank=SIZE_MAX) const {
+        Tensor* fixed[]{&storage.query,&storage.key,&storage.value,&storage.gate,&storage.residual,&storage.cache_positions};
+        auto transfer=[&](std::uint32_t id,void* device_pointer,std::size_t bytes) {
+            auto* cpu=rank==SIZE_MAX?host(id,n):tensor_host(rank,id,n);
+            CUDA_CHECK(cudaMemcpyAsync(download?static_cast<void*>(cpu):device_pointer,
+                download?device_pointer:static_cast<void*>(cpu),bytes,
+                download?cudaMemcpyDeviceToHost:cudaMemcpyHostToDevice,device.stream));
+        };
+        for (std::uint32_t id=0;id<6;++id) transfer(id,fixed[id]->data,fixed[id]->bytes());
+        // A native [n,3] tensor is axis-major, while tape reads are by logical
+        // token. Store each axis independently with its true stride4.
+        for (std::uint32_t axis=0;axis<rope_axes;++axis)
+            transfer(rope_plane(axis),static_cast<std::byte*>(storage.rope_positions.data)+std::size_t(axis)*n*4,std::size_t(n)*4);
+    }
+    void upload_positions(execution::PreparedLayerQueryStorage& storage,std::uint32_t n,std::size_t rank=SIZE_MAX) const {
+        auto address=[&](std::uint32_t id){return rank==SIZE_MAX?host(id,n):tensor_host(rank,id,n);};
+        auto* cache=reinterpret_cast<std::int32_t*>(address(CachePosition));
+        for (std::uint32_t i=0;i<n;++i)
+            cache[i]=static_cast<std::int32_t>(bindings.historical_tokens+cursor-identity.evaluation.begin+i);
+        CUDA_CHECK(cudaMemcpyAsync(storage.cache_positions.data,cache,std::size_t(n)*4,cudaMemcpyHostToDevice,device.stream));
+        for (std::uint32_t axis=0;axis<rope_axes;++axis) {
+            auto* rope=reinterpret_cast<std::int32_t*>(address(rope_plane(axis)));
+            original_rope(rope,cursor,n,axis);
+            CUDA_CHECK(cudaMemcpyAsync(static_cast<std::byte*>(storage.rope_positions.data)+std::size_t(axis)*n*4,
+                rope,std::size_t(n)*4,cudaMemcpyHostToDevice,device.stream));
+        }
+    }
+    void bind(execution::PrefillContext& c, execution::TextContext& card, std::span<const TokenId> public_input,
