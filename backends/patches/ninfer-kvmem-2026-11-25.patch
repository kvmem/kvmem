+                   qh = dim(config.attention->num_attention_heads), kh = dim(config.attention->num_key_value_heads);
+        const auto query = layout.add_tensor(DType::BF16, {d, qh, t}, 256, "query");
+        const auto key = layout.add_tensor(DType::BF16, {d, kh, t}, 256, "key");
+        const auto value = layout.add_tensor(DType::BF16, {d, kh, t}, 256, "value");
+        const auto gate = layout.add_tensor(DType::BF16, {d, qh, t}, 256, "gate");
+        const auto residual = layout.add_tensor(DType::BF16, {dim(h), t}, 256, "residual");
+        const auto cache = layout.add_tensor(DType::I32, {t}, 256, "cache positions");
+        const auto rope = layout.add_tensor(DType::I32, {t,dim(rope_axes)}, 256, "RoPE positions");
+        const auto ids = layout.add_tensor(DType::I32, {t}, 256, "token IDs");
+        const auto hidden = layout.add_tensor(DType::BF16, {dim(h), t}, 256, "normalized hidden");
+        const auto logits = layout.add_tensor(execution::target_logits_dtype(parameters->text.output_head), {dim(config.vocab_size), 1}, 256, "target logits");
+        const auto table_row=layout.add_tensor(DType::I32,{1},256,"Query rank-local table row");
+        const auto origin=layout.add_tensor(DType::I32,{1},256,"Query rank-local logical origin");
+        const auto rank_bytes=layout.finish(256);
