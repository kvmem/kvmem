+void ProgramImpl::prepare_layerwise_admission(MaterializationTransaction& transaction,
+    const KvmemPrefixCheckpoint* checkpoint,const KvmemWindowState* prospective) {
+    auto& staged=*requests[transaction.destination.value].prefill;
+    const auto envelope=layerwise_envelope(staged.prompt,transaction.plan->impl_->summary.effective_output_tokens);
+    const kvmem::LayerwiseWindowPlan window(envelope,kvmem_window_tokens);
+    const auto source_h=checkpoint?static_cast<std::uint32_t>(checkpoint->prefix.size()):0U;
+    const auto source_l=checkpoint?checkpoint->layer_views.validate(source_h):0U;
+    const auto phases=plan_native_query_admission(window,{source_h,source_l},prefill_chunk,
+        speculative_backend==SpeculativeBackend::Mtp &&
+        kvmem_options.layerwise_mtp_history==kvmem::LayerwiseMtpHistory::UpstreamGlobal);
+    const auto source_partition=kvmem_options.layerwise.metadata_bytes-2*(kvmem_options.layerwise.metadata_bytes/8);
+    if (!layerwise_source_account || layerwise_source_account->limit()!=source_partition || !memory_checkpoint_pool)
+        throw std::logic_error("native Waiting has no owning finite Program source account/pool");
+    memory_checkpoint_pool->configure_metadata(layerwise_source_account);
+    if (transaction.memory_history && transaction.memory_history->work &&
+        transaction.memory_history->work->layerwise_admission) {
+        const auto& old=*transaction.memory_history->work->layerwise_admission;
+        if (old.input_owner!=&staged.prompt || old.prompt_end!=staged.prompt_tokens ||
+            old.source_frontier!=source_h || old.account()!=layerwise_source_account ||
+            old.source.get()!=(checkpoint?checkpoint->canonical_source.get():nullptr) ||
+            old.source_epoch!=(checkpoint && checkpoint->canonical_source?checkpoint->canonical_source->epoch:0))
+            throw std::logic_error("native Waiting retry changed its exact input/source reservation");
+        return;
+    }
+    auto log=[&](const char* action,std::uint32_t count) {
+        if (!kvmem_options.verify_transfers) return;
+        const auto allocated=memory_checkpoint_pool->allocated_bytes(),idle=memory_checkpoint_pool->idle_bytes();
+        std::fprintf(stderr,"KVMEM_LAYERWISE_ADMISSION action=%s phase=waiting source_h=%u source_l=%llu source_epoch=%llu source_used=%llu source_limit=%llu pool_allocated=%zu pool_idle=%zu pool_active=%zu checkpoint_credits=%u history_moved=0 model_forward_rows=0\n",
+            action,source_h,(unsigned long long)source_l,
+            (unsigned long long)(checkpoint && checkpoint->canonical_source?checkpoint->canonical_source->epoch:0),
+            (unsigned long long)layerwise_source_account->charged_bytes(),(unsigned long long)source_partition,
+            allocated,idle,allocated-idle,count);
+    };
+    log("begin",phases.checkpoint_count);
+    auto build=[&]() {
+        // Charge the owner, bounded phase vector and optional new Work before
+        // allocating their control blocks. Existing v1 Work is already funded.
+        const auto descriptor_planes=std::uint64_t(parameters.model.config().text.full_attention_layers)*
+            std::max<std::size_t>(1,device.size())*4+(backend_kv_pages?4:0);
+        const auto pricing_bytes=admission_add(checkpoint?2*checkpoint->graph.bytes():2*sizeof(kvmem::GraphSnapshot),
+            admission_add(admission_mul(2*(staged.prompt.memory_messages.size()+1),sizeof(kvmem::GraphMessageSpan)),
+                admission_add(admission_mul(6*descriptor_planes,sizeof(kvmem::PayloadPlane)),
+                    4096+256*state_images->shard_count())));
+        const auto controls=admission_add(pricing_bytes,sizeof(NativeLayerwiseAdmission)+128+
+            3*sizeof(NativeLayerwiseCheckpointCredit)+
+            ((!transaction.memory_history || !transaction.memory_history->work)?
+                sizeof(KvmemHistoryPreparation)+sizeof(KvmemHistoryPreparation::Work)+128:0));
+        auto control=layerwise_source_account->reserve(controls);
+        auto owner=std::make_shared<NativeLayerwiseAdmission>();
+        owner->control_metadata=std::move(control);owner->pool=memory_checkpoint_pool;
+        owner->verify=kvmem_options.verify_transfers;owner->input_owner=&staged.prompt;
+        owner->prompt_end=staged.prompt_tokens;owner->source_frontier=source_h;
+        owner->query_begin=envelope.query?static_cast<std::uint32_t>(envelope.query->begin):0;
+        owner->query_end=envelope.query?static_cast<std::uint32_t>(envelope.query->end):0;
+        owner->source=checkpoint?checkpoint->canonical_source:nullptr;
+        owner->source_epoch=owner->source?owner->source->epoch:0;
+        owner->checkpoints.reserve(3);
+        prepare_native_layerwise_fresh_statistics_admission(*owner,prospective,capacity,kvmem_window_tokens,
+            parameters.model.config().text.full_attention_layers,memory_statistics->key_width,kvmem_options.mean_key_block_tokens());
+        // Graph/cohort adapter prices sizeof its actual Impl and reserves all
+        // three feedback tickets in Waiting; this is not a capacity-only probe.
+        NativeLayerwiseRequest::prepare_feedback_admission(*this,*owner,envelope,
+            native_layerwise_prefill_options(kvmem_options.selected_tokens,kvmem_options.reserve_tokens));
+        const auto layout=plan_host_kv_page_layout(text_kv_pages->physical_pool().geometry());
+        std::optional<HostKVPageLayout> auxiliary;
+        if (backend_kv_pages) auxiliary=plan_host_kv_page_layout(backend_kv_pages->physical_pool().geometry());
+        const auto descriptor=native_window_descriptor(*this,layout,auxiliary,
+            layout.page_stride+(auxiliary?auxiliary->page_stride:0),backend_kv_cache());
+        const kvmem::CheckpointIdentity identity{descriptor.identity,descriptor.layout,{}};
+        kvmem::RawKvStoreConfig config;
+        config.n_layer=parameters.model.config().text.full_attention_layers;
+        config.n_embd_k=memory_statistics->key_width;config.block_tokens=kvmem_options.mean_key_block_tokens();
+        kvmem::RawKvStore empty(config);
+        const auto& mean=prospective && prospective->statistics?*prospective->statistics:empty;
+        auto graph=admission_graph(checkpoint,staged.prompt,capacity);
+        const auto compact_pages=(std::uint64_t(kvmem_window_tokens)+63)/64;
+        const auto layers=std::uint64_t(config.n_layer);
+        // Native map vectors grow geometrically by at most two capacities.
+        const auto maps=admission_add(admission_mul(2*layers,sizeof(KvmemLayerResidentView)),
+            admission_mul(2*compact_pages*(layers+1),sizeof(std::uint32_t)));
+        const auto feedback=checkpoint?3*checkpoint->feedback.bytes():0;
+        auto reserve_phase=[&](NativeCheckpointPhase phase) {
+            const auto frontier=phase.frontier;
+            if (frontier<graph.accepted_through)
+                throw std::logic_error("native Waiting checkpoint precedes its exact source graph");
+            graph=kvmem::prepare_graph_accept(graph,graph.accepted_through,frontier,{},32u<<20);
+            const auto pages=(std::uint64_t(frontier)+63)/64;
+            const auto index=phase.new_canonical_index?
+                admission_add(sizeof(NativeCanonicalHistoryVersion)+64+NativeCanonicalHistoryVersion::descriptor_bytes(descriptor),
+                    admission_add(admission_mul(pages,sizeof(kvmem::HostKvRecord)+sizeof(std::uint32_t)),mean.capacity_bytes(frontier))):0;
+            const auto identity_bytes=std::max<std::uint64_t>(materialization_identity_.allocated_bytes(),
+                checkpoint?checkpoint->prefix_identity.allocated_bytes():0);
+            auto metadata=admission_add(sizeof(KvmemPrefixCheckpoint)+64+KvmemPrefixCheckpoint::identity_bytes(identity),
+                admission_add(admission_mul(2*std::uint64_t(frontier),sizeof(TokenId)),identity_bytes));
+            const auto score_capacity=std::max<std::uint64_t>(2*pages,
+                checkpoint?checkpoint->history.scores->capacity():0);
+            metadata=admission_add(metadata,admission_add(admission_mul(compact_pages,sizeof(std::uint64_t)),
+                admission_mul(score_capacity,sizeof(double))));
+            metadata=admission_add(metadata,admission_add(graph.bytes(),admission_add(feedback,maps)));
+            NativeLayerwiseCheckpointCredit credit;credit.role=phase.role;credit.frontier=frontier;
+            credit.image_bytes=state_images->host_layout().image_bytes;
+            credit.index_bound=index;credit.checkpoint_bound=metadata;credit.pool=memory_checkpoint_pool;
+            credit.feedback_bound=owner->feedback_snapshot_bytes;
+            credit.metadata=layerwise_source_account->reserve(admission_add(index,admission_add(metadata,credit.feedback_bound)));
+            credit.image=memory_checkpoint_pool->acquire(credit.image_bytes);
+            owner->checkpoints.push_back(std::move(credit));
+        };
+        for (std::uint32_t i=0;i<phases.checkpoint_count;++i) reserve_phase(phases.checkpoints[i]);
+        // Ordinary PromptTail is required unless a structural input checkpoint
+        // suppresses it. Media cannot be divided. A saved nearby surrogate may
+        // still make this credit unnecessary; detach releases that unused lease.
+        if (!envelope.query) if (const auto point=window.prefill_checkpoint();point && *point>source_h &&
+            !memory_input_reuse_frontier(staged.prompt) &&
+            *point==layerwise_media_replay_begin(staged.prompt,*point,64))
+            reserve_phase({NativeLayerwiseCheckpointRole::PrefillBoundary,static_cast<std::uint32_t>(*point),true});
+        const auto& policy=prospective?prospective->coverage.policy():
+            continuation_states.at(transaction.destination.value).window.coverage.policy();
+        if (policy.enabled) {
+            // Images are already in the real pool. Count the unpublished CP
+            // metadata exactly once, alongside all peers' future CP credits.
+            auto used=native_checkpoint_policy_bytes();
+            for (const auto& credit:owner->checkpoints) used=admission_add(used,credit.checkpoint_bound);
+            if (kvmem_options.disk_bytes) used=admission_add(used,state_images->host_layout().image_bytes);
+            const auto budget=admission_mul(policy.host_bytes,max_concurrency);
+            if (used>budget)
+                throw ContextCacheExhausted("native Waiting cannot admit its complete checkpoint Host policy peak");
+        }
+        return owner;
+    };
+    std::shared_ptr<NativeLayerwiseAdmission> owner;
+    for (unsigned attempt=0;;++attempt) {
+        try {owner=build();break;}
+        catch (const NativeSourceQuotaExceeded& error) {
+            if (error.account==layerwise_source_account.get() && error.growth<=layerwise_source_account->limit() &&
+                reclaim_idle_metadata(error.shortfall)) continue;
+            log("denied",phases.checkpoint_count);
+            throw ContextCacheExhausted("native Waiting cannot admit the required metadata after idle reclamation");
+        } catch (const std::length_error&) {
+            if (!attempt && memory_checkpoint_pool->idle_bytes()) {memory_checkpoint_pool->trim();continue;}
+            log("denied",phases.checkpoint_count);
+            throw ContextCacheExhausted("native Waiting cannot hold its complete Query/feedback/checkpoint metadata peak");
+        } catch (const ContextCacheExhausted&) {
+            if (!attempt && memory_checkpoint_pool->idle_bytes()) {memory_checkpoint_pool->trim();continue;}
+            log("denied",phases.checkpoint_count);throw;
+        } catch (const kvmem::MemoryError& error) {
+            if (error.code()!=kvmem::MemoryErrorCode::BudgetExceeded) throw;
+            if (!attempt && memory_checkpoint_pool->idle_bytes()) {memory_checkpoint_pool->trim();continue;}
+            log("denied",phases.checkpoint_count);throw ContextCacheExhausted(error.what());
+        } catch (const std::bad_alloc&) {
+            log("denied",phases.checkpoint_count);
+            throw ContextCacheExhausted("native Waiting could not allocate its complete bounded request resources");
+        } catch (const std::runtime_error& error) {
+            // Pool/acquire and CUDA pinned allocation are engineering resource
+            // refusals here; no Native model work or old-history move occurred.
+            log("denied",phases.checkpoint_count);throw ContextCacheExhausted(error.what());
+        }
+    }
+    if (!transaction.memory_history) transaction.memory_history=std::make_unique<KvmemHistoryPreparation>();
+    if (!transaction.memory_history->work) transaction.memory_history->work=std::make_shared<KvmemHistoryPreparation::Work>();
+    transaction.memory_history->work->layerwise_admission=std::move(owner);
+    log("reserved",static_cast<std::uint32_t>(transaction.memory_history->work->layerwise_admission->checkpoints.size()));
+}
