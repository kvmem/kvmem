+bool same_options(const kvmem::LayerwisePrefillOptions& a,const kvmem::LayerwisePrefillOptions& b) {
+    return a.block_tokens==b.block_tokens && a.select_tokens==b.select_tokens &&
+        a.reserve_tokens==b.reserve_tokens && a.interval==b.interval && a.stride==b.stride && a.half_life==b.half_life && a.scorer==b.scorer;
+}
+bool same_options(const kvmem::LayerwiseOutputOptions& a,const kvmem::LayerwiseOutputOptions& b) {
+    return a.scope==b.scope && a.interval==b.interval && a.decay==b.decay && a.commit_max_bytes==b.commit_max_bytes;
+}
+std::uint64_t checked_product(std::uint64_t a,std::uint64_t b) {
+    if (b && a>UINT64_MAX/b) throw std::length_error("native layerwise feedback byte count overflows");return a*b;
+}
+std::uint64_t checked_sum(std::uint64_t a,std::uint64_t b) {
+    if (b>UINT64_MAX-a) throw std::length_error("native layerwise feedback byte sum overflows");return a+b;
+}
