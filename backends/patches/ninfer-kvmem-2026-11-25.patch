+std::uint64_t native_query_mtp_device_bound(const TextConfig&,std::uint32_t chunk,std::uint32_t rope_axes);
+std::uint64_t native_query_staging_bytes(const TextConfig&,std::uint32_t chunk);
+std::uint64_t native_query_staging_bytes(const TextConfig&,std::uint32_t chunk,std::uint32_t rope_axes);
+std::uint64_t native_query_tensor_staging_bytes(const TextConfig&,std::uint32_t chunk,
+                                                std::uint32_t ranks);
+std::uint64_t native_query_tensor_staging_bytes(const TextConfig&,std::uint32_t chunk,
+                                                std::uint32_t ranks,std::uint32_t rope_axes);
+
+struct NativeQueryPromptInput {
+    // The RequestControl owns both objects for the whole execution. Complete
+    // positions are required even when the current Query contains only text.
+    const PreparedPromptData* prompt = nullptr;
+    execution::VisionPrefillSession* vision = nullptr;
+    bool retain_for_mtp = false;
+};
+
+struct NativeQueryRunnerBindings {
+    std::uint32_t historical_tokens = 0;
+    float attention_scale = 0;
+    kvmem::LayerwiseQuerySelection::NativeScorer score;
+    // The Program performs whole-page COW, then restores only this target
+    // layer's native K/V/scale stripes. Return the real post-fence view. No
+    // accepted frontier, session or checkpoint may be published by this hook.
+    std::function<kvmem::ExecutionView(std::uint32_t, const kvmem::LayerWorkingSetPlan&)> restore;
+    // Exact native FP32 token_sums, captured during this chunk's projection.
+    // The span is chronological logical-page buckets, each containing the full
+    // native KV width. Called only after attention/residual/FFN have fenced.
+    // The selection's index must be a separately owned frozen mean prefix.
+    std::function<void(std::uint32_t, std::uint64_t, std::uint32_t, std::span<const float>)> commit_mean;
+    // Borrow the actual target final-normalized hidden chunk after its producer
+    // fence. The final chunk also supplies completed target logits. The Program
+    // may feed the existing MTP operation here using its independent auxiliary
+    // map/positions; no target forward is repeated. These views must not escape
+    // the callback. This execution fences again before yielding/reusing storage.
+    std::function<void(std::uint64_t, const Tensor&, const Tensor*)> final_hidden;
+    // Actual model-block residual after its mixer and FFN, before the next
+    // block/final normalization. DFlash captures its configured target block
+    // IDs from this seam, including GDN blocks. Borrowed storage cannot escape:
+    // enqueue copies on producer_stream or finish their consumer before return.
+    // The owning Program accounts any retained feature tapes separately.
+    std::function<void(std::uint32_t, std::uint64_t, const Tensor&, cudaStream_t)> layer_output;
+    // Optional eager all-target mass observer. It borrows post-RoPE Q only
+    // inside native attention; no arena pointer survives its callback.
+    const execution::CurrentLayerQueryBoundary* attention_boundary=nullptr;
+};
+
+enum class NativeQueryRunnerStage {
+    Embedding, BeginLayer, Projection, Restore, Consumption, Gdn, FinalNorm, Complete, Aborted
