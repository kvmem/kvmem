+#include "models/qwen3_5/program/internal.h"
+#include "core/paged_kv_cache.h"
+#include "kvmem/layerwise_options.hpp"
+#include <stdexcept>
+
+namespace ninfer::models::qwen3_5::detail {
+
+// Option granularity, not a hidden padding/allocation rule. The existing
+// planner and native small-T operators derive their real layouts from the
+// chosen row capacity, including 17..64-row prompt calls. Keep Legacy's
+// original128 contract while Layerwise uses its actual64-token Window block.
+inline void validate_native_prefill_chunk(std::uint32_t chunk,kvmem::RecallStrategy strategy) {
+    const auto alignment=strategy==kvmem::RecallStrategy::Layerwise
+        ?static_cast<std::uint32_t>(kPagedKVPageSize):kPrefillChunkAlignment;
+    if (!chunk || chunk%alignment)
+        throw std::invalid_argument(strategy==kvmem::RecallStrategy::Layerwise
+            ?"layerwise prefill_chunk must be a nonzero multiple of 64"
+            :"prefill_chunk must be a nonzero multiple of 128");
+}
