+        }
+        ranks.reserve(device.size());
+        for (std::size_t rank=0;rank<device.size();++rank) {
+            const auto slab=rank?limits.extra_rank_storage.at(rank-1):backing;
+            if (!slab.data || slab.bytes<rank_bytes)
+                throw std::length_error("native Query later stage lost its startup-admitted stable planes");
+            ranks.push_back({{query.bind(slab),key.bind(slab),value.bind(slab),gate.bind(slab),
+                             residual.bind(slab),cache.bind(slab),rope.bind(slab)},
+                ids.bind(slab),hidden.bind(slab),logits.bind(slab),table_row.bind(slab),origin.bind(slab)});
+        }
