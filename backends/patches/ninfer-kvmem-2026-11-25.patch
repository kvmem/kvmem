+bool ProgramImpl::prepare_memory_materialization(MaterializationTransaction& transaction) {
+    auto& staged=*requests[transaction.destination.value].prefill;
+    const auto prepare_source=[&]() -> bool {
+
+    if(!staged.memory_restore_frontier || !staged.memory_restore_generation) return true;
+    auto& pending=transaction.memory_history;
+    try {
+        if(!pending) {
+            const auto match=memory_restorable_history(staged.prompt,&materialization_prefix_digests_);
+            if(!match || match->frontier!=staged.memory_restore_frontier ||
+               memory_histories[match->history]->stamp.session.id!=staged.memory_restore_generation) {
+                staged.memory_restore_generation=0;
+                transaction.plan->impl_->memory_payload_envelope=transaction.plan->impl_->memory_payload_root_envelope;
+                return true;
+            }
+            const auto& source=*memory_histories[match->history];
+            pending=std::make_unique<KvmemHistoryPreparation>();
+            pending->history=match->history;
+            pending->generation=source.stamp.session.id;
+            pending->selected=match->kind;
+            memory_checkpoint_slot(*memory_histories[match->history], match->kind)->last_used =
+                next_history_access.fetch_add(1);
+            {
+                const auto* checkpoint=memory_checkpoint(source,match->kind);
+                for (;;) {
+                    try { pending->fork=fork_memory_history(source,*checkpoint); break; }
+                    catch (const NativeSourceQuotaExceeded& error) {
+                        if (error.account!=layerwise_source_account.get() || error.growth>layerwise_source_account->limit() ||
+                            !reclaim_idle_metadata(error.shortfall)) throw;
+                    }
+                }
+                const auto input = canonical_snapshot_input(source, state_images->host_layout().image_bytes);
+                if (!snapshot_input_matches(input, staged.prompt))
+                    pending->fork->cache_group=0;
+                memory_histories[match->history]->publication_order=next_history_access.fetch_add(1);
+            }
+            // No source reference or directory lookup may cross this boundary.
+            // The fork and its immutable checkpoint independently own the source.
+            pending->directory_borrowed=false;
+            if(kvmem_options.verify_transfers) std::fprintf(stderr,
+                "KVMEM_HISTORY_DETACH generation=%llu frontier=%u directory_borrowed=0\n",
+                (unsigned long long)pending->generation,staged.memory_restore_frontier);
+        }
+        try {
+            enforce_memory_payload_budget(0,false,true);
+        } catch(const ContextCacheExhausted&) {
+            // A directory hit is optional. Before any read/submission, compare
+            // the root plan under the same complete-history reservation instead
+            // of rejecting a request solely for the restore's copy peak.
+            if(pending->ticket || pending->work || pending->native_ready) throw;
+            // Vision suffix planning may already have released cached-prefix
+            // media. Root replay is legal only when the admitted plan still
+            // covers every original item and retains its input payload.
+            if(staged.prompt.has_media()) {
+                const auto& vision=transaction.plan->impl_->vision;
+                const auto count=staged.prompt.vision_items.size();
+                bool complete=vision && vision->uses.size()==count &&
+                    staged.prompt.media_payloads.size()==count;
+                for(std::size_t i=0;complete && i<count;++i)
+                    complete=vision->uses[i].prepared_item_index==i &&
+                        bool(staged.prompt.media_payloads[i]);
+                if(!complete) throw;
+            }
+            const auto generation=pending->generation;
+            pending.reset();
+            staged.memory_restore_generation=0;
+            transaction.plan->impl_->memory_payload_envelope=transaction.plan->impl_->memory_payload_root_envelope;
+            // Preserve the quoted frontier. start_request records it as hidden
+            // replay and reports zero actual reuse when no source was restored.
+            enforce_memory_payload_budget(0,false,true);
+            if(kvmem_options.verify_transfers) std::fprintf(stderr,
+                "KVMEM_HISTORY_ROOT_FALLBACK generation=%llu frontier=%u reason=restore_payload_peak\n",
+                (unsigned long long)generation,staged.memory_restore_frontier);
+            return true;
+        }
+        if(pending->native_ready) return true;
+        auto* history=pending->fork.get();
+        if(!history) throw std::logic_error("memory restoration lost its independently owned fork");
+        if(!memory_io || !kvmem_options.disk_bytes) return true;
+        if(pending->ticket && !pending->ticket.ready()) return false;
+        if(pending->ticket) {
+            pending->ticket.wait();
+            auto& work=*pending->work;
+            if(pending->checkpoint) {
+                auto& checkpoint=memory_checkpoint_slot(*history,*pending->checkpoint);
+                if(!checkpoint || checkpoint->state || checkpoint->state_bytes()!=work.state.size())
+                    throw std::logic_error("prepared state image changed before publication");
+                checkpoint_memory_room(*history,work.state.size());
+                auto state=memory_checkpoint_pool->acquire(work.state.size());
+                std::memcpy(state->data(),work.state.data(),work.state.size());
+                if(kvmem_options.verify_transfers) std::fprintf(stderr,
+                    "KVMEM_COVERAGE_TIER read_bytes=%zu frontier=%zu fork=%u\n",work.state.size(),checkpoint->prefix.size(),unsigned(bool(pending->fork)));
+                checkpoint->state=std::move(state);
+                checkpoint->cold_state={};
+                pending->checkpoint.reset(); pending->work.reset(); pending->ticket={};
+            } else {
+                for(size_t i=0;i<work.ids.size();++i) if(work.records[i]) {
+                    work.records[i].seal();
+                    history->archive.at(work.ids[i])=std::move(work.records[i]);
+                }
+                pending->native_ready=true;
+                return true;
+            }
+        }
+        for(const auto kind:checkpoint_kinds(*history)) {
+            if((pending->fork || history->coverage.policy().enabled) && kind!=pending->selected) continue;
+            const auto* checkpoint=memory_checkpoint(*history,kind);
+            if(!checkpoint || checkpoint->state || !checkpoint->cold_state.size()) continue;
+            if(memory_state_staging.charged_bytes()) return false;
+            pending->checkpoint=kind;
+            pending->work=std::make_shared<KvmemHistoryPreparation::Work>();
+            auto work=pending->work;
+            work->state_source=checkpoint->cold_state;
+            work->state_tag=checkpoint->cold_tag;
+            work->state_payload_bytes=checkpoint->state_bytes();
+            work->payload_inputs.emplace_back(checkpoint->cold_state.storage_identity(),checkpoint->cold_state.size());
+            memory_history_work.emplace_back(work);
+            pending->ticket=memory_io->submit(checkpoint->state_bytes(),[work,storage=memory_state_staging]() mutable {
+                work->state=storage.allocate(work->state_payload_bytes);
+                if(work->state_tag) kvmem::read_checkpoint_image(work->state_source,work->state_tag,{{work->state.writable_data(),work->state.size()}});
+                else work->state_source.read(0,work->state.writable_data(),work->state.size());
+            });
+            work->accounting_ticket=pending->ticket;
+            return false;
+        }
+        pending->work=std::make_shared<KvmemHistoryPreparation::Work>();
+        auto work=pending->work;
+        const auto& checkpoint=*memory_checkpoint(*history,pending->selected);
+        for(const auto id:checkpoint.resident_pages) {
+            work->ids.push_back(static_cast<uint32_t>(id));
+            work->sources.push_back(history->archive.at(id).source());
+            const auto& record=history->archive.at(id);
+            work->payload_inputs.emplace_back(record.storage_identity(),record.size());
+            // Deferred sources may change tier before their worker obtains a
+            // lease. Every selected page can therefore require a private read
+            // destination, even if resident at submission time.
+            work->payload_growth+=record.size();
+        }
+        work->records.resize(work->ids.size()); work->leases.resize(work->ids.size());
+        const auto stride=text_host_kv_page_stride+backend_host_kv_page_stride;
+        const auto tail=(staged.memory_restore_frontier-1)/page_tokens;
+        memory_history_work.emplace_back(work);
+        pending->ticket=memory_io->submit(work->ids.size()*stride,[work,storage=memory_payload_storage,stride,tail]() mutable {
+            for(size_t i=0;i<work->ids.size();++i) {
+                auto source=work->sources[i].lease();
+                if(source.data() && work->ids[i]!=tail) work->leases[i]=std::move(source);
+                else {
+                    auto& record=work->records[i];
+                    record=storage.allocate(stride);
+                    source.read(0,record.writable_data(),stride);
+                    record.seal();
+                    work->leases[i]=record.lease();
+                }
+            }
+            work->sources.clear();
+        });
+        work->accounting_ticket=pending->ticket;
+        return false;
+    } catch(const ContextCacheExhausted&) {
+        throw; // The materialization boundary aborts only this request.
+    } catch(const std::exception& error) {
+        std::fprintf(stderr,"KVMEM_HISTORY preparation failed; replaying prefix: %s\n",error.what());
+        pending.reset(); staged.memory_restore_generation=0;
+        transaction.plan->impl_->memory_payload_envelope=transaction.plan->impl_->memory_payload_root_envelope;
+        return true;
+    }
+    };
+    if (!prepare_source()) return false;
+    // Includes misses/fallbacks. No payload capacity decision is deferred until
+    // start_request has overwritten native state or published a new ledger.
+    enforce_memory_payload_budget(0,false,true);
+    if (kvmem_options.recall_strategy==kvmem::RecallStrategy::Layerwise) {
+        const KvmemPrefixCheckpoint* checkpoint=nullptr;
+        const auto& prepared=transaction.memory_history;
+        if (staged.memory_restore_generation && prepared) {
+            const auto* history=prepared->fork.get();
+            if (!history) throw std::logic_error("native Query lost its owned restore source");
+            checkpoint=memory_checkpoint(*history,prepared->selected);
+            if (!checkpoint || checkpoint->prefix.size()!=staged.memory_restore_frontier)
+                throw std::logic_error("native Query binding differs from its selected actual checkpoint");
+        }
+        // The selected history still owns its immutable CP here. Reserve the
+        // exact temporary mean-index/directory copy before moving that history
+        // into an active native lane. This lies outside prepare_source's
+        // optional-cache fallback catch: a hard quota is an admission refusal.
+        if (checkpoint && checkpoint->canonical_source) {
+            const auto& source=*checkpoint->canonical_source;source.validate();
+            auto& pending=*transaction.memory_history;
+            if (source.frontier!=checkpoint->prefix.size() || source.charge.account()!=layerwise_source_account)
+                throw std::logic_error("native Waiting restore source/account changed before admission");
+            const auto pages=kv_pages_for_tokens(source.frontier);
+            const auto copy_bytes=source.mean_index->allocated_bytes()+
+                std::uint64_t(pages)*(sizeof(kvmem::HostKvRecord)+sizeof(std::uint64_t));
+            const auto* work=pending.work.get();
+            if (work && work->layerwise_restore_metadata.account()) {
+                if (work->layerwise_restore_source.get()!=&source || work->layerwise_restore_epoch!=source.epoch ||
+                    work->layerwise_restore_frontier!=source.frontier || work->layerwise_restore_copy_bytes!=copy_bytes ||
+                    work->layerwise_restore_metadata.account()!=source.charge.account())
+                    throw std::logic_error("native Waiting restore admission belongs to a different immutable source");
+            } else {
+                std::uint64_t work_bytes=sizeof(KvmemHistoryPreparation::Work)+64;
+                if (work) work_bytes+=work->ids.capacity()*sizeof(std::uint32_t)+
+                    work->sources.capacity()*sizeof(kvmem::HostKvSource)+work->records.capacity()*sizeof(KvmemHostRecord)+
+                    work->leases.capacity()*sizeof(kvmem::HostKvLease)+
+                    work->payload_inputs.capacity()*sizeof(std::pair<const void*,std::uint64_t>);
+                if (copy_bytes>UINT64_MAX-work_bytes)
+                    throw ContextCacheExhausted("native Waiting restore metadata bound overflows");
+                NativeSourceVersionCharge admission;
+                for (;;) {
+                    try { admission=source.charge.account()->reserve(copy_bytes+work_bytes); break; }
+                    catch (const NativeSourceQuotaExceeded& error) {
+                        if (error.growth>layerwise_source_account->limit() || !reclaim_idle_metadata(error.shortfall))
+                            throw ContextCacheExhausted("native layerwise source metadata cannot admit the complete checkpoint restore");
+                    }
+                }
+                // The charge covers Work/control metadata before allocation.
+                if (!pending.work) pending.work=std::make_shared<KvmemHistoryPreparation::Work>();
+                auto& next=*pending.work;next.layerwise_restore_metadata=std::move(admission);
+                next.layerwise_restore_source=checkpoint->canonical_source;
+                next.layerwise_restore_epoch=source.epoch;next.layerwise_restore_frontier=source.frontier;
+                next.layerwise_restore_copy_bytes=copy_bytes;
+            }
+        }
+        bind_layerwise_request_source(staged.prompt,transaction.plan->impl_->summary.effective_output_tokens,checkpoint);
+        const KvmemWindowState* prospective=nullptr;
+        if (transaction.memory_history) {
+            prospective=transaction.memory_history->fork.get();
+        }
+        prepare_layerwise_admission(transaction,checkpoint,prospective);
+    }
+    return true;
+}
+
+bool ProgramImpl::restore_memory_history(SequenceState& sequence, RequestControl::Prefill& staged) {
+    const auto started = Clock::now();
+    auto* transaction=std::get_if<MaterializationTransaction>(&context_transaction_);
+    auto* prepared=transaction ? transaction->memory_history.get() : nullptr;
+    if(!staged.memory_restore_generation || !prepared || prepared->generation!=staged.memory_restore_generation) return false;
+    const bool fork=bool(prepared->fork);
+    const auto kind=prepared->selected;
+    const auto frontier=std::optional<uint32_t>(staged.memory_restore_frontier);
+    if(!fork || prepared->directory_borrowed)
+        throw std::logic_error("memory restore has no detached execution owner");
+    sequence.window=std::move(*prepared->fork);
+    auto& window = sequence.window;
+    const bool same_query = memory_user_already_evaluated(staged.prompt, *frontier);
+    auto checkpoint = memory_checkpoint_slot(window, kind);
+    window.execution_checkpoint = checkpoint;
+    window.coverage.touch(checkpoint.get());
+    // The previous Program address-space lease has been released. These IDs
+    // must never be treated as resident in the new native address space.
+    window.pages.clear();
+    window.removed_tokens = 0;
+    window.reconstruction_frontier = 0;
+    window.query_replayed = same_query;
+    window.query_capture = false;
+    window.query_replay_active = false;
+    window.query_selected.clear();window.query_required.clear();
+    const auto query = memory_query_span(staged.prompt);
+    window.query_begin = static_cast<std::uint32_t>(query.begin);
+    window.query_end = static_cast<std::uint32_t>(query.begin + query.count);
+    // Query features are request-local seeds. The verified input prefix alone
+    // determines continuation; never retain features from a discarded suffix.
+    window.query_tokens = 0;
+    for(auto& rows:window.query_rows) rows.clear();
+    window.query_sums.clear();
+    // The durable archive already covers the quoted prefix. This is not a
+    // native allocation frontier; force-selection creates only B resident rows.
+    sequence.text_kv_valid = *frontier;
+    if (backend_kv_pages) sequence.mtp_kv_valid = *frontier;
+    auto* materialization = std::get_if<MaterializationTransaction>(&context_transaction_);
+    const bool resident_native = materialization && materialization->memory_history &&
+        materialization->memory_history->native_ready;
+    if (kvmem_options.recall_strategy==kvmem::RecallStrategy::Layerwise) {
+        if (!prepared->work || !prepared->work->layerwise_restore_metadata.account())
+            throw std::logic_error("native materialization has no complete Waiting restore admission");
+        restore_memory_prefix(sequence,*checkpoint,true,false,resident_native,prepared->work.get());
+    } else restore_memory_prefix(sequence, *checkpoint, true, false, resident_native);
+    if (resident_native && kvmem_options.recall_strategy!=kvmem::RecallStrategy::Layerwise)
+        materialization->memory_history.reset();
+
+    // A pre-Query checkpoint already owns an uncommitted round whose scores
+    // are the preceding committed history. Reuse it when editing that Query.
+    // Starting again would count the same discarded Query in the round number.
+    const auto restored_history=window.selector->retrieval_checkpoint();
+    if (!restored_history.round || restored_history.committed)
+        window.selector->begin_retrieval_round();
+    if (backend_kv_pages && kvmem_options.recall_strategy!=kvmem::RecallStrategy::Layerwise) {
+        // An MTP row combines target hidden at i with the embedding of token i+1.
+        // Prefix identity proves only [0,frontier), so its last MTP row must be
+        // rebuilt using this request's first suffix token before it is trusted.
+        const auto last = *frontier - 1U;
+        sequence.mtp_kv_valid = last;
+        trim_sequence_kv(sequence, *frontier, last);
+        ensure_sequence_kv_mapped(sequence, *frontier, *frontier);
+        const auto selectors = state_selectors(sequence);
+        execution::PrefillContext bridge{
+            {device, parameters, work, state_images->linear(0),
+             replay_records ? &*replay_records : nullptr, io, prefill_hidden, prefill_chunk,
+             proposal_head, stage_runtime.get(), rope_yarn, fast_prefill_kernel,
+             mtp_attention_window},
+            text_kv_view(sequence), mtp_kv_view(sequence), decoder->text_kv,
+            decoder->mtp_cache(), nullptr, *frontier, nullptr, nullptr,
+            selectors.source, selectors.destination, 0, 0};
+        bridge.cache_position_shift = window.removed_tokens;
+        set_device_i32(io.rope_delta, sequence.rope_delta +
+            checked_i32(window.removed_tokens, "restored MTP cache shift"));
+        auto token = io.mtp->target_input_ids.slice(0, 0, 1);
+        set_device_i32(token, staged.prompt.token_ids[*frontier]);
+        const auto tokens = staged.prompt.token_ids.size();
+        const std::array<std::int32_t, 3> rope{
+            staged.prompt.positions.at(last), staged.prompt.positions.at(tokens + last),
+            staged.prompt.positions.at(2 * tokens + last)};
+        mark_workspace_usage(workspace_plan.mtp_prefill);
+        if (staged.vision) {
+            execution::mtp_bridge_multimodal(bridge, staged.prompt, *staged.vision,
+                {.previous_hidden = &sequence.tail_hidden,
+                 .position = checked_i32(last, "restored MTP tail"), .rope_position = rope});
+        } else {
+            execution::mtp_bridge_and_propose(bridge, token, sequence.tail_hidden,
+                checked_i32(last, "restored MTP tail"), rope, false);
+        }
+        device.synchronize();
+        work.reset();
+        sequence.mtp_kv_valid = *frontier;
+        commit_sequence_kv(sequence, *frontier, *frontier);
+        window.host_versions.at(last / page_tokens) = 0;
+        // Same-boundary query replay can restore before another view switch.
+        archive_memory_window(sequence);
+    }
+    window.query_probe_swaps=window.swaps;
+    if (*frontier == memory_checkpoint_frontier(sequence, staged.prompt_tokens, true) &&
+        (memory_query_probe(sequence, staged.prompt_tokens) || !memory_input_reuse_frontier(staged.prompt)))
+        publish_memory_checkpoint_source(window, std::move(checkpoint), memory_query_probe(sequence, staged.prompt_tokens));
+    else
+        // An exact replay can start at the input capture boundary, so prefill
+        // will not cross it again. Keep the restored complete state for repeats
+        // and cancellation recovery; restoring does not consume its payload.
+        memory_checkpoint_slot(window, kind) = std::move(checkpoint);
+    // The ordinary restore source has served its last native/MTP read. Keep
+    // its directory alias for reuse, but do not protect its old partial tail
+    // while capturing a different Query source later in this prefill.
+    // Native layerwise's Query owner retains its selected source explicitly.
+    if (kvmem_options.recall_strategy!=kvmem::RecallStrategy::Layerwise &&
+        !(memory_query_probe(sequence,staged.prompt_tokens) && *frontier==window.query_begin))
+        window.execution_checkpoint.reset();
+    staged.base = *frontier;
+    staged.cursor = *frontier;
+    ++memory_history_hits;
+    if (kvmem_options.verify_transfers) {
+        std::fprintf(stderr, "KVMEM_HISTORY_RESTORE frontier=%u kind=%u same_query=%u prefix_match=1 state_exact=1 restore_ms=%.3f fork=%u\n",
+            *frontier, static_cast<unsigned>(kind), same_query ? 1U : 0U,
+            std::chrono::duration<double, std::milli>(Clock::now() - started).count(),unsigned(fork));
+    }
+    return true;
+}
+
+void ProgramImpl::reserve_memory_history(SequenceState& sequence, RequestControl& request,
+                                         uint64_t additional, bool optional) {
+    if(!sequence.window.cache_group) sequence.window.cache_group=next_snapshot_group.fetch_add(1);
+    if (!sequence.window.statistics) ++memory_history_misses;
+    (void)request;
+    enforce_memory_payload_budget(additional,optional,false,&sequence);
+}
+
+KvmemPayloadBudget ProgramImpl::required_memory_payload(uint64_t additional,
+        const SequenceState* owner, bool include_optional) const {
+    KvmemPayloadBudget required;
+    if (!owner) required.reserve(additional);
+    std::vector<std::uint64_t> credits;
+    credits.reserve(requests.size());
+    for (const auto& active : requests) {
+        required.reserve(active.memory_payload_envelope);
+        credits.push_back(active.memory_payload_envelope);
+    }
+    const auto* transaction=std::get_if<MaterializationTransaction>(&context_transaction_);
+    const auto* pending=transaction ? transaction->memory_history.get() : nullptr;
+    if (transaction) {
+        const auto installed=requests[transaction->destination.value].memory_payload_envelope;
+        const auto quoted=transaction->plan->impl_->memory_payload_envelope;
+        if (quoted>installed) required.reserve(quoted-installed);
+        credits[transaction->destination.value]=std::max(installed,quoted);
+    }
+    // Establish all primary archive credits before charging immutable private
+    // versions. Preparation owns the same full-history credit as its destination.
+    for (const auto& lane : continuation_states) if (lane.window.statistics)
+        for (const auto& record : lane.window.archive) if (record)
+            required.require(record.storage_identity(),record.size(),credits.at(lane.lane));
+    if (pending && pending->fork && pending->fork->statistics)
+        for (const auto& record:pending->fork->archive) if(record)
+            required.require(record.storage_identity(),record.size(),credits.at(transaction->destination.value));
+    const auto checkpoint_payload=[&](const KvmemPrefixCheckpoint& cp, std::uint64_t& credit) {
+        account_kvmem_checkpoint_payload(cp,[&](const void* id,size_t bytes) {required.require(id,bytes,credit);});
+        if(cp.cold_state) required.require(cp.cold_state.storage_identity(),cp.cold_state.size(),credit);
+    };
+    for (const auto& lane : continuation_states) if (lane.window.statistics) {
+        auto& credit=credits.at(lane.lane);
+        if (lane.window.execution_checkpoint) checkpoint_payload(*lane.window.execution_checkpoint,credit);
+        required.reserve(lane.window.execution_auxiliary_bytes,credit);
+        if (const auto& append=lane.window.pending_append) {
+            if (!append->ticket.ready())
+                required.reserve(append->work->ids.size()*(text_host_kv_page_stride+backend_host_kv_page_stride),credit);
+            else for (const auto& record:append->work->records) if (record)
+                required.require(record.storage_identity(),record.size(),credit);
+        }
+        required.reserve(lane.window.pending_window_payload_growth,credit);
+        if (include_optional) visit_memory_checkpoints(lane.window,[&](const auto& cp) {checkpoint_payload(cp,credit);});
+    }
+    if(pending && pending->fork && pending->fork->statistics)
+        visit_memory_checkpoints(*pending->fork,[&](const auto& cp) {checkpoint_payload(cp,credits.at(transaction->destination.value));});
+    std::uint64_t no_credit=0;
+    if(memory_coverage_transfer) checkpoint_payload(*memory_coverage_transfer->checkpoint,no_credit);
+    if(memory_idle_transfer)
+        required.require(memory_idle_transfer->work->destination.storage_identity(),memory_idle_transfer->work->destination.size());
+
+    // The engine reads only immutable quotes while workers are running. The
+    // physical storage account keeps the same bytes charged after cancellation;
+    // this weak registry keeps the admission ledger aware until the read drains.
+    const auto work_payload=[&](const KvmemHistoryPreparation::Work& work, std::uint64_t& credit) {
+        for(const auto& [id,bytes]:work.payload_inputs) required.require(id,bytes,credit);
+        if(work.accounting_ticket && !work.accounting_ticket.ready()) {
+            required.reserve(work.payload_growth,credit);
+        } else {
+            for(const auto& record:work.records) if(record)
+                required.require(record.storage_identity(),record.size(),credit);
+        }
+    };
+    for(const auto& weak:memory_history_work) {
+        const auto work=weak.lock();
+        if(work && !(work->accounting_ticket && work->accounting_ticket.ready()) &&
+           (!pending || work!=pending->work)) work_payload(*work,no_credit);
+    }
+    if(pending && pending->work) work_payload(*pending->work,credits.at(transaction->destination.value));
+    // Reserve transient restore copies before the first I/O submission/native
+    // mutation. Once submitted, Work owns either its growth quote or its ready
+    // records until publication; do not charge the same copy a second time.
+    if(pending && pending->fork && pending->fork->statistics && !pending->native_ready &&
+       !(pending->work && pending->work->accounting_ticket &&
+         pending->work->payload_growth)) {
+        const auto* cp=memory_checkpoint(*pending->fork,pending->selected);
+        if(!cp || cp->prefix.empty()) throw std::logic_error("restore budget has no selected checkpoint");
+        const auto tail=(cp->prefix.size()-1)/page_tokens;
+        for(const auto page:cp->resident_pages) {
+            const auto& record=pending->fork->archive.at(page);
+            if((memory_io && kvmem_options.disk_bytes) || page==tail || !record.resident_bytes())
+                required.reserve(record.size(),credits.at(transaction->destination.value));
+        }
+    }
+    if (owner) required.reserve(additional,credits.at(owner->lane));
+    return required;
+}
+
+bool ProgramImpl::reclaim_optional_memory_checkpoints() {
+    bool changed=false;
+    for (auto& lane:continuation_states) {
+        auto& window=lane.window;
+        if (!window.statistics) continue;
+        const auto* required=window.execution_checkpoint.get();
+        for (auto& slot:window.checkpoints) if (slot.data && slot.data.get()!=required) {
+            slot.data.reset();changed=true;
+        }
+        for (auto& entry:window.coverage) if (entry.record.data && entry.record.data.get()!=required) {
+            entry={};changed=true;
+        }
+    }
+    if (changed && kvmem_options.verify_transfers)
+        std::fprintf(stderr,"KVMEM_CHECKPOINT_EVICT reason=payload_pressure scope=optional_active\n");
+    return changed;
+}
+
+void ProgramImpl::enforce_memory_payload_budget(uint64_t additional, bool optional, bool admission,
+                                               const SequenceState* owner) {
+    if(!kvmem_window_tokens) return;
+    auto required=required_memory_payload(additional,owner);
+    const auto denied=[&]() {
+        if(optional) throw std::runtime_error("optional snapshot exceeds retained payload budget");
+        if(admission) throw ContextCacheExhausted("KVMem required execution payload exceeds the retained budget");
+        // Active KVMem steps already have a request-local storage failure/drain
+        // path. Do not send expected capacity pressure to the invariant handler.
+        throw kvmem::MemoryError(kvmem::MemoryErrorCode::BudgetExceeded,
+                                "KVMem required execution payload exceeds the retained budget");
+    };
+    if(!required.fits(memory_retained_budget)) {
+        if (!optional && reclaim_optional_memory_checkpoints()) required=required_memory_payload(additional,owner);
+        if(!required.fits(memory_retained_budget)) denied();
+    }
+    for (;;) {
+        auto total=required;
+        std::vector<kvmem::ContentCacheSlot> slots;
+        for (std::size_t index = 0; index < memory_histories.size(); ++index) {
+            const auto& history = memory_histories[index];
+            slots.push_back({bool(history),history && retained_history_pinned(index),
+                history ? history->publication_order : 0,
+                history ? static_cast<const void*>(&*history) : nullptr,history ? history->cache_group : 0});
+            if (!history) continue;
+            for(const auto& record:history->archive)
+                if(record) total.require(record.storage_identity(),record.size());
+            visit_memory_checkpoints(*history,[&](const KvmemPrefixCheckpoint& cp) {
+                account_kvmem_checkpoint_payload(cp,[&](const void* id,size_t bytes) {total.require(id,bytes);});
+                if(cp.cold_state) total.require(cp.cold_state.storage_identity(),cp.cold_state.size());
+            });
+        }
+        if(total.fits(memory_retained_budget)) break;
+        if (optional) throw std::runtime_error("optional snapshot exceeds retained payload budget");
+        const auto victim=kvmem::select_content_eviction(slots);
+        if(!victim) denied();
+        const auto generation=memory_histories[*victim]->stamp.session.id;
+        const auto physical_before=memory_payload_storage.charged_bytes();
+        memory_histories[*victim].reset();
+        ++memory_history_evictions;
+        if(kvmem_options.verify_transfers) std::fprintf(stderr,
+            "KVMEM_HISTORY_EVICT generation=%llu required_bytes=%llu total_before=%llu budget=%llu physical_before=%llu physical_after=%llu\n",
+            (unsigned long long)generation,(unsigned long long)required.used(),(unsigned long long)total.used(),
+            (unsigned long long)memory_retained_budget,(unsigned long long)physical_before,
+            (unsigned long long)memory_payload_storage.charged_bytes());
+    }
+}
+
+bool ProgramImpl::admit_retained_history(std::uint32_t frontier) noexcept {
+    memory_cache_candidate_tokens = frontier;
+    if (kvmem::admit_content_history(frontier, kvmem_options.cache_min_tokens)) return true;
+    ++memory_cache_below_minimum;
+    if (kvmem_options.verify_transfers) std::fprintf(stderr,
+        "KVMEM_SNAPSHOT_SKIP reason=below_min_tokens candidate_tokens=%u minimum_tokens=%u\n",
+        frontier, kvmem_options.cache_min_tokens);
+    return false;
+}
+
+void ProgramImpl::retain_memory_history(SequenceState& sequence, const RequestControl& request,
+                                       bool completed) noexcept {
+    // A cancelled request can retain an earlier complete checkpoint, but cannot
+    // move a transaction whose backend still addresses the active sequence.
+    sequence.window.pending_window.reset();
+    sequence.window.pending_append.reset();
+    if (sequence.window.layerwise_request) {
+        try {sequence.window.layerwise_request->retire();}
+        catch (...) {sequence.window.layerwise_request->abort();}
+        sequence.window.layerwise_request.reset();
+    }
+    if (sequence.window.layerwise_rewrite_pending || !kvmem_window_tokens || !request.allow_memory_reuse || !sequence.window.stamp.valid) return;
+    auto& window = sequence.window;
+    if (!window.update_session_index) return;
+    // The endpoint capture may have been skipped solely because this complete
+    // accepted state is short. Report its actual logical boundary once, before
+    // pruning or allocating any optional retention metadata. Cancellation uses
+    // the surviving checkpoint frontier below, never pending execution rows.
+    if (completed && request.lifecycle == Lifecycle::Finishable &&
+        sequence.text_kv_valid == sequence.execution_frontier && sequence.tail_hidden_valid &&
+        !sequence.state.fork_pending && (!backend_kv_pages || sequence.mtp_kv_valid == sequence.execution_frontier) &&
+        !kvmem::admit_content_history(sequence.execution_frontier, kvmem_options.cache_min_tokens)) {
+        (void)admit_retained_history(sequence.execution_frontier);
+        return;
+    }
+    if (window.checkpoints.empty() && window.coverage.size()==0) return;
+    window.query_tokens=0;
+    window.query_capture=false;
+    for(auto& rows:window.query_rows) std::vector<float>().swap(rows);
+    std::vector<float>().swap(window.query_sums);
+    // Only the successful finish caller releases execution protection. Neither
+    // query_replayed (set at rewind start) nor a late cancellation of a Finishable
+    // request is proof that this is the successful publication path.
+    if (completed && request.lifecycle == Lifecycle::Finishable &&
+        !window.coverage.policy().extra_recompute_tokens &&
+        memory_checkpoint(window, KvmemCheckpointKind::PromptTail)) {
+        // T=0 preserves the previous single-Base retention footprint after the
+        // temporary overlap needed to protect a currently executing replay.
+        memory_checkpoint_slot(window, KvmemCheckpointKind::Base).reset();
+    }
+    if (completed && request.lifecycle == Lifecycle::Finishable && window.coverage.policy().extra_recompute_tokens) {
+        try { prune_completed_memory_checkpoints(sequence); }
+        catch (const std::exception& error) {
+            std::fprintf(stderr, "KVMEM_CHECKPOINT_PRUNE skipped: %s\n", error.what());
+        }
+    }
+    if(window.coverage.policy().enabled) {
+      try {
+        std::shared_ptr<KvmemPrefixCheckpoint> input;
+        if (window.coverage.policy().extra_recompute_tokens ||
+            memory_checkpoint(window, KvmemCheckpointKind::InputReuse)) {
+            for (const auto kind : checkpoint_kinds(window)) {
+                const auto& cp = memory_checkpoint_slot(window, kind);
+                if (!cp || cp->prefix.size() >= window.output_begin ||
+                    (input && cp->prefix.size() <= input->prefix.size()) ||
+                    (cp->prefix.size() > window.query_begin && cp->prefix.size() < window.query_end) ||
+                    !complete_memory_checkpoint(sequence, *cp)) continue;
+                input = cp;
+            }
+            // Input-side reuse and append endpoints have distinct legal restore
+            // limits. Prefer both under ordinary budgets; tiny budgets may evict.
+            if (input) window.coverage.remember({kvmem::CheckpointPurpose::None, input}, kvmem::CoveragePurpose::Input);
+        }
+        // Reverse equal-frontier priority: the native Endpoint is published last.
+        for(auto it=kKvmemCheckpointKinds.rbegin();it!=kKvmemCheckpointKinds.rend();++it) {
+            const auto& cp=memory_checkpoint_slot(window,*it);
+            if(cp) window.coverage.remember({kvmem::CheckpointPurpose::None,cp},
+                *it==KvmemCheckpointKind::Endpoint ? kvmem::CoveragePurpose::Endpoint :
+                *it==KvmemCheckpointKind::ReuseAnchor ? kvmem::CoveragePurpose::Anchor :
+                cp==input ? kvmem::CoveragePurpose::Input : kvmem::CoveragePurpose::Periodic);
+        }
+        window.checkpoints.clear();
+        window.coverage.prune();
+      } catch(const std::exception& error) {
+        // Retention is optional; never terminate a completed request if a
+        // directory allocation fails. The active owner keeps its valid state.
+        std::fprintf(stderr,"KVMEM_COVERAGE retention skipped: %s\n",error.what());
+        return;
+      }
+    }
+    std::uint32_t frontier = 0;
+    for (const auto kind : checkpoint_kinds(window))
+        if (const auto* checkpoint = memory_checkpoint(window, kind))
+            frontier = std::max(frontier, static_cast<std::uint32_t>(checkpoint->prefix.size()));
+    if (!admit_retained_history(frontier)) return;
+    const auto pages = kv_pages_for_tokens(frontier);
+    if (!pages || pages > window.archive.size() || pages > window.host_versions.size() ||
+        !window.archive.front()) return;
+    const auto page_bytes = window.archive.front().size();
+    // Trim the latest active archive; each checkpoint owns its exact manifest.
+    // Uncommitted/cancelled rows past that frontier are never retained.
+    window.archive.resize(pages);
+    window.host_versions.resize(pages);
+    window.payload_bytes = pages * page_bytes;
+    try {
+    // Recheck at publication: two independent requests can prepare from the
+    // same old ancestor before either branch publishes. Only groups whose
+    // complete canonical inputs all lie on one exact path may be inherited.
+    const auto input = canonical_snapshot_input(window, state_images->host_layout().image_bytes);
+    window.cache_group = snapshot_content_group(input, window.cache_group, memory_histories,
+                                                state_images->host_layout().image_bytes);
+    if (kvmem_options.verify_transfers) std::fprintf(stderr,
+        "KVMEM_SNAPSHOT_GROUP canonical=%zu accepted=%zu group=%llu\n", input.frontier,
+        input ? input.checkpoint->prefix.size() : 0, (unsigned long long)window.cache_group);
+    const auto origins=[&](const KvmemWindowState& owner) {
+        std::vector<uint64_t> result;
+        for(const auto kind:checkpoint_kinds(owner))
+            if(const auto* cp=memory_checkpoint(owner,kind)) result.push_back(cp->immutable_origin);
+        return result;
+    };
+    const auto incoming_origins=origins(window);
+    std::vector<kvmem::ContentCacheSlot> slots;
+    std::vector<size_t> superseded;
+    slots.reserve(memory_histories.size());
+    for (size_t index=0;index<memory_histories.size();++index) {
+        const auto& history=memory_histories[index];
+        const bool pinned=history && retained_history_pinned(index);
+        bool covered=history && !pinned && kvmem::content_snapshot_covers(incoming_origins,origins(*history));
+        // State-origin numbers alone do not prove KV. Compaction additionally
+        // requires the same strongly owned immutable manifest for every source.
+        if (covered) visit_memory_checkpoints(*history, [&](const KvmemPrefixCheckpoint& old) {
+            bool found = false;
+            visit_memory_checkpoints(window, [&](const KvmemPrefixCheckpoint& next) {
+                found |= old.immutable_origin == next.immutable_origin && same_kvmem_checkpoint_payload(old,next);
+            });
+            covered &= found;
+        });
+        if(covered) superseded.push_back(index);
+        slots.push_back({bool(history) && !covered, pinned, history ? history->publication_order : 0,
+                         history ? static_cast<const void*>(&*history) : nullptr,
+                         history ? history->cache_group : 0});
+    }
+    const auto destination=kvmem::plan_content_group_publication(slots,
+        layerwise_source_account ? memory_histories.size() : std::min<size_t>(memory_histories.size(),kvmem_options.retained_sessions),
+        kvmem_options.retained_sessions,window.cache_group);
+    if (!destination) {
+        if(kvmem_options.verify_transfers) std::fprintf(stderr,"KVMEM_SNAPSHOT_PUBLISH admitted=0 reason=%u\n",unsigned(destination.reason));
+        return;
+    }
+    if(memory_histories[*destination] && slots[*destination].occupied) {
+        ++memory_history_evictions; ++memory_history_retention_evictions;
+    }
+    // Capture already completed every Host copy. The active state's later
+    // writes and unpublished output never become this checkpoint's contents.
+    for (auto& record : window.archive) record.seal();
+    if(window.coverage.policy().enabled && kvmem_options.verify_transfers) {
+        std::vector<const KvmemPrefixCheckpoint*> seen;
+        for(const auto kind:checkpoint_kinds(window)) if(const auto* cp=memory_checkpoint(window,kind);
+                cp && std::find(seen.begin(),seen.end(),cp)==seen.end()) {
+            seen.push_back(cp);
+            std::fprintf(stderr,"KVMEM_CHECKPOINT_DIRECTORY frontier=%zu cold=%d bytes=%llu identity=%p\n",
+                cp->prefix.size(),int(!cp->state),(unsigned long long)(cp->state_bytes()+cp->metadata_bytes()),(const void*)cp);
+        }
+    }
+    window.publication_order=next_history_access.fetch_add(1);
+    memory_histories[*destination].emplace(std::move(window));
+    for(const auto index:superseded) if(index!=*destination) memory_histories[index].reset();
+    for(const auto index:destination.retired_slots) if(index!=*destination && memory_histories[index]) {
+        memory_histories[index].reset(); ++memory_history_evictions; ++memory_history_retention_evictions;
+    }
+    if(kvmem_options.verify_transfers) std::fprintf(stderr,"KVMEM_SNAPSHOT_PUBLISH admitted=1 reason=%u slot=%zu group=%llu\n",
+        unsigned(destination.reason),*destination,(unsigned long long)memory_histories[*destination]->cache_group);
+    if (layerwise_source_account && memory_io && memory_payload_storage.spill_file())
+        memory_idle_requested = true; // Demote the oldest excess hot point in the existing idle writer.
+    else if (layerwise_source_account) trim_hot_checkpoints();
+    else if (memory_io && memory_payload_storage.disk_bytes()) memory_idle_requested = true;
+    } catch(const std::exception& error) {
+        std::fprintf(stderr,"KVMEM_SNAPSHOT_PUBLISH admitted=0 reason=allocation_failed error=%s\n",error.what());
+    }
+
+}
+
+bool ProgramImpl::memory_maintenance_pending() const noexcept {
+    return memory_io && (memory_idle_requested || memory_idle_transfer || memory_coverage_transfer ||
+                         !memory_history_work.empty());
+}
+
+bool ProgramImpl::progress_memory_storage() {
+    if (!memory_maintenance_pending()) return false;
+    bool changed = false;
+    // Ready includes release of the worker's captured owners. Report this
+    // capacity change so Waiting requests blocked on cancelled reads retry.
+    for(auto it=memory_history_work.begin();it!=memory_history_work.end();) {
+        const auto work=it->lock();
+        if(!work || (work->accounting_ticket && work->accounting_ticket.ready())) {
+            it=memory_history_work.erase(it); changed=true;
+        } else ++it;
+    }
+    if(memory_coverage_transfer) {
+        progress_checkpoint_coverage(continuation_states.front().window);
+        if(memory_coverage_transfer) return changed;
+        changed = true;
+    }
+    const auto being_restored = [&](std::uint64_t generation) {
+        return borrowed_memory_history()==generation;
+    };
+    if (memory_idle_transfer) {
+        if (!memory_idle_transfer->ticket.ready()) return changed;
+        auto completed = std::move(memory_idle_transfer);
+        auto& pending = *completed;
+        try {
+            pending.ticket.wait();
+            auto& history = memory_histories.at(pending.history);
+            if (history && history->stamp.session.id == pending.generation && !being_restored(pending.generation)) {
+                auto& checkpoint = memory_checkpoint_slot(*history, pending.kind);
+                // Reads and publication can change LRU while the asynchronous write is in flight.
+                const bool eligible = !layerwise_source_account || (checkpoint &&
+                    oldest_retained_checkpoint(kvmem_options.checkpoint_target) == checkpoint->immutable_origin);
+                if (eligible && checkpoint && checkpoint->state == pending.source && !checkpoint->cold_state.size()) {
+                    if (layerwise_source_account) ++count_demotions;
+                    // Fork metadata has its own lifetime, but an immutable native
+                    // image gets one SSD extent even when several owners retain it.
+                    for(auto& owner:memory_histories) if(owner && !being_restored(owner->stamp.session.id))
+                        for(const auto kind:checkpoint_kinds(*owner)) {
+                            auto& alias=memory_checkpoint_slot(*owner,kind);
+                            if(!alias || alias->state!=pending.source || alias->cold_state) continue;
+                            alias->cold_tag=pending.work->tag;
+                            alias->cold_payload_bytes=pending.source->size();
+                            alias->cold_state=pending.work->destination;
+                            alias->state.reset();
+                        }
+                }
+            }
+        } catch (const std::exception& error) {
+            std::fprintf(stderr, "KVMEM_IDLE state spill retained RAM: %s\n", error.what());
+            memory_idle_requested = false; // retry on a subsequent retention boundary
+        }
+        completed.reset(); // release the writer's pinned image on the engine thread
+        if (layerwise_source_account && !memory_idle_requested) trim_hot_checkpoints();
+        changed = true;
+    }
+    if (!memory_idle_requested || has_context_transaction()) return changed;
+    memory_idle_requested = false;
+    const auto disk = memory_payload_storage.spill_file();
+    const auto victim = layerwise_source_account ? oldest_retained_checkpoint(kvmem_options.checkpoint_target) :
+        std::optional<std::uint64_t>{};
+    if (layerwise_source_account && !victim) return changed;
+    auto payload_budget=required_memory_payload();
+    for (const auto& history : memory_histories) {
+        if (!history) continue;
+        for(const auto& record:history->archive)
+            if(record) payload_budget.require(record.storage_identity(),record.size());
+        visit_memory_checkpoints(*history,[&](const auto& checkpoint) {
+            account_kvmem_checkpoint_payload(checkpoint,[&](const void* identity,size_t bytes) {
+                payload_budget.require(identity,bytes);
+            });
+            if(checkpoint.cold_state)
+                payload_budget.require(checkpoint.cold_state.storage_identity(),checkpoint.cold_state.size());
+        });
+    }
+    const auto used=payload_budget.used();
+    // One background image at a time. Its original pinned owner is retained,
+    // so there is no second full state-image allocation and no worker CUDA call.
+    for (std::size_t index = 0; index < memory_histories.size(); ++index) {
+        const auto& history = memory_histories[index];
+        if (!history) continue;
+        for (const auto kind : checkpoint_kinds(*history)) {
+            const auto* checkpoint = memory_checkpoint(*history, kind);
+            if (!checkpoint || !checkpoint->state || checkpoint->cold_state.size() ||
+                (victim && checkpoint->immutable_origin != *victim)) continue;
+            const auto bytes = checkpoint->state->size();
+            const auto disk_bytes = history->coverage.policy().enabled ? kvmem::checkpoint_image_size(bytes,1) : bytes;
+            if (used > memory_retained_budget || disk_bytes > memory_retained_budget - used ||
+                disk_bytes > disk->capacity_bytes() - disk->charged_bytes()) continue;
+            try {
+                auto pending = std::make_unique<KvmemIdleTransfer>();
+                pending->history = index;
+                pending->generation = history->stamp.session.id;
+                pending->kind = kind;
+                pending->source = checkpoint->state;
+                pending->work = std::make_shared<KvmemIdleTransfer::Work>();
+                pending->work->destination = disk->reserve(disk_bytes);
+                pending->work->data = pending->source->data();
+                pending->work->bytes = bytes;
+                pending->work->tag = history->coverage.policy().enabled ? uint64_t(reinterpret_cast<uintptr_t>(checkpoint)) : 0;
+                pending->ticket = memory_io->submit(bytes, [work = pending->work] {
+                    if(work->tag) kvmem::write_checkpoint_image(work->destination,work->tag,{{work->data,work->bytes}});
+                    else work->destination.write(0, work->data, work->bytes);
+                });
+                memory_idle_transfer = std::move(pending);
+                memory_idle_requested = true;
+                return true;
+            } catch (const std::exception& error) {
+                std::fprintf(stderr, "KVMEM_IDLE state spill retained RAM: %s\n", error.what());
+                if (layerwise_source_account) trim_hot_checkpoints();
+                return changed;
+            }
+        }
+    }
+    // No SSD or retained-payload room for the selected victim. Keep the hot
+    // bound effective even when an optional spill cannot be admitted.
+    if (layerwise_source_account) trim_hot_checkpoints();
+    return changed;
+}
+
+} // namespace ninfer::models::qwen3_5::detail
diff --git a/src/models/qwen3_5/program/storage/layerwise_admission.h b/src/models/qwen3_5/program/storage/layerwise_admission.h
new file mode 100644
index 0000000000000000000000000000000000000000..b5099852324a70092ce8ee4b482e110a30f9a1fd
