+std::size_t prompt_fp8_wide_workspace(int width, std::uint32_t max_visible) {
+    const char* setting = std::getenv("NINFER_PREFILL_FP8_WIDE_KV");
+    const char* feedback = std::getenv("NINFER_PREFILL_PAGE_LSE_REUSE");
+    if ((feedback && std::strcmp(feedback,"1")) || !setting || std::strcmp(setting,"1") || width < 128 || max_visible > 65536 ||
+        current_device_volta() ||
+        shape_max_shared_bytes_per_block(turing_shapes_here()) < kCausalPromptSmemBytes) return 0;
+    const std::size_t stride = (std::size_t(max_visible)+63)/64*64;
+    return stride * 4 * 256 * 2 * sizeof(__half);
+}
+
+bool try_prompt_fp8_page_lse(const Tensor& q, const Tensor& k, const Tensor& v,
+    const Tensor& positions, const Tensor& table_rows, float scale, PagedKVBatchLayerView cache,
+    std::uint32_t max_visible, WorkspaceArena& workspace, Tensor& out, cudaStream_t stream, PromptPageLse& capture) {
+    // Volta owns a separate prompt implementation. Every other supported tier
+    // uses this FP8 kernel, with Turing's smaller shared-memory shape selected below.
+    if (current_device_volta()) return false;
+    PromptPageLseTile tile;
+    if (!prepare_prompt_page_lse_tile(q, cache, max_visible, capture, tile, stream)) return false;
+    using Metadata=PagedKVBatchMetadata<false>;
+    const Metadata meta{.tables=static_cast<const int*>(cache.block_tables.data),
+        .valid_columns=nullptr, .table_rows=static_cast<const int*>(table_rows.data),
+        .table_stride=cache.block_tables.ne[0]};
+    kv_cache_append_batch_launch(k,v,positions,Tensor{},table_rows,cache,stream);
+    if (const auto bytes = prompt_fp8_wide_workspace(q.ne[2],max_visible)) {
+        auto scope = workspace.scope();
+        auto buffer = workspace.alloc_bytes(bytes);
+        const int width = q.ne[2], stride = (max_visible+63)/64*64;
+        auto* wide_keys = static_cast<__nv_bfloat16*>(buffer.data);
+        auto* wide_values = reinterpret_cast<__half*>(wide_keys + size_t(stride)*4*256);
+        widen_prompt_fp8_kv<<<dim3((stride+7)/8,4),256,0,stream>>>(
+            static_cast<const std::uint8_t*>(cache.k_pages.data),static_cast<const std::uint8_t*>(cache.v_pages.data),
+            static_cast<const __half*>(cache.k_scale_pages.data),static_cast<const __half*>(cache.v_scale_pages.data),
+            meta.tables,meta.table_rows,meta.table_stride,static_cast<const int*>(positions.data),width,stride,wide_keys,wide_values);
+        constexpr int shared_bytes = kCausalPromptSmemBytes;
+        raise_dynamic_shared_memory(wide_prompt_fp8_page_attention, shared_bytes);
+        const dim3 grid(div_up(width, kCausalPromptBr), 24);
+        wide_prompt_fp8_page_attention<<<grid, kCausalPromptThreads, shared_bytes, stream>>>(
+            static_cast<const __nv_bfloat16*>(q.data), wide_keys, wide_values, stride,
+            static_cast<const int*>(positions.data), width, scale,
+            static_cast<__nv_bfloat16*>(out.data), tile);
+        CUDA_CHECK(cudaGetLastError());
+        return true;
+    }
+    with_shape_set([&]<bool TuringShapes>() {
+        using Shape = CausalPromptFp8Shape<TuringShapes>;
+        const auto kernel = causal_attention_prompt_fp8_kernel<
+            CausalD256H24Kv4, Metadata, TuringShapes, PromptPageLseTile>;
