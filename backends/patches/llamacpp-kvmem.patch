+template <int rows, int width>
+static __device__ __forceinline__ float gdn_delta_f32(
+        const float (&state)[rows], const float (&key)[rows], float decay, float value, float beta) {
+    float partial = 0.0f;
+#pragma unroll
+    for (int r = 0; r < rows; ++r) {
+        partial += state[r] * key[r];
