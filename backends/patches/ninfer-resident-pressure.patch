+    std::span<const DeviceKVPageHandle> destination, std::span<const std::size_t> selected,
+    RankStreams streams) const {
+    if (source.empty() || source.size()!=destination.size() || selected.empty())
+        throw std::invalid_argument("native plane run has inconsistent extents");
+    const auto from=physical_index(source.front()),to=physical_index(destination.front());
+    for (std::size_t i=0;i<source.size();++i)
+        if (physical_index(source[i])!=std::int64_t(from)+i ||
+            physical_index(destination[i])!=std::int64_t(to)+i)
+            throw std::logic_error("native plane run is not physically consecutive");
+    if (from!=to && std::uint64_t(std::abs(std::int64_t(from)-to))<source.size())
+        throw std::logic_error("native plane run has overlapping CUDA copy ranges");
+    for (auto index:selected)
+        if (index>=planes_.size() || spec_.geometry.planes[index].page_stride!=1 ||
+            plane_ranks_[index]>=streams.size())
+            throw std::logic_error("native plane run has unsupported geometry or rank");
+    if (from==to) return;
+    for (auto index:selected) {
+        const auto& plane=planes_[index];
+        const HoldingDeviceBinding binding(plane_devices_[index]);
+        auto* base=static_cast<unsigned char*>(plane.data);
+        if (spec_.geometry.device_plane_order==PagedKVPlaneOrder::PageMajor)
+            CUDA_CHECK(cudaMemcpyAsync(base+std::int64_t(to)*plane.nb[3],
+                base+std::int64_t(from)*plane.nb[3],source.size()*plane.nb[3],
+                cudaMemcpyDeviceToDevice,streams[plane_ranks_[index]]));
+        else
+            CUDA_CHECK(cudaMemcpy2DAsync(base+std::int64_t(to)*plane.nb[2],plane.nb[3],
+                base+std::int64_t(from)*plane.nb[2],plane.nb[3],source.size()*plane.nb[2],
+                static_cast<std::size_t>(plane.ne[3]),cudaMemcpyDeviceToDevice,streams[plane_ranks_[index]]));
+    }
