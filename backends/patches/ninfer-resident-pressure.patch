+
+namespace ninfer::models::qwen3_5::detail {
+struct LayerRestoreTrace {
+    using Clock=std::chrono::steady_clock;
+    std::uint64_t batches=0,bytes=0,pages=0;
+    double pack_ms=0,submit_ms=0,wait_ms=0;
+    static double elapsed(Clock::time_point start) {
+        return std::chrono::duration<double,std::milli>(Clock::now()-start).count();
+    }
+};
+LayerRestoreTrace*& active_layer_restore_trace() noexcept;
+
+// Optional host timing only. No CUDA timing events or extra device fences.
+class LayerwiseRefreshProfile {
+public:
+    LayerwiseRefreshProfile(std::uint32_t lane,std::uint32_t frontier)
+        : lane_(lane),frontier_(frontier),previous_(active_layer_restore_trace()) {
+        static const bool enabled=[] { const auto* v=std::getenv("NINFER_TIME_LAYER_REFRESH");return v && v[0]=='1'; }();
+        enabled_=enabled;
+        if (enabled_) {start_=phase_=LayerRestoreTrace::Clock::now();active_layer_restore_trace()=&transfer;}
+    }
+    ~LayerwiseRefreshProfile() {
+        if (!enabled_) return;
+        active_layer_restore_trace()=previous_;
+        std::fprintf(stderr,"REFRESH_PROFILE lane=%u frontier=%u complete=%d archive_ms=%.3f plan_ms=%.3f cow_ms=%.3f restore_ms=%.3f publish_ms=%.3f total_ms=%.3f batches=%llu pages=%llu bytes=%llu pack_ms=%.3f submit_ms=%.3f wait_ms=%.3f\n",
+            lane_,frontier_,complete,archive_ms,plan_ms,cow_ms,restore_ms,publish_ms,LayerRestoreTrace::elapsed(start_),
+            (unsigned long long)transfer.batches,(unsigned long long)transfer.pages,(unsigned long long)transfer.bytes,
+            transfer.pack_ms,transfer.submit_ms,transfer.wait_ms);
+    }
+    double lap() {if(!enabled_)return 0;const auto value=LayerRestoreTrace::elapsed(phase_);phase_=LayerRestoreTrace::Clock::now();return value;}
+    LayerRestoreTrace transfer;
+    double archive_ms=0,plan_ms=0,cow_ms=0,restore_ms=0,publish_ms=0;
+    bool complete=false;
+private:
+    std::uint32_t lane_,frontier_;
+    bool enabled_=false;
+    LayerRestoreTrace* previous_;
+    LayerRestoreTrace::Clock::time_point start_,phase_;
+};
+}
