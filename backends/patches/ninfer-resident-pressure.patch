+NativeResidentStripe plan_native_resident_stripe(const kvmem::MemoryDescriptor& descriptor,
+    const kvmem::MemorySnapshot& current,const kvmem::LayerWorkingSetPlan& layer,
+    const DeviceKVPagePool& pool) {
+    std::vector<std::uint64_t> selected;
+    for (const auto& item:layer.plan.next.blocks) selected.push_back(item.block.id);
+    const auto checked=kvmem::plan_working_set(descriptor,current,selected,layer.plan.mandatory,layer.plan.budget);
+    if (descriptor.layout.block_tokens!=64 || current.stamp!=layer.plan.expected ||
+        !same_view(checked.next,layer.plan.next) || !checked.spill.empty() ||
+        !std::is_sorted(current.resident.begin(),current.resident.end()) ||
+        std::adjacent_find(current.resident.begin(),current.resident.end())!=current.resident.end() ||
+        !std::includes(current.resident.begin(),current.resident.end(),selected.begin(),selected.end()))
+        throw std::logic_error("resident stripe is not an exact chronological resident subset");
+    NativeResidentStripe result;
+    for (auto id:selected) {
+        const auto slot=std::lower_bound(current.resident.begin(),current.resident.end(),id)-current.resident.begin();
+        if (slot<result.source_slots.size() || slot>UINT32_MAX)
+            throw std::logic_error("resident stripe would overwrite an unread source");
+        result.source_slots.push_back(static_cast<std::uint32_t>(slot));
+    }
+    const auto host=plan_host_kv_page_layout(pool.geometry());
+    const kvmem::NativeKvLayerRegions regions(descriptor.layout,layer.model_layer);
+    if (regions.packed_bytes()!=layer.payload.packed_bytes() || regions.regions().size()!=layer.payload.regions().size())
+        throw std::logic_error("resident stripe payload does not match its layer");
+    for (std::size_t r=0;r<regions.regions().size();++r) {
+        const auto& region=regions.regions()[r];
+        if (!(region.plane==layer.payload.regions()[r].plane) ||
+            region.packed_offset!=layer.payload.regions()[r].packed_offset)
+            throw std::logic_error("resident stripe changed a native plane");
+        const auto found=std::find_if(host.planes.begin(),host.planes.end(),[&](const auto& p){return p.offset==region.plane.offset;});
+        const auto index=std::size_t(found-host.planes.begin());
+        if (found==host.planes.end() || found->page_payload_bytes!=region.plane.bytes ||
+            pool.geometry().planes[index].page_stride!=1 || pool.plane_rank(index)!=region.plane.rank ||
+            std::find(result.planes.begin(),result.planes.end(),index)!=result.planes.end())
+            throw std::logic_error("resident stripe does not match its physical pool");
+        result.planes.push_back(index);
+    }
+    return result;
+}
+
+void submit_native_resident_stripe(const NativeResidentStripe& recipe,DeviceKVPagePool& pool,
+    KVAddressSpaceStore& addresses,KVAddressSpaceHandle address,RankStreams streams,LayerRestoreTrace* trace) {
+    KVLayerStripeWrite::require_unpublished_destination(addresses,address,pool,
+        static_cast<std::uint32_t>(recipe.source_slots.size()));
+    const auto mapped=addresses.mapped_pages(address);
+    // Validate the entire recipe before mutation. Physical uniqueness follows
+    // from the complete address's exclusive writer-reference proof above.
+    for (std::size_t i=0;i<recipe.source_slots.size();++i)
+        if (recipe.source_slots[i]<i || recipe.source_slots[i]>=mapped ||
+            (i && recipe.source_slots[i]<=recipe.source_slots[i-1]))
+            throw std::logic_error("resident stripe has an unsafe source ordering");
+    std::uint64_t stripe_bytes=0;
+    if (trace) {
+        const auto host=plan_host_kv_page_layout(pool.geometry());
+        for (auto p:recipe.planes) stripe_bytes+=host.planes[p].page_payload_bytes;
+    }
+    std::array<DeviceKVPageHandle,64> from{},to{};
+    for (std::size_t first=0;first<recipe.source_slots.size();) {
+        if (recipe.source_slots[first]==first) {++first;continue;}
+        std::size_t count=0;
+        const auto gap=recipe.source_slots[first]-first;
+        // A physical contiguous run may still overlap its source. Bound it by
+        // the logical gap, then split again on either physical discontinuity.
+        for (;count<std::min<std::size_t>({64,gap,recipe.source_slots.size()-first});++count) {
+            if (recipe.source_slots[first+count]!=recipe.source_slots[first]+count) break;
+            const auto a=addresses.physical_page(address,recipe.source_slots[first+count]);
+            const auto b=addresses.physical_page(address,static_cast<std::uint32_t>(first+count));
+            from[count]=a;to[count]=b;
+            if (count && (pool.contiguous_run_count({from.data(),count+1})!=1 ||
+                pool.contiguous_run_count({to.data(),count+1})!=1)) break;
+        }
+        pool.copy_page_run_planes({from.data(),count},{to.data(),count},recipe.planes,streams);
+        if (trace) {
+            ++trace->batches;trace->pages+=count;
+            trace->bytes+=count*stripe_bytes;
+        }
+        first+=count;
+    }
+}
