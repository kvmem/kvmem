+class Fp4Operands {
+public:
+    void linear(LinearParameters& p) { measure(p.weight,p.policy); add(p.weight, p.policy, p.weight.gguf_amax); }
+
+    void projection(ops::ProjectionWeights& projection) {
+        if (auto* single = std::get_if<ops::SingleProjectionWeight>(&projection)) {
+            linear(*single);
+        } else if (auto* gguf = std::get_if<ops::PartProjectionWeights>(&projection)) {
+            for (auto& part : gguf->parts) {
+                measure(part.weight,gguf->policy); add(part.weight, gguf->policy, part.weight.gguf_amax);
+            }
+        }
+    }
+
+    void dense(DenseParameters& p) {
+        if (p.up) {
+            measure(p.gate_up.weight,p.gate_up.policy); measure(p.up->weight,p.gate_up.policy);
+            const float pair = std::max(p.gate_up.weight.gguf_amax, p.up->weight.gguf_amax);
+            add(p.gate_up.weight, p.gate_up.policy, pair);
+            add(p.up->weight, p.gate_up.policy, pair);
+        } else {
+            linear(p.gate_up);
+        }
+        linear(p.down);
+    }
+
+    void ffn(FfnParameters& p) {
+        if (auto* d = std::get_if<DenseParameters>(&p)) { dense(*d); }
+    }
+
+    // Builds every table into one pinned host allocation and points the operands at theirs.
+    // Operands over the same rows at the same max |w| share one. An operand outside device memory
+    // keeps none (its products search).
+    std::optional<PinnedHostBuffer> build() {
+        using Key = std::tuple<const void*, std::int32_t, std::int32_t, float>;
+        std::map<Key, std::size_t> offsets;
+        std::vector<std::size_t> at(operands_.size());
+        std::vector<bool> first(operands_.size(), false);
+        std::size_t bytes = 0;
+        for (std::size_t i = 0; i < operands_.size(); ++i) {
+            const Operand& o = operands_[i];
+            const auto [found, inserted] =
+                offsets.try_emplace(Key{o.weight->qdata, o.weight->n, o.weight->k, o.amax}, bytes);
+            at[i]    = found->second;
+            first[i] = inserted;
+            if (inserted) { bytes += o.bytes; }
+        }
+        if (bytes == 0) { return std::nullopt; }
+        PinnedHostBuffer storage(bytes);
+        auto* base = static_cast<std::uint8_t*>(storage.data());
+        std::set<int> devices;
+        for (std::size_t i = 0; i < operands_.size(); ++i) {
+            if (!first[i]) { continue; }
+            const Operand& o = operands_[i];
+            const DeviceBinding bind(o.device);
+            ops::gguf::fp4_choices(ops::detail::gguf_type(o.weight->qtype),o.weight->qdata,row_bytes(*o.weight),o.weight->n,o.weight->k,o.amax,base+at[i],nullptr);
+            devices.insert(o.device);
+        }
+        for (const int device : devices) {
+            const DeviceBinding bind(device);
+            if (const cudaError_t e = cudaDeviceSynchronize(); e != cudaSuccess) {
+                throw std::runtime_error(std::string("NVFP4 scale-choice tables: ") +
+                                         cudaGetErrorString(e));
+            }
+        }
+        for (std::size_t i = 0; i < operands_.size(); ++i) {
+            operands_[i].weight->fp4_choices      = base + at[i];
+            operands_[i].weight->fp4_choices_amax = operands_[i].amax;
+        }
+        return storage;
+    }
+
+private:
+    static std::int64_t row_bytes(const Weight& w) {
+        auto shape=gguf_block_shape(w.qtype); return std::int64_t(w.k/shape.elements)*shape.bytes;
+    }
+    void measure(Weight& w,ops::LinearPolicy policy) {
+        if (!ops::gguf::nvfp4_enabled() || !ops::allows_a4(policy) || !is_gguf(w.qtype)) return;
+        const int device=memory_device(w.qdata);
+        if (device<0) return;
+        const DeviceBinding binding(device);
+        if (!ops::gguf::has_lt_product(ops::detail::gguf_type(w.qtype),w.k,ops::gguf::LtForm::Nvfp4)) return;
+        const auto key=std::tuple{w.qdata,w.n,w.k};
+        auto found=maxima_.find(key);
+        if (found==maxima_.end()) {
+            const DeviceBinding bind(device); DeviceBuffer word(sizeof(unsigned));
+            ops::gguf::matrix_amax(ops::detail::gguf_type(w.qtype),w.qdata,row_bytes(w),w.n,w.k,static_cast<unsigned*>(word.p),nullptr);
+            CUDA_CHECK(cudaStreamSynchronize(nullptr)); float value=0; word.copy_to_host(&value,sizeof(value));
+            found=maxima_.emplace(key,std::max(value,std::numeric_limits<float>::min())).first;
+        }
+        w.gguf_amax=found->second;
+    }
+    std::map<std::tuple<const void*,int,int>,float> maxima_;
+    struct Operand {
+        Weight* weight;
+        float amax;
+        std::size_t bytes;
+        int device;
+    };
+
+    void add(Weight& w, ops::LinearPolicy policy, float amax) {
+        if (!is_gguf(w.qtype) || !(amax > 0.0F)) { return; }
+        const int device = memory_device(w.qdata);
+        if (device < 0) { return; }
+        const DeviceBinding binding(device);
+        const std::size_t bytes = ops::allows_a4(policy) && ops::gguf::has_lt_product(ops::detail::gguf_type(w.qtype),w.k,ops::gguf::LtForm::Nvfp4) ? ops::gguf::fp4_choice_bytes(w.n,w.k) : 0;
+        if (bytes == 0) { return; }
+        operands_.push_back({&w, amax, bytes, device});
+    }
+
+    std::vector<Operand> operands_;
+};
+
+
 } // namespace
 
