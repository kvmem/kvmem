@@ -0,0 +1,88 @@
+"""Make an explicit GGUF A4-permission artifact without changing physical tensor bytes.
+
+python -m tools.artifact.gguf_a4 source.ninfer output.ninfer --scope mlp-gate-up
+"""
+from __future__ import annotations
+import argparse
+import hashlib
+import json
+import re
+from pathlib import Path
+from .reader import Artifact
+from .schema import ResourceSpec, TensorObject, TensorSpec, binding_parts
+from .writer import ArtifactWriter
+
+def permit_a4(source: Path, output: Path, scope: str, *, verify_payload: bool = True) -> dict:
+    if scope not in {"all-projections", "mlp-gate-up", "mlp-gate-up-middle-half"}:
+        raise ValueError("unknown GGUF A4 scope")
+    if source.resolve() == output.resolve() or output.exists():
+        raise ValueError("output must be a new file distinct from the source")
+    with Artifact(source) as artifact:
+        description = artifact.directory.to_json()
+        layer_pattern=re.compile(r"text/layers/(\d+)/mlp/(gate|up)$")
+        layers=[int(m.group(1)) for name in description["bindings"]
+                if (m:=layer_pattern.fullmatch(name))]
+        count=max(layers)+1 if layers else 0
+        if scope=="mlp-gate-up-middle-half" and count<4:
+            raise ValueError("middle-half scope requires at least four text layers")
+        changed = []
+        for use in description["uses"]:
+            name = use["parameter"]
+            parts = binding_parts(description["bindings"][name], artifact.by_id)
+            gguf = all(isinstance(artifact.by_id[p[0]], TensorObject) and
+                       artifact.by_id[p[0]].format.startswith("gguf_") for p in parts)
+            match=layer_pattern.fullmatch(name)
+            selected = (not name.endswith("/output_head") if scope == "all-projections" else
+                        match is not None and (scope=="mlp-gate-up" or
+                        count//4<=int(match.group(1))<count-count//4))
+            if gguf and selected and use.get("activation_policy") == "AllowA8":
+                use["activation_policy"] = "AllowA4"
+                changed.append({"parameter": name, "input": use["input"]})
+        if not changed:
+            raise ValueError("scope selects no GGUF AllowA8 Uses")
+        specs = [TensorSpec(o.id, o.shape, o.format, o.layout, o.divisors)
+                 if isinstance(o, TensorObject) else ResourceSpec(o.id, o.bytes, o.encoding)
+                 for o in artifact.objects]
+        provenance = {**description["provenance"], "gguf_a4_permission": {
+            "source_artifact_id": artifact.artifact_id.hex(), "scope": scope,
+            "physical_objects": "unchanged", "changed_uses": changed}}
+        hashes = {}
+        with ArtifactWriter(output, specs, components=description["components"],
+                            bindings=description["bindings"], uses=description["uses"],
+                            metadata=description["metadata"], provenance=provenance) as writer:
+            for obj in artifact.objects:
+                digest = hashlib.sha256()
+                def chunks():
+                    for data in artifact.iter_range(obj.offset, obj.bytes):
+                        digest.update(data)
+                        yield data
+                writer.write_object(obj.id, chunks())
+                hashes[obj.id] = digest.hexdigest()
+            writer.finish()
+    with Artifact(output) as artifact:
+        if verify_payload:
+            for obj in artifact.objects:
+                digest = hashlib.sha256()
+                for data in artifact.iter_range(obj.offset, obj.bytes):
+                    digest.update(data)
+                if digest.hexdigest() != hashes[obj.id]:
+                    raise RuntimeError(f"physical object changed: {obj.id}")
+        return {"source": str(source), "output": str(output), "scope": scope,
+                "artifact_id": artifact.artifact_id.hex(), "changed_uses": changed,
+                "object_sha256": hashes, "payload_verified": verify_payload}
+
+def main() -> None:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("source", type=Path)
+    parser.add_argument("output", type=Path)
+    parser.add_argument("--scope", choices=("all-projections", "mlp-gate-up", "mlp-gate-up-middle-half"), required=True)
+    parser.add_argument("--report", type=Path)
+    args = parser.parse_args()
+    report = permit_a4(args.source, args.output, args.scope)
+    if args.report:
+        args.report.write_text(json.dumps(report, indent=2) + "\n", encoding="utf-8")
+    print(json.dumps({**{k: v for k, v in report.items() if k not in {"object_sha256","changed_uses"}},
+                      "changed_uses":len(report["changed_uses"])}))
+
+if __name__ == "__main__":
+    main()
