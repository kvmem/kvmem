+// NVFP4 algorithms adapted from 2-com-org/ninfer-5060-qwen 08c4fb70.
+// Uses the existing GGUF decoder; all activation/image storage belongs to the caller.
+#include "gguf_nvfp4.h"
+#include "ggml_bridge_vec.cuh"
+#include "lt_fp4.cuh"
+#include <cublasLt.h>
+#include <algorithm>
+#include <array>
+#include <map>
+#include <mutex>
