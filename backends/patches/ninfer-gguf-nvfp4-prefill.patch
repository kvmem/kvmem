+
+// Process-start numerical modes, usable by host diagnostics without CUDA headers.
+// Configure them before loading models or querying workspace; each is immutable afterwards.
+namespace ninfer::ops::gguf {
+[[nodiscard]] bool nvfp4_enabled();
