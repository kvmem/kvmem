diff --git a/src/ops/wrapper/linear_swiglu_add.cpp b/src/ops/wrapper/linear_swiglu_add.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..72640782df4e1e5d98820bfb65f46f4a55354aba
--- /dev/null
+++ b/src/ops/wrapper/linear_swiglu_add.cpp
@@ -0,0 +1,89 @@
+#include "ninfer/ops/linear_swiglu_add.h"
+#include "ops/linear/gguf/gguf_linear.h"
+#include "ops/linear/gguf/gguf_nvfp4.h"
+#include <algorithm>
+#include <stdexcept>
+
+namespace ninfer::ops {
+namespace {
+constexpr auto form = gguf::LtForm::Nvfp4;
+void require_policies(LinearPolicy gate, LinearPolicy down) {
+    if (!valid_linear_policy(gate) || !valid_linear_policy(down))
+        throw std::invalid_argument("linear_swiglu_add: invalid compute policy");
+}
+
+bool fused(QType gate, QType up, QType down, int k, int rows, int t, LinearPolicy gp,
+           LinearPolicy dp) {
+    return gguf::nvfp4_enabled() && allows_a4(gp) && allows_a4(dp) && t >= 129 && rows % 256 == 0 &&
+           gguf::has_lt_product(detail::gguf_type(gate), k, form) &&
+           gguf::has_lt_product(detail::gguf_type(up), k, form) &&
+           gguf::has_lt_product(detail::gguf_type(down), rows, form);
+}
+} // namespace
+
+std::size_t linear_swiglu_add_workspace_capacity_bytes(QType gate, const QType* up, int gate_rows,
+                                                       int k, QType down, int output_rows,
+                                                       LinearPolicy gp, LinearPolicy dp, int first,
+                                                       int last) {
+    if (!is_gguf(gate) || !is_gguf(down) || (up && !is_gguf(*up)) || first <= 0 || last < first ||
+        gate_rows <= 0 || (!up && gate_rows % 2 != 0) || k <= 0 || output_rows <= 0)
+        throw std::invalid_argument(
+            "linear_swiglu_add: GGUF matrices and a valid token interval required");
+    require_policies(gp,dp);
+    int rows = up ? gate_rows : gate_rows / 2;
+    detail::GgufShape g{gate, gate_rows, k}, u{up ? *up : gate, rows, k},
+        d{down, output_rows, rows};
+    const auto gated     = detail::gguf_swiglu_workspace_bytes(g, up ? &u : nullptr, first, last);
+    const auto projected = detail::gguf_project_workspace_bytes({&d, 1}, first, last);
+    auto bytes           = std::max(gated, projected);
+    if (fused(gate, up ? *up : gate, down, k, rows, last, gp, dp))
+        bytes = std::max(bytes, gguf::lt_activation_bytes(rows, last, form) +
+                                    std::max(gated, gguf::lt_planned_scratch_bytes(
+                                                        rows, output_rows, last, false, form)) +
+                                    512);
+    return std::size_t(rows) * last * 2 + bytes + 256;
+}
+
+void linear_swiglu_add(const Tensor& x, const Weight& gate, const Weight* up, const Weight& down,
+                       Tensor& residual, LinearPolicy gp, LinearPolicy dp,
+                       WorkspaceArena& workspace, cudaStream_t stream) {
+    detail::require_gguf(gate, "linear_swiglu_add gate");
+    detail::require_gguf(down, "linear_swiglu_add down");
+    if (up) detail::require_gguf(*up, "linear_swiglu_add up");
+    const int t = x.ne[1], rows = up ? gate.n : gate.n / 2;
+    if (down.k != rows || residual.dtype != DType::BF16 || !residual.is_contiguous() ||
+        residual.ne[0] != down.n || residual.ne[1] != t)
+        throw std::invalid_argument("linear_swiglu_add: incompatible down/residual geometry");
+    require_policies(gp,dp);
+    auto scope        = workspace.scope();
+    Tensor activation = workspace.alloc(DType::BF16, {rows, t});
+    gguf::VectorOutput out;
+    out.bf16          = static_cast<__nv_bfloat16*>(residual.data);
+    out.column_stride = down.n;
+    out.epilogue      = gguf::Epilogue::Accumulate;
+    if (!fused(gate.qtype, up ? up->qtype : gate.qtype, down.qtype, gate.k, rows, t, gp, dp) ||
+        gate.gguf_amax <= 0 || (up && up->gguf_amax <= 0) || down.gguf_amax <= 0 ||
+        down.input_columns || !gguf::lt_takes_output(out)) {
+        {
+            auto call = workspace.scope();
+            detail::gguf_swiglu(x, gate, up, activation, workspace, stream,
+                                gguf::GateActivation::Silu, gp);
+        }
+        detail::gguf_linear_add(activation, down, residual, workspace, stream, dp);
+        return;
+    }
+    void* encoded = workspace.alloc_bytes(gguf::lt_activation_bytes(rows, t, form)).data;
+    {
+        auto call = workspace.scope();
+        detail::gguf_swiglu(x, gate, up, activation, workspace, stream, gguf::GateActivation::Silu,
+                            gp, encoded);
+    }
+    const auto bytes = gguf::lt_planned_scratch_bytes(rows, down.n, t, false, form);
+    void* scratch    = workspace.alloc_bytes(bytes).data;
+    auto block       = gguf_block_shape(down.qtype);
+    gguf::lt_product(detail::gguf_type(down.qtype), down.qdata,
+                     std::int64_t(rows / block.elements) * block.bytes, down.n, rows, form,
+                     down.gguf_amax, {down.fp4_choices, down.fp4_choices_amax}, encoded, t, out,
+                     scratch, bytes, stream);
+}
+} // namespace ninfer::ops
