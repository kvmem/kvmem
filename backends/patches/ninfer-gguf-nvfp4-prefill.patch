+import hashlib
+from pathlib import Path
+import tempfile
+import unittest
+from tools.artifact.gguf_a4 import permit_a4
+from tools.artifact.reader import Artifact
+from tools.artifact.schema import TensorSpec
+from tools.artifact.writer import ArtifactWriter
+
+class GgufA4ArtifactTest(unittest.TestCase):
+    def test_permission_scope_preserves_every_physical_byte_and_sensitive_use(self):
+        with tempfile.TemporaryDirectory() as directory:
+            root=Path(directory);source=root/'source.ninfer'
+            bindings={name:{'object':obj} for name,obj in [
+                ('text/layers/0/mlp/gate','w'),('text/layers/0/attention/query','w'),
+                ('text/output_head','w'),('text/layers/0/mlp/up','b'),
+                ('text/layers/1/mlp/gate','w'),('text/layers/2/mlp/gate','w'),
+                ('text/layers/3/mlp/gate','w')]}
+            uses=[dict(parameter=name,input='hidden',activation_policy='A16Only' if name.startswith('text/layers/1/') else 'AllowA8') for name in bindings]
+            payload=bytes(range(256))+bytes(range(32))
+            with ArtifactWriter(source,[TensorSpec('w',(2,256),'gguf_q4_k','gguf_blocks_v1'),
+                                        TensorSpec('b',(2,2),'bf16','contiguous_le_v1')],
+                                components={'text':{'config':{}}},
+                                bindings=bindings,uses=uses) as writer:
+                writer.write_object('w',payload);writer.write_object('b',b'12345678');writer.finish()
+            original=hashlib.sha256(source.read_bytes()).hexdigest()
+            for scope,count in [('all-projections',4),('mlp-gate-up',3),('mlp-gate-up-middle-half',1)]:
+                target=root/(scope+'.ninfer');report=permit_a4(source,target,scope)
+                self.assertEqual(len(report['changed_uses']),count)
+                with Artifact(source) as before,Artifact(target) as after:
+                    self.assertNotEqual(before.artifact_id,after.artifact_id)
+                    for obj in before.objects:self.assertEqual(before.read_object(obj.id),after.read_object(obj.id))
+                    policies={u['parameter']:u['activation_policy'] for u in after.directory.uses}
+                    self.assertEqual(policies['text/layers/0/mlp/gate'],'AllowA8' if scope.endswith('middle-half') else 'AllowA4')
+                    self.assertEqual(policies['text/layers/2/mlp/gate'],'AllowA4')
+                    self.assertEqual(policies['text/layers/3/mlp/gate'],'AllowA8' if scope.endswith('middle-half') else 'AllowA4')
+                    self.assertEqual(policies['text/output_head'],'AllowA8')
+                    self.assertEqual(policies['text/layers/0/mlp/up'],'AllowA8')
+                    self.assertEqual(policies['text/layers/1/mlp/gate'],'A16Only')
+                self.assertEqual(hashlib.sha256(source.read_bytes()).hexdigest(),original)
+
+if __name__=='__main__':unittest.main()
