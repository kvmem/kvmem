index 0000000000000000000000000000000000000000..ac32bf1a3e471899b7665854eca79fe94a500137
--- /dev/null
+++ b/tests/ops/linear/test_gguf_nvfp4.cpp
@@ -0,0 +1,550 @@
+// Public GGUF NVFP4 products against a scalar CPU packed-weight decoder, independent
+// table codecs and FP64 dot products. The CPU error calculation explicitly rounds each
+// half-precision candidate-error operation, while the actual GEMM accumulates in FP32.
+#include "core/arena.h"
+#include "core/weight.h"
+#include "ninfer/ops/linear.h"
+#include "ninfer/ops/linear_add.h"
+#include "ninfer/ops/linear_swiglu.h"
+#include "ninfer/ops/linear_swiglu_add.h"
+#include "ops/linear/gguf/gguf_linear.h"
+#include "ops/linear/gguf/gguf_nvfp4.h"
+#include <cuda_bf16.h>
+#include <cuda_fp16.h>
+#include <algorithm>
+#include <array>
+#include <cmath>
+#include <cstring>
+#include <iostream>
+#include <numeric>
+#include <random>
+#include <stdexcept>
+#include <string_view>
+#include <vector>
+extern "C" void gguf_cpu_decode(int, const void*, float*, int);
+
+namespace {
+using namespace ninfer;
+namespace g           = ops::gguf;
+constexpr auto form   = g::LtForm::Nvfp4;
+constexpr auto policy = ops::LinearPolicy::AllowA4;
+
+void ck(cudaError_t e) {
+    if (e != cudaSuccess) throw std::runtime_error(cudaGetErrorString(e));
+}
+
+double f8(unsigned c) {
+    int e = (c >> 3) & 15, m = c & 7;
+    return e ? std::ldexp(1.0 + m / 8.0, e - 7) : std::ldexp(double(m), -9);
+}
+
+unsigned f8code(float v) {
+    unsigned best = 0;
+    double error  = std::abs(double(v));
+    for (unsigned c = 1; c <= 126; ++c) {
+        const double d = std::abs(double(v) - f8(c));
+        if (d < error || (d == error && (c & 1) == 0)) {
+            best  = c;
+            error = d;
+        }
+    }
+    return best;
+}
+
+constexpr float f4table[] = {0, .5, 1, 1.5, 2, 3, 4, 6};
+
+unsigned f4code(float v) {
+    const unsigned sign = std::signbit(v) ? 8 : 0;
+    v                   = std::abs(v);
+    unsigned best       = 0;
+    float error         = v;
+    for (unsigned c = 1; c < 8; ++c) {
+        float d = std::abs(v - f4table[c]);
+        if (d < error || (d == error && (c & 1) == 0)) {
+            best  = c;
+            error = d;
+        }
+    }
+    return best | sign;
+}
+
+float f4(unsigned c) { return (c & 8 ? -1.f : 1.f) * f4table[c & 7]; }
+
+float half(float v) { return __half2float(__float2half_rn(v)); }
+
+float global(float a) {
+    if (a == 0) return 1;
+    if (a < 1e-15f) return std::ldexp(1.f, 60);
+    return std::ldexp(1.f, std::max(-60, int(std::floor(std::log2(2688.0 / double(a))))));
+}
+
+struct Group {
+    unsigned scale = 0, choice = 0;
+    std::array<unsigned, 16> codes{};
+};
+
+Group encode(const float* v) {
+    float a = 0;
+    for (int j = 0; j < 16; ++j) a = std::max(a, std::abs(v[j]));
+    const unsigned s6        = std::max(f8code(a * (1.f / 6.f)), a > 0 ? 1u : 0u),
+                   s4        = std::max(f8code(a * .25f), a > 0 ? 1u : 0u);
+    const unsigned choices[] = {s6, s4, std::min(126u, s6 + 1), std::min(126u, s4 + 1)};
+    Group best;
+    float best_error = 0;
+    for (unsigned c = 0; c < 4; ++c) {
+        Group trial;
+        trial.scale       = choices[c];
+        trial.choice      = c;
+        const float scale = float(f8(trial.scale)), inv = scale > 0 ? 1.f / scale : 0.f;
+        float sums[2] = {};
+        for (int j = 0; j < 16; ++j) {
+            trial.codes[j] = f4code(v[j] * inv);
+            const float e  = half(std::fma(half(v[j]), half(inv), -f4(trial.codes[j])));
+            sums[j % 2]    = half(std::fma(e, e, sums[j % 2]));
+        }
+        const float error = (sums[0] + sums[1]) * scale * scale;
+        if (c == 0 || error < best_error) {
+            best_error = error;
+            best       = trial;
+        }
+    }
+    return best;
+}
+
+void quantize(std::vector<float>& values, float amax = 0) {
+    if (amax == 0)
+        for (float v : values) amax = std::max(amax, std::abs(v));
+    const float gl = global(amax);
+    for (std::size_t at = 0; at < values.size(); at += 16) {
+        float v[16];
+        for (int j = 0; j < 16; ++j) v[j] = values[at + j] * gl;
+        const auto q = encode(v);
+        for (int j = 0; j < 16; ++j) values[at + j] = f4(q.codes[j]) * float(f8(q.scale)) / gl;
+    }
+}
+
+void compare(const std::vector<__nv_bfloat16>& got, const std::vector<double>& want,
+             const char* name, double limit = .008) {
+    double diff = 0, ref = 0, peak = 0, worst = 0;
+    for (std::size_t i = 0; i < want.size(); ++i) {
+        double value = __bfloat162float(got[i]);
+        if (!std::isfinite(value)) throw std::runtime_error("nonfinite");
+        diff += (value - want[i]) * (value - want[i]);
+        ref += want[i] * want[i];
+        peak  = std::max(peak, std::abs(want[i]));
+        worst = std::max(worst, std::abs(value - want[i]));
+    }
+    double rms = std::sqrt(diff / std::max(ref, 1e-30)), rel = worst / std::max(peak, 1e-30);
+    std::cout << name << " rms=" << rms << " peak=" << rel << "\n";
+    if (rms > limit || rel > 2 * limit)
+        throw std::runtime_error(std::string(name) + " independent FP64 bound");
+}
+
+std::size_t scale_at(int row, int group, int groups) {
+    return std::size_t(row / 128 * ((groups + 3) / 4) + group / 4) * 512 + (row % 32) * 16 +
+           (row % 128 / 32) * 4 + group % 4;
+}
+
+void activation_codec() {
+    constexpr int k = 256, t = 5;
+    std::vector<__nv_bfloat16> x(k * t);
+    std::mt19937 rng(5151);
+    std::normal_distribution<float> normal(0, 1);
+    for (auto& v : x) v = __float2bfloat16(normal(rng));
+    for (int j = 0; j < 16; ++j) x[j] = __float2bfloat16(0);
+    for (int j = 16; j < 32; ++j) x[j] = __float2bfloat16((j & 1 ? -1.f : 1.f) * 1e-38f);
+    for (int j = 32; j < 48; ++j) x[j] = __float2bfloat16((j & 1 ? -1.f : 1.f) * 1e8f);
+    DeviceBuffer dx(x.size() * 2), data(g::lt_activation_bytes(k, t, form));
+    dx.copy_from_host(x.data(), x.size() * 2);
+    std::vector<int> permutation(k);
+    std::iota(permutation.begin(), permutation.end(), 0);
+    std::reverse(permutation.begin(), permutation.end());
+    DeviceBuffer dp(k * 4);
+    dp.copy_from_host(permutation.data(), k * 4);
+    for (bool gather : {false, true}) {
+        g::quantize_lt_activation(static_cast<const __nv_bfloat16*>(dx.p), k, t,
+                                  gather ? static_cast<int*>(dp.p) : nullptr, form, data.p,
+                                  nullptr);
+        std::vector<unsigned char> bytes(data.bytes);
+        data.copy_to_host(bytes.data(), bytes.size());
+        float a = 0;
+        for (auto v : x) a = std::max(a, std::abs(__bfloat162float(v)));
+        const float gl = global(a);
+        int differing  = 0;
+        for (int c = 0; c < t; ++c)
+            for (int b = 0; b < k / 16; ++b) {
+                float v[16];
+                for (int j = 0; j < 16; ++j)
+                    v[j] = __bfloat162float(
+                               x[c * k + (gather ? permutation[16 * b + j] : 16 * b + j)]) *
+                           gl;
+                auto q = encode(v);
+                unsigned s =
+                    bytes[g::lt_activation_scales_offset(k, t, form) + scale_at(c, b, k / 16)];
+                bool same = s == q.scale;
+                for (int j = 0; j < 16; ++j) {
+                    unsigned code = (bytes[c * (k / 2) + 8 * b + j / 2] >> (4 * (j % 2))) & 15u;
+                    same &= code == q.codes[j];
+                    // Scalar nearest-code property at the actual scale, independent of candidate
+                    // selection.
+                    const float inv = s ? 1.f / float(f8(s)) : 0;
+                    if (code != f4code(v[j] * inv) &&
+                        std::abs(f4(code) - v[j] * inv) >
+                            std::abs(f4(f4code(v[j] * inv)) - v[j] * inv) + 1e-4f)
+                        throw std::runtime_error("FP4 code is not a nearest value");
+                }
+                differing += !same;
+            }
+        // rcp.approx can resolve a near-tie differently; explicitly retain the count.
+        std::cout << "codec gather=" << gather << " CPU candidate differences=" << differing << "/"
+                  << t * k / 16 << "\n";
+        if (differing > 1) throw std::runtime_error("activation codec disagreement");
+        for (int c = t; c < 128; ++c)
+            for (int b = 0; b < k / 16; ++b)
+                if (bytes[g::lt_activation_scales_offset(k, t, form) + scale_at(c, b, k / 16)] != 0)
+                    throw std::runtime_error("scale padding");
+    }
+}
+
+struct Format {
+    QType q;
+    const char* name;
+    std::vector<int> fields;
+};
+
+void fallback_boundaries() {
+    constexpr int k = 256, n = 128;
+    std::mt19937 rng(913);
+    const auto b = gguf_block_shape(QType::GGUF_Q4_K);
+    std::vector<unsigned char> raw(n * b.bytes);
+    for (auto& v : raw) v = static_cast<unsigned char>(rng());
+    unsigned short h = 0x2266;
+    for (int r = 0; r < n; ++r) {
+        std::memcpy(raw.data() + r * b.bytes, &h, 2);
+        std::memcpy(raw.data() + r * b.bytes + 2, &h, 2);
+    }
+    DeviceBuffer dw(raw.size());
+    dw.copy_from_host(raw.data(), raw.size());
+    Weight w;
+    w.qtype            = QType::GGUF_Q4_K;
+    w.layout           = QuantLayout::GgufBlocks;
+    w.n                = n;
+    w.k                = k;
+    w.qdata            = dw.p;
+    w.gguf_amax        = 32;
+    std::uint64_t hash = 1469598103934665603ULL;
+    for (int t : {1, 8, 32, 128, 129})
+        for (auto p : {ops::LinearPolicy::A16Only, ops::LinearPolicy::AllowA8, policy}) {
+            if (t == 129 && p == policy) continue;
+            std::vector<__nv_bfloat16> x(k * t);
+            for (auto& v : x) v = __float2bfloat16(float(int(rng() % 131) - 65) * .01f);
+            DeviceBuffer dx(x.size() * 2), dy(n * t * 2);
+            dx.copy_from_host(x.data(), x.size() * 2);
+            Tensor tx(dx.p, DType::BF16, {k, t}), ty(dy.p, DType::BF16, {n, t});
+            WorkspaceArena ws(ops::linear_workspace_capacity_bytes(w.qtype, n, k, p, 1, t));
+            ops::linear(tx, w, ty, p, ws, nullptr);
+            std::vector<unsigned char> result(n * t * 2);
+            dy.copy_to_host(result.data(), result.size());
+            for (auto value : result) {
+                hash ^= value;
+                hash *= 1099511628211ULL;
+            }
+        }
+    // FP32 products also retain q8_1 at wide sizes.
+    constexpr int t = 129;
+    std::vector<__nv_bfloat16> x(k * t);
+    for (auto& v : x) v = __float2bfloat16(float(int(rng() % 131) - 65) * .01f);
+    DeviceBuffer dx(x.size() * 2), dy(n * t * 4);
+    dx.copy_from_host(x.data(), x.size() * 2);
+    Tensor tx(dx.p, DType::BF16, {k, t}), ty(dy.p, DType::FP32, {n, t});
+    WorkspaceArena ws(ops::linear_workspace_capacity_bytes(w.qtype, n, k, policy, 1, t));
+    ops::linear(tx, w, ty, policy, ws, nullptr);
+    std::vector<unsigned char> result(n * t * 4);
+    dy.copy_to_host(result.data(), result.size());
+    for (auto value : result) {
+        hash ^= value;
+        hash *= 1099511628211ULL;
+    }
+    std::cout << "q8 fallback checksum=" << hash << "\n";
+}
+
+void fused_feed_forward() {
+    constexpr int k = 256, m = 256, n = 16, t = 129;
+    const auto block = gguf_block_shape(QType::GGUF_Q4_K);
+    const int rb     = block.bytes;
+    std::mt19937 rng(8119);
+    std::vector<unsigned char> gr(2 * m * rb), dr(n * rb);
+    const unsigned short h = 0x1866;
+    for (auto* raw : {&gr, &dr}) {
+        for (auto& v : *raw) v = static_cast<unsigned char>(rng());
+        for (std::size_t r = 0; r < raw->size(); r += rb) {
+            std::memcpy(raw->data() + r, &h, 2);
+            std::memcpy(raw->data() + r + 2, &h, 2);
+        }
+    }
+    std::vector<float> gw(2 * m * k), dw(n * m);
+    gguf_cpu_decode(12, gr.data(), gw.data(), 2 * m * k);
+    gguf_cpu_decode(12, dr.data(), dw.data(), n * m);
+    float ga = 0, da = 0;
+    for (float v : gw) ga = std::max(ga, std::abs(v));
+    for (float v : dw) da = std::max(da, std::abs(v));
+    quantize(gw, ga);
+    quantize(dw, da);
+    std::normal_distribution<float> normal(0, .3f);
+    std::vector<__nv_bfloat16> x(k * t);
+    for (auto& v : x) v = __float2bfloat16(normal(rng));
+    std::vector<float> qx(x.size());
+    for (std::size_t i = 0; i < x.size(); ++i) qx[i] = __bfloat162float(x[i]);
+    quantize(qx);
+    std::vector<float> activation(m * t);
+    for (int c = 0; c < t; ++c)
+        for (int r = 0; r < m; ++r) {
+            double a = 0, b = 0;
+            for (int j = 0; j < k; ++j) {
+                a += double(gw[r * k + j]) * qx[c * k + j];
+                b += double(gw[(m + r) * k + j]) * qx[c * k + j];
+            }
+            const float gb        = __bfloat162float(__float2bfloat16(float(a))),
+                        ub        = __bfloat162float(__float2bfloat16(float(b)));
+            activation[c * m + r] = __bfloat162float(
+                __float2bfloat16(float(double(gb) / (1 + std::exp(-double(gb))) * ub)));
+        }
+    quantize(activation);
+    std::vector<double> ref(n * t, .25);
+    for (int c = 0; c < t; ++c)
+        for (int r = 0; r < n; ++r)
+            for (int j = 0; j < m; ++j)
+                ref[c * n + r] += double(dw[r * m + j]) * activation[c * m + j];
+    DeviceBuffer dg(gr.size()), dd(dr.size()), dx(x.size() * 2), dy(n * t * 2), dh(m * t * 2);
+    dg.copy_from_host(gr.data(), gr.size());
+    dd.copy_from_host(dr.data(), dr.size());
+    dx.copy_from_host(x.data(), x.size() * 2);
+    Weight gate;
+    gate.qtype     = QType::GGUF_Q4_K;
+    gate.layout    = QuantLayout::GgufBlocks;
+    gate.n         = 2 * m;
+    gate.k         = k;
+    gate.qdata     = dg.p;
+    gate.gguf_amax = ga;
+    Weight down    = gate;
+    down.n         = n;
+    down.k         = m;
+    down.qdata     = dd.p;
+    down.gguf_amax = da;
+    Tensor tx(dx.p, DType::BF16, {k, t}), ty(dy.p, DType::BF16, {n, t}),
+        th(dh.p, DType::BF16, {m, t});
+    const auto bytes = ops::linear_swiglu_add_workspace_capacity_bytes(
+        gate.qtype, nullptr, gate.n, k, down.qtype, n, policy, policy, 1, t);
+    WorkspaceArena ws(bytes);
+    std::vector<__nv_bfloat16> initial(n * t, __float2bfloat16(.25)), got(n * t), composed(n * t);
+    dy.copy_from_host(initial.data(), initial.size() * 2);
+    ops::linear_swiglu_add(tx, gate, nullptr, down, ty, policy, policy, ws, nullptr);
+    dy.copy_to_host(got.data(), got.size() * 2);
+    compare(got, ref, "fused FFN FP64", .012);
+    dy.copy_from_host(initial.data(), initial.size() * 2);
+    ops::linear_swiglu(tx, gate, th, policy, ws, nullptr);
+    ops::linear_add(th, down, ty, policy, ws, nullptr);
+    dy.copy_to_host(composed.data(), composed.size() * 2);
+    if (std::memcmp(got.data(), composed.data(), got.size() * 2))
+        throw std::runtime_error("fused down producer differs from BF16 composition");
+    std::cout << "fused down activation exactly matches separate BF16 producer\n";
+}
+
+void run(const Format& format, int n, int k, int t, bool fusion) {
+    std::mt19937 rng(1031 + int(format.q) + k + t);
+    const auto block = gguf_block_shape(format.q);
+    const auto rb    = std::size_t(k / block.elements) * block.bytes;
+    std::vector<unsigned char> raw(2 * n * rb);
+    for (auto& v : raw) v = static_cast<unsigned char>(rng());
+    const unsigned short h = 0x2266;
+    for (std::size_t b = 0; b < raw.size(); b += block.bytes) {
+        for (int off : format.fields) std::memcpy(raw.data() + b + off, &h, 2);
+        if (format.q == QType::GGUF_IQ1_M) {
+            for (int i = 0; i < 4; ++i) {
+                unsigned short s;
+                std::memcpy(&s, raw.data() + b + 48 + 2 * i, 2);
+                s = (s & 0xfff) | (((h >> (4 * i)) & 15) << 12);
+                std::memcpy(raw.data() + b + 48 + 2 * i, &s, 2);
+            }
+        }
+    }
+    std::vector<float> exact(std::size_t(2 * n) * k);
+    gguf_cpu_decode(int(ops::detail::gguf_type(format.q)), raw.data(), exact.data(), 2 * n * k);
+    float max_gate = 0, max_up = 0;
+    for (int i = 0; i < n * k; ++i) {
+        max_gate = std::max(max_gate, std::abs(exact[i]));
+        max_up   = std::max(max_up, std::abs(exact[n * k + i]));
+    }
+    const float pair = std::max(max_gate, max_up);
+    DeviceBuffer dw(raw.size()), amax(sizeof(unsigned));
+    dw.copy_from_host(raw.data(), raw.size());
+    g::matrix_amax(ops::detail::gguf_type(format.q), dw.p, rb, 2 * n, k,
+                   static_cast<unsigned*>(amax.p), nullptr);
+    float measured;
+    amax.copy_to_host(&measured, 4);
+    if (measured != pair) throw std::runtime_error("independent decoded amax differs");
+    std::normal_distribution<float> normal(0, .3f);
+    std::vector<__nv_bfloat16> x(k * t);
+    for (auto& v : x) v = __float2bfloat16(normal(rng));
+    DeviceBuffer dx(x.size() * 2), dy(std::size_t(n) * t * 2 + 32);
+    dx.copy_from_host(x.data(), x.size() * 2);
+    Tensor tx(dx.p, DType::BF16, {k, t}),
+        ty(static_cast<unsigned char*>(dy.p) + 16, DType::BF16, {n, t});
+    Weight w;
+    w.qtype          = format.q;
+    w.layout         = QuantLayout::GgufBlocks;
+    w.n              = n;
+    w.k              = k;
+    w.qdata          = dw.p;
+    w.gguf_amax      = max_gate;
+    Weight parent    = w;
+    parent.n         = 2 * n;
+    parent.gguf_amax = pair;
+    const auto capacity =
+        std::max(ops::linear_workspace_capacity_bytes(w.qtype, n, k, policy, 1, t),
+                 ops::linear_swiglu_workspace_capacity_bytes(w.qtype, 2 * n, k, policy, 1, t));
+    WorkspaceArena ws(capacity);
+    std::vector<int> permutation(k);
+    std::iota(permutation.begin(), permutation.end(), 0);
+    std::shuffle(permutation.begin(), permutation.end(), rng);
+    DeviceBuffer dp(k * 4);
+    dp.copy_from_host(permutation.data(), k * 4);
+    const auto choices_bytes = g::fp4_choice_bytes(2 * n, k);
+    PinnedHostBuffer choices(choices_bytes);
+    g::fp4_choices(ops::detail::gguf_type(w.qtype), dw.p, rb, 2 * n, k, pair,
+                   static_cast<unsigned char*>(choices.data()), nullptr);
+    for (bool gather : {false, true}) {
+        w.input_columns      = gather ? static_cast<int*>(dp.p) : nullptr;
+        parent.input_columns = w.input_columns;
+        std::vector<float> qx(k * t), qw(exact.begin(), exact.begin() + n * k), qpair = exact;
+        for (int c = 0; c < t; ++c)
+            for (int j = 0; j < k; ++j)
+                qx[c * k + j] = __bfloat162float(x[c * k + (gather ? permutation[j] : j)]);
+        quantize(qx);
+        quantize(qw, max_gate);
+        quantize(qpair, pair);
+        std::vector<double> ref(n * t), fused(n * t);
+        for (int c = 0; c < t; ++c)
+            for (int r = 0; r < n; ++r) {
+                double sum = 0, gate = 0, up = 0;
+                for (int j = 0; j < k; ++j) {
+                    sum += double(qw[r * k + j]) * qx[c * k + j];
+                    gate += double(qpair[r * k + j]) * qx[c * k + j];
+                    up += double(qpair[(n + r) * k + j]) * qx[c * k + j];
+                }
+                ref[c * n + r]   = sum;
+                float gb         = __bfloat162float(__float2bfloat16(float(gate))),
+                      ub         = __bfloat162float(__float2bfloat16(float(up)));
+                fused[c * n + r] = gb / (1 + std::exp(-double(gb))) * ub;
+            }
+        std::vector<__nv_bfloat16> got(n * t), search;
+        dy.fill(0x42);
+        ops::linear(tx, w, ty, policy, ws, nullptr);
+        ck(cudaDeviceSynchronize());
+        ck(cudaMemcpy(got.data(), ty.data, got.size() * 2, cudaMemcpyDeviceToHost));
+        search = got;
+        std::cout << format.name << " N=" << n << " K=" << k << " T=" << t << " gather=" << gather
+                  << " ";
+        compare(got, ref, "FP64 encoded product");
+        // Cache computed under this operand's own global must preserve every output bit.
+        g::fp4_choices(ops::detail::gguf_type(w.qtype), dw.p, rb, n, k, max_gate,
+                       static_cast<unsigned char*>(choices.data()), nullptr);
+        w.fp4_choices      = static_cast<unsigned char*>(choices.data());
+        w.fp4_choices_amax = max_gate;
+        ops::linear(tx, w, ty, policy, ws, nullptr);
+        ck(cudaMemcpy(got.data(), ty.data, got.size() * 2, cudaMemcpyDeviceToHost));
+        if (std::memcmp(got.data(), search.data(), got.size() * 2))
+            throw std::runtime_error("choice cache changes result");
+        std::fill(got.begin(), got.end(), __float2bfloat16(.25));
+        ck(cudaMemcpy(ty.data, got.data(), got.size() * 2, cudaMemcpyHostToDevice));
+        ops::linear_add(tx, w, ty, policy, ws, nullptr);
+        ck(cudaMemcpy(got.data(), ty.data, got.size() * 2, cudaMemcpyDeviceToHost));
+        auto add = ref;
+        for (auto& v : add) v += .25;
+        compare(got, add, "residual");
+        if (fusion) {
+            g::fp4_choices(ops::detail::gguf_type(w.qtype), dw.p, rb, 2 * n, k, pair,
+                           static_cast<unsigned char*>(choices.data()), nullptr);
+            parent.fp4_choices      = static_cast<unsigned char*>(choices.data());
+            parent.fp4_choices_amax = pair;
+            ops::linear_swiglu(tx, parent, ty, policy, ws, nullptr);
+            ck(cudaMemcpy(got.data(), ty.data, got.size() * 2, cudaMemcpyDeviceToHost));
+            compare(got, fused, "BF16-boundary SwiGLU", .012);
+            Weight gate_half=parent,up_half=parent;
+            gate_half.n=up_half.n=n;
+            up_half.qdata=static_cast<const unsigned char*>(dw.p)+std::size_t(n)*rb;
+            up_half.fp4_choices=g::fp4_choice_rows(parent.fp4_choices,n,k);
+            ops::linear_swiglu(tx,gate_half,up_half,ty,policy,ws,nullptr);
+            ck(cudaMemcpy(got.data(),ty.data,got.size()*2,cudaMemcpyDeviceToHost));
+            compare(got,fused,"separate-parent SwiGLU",.012);
+            // Distinct gathers take two GEMMs instead of the stacked one-GEMM form.
+            up_half.input_columns=gather?nullptr:static_cast<int*>(dp.p);
+            std::vector<float> up_x(k*t);
+            for(int c=0;c<t;++c)for(int j=0;j<k;++j)
+                up_x[c*k+j]=__bfloat162float(x[c*k+(gather?j:permutation[j])]);
+            quantize(up_x);
+            std::vector<double> separate(n*t);
+            for(int c=0;c<t;++c)for(int r=0;r<n;++r){
+                double gv=0,uv=0;
+                for(int j=0;j<k;++j){gv+=double(qpair[r*k+j])*qx[c*k+j];uv+=double(qpair[(n+r)*k+j])*up_x[c*k+j];}
+                const float gb=__bfloat162float(__float2bfloat16(float(gv))),ub=__bfloat162float(__float2bfloat16(float(uv)));
+                separate[c*n+r]=gb/(1+std::exp(-double(gb)))*ub;
+            }
+            ops::linear_swiglu(tx,gate_half,up_half,ty,policy,ws,nullptr);
+            ck(cudaMemcpy(got.data(),ty.data,got.size()*2,cudaMemcpyDeviceToHost));
+            compare(got,separate,"distinct-gather two-GEMM SwiGLU",.012);
+        }
+        w.fp4_choices = nullptr;
+        cudaStream_t stream;
+        ck(cudaStreamCreateWithFlags(&stream, cudaStreamNonBlocking));
+        ck(cudaStreamBeginCapture(stream, cudaStreamCaptureModeGlobal));
+        ops::linear(tx, w, ty, policy, ws, stream);
+        cudaGraph_t graph;
+        ck(cudaStreamEndCapture(stream, &graph));
+        cudaGraphExec_t exe;
+        ck(cudaGraphInstantiate(&exe, graph, nullptr, nullptr, 0));
+        ck(cudaGraphLaunch(exe, stream));
+        ck(cudaStreamSynchronize(stream));
+        ck(cudaMemcpy(got.data(), ty.data, got.size() * 2, cudaMemcpyDeviceToHost));
+        compare(got, ref, "graph");
+        ck(cudaGraphExecDestroy(exe));
+        ck(cudaGraphDestroy(graph));
+        ck(cudaStreamDestroy(stream));
+        std::vector<unsigned char> guards(dy.bytes);
+        dy.copy_to_host(guards.data(), guards.size());
+        for (int i = 0; i < 16; ++i)
+            if (guards[i] != 0x42 || guards[guards.size() - 1 - i] != 0x42)
+                throw std::runtime_error("output canary");
+        w.fp4_choices = nullptr;
+    }
+    if (ws.peak_used() > capacity) throw std::runtime_error("workspace bound");
+}
+} // namespace
+
+int main(int argc, char** argv) {
+    try {
+        fallback_boundaries();
+        if (argc > 1 && std::string_view(argv[1]) == "--boundary-only") return 0;
+        if (!g::nvfp4_enabled()) throw std::runtime_error("NINFER_GGUF_PREFILL_NVFP4=1 required");
+        if (!g::has_lt_product(g::GgmlType::IQ3_S, 256, form)) return 77;
+        activation_codec();
+        fused_feed_forward();
+        std::vector<Format> fs = {
+            {QType::GGUF_IQ3_XXS, "iq3_xxs", {0}}, {QType::GGUF_IQ3_S, "iq3_s", {0}},
+            {QType::GGUF_IQ2_XXS, "iq2_xxs", {0}}, {QType::GGUF_IQ2_XS, "iq2_xs", {0}},
+            {QType::GGUF_IQ2_S, "iq2_s", {0}},     {QType::GGUF_IQ4_XS, "iq4_xs", {0}},
+            {QType::GGUF_Q2_K, "q2_k", {80, 82}},  {QType::GGUF_Q4_K, "q4_k", {0, 2}},
+            {QType::GGUF_Q6_K, "q6_k", {208}},     {QType::GGUF_IQ1_S, "iq1_s", {0}},
+            {QType::GGUF_IQ1_M, "iq1_m", {}}};
+        for (auto& f : fs) run(f, 24, 256, 129, true);
+        run(fs[1], 128, 5120, 256, false);
+        run(fs[2], 32, 6144, 1024, false);
+        run(fs[5], 24, 17408, 257, false);
+        std::cout
+            << "NVFP4 independent CPU codec, packed decode, FP64 products and public Ops passed\n";
+        return 0;
+    } catch (const std::exception& e) {
+        std::cerr << e.what() << "\n";
+        return 1;
+    }
+}
