+namespace ninfer::ops {
+
+// Match the original FP8 kernel's 32-key softmax and FP16 PV operand
+// boundaries. Its two producer warps each reduce 16 keys and then add their
+// FP32 sums. One warp can reproduce that order in registers for its own rows.
+template<int Half>
+__device__ __forceinline__ void wide_prompt_half(float (&score)[kCausalPromptQKNt][4],
+    float (&acc)[kCausalPromptPVNt][4], const CausalPromptWarpTiles& tiles,
+    float& m0,float& m1,float& l0,float& l1,float& page0,float& page1,
+    int q0,int k0,int r0,int width,int base,float scale,float scale_l2,int lane,
+    bool last_piece,float* out0,float* out1) {
+    constexpr int keys=32, ntiles=keys/8;
+    const int key_base=k0+Half*keys;
+    const int qrow0=q0+r0, qrow1=qrow0+8;
+    const int end0=qrow0<width ? base+qrow0 : -1;
+    const int end1=qrow1<width ? base+qrow1 : -1;
+    const int lid=lane%4;
+    float maximum0=-CUDART_INF_F, maximum1=-CUDART_INF_F;
+#pragma unroll
+    for (int n=0;n<ntiles;++n) {
+        float* s=score[Half*ntiles+n];
+        const int k=key_base+n*8+2*lid;
+        s[0]=k<=end0?s[0]:-CUDART_INF_F; s[1]=k+1<=end0?s[1]:-CUDART_INF_F;
+        s[2]=k<=end1?s[2]:-CUDART_INF_F; s[3]=k+1<=end1?s[3]:-CUDART_INF_F;
+        maximum0=fmaxf(maximum0,fmaxf(s[0],s[1]));
+        maximum1=fmaxf(maximum1,fmaxf(s[2],s[3]));
+    }
+    const float next0=fmaxf(m0,warp_max<4>(maximum0)),next1=fmaxf(m1,warp_max<4>(maximum1));
+    const float scaled0=next0*scale_l2,scaled1=next1*scale_l2;
+    const float a0=m0==-CUDART_INF_F?0:exp2_approx(__fmaf_rn(m0,scale_l2,-scaled0));
+    const float a1=m1==-CUDART_INF_F?0:exp2_approx(__fmaf_rn(m1,scale_l2,-scaled1));
+    float left[2]{},right[2]{};
+    unsigned probability[kCausalPromptPVKs][4];
+#pragma unroll
+    for (int n=0;n<ntiles;++n) {
+        const float* s=score[Half*ntiles+n];
+        const float p0=s[0]>-CUDART_INF_F?exp2_approx(__fmaf_rn(s[0],scale_l2,-scaled0)):0;
+        const float p1=s[1]>-CUDART_INF_F?exp2_approx(__fmaf_rn(s[1],scale_l2,-scaled0)):0;
+        const float p2=s[2]>-CUDART_INF_F?exp2_approx(__fmaf_rn(s[2],scale_l2,-scaled1)):0;
+        const float p3=s[3]>-CUDART_INF_F?exp2_approx(__fmaf_rn(s[3],scale_l2,-scaled1)):0;
+        float* sums=n<2?left:right;
+        sums[0]+=p0+p1; sums[1]+=p2+p3;
+        probability[n/2][(n%2)*2]=pack_f16x2(p0,p1);
+        probability[n/2][(n%2)*2+1]=pack_f16x2(p2,p3);
+    }
+    const float sum0=warp_sum<4>(left[0])+warp_sum<4>(right[0]);
+    const float sum1=warp_sum<4>(left[1])+warp_sum<4>(right[1]);
+    l0=__fmaf_rn(l0,a0,sum0);l1=__fmaf_rn(l1,a1,sum1);m0=next0;m1=next1;
+    if constexpr (Half==0) {page0=sum0;page1=sum1;}
+    else {page0=__fmaf_rn(page0,a0,sum0);page1=__fmaf_rn(page1,a1,sum1);}
+    if (last_piece && lid==0) {
+        if(out0)*out0=page0>0?m0*scale+logf(page0):-CUDART_INF_F;
+        if(out1)*out1=page1>0?m1*scale+logf(page1):-CUDART_INF_F;
+    }
+#pragma unroll
+    for (int n=0;n<kCausalPromptPVNt;++n) {
+        acc[n][0]*=a0;acc[n][1]*=a0;acc[n][2]*=a1;acc[n][3]*=a1;
+    }
+    auto adjusted=tiles;
+    adjusted.v_base+=Half*keys*kCausalPromptHeadDim*sizeof(__half);
+    auto pv=[](float& a,float& b,float& c,float& d,unsigned x,unsigned y,unsigned z,unsigned w,unsigned u,unsigned v){
+        mma_f16(a,b,c,d,x,y,z,w,u,v);
+    };
+    causal_prompt_pv<2>(acc,probability,adjusted,pv);
+}
+
+__global__ __launch_bounds__(128,1) void wide_prompt_fp8_page_attention(
+    const __nv_bfloat16* query, const __nv_bfloat16* key, const __half* value, int stride,
+    const int* positions, int width, float scale, __nv_bfloat16* out,
+    const __grid_constant__ PromptPageLseTile feedback) {
+    if constexpr (!shape_set_in_image(false)) return;
+    using Geometry = CausalD256H24Kv4;
+    constexpr int br=kCausalPromptBr,bc=kCausalPromptBc,dim=kCausalPromptHeadDim;
+    constexpr float log2e=1.4426950408889634f;
+    extern __shared__ __align__(16) unsigned char wide_smem[];
+    auto* qs=reinterpret_cast<__nv_bfloat16*>(wide_smem);
+    auto* ks=qs+br*dim;
+    auto* vs=reinterpret_cast<__half*>(ks+bc*dim);
+    const int tid=threadIdx.x,warp=tid/32,lane=tid%32;
+    const int head=blockIdx.y,q0=blockIdx.x*br,head_group=head/Geometry::GroupSize;
+    const int base=positions[0],last=base+min(q0+br,width)-1;
+    const auto tiles=causal_prompt_warp_tiles(smem_addr(qs),smem_addr(ks),smem_addr(vs),warp*16,lane);
+    // A single warp rotates one represented BF16 query row before QK.
+    for (int row=warp;row<br;row+=4) {
+        float v[8];
+#pragma unroll
+        for (int i=0;i<8;++i) {
+            const int d=lane+32*i;
+            v[i]=q0+row<width ? __bfloat162float(query[(size_t(q0+row)*24+head)*dim+d]) : 0;
+        }
+        normalized_hadamard_d256_inplace(v,lane);
+#pragma unroll
+        for (int i=0;i<8;++i) {
+            const int d=lane+32*i;
+            qs[row*dim+causal_prompt_swz(row,d)]=__float2bfloat16_rn(v[i]);
+        }
+    }
+    const int r0=q0+warp*16+lane/4;
+    const int slot0=feedback.slot(r0),slot1=feedback.slot(r0+8);
+    auto stage=[&](auto* dst,const auto* src,int tile) {
+        const auto* start=src+(size_t(head_group)*stride+tile*bc)*dim;
+#pragma unroll
+        for (int v=tid;v<bc*dim/8;v+=128) {
+            const int row=v/(dim/8),d=v%(dim/8)*8;
+            cp_async<16,Cache::cg>(dst+row*dim+causal_prompt_swz(row,d),start+v*8);
+        }
+        cp_commit();
+    };
+    float acc[kCausalPromptPVNt][4]{};
+    float m0=-CUDART_INF_F,m1=-CUDART_INF_F,l0=0,l1=0;
+    auto qk=[](float& a,float& b,float& c,float& d,unsigned x,unsigned y,unsigned z,unsigned w,unsigned u,unsigned v){
+        mma_bf16(a,b,c,d,x,y,z,w,u,v);
+    };
+    stage(ks,key,0);
+    for (int tile=0;tile<=last/bc;++tile) {
+        cp_wait<0>();__syncthreads();
+        stage(vs,value,tile);
+        float score[kCausalPromptQKNt][4];
+        causal_prompt_qk(score,tiles,qk);
+        auto page=[&](int slot) { return slot>=0 ? feedback.values+(size_t(slot)*24+head)*feedback.pages+tile : nullptr; };
+        cp_wait<0>();__syncthreads();
+        if (tile<last/bc) stage(ks,key,tile+1);
+        // Warps from adjacent 32-query-row groups can have different
+        // causal ends. Retain each group's original number of updates.
+        const int group_last=base+min(width,q0+(warp/2+1)*32)-1;
+        const int k0=tile*bc;
+        float ps0=0,ps1=0;
+        if(k0<=group_last) {
+            const bool second=k0+32<=group_last;
+            wide_prompt_half<0>(score,acc,tiles,m0,m1,l0,l1,ps0,ps1,
+                q0,k0,warp*16+lane/4,width,base,scale,scale*log2e,lane,!second,page(slot0),page(slot1));
+            if(second) wide_prompt_half<1>(score,acc,tiles,m0,m1,l0,l1,ps0,ps1,
+                q0,k0,warp*16+lane/4,width,base,scale,scale*log2e,lane,true,page(slot0),page(slot1));
+        }
+
+    }
+    // The store sums the four per-lane contributions. The original 32-key
+    // order already has their total in every lane.
+    if ((lane%4)!=0) {l0=0;l1=0;}
+    causal_prompt_store<Geometry>(acc,l0,l1,out,head,q0,width,width,warp*16,lane,tid);
+}
+} // namespace ninfer::ops
