+#pragma once
+
+#include "ninfer/kv_cache_storage.h"
+
+#include "core/tensor.h"
+
+#include <cuda_runtime_api.h>
+
+namespace ninfer::ops {
+
+// A write uses the attention call's positions and page table, including its valid
+// column mask. I32 stores one frame per token shared by all KV heads.
+// BF16 stores the full normalized key for exact source reconstruction.
+struct RawKeyWrite {
+    const Tensor* pages = nullptr;
+    Tensor positions;
+    Tensor page_tables;
+    const Tensor* table_rows = nullptr;
+    const Tensor* valid_columns = nullptr;
+    int columns_per_sequence = 0;
+
+    explicit operator bool() const noexcept { return pages != nullptr; }
+};
+
+void write_raw_keys(const RawKeyWrite&, const Tensor& normalized_key, cudaStream_t);
+
+// Move an overlapping run using two independent page reflections on the same stream.
+// Logical pages may map to nonconsecutive physical pages.
+void move_compact_plane(const Tensor& plane, const Tensor& page_table, int src, int dst,
+                        int pages, cudaStream_t stream);
+
+// Rotate native K by its position change (I32) or rebuild from normalized K (BF16).
+// The rows' position indices are their dense logical slots in the page table.
+void materialize_compact_keys(const Tensor& raw_pages, const Tensor& key_pages,
+                              const Tensor& scale_pages, KvCacheStorage storage, const Tensor& page_table,
+                              int begin, int count, cudaStream_t);
+
+} // namespace ninfer::ops
