+CompactPageMoves plan_compact_page_moves(std::span<const std::uint32_t> resident,
+    std::span<const std::uint32_t> chosen, std::span<const std::uint32_t> prior, std::uint32_t limit) {
+    CompactPageMoves plan;
+    if (prior.size() > resident.size() || !std::is_sorted(resident.begin(),resident.end()) ||
+        std::adjacent_find(resident.begin(),resident.end()) != resident.end() ||
+        !std::is_sorted(chosen.begin(),chosen.end()) || std::adjacent_find(chosen.begin(),chosen.end()) != chosen.end())
+        throw std::logic_error("invalid accepted map for native RoPE reuse");
+    plan.first_changed = static_cast<std::uint32_t>(chosen.size());
+    auto it = resident.begin();
+    for (std::uint32_t dst=0; dst<chosen.size(); ++dst) {
+        it = std::lower_bound(it,resident.end(),chosen[dst]);
+        const std::int32_t src = it != resident.end() && *it == chosen[dst] ? std::int32_t(it-resident.begin()) : -1;
+        std::uint32_t count = src >= 0 && std::size_t(src)<prior.size() ? prior[src] : 0;
+        if (src != std::int32_t(dst)) {
+            plan.first_changed = std::min(plan.first_changed,dst);
+            if (src < 0) plan.cold.push_back(dst);
+            else if (count >= limit) { plan.capped.push_back(dst); count=0; }
+            else ++count;
+        }
+        plan.sources.push_back(src);
+        plan.counts.push_back(count);
+    }
+    return plan;
+}
