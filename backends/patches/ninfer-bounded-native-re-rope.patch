+    [[nodiscard]] std::uint32_t rope_reuse_limit(KvCacheStorage storage) const {
+        switch (storage) {
+        case KvCacheStorage::BFloat16: case KvCacheStorage::Int8Group64:
+        case KvCacheStorage::RotatedInt8KeyInt4ValueGroup64: return compact_rope_reuse_limit.value_or(32);
