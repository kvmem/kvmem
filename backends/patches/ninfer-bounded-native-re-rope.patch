+        case KvCacheStorage::Nvfp4Group16: case KvCacheStorage::RotatedLloyd4KeyInt4Value: return compact_rope_reuse_limit.value_or(2);
+        case KvCacheStorage::RotatedInt4KeyInt4ValueE8: return compact_rope_reuse_limit.value_or(1);
+        case KvCacheStorage::RotatedE8RootKeyInt4Value: return compact_rope_reuse_limit.value_or(0);
+        case KvCacheStorage::Bf16Packed: case KvCacheStorage::Float16:
+        case KvCacheStorage::Mxfp8: break;
+        }
+        throw std::invalid_argument("--kvmem-re-rope does not support this KV format");
