+int compact_key_batched_capture(bool masked) {
+    constexpr int heads = 2, sequences = 3;
+    constexpr int pages_per_row = 2, physical_pages = pages_per_row * sequences;
+    const int width = masked ? 4 : 1;
+    const int tokens = sequences * width;
+    const std::vector<int> table{0, 3, 2, 5, 4, 1};
+    const std::vector<int> table_rows{2, 0, 1};
+    const std::vector<int> valid{3, 0, 4};
+    std::vector<int> positions(tokens);
+    for (int i = 0; i < tokens; ++i) positions[i] = 62 + i % width;
+    auto bits = patterned_bits(tokens * heads * kFullHeadDim, 9183U);
+    std::vector<std::uint16_t> expected(kPage * heads * physical_pages * kFullHeadDim);
+    auto dk = to_device(bits), dt = to_device(table), dp = to_device(positions);
+    auto dr = to_device(table_rows), dv = to_device(valid), raw = to_device(expected);
+    const Tensor raw_plane(raw.p, DType::BF16, {kFullHeadDim, kPage, heads, physical_pages});
+    const Tensor key(dk.p, DType::BF16, {kFullHeadDim, heads, tokens});
+    const Tensor pos(dp.p, DType::I32, {width, sequences});
+    const Tensor page_table(dt.p, DType::I32, {pages_per_row, sequences});
+    const Tensor rows(dr.p, DType::I32, {sequences});
+    const Tensor counts(dv.p, DType::I32, {sequences});
+    ops::write_raw_keys({&raw_plane, pos, page_table, &rows, masked ? &counts : nullptr, width}, key, nullptr);
+    for (int i = 0; i < tokens; ++i) {
+        const int lane = i / width;
+        if (masked && i % width >= valid[lane]) continue;
+        const int slot = positions[i];
+        const int physical = table[table_rows[lane] * pages_per_row + slot / kPage];
+        for (int head = 0; head < heads; ++head) {
+            for (int dim = 0; dim < kFullHeadDim; ++dim) {
+                expected[full_cache_index(kFullHeadDim, dim, head, slot, physical, heads)] =
+                    bits[full_input_index(dim, head, i, heads)];
+            }
+        }
+    }
+    return verify_exact(masked ? "compact FP8 masked rows" : "compact FP8 ordinary rows",
+                        from_device<std::uint16_t>(raw, expected.size()), expected);
+}
