+constexpr int kTokensPerBlock = 4;
+
+__global__ void write_raw(const __nv_bfloat16* key, __nv_bfloat16* raw, const int* positions,
+                          const int* tables, int table_stride, const int* rows,
+                          const int* valid, int width, int tokens, int heads) {
+    const int token = blockIdx.x * kTokensPerBlock + threadIdx.y;
+    if (token >= tokens) return;
+    const int sequence = token / width;
+    if (valid && token % width >= valid[sequence]) return;
+    const int* table = tables + (rows ? static_cast<std::int64_t>(rows[sequence]) * table_stride : 0);
+    const int pos = positions[token];
+    const int page = paged_kv_physical_page(table, pos);
+    const int head = blockIdx.y;
+    const int lane = threadIdx.x;
+#pragma unroll
+    for (int group = 0; group < 8; ++group) {
+        const int dim = lane + 32 * group;
+        raw[kv_cache_fp8_code_index(page, head, dim, pos & kPagedKVPageMask, heads)] =
+            key[kv_cache_fp8_src_index(head, dim, token, heads)];
+    }
+}
+
+// In-place codecs must finish reading a whole represented row before any lane
+// overwrites its original group scale or packed codes.
+template <KvCacheStorage Storage>
+__device__ void encode_transformed(float (&values)[8], void* keys, void* scales,
+                                  int page, int head, int offset, int heads, int lane) {
+    if constexpr (Storage == KvCacheStorage::Fp8E4M3Row256) {
+        auto* output = static_cast<std::uint8_t*>(keys);
+        auto* output_scales = static_cast<__half*>(scales);
+        float maximum = 0.0F;
+        for (float v : values) maximum = fmaxf(maximum, fabsf(v));
+        const auto quant = kv_cache_fp8_quant_params(warp_max(maximum, 0xffffffffU));
+#pragma unroll
+        for (int group = 0; group < 8; ++group) {
+            output[kv_cache_fp8_code_index(page, head, lane + 32 * group, offset, heads)] =
+                kv_cache_fp8_quant_code(values[group], quant.inverse_scale);
+        }
+        if (lane == 0)
+            output_scales[kv_cache_fp8_scale_index(page, head, offset, heads)] = quant.scale;
+    } else if constexpr (Storage == KvCacheStorage::Nvfp4Group16) {
+        __shared__ float rows[kTokensPerBlock][kD256KVCacheHeadDim];
+        auto* scratch = rows[threadIdx.y];
+#pragma unroll
+        for (int group = 0; group < 8; ++group) scratch[lane + 32 * group] = values[group];
+        __syncwarp();
+        if (lane < kKVCacheNvfp4Groups) {
+            const auto quant = kv_cache_nvfp4_quantize_group16(scratch + lane * kKVCacheNvfp4Group);
+            auto* output = static_cast<std::uint8_t*>(keys);
+            auto* output_scales = static_cast<std::uint8_t*>(scales);
+            const auto code = kv_cache_nvfp4_code_index(
+                page, head, lane * kKVCacheNvfp4Group, offset, heads);
+            store_vec(output + code, make_uint2(quant.codes_lo, quant.codes_hi));
+            output_scales[kv_cache_nvfp4_scale_index(page, head, lane, offset, heads)] = quant.scale;
+        }
+    } else {
+        constexpr auto coding = Storage == KvCacheStorage::RotatedLloyd4KeyInt4Value
+            ? KvKeyCoding::Lloyd4
+            : Storage == KvCacheStorage::RotatedInt4KeyInt4ValueE8
+            ? KvKeyCoding::Int4E8
+            : Storage == KvCacheStorage::RotatedE8RootKeyInt4Value
+            ? KvKeyCoding::RootE8
+            : KvKeyCoding::Int8;
+#pragma unroll
+        for (int group = 0; group < kKVCacheInt8Groups; ++group) {
+            kv_cache_i8_family_store_key_group<coding>(
+                static_cast<std::int8_t*>(keys), static_cast<__half*>(scales), page, head,
+                group, offset, lane, values[2 * group], values[2 * group + 1], heads);
+        }
+    }
+}
+
+__global__ void write_positions(int* frame, const int* positions, const int* tables,
+                                int stride, const int* rows, const int* valid,
+                                int width, int count, int begin) {
+    const int i = blockIdx.x * blockDim.x + threadIdx.x;
+    if (i >= count) return;
+    const int sequence = i / width;
+    if (valid && i % width >= valid[sequence]) return;
+    const int pos = positions ? positions[i] : begin + i;
+    const int* table = tables + (rows ? std::int64_t(rows[sequence]) * stride : 0);
+    frame[std::int64_t(paged_kv_physical_page(table, pos)) * kPagedKVPageSize +
+          (pos & kPagedKVPageMask)] = pos;
+}
+
+template <KvCacheStorage Storage>
+__device__ float decoded_key(const void* keys, const void* scales,
+                             int page, int head, int offset, int heads, int d) {
+    const auto* codes = static_cast<const std::uint8_t*>(keys);
+    if constexpr (Storage == KvCacheStorage::Fp8E4M3Row256) {
+        __nv_fp8_e4m3 code;
+        code.__x = codes[kv_cache_fp8_code_index(page, head, d, offset, heads)];
+        return static_cast<float>(code) * __half2float(static_cast<const __half*>(scales)[
+            kv_cache_fp8_scale_index(page, head, offset, heads)]);
+    } else if constexpr (Storage == KvCacheStorage::Nvfp4Group16) {
+        const auto pair = __half22float2(kv_cache_nvfp4_pair_to_half2(
+            codes[kv_cache_nvfp4_code_index(page, head, d, offset, heads)]));
+        return (d & 1 ? pair.y : pair.x) * kv_cache_nvfp4_scale_to_float(
+            static_cast<const std::uint8_t*>(scales)[kv_cache_nvfp4_scale_index(page, head, d / 16, offset, heads)]);
+    } else {
+        int code;
+        if constexpr (Storage == KvCacheStorage::RotatedE8RootKeyInt4Value) {
+            const auto address = kv_cache_e8_root_code_index(page, head, (d / 8) * 2, offset, heads);
+            const auto word = load_vec<std::uint16_t>(codes + address);
+            const auto decoded = kv_cache_e8_root_decode_block(word & 255, word >> 8);
+            code = static_cast<std::int8_t>((d & 4 ? decoded.y : decoded.x) >> (8 * (d & 3)));
+        } else if constexpr (Storage == KvCacheStorage::RotatedLloyd4KeyInt4Value ||
+                             Storage == KvCacheStorage::RotatedInt4KeyInt4ValueE8) {
+            const auto bits = codes[kv_cache_int4_value_code_index(page, head, d / 2, offset, heads)];
+            if constexpr (Storage == KvCacheStorage::RotatedLloyd4KeyInt4Value)
+                code = kv_cache_lloyd4_code((bits >> (4 * (d & 1))) & 15);
+            else
+                code = kv_cache_int4_unpack(bits, d & 1);
+        } else {
+            code = static_cast<const std::int8_t*>(keys)[kv_cache_int8_quant_code_index(page, head, d, offset, heads)];
+        }
+        return code * __half2float(static_cast<const __half*>(scales)[
+            kv_cache_int8_quant_scale_index(page, head, d / 64, offset, heads)]);
+    }
+}
+
+template <KvCacheStorage Storage>
+__global__ void rotate_native(const int* positions, void* keys, void* scales, const int* table,
+                              int begin, int count, int heads) {
+    const int i = blockIdx.x * kTokensPerBlock + threadIdx.y;
+    if (i >= count) return;
+    const int pos = begin + i;
+    const int page = paged_kv_physical_page(table, pos), offset = pos & kPagedKVPageMask;
+    const int delta = pos - positions[std::int64_t(page) * kPagedKVPageSize + offset];
+    if (delta == 0) return;
+    const int lane = threadIdx.x, head = blockIdx.y;
+    float sine, cosine;
+    sincosf(static_cast<float>(delta) * kTextRopeInvFrequency[lane], &sine, &cosine);
+    if constexpr (Storage == KvCacheStorage::BFloat16) {
+        auto* row = static_cast<__nv_bfloat16*>(keys) + kv_cache_fp8_code_index(page, head, lane, offset, heads);
+        const float x = __bfloat162float(row[0]), y = __bfloat162float(row[32]);
+        row[0] = __float2bfloat16_rn(x * cosine - y * sine);
+        row[32] = __float2bfloat16_rn(x * sine + y * cosine);
+    } else {
+        float values[8];
+        float even = 0.f, odd = 0.f;
+#pragma unroll
+        for (int j = 0; j < 8; j += 2) {
+            values[j] = decoded_key<Storage>(keys, scales, page, head, offset, heads, lane + 32*j);
+            values[j+1] = decoded_key<Storage>(keys, scales, page, head, offset, heads, lane + 32*(j+1));
+            even += values[j]; odd += values[j+1];
+        }
+        // H256 is self-inverse. Only the first two H32 columns of inverse-H
+        // participate in RoPE. Transform their change back into the stored
+        // basis; two factors of 1/16 give 1/256.
+        float pair[2]{even + odd, even - odd};
+        hadamard_d32_columns_inplace(pair, lane);
+        const float dx = (cosine - 1.f) * pair[0] - sine * pair[1];
+        const float dy = sine * pair[0] + (cosine - 1.f) * pair[1];
+        pair[0] = (dx + dy) / 256.f; pair[1] = (dx - dy) / 256.f;
+        hadamard_d32_columns_inplace(pair, lane);
+#pragma unroll
+        for (int j = 0; j < 8; ++j) values[j] += pair[j & 1];
+        __syncwarp();
+        encode_transformed<Storage>(values, keys, scales, page, head, offset, heads, lane);
+        if constexpr (Storage == KvCacheStorage::RotatedInt4KeyInt4ValueE8 ||
+                      Storage == KvCacheStorage::RotatedE8RootKeyInt4Value) {
+            // The lattice encoder chooses a radius as well as a direction. Feeding
+            // its own decoded codes back into the absmax fit can increase the
+            // group's gain on every move. Keep the energy of the rotated G64
+            // input with one represented FP16 scale on the same output codes.
+            __syncwarp();
+#pragma unroll
+            for (int g=0; g<4; ++g) {
+                const auto d=g*64+lane;
+                const float a=decoded_key<Storage>(keys,scales,page,head,offset,heads,d);
+                const float b=decoded_key<Storage>(keys,scales,page,head,offset,heads,d+32);
+                const float have=warp_sum(a*a+b*b,0xffffffffU);
+                const float x=values[2*g], y=values[2*g+1];
+                const float wanted=warp_sum(x*x+y*y,0xffffffffU);
+                if (lane==0 && have>0.f) {
+                    auto& gain=static_cast<__half*>(scales)[kv_cache_int8_quant_scale_index(page,head,g,offset,heads)];
+                    gain=__float2half_rn(__half2float(gain)*sqrtf(wanted/have));
+                }
+            }
+        }
+    }
+}
+
+template <KvCacheStorage Storage>
+__global__ void rebuild_keys(const __nv_bfloat16* raw, void* keys, void* scales,
+                             const int* table, int begin, int count, int heads) {
+    const int token = blockIdx.x * kTokensPerBlock + threadIdx.y;
+    if (token >= count) return;
+    const int pos = begin + token;
+    const int page = paged_kv_physical_page(table, pos);
+    const int offset = pos & kPagedKVPageMask;
+    const int head = blockIdx.y;
+    const int lane = threadIdx.x;
+    float values[8];
+#pragma unroll
+    for (int group = 0; group < 8; ++group) {
+        values[group] = __bfloat162float(
+            raw[kv_cache_fp8_code_index(page, head, lane + 32 * group, offset, heads)]);
+    }
+    float sine, cosine;
+    sincosf(static_cast<float>(pos) * kTextRopeInvFrequency[lane], &sine, &cosine);
+    const float first = values[0], second = values[1];
+    // The normal append consumes a BF16 K, including this rounding after RoPE.
+    values[0] = __bfloat162float(__float2bfloat16_rn(first * cosine - second * sine));
+    values[1] = __bfloat162float(__float2bfloat16_rn(first * sine + second * cosine));
+
+    if constexpr (Storage == KvCacheStorage::BFloat16) {
+        auto* output = static_cast<__nv_bfloat16*>(keys);
+#pragma unroll
+        for (int group = 0; group < 8; ++group) {
+            output[kv_cache_fp8_code_index(page, head, lane + 32 * group, offset, heads)] =
+                __float2bfloat16_rn(values[group]);
+        }
+    } else {
+        normalized_hadamard_d256_inplace(values, lane);
+        encode_transformed<Storage>(values, keys, scales, page, head, offset, heads, lane);
+    }
+}
+
+// Copy a reversed source interval into its destination. Within the overlap,
+// the reflection consists of disjoint pairs; outside it, only the destination
+// is written. A second reflection of the destination completes memmove. All
+// page vectors run in parallel, even for a one-page shift of a long window.
+__global__ void reflect_pages(uint4* data, const int* table, int src, int dst,
+                              int count, int vectors) {
+    const auto index = std::int64_t(blockIdx.x) * blockDim.x + threadIdx.x;
+    if (index >= std::int64_t(count)*vectors) return;
+    const int row = int(index / vectors), offset = int(index % vectors);
+    const int here=dst+row, peer=src+count-1-row;
+    const bool swap = peer>=dst && peer<dst+count;
+    if (swap && here>=peer) return;
+    auto* a=data+std::int64_t(table[here])*vectors+offset;
+    auto* b=data+std::int64_t(table[peer])*vectors+offset;
+    const auto value=*b;
+    if (swap) *b=*a;
+    *a=value;
+}
+
+bool is_page_plane(const Tensor& plane, int leading, int heads, int pages) {
+    return plane.data && plane.is_contiguous() && plane.ne[0] == leading &&
+        plane.ne[1] == kPagedKVPageSize && plane.ne[2] == heads && plane.ne[3] == pages;
+}
+
+bool is_i32_input(const Tensor& tensor, std::int64_t size) {
+    return tensor.data && tensor.dtype == DType::I32 && tensor.is_contiguous() &&
+        tensor.numel() == size;
+}
+
+} // namespace
+
+void move_compact_plane(const Tensor& plane, const Tensor& table, int src, int dst,
+                        int pages, cudaStream_t stream) {
+    if (pages<=0 || src==dst) return;
+    if (!plane.data || !plane.is_contiguous() || plane.nb[3]%sizeof(uint4) ||
+        src<0 || dst<0 || table.dtype!=DType::I32 || !table.data || !table.is_contiguous() ||
+        std::int64_t(std::max(src,dst))+pages>table.ne[0])
+        throw std::invalid_argument("invalid native RoPE plane move");
+    const int vectors=static_cast<int>(plane.nb[3]/sizeof(uint4));
+    const auto elements=std::int64_t(pages)*vectors;
+    if (!vectors || (elements+127)/128>INT32_MAX) throw std::invalid_argument("native RoPE plane run is too large");
+    for (int from:{src,dst}) {
+        reflect_pages<<<(elements+127)/128,128,0,stream>>>(static_cast<uint4*>(plane.data),
+            static_cast<const int*>(table.data),from,dst,pages,vectors);
+        CUDA_CHECK(cudaGetLastError());
+    }
+}
+
+void write_raw_keys(const RawKeyWrite& output, const Tensor& normalized_key, cudaStream_t stream) {
+    if (!output) return;
+    const auto& raw = *output.pages;
+    const int heads = normalized_key.ne[1], tokens = normalized_key.ne[2];
+    const int width = output.columns_per_sequence;
+    const auto& table = output.page_tables;
+    const bool native = raw.dtype == DType::I32;
+    if (!(native ? is_page_plane(raw, 1, 1, raw.ne[3]) :
+            raw.dtype == DType::BF16 && is_page_plane(raw, 256, heads, raw.ne[3])) ||
+        normalized_key.dtype != DType::BF16 || !normalized_key.is_contiguous() ||
+        normalized_key.ne[0] != 256 || normalized_key.ne[1] != heads ||
+        width <= 0 || tokens <= 0 || tokens % width ||
+        !is_i32_input(output.positions, tokens) ||
+        !table.data || table.dtype != DType::I32 || !table.is_contiguous() ||
+        (output.table_rows && !is_i32_input(*output.table_rows, tokens / width)) ||
+        (output.valid_columns && (!output.table_rows ||
+            !is_i32_input(*output.valid_columns, tokens / width))) ||
+        (!output.table_rows && width != tokens)) {
+        throw std::invalid_argument("invalid pre-RoPE key write geometry");
+    }
+    if (native) {
+        write_positions<<<(tokens + 127)/128, 128, 0, stream>>>(
+            static_cast<int*>(raw.data), static_cast<const int*>(output.positions.data),
+            static_cast<const int*>(table.data), table.ne[0],
+            output.table_rows ? static_cast<const int*>(output.table_rows->data) : nullptr,
+            output.valid_columns ? static_cast<const int*>(output.valid_columns->data) : nullptr, width, tokens, 0);
+        CUDA_CHECK(cudaGetLastError());
+        return;
+    }
+    write_raw<<<dim3((tokens + kTokensPerBlock - 1) / kTokensPerBlock, heads),
+                dim3(32, kTokensPerBlock), 0, stream>>>(
+        static_cast<const __nv_bfloat16*>(normalized_key.data),
+        static_cast<__nv_bfloat16*>(raw.data),
+        static_cast<const int*>(output.positions.data), static_cast<const int*>(table.data), table.ne[0],
+        output.table_rows ? static_cast<const int*>(output.table_rows->data) : nullptr,
+        output.valid_columns ? static_cast<const int*>(output.valid_columns->data) : nullptr,
+        width, tokens, heads);
+    CUDA_CHECK(cudaGetLastError());
+}
+
+void materialize_compact_keys(const Tensor& raw, const Tensor& key, const Tensor& scale,
+                              KvCacheStorage storage, const Tensor& table, int begin, int count,
+                              cudaStream_t stream) {
+    const auto profile = d256_kv_cache_profile(storage);
+    const int heads = key.ne[2], pages = key.ne[3];
+    const bool native = raw.dtype == DType::I32;
+    const bool valid_scale = profile.quant_group
+        ? scale.dtype == profile.key_scale_dtype &&
+            is_page_plane(scale, profile.scale_leading_extent, heads, pages)
+        : !scale.data;
+    if (begin < 0 || count <= 0 || (std::int64_t(begin) + count - 1) / kPagedKVPageSize >= table.ne[0] ||
+        heads <= 0 || pages <= 0 ||
+        !(native ? is_page_plane(raw, 1, 1, pages) :
+            raw.dtype == DType::BF16 && is_page_plane(raw, kD256KVCacheHeadDim, heads, pages)) ||
+        key.dtype != profile.key_code_dtype || !is_page_plane(key, profile.key_leading_extent, heads, pages) ||
+        !valid_scale || table.dtype != DType::I32 || !table.is_contiguous() || !table.data) {
+        throw std::invalid_argument("invalid compact key materialization");
+    }
+    const auto launch = [&]<KvCacheStorage Format>() {
+        if (native) {
+            rotate_native<Format><<<dim3((count + kTokensPerBlock - 1)/kTokensPerBlock, heads),
+                                    dim3(32, kTokensPerBlock), 0, stream>>>(
+                static_cast<const int*>(raw.data), key.data, scale.data, static_cast<const int*>(table.data), begin, count, heads);
+            return;
+        }
+        rebuild_keys<Format><<<dim3((count + kTokensPerBlock - 1) / kTokensPerBlock, heads),
+                               dim3(32, kTokensPerBlock), 0, stream>>>(
+            static_cast<const __nv_bfloat16*>(raw.data), key.data, scale.data,
+            static_cast<const int*>(table.data), begin, count, heads);
+    };
+    switch (storage) {
+    case KvCacheStorage::BFloat16:
+        launch.operator()<KvCacheStorage::BFloat16>();
+        break;
+    case KvCacheStorage::Fp8E4M3Row256:
+    case KvCacheStorage::Fp8KeyNvfp4Value:
+        launch.operator()<KvCacheStorage::Fp8E4M3Row256>();
+        break;
+    case KvCacheStorage::Nvfp4Group16:
+        launch.operator()<KvCacheStorage::Nvfp4Group16>();
+        break;
+    case KvCacheStorage::Int8Group64:
+    case KvCacheStorage::RotatedInt8KeyInt4ValueGroup64:
+        launch.operator()<KvCacheStorage::Int8Group64>();
+        break;
+    case KvCacheStorage::RotatedLloyd4KeyInt4Value:
+        launch.operator()<KvCacheStorage::RotatedLloyd4KeyInt4Value>();
+        break;
+    case KvCacheStorage::RotatedInt4KeyInt4ValueE8:
+        launch.operator()<KvCacheStorage::RotatedInt4KeyInt4ValueE8>();
+        break;
+    case KvCacheStorage::RotatedE8RootKeyInt4Value:
+        launch.operator()<KvCacheStorage::RotatedE8RootKeyInt4Value>();
+        break;
+    default:
+        throw std::invalid_argument("unsupported compact RoPE KV format");
+    }
+    CUDA_CHECK(cudaGetLastError());
+    if (native) {
+        // Publish the new frame after every KV head has read the old one.
+        write_positions<<<(count + 127)/128, 128, 0, stream>>>(static_cast<int*>(raw.data), nullptr,
+            static_cast<const int*>(table.data), table.ne[0], nullptr, nullptr, count, count, begin);
+        CUDA_CHECK(cudaGetLastError());
+    }
+}
+
+} // namespace ninfer::ops
