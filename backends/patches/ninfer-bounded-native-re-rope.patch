+    const std::array<std::uint32_t, count> old{5, 10, 20, 30, 40}, chosen{4, 5, 20, 40, 44},
+                                           counters{0, 0, 1, 0, 1};
+    const auto plan = store::plan_compact_page_moves(old, chosen, counters, 1);
+    const std::array<std::size_t, 5> planes{0, 1, 2, 3, 4};
+    const std::array<std::size_t, 3> keys{0, 2, 4};
+    std::array<unsigned, count> reads{};
+    const auto archive_byte = [](std::size_t dst, std::size_t offset) {
+        return std::byte((dst * 37 + offset * 11) % 241);
+    };
+    store::transfer_compact_pages(plan, planes, keys, pool, addresses, *address, device.stream, &stage,
+        [&](std::uint32_t dst, std::size_t off, void* output, std::size_t len) {
+            ++reads.at(dst);
+            for (std::size_t j = 0; j < len; ++j)
