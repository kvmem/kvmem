+std::optional<NativeCompactKeyPlanes> compact_planes(
+    const kvmem::NativeKvLayerRegions& regions, std::span<const std::size_t> planes,
+    std::optional<KvCacheStorage> storage) {
+    NativeCompactKeyPlanes result{SIZE_MAX, SIZE_MAX, SIZE_MAX, KvCacheStorage::BFloat16};
+    const auto items = regions.regions();
+    for (std::size_t i = 0; i < items.size(); ++i) {
+        switch (items[i].plane.kind) {
+        case kvmem::PayloadPlaneKind::Key: result.key = planes[i]; break;
+        case kvmem::PayloadPlaneKind::KeyScale: result.scale = planes[i]; break;
+        case kvmem::PayloadPlaneKind::KeyPosition:
+        case kvmem::PayloadPlaneKind::RawKey: result.raw = planes[i]; break;
+        default: break;
+        }
+    }
+    if (result.raw == SIZE_MAX) return std::nullopt;
+    if (!storage || result.key == SIZE_MAX)
+        throw std::logic_error("pre-RoPE plane requires a native key encoding");
+    const bool scaled = ops::d256_kv_cache_profile(*storage).quant_group != 0;
+    if (scaled != (result.scale != SIZE_MAX) || items.size() != (scaled ? 5U : 3U))
+        throw std::logic_error("pre-RoPE plane does not match its native KV geometry");
+    result.storage = *storage;
+    return result;
+}
