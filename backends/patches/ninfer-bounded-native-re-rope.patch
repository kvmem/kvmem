+// Different sentinel data in the archive and resident pool expose spurious reads.
+// The last plane represents a peer layer sharing the same physical page table.
+void qualify_bounded_reload(DeviceContext& device, PagedKVPlaneOrder order) {
+    constexpr std::size_t count = 5;
+    LayoutBuilder builder;
+    DeviceKVPagePoolSpec spec;
+    spec.page_group_count = count;
+    spec.geometry.page_tokens = 64;
+    spec.geometry.device_plane_order = order;
+    for (const auto& plane : std::vector<KVPlaneGeometry>{
+             {DType::I8, 16, 2}, {DType::I8, 16, 2}, {DType::FP16, 1, 2},
+             {DType::FP16, 1, 2}, {DType::I32, 1, 1}, {DType::I8, 16, 2}})
+        spec.geometry.planes.push_back(plane);
+    const auto layout = plan_device_kv_page_pool(builder, spec);
+    const auto table_layout = plan_kv_execution_tables(builder, {count, 1});
+    DeviceArena arena(builder.finish(256));
+    const DeviceSpan backing{arena.base(), arena.capacity()};
+    DeviceKVPagePool pool(backing, layout);
+    KVExecutionTablePool tables(backing, table_layout, pool);
+    store::LogicalKVPageStore pages(pool, count);
+    store::KVAddressSpaceStore addresses(pages, tables, 2, count);
+    auto address = addresses.create_active(count, 0, device.stream);
+    check(bool(address), "bounded reload address admission failed");
+    addresses.ensure_mapped_to_tokens(*address, count * 64, device.stream);
+    const auto host = plan_host_kv_page_layout(pool.geometry());
+    PinnedHostBuffer initial(count * host.page_stride), actual(count * host.page_stride), stage(host.page_stride);
+    auto* bytes = static_cast<std::byte*>(initial.data());
+    for (std::size_t i = 0; i < initial.size(); ++i) bytes[i] = std::byte((i + i / 251) % 251);
+    std::array<DeviceKVPageHandle, count> handles;
+    for (std::size_t i = 0; i < count; ++i) handles[i] = addresses.physical_page(*address, i);
+    pool.copy_from_host(bytes, host, handles, device.stream);
+    const std::array<std::uint32_t, count> old{5, 10, 20, 30, 40}, chosen{4, 5, 20, 40, 44},
+                                           counters{0, 0, 1, 0, 1};
+    const auto plan = store::plan_compact_page_moves(old, chosen, counters, 1);
+    const std::array<std::size_t, 5> planes{0, 1, 2, 3, 4};
+    const std::array<std::size_t, 3> keys{0, 2, 4};
+    std::array<unsigned, count> reads{};
+    const auto archive_byte = [](std::size_t dst, std::size_t offset) {
+        return std::byte((dst * 37 + offset * 11) % 241);
+    };
+    store::transfer_compact_pages(plan, planes, keys, pool, addresses, *address, device.stream, &stage,
+        [&](std::uint32_t dst, std::size_t off, void* output, std::size_t len) {
+            ++reads.at(dst);
+            for (std::size_t j = 0; j < len; ++j)
+                static_cast<std::byte*>(output)[j] = archive_byte(dst, off+j);
+        });
+    check(reads == std::array<unsigned, count>{5, 0, 0, 3, 5}, "wrong set of archive reads");
+    pool.copy_to_host(handles, static_cast<std::byte*>(actual.data()), host, device.stream);
+    device.synchronize();
+    for (std::size_t dst = 0; dst < count; ++dst) {
+        for (std::size_t p = 0; p < host.planes.size(); ++p) {
+            const auto& plane = host.planes[p];
+            const bool peer = p == 5;
+            const bool canonical = !peer && (dst == 0 || dst == 4 || (dst == 3 && (p == 0 || p == 2 || p == 4)));
+            for (std::size_t j = 0; j < plane.page_payload_bytes; ++j) {
+                const auto off = plane.offset + j;
+                const auto expected = canonical ? archive_byte(dst, off)
+                    : bytes[(peer ? dst : static_cast<std::size_t>(plan.sources[dst])) * host.page_stride + off];
+                check(static_cast<const std::byte*>(actual.data())[dst * host.page_stride + off] == expected,
+                      "bounded reload changed a resident V, peer layer, or canonical key plane");
+            }
+        }
+    }
+    check(addresses.release_after_deactivate(*address) && pool.allocated_pages() == 0,
+          "bounded reload leaked native ownership");
+}
+
+void qualify_native_moves() {
+    const std::vector<std::uint32_t> old{1,3,5,7,9,11}, keep{0,1,3,7,11,12};
+    const std::vector<std::uint32_t> counters{0,2,1,2};
+    const auto m=store::plan_compact_page_moves(old,keep,counters,2);
+    check(m.sources==std::vector<std::int32_t>{-1,0,1,3,5,-1},"wrong resident source");
+    check(m.cold==std::vector<std::uint32_t>{0,5} && m.capped==std::vector<std::uint32_t>{2},
+          "wrong cold or forced reload pages");
+    check(m.counts==std::vector<std::uint32_t>{0,1,0,2,1,0},"unmoved blocks consumed a move");
+    const auto zero=store::plan_compact_page_moves(old,keep,{},0);
+    check(zero.capped==std::vector<std::uint32_t>{1,2,4},"limit zero reused a moved page");
+    const auto again=store::plan_compact_page_moves(keep,keep,m.counts,2);
+    check(again.first_changed==keep.size() && again.counts==m.counts,"identity move changed reuse history");
+}
