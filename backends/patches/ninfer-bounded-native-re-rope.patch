+int compact_plane_moves() {
+    constexpr int count = 19, width = 4;
+    std::vector<std::int32_t> pages(count);
+    std::vector<std::uint8_t> original(count * kPage * width);
+    for (int page = 0; page < count; ++page) pages[page] = page * 7 % count;
+    for (std::size_t i = 0; i < original.size(); ++i)
+        original[i] = static_cast<std::uint8_t>((i * 11 + i / 251) % 253);
+    const auto mapping = to_device(pages);
+    const Tensor table(mapping.p, DType::I32, {count});
+    int failures = 0;
+    for (const auto& [src, dst, length] : std::array<std::array<int, 3>, 7>{{
+             {1, 0, 18}, {0, 1, 18}, {5, 2, 11}, {2, 5, 11}, {1, 12, 4}, {5, 5, 3}, {2, 1, 0}}}) {
+        auto expected = original;
+        for (int i = 0; i < length; ++i)
+            std::copy_n(original.begin() + pages[src+i] * kPage * width, kPage * width,
+                        expected.begin() + pages[dst+i] * kPage * width);
+        const auto storage = to_device(original);
+        ops::move_compact_plane(Tensor(storage.p, DType::U8, {width, kPage, 1, count}),
+                                table, src, dst, length, nullptr);
