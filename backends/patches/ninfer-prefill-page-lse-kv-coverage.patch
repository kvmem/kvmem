+namespace ninfer::ops {
+
+struct PromptPageLseTile {
+    float* values = nullptr;
+    int pages = 0;
+    int samples = 0;
+    int rows[PromptPageLse::max_samples]{};
+
+    __device__ __forceinline__ int slot(int row) const {
+        int lo = 0, hi = samples;
+        while (lo < hi) {
+            const int middle = (lo + hi) / 2;
+            if (rows[middle] < row) lo = middle + 1; else hi = middle;
+        }
+        return lo < samples && rows[lo] == row ? lo : -1;
+    }
+};
+
+static __global__ void clear_prompt_page_lse(float* values, int n) {
+    const int i = blockIdx.x * blockDim.x + threadIdx.x;
+    if (i < n) values[i] = -CUDART_INF_F;
+}
+
+inline bool prepare_prompt_page_lse_tile(const Tensor& q, PagedKVBatchLayerView cache,
+                                        std::uint32_t max_visible, const PromptPageLse& capture,
+                                        PromptPageLseTile& tile, cudaStream_t stream) {
+    const auto& scratch = capture.scratch;
+    const int n = capture.count;
+    if (n <= 0 || n > PromptPageLse::max_samples || scratch.dtype != DType::FP32 ||
+        !scratch.data || !scratch.is_contiguous() || scratch.ne[0] <= 0 ||
+        scratch.ne[0] > cache.block_tables.ne[0] || std::uint64_t(scratch.ne[0]) * 64 < max_visible ||
+        scratch.ne[1] != q.ne[1] || scratch.ne[2] != n || scratch.ne[3] != 1 || scratch.numel() > INT_MAX)
+        return false;
+    for (int i = 0; i < n; ++i)
+        if (capture.rows[i] < 0 || capture.rows[i] >= q.ne[2] || (i && capture.rows[i] <= capture.rows[i-1]))
+            return false;
+    tile = {static_cast<float*>(scratch.data), int(scratch.ne[0]), n, {}};
+    std::copy_n(capture.rows, n, tile.rows);
+    // Pages beyond a sampled row's causal frontier have zero probability.
+    clear_prompt_page_lse<<<(int(scratch.numel()) + 255) / 256, 256, 0, stream>>>(
+        tile.values, int(scratch.numel()));
+    return true;
+}
+
+// One four-lane group owns two rows. Only the group leader writes, and all
+// lanes in a sampled warp participate in the reductions.
+struct PromptPageLseRows {
+    int first;
+    int second;
+    bool sampled;
+
+    __device__ __forceinline__ PromptPageLseRows(const PromptPageLseTile& tile, int row)
+        : PromptPageLseRows(tile, row, row + 8) {}
+
+    __device__ __forceinline__ PromptPageLseRows(const PromptPageLseTile& tile, int row0, int row1)
+        : first(tile.slot(row0)), second(tile.slot(row1)),
+          sampled(tile.values && __any_sync(0xffffffffu, first >= 0 || second >= 0)) {}
+
+    __device__ __forceinline__ void store_reduced(const PromptPageLseTile& tile, int page,
+        int head0, int head1, int heads, float max0, float max1, float sum0, float sum1) const {
+        if (first >= 0 && sum0 > 0)
+            tile.values[(size_t(first) * heads + head0) * tile.pages + page] = max0 + logf(sum0);
+        if (second >= 0 && sum1 > 0)
+            tile.values[(size_t(second) * heads + head1) * tile.pages + page] = max1 + logf(sum1);
+    }
+
+    __device__ __forceinline__ void store(const PromptPageLseTile& tile, int page, int head,
+                                        int heads, float max0, float max1, float sum0,
+                                        float sum1, int lane) const {
+        if (sampled && page < tile.pages) {
+            sum0 = warp_sum<4>(sum0, 0xffffffffu);
+            sum1 = warp_sum<4>(sum1, 0xffffffffu);
+            if ((lane & 3) == 0)
+                store_reduced(tile, page, head, head, heads, max0, max1, sum0, sum1);
+        }
+    }
+};
+
+// The smaller FP4 kernels sweep two 32-key tiles per physical KV page.
+// Rescale the first half with the same online-softmax alpha that joins the tiles.
+struct PromptHalfPageLse {
+    int slot;
+    float first_half = 0;
+
+    __device__ __forceinline__ void add(const PromptPageLseTile& tile, int half, bool last,
+        int head, int heads, float max, float alpha, float sum) {
+        const int page = half / 2;
+        if (slot < 0 || page >= tile.pages) return;
+        if ((half & 1) != 0) sum = __fmaf_rn(first_half, alpha, sum);
+        else if (!last) {
+            first_half = sum;
+            return;
+        }
+        if (sum > 0)
+            tile.values[(size_t(slot) * heads + head) * tile.pages + page] = max + logf(sum);
+    }
+};
+
+} // namespace ninfer::ops
