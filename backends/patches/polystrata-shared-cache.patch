 #ifdef STRATA_KVMEM
+uint64_t Engine::logical_memory_payload_bytes() const {
+    std::vector<const KvmemMemory*> seen;
+    uint64_t total=0;
+    const auto add=[&](const KvmemMemory* memory) {
+        if(memory && std::find(seen.begin(),seen.end(),memory)==seen.end()) {
+            seen.push_back(memory);total+=memory->active_host_bytes();
+        }
+    };
+    add(memory_.get());
+    for(const auto& sequence:seqs_)add(sequence.memory.get());
+    return total;
+}
