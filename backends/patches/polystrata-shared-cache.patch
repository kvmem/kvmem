+def cache_owner(req):
+    req = req or {}
+    k = req.get("kvmem", {})
+    if not isinstance(k, dict):
+        raise ValueError("kvmem must be an object")
+    conversation = k.get("conversation_id")
+    if conversation is not None and (not isinstance(conversation, str) or not conversation or len(conversation.encode()) > 256):
+        raise ValueError("kvmem.conversation_id must be a nonempty string of at most 256 UTF-8 bytes")
+    aliases = []
+    for name in ("prompt_cache_key", "promptCacheKey"):
+        value = req.get(name)
+        if value is not None and (not isinstance(value, str) or len(value.encode()) > 256):
+            raise ValueError(name + " must be a string of at most 256 UTF-8 bytes")
+        if value: aliases.append(value)
+    if len(set(aliases)) > 1:
+        raise ValueError("conflicting prompt cache keys")
+    return conversation or (aliases[0] if aliases else "")
