@@ -0,0 +1,144 @@
+"""Bounded, model-local storage for accepted text generation IDs, independent of native KV."""
+from array import array
+from collections import OrderedDict
+from hashlib import sha256
+import json
+import threading
+
+
+def extend(key, message):
+    encoded = json.dumps(message, sort_keys=True, separators=(",", ":"), ensure_ascii=True)
+    return sha256(key + encoded.encode("ascii")).digest()
+
+
+def pieces(tokenizer, ids):
+    return b"".join(tokenizer.token_bytes(i) for i in ids)
+
+
+class Directory:
+    def __init__(self, max_records=32, max_bytes=32 << 20):
+        self.max_records = max_records
+        self.max_bytes = max_bytes
+        self.entries = OrderedDict()
+        self.size = 0
+        self.lock = threading.Lock()
+
+    def begin(self, domain, messages, lookup=True):
+        parent = domain
+        ancestors = []
+        for message in messages:
+            parent = extend(parent, message)
+            if message["role"] == "assistant":
+                ancestors.append(parent)
+        with self.lock:
+            candidates = [self.entries[k] for k in reversed(ancestors) if self.entries.get(k)] if lookup else []
+        return Request(self, parent, candidates)
+
+    @staticmethod
+    def charge(key, record):
+        return len(key) + (sum(map(len, record)) if record else 0)
+
+    def publish(self, key, record):
+        with self.lock:
+            if key in self.entries:
+                old = self.entries.pop(key)
+                self.size -= self.charge(key, old)
+                if old != record:
+                    record = None  # indistinguishable response; keep the tombstone until eviction
+            cost = self.charge(key, record)
+            if cost > self.max_bytes:
+                return
+            self.entries[key] = record
+            self.size += cost
+            while self.size > self.max_bytes or len(self.entries) > self.max_records:
+                old_key, old_record = self.entries.popitem(last=False)
+                self.size -= self.charge(old_key, old_record)
+
+
+class Request:
+    def __init__(self, directory, parent, candidates):
+        self.directory = directory
+        self.parent = parent
+        self.candidates = candidates
+        self.reused = 0
+        self.original = ""
+        self.output = None
+
+    def encoder(self, service, original, tokenize, limit):
+        from .frontend import unmark_think_literals
+        self.original = original
+        original_bytes = original.encode("utf-8")
+        eog = getattr(service.engine, "eos_ids", ())
+        for marked_prefix, packed in self.candidates:
+            if not original_bytes.startswith(marked_prefix):
+                continue
+            seam = len(marked_prefix.decode("utf-8"))
+            suffix = original[seam:]
+            tail = tokenize(suffix)
+            plain_tail, literal = unmark_think_literals(suffix, service.literals)
+            if (not tail or tail[0] not in eog or (literal and literal[0][0] == 0)
+                    or pieces(service.tok, tail) != plain_tail.encode("utf-8")):
+                continue
+            # A worker can accept extra stop IDs. Require an explicitly declared end ID or
+            # a complete ChatML end marker, never an ordinary byte inside a split marker.
+            declared = getattr(service.tok, "special_ids", {}) or {}
+            if (tail[0] not in (declared.get(k) for k in ("eos", "tokenizer.ggml.eos_token_id",
+                    "tokenizer.ggml.eot_token_id", "tokenizer.ggml.eom_token_id"))
+                    and service.tok.token_bytes(tail[0]) not in (b"<|im_end|>", b"<|endoftext|>")):
+                continue
+            saved = array("i")
+            saved.frombytes(packed)
+            if len(saved) + len(tail) > limit:
+                continue
+            ids = saved.tolist()
+            self.reused = len(ids)
+
+            def effective(text):
+                if text == original:
+                    return ids + tail
+                if len(text) >= seam and original.startswith(text):
+                    return ids + tokenize(text[seam:])
+                return tokenize(text)
+            return effective
+        return tokenize
+
+    def observe(self, service, ids, events, cancel):
+        from .frontend import unmark_think_literals
+        text, reasoning, calls = [], [], []
+        for kind, value in events:
+            if kind == "event":
+                if value.kind == "content":
+                    text.append(value.text)
+                elif value.kind == "reasoning":
+                    reasoning.append(value.text)
+                elif value.kind == "tool_call":
+                    call = value.call
+                    calls.append({"id": call.id, "function": {"name": call.name, "arguments": call.arguments}})
+            elif kind == "done" and value["finish"] in ("stop", "length") and not cancel.is_set():
+                assistant = {"role": "assistant", "content": "".join(text)}
+                if reasoning:
+                    assistant["reasoning_content"] = "".join(reasoning)
+                if calls:
+                    assistant["tool_calls"] = calls
+                key = extend(self.parent, assistant)
+                record = None
+                if self.output and not any(k in value for k in ("stop_sequence", "tool_markup_retry",
+                                                                "unread_tool_markup", "rejected_tool_calls")):
+                    raw = self.output
+                    if raw[-1] in getattr(service.engine, "eos_ids", ()):
+                        raw = raw[:-1]
+                    prompt_text, _ = unmark_think_literals(self.original, service.literals)
+                    if raw and pieces(service.tok, ids) == prompt_text.encode("utf-8"):
+                        suffix = pieces(service.tok, raw)
+                        try:
+                            decoded = suffix.decode("utf-8")
+                        except UnicodeDecodeError:
+                            pass
+                        else:
+                            # The frontend uses private-use characters to protect literal control tags.
+                            # An actual model output containing one would change bytes on the next unmark.
+                            _, translated = unmark_think_literals(decoded, service.literals)
+                            if not translated:
+                                record = (self.original.encode("utf-8") + suffix, array("i", list(ids) + raw).tobytes())
+                self.directory.publish(key, record)
+            yield kind, value
