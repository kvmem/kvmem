index 0000000000000000000000000000000000000000..72584a1ac22df3ae695734bdc8160142fd6ebd67
--- /dev/null
+++ b/terminal/serve/test_generated_history.py
@@ -0,0 +1,177 @@
+"""Exercise accepted IDs at the Service/worker boundary, including cold native KV."""
+from pathlib import Path
+import tempfile
+import threading
+import unittest
+
+from serve.frontend import ChatTemplate, Event, ToolCall
+from serve.generated_history import Directory, extend
+from serve.server import ByteTokenizer, MockEngine, Service
+
+
+class Tokens(ByteTokenizer):
+    SPECIALS = ByteTokenizer.SPECIALS + ["ab"]
+    ALWAYS = ("ab",)
+
+    def token_bytes(self, token):
+        return self.SPECIALS[token - 256].encode() if token >= 256 else bytes([token])
+
+
+class Worker(MockEngine):
+    def generate(self, ids, max_new, sampling, cancel, embeddings=None):
+        try:
+            yield from super().generate(ids, max_new, sampling, cancel, embeddings)
+        finally:
+            self.last = dict(generated=len(self.script), reused=0, prompt_read=len(ids),
+                             prompt_ms=1., decode_ms=1., finish="stop")
+
+
+class GeneratedHistoryTests(unittest.TestCase):
+    def setUp(self):
+        path = tempfile.TemporaryDirectory()
+        self.addCleanup(path.cleanup)
+        template = Path(path.name) / "test.jinja"
+        template.write_text("{% for m in messages %}<|im_start|>{{m.role}}\n"
+                            "{{m.content}}{% if m.tool_calls %}{{m.tool_calls[0].function.name}}{% endif %}"
+                            "<|im_end|>{% endfor %}{% if add_generation_prompt %}<|im_start|>assistant\n{% endif %}",
+                            encoding="utf-8")
+        self.tok = Tokens()
+        self.worker = Worker(self.tok, "x", max_context=8192)
+        self.worker.info = {"kvmem": 1}
+        self.worker.last = None
+        self.worker.script = [97, 98] * 4 + [257]
+        self.service = Service(self.worker, self.tok, ChatTemplate(template))
+        self.first = [{"role": "user", "content": "first"}]
+        self.echo = {"role": "assistant", "content": "ab" * 4}
+        self.next = self.first + [self.echo, {"role": "user", "content": "follow up"}]
+
+    def prepare(self, messages, req=None):
+        return self.service.prepare(messages, None, {"enable_thinking": False}, 32, req=req)[0]
+
+    def generate(self, ids):
+        return dict((kind, value) for kind, value in self.service.run(
+            ids, False, None, 32, {}, threading.Event()) if kind == "done")["done"]
+
+    def test_user_and_cold_replay_match_worker_ids_and_query(self):
+        first = self.prepare(self.first)
+        self.generate(first)
+        again = self.prepare(self.next)
+        n = len(first) + 8
+        self.assertEqual(again[:n], list(first) + [97, 98] * 4)
+        self.assertEqual(self.tok.decode(again[slice(*again.kvmem_query)]), "follow up")
+        self.assertEqual(again.kvmem_canonical_end, len(again) - len(first[first.kvmem_canonical_end:]))
+        done = self.generate(again)
+        self.assertEqual(done["timings"]["cache_reuse"]["generated_history_tokens"], n)
+        self.assertEqual(done["reused"], 0)
+        self.assertEqual(self.worker.last_prompt, again)
+        edited = self.first + [dict(self.echo, content="edited"), self.next[-1]]
+        self.assertEqual(self.prepare(edited).generated_history.reused, 0)
+        self.assertEqual(self.prepare(self.next, {"cache_reset": True}).generated_history.reused, 0)
+        self.assertEqual(self.prepare(self.next, {"kvmem_query": {"message": 2, "start": 0, "end": 6}}).generated_history.reused, 0)
+        self.worker.max_context = len(again) + 32  # the split IDs exceed capacity, canonical merges fit
+        self.service.fit_max_tokens = False
+        from serve.server import CTX_SLACK
+        self.worker.max_context += CTX_SLACK - 1
+        self.assertEqual(self.prepare(self.next).generated_history.reused, 0)
+
+    def test_tool_sentinel_and_structured_identity(self):
+        ids = self.prepare(self.first)
+        request = ids.generated_history
+        request.output = self.tok.encode("weather")
+        call = ToolCall("weather", {"city": "X"}, "call-1")
+        done = {"finish": "stop", "timings": {}}
+        list(request.observe(self.service, ids, [("event", Event("tool_call", call=call)), ("done", done)], threading.Event()))
+        assistant = {"role": "assistant", "content": "", "tool_calls": [
+            {"id": call.id, "function": {"name": call.name, "arguments": call.arguments}}]}
+        history = self.first + [assistant, {"role": "tool", "tool_call_id": call.id, "content": "rain"}]
+        resolved = self.prepare(history)
+        self.assertEqual(resolved.kvmem_query, (0, 0))
+        self.assertEqual(resolved.generated_history.reused, len(ids) + len("weather"))
+        assistant["tool_calls"][0]["function"]["arguments"] = {"city": "Y"}
+        self.assertEqual(self.prepare(history).generated_history.reused, 0)
+
+    def test_conflict_clipped_stop_and_authority(self):
+        self.service.api_key = "key"
+        self.assertIsNone(self.prepare(self.first).generated_history)
+        self.service.embeddings.history_domain = b"A"
+        self.generate(self.prepare(self.first))
+        self.service.embeddings.history_domain = b"B"
+        self.assertEqual(self.prepare(self.next).generated_history.reused, 0)
+        self.service.embeddings.history_domain = b"A"
+        self.assertGreater(self.prepare(self.next).generated_history.reused, 0)
+        self.worker.script = self.tok.encode("ab" * 4, parse_special=True) + [257]
+        self.generate(self.prepare(self.first))
+        self.assertEqual(self.prepare(self.next).generated_history.reused, 0)
+        self.service.generated_history = Directory()
+        self.generate(self.prepare(self.first))
+        ids = self.prepare(self.first)
+        history = ids.generated_history
+        history.output = [97, 98] * 6
+        list(history.observe(self.service, ids, [("event", Event("content", "ab" * 4)),
+                             ("done", {"finish": "stop", "stop_sequence": "!"})], threading.Event()))
+        self.assertEqual(self.prepare(self.next).generated_history.reused, 0)
+
+    def test_cancel_and_bounded_immutable_reads(self):
+        cancel = threading.Event()
+        cancel.set()
+        ids = self.prepare(self.first)
+        list(self.service.run(ids, False, None, 32, {}, cancel))
+        self.assertFalse(self.service.generated_history.entries)
+        directory = Directory(max_records=1, max_bytes=48)
+        key = extend(b"", self.echo)
+        directory.publish(key, (b"4", b"1234"))
+        reader = directory.begin(b"", [self.echo])
+        directory.publish(b"x" * 32, (b"3", b"x"))
+        self.assertEqual(directory.begin(b"", [self.echo]).candidates, [])
+        self.assertEqual(reader.candidates, [(b"4", b"1234")])
+        directory.publish(key, (b"x" * 48, b"x"))
+        self.assertLessEqual(directory.size, 48)
+
+    def test_disconnect_after_first_event_never_publishes(self):
+        stream = self.service.run(self.prepare(self.first), False, None, 32, {}, threading.Event())
+        for kind, item in stream:
+            if kind == "event" and item.kind == "content":
+                break
+        stream.close()
+        self.assertFalse(self.service.generated_history.entries)
+
+    def test_generated_private_literal_marker_falls_back_to_plain_bytes(self):
+        marker = self.service.literals["<|im_end|>"]
+        self.worker.script = list(marker.encode("utf-8")) + [257]
+        self.generate(self.prepare(self.first))
+        messages = self.first + [{"role": "assistant", "content": marker}, self.next[-1]]
+        follow = self.prepare(messages)
+        canonical = self.prepare(messages, {"cache_reset": True})
+        self.assertEqual(follow.generated_history.reused, 0)
+        self.assertEqual(follow, canonical)
+        self.assertIn("<|im_end|>", self.tok.decode(follow))
+        self.assertNotIn(marker, self.tok.decode(follow))
+
+    def test_oldest_complete_ancestor_and_independent_end_marker(self):
+        self.generate(self.prepare(self.first))
+        child = self.prepare(self.next)
+        self.generate(child)
+        newest = self.next + [self.echo, {"role": "user", "content": "third"}]
+        self.assertEqual(self.prepare(newest).generated_history.reused, len(child) + 8)
+        edited = self.next + [dict(self.echo, content="different"), newest[-1]]
+        self.assertEqual(self.prepare(edited).generated_history.reused, len(self.prepare(self.first)) + 8)
+        self.worker.eos_ids = frozenset()
+        self.assertEqual(self.prepare(newest).generated_history.reused, 0)
+
+    def test_concurrent_conflicting_publications_are_ambiguous(self):
+        directory = Directory()
+        key = extend(b"D", self.echo)
+        records = [(b"ab", b"split"), (b"ab", b"merged")] * 8
+        barrier = threading.Barrier(len(records))
+
+        def publish(record):
+            barrier.wait()
+            directory.publish(key, record)
+
+        writers = [threading.Thread(target=publish, args=(record,)) for record in records]
+        for writer in writers:
+            writer.start()
+        for writer in writers:
+            writer.join()
+        self.assertIsNone(directory.entries[key])
+        self.assertFalse(directory.begin(b"D", [self.echo]).candidates)
