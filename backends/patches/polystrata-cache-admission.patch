+void KvmemSessions::complete(KvmemMemory& memory,KvmemHistory& history) {
+    // The legacy serial path saves at prompt-1. Only materialize another
+    // optional point when accepted output/input has newly crossed the gate.
+    if(!minimum_tokens_)return;
+    const auto stamp=memory.stamp();
+    if(!stamp.valid || !admit_history(std::min<uint64_t>(stamp.frontier,history.size())))return;
