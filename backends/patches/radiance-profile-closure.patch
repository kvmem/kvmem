diff --git a/libr4d/audit_profile_objects.py b/libr4d/audit_profile_objects.py
new file mode 100644
--- /dev/null
+++ b/libr4d/audit_profile_objects.py
@@ -0,0 +1,62 @@
+"""Verify internal symbol closure using the actual compiled profile objects."""
+from pathlib import Path
+import argparse
+import json
+import subprocess
+
+
+def symbols(nm: str, path: Path, mode: str) -> set[str]:
+    result = subprocess.run([nm, '-g', mode, str(path)], text=True, capture_output=True, check=True)
+    names = set()
+    for line in result.stdout.splitlines():
+        fields = line.split()
+        if len(fields) < 2:
+            continue
+        name, kind = fields[-1], fields[-2]
+        # Weak undefined symbols are optional and are zero when absent. Strong r4d
+        # helpers, including mangled C++ names, must resolve within this plugin.
+        if 'r4d_' in name and (mode != '--undefined-only' or kind == 'U'):
+            names.add(name)
+    return names
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--manifest', type=Path, required=True)
+    parser.add_argument('--object-root', type=Path, required=True)
+    parser.add_argument('--nm', default='nm')
+    parser.add_argument('--output', type=Path, required=True)
+    args = parser.parse_args()
+    manifest = json.loads(args.manifest.read_text(encoding='utf8'))
+    expected = {name + '.hip.o' for name in manifest['units']}
+    expected.update(name + '.o' for name in ['r4d_profile_rows.cpp', 'r4d_layout.cpp',
+                    'r4d_fp8_layout.cpp', 'r4d_iqr_layout.cpp', 'r4d_shapes.cpp', 'r4d_fuse.cpp'])
+    objects = {}
+    for path in args.object_root.rglob('*.o'):
+        if path.name not in expected:
+            continue
+        if path.name in objects:
+            raise ValueError(f'duplicate profile object {path.name}')
+        objects[path.name] = path.resolve()
+    missing_objects = sorted(expected - objects.keys())
+    if missing_objects:
+        raise ValueError(f'profile objects incomplete: {missing_objects}')
+    defined = set()
+    references = {}
+    for name, path in sorted(objects.items()):
+        defined.update(symbols(args.nm, path, '--defined-only'))
+        references[name] = symbols(args.nm, path, '--undefined-only')
+    unresolved = {name: sorted(values - defined) for name, values in references.items() if values - defined}
+    report = {'profile': manifest['profile'], 'object_count': len(objects),
+              'objects': {name: str(path) for name, path in sorted(objects.items())},
+              'internal_definitions': len(defined), 'unresolved_internal_symbols': unresolved,
+              'passed': not unresolved}
+    args.output.parent.mkdir(parents=True, exist_ok=True)
+    args.output.write_text(json.dumps(report, indent=2) + '\n', encoding='utf8')
+    if unresolved:
+        raise SystemExit(json.dumps(unresolved, indent=2))
+    print(f'profile object closure passed: {len(objects)} actual objects, {len(defined)} internal definitions')
+
+
+if __name__ == '__main__':
+    main()
