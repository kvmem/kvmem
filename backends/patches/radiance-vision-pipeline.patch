+inline size_t vision_cache_bytes() {
+    const char* value=std::getenv("KVMEM_RAD_VISION_CACHE_MIB");
+    if(!value)return size_t(256)*1024*1024;
+    unsigned mib=0;const char* end=value+std::strlen(value);
