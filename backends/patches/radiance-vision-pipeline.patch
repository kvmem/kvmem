+// Retain handle numbering for the architecture's immutable vision declaration, but remove all
+// language-model ops/buffer allocations. Weight pointers refer to the engine-owned mapped file.
+static Program cpu_vision_program(const Program& source) {
+    Program p=source;
+    p.kv_groups.clear();p.meta.n_expert=0;
+    p.arena_bytes=0;p.arena_fixed_bytes=0;p.arena_stage_off=-1;p.arena_stage_bytes=0;
+    p.scratch_bytes=0;p.scratch_regions=1;
+    for(size_t i=1;i<p.buffers.size();++i) {
+        auto& b=p.buffers[i];
+        if(b.name.rfind("v.",0)!=0) {
+            b.decl={};b.decl.dtype=RAD_F32;b.decl.rank=1;b.decl.shape[0]=1;
+            b.arena_offset=0;b.bytes=sizeof(float);
+        }
+        b.decl.domain=RAD_DOMAIN_HOST;
+    }
+    for(size_t i=1;i<p.ops.size();++i) {
+        auto& o=p.ops[i];
+        if(!o.host_forced){o=OpInfo{};o.host_forced=true;continue;}
+        for(auto& b:o.bands) {
+            b.dom[RAD_DOMAIN_DEVICE]={};
+            const auto& host=b.dom[RAD_DOMAIN_HOST];
+            if(!host.row || host.scratch_bytes)throw std::runtime_error("CPU encoder needs a scratch-free host kernel");
+        }
+    }
+    return p;
+}
