+// Engine-local: model, encoder implementation and weights cannot change during its lifetime.
+// Exact patches guard even a content-key collision; their bytes count against the LRU quota.
+class VisionCache {
+    struct Entry { Item identity; std::vector<uint16_t> output; size_t bytes; };
+    std::list<Entry> entries_;
+    size_t limit_, bytes_=0;
+    static bool same(const Item& a,const Item& b) {
+        return a.kind==b.kind && a.key_hi==b.key_hi && a.key_lo==b.key_lo &&
