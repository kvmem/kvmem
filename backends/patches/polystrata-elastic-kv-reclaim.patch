 struct ElasticTestAccess {
+    static void reclaim_test(Engine& e) {
+        std::vector<int32_t> prompt(128,1000);
+        for(int i=0;i<36;++i)e.eval(prompt.data(),128,false);
+        const auto cp=e.memory().checkpoint();
+        const auto kv=KvmemTestAccess::kv(e.memory());
