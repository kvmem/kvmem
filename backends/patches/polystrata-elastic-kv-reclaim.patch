+        e.cover(e.cache_capacity());
+        check(e.trim_kv(64)>0,"first short trim did not reclaim high water");
+        check(e.kv_rows_>=e.memory().visible_tokens(),"trim unmapped accepted resident rows");
+        check(KvmemTestAccess::kv(e.memory())==kv,"trim changed resident KV");
+        check(KvmemTestAccess::means(e.memory())==means,"trim changed accepted statistics");
+        check(e.memory().checkpoint().state==cp.state,"trim changed recurrent state");
+        freeze(e,true);
+        const int32_t token=1000;e.eval(&token,1,true);
+        const std::vector<float> expected(e.logits(),e.logits()+e.n_vocab());
+        e.memory().restore_prefix(cp);
+        auto parked=e.memory().park(cp);e.reset();
+        check(e.trim_kv(64)>0,"first new short session retained long KV");
+        check(e.kv_rows_==4096,"short session failed to return to initial KV extent");
+        e.memory().enter(std::move(parked),cp);
+        check(KvmemTestAccess::kv(e.memory())==kv,"session restore lost trimmed KV");
+        e.eval(&token,1,true);
+        check(std::memcmp(expected.data(),e.logits(),expected.size()*sizeof(float))==0,"trim/park/restore changed logits");
+        freeze(e,false);verify(e);
+        std::cout<<"PASS first_request_KV_reclaim resident_KV statistics recurrent_state session_restore logits\n";
+    }
