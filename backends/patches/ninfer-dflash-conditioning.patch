diff --git a/tests/models/qwen3_5/test_dflash_conditioning.cpp b/tests/models/qwen3_5/test_dflash_conditioning.cpp
new file mode 100644
--- /dev/null
+++ b/tests/models/qwen3_5/test_dflash_conditioning.cpp
@@ -0,0 +1,109 @@
+#include "runtime/contract/dflash_conditioning.h"
+#include "runtime/engine/memory_recovery.h"
+
+#include <array>
+#include <cstdint>
+#include <cstdio>
+#include <stdexcept>
+
+namespace {
+using ninfer::SpeculativeBackend;
+using ninfer::runtime::dflash2_kvmem_recent_tokens;
+void require(bool condition, const char* message) {
+    if (!condition) throw std::runtime_error(message);
+}
+template<class Work> void rejects(Work work, const char* message) {
+    bool rejected = false;
+    try { work(); } catch (const std::invalid_argument&) { rejected = true; }
+    require(rejected, message);
+}
+void recent_respects_backend_and_page_budget() {
+    ninfer::KvmemOptions memory;
+    memory.selected_tokens = 8192;
+    memory.recent_tokens = 64;
+    require(dflash2_kvmem_recent_tokens(memory, SpeculativeBackend::DFlash2, 2048) == 2048,
+            "DFlash2 preserves a full model ring");
+    for (auto backend : {SpeculativeBackend::None, SpeculativeBackend::Mtp, SpeculativeBackend::DFlash}) {
+        require(dflash2_kvmem_recent_tokens(memory, backend, 2048) == 64,
+                "other backends keep their requested recent span");
+    }
+    memory.selected_tokens = 0;
+    require(dflash2_kvmem_recent_tokens(memory, SpeculativeBackend::DFlash2, 0) == 64,
+            "disabled KVMem has no recent-ring requirement");
+    memory.selected_tokens = 8192;
+    memory.recent_tokens = 2000;
+    require(dflash2_kvmem_recent_tokens(memory, SpeculativeBackend::DFlash2, 2048) == 2048,
+            "downward page rounding must not shorten the ring");
+    memory.recent_tokens = 4095;
+    require(dflash2_kvmem_recent_tokens(memory, SpeculativeBackend::DFlash2, 2048) == 4095,
+            "larger caller settings retain their existing rounding semantics");
+    memory.recent_tokens = 4096;
+    memory.selected_tokens = 4096;
+    rejects([&] { (void)dflash2_kvmem_recent_tokens(memory, SpeculativeBackend::DFlash2, 2048); },
+            "a larger explicit recent span must also leave room for the sink");
+    memory.selected_tokens = 8192;
+    memory.recent_tokens = 64;
+    require(dflash2_kvmem_recent_tokens(memory, SpeculativeBackend::DFlash2, 4096) == 4096,
+            "capacity comes from the model rather than a hardcoded 2K");
+    memory.selected_tokens = 2048;
+    rejects([&] { (void)dflash2_kvmem_recent_tokens(memory, SpeculativeBackend::DFlash2, 2048); },
+            "the ring must not consume the mandatory sink budget");
+    memory.selected_tokens = 2112;
+    require(dflash2_kvmem_recent_tokens(memory, SpeculativeBackend::DFlash2, 2048) == 2048,
+            "the exact sink-plus-ring budget is admitted");
+    memory.sink_tokens = 512;
+    rejects([&] { (void)dflash2_kvmem_recent_tokens(memory, SpeculativeBackend::DFlash2, 2048); },
+            "the actual sink size counts against the same selected budget");
+    memory.selected_tokens = 8192;
+    rejects([&] { (void)dflash2_kvmem_recent_tokens(memory, SpeculativeBackend::DFlash2, 0); },
+            "an active DFlash2 ring must have positive capacity");
+    rejects([&] { (void)dflash2_kvmem_recent_tokens(memory, SpeculativeBackend::DFlash2, UINT32_MAX); },
+            "rounding a huge ring must not wrap uint32");
+    rejects([&] { (void)dflash2_kvmem_recent_tokens(memory, SpeculativeBackend::DFlash2,
+                                                  UINT32_MAX - 63U, false); },
+            "the budget-search minimum must include sink without overflowing uint32");
+    memory.recent_tokens = 2048;
+    require(dflash2_kvmem_recent_tokens(memory, SpeculativeBackend::DFlash2, 2048) == 2048,
+            "normalization is idempotent and does not double-pin recent pages");
+}
+void budget_search_uses_the_resolved_recent_minimum() {
+    ninfer::EngineOptions options;
+    options.speculative.backend = SpeculativeBackend::DFlash2;
+    options.kvmem.selected_tokens = 1024;
+    options.kvmem.reserve_tokens = 256;
+    options.max_context = 16384;
+    options.kvmem.recent_tokens = dflash2_kvmem_recent_tokens(
+        options.kvmem, options.speculative.backend, 2048, false);
+    unsigned quotes = 0;
+    const auto plan = ninfer::runtime::maximum_memory_budget(options, 1ULL << 30, 16384,
+        [&](const ninfer::EngineOptions& candidate) {
+            ++quotes;
+            require(candidate.kvmem.selected_tokens >= 2112,
+                    "budget planning never quotes an inadmissible sink-plus-ring window");
+            return static_cast<std::size_t>(candidate.kvmem.selected_tokens) * 1024;
+        });
+    require(plan.available && quotes && plan.minimum_budget == 2112,
+            "a small planning seed may discover a larger valid DFlash2 budget");
+}
+void truncation_does_not_leave_a_future_floor() {
+    struct Case { std::uint32_t floor, frontier, expected; };
+    for (auto row : std::array{Case{4032, 2048, 2048}, Case{4096, 0, 0},
+                               Case{0, 4096, 0}, Case{2048, 4096, 2048},
+                               Case{UINT32_MAX, 17, 17}, Case{17, 17, 17}}) {
+        ninfer::runtime::clamp_dflash_context_floor(row.floor, row.frontier);
+        require(row.floor == row.expected && row.floor <= row.frontier,
+                "restore keeps existing history bounds or safely hides all truncated history");
+    }
+}
+}
+int main() {
+    try {
+        recent_respects_backend_and_page_budget();
+        budget_search_uses_the_resolved_recent_minimum();
+        truncation_does_not_leave_a_future_floor();
+    } catch (const std::exception& error) {
+        std::fprintf(stderr, "%s\n", error.what());
+        return 1;
+    }
+    std::puts("DFlash conditioning policy passed");
+}
