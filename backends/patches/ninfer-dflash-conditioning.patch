+++ b/src/runtime/contract/dflash_conditioning.h
@@ -0,0 +1,54 @@
+#pragma once
+
+#include "ninfer/engine_options.h"
+
+#include <algorithm>
+#include <cstdint>
+#include <limits>
+#include <stdexcept>
+
+namespace ninfer::runtime {
+
+// Resolve once, before publishing Engine options or planning the working set. The existing
+// recent policy then owns both Query and resident-only Pressure; no second pinning policy.
+// Budget searches may start with a smaller seed B: their minimum candidate uses this resolved
+// recent span, whereas an executing Engine must already have enough selected pages.
+inline std::uint32_t dflash2_kvmem_recent_tokens(const KvmemOptions& memory,
+                                                SpeculativeBackend backend,
+                                                std::uint32_t ring_tokens,
+                                                bool require_selected_budget = true) {
+    if (!memory.selected_tokens || backend != SpeculativeBackend::DFlash2) {
+        return memory.recent_tokens;
+    }
+    if (!ring_tokens) {
+        throw std::invalid_argument("DFlash2 requires a positive draft sliding window");
+    }
+    constexpr std::uint64_t page_tokens = 64;
+    const auto ring_pages = (static_cast<std::uint64_t>(ring_tokens) + page_tokens - 1) / page_tokens;
+    const auto recent_pages = std::max<std::uint64_t>(memory.recent_blocks(), ring_pages);
+    const auto effective = recent_pages * page_tokens;
+    if (effective > std::numeric_limits<std::uint32_t>::max()) {
+        throw std::invalid_argument("DFlash2 draft recent span exceeds uint32 token capacity");
+    }
+    const auto required_pages = static_cast<std::uint64_t>(memory.sink_blocks()) + recent_pages;
+    if (required_pages > std::numeric_limits<std::uint32_t>::max() / page_tokens) {
+        throw std::invalid_argument("DFlash2 sink-plus-recent span exceeds uint32 token capacity");
+    }
+    if (require_selected_budget && required_pages > memory.selected_tokens / page_tokens) {
+        throw std::invalid_argument(
+            "DFlash2 KVMem selected_tokens must hold sink plus the draft-ring recent span; "
+            "increase the KVMem budget");
+    }
+    // Preserve the caller's existing downward page rounding when its span is already larger.
+    return memory.recent_blocks() >= ring_pages ? memory.recent_tokens
+                                               : static_cast<std::uint32_t>(effective);
+}
+
+// Truncating reuse can restore an earlier frontier while retaining a later floor. Hiding all
+// history is safe, but the lower bound itself must not remain beyond the restored frontier.
+constexpr void clamp_dflash_context_floor(std::uint32_t& floor,
+                                           std::uint32_t frontier) noexcept {
+    floor = std::min(floor, frontier);
+}
+
+} // namespace ninfer::runtime
