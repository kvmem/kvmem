diff --git a/libr4d/generate_profile.py b/libr4d/generate_profile.py
new file mode 100644
--- /dev/null
+++ b/libr4d/generate_profile.py
@@ -0,0 +1,227 @@
+"""Generate a narrowed registry from the original row table, without compiling device code."""
+from __future__ import annotations
+
+import argparse
+from concurrent.futures import ThreadPoolExecutor
+import hashlib
+import json
+from pathlib import Path
+import re
+import shlex
+import subprocess
+
+
+TOKEN = re.compile(r'"(?:\\.|[^"\\])*"|\'(?:\\.|[^\'\\])*\'|[A-Za-z_]\w*|[^\s]', re.S)
+FUNCTION = re.compile(r'\b(r4d_\w+)\s*\([^;{}]*\)\s*(?:noexcept\s*)?\{', re.S)
+EXPORTED_FUNCTION = re.compile(r'extern\s+"C"\s+[^;{}()]*?\b(r4d_\w+)\s*\([^;{}]*\)\s*\{', re.S)
+PROTOTYPE = re.compile(r'\b(r4d_\w+)\s*\([^;{}]*\)\s*;', re.S)
+CALLBACK_FIELDS = {12: 'tune_valid', 13: 'init', 14: 'fini', 15: 'launch',
+                   16: 'scratch', 17: 'layout', 18: 'relayout', 19: 'opd_shape',
+                   20: 'unrelayout', 21: 'replaces'}
+INDEX_EXPORTS = ('rad_kernel_count', 'rad_kernel_at', 'rad_kernel_concurrent',
+                 'rad_kernel_chain', 'rad_kernel_collective')
+HOST_UNITS = ('r4d_rows.cpp', 'r4d_layout.cpp', 'r4d_fp8_layout.cpp',
+              'r4d_iqr_layout.cpp', 'r4d_shapes.cpp', 'r4d_fuse.cpp')
+
+
+def clean_preprocessed(text: str) -> str:
+    return re.sub(r'^\s*#.*$', '', text, flags=re.M)
+
+
+def split_fields(text: str) -> list[str]:
+    """Split an aggregate at top-level commas, preserving nested macros' expansions."""
+    parts = []
+    start = 0
+    depth = 0
+    for token in TOKEN.finditer(text):
+        value = token.group()
+        if value in ('{', '(', '['):
+            depth += 1
+        elif value in ('}', ')', ']'):
+            depth -= 1
+        elif value == ',' and depth == 0:
+            parts.append(text[start:token.start()].strip())
+            start = token.end()
+    tail = text[start:].strip()
+    if tail:
+        parts.append(tail)
+    return parts
+
+
+def rows_from_preprocessed(text: str) -> list[list[str]]:
+    match = re.search(r'static\s+const\s+RadKernelInfo\s+kKernels\s*\[\s*\]\s*=\s*\{', text)
+    if not match:
+        raise ValueError('the original kKernels table was not found')
+    depth = 1
+    end = None
+    for token in TOKEN.finditer(text, match.end()):
+        if token.group() == '{':
+            depth += 1
+        elif token.group() == '}':
+            depth -= 1
+            if depth == 0:
+                end = token.start()
+                break
+    if end is None:
+        raise ValueError('unterminated kKernels table')
+    rows = []
+    for initializer in split_fields(text[match.end():end]):
+        if not initializer.startswith('{') or not initializer.endswith('}'):
+            raise ValueError('unexpected kernel initializer')
+        fields = split_fields(initializer[1:-1])
+        if not 16 <= len(fields) <= 23:
+            raise ValueError(f'RadKernelInfo field count changed: {len(fields)}')
+        rows.append(fields)
+    return rows
+
+
+def symbol(value: str) -> str | None:
+    if value in ('nullptr', '0', '__null', ''):
+        return None
+    match = re.fullmatch(r'&?\s*(r4d_\w+)', value)
+    if not match:
+        raise ValueError(f'unsupported callback expression: {value}')
+    return match.group(1)
+
+
+def write_if_changed(path: Path, value: str) -> None:
+    if path.exists() and path.read_text(encoding='utf8') == value:
+        return
+    path.write_text(value, encoding='utf8', newline='\n')
+
+
+def wrapper(disabled: list[str]) -> str:
+    lines = ['// Generated from the original registry and compiler-expanded unit definitions.',
+             '#include "r4d_plugin.h"']
+    lines.extend(f'#define {name} nullptr' for name in disabled)
+    lines.extend(f'#define {name} r4d_profile_raw_{name}' for name in INDEX_EXPORTS)
+    lines.append('#include "r4d_rows.cpp"')
+    lines.extend(f'#undef {name}' for name in INDEX_EXPORTS)
+    lines.extend(f'#undef {name}' for name in disabled)
+    lines.append(r'''
+namespace {
+const std::vector<int>& profile_indices() {
+    static const std::vector<int> indices = [] {
+        std::vector<int> result;
+        const int count = r4d_profile_raw_rad_kernel_count();
+        for (int i = 0; i < count; ++i) {
+            const RadKernelInfo* row = r4d_profile_raw_rad_kernel_at(i);
+            if (row && row->launch) result.push_back(i);
+        }
+        return result;
+    }();
+    return indices;
+}
+int profile_raw_index(int index) {
+    const auto& indices = profile_indices();
+    return index >= 0 && size_t(index) < indices.size() ? indices[size_t(index)] : -1;
+}
+}
+extern "C" int rad_kernel_count() { return int(profile_indices().size()); }
+extern "C" const RadKernelInfo* rad_kernel_at(int index) {
+    return r4d_profile_raw_rad_kernel_at(profile_raw_index(index));
+}
+extern "C" int rad_kernel_concurrent(int index) {
+    return r4d_profile_raw_rad_kernel_concurrent(profile_raw_index(index));
+}
+extern "C" int rad_kernel_chain(int index) {
+    return r4d_profile_raw_rad_kernel_chain(profile_raw_index(index));
+}
+extern "C" int rad_kernel_collective(int index) {
+    return r4d_profile_raw_rad_kernel_collective(profile_raw_index(index));
+}
+''')
+    return '\n'.join(lines)
+
+
+def main() -> None:
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--source', required=True, type=Path)
+    parser.add_argument('--profile', required=True, type=Path)
+    parser.add_argument('--output', required=True, type=Path)
+    parser.add_argument('--cxx', required=True)
+    parser.add_argument('--hip', required=True)
+    parser.add_argument('--arch', required=True)
+    parser.add_argument('--rocm-root')
+    parser.add_argument('--cxx-flags', default='')
+    parser.add_argument('--hip-flags', default='')
+    parser.add_argument('--jobs', type=int, default=8)
+    args = parser.parse_args()
+    source = args.source.resolve()
+    profile = json.loads(args.profile.read_text(encoding='utf8'))
+    units = profile['units']
+    if not units or len(set(units)) != len(units):
+        raise ValueError('profile must contain unique device units')
+    for unit in units:
+        if not re.fullmatch(r'r4d_\w+', unit) or not (source / (unit + '.hip')).is_file():
+            raise ValueError(f'unknown device unit {unit}')
+    args.output.mkdir(parents=True, exist_ok=True)
+
+    def preprocess(name: str) -> tuple[str, str, list[str]]:
+        device = name.endswith('.hip')
+        command = [args.hip if device else args.cxx, '-E', '-std=c++17' if device else '-std=c++20',
+                   '-I' + str(source), '-I' + str(source.parent / 'abi')]
+        command += shlex.split(args.hip_flags if device else args.cxx_flags)
+        if device:
+            command += ['-x', 'hip', '--cuda-host-only', '--offload-arch=' + args.arch]
+            if args.rocm_root:
+                command += ['--rocm-path=' + args.rocm_root]
+        command.append(str(source / name))
+        result = subprocess.run(command, text=True, encoding='utf8', capture_output=True)
+        if result.returncode:
+            raise RuntimeError(f'preprocessing {name} failed\n{result.stderr}')
+        dependencies = sorted({p for p in re.findall(r'^#\s+\d+\s+"([^"<>]+)"', result.stdout, re.M)
+                               if Path(p).is_file()})
+        return name, clean_preprocessed(result.stdout), dependencies
+
+    names = list(HOST_UNITS) + [unit + '.hip' for unit in units]
+    with ThreadPoolExecutor(max_workers=max(1, min(args.jobs, 8))) as pool:
+        expanded = list(pool.map(preprocess, names))
+    texts = {name: text for name, text, _ in expanded}
+    definitions = {name: set(FUNCTION.findall(text)) for name, text in texts.items()}
+    exported = {name: set(EXPORTED_FUNCTION.findall(text)) for name, text in texts.items()}
+    host_definitions = set().union(*(definitions[name] for name in HOST_UNITS))
+    unit_definitions = set().union(*(exported[unit + '.hip'] for unit in units))
+    available_callbacks = host_definitions | unit_definitions
+    available = host_definitions | set().union(*definitions.values())
+    rows = rows_from_preprocessed(texts['r4d_rows.cpp'])
+    retained = []
+    callbacks = set()
+    for fields in rows:
+        functions = {field: symbol(fields[index]) for index, field in CALLBACK_FIELDS.items()
+                     if index < len(fields)}
+        callbacks.update(value for value in functions.values() if value)
+        if functions['launch'] not in unit_definitions:
+            continue
+        missing = {field: value for field, value in functions.items() if value and value not in available_callbacks}
+        if missing:
+            raise ValueError(f'profile callback closure incomplete for {fields[0]}: {missing}')
+        retained.append({'name': fields[0], 'callbacks': functions})
+    if not retained:
+        raise ValueError('profile retained no kernel rows')
+    # The original table also names peer init callbacks outside kKernels (host twins and
+    # collective metadata). Declarations are read after macro expansion, including token-pasted
+    # window/trellis names, so absent symbols cannot leak through those helper tables.
+    declarations = set(PROTOTYPE.findall(texts['r4d_rows.cpp']))
+    disabled = sorted((declarations - available) | (callbacks - available_callbacks))
+    write_if_changed(args.output / 'r4d_profile_rows.cpp', wrapper(disabled))
+    dependencies = sorted({str(Path(dep).resolve()) for _, _, deps in expanded for dep in deps}
+                          | {str(args.profile.resolve()), str(Path(__file__).resolve())})
+    write_if_changed(args.output / 'dependencies.txt', '\n'.join(dependencies) + '\n')
+    manifest = {
+        'profile': args.profile.stem, 'arch': args.arch, 'units': units,
+        'preprocessors': {'cxx': args.cxx, 'hip': args.hip,
+                          'cxx_flags': args.cxx_flags, 'hip_flags': args.hip_flags},
+        'unit_count': len(units), 'all_row_count': len(rows), 'retained_row_count': len(retained),
+        'disabled_callback_count': len(disabled), 'rows': retained,
+        'device_definitions': sorted(unit_definitions & declarations),
+        'definitions': {name: sorted(values & declarations) for name, values in definitions.items()},
+        'source_sha256': {name: hashlib.sha256((source / name).read_bytes()).hexdigest() for name in names},
+        'preprocessing_only': True,
+    }
+    write_if_changed(args.output / 'manifest.json', json.dumps(manifest, indent=2) + '\n')
+    print(f'R4D profile {args.profile.stem}: {len(units)} HIP units, {len(retained)}/{len(rows)} rows; callback closure verified')
+
+
+if __name__ == '__main__':
+    main()
