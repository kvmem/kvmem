+// Independent CPU fixtures for newly enabled DFlash2 kernel math.
+#include "rad_planes.h"
+void dflash_conv_test(HMODULE dll,int m,int block,int half){
+ const int h=5120,ng=h/16,pitch=4*ng;
+ std::vector<uint16_t> x(m*h),d(m*pitch),base(4*h),out(m*h+32,0x7fc1);
+ for(auto* v:{&x,&d,&base})for(auto& z:*v)z=bf((int(rng()%255)-127)/128.0f);
+ std::vector<double> ref(m*h);
+ for(int t=0;t<m;++t)for(int j=0;j<h;++j){float a=(fl(base[half*2*h+j])+fl(d[t*pitch+half*2*ng+j/16]))*fl(x[t*h+j]);
+  if(t%block)a+=(fl(base[half*2*h+h+j])+fl(d[t*pitch+half*2*ng+ng+j/16]))*fl(x[(t-1)*h+j]);ref[t*h+j]=a;}
+ Dev dev;auto dp=(uint16_t*)dev.put(d.size()*2,d.data());auto bp=(uint16_t*)dev.put(base.size()*2,base.data());
+ RadTensor ts[]={tensor(dev.put(x.size()*2,x.data()),RAD_BF16,{m,h}),tensor(dp+half*2*ng,RAD_BF16,{m,2*ng}),
+  tensor(bp+half*2*h,RAD_BF16,{1,2,h}),tensor(dev.put(out.size()*2,out.data()),RAD_BF16,{m,h})};ts[1].stride[0]=pitch;
+ RadParam p[]={RAD_INT("T",m),RAD_INT("hidden_size",h),RAD_INT("taps",2),RAD_INT("group_size",16),RAD_INT("NG",ng),RAD_INT("block_size",block),RAD_STR("dtype","bf16")};
+ RadArgs a{};a.t=ts;a.n_t=4;a.p=p;a.n_p=7;
+ auto fn=sym<RadLaunchFn>(dll,"r3di_dflash_conv");hipStream_t stream;hc(hipStreamCreate(&stream));
+ for(int i=0;i<3;++i)rc(fn(&a,(RadStream)stream),"dflash conv");hc(hipStreamSynchronize(stream));hc(hipStreamDestroy(stream));
+ hc(hipMemcpy(out.data(),ts[3].data,out.size()*2,hipMemcpyDeviceToHost));
+ for(size_t i=0;i<ref.size();++i)req(out[i]==bf(float(ref[i])),"dflash conv CPU result mismatch");
+ for(size_t i=ref.size();i<out.size();++i)req(out[i]==0x7fc1,"dflash conv output guard");
+ auto saved=ts[3].data;ts[3].data=ts[0].data;req(fn(&a,nullptr)==RAD_E_INVAL,"dflash conv alias accepted");ts[3].data=saved;
+ p[5].ival=3;req(fn(&a,nullptr)==RAD_E_SHAPE,"dflash conv non-power block accepted");
+ printf("PASS dflash conv M%d block%d half%d exact CPU, pitched coefficient, guard, nondefault stream\n",m,block,half);
+}
+void dflash_mx_test(HMODULE dll,int m,int k,int impl){
+ const int n=128;float mag[]={0,.5f,1,1.5f,2,3,4,6};
+ std::vector<uint8_t>x(m*k),w(n*k/2),e(n*k/32);std::vector<float> sc(m*k/128);
+ for(auto& v:x)v=uint8_t(16+rng()%80)|((rng()&1)?128:0);
+ for(auto& v:w)v=rng()&255;for(auto& v:e)v=123+rng()%7;for(auto& v:sc)v=std::ldexp(1.0f,-5-int(rng()%3));
+ std::vector<double>ref(m*n);std::vector<uint16_t>out(m*n+32,0x7fc1);
+ for(int i=0;i<m;++i)for(int j=0;j<n;++j){double sum=0;for(int q=0;q<k;++q){unsigned code=(w[(j*k+q)/2]>>(4*(q&1)))&15;
+  sum+=double(fp8(x[i*k+q]))*sc[i*(k/128)+q/128]*mag[code&7]*((code&8)?-1:1)*std::ldexp(1.0,int(e[j*(k/32)+q/32])-127);}ref[i*n+j]=sum;}
+ Dev dev;RadTensor t[]={tensor(dev.put(x.size(),x.data()),RAD_F8E4M3,{m,k}),tensor(dev.put(sc.size()*4,sc.data()),RAD_F32,{m,k/128}),
+  tensor(dev.put(w.size(),w.data()),RAD_FP4E2M1,{n,k}),tensor(dev.put(e.size(),e.data()),RAD_E8M0,{n,k/32}),
+  tensor(dev.put(out.size()*2,out.data()),RAD_BF16,{m,n})};
+ RadParam p[]={RAD_INT("M",m),RAD_INT("N",n),RAD_INT("K",k),RAD_INT("group",128),RAD_STR("dtype","mxfp4a8"),RAD_INT("impl",impl)};
+ RadArgs a{};a.t=t;a.n_t=5;a.p=p;a.n_p=6;
+ auto fn=sym<RadLaunchFn>(dll,m<=16?"r3d_rad_gemm_nt_q_mxfp4a8_m16":"r3d_rad_gemm_nt_q_mxfp4a8_tiled");
+ hipStream_t stream;hc(hipStreamCreate(&stream));rc(fn(&a,(RadStream)stream),"draft MXFP4 GEMM");hc(hipStreamSynchronize(stream));hc(hipStreamDestroy(stream));
+ hc(hipMemcpy(out.data(),t[4].data,out.size()*2,hipMemcpyDeviceToHost));compare_bf(out,ref,.004,1e-4);
+ printf("PASS draft MXFP4 M%d N%d K%d impl%d CPU reference\n",m,n,k,impl);
+}
+void dflash_select_test(HMODULE dll,int steps,bool hidden){
+ const int m=2,nv=101,k=16,r=256,rows=m*steps;
+ std::vector<int32_t>cand(rows*k),anc={7,19},got(m*steps+16,-999),ref(m*steps);
+ std::vector<float>un(rows*k);std::vector<uint16_t>hp(rows*r),pred(nv*r),succ(nv*r);
+ for(auto& v:cand)v=rng()%nv;for(auto& v:un)v=(int(rng()%255)-127)/64.0f;
+ for(auto* vec:{&hp,&pred,&succ})for(auto& v:*vec)v=bf((int(rng()%255)-127)/128.0f);
+ for(int s=0;s<m;++s){int prev=anc[s];for(int step=0;step<steps;++step){int row=s*steps+step,best=0;float bs=-INFINITY;
+  for(int j=0;j<k;++j){int id=cand[row*k+j];float score=un[row*k+j];for(int q=0;q<r;++q){float a=fl(pred[prev*r+q])*(hidden?fl(hp[row*r+q]):1.0f);score+=a*fl(succ[id*r+q]);}if(score>bs){bs=score;best=j;}}
+  prev=ref[row]=cand[row*k+best];}}
+ Dev dev;RadTensor t[]={tensor(dev.put(cand.size()*4,cand.data()),RAD_I32,{rows,k}),tensor(dev.put(un.size()*4,un.data()),RAD_F32,{rows,k}),
+  tensor(hidden?dev.put(hp.size()*2,hp.data()):nullptr,RAD_BF16,{rows,r}),tensor(dev.put(anc.size()*4,anc.data()),RAD_I32,{m}),
+  tensor(dev.put(pred.size()*2,pred.data()),RAD_BF16,{nv,r}),tensor(dev.put(succ.size()*2,succ.data()),RAD_BF16,{nv,r}),
+  tensor(dev.put(got.size()*4,got.data()),RAD_I32,{m,steps})};
+ RadParam p[]={RAD_INT("M",m),RAD_INT("steps",steps),RAD_INT("top_k",k),RAD_INT("rank",r),RAD_INT("n_vocab",nv),RAD_STR("dtype","bf16")};
+ RadArgs a{};a.t=t;a.n_t=7;a.p=p;a.n_p=6;hipStream_t stream;hc(hipStreamCreate(&stream));
+ rc(sym<RadLaunchFn>(dll,"r3d_rad_dflash_select")(&a,(RadStream)stream),"draft selector");hc(hipStreamSynchronize(stream));hc(hipStreamDestroy(stream));
+ hc(hipMemcpy(got.data(),t[6].data,got.size()*4,hipMemcpyDeviceToHost));
+ for(size_t i=0;i<ref.size();++i)req(got[i]==ref[i],"draft selector CPU mismatch");
+ for(size_t i=ref.size();i<got.size();++i)req(got[i]==-999,"draft selector guard");
+ printf("PASS draft selector steps%d hidden%d exact CPU chain, guard, nondefault stream\n",steps,hidden);
+}
+void dflash_head_test(HMODULE dll,int m,bool logical,int n=64,int k=5120){
+ const int g=k/128;
+ std::vector<int8_t>x(m*k);std::vector<uint8_t>w(n*k/4),z(n*g);std::vector<uint16_t>sc(n*g),out(m*n+32,0x7fc1);
+ std::vector<float>as(m),sum(g*16),sf(n*g);std::vector<double>ref(m*n);
+ for(auto& v:x)v=int(rng()%255)-127;for(auto& v:w)v=rng()&255;for(auto& v:z)v=rng()%4;
+ for(int i=0;i<n*g;++i){sf[i]=std::ldexp(1.0f,-4-int(rng()%5));sc[i]=rad_f32_to_f16(sf[i]);}
+ for(auto& v:as)v=(1+rng()%19)/1731.0f;
+ auto pos=[](int q){return(q&~12)|((q&4)<<1)|((q&8)>>1);};
+ for(int i=0;i<m;++i)for(int q=0;q<k;++q)sum[(q/128)*16+i]+=x[i*k+pos(q)];
+ std::vector<uint16_t> exact(m*n);
+ for(int i=0;i<m;++i)for(int j=0;j<n;++j){float acc=0;for(int gg=0;gg<g;++gg){int dot=0;
+  for(int q=gg*128;q<(gg+1)*128;++q){int code=(w[(j*k+q)/4]>>(2*(q&3)))&3;dot+=int(x[i*k+pos(q)])*code;}
+  float sub=float(dot)-float(z[j*g+gg])*sum[gg*16+i];acc+=(sub*as[i])*sf[j*g+gg];}
+  exact[i*n+j]=bf(acc);ref[i*n+j]=acc;}
+ RadEncoding enc{};rad_enc_copy_str(enc.scheme,"affine");enc.n_planes=3;
+ const char* roles[]={"codes","scale","zero"};uint32_t dt[]={RAD_U2,RAD_F16,RAD_U8};
+ for(int i=0;i<3;++i){rad_enc_copy_str(enc.plane[i].role,roles[i]);enc.plane[i].dtype=dt[i];enc.plane[i].kind=RAD_PLANE_TILED;enc.plane[i].block[0]=1;enc.plane[i].block[1]=i?128:1;}
+ int sel[]={1,2};RadTensor planes[]={tensor(sc.data(),RAD_F16,{n,g}),tensor(z.data(),RAD_U8,{n,g})};RadPlanesEntry entries[2];
+ int64_t bytes=rad_planes_plan(&enc,sel,planes,2,entries);req(bytes>0,"draft head joined plan");std::vector<uint8_t>joined(bytes);
+ rc(rad_planes_relayout(&enc,sel,planes,2,joined.data(),bytes),"draft head relayout");
+ Dev dev;RadTensor t[]={tensor(dev.put(x.size(),x.data()),RAD_I8,{m,k}),tensor(dev.put(as.size()*4,as.data()),RAD_F32,{m}),
+  tensor(dev.put(w.size(),w.data()),RAD_U2,{n,k}),tensor(dev.put(joined.size(),joined.data()),RAD_U8,{bytes}),
+  tensor(dev.put(out.size()*2,out.data()),RAD_BF16,{m,n}),tensor(dev.put(sum.size()*4,sum.data()),RAD_F32,{g,16})};
+ if(logical)t[3]=tensor(t[3].data,RAD_F16,{n,k}); // actual engine's declared view, not stored byte shape
+ RadParam p[]={RAD_INT("M",m),RAD_INT("N",n),RAD_INT("K",k),RAD_INT("group",128),RAD_STR("dtype","w2a8")};
+ RadArgs a{};a.t=t;a.n_t=6;a.p=p;a.n_p=5;hipStream_t stream;hc(hipStreamCreate(&stream));
+ auto saved=t[3];t[3]=tensor(t[3].data,RAD_F16,{n,k+1});
+ req(sym<RadLaunchFn>(dll,"r3d_rad_gemm_nt_q_w2a8")(&a,(RadStream)stream)<0,"draft head wrong logical view accepted");
+ t[3]=tensor(saved.data,RAD_U8,{bytes-1});
+ req(sym<RadLaunchFn>(dll,"r3d_rad_gemm_nt_q_w2a8")(&a,(RadStream)stream)<0,"draft head short stored view accepted");t[3]=saved;
+ rc(sym<RadLaunchFn>(dll,"r3d_rad_gemm_nt_q_w2a8")(&a,(RadStream)stream),"draft U2 head");hc(hipStreamSynchronize(stream));hc(hipStreamDestroy(stream));
+ hc(hipMemcpy(out.data(),t[4].data,out.size()*2,hipMemcpyDeviceToHost));compare_bf(out,ref,.007,.0003);req(std::equal(exact.begin(),exact.end(),out.begin()),"U2 WMMA differs from reference-order CPU bytes");
+ printf("PASS draft U2 head M%d N%d K%d logical_view%d exact CPU bytes, device-only metadata, invalid views, guard\n",m,n,k,logical);
+}
+void dflash_state_test(HMODULE dll,int heads,int fp16,int accepted){
+ const int width=128*128,slot=heads*width,fstr=648,mark=16*fstr;
+ const int count=2*slot+32;
+ std::vector<float> input(count,0);std::vector<uint16_t> halves(count);
+ for(int i=0;i<slot;++i)input[i]=(int(rng()%255)-127)/4096.0f;
+ for(int h=0;h<heads;++h){int base=slot+h*width;
+  for(int t=0;t<16;++t){int f=base+t*fstr;
+   for(int k=0;k<128;++k){float v=(int(rng()%127)-63)/1024.0f;for(int g=0;g<4;++g)input[f+g*128+k]=v;}
+   for(int v=0;v<128;++v)input[f+512+v]=(int(rng()%127)-63)/512.0f;
+   for(int g=0;g<4;++g){input[f+640+2*g]=-.03125f*(1+t%3);input[f+641+2*g]=.125f*(1+t%4);}
+  }input[base+mark]=2;
+ }
+ for(int i=2*slot;i<count;++i)input[i]=17;
+ if(fp16)for(int i=0;i<count;++i){halves[i]=rad_f32_to_f16(input[i]);input[i]=rad_f16_to_f32(halves[i]);}
+ std::vector<double> ref(input.begin(),input.begin()+slot);
+ for(int h=0;h<heads;++h)for(int v=0;v<128;++v)for(int t=0;t<accepted;++t){
+  int f=slot+h*width+t*fstr,g=v/32;double decay=std::exp(double(input[f+640+2*g])),dot=0;
+  for(int k=0;k<128;++k){auto& x=ref[h*width+v*128+k];x*=decay;dot+=x*input[f+g*128+k];}
+  double delta=(input[f+512+v]-dot)*input[f+641+2*g];
+  for(int k=0;k<128;++k)ref[h*width+v*128+k]+=delta*input[f+g*128+k];
+ }
+ Dev dev;void* state=dev.put(count*(fp16?2:4),fp16?(void*)halves.data():(void*)input.data());
+ auto fn=sym<int(*)(void*,int,int,int)>(dll,"rad_gdn_materialize_v1");
+ req(fn(state,heads,fp16,17)!=0,"materializer accepted invalid prefix");
+ rc(fn(state,heads,fp16,accepted),"accepted GDN state materialization");
+ std::vector<float> got(count);if(fp16){hc(hipMemcpy(halves.data(),state,count*2,hipMemcpyDeviceToHost));for(int i=0;i<count;++i)got[i]=rad_f16_to_f32(halves[i]);}
+ else hc(hipMemcpy(got.data(),state,count*4,hipMemcpyDeviceToHost));
+ double maxerr=0;for(int i=0;i<slot;++i){double err=std::abs(got[i]-ref[i]);maxerr=std::max(maxerr,err);
+  req(std::isfinite(got[i]) && err<(fp16?2e-6:2e-7)+(fp16?6e-4:1e-5)*std::abs(ref[i]),"accepted-state CPU mismatch");}
+ for(int i=slot;i<count;++i)if(i<2*slot && (i-slot)%width==mark)req(got[i]==3,"materializer marker");else req(got[i]==input[i],"materializer factor or guard overwritten");
+ printf("PASS GDN accepted-state heads%d fp16%d prefix%d independent CPU max_abs=%g\n",heads,fp16,accepted,maxerr);
+}
+void dflash_tests(HMODULE dll,HMODULE r3d){
+ for(int m:{1,8,17})for(int block:{2,4,8})for(int half:{0,1})dflash_conv_test(dll,m,block,half);
+ for(int m:{1,8,65})for(int k:{256,5120})dflash_mx_test(r3d,m,k,0);
+ for(int steps:{1,3,7})for(bool hidden:{false,true})dflash_select_test(r3d,steps,hidden);
+ for(int m:{1,2,3,7,8,16})for(bool logical:{false,true})dflash_head_test(r3d,m,logical);
+ for(int n:{1,15,16,17,63,65,127})for(int m:{1,8})dflash_head_test(r3d,m,true,n,128);
+ for(int h:{1,3})for(int fp16:{0,1})for(int accepted:{0,1,4,8,16})dflash_state_test(r3d,h,fp16,accepted);
+ puts("DFLASH_GPU_QUALIFICATION_PASS");
+}
diff --git a/libr3diqr/fusion_gpu_test.inc b/libr3diqr/fusion_gpu_test.inc
new file mode 100644
--- /dev/null
+++ b/libr3diqr/fusion_gpu_test.inc
@@ -0,0 +1,119 @@
+// Compare fused paths with their previously qualified unfused compositions.
+// Repetition, independent streams, graph replay, optional BF16 output and padded
+// row strides exercise the arrival protocol and the engine's band-M contract.
+void fusion_gated_test(Api& api,HMODULE dll,int m,int n,int k,int bits,bool sigmoid,bool has_y) {
+    Weight w(n,k,bits,bits==2?15:16,512);
+    std::vector<RadParam> p={RAD_INT("M",16),RAD_INT("N",n),RAD_INT("K",k),RAD_INT("group",128),RAD_STR("dtype","i8a8h"),RAD_STR("act",sigmoid?"sigmoid":"silu")};
+    auto pw=w.store(api,2,p),ps=w.store(api,3,p);
+    const int h=n/2,xld=k+16,xsld=k/128+4,qld=h+16,sld=h/128+4,yld=h+8;
+    std::vector<int8_t> x(m*xld),q(m*qld+64,107);
+    std::vector<float> xs(m*xsld,0),sc(m*sld+64,-9.0f);
+    std::vector<uint16_t> ob(m*yld+64,0x7fc1);
+    for(auto& v:x)v=(int8_t)((int)(rng()%255)-127);
+    for(auto& v:xs)v=(1+rng()%13)/512.0f;
+    std::fill(x.begin(),x.begin()+k,0); // exercises the zero scale convention
+    Dev d;
+    RadTensor common[]={tensor(d.put(x.size(),x.data()),RAD_I8,{m,k}),tensor(d.put(xs.size()*4,xs.data()),RAD_F32,{m,k/128}),
+        tensor(d.put(pw.data.size(),pw.data.data()),pw.desc.dtype,{n,k}),tensor(d.put(ps.data.size(),ps.data.data()),ps.desc.dtype,{n,k/128})};
+    common[0].stride[0]=xld;common[1].stride[0]=xsld;
+    RadTensor t[3][7]{};RadArgs args[3]{};
+    auto fused=sym<RadLaunchFn>(dll,"r3di_gated_gemm"),plain=sym<RadLaunchFn>(dll,"r3di_gated_gemm_fallback");
+    for(int i=0;i<3;++i){
+        std::copy(common,common+4,t[i]);
+        t[i][4]=tensor(d.put(q.size(),q.data()),RAD_I8,{m,h});t[i][4].stride[0]=qld;
+        t[i][5]=tensor(d.put(sc.size()*4,sc.data()),RAD_F32,{m,h/128});t[i][5].stride[0]=sld;
+        if(has_y){t[i][6]=tensor(d.put(ob.size()*2,ob.data()),RAD_BF16,{m,h});t[i][6].stride[0]=yld;}
+        auto& a=args[i];a.t=t[i];a.n_t=7;a.p=p.data();a.n_p=p.size();
+        a.scratch_bytes=sym<RadScratchFn>(dll,"r3di_gated_gemm_scratch")(&a);a.scratch=d.put(a.scratch_bytes);
+    }
+    hipStream_t streams[2];for(auto& s:streams)hc(hipStreamCreateWithFlags(&s,hipStreamNonBlocking));
+    rc(plain(args,nullptr),"gated reference");hc(hipDeviceSynchronize());
+    // Warm allocations before capture, then overlap independent outputs.
+    for(int i=0;i<2;++i)rc(fused(&args[i+1],(RadStream)streams[i]),"gated warmup");
+    for(auto s:streams)hc(hipStreamSynchronize(s));
+    for(int rep=0;rep<32;++rep)for(int i=0;i<2;++i)rc(fused(&args[i+1],(RadStream)streams[i]),"gated repeated");
+    for(auto s:streams)hc(hipStreamSynchronize(s));
+    hipGraph_t graph;hipGraphExec_t executable;
+    hc(hipStreamBeginCapture(streams[0],hipStreamCaptureModeThreadLocal));
+    rc(fused(&args[1],(RadStream)streams[0]),"gated capture");
+    hc(hipStreamEndCapture(streams[0],&graph));hc(hipGraphInstantiate(&executable,graph,nullptr,nullptr,0));
+    for(int i=0;i<8;++i)hc(hipGraphLaunch(executable,streams[0]));
+    hc(hipStreamSynchronize(streams[0]));hc(hipGraphExecDestroy(executable));hc(hipGraphDestroy(graph));
+    for(int slot=4;slot<=6;++slot){
+        if(slot==6&&!has_y)continue;
+        size_t bytes=slot==4?q.size():slot==5?sc.size()*4:ob.size()*2;
+        std::vector<uint8_t> expected(bytes),actual(bytes);
+        hc(hipMemcpy(expected.data(),t[0][slot].data,bytes,hipMemcpyDeviceToHost));
+        for(int i=1;i<3;++i){hc(hipMemcpy(actual.data(),t[i][slot].data,bytes,hipMemcpyDeviceToHost));req(actual==expected,"fused gate differs from unfused bytes/padding");}
+    }
+    if(n>4096) {
+        hipEvent_t begin,end;hc(hipEventCreate(&begin));hc(hipEventCreate(&end));
+        std::vector<float> timings[2];RadLaunchFn fn[]={plain,fused};
+        for(int rep=0;rep<7;++rep)for(int turn=0;turn<2;++turn){int i=(rep+turn)&1;
+            hc(hipEventRecord(begin,streams[0]));for(int j=0;j<8;++j)rc(fn[i](&args[1],(RadStream)streams[0]),"gate bench");
+            hc(hipEventRecord(end,streams[0]));hc(hipEventSynchronize(end));float ms;hc(hipEventElapsedTime(&ms,begin,end));timings[i].push_back(ms/8);}
+        for(auto& v:timings)std::sort(v.begin(),v.end());
+        printf("FUSION_BENCH M%d N%d K%d unfused_ms=%.6f fused_ms=%.6f speedup=%.4f\n",m,n,k,timings[0][3],timings[1][3],timings[0][3]/timings[1][3]);fflush(stdout);
+        hc(hipEventDestroy(begin));hc(hipEventDestroy(end));
+    }
+    for(auto s:streams)hc(hipStreamDestroy(s));
+    for(int i=1;i<3;++i)sym<void(*)(const void*,int64_t)>(dll,"rad_plugin_freed")(t[i][4].data,q.size());
+    printf("PASS fused gate B%d M%d N%d K%d sigmoid%d optional%d exact bytes, pitch, streams, graph\n",bits,m,n,k,sigmoid,has_y);
+}
+
+void fusion_gdn_test(Api& api,HMODULE dll,int m,bool anchor) {
+    constexpr int H=4,Hg=2,K=128,V=128,C=2*Hg*K+H*V,SL=10,COLS=8;
+    Dev d;
+    auto random_bf=[](int n){std::vector<uint16_t> v(n);for(auto& z:v)z=bf(((int)(rng()%257)-128)/256.0f);return v;};
+    auto in=random_bf(m*(C+H*V)),ab=random_bf(m*H*2),cw=random_bf(C*4),cs=random_bf(C*SL);
+    std::vector<float> state(COLS*H*V*K,0.0f),alog(H,-2.0f),dtb(H,-1.0f),nw(V,1.0f);
+    std::vector<uint16_t> out(m*H*V+64,0x7fc1);
+    std::vector<int8_t> codes(m*H*V+64,107);std::vector<float> scales(m*H+64,-9.0f);
+    int ci=0,na=1,cu[2]={0,m},si[COLS];for(int i=0;i<COLS;++i)si[i]=i;
+    auto dx=(uint16_t*)d.put(in.size()*2,in.data()),da=(uint16_t*)d.put(ab.size()*2,ab.data());
+    auto x=tensor(dx,RAD_BF16,{m,C});x.stride[0]=C+H*V;
+    auto z=tensor(dx+C,RAD_BF16,{m,H*V});z.stride[0]=C+H*V;
+    auto a=tensor(da,RAD_BF16,{m,H});a.stride[0]=H*2;
+    auto b=tensor(da+H,RAD_BF16,{m,H});b.stride[0]=H*2;
+    RadTensor t[2][18]{};
+    t[0][0]=x;t[0][1]=tensor(d.put(cw.size()*2,cw.data()),RAD_BF16,{C,4});
+    t[0][4]=tensor(d.put(4,&ci),RAD_I32,{1});t[0][5]=a;t[0][6]=b;
+    t[0][7]=tensor(d.put(H*4,alog.data()),RAD_F32,{H});t[0][8]=tensor(d.put(H*4,dtb.data()),RAD_F32,{H});
+    t[0][10]=tensor(d.put(sizeof(si),si),RAD_I32,{1,COLS});t[0][11]=tensor(d.put(4,&na),RAD_I32,{1});
+    t[0][12]=tensor(d.put(sizeof(cu),cu),RAD_I32,{2});t[0][13]=z;t[0][14]=tensor(d.put(V*4,nw.data()),RAD_F32,{V});
+    std::copy(t[0],t[0]+18,t[1]);
+    RadParam p[]={RAD_INT("q_len",8),RAD_INT("head_k",K),RAD_INT("head_v",V),RAD_INT("conv_width",4),RAD_INT("n_head_v",H),RAD_F64("scale",.088388),RAD_F64("eps",1e-6),RAD_STR("act","silu"),RAD_STR("state_form",anchor?"anchor":"per_candidate")};
+    RadArgs args[2]{};
+    for(int i=0;i<2;++i){
+        t[i][3]=tensor(d.put(cs.size()*2,cs.data()),RAD_BF16,{1,C,SL});t[i][9]=tensor(d.put(state.size()*4,state.data()),RAD_F32,{COLS,H,V,K});
+        t[i][15]=tensor(d.put(out.size()*2,out.data()),RAD_BF16,{m,H,V});
+        t[i][16]=tensor(d.put(codes.size(),codes.data()),RAD_I8,{m,H*V});t[i][17]=tensor(d.put(scales.size()*4,scales.data()),RAD_F32,{m,H});
+        args[i].t=t[i];args[i].n_t=18;args[i].p=p;args[i].n_p=sizeof(p)/sizeof(p[0]);
+    }
+    auto plain=sym<RadLaunchFn>(dll,"r3dh_rad_gdn_conv_recurrent_update"),fused=sym<RadLaunchFn>(dll,"r3dh_rad_gdn_conv_recurrent_update_had");
+    hipStream_t stream;hc(hipStreamCreateWithFlags(&stream,hipStreamNonBlocking));
+    for(int step=0;step<4;++step){
+        args[0].n_t=16;rc(plain(&args[0],(RadStream)stream),"GDN reference");
+        RadTensor qt[]={tensor(t[0][15].data,RAD_BF16,{m,H*V}),t[0][16],t[0][17]};
+        RadParam qp[]={RAD_INT("M",m),RAD_INT("n",H*V),RAD_INT("group",128),RAD_STR("dtype","bf16")};
+        RadArgs qa{};qa.t=qt;qa.n_t=3;qa.p=qp;qa.n_p=4;rc(api.quant(&qa,(RadStream)stream),"GDN reference quant");
+        rc(fused(&args[1],(RadStream)stream),"GDN fused");hc(hipStreamSynchronize(stream));
+        for(int slot:{3,9,15,16,17}){
+            size_t bytes=slot==3?cs.size()*2:slot==9?state.size()*4:slot==15?out.size()*2:slot==16?codes.size():scales.size()*4;
+            std::vector<uint8_t> l(bytes),r(bytes);hc(hipMemcpy(l.data(),t[0][slot].data,bytes,hipMemcpyDeviceToHost));hc(hipMemcpy(r.data(),t[1][slot].data,bytes,hipMemcpyDeviceToHost));
+            if(l!=r)printf("GDN mismatch M%d anchor%d slot%d step%d\n",m,anchor,slot,step);
+            req(l==r,"fused GDN differs from reference bytes/state/guards");
+        }
+    }
+    hc(hipStreamDestroy(stream));
+    for(int i=0;i<2;++i)sym<void(*)(const void*,int64_t)>(dll,"rad_plugin_freed")(t[i][15].data,out.size()*2);
+    printf("PASS fused GDN M%d anchor%d exact output/codes/scales/state/conv, four steps\n",m,anchor);
+}
+
+void fusion_tests(Api& api,HMODULE iqr,HMODULE r3d) {
+    for(int m:{1,2,7,8,16})for(int bits:{2,3,4,5,6})fusion_gated_test(api,iqr,m,512,256,bits,m%2==0,m%2!=0);
+    fusion_gated_test(api,iqr,1,512,5120,2,false,true);
+    fusion_gated_test(api,iqr,8,512,5120,3,false,true);
+    fusion_gated_test(api,iqr,1,4096,256,2,false,false);
+    for(int m:{1,2,7,8})for(bool anchor:{false,true})fusion_gdn_test(api,r3d,m,anchor);
+}
diff --git a/libr3diqr/iqr_bench.inc b/libr3diqr/iqr_bench.inc
new file mode 100644
--- /dev/null
+++ b/libr3diqr/iqr_bench.inc
@@ -0,0 +1,43 @@
+// Same device buffers, stream and packed weights; interleaved baseline/candidate
+// launches measured by HIP events. Large shapes are compared numerically as well
+// as the independent canonical-trellis reference in the ordinary test suite.
+void benchmark(const char* baseline,const char* candidate){
+ HMODULE handles[2]={LoadLibraryA(baseline),LoadLibraryA(candidate)};
+ req(handles[0]&&handles[1],"benchmark DLL load");
+ for(auto h:handles)rc(sym<int(*)()>(h,"rad_plugin_open")(),"benchmark plugin_open");
+ Api api[2]={Api(handles[0]),Api(handles[1])};
+ hipStream_t stream;hc(hipStreamCreate(&stream));hipEvent_t start,stop;
+ hc(hipEventCreate(&start));hc(hipEventCreate(&stop));
+ for(int bits:{2,4}){
+  const int n=5120,k=5120;Weight w(n,k,bits,bits==2?15:16,512);
+  for(int m:{1,16,256}){
+   std::vector<RadParam> p={RAD_INT("M",m),RAD_INT("N",n),RAD_INT("K",k),RAD_INT("group",128),RAD_STR("dtype","i8a8h")};
+   auto pw=w.store(api[0],2,p),ps=w.store(api[0],3,p);
+   std::vector<int8_t> x(m*k);std::vector<float> xs(m*k/128);
+   for(auto& v:x)v=int8_t(int(rng()%255)-127);for(auto& v:xs)v=(1+rng()%13)/512.0f;
+   Dev dev;RadTensor t[]={tensor(dev.put(x.size(),x.data()),RAD_I8,{m,k}),tensor(dev.put(xs.size()*4,xs.data()),RAD_F32,{m,k/128}),
+    tensor(dev.put(pw.data.size(),pw.data.data()),pw.desc.dtype,{n,k}),tensor(dev.put(ps.data.size(),ps.data.data()),ps.desc.dtype,{n,k/128}),
+    tensor(dev.put((size_t)m*n*2),RAD_BF16,{m,n})};
+   RadArgs args[2]{};std::vector<uint16_t> output[2];
+   for(int id=0;id<2;++id){
+    auto& a=args[id];a.t=t;a.n_t=5;a.p=p.data();a.n_p=p.size();
+    if(api[id].gemm_scratch){a.scratch_bytes=api[id].gemm_scratch(&a);if(a.scratch_bytes)a.scratch=dev.put(a.scratch_bytes);}
+    for(int i=0;i<2;++i)rc(api[id].gemm(&a,(RadStream)stream),"benchmark warmup");hc(hipStreamSynchronize(stream));
+    output[id].resize(m*n);hc(hipMemcpy(output[id].data(),t[4].data,(size_t)m*n*2,hipMemcpyDeviceToHost));
+   }
+   double err=0,norm=0,maxabs=0;
+   for(size_t i=0;i<output[0].size();++i){double a=fl(output[0][i]),b=fl(output[1][i]);req(std::isfinite(b),"benchmark nonfinite");err+=(a-b)*(a-b);norm+=a*a;maxabs=std::max(maxabs,std::abs(a-b));}
+   double rel=std::sqrt(err/std::max(norm,1e-30));req(rel<.004,"large-shape candidate disagrees with baseline");
+   std::vector<float> times[2];
+   for(int round=0;round<7;++round)for(int turn=0;turn<2;++turn){int id=(round+turn)%2;
+    hc(hipEventRecord(start,stream));for(int i=0;i<3;++i)rc(api[id].gemm(&args[id],(RadStream)stream),"benchmark launch");
+    hc(hipEventRecord(stop,stream));hc(hipEventSynchronize(stop));float ms;hc(hipEventElapsedTime(&ms,start,stop));times[id].push_back(ms/3);
+   }
+   for(auto& v:times)std::sort(v.begin(),v.end());
+   printf("BENCH B%d M%d N%d K%d baseline_ms=%.6f candidate_ms=%.6f speedup=%.3f rel_l2=%.8g max_abs=%.8g scratch_bytes=%lld\n",
+    bits,m,n,k,times[0][3],times[1][3],times[0][3]/times[1][3],rel,maxabs,(long long)args[1].scratch_bytes);fflush(stdout);
+  }
+ }
+ hc(hipEventDestroy(start));hc(hipEventDestroy(stop));hc(hipStreamDestroy(stream));
+ puts("IQR_BENCH_PASS");
+}
