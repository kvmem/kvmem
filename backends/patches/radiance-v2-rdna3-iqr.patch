+// Independent numerical qualification of the loaded GPU plugin. Canonical
+// codes are kept separately; the oracle walks the mathematical tail-biting
+// trellis, never the imported packed decoder or its fragment addressing.
+#include "rad_abi.h"
+#include "rad_plugin.h"
+#include "rad_encoding.h"
+#include "r3di_args.h"
+#include <hip/hip_runtime.h>
+#ifdef _WIN32
+#include <windows.h>
+static constexpr const char* generic_plugin = "libr3d.dll";
+#else
+#include <dlfcn.h>
+using HMODULE = void*;
+static HMODULE LoadLibraryA(const char* p) { return dlopen(p, RTLD_NOW | RTLD_LOCAL); }
+static void* GetProcAddress(HMODULE m, const char* n) { return dlsym(m, n); }
+static constexpr const char* generic_plugin = "libr3d.so";
+#endif
+#include <algorithm>
+#include <cmath>
+#include <cstdio>
+#include <cstring>
+#include <memory>
+#include <limits>
+#include <stdexcept>
+#include <vector>
+#include <string>
+void req(bool v,const char* msg){if(!v)throw std::runtime_error(msg);}
+void hc(hipError_t e){if(e!=hipSuccess)throw std::runtime_error(hipGetErrorString(e));}
+void rc(int s,const char* what){if(s){printf("%s status=%d\n",what,s);throw std::runtime_error(what);}}
+uint32_t seed=0x853ac019;
+uint32_t rng(){seed^=seed<<13;seed^=seed>>17;seed^=seed<<5;return seed;}
+uint16_t bf(float x){uint32_t u;memcpy(&u,&x,4);return(uint16_t)((u+0x7fff+((u>>16)&1))>>16);}
+float fl(uint16_t h){uint32_t u=(uint32_t)h<<16;float f;memcpy(&f,&u,4);return f;}
+float fp8(uint8_t b){unsigned e=(b>>3)&15,m=b&7;float f=e?std::ldexp(1.0f+m/8.0f,(int)e-7):m/512.0f;return b&128?-f:f;}
+RadTensor tensor(void* p,uint32_t dt,std::initializer_list<int64_t> dims){RadTensor t{};t.data=p;t.dtype=dt;for(auto d:dims)t.shape[t.rank++]=d;rad_tensor_pack(&t);return t;}
+struct Dev {
+ std::vector<void*> ptr;
+ ~Dev(){for(auto p:ptr)hipFree(p);}
+ void* put(size_t n,const void* src=nullptr){void* p;hc(hipMalloc(&p,n));ptr.push_back(p);if(src)hc(hipMemcpy(p,src,n,hipMemcpyHostToDevice));else hc(hipMemset(p,0,n));return p;}
+};
+template<class T>T sym(HMODULE dll,const char* name){auto p=GetProcAddress(dll,name);req(p!=nullptr,name);return reinterpret_cast<T>(p);}
+struct Api {
+ RadLayoutFn layout,embed_layout;RadRelayoutFn relayout,embed_relayout;RadUnrelayoutFn inverse;
+ RadLaunchFn gemm,embed,vocab,quant,gated;RadScratchFn scratch,gemm_scratch;
+ Api(HMODULE d):layout(sym<RadLayoutFn>(d,"r3di_rad_layout_iqr")),embed_layout(sym<RadLayoutFn>(d,"r3di_rad_layout_iqr_embed")),
+ relayout(sym<RadRelayoutFn>(d,"r3di_rad_relayout_iqr")),embed_relayout(sym<RadRelayoutFn>(d,"r3di_rad_relayout_iqr_embed")),
+ inverse(sym<RadUnrelayoutFn>(d,"r3di_rad_unrelayout_iqr")),gemm(sym<RadLaunchFn>(d,"r3di_gemm")),embed(sym<RadLaunchFn>(d,"r3di_rad_embed_lookup_iqr")),
+ vocab(sym<RadLaunchFn>(d,"r3di_vocab")),quant(sym<RadLaunchFn>(d,"r3di_rad_had_quant_act_i8g")),gated(sym<RadLaunchFn>(d,"r3di_rad_gated_had_quant_i8g")),scratch(sym<RadScratchFn>(d,"r3di_vocab_scratch")),gemm_scratch((RadScratchFn)GetProcAddress(d,"r3di_gemm_scratch")){}
+};
+struct Weight {
+ int n,k,b,l,run;bool emb,group_bf16;RadEncoding enc{};
+ std::vector<std::vector<uint8_t>> planes;
+ std::vector<RadTensor> t;
+ std::vector<uint8_t> codes;
+ std::vector<float> row,col;
+ uint32_t A=0x05bd1e99,Bc=0x7ac395f1;
+ int find(const char* role){return rad_enc_find(&enc,role);}
+ Weight(int N,int K,int bits,int L,int R,bool E=false,bool G=false):n(N),k(K),b(bits),l(L),run(R),emb(E),group_bf16(G) {
+  req(!emb || !group_bf16,"embedding and grouped BF16 forms are distinct");
+  uint32_t types[]={0,RAD_U1,RAD_U2,RAD_U3,RAD_U4,RAD_U5,RAD_U6};
+  rad_enc_copy_str(enc.scheme,"trellis");rad_enc_copy_str(enc.transform,"fwht128");
+  rad_enc_add_plane(&enc,"codes",types[b],1,1);
+  rad_enc_add_plane(&enc,"scale",emb?RAD_F8E4M3:(group_bf16?RAD_BF16:RAD_F32),1,(emb||group_bf16)?128:0);
+  if(emb)rad_enc_add_plane(&enc,"scale.1",RAD_F32,0,0);
+  else if(!group_bf16)rad_enc_add_plane(&enc,"scale.col",RAD_F32,0,128);
+  int ti=rad_enc_add_table(&enc,"trellis",RAD_I8,1ll<<l,1);enc.plane[ti].block[0]=run;
+  if(!emb)rad_enc_add_table(&enc,"trellis.mad",RAD_U32,2,1);
+  planes.resize(enc.n_planes);t.resize(enc.n_planes);
+  for(int i=0;i<enc.n_planes;++i){int64_t r,c;rad_enc_plane_dims(&enc.plane[i],n,k,&r,&c);planes[i].resize(r*rad_enc_row_bytes(enc.plane[i].dtype,c));t[i]=tensor(planes[i].data(),enc.plane[i].dtype,{r,c});}
+  codes.resize((size_t)n*k);
+  auto& packed=planes[find("codes")];
+  for(size_t i=0;i<codes.size();++i){unsigned v=rng()% (1u<<b);codes[i]=(uint8_t)v;for(int bit=0;bit<b;++bit)if(v&(1u<<bit)){size_t at=i*b+bit;packed[at/8]|=1u<<(at%8);}}
+  auto& tab=planes[ti];
+  for(unsigned s=0;s<tab.size();++s){unsigned h=(s*(A&0xffffffu)+Bc)&0x3f3f3f3f;int v=int((h&255)+((h>>8)&255)+((h>>16)&255)+(h>>24))-126;tab[s]=(uint8_t)(int8_t)(emb?(int)(rng()%17)-8:v);}
+  if(emb){std::fill(planes[find("scale")].begin(),planes[find("scale")].end(),0x30);float f=.03125f;memcpy(planes[find("scale.1")].data(),&f,4);}
+  else if(group_bf16) {
+   memcpy(planes[find("trellis.mad")].data(),&A,4);memcpy(planes[find("trellis.mad")].data()+4,&Bc,4);
+   for(int r=0;r<n;++r)for(int g=0;g<k/128;++g){
+    const uint16_t v=bf((1+rng()%63)/4096.0f);
+    memcpy(planes[find("scale")].data()+2*((size_t)r*(k/128)+g),&v,2);
+   }
+  } else {
