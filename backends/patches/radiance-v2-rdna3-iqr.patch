+extern "C" int64_t r3di_gated_gemm_scratch(const RadArgs* a){
+ int64_t m=r3di_geti_or(a,"M",0),n=r3di_geti_or(a,"N",0);
+ if(m<=0||m>16||n<=0||n>INT_MAX||n%256)return 0;
+ return (m*n*2+255)&~int64_t(255);
+}
+extern "C" int r3di_gated_gemm_fallback(const RadArgs* a,RadStream stream){
+ if(!a||a->n_t<6||r3di_geti_or(a,"chain",0))return RAD_E_INVAL;
+ const auto &x=a->t[0],&w=a->t[2],&q=a->t[4],&s=a->t[5];
+ int64_t m=x.rank?x.shape[0]:0,n=r3di_geti_or(a,"N",0),k=r3di_geti_or(a,"K",0);
+ int64_t bytes=r3di_gated_gemm_scratch(a);
+ // M is the selected band's upper bound (for example 16 at actual M=1).
+ if(!bytes||!a->scratch||a->scratch_bytes<bytes||!r3di_aligned(a->scratch,256)||m<1||m>16||m>r3di_geti_or(a,"M",0)||w.rank!=2||w.shape[0]!=n||w.shape[1]!=k)return RAD_E_SHAPE;
+ if(!q.data||!s.data||q.dtype!=RAD_I8||s.dtype!=RAD_F32)return RAD_E_DTYPE;
+ long long qm=0,sm=0;
+ if(r3di_rows_pitch(&q,n/2,&qm)<n/2||qm!=m||r3di_rows_pitch(&s,n/256,&sm)<n/256||sm!=m)return RAD_E_SHAPE;
+ const char* act=r3di_gets(a,"act");if(!act|| (strcmp(act,"silu")&&strcmp(act,"sigmoid")))return RAD_E_INVAL;
+ RadTensor tmp{};tmp.data=a->scratch;tmp.dtype=RAD_BF16;tmp.rank=2;tmp.shape[0]=m;tmp.shape[1]=n;rad_tensor_pack(&tmp);
+ RadTensor gt[]={a->t[0],a->t[1],a->t[2],a->t[3],tmp};RadArgs ga=*a;ga.t=gt;ga.n_t=5;
+ int rc=r3di_gemm(&ga,stream);if(rc)return rc;
+ RadTensor qt[]={tmp,q,s,a->n_t>6?a->t[6]:RadTensor{}};
+ RadParam p[]={RAD_INT("M",m),RAD_INT("n",n/2),RAD_INT("group",128),RAD_STR("dtype","bf16"),RAD_STR("act",act)};
+ RadArgs qa{};qa.t=qt;qa.n_t=4;qa.p=p;qa.n_p=5;
+ return r3di_rad_gated_had_quant_i8g(&qa,stream);
+}
