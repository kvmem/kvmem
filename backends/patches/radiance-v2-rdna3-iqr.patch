+extern "C" int rad_plugin_open(){
+#ifdef _WIN32
+ return r3d_windows_device_open();
+#else
+ // Use the same runtime-free KFD topology check as libr3d.
+ const char* root="/sys/class/kfd/kfd/topology/nodes";
+ DIR* d=opendir(root);
+ if(!d)return RAD_E_UNSUPPORTED;
+ bool found=false;
+ while(const dirent* e=readdir(d)){
