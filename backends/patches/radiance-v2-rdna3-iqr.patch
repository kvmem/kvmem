--- /dev/null
+++ b/libr3diqr/r3di_iqr_dec.h
@@ -0,0 +1,418 @@
+/* r3di_iqr_dec.h -- device decoders of the IQR weights (r3di_iqr.h), decoded from their codes where
+ * they are read.
+ *
+ * A decoder is fetch (a lane's raw code dwords of one 16-row x 128-K unit, issued ahead like any
+ * operand load) and rows (raw to the int8 values: for each of the tile's 16 rows, the lane's four
+ * columns packed in a dword, the operand of one sudot4). A GEMM on the WMMA tiles takes the unit
+ * through `frag`: the 16 x 128 bytes through this wave's LDS tile, read back as the int8 tiles'
+ * fragment order (r3di_fp8_frag.h), two 64-K supertiles.
+ *
+ * The forms' tables are read from LDS, staged once a block by `stage`: Table and Trellis entries
+ * one byte each, Grid entries one V-vector each.
+ *
+ * A trellis column's 16 codes are followed in its stream by the first ones of the same column in
+ * the unit above, so each row's state is a field of that stream at a fixed position. On libquant's
+ * tcq_rb grid (LRB > 0) a value v is rint(v * own / B), own the row's scale and B its block's, the
+ * int8 libquant's grid_tcq_decode reads; the ratio is one IEEE division a (row, 128-K block), the
+ * host's f32 operations, computed by the lane of its row and read by the others. */
+#pragma once
+#include "r3di_device.h"
+#include "r3di_iqr.h"
+
+#include <hip/hip_runtime.h>
+#include <cstdint>
+
+namespace r3di_iqr_dev {
+
+using namespace r3di_fp8;
+using namespace r3di_iqr;
+
+template <uint32_t KIND_, uint32_t B_, uint32_t LV_ = 0, uint32_t L_ = 0, uint32_t LRB_ = 0,
+          uint32_t SC_ = kBf16>
+struct FormT {
+    static constexpr uint32_t KIND = KIND_, B = B_, LV = LV_, L = L_, LRB = LRB_, SC = SC_;
+    static constexpr uint32_t word() {
+        return r3di_iqr::word(Form{ KIND, B, LV, L, LRB, SC, 0 });
+    }
+};
+
+/* What a decoder reads besides the codes. */
+struct Ctx {
+    const uint8_t* W;       /* the weight buffer */
+    const uint8_t* S;       /* the scale buffer */
+    const int8_t* tab;      /* the form's table, staged in LDS */
+    uint32_t N, nkb;
+    uint32_t run_tiles;     /* a trellis run's 16-row tiles */
+};
+
+/* The LDS tile a unit is transposed through: 16 rows of 128 bytes and 8 of padding, so the sixteen
+ * rows' 8-byte fragment reads fall on distinct banks. */
+constexpr uint32_t kTrPitch = 136, kTrBytes = 16 * kTrPitch;
+
+/* Bits [s, s + n) of the 64 bits hi:lo, n <= 32 (constants after unrolling). On byte bounds one
+ * v_perm, which also zeroes the bytes above; else a funnel shift and a mask. */
+__device__ __forceinline__ uint32_t window(uint32_t lo, uint32_t hi, uint32_t s, uint32_t n) {
+    if (s % 8u == 0u && n % 8u == 0u && n < 32u) {
+        uint32_t sel = 0x0C0C0C0Cu;
+        for (uint32_t i = 0; i < n / 8u; ++i)   /* byte s / 8 + i of hi:lo: lo's 0-3, hi's 4-7 */
+            sel = (sel & ~(0xFFu << (8u * i))) | ((s / 8u + i) << (8u * i));
+        return __builtin_amdgcn_perm(hi, lo, sel);
+    }
+    const uint32_t m = n == 32u ? 0xFFFFFFFFu : ((1u << n) - 1u);
+    return __builtin_amdgcn_alignbit(hi, lo, s) & m;
+}
+
+/* `n` <= 32 bits of a little-endian dword stream from bit `o` (constant after unrolling). */
+template <uint32_t ND>
+__device__ __forceinline__ uint32_t field(const uint32_t (&d)[ND], uint32_t o, uint32_t n) {
+    const uint32_t q = o >> 5, s = o & 31u;
+    const uint32_t m = n == 32u ? 0xFFFFFFFFu : ((1u << n) - 1u);
+    if (s + n <= 32u) return (d[q] >> s) & m;
+    return window(d[q], q + 1u < ND ? d[q + 1u] : 0u, s, n);
+}
+
+/* Low bytes of two, then of two pairs, into one dword. */
+__device__ __forceinline__ uint32_t pack2(uint32_t lo, uint32_t hi) {
+    return __builtin_amdgcn_perm(hi, lo, 0x0c0c0400u);
+}
+__device__ __forceinline__ uint32_t pack4(uint32_t p01, uint32_t p23) {
+    return __builtin_amdgcn_perm(p23, p01, 0x05040100u);
+}
+
+template <uint32_t N>
+__device__ __forceinline__ void load_dw(uint32_t (&d)[N], const uint8_t* p, bool live) {
+#pragma unroll
+    for (uint32_t i = 0; i < N; ++i) d[i] = 0u;
+    if (!live) return;
+    uint32_t i = 0;
+#pragma unroll
+    for (; i + 4u <= N; i += 4u) {
+        const uint4 v = *(const uint4*)(p + 4 * i);
+        d[i] = v.x; d[i + 1] = v.y; d[i + 2] = v.z; d[i + 3] = v.w;
+    }
+    if constexpr (N % 4u == 3u) {
+        const uint3 v = *(const uint3*)(p + 4 * i);
+        d[i] = v.x; d[i + 1] = v.y; d[i + 2] = v.z;
+    } else if constexpr (N % 4u == 2u) {
+        const uint2 v = *(const uint2*)(p + 4 * i);
+        d[i] = v.x; d[i + 1] = v.y;
+    } else if constexpr (N % 4u == 1u) {
+        d[i] = *(const uint32_t*)(p + 4 * i);
+    }
+}
+
+/* The bf16 bits of x rounded to nearest even, as the host relayout and libquant round. */
+__device__ __forceinline__ uint32_t bf16_bits(float x) {
+    const uint32_t u = __float_as_uint(x);
+    return (u + 0x7FFFu + ((u >> 16) & 1u)) >> 16;
+}
+
+/* A row's own scale for 128-K block kb, as bf16 bits. */
+template <class F>
+__device__ __forceinline__ uint32_t own_scale(const Ctx& c, uint32_t r, uint32_t kb) {
+    const size_t i = ((size_t)(r / 16u) * c.nkb + kb) * 16u + r % 16u;
+    if constexpr (F::SC == kBf16) {
+        return ((const uint16_t*)c.S)[i];
+    } else {
+        constexpr Form f{ F::KIND, F::B, F::LV, F::L, F::LRB, F::SC, 0 };
+        const float* s2 = (const float*)(c.S + s2_off(f, c.N, (int64_t)c.nkb * 128));
+        return bf16_bits(s2[F::SC == kE4m3Row ? r : 0u] * e4m3(c.S[i]));
+    }
+}
+/* The scale the GEMM folds a row's block kb at: its own, or with LRB its block's. */
+template <class F>
+__device__ __forceinline__ uint32_t fold_scale(const Ctx& c, uint32_t r, uint32_t kb) {
+    if constexpr (F::LRB != 0) {
+        constexpr Form f{ F::KIND, F::B, F::LV, F::L, F::LRB, F::SC, 0 };
+        const uint16_t* bp = (const uint16_t*)(c.S + blk_off(f, c.N, (int64_t)c.nkb * 128));
+        return bp[(size_t)(r >> F::LRB) * c.nkb + kb];
+    } else {
+        return own_scale<F>(c, r, kb);
+    }
+}
+/* The f32 a GEMM folds row r's block kb at (with the activation's per-128 scale): the bf16 fold
+ * scale, or under one scale a row (kRowF32) the block's shared factor, the row's own then taken
+ * in the epilogue (row_scale). */
+template <class F>
+__device__ __forceinline__ float fold_f32(const Ctx& c, uint32_t r, uint32_t kb) {
+    if constexpr (F::SC == kRowF32) {
+        constexpr Form f{ F::KIND, F::B, F::LV, F::L, F::LRB, F::SC, 0 };
+        (void)r;
+        return ((const float*)(c.S + cf_off(f, c.N, (int64_t)c.nkb * 128)))[kb];
+    } else {
+        return bscale(fold_scale<F>(c, r, kb));
+    }
+}
+/* The factor row r's sums take in the epilogue: its kRowF32 scale, else 1. */
+template <class F>
+__device__ __forceinline__ float row_scale(const Ctx& c, uint32_t r) {
+    if constexpr (F::SC == kRowF32) return ((const float*)c.S)[r];
+    else { (void)c; (void)r; return 1.0f; }
+}
+
+/* The tcq_rb ratio own / B of a row's block kb (1 off that grid). */
+template <class F>
+__device__ __forceinline__ float rb_ratio(const Ctx& c, uint32_t r, uint32_t kb) {
+    if constexpr (F::LRB != 0) {
+        const float so = __uint_as_float(own_scale<F>(c, r, kb) << 16);
+        const float sb = __uint_as_float(fold_scale<F>(c, r, kb) << 16);
+        return sb > 0.0f ? __fdiv_rn(so, sb) : 0.0f;
+    } else {
+        return 1.0f;
+    }
+}
+
+/* H16: a tcq_rb trellis's state values staged as f16 (exact for int8), so a value's product with
+ * its ratio is one mixed-precision fma instead of a conversion and a multiply; twice the LDS, which
+ * the GEMV has to spare and the tiles do not. */
+template <class F, bool H16 = false>
+struct Dec {
+    static constexpr uint32_t B = F::B;
+    static constexpr bool TR = is_trellis(F::KIND), GRID = F::KIND == kGrid;
+    static constexpr bool MAD = F::KIND == kTrellisMad;   /* values computed, no table */
+    static constexpr uint32_t LANE_BITS = GRID ? (64u >> F::LV) * B : 64u * B;
+    /* A grid lane segment may start mid-dword: read the dword-aligned window covering it. */
+    static constexpr bool ALIGNED = LANE_BITS % 32u == 0u;
+    static constexpr uint32_t ND = ALIGNED ? LANE_BITS / 32u : (LANE_BITS + 24u + 31u) / 32u;
+    /* A trellis column's continuation: its first L - B bits in the unit above, which lie in one
+     * dword of that unit's lane segment for every width (column e starts at bit 16 B e), so a lane
+     * reads that dword alone of each of its four columns: p[e]. */
+    static constexpr uint32_t CB = 16u * B;
+    static constexpr uint32_t NP = TR ? 4u : 1u;
+    static constexpr uint32_t pdw(uint32_t e) { return e * CB / 32u; }
+    static constexpr uint32_t pbit(uint32_t e) { return e * CB % 32u; }
+    struct Raw { uint32_t d[ND]; uint32_t p[NP]; };
+    /* A trellis column's stream: its CB code bits, then its continuation, as NW dwords, which
+     * its sixteen rows' states are windows of (row q's at bit q B). Built once a unit: a dword of
+     * a column that does not start on a dword bound is one funnel shift or v_perm, where reading
+     * each state from the lane's codes would join every state that crosses a bound, and every
+     * continued one, separately. */
+    static constexpr uint32_t NW = TR ? (15u * B + F::L + 31u) / 32u : 1u;
+    __device__ static uint32_t colw(const Raw& r, uint32_t e, uint32_t i) {
+        const uint32_t a = e * CB + 32u * i, oe = e * CB + CB;
+        const uint32_t q = a >> 5, s = a & 31u;
+        if (a + 32u <= oe) return s == 0u ? r.d[q] : __builtin_amdgcn_alignbit(r.d[q + 1u], r.d[q], s);
+        if (a >= oe) return r.p[e] >> (pbit(e) + (a - oe));
+        const uint32_t n0 = oe - a;   /* the column's own last bits, then its continuation */
+        if (s + n0 == 32u && pbit(e) == 0u) return __builtin_amdgcn_alignbit(r.p[e], r.d[q], s);
+        if (s % 8u == 0u && n0 % 8u == 0u && pbit(e) % 8u == 0u && s + n0 <= 32u) {
+            uint32_t sel = 0u;
+            for (uint32_t j = 0; j < 4u; ++j) {
+                const uint32_t b = j < n0 / 8u ? s / 8u + j : 4u + pbit(e) / 8u + (j - n0 / 8u);
+                sel |= (b < 8u ? b : 0x0Cu) << (8u * j);
+            }
+            return __builtin_amdgcn_perm(r.p[e], r.d[q], sel);
+        }
+        return field<ND>(r.d, a, n0) | (r.p[e] >> pbit(e)) << n0;
+    }
+    __device__ static void columns(const Raw& r, uint32_t (&cw)[4][NW]) {
+#pragma unroll
+        for (uint32_t e = 0; e < 4; ++e)
+#pragma unroll
+            for (uint32_t i = 0; i < NW; ++i) cw[e][i] = colw(r, e, i);
+    }
+    /* Bits 16 .. 47 of words i and i + 1 of each column's stream. A state that crosses that
+     * bound starts past bit 16 of word i (L is at most 16), so it is a field of this word: one
+     * extract a state, where a funnel shift and a mask each would be two. */
+    __device__ static void mids(const uint32_t (&cw)[4][NW], uint32_t (&mw)[4][NW]) {
+#pragma unroll
+        for (uint32_t e = 0; e < 4; ++e)
+#pragma unroll
+            for (uint32_t i = 0; i < NW; ++i)
+                mw[e][i] = i + 1u < NW ? __builtin_amdgcn_alignbit(cw[e][i + 1u], cw[e][i], 16u) : 0u;
+    }
+    /* Row q's state of column e: L bits from bit q B of the column's stream. */
+    __device__ static uint32_t state(const uint32_t (&cw)[4][NW], const uint32_t (&mw)[4][NW],
+                                     uint32_t q, uint32_t e) {
+        constexpr uint32_t L = F::L;
+        static_assert(L <= 16u, "a crossing state within bits 16 .. 47");
+        const uint32_t o = q * B, i = o >> 5, s = o & 31u;
+        if (s + L <= 32u) return (cw[e][i] >> s) & ((1u << L) - 1u);
+        if (s % 8u == 0u && L % 8u == 0u) return window(cw[e][i], cw[e][i + 1u], s, L);
+        return (mw[e][i] >> (s - 16u)) & ((1u << L) - 1u);
+    }
+    static constexpr bool HALF = H16 && TR && !MAD && F::LRB != 0;
+    static constexpr uint32_t kTab = F::KIND == kTable ? 256u
+                                   : GRID ? (1u << B) << F::LV
+                                   : TR && !MAD ? (1u << F::L) * (HALF ? 2u : 1u) : 4u;
+
+    /* Copy the form's table into LDS; the caller then barriers. */
+    __device__ static void stage(int8_t* tab, const Ctx& c, uint32_t tid, uint32_t nthr) {
+        if constexpr (F::KIND == kTable || GRID || (TR && !MAD)) {
+            constexpr Form f{ F::KIND, F::B, F::LV, F::L, F::LRB, F::SC, 0 };
+            const uint32_t* src = (const uint32_t*)(c.W + aux_off(f, c.N, (int64_t)c.nkb * 128));
+            if constexpr (HALF) {
+                for (uint32_t i = tid; i < (1u << F::L) / 4u; i += nthr) {
+                    const uint32_t q = src[i];
+#pragma unroll
+                    for (uint32_t j = 0; j < 4; ++j)
+                        ((_Float16*)tab)[4 * i + j] = (_Float16)(float)(int8_t)(q >> (8 * j));
+                }
+            } else {
+                for (uint32_t i = tid; i < kTab / 4u; i += nthr) ((uint32_t*)tab)[i] = src[i];
+            }
+        }
+    }
+
+    __device__ static Raw fetch(const Ctx& c, uint32_t rt, uint32_t kb, uint32_t lane, bool live) {
+        Raw r;
+        constexpr size_t ub = 4u * LANE_BITS;
+        const uint8_t* unit = c.W + ((size_t)rt * c.nkb + kb) * ub;
+        if constexpr (ALIGNED) {
+            load_dw<ND>(r.d, unit + (size_t)lane * (LANE_BITS / 8u), live);
+        } else {
+            const uint32_t off = lane * (LANE_BITS / 8u);   /* LANE_BITS is whole bytes */
+            uint32_t w[ND];
+            load_dw<ND>(w, unit + (off & ~3u), live);
+            const uint32_t sh = (off & 3u) * 8u;
+#pragma unroll
+            for (uint32_t i = 0; i < ND; ++i)
+                r.d[i] = __builtin_amdgcn_alignbit(i + 1u < ND ? w[i + 1u] : 0u, w[i], sh);
+        }
+        if constexpr (TR) {
+            static_assert(!TR || (pbit(1) + F::L - B <= 32u && pbit(2) + F::L - B <= 32u &&
+                                  pbit(3) + F::L - B <= 32u),
+                          "a column's continuation in one dword");
+            const uint32_t rp = rt % c.run_tiles == 0u ? rt + c.run_tiles - 1u : rt - 1u;
+            const uint32_t* up = (const uint32_t*)(c.W + ((size_t)rp * c.nkb + kb) * ub +
+                                                   (size_t)lane * (LANE_BITS / 8u));
+#pragma unroll
+            for (uint32_t e = 0; e < 4; ++e) r.p[e] = live ? up[pdw(e)] : 0u;
+        } else {
+            r.p[0] = 0u;
+        }
+        return r;
+    }
+
+    /* The lane's four values of each of the tile's 16 rows, packed. `ratio` is row (lane & 15)'s
+     * tcq_rb ratio for this block (rb_ratio). UNS (a computed trellis off the tcq_rb grid): each
+     * value as its unsigned byte sum, the value plus 126, which the caller corrects in its sums. */
+    template <bool UNS = false>
+    __device__ static void rows(const Raw& r, const Ctx& c, float ratio, uint32_t (&w)[16]) {
+        static_assert(!UNS || (MAD && F::LRB == 0), "unsigned values: a computed trellis, one scale a row");
+        if constexpr (TR) {
+            /* All 64 states, then all 64 lookups, then the values: the LDS reads go out together
+             * instead of each waiting on the last's use. */
+            uint32_t st[64], cw[4][NW], mw[4][NW];
+            columns(r, cw);
+            mids(cw, mw);
+#pragma unroll
+            for (uint32_t q = 0; q < 16; ++q)
+#pragma unroll
+                for (uint32_t e = 0; e < 4; ++e) st[q * 4 + e] = state(cw, mw, q, e);
+            [[maybe_unused]] int32_t t[HALF ? 1 : 64];
+            [[maybe_unused]] _Float16 th[HALF ? 64 : 1];
+            if constexpr (MAD) {
+                /* bytesum((st * A + B) & 0x3F3F3F3F) - 126: st < 2^16 and A < 2^24, so the
+                 * 24-bit multiply is the full product mod 2^32 */
+                constexpr Form f{ F::KIND, F::B, F::LV, F::L, F::LRB, F::SC, 0 };
+                const uint32_t* ab = (const uint32_t*)(c.W + aux_off(f, c.N, (int64_t)c.nkb * 128));
+                const uint32_t A = ab[0], Bc = ab[1];
+#pragma unroll
+                for (uint32_t i = 0; i < 64; ++i) {
+                    /* the byte sum less the code's bias, in the dot's own accumulator */
+                    const uint32_t h = (__umul24(st[i], A) + Bc) & 0x3F3F3F3Fu;
+                    t[i] = __builtin_amdgcn_sudot4(false, (int)h, false, 0x01010101, UNS ? 0 : -126, false);
+                }
+            } else {
+#pragma unroll
+                for (uint32_t i = 0; i < 64; ++i) {
+                    if constexpr (HALF) th[i] = ((const _Float16*)c.tab)[st[i]];
+                    else t[i] = c.tab[st[i]];
+                }
+            }
+#pragma unroll
+            for (uint32_t q = 0; q < 16; ++q) {
+                uint32_t v[4];
+                if constexpr (F::LRB != 0) {
+                    /* rint(t * rq) as the low byte of t * rq + 1.5 * 2^23: the add rounds the f32
+                     * product to an integer, nearest even as rintf does, and |t * rq| <= 127
+                     * leaves it in the mantissa's low bits, two's complement in its low byte. */
+                    const float rq = __builtin_bit_cast(
+                        float, __builtin_amdgcn_readlane(__float_as_int(ratio), 15 - q));
+#pragma unroll
+                    for (uint32_t e = 0; e < 4; ++e) {
+                        /* the f16 value times rq, rounded once: the f32 product of the int8; a
+                         * computed code rounds the exact product, one fma */
+                        if constexpr (MAD) {
+                            v[e] = __float_as_uint(__builtin_fmaf((float)t[q * 4 + e], rq, 12582912.0f));
+                        } else {
+                            const float pr = HALF ? __builtin_fmaf((float)th[q * 4 + e], rq, 0.0f)
+                                                  : __fmul_rn((float)t[HALF ? 0 : q * 4 + e], rq);
+                            v[e] = __float_as_uint(__fadd_rn(pr, 12582912.0f));
+                        }
+                    }
+                } else {
+#pragma unroll
+                    for (uint32_t e = 0; e < 4; ++e) v[e] = (uint32_t)t[HALF ? 0 : q * 4 + e];
+                }
+                w[15u - q] = pack4(pack2(v[0], v[1]), pack2(v[2], v[3]));
+            }
+        } else if constexpr (GRID) {
+            constexpr uint32_t V = 1u << F::LV, PER = 4u / V;
+#pragma unroll
+            for (uint32_t q = 0; q < 16; ++q) {
+                if constexpr (V == 4u) {
+                    w[q] = *(const uint32_t*)(c.tab + field<ND>(r.d, q * B, B) * 4u);
+                } else {
+                    const uint32_t g0 = *(const uint16_t*)(c.tab + field<ND>(r.d, (q * PER) * B, B) * 2u);
+                    const uint32_t g1 = *(const uint16_t*)(c.tab + field<ND>(r.d, (q * PER + 1) * B, B) * 2u);
+                    w[q] = g0 | g1 << 16;
+                }
+            }
+        } else {
+            (void)ratio;
+#pragma unroll
+            for (uint32_t q = 0; q < 16; ++q) {
+                uint32_t v[4];
+#pragma unroll
+                for (uint32_t e = 0; e < 4; ++e) {
+                    const uint32_t code = field<ND>(r.d, (q * 4u + e) * B, B);
+                    if constexpr (F::KIND == kTable) v[e] = (uint8_t)c.tab[code];
+                    else if constexpr (F::KIND == kZero) v[e] = code;
+                    else v[e] = (uint32_t)((int32_t)(code << (32u - B)) >> (32u - B));
+                }
+                w[q] = pack4(pack2(v[0], v[1]), pack2(v[2], v[3]));
+            }
+        }
+    }
+
+    /* A computed trellis's masked hashes, one a value: h[q][e] for the lane's column e of row q,
+     * whose four bytes sum to the value plus 126. A dot of h with an activation byte repeated in
+     * each byte is the value plus 126 times the activation, the sum and the product in one. */
+    __device__ static void hashes(const Raw& r, const Ctx& c, uint32_t (&h)[16][4]) {
+        static_assert(MAD, "hashes: a computed trellis");
+        constexpr Form f{ F::KIND, F::B, F::LV, F::L, F::LRB, F::SC, 0 };
+        const uint32_t* ab = (const uint32_t*)(c.W + aux_off(f, c.N, (int64_t)c.nkb * 128));
+        const uint32_t A = ab[0], Bc = ab[1];
+        uint32_t cw[4][NW], mw[4][NW];
+        columns(r, cw);
+        mids(cw, mw);
+#pragma unroll
+        for (uint32_t q = 0; q < 16; ++q)
+#pragma unroll
+            for (uint32_t e = 0; e < 4; ++e) h[15u - q][e] = (__umul24(state(cw, mw, q, e), A) + Bc) & 0x3F3F3F3Fu;
+    }
+
+    /* Zero: the zero of row (rt*16 + q) for block kb is subtracted bytewise after `rows`. */
+    __device__ static void unzero(const Ctx& c, uint32_t rt, uint32_t kb, uint32_t (&w)[16]) {
+        if constexpr (F::KIND == kZero) {
+            constexpr Form f{ F::KIND, F::B, F::LV, F::L, F::LRB, F::SC, 0 };
+            const uint8_t* zp = c.W + aux_off(f, c.N, (int64_t)c.nkb * 128) +
+                                ((size_t)rt * c.nkb + kb) * 16u;
+            const uint4 z4 = *(const uint4*)zp;   /* the tile's 16 rows, one byte each */
+            const uint32_t zd[4] = { z4.x, z4.y, z4.z, z4.w };
+#pragma unroll
+            for (uint32_t q = 0; q < 16; ++q) {
+                const uint32_t z = (zd[q / 4u] >> (8u * (q % 4u))) & 0xFFu;
+                /* codes and zero are below 128, so bytewise subtraction borrows nothing across
+                 * bytes once 0x80 is added to each code byte and taken off the result */
+                w[q] = ((w[q] | 0x80808080u) - z * 0x01010101u) ^ 0x80808080u;
+            }
+        } else {
+            (void)c; (void)rt; (void)kb; (void)w;
+        }
+    }
+};
+
+} // namespace r3di_iqr_dev
diff --git a/libr3diqr/r3di_iqr_embed.hip b/libr3diqr/r3di_iqr_embed.hip
new file mode 100644
--- /dev/null
+++ b/libr3diqr/r3di_iqr_embed.hip
@@ -0,0 +1,142 @@
+// embed_lookup over an IQR table (r3di_iqr.h's embed_off): the gather decodes each requested row
+// from its codes, so VRAM holds the table at its codes' width.
+//
+// ref_embed_lookup's contract (r3di_model_bf16.hip's embed_lookup_kernel): x[m] is the table's row
+// tok[m] - vocab_offset, a zero row for an id outside this rank's rows, times `mult` with one
+// rounding. A row's value is the form's int8 value times its (row, 128) scale in f32, the 128-wide
+// Hadamard undone in f32 on a rotated table (libquant's butterfly order: span 1, 2, .., 64, each
+// pair (a, b) to (a + b, a - b)), rounded to bf16 to nearest even: the values the table's bf16
+// widening at load produced, bit for bit.
+
+#include "r3di_device.h"
+#include "r3di_args.h"
+
+
+#include "r3di_iqr.h"
+#include "r3di_iqr_dec.h"
+
+namespace {
+
+using namespace r3di_iqr;
+using namespace r3di_iqr_dev;
+
+/* `n` <= 16 bits of a byte stream from bit `o`. */
+__device__ __forceinline__ uint32_t bits_at(const uint8_t* p, uint64_t o, uint32_t n) {
+    const uint8_t* b = p + (o >> 3);
+    const uint32_t w = (uint32_t)b[0] | (uint32_t)b[1] << 8 | (uint32_t)b[2] << 16;
+    return (w >> (o & 7u)) & ((1u << n) - 1u);
+}
+
+template <uint32_t KIND, uint32_t B, uint32_t LV, uint32_t L, uint32_t LRB, uint32_t SC, uint32_t ROT>
+__global__ __launch_bounds__(128) void iqr_embed_kernel(const int32_t* __restrict__ tok,
+                                                        const uint8_t* __restrict__ W,
+                                                        uint16_t* __restrict__ x, uint32_t n_embd,
+                                                        int32_t n_vocab, int32_t vocab_off,
+                                                        uint32_t x_ld, float mult) {
+    constexpr Form f{ KIND, B, LV, L, LRB, SC, 0, ROT };
+    __shared__ float s_v[128];
+    const uint32_t m = blockIdx.x, g = blockIdx.y, t = threadIdx.x, k = g * 128u + t;
+    const int64_t id = (int64_t)tok[m] - vocab_off;
+    uint16_t* dst = x + (size_t)m * x_ld + k;
+    if (id < 0 || id >= n_vocab) {
+        *dst = 0;
+        return;
+    }
+    const EmbedOff o = embed_off(f, n_vocab, n_embd);
+    const uint32_t nkb = n_embd / 128u, r = (uint32_t)id;
+    auto code = [&](uint32_t row, uint32_t col) {
+        return bits_at(W + (size_t)row * o.codes_row, (uint64_t)col * B, B);
+    };
+    const int8_t* aux = (const int8_t*)(W + o.aux);
+    int32_t v;
+    if constexpr (KIND == kTable) {
+        v = aux[code(r, k)];
+    } else if constexpr (KIND == kGrid) {
+        v = aux[code(r, k >> LV) * (1u << LV) + (k & ((1u << LV) - 1u))];
+    } else if constexpr (KIND == kZero) {
+        v = (int32_t)code(r, k) - (int32_t)((const uint8_t*)aux)[(size_t)r * nkb + g];
+    } else if constexpr (KIND == kSigned) {
+        v = (int32_t)(code(r, k) << (32u - B)) >> (32u - B);
+    } else {
+        /* The trellis: row r's state is its last ceil(L/B) codes in its column, the run's 256
+         * rows wrapping (the launch refuses another run). */
+        constexpr uint32_t C = (L + B - 1) / B, run = 256u;
+        const uint32_t r0 = r / run * run;
+        uint32_t st = 0;
+#pragma unroll
+        for (uint32_t q = C; q-- > 0;) {
+            const uint32_t rr = r0 + (r - r0 + run - q) % run;
+            st = ((st << B) | code(rr, k)) & ((1u << L) - 1u);
+        }
+        v = aux[st];
+    }
+    /* The row's scale as bf16 bits: its own, or its block's on a tcq_rb grid, against which the
+     * value is rint(v * own / B). */
+    uint32_t own;
+    if constexpr (SC == kBf16) {
+        own = ((const uint16_t*)(W + o.sc))[(size_t)r * nkb + g];
+    } else {
+        const float s2 = ((const float*)(W + o.s2))[SC == kE4m3Row ? r : 0u];
+        own = bf16_bits(s2 * e4m3((W + o.sc)[(size_t)r * nkb + g]));
+    }
+    uint32_t sb = own;
+    if constexpr (LRB != 0) {
+        sb = ((const uint16_t*)(W + o.blk))[(size_t)(r >> LRB) * nkb + g];
+        const float so = __uint_as_float(own << 16), sbf = __uint_as_float(sb << 16);
+        v = sbf > 0.0f ? (int32_t)rintf(__fmul_rn((float)v, __fdiv_rn(so, sbf))) : 0;
+    }
+    float val = __fmul_rn((float)v, __uint_as_float(sb << 16));
+    if constexpr (ROT != 0) {
+        s_v[t] = val;
+        __syncthreads();
+#pragma unroll
+        for (uint32_t h = 1; h < 128u; h <<= 1) {
+            const float a = s_v[t & ~h], b = s_v[t | h];
+            const float y = (t & h) ? __fsub_rn(a, b) : __fadd_rn(a, b);
+            __syncthreads();
+            s_v[t] = y;
+            __syncthreads();
+        }
+        val = s_v[t];
+    }
+    uint32_t bits = bf16_bits(val);
+    if (mult != 1.0f) bits = r3di_bf16(__uint_as_float(bits << 16) * mult);
+    *dst = (uint16_t)bits;
+}
+
+}  // namespace
+
+enum { EL_TOK = 0, EL_WTE, EL_X };
+
+extern "C" int r3di_rad_embed_lookup_iqr(const RadArgs* a, RadStream stream) {
+    const RadTensor* tok = r3di_opt(a, EL_TOK);
+    const RadTensor* wte = r3di_opt(a, EL_WTE);
+    const RadTensor* x = r3di_opt(a, EL_X);
+    if (!tok || !wte || !x) return R3DI_NO(RAD_E_INVAL);
+    if (tok->dtype != RAD_I32 || x->dtype != RAD_BF16 || !is_weight_dtype(wte->dtype))
+        return R3DI_NO(RAD_E_DTYPE);
+    if (!r3di_contig(tok)) return R3DI_NO(RAD_E_STRIDE);
+    const long long n_embd = r3di_geti_or(a, "n_embd", 0), n_vocab = r3di_geti_or(a, "n_vocab", 0);
+    const long long voff = r3di_geti_or(a, "vocab_offset", 0);
+    if (n_embd <= 0 || n_embd % 128 || n_vocab <= 0 || voff < 0) return R3DI_NO(RAD_E_SHAPE);
+    long long M = 0;
+    const long long x_ld = r3di_rows_pitch(x, n_embd, &M);
+    if (x_ld < 0) return R3DI_NO(RAD_E_STRIDE);
+    if (M <= 0 || r3di_numel(tok) < M) return R3DI_NO(RAD_E_SHAPE);
+    const float mult = (float)r3di_getf(a, "mult", 1.0);
+    const uint32_t kw = kernel_word(wte->dtype & kWordMask);
+    const Form f = form(wte->dtype & kWordMask);
+    /* The run, which the kernel assumes, is libquant's tcq_rows = 256. */
+    if (f.kind == kTrellis && f.lrun != 8u) return R3DI_NO(RAD_E_SHAPE);
+    const dim3 grid((uint32_t)M, (uint32_t)(n_embd / 128));
+    int rc = RAD_E_UNSUPPORTED;
+#define R3DI_IQR_EGO(k, b, lv, l, lrb, sc, r)                                                     \
+    if (kw == word(Form{ k, b, lv, l, lrb, sc, 0, r }))                                          \
+        rc = R3DI_EMIT(stream, (iqr_embed_kernel<k, b, lv, l, lrb, sc, r>), grid, dim3(128), 0,     \
+                      (const int32_t*)tok->data, (const uint8_t*)wte->data, (uint16_t*)x->data,   \
+                      (uint32_t)n_embd, (int32_t)n_vocab, (int32_t)voff, (uint32_t)x_ld, mult);   \
+    else
+    R3DI_IQR_EMBED_FORMS(R3DI_IQR_EGO) { return R3DI_NO(RAD_E_UNSUPPORTED); }
+#undef R3DI_IQR_EGO
+    return rc == RAD_OK && hipGetLastError() == hipSuccess ? RAD_OK : R3DI_NO(RAD_E_DEVICE);
+}
diff --git a/libr3diqr/r3di_iqr_layout.cpp b/libr3diqr/r3di_iqr_layout.cpp
new file mode 100644
--- /dev/null
+++ b/libr3diqr/r3di_iqr_layout.cpp
@@ -0,0 +1,906 @@
+/* r3di_iqr_layout.cpp -- the IQR weights' stored form (r3di_iqr.h) from a container's planes, and
+ * back. Pure host C++, as r3di_fp8_layout.cpp.
+ *
+ * The weight buffer is the codes reordered into lane segments plus the form's table or zero plane;
+ * the scale buffer is the scale plane in tile-major order, with its second level and, on a tcq_rb
+ * trellis, the block scale B each block of rows is read at. Every bit of the codes is kept and
+ * nothing is widened: VRAM holds a B-bit weight in B bits. The relayout refuses (RAD_E_FORMAT) a
+ * code no entry answers and a value outside the int8 grid's -127..127, which no kernel could
+ * read. */
+
+#include "r3di_plugin.h"
+#include "r3di_iqr.h"
+#include "r3di_fp8_frag.h"
+#include "r3di_enc.h"
+#include "r3di_hsimd.h"
+#include "r3di_par.h"
+
+#include <algorithm>
+#include <atomic>
+#include <cmath>
+#include <cstdint>
+#include <cstring>
+#include <thread>
+#include <vector>
+
+using namespace r3di_iqr;
+
+/* Operand indices of `gemm_nt_q` (r3di_rows.cpp). */
+enum { IL_B = 2, IL_BSCALE = 3 };
+
+namespace {
+
+int log2_exact(int64_t v) {
+    if (v <= 0 || (v & (v - 1))) return -1;
+    int l = 0;
+    while (((int64_t)1 << l) < v) ++l;
+    return l;
+}
+
+int unsigned_bits(uint32_t dt) {
+    static const uint32_t kU[] = { RAD_U1, RAD_U2, RAD_U3, RAD_U4, RAD_U5, RAD_U6, RAD_U7, RAD_U8 };
+    for (int i = 0; i < 8; ++i)
+        if (dt == kU[i]) return i + 1;
+    return 0;
+}
+int signed_bits(uint32_t dt) {
+    static const uint32_t kS[] = { RAD_I2, RAD_I3, RAD_I4, RAD_I5, RAD_I6, RAD_I7 };
+    for (int i = 0; i < 6; ++i)
+        if (dt == kS[i]) return i + 2;
+    return 0;
+}
+
+/* The scale plane a form reads: one bf16 per [1 x 128], or E4M3 per [1 x 128] under an f32 or bf16
+ * second level for the tensor or the row. */
+bool scale_form(const RadEncoding* enc, int want_planes, uint32_t* out) {
+    const RadEncPlane* sc = rad_enc_plane(enc, "scale");
+    const RadEncPlane* s2 = rad_enc_plane(enc, "scale.1");
+    /* one f32 a row (block [1 x whole]), with a "scale.col" f32 a [whole x 128] or none */
+    if (sc && sc->kind == RAD_PLANE_TILED && sc->block[0] == 1 && sc->block[1] == 0 &&
+        sc->dtype == RAD_F32 && !s2) {
+        const RadEncPlane* cf = rad_enc_plane(enc, "scale.col");
+        if (cf && (cf->kind != RAD_PLANE_TILED || cf->dtype != RAD_F32 || cf->block[0] != 0 ||
+                   cf->block[1] != 128))
+            return false;
+        if (enc->n_planes != want_planes + (cf ? 1 : 0)) return false;
+        *out = kRowF32;
+        return true;
+    }
+    if (!sc || sc->kind != RAD_PLANE_TILED || sc->block[0] != 1 || sc->block[1] != 128) return false;
+    if (!s2) {
+        if (sc->dtype != RAD_BF16 || enc->n_planes != want_planes) return false;
+        *out = kBf16;
+        return true;
+    }
+    if (sc->dtype != RAD_F8E4M3 || enc->n_planes != want_planes + 1) return false;
+    if (s2->kind != RAD_PLANE_TILED || (s2->dtype != RAD_F32 && s2->dtype != RAD_BF16) ||
+        s2->block[1] != 0 || (s2->block[0] != 0 && s2->block[0] != 1))
+        return false;
+    *out = s2->block[0] == 0 ? kE4m3Tensor : kE4m3Row;
+    return true;
+}
+
+/* Which IQR form `enc` is at transform `tr`, and the entries its table holds. Int8 codes are not
+ * one: the int8 GEMMs read them as they are. */
+bool classify(const RadEncoding* enc, const char* tr, Form* f, int64_t* entries) {
+    *f = Form{};
+    *entries = 0;
+    if (!enc || std::strncmp(enc->transform, tr, RAD_ENC_STR) != 0) return false;
+    const RadEncPlane& cp = enc->plane[0];
+    if (std::strncmp(cp.role, "codes", RAD_ENC_STR) != 0) return false;
+    if (rad_enc_is(enc, "trellis")) {
+        const RadEncPlane* tp = rad_enc_plane(enc, "trellis");
+        /* tcq_code=mad: A and B beside the table, the values computed where they are read */
+        const RadEncPlane* mp = rad_enc_plane(enc, "trellis.mad");
+        const int b = unsigned_bits(cp.dtype);
+        uint32_t sc = 0;
+        if (!tp || !b || cp.block[0] != 1 || cp.block[1] != 1 || !scale_form(enc, mp ? 4 : 3, &sc))
+            return false;
+        if (mp && (mp->kind != RAD_PLANE_TABLE || mp->dtype != RAD_U32 || mp->extent[0] != 2 ||
+                   mp->extent[1] != 1))
+            return false;
+        const int L = log2_exact(tp->extent[0]);
+        const int lrun = log2_exact(tp->block[0]);
+        const int lrb = tp->block[1] > 1 ? log2_exact(tp->block[1]) : 0;
+        /* A table's values are read from LDS (16 KiB at L = 14), a computed code's from none; a run
+         * is whole 16-row tiles. */
+        if (tp->kind != RAD_PLANE_TABLE || tp->dtype != RAD_I8 || tp->extent[1] != 1 || L <= b ||
+            L > (mp ? 16 : 14) || lrun < 4 || lrb < 0 || lrb > lrun)
+            return false;
+        f->kind = mp ? kTrellisMad : kTrellis; f->bits = (uint32_t)b; f->L = (uint32_t)L; f->lrun = (uint32_t)lrun;
+        f->lrb = (uint32_t)lrb; f->scale = sc;
+        *entries = tp->extent[0];
+        return span(*f) <= 16;
+    }
+    if (!rad_enc_is(enc, "affine")) return false;
+    uint32_t sc = 0;
+    if (cp.block[0] != 1) return false;
+    /* A vector grid: one code a V-vector (V 2 or 4: a lane's four columns hold whole vectors), an i8
+     * table of V-vectors. */
+    if (cp.block[1] > 1) {
+        const RadEncPlane* gr = rad_enc_plane(enc, "grid");
+        const int b = unsigned_bits(cp.dtype) ? unsigned_bits(cp.dtype)
+                    : cp.dtype == RAD_U9 ? 9 : cp.dtype == RAD_U10 ? 10 : cp.dtype == RAD_U11 ? 11
+                    : cp.dtype == RAD_U12 ? 12 : 0;
+        const int lv = log2_exact(cp.block[1]);
+        if (!gr || !b || lv < 1 || lv > 2 || !scale_form(enc, 3, &sc) || sc != kBf16 ||
+            gr->kind != RAD_PLANE_TABLE || gr->dtype != RAD_I8 || gr->extent[1] != cp.block[1] ||
+            gr->extent[0] < 1 || gr->extent[0] > ((int64_t)1 << b) ||
+            ((int64_t)1 << b) * cp.block[1] > 16384)
+            return false;
+        f->kind = kGrid; f->bits = (uint32_t)b; f->lv = (uint32_t)lv; f->scale = kBf16;
+        *entries = gr->extent[0];
+        return true;
+    }
+    if (const int b = signed_bits(cp.dtype)) {
+        if (!scale_form(enc, 2, &sc) || sc != kBf16) return false;
+        f->kind = kSigned; f->bits = (uint32_t)b;
+        return true;
+    }
+    const int b = unsigned_bits(cp.dtype);
+    /* eight bits only under a zero: the embedding's u8 table (no GEMM form takes it) */
+    if (!b || b > 8 || (b == 8 && !rad_enc_plane(enc, "zero"))) return false;
+    if (const RadEncPlane* zp = rad_enc_plane(enc, "zero")) {
+        if (!scale_form(enc, 3, &sc) || sc != kBf16 || !unsigned_bits(zp->dtype) ||
+            zp->block[0] != 1 || zp->block[1] != 128)
+            return false;
+        f->kind = kZero; f->bits = (uint32_t)b;
+        return true;
+    }
+    if (const RadEncPlane* tp = rad_enc_plane(enc, "table")) {
+        if (!scale_form(enc, 3, &sc) || sc != kBf16 || tp->kind != RAD_PLANE_TABLE ||
+            tp->dtype != RAD_I8 || tp->extent[0] != 1 || tp->extent[1] < 2 ||
+            tp->extent[1] > ((int64_t)1 << b))
+            return false;
+        f->kind = kTable; f->bits = (uint32_t)b;
+        *entries = tp->extent[1];
+        return true;
+    }
+    return false;
+}
+
+struct Geom { long long N, K, nkb; };
+
+/* tcq_code=mad's value of state `st`: bytesum((st * A + B) mod 2^32 & 0x3F3F3F3F) - 126, the
+ * product from the low 24 bits of each factor (libquant's grid_tcq_mad_values). */
+inline int mad_value(uint32_t st, uint32_t a, uint32_t b) {
+    const uint32_t h = ((st & 0xFFFFFFu) * (a & 0xFFFFFFu) + b) & 0x3F3F3F3Fu;
+    return (int)((h & 0xFFu) + ((h >> 8) & 0xFFu) + ((h >> 16) & 0xFFu) + (h >> 24)) - 126;
+}
+
+int geom(const RadParam* p, int n_p, Geom* g) {
+    g->N = r3di_pgeti_or(p, n_p, "N", 0);
+    g->K = r3di_pgeti_or(p, n_p, "K", 0);
+    if (g->N <= 0 || g->K <= 0) return RAD_E_SHAPE;
+    if (r3di_pgeti_or(p, n_p, "group", 128) != 128) return RAD_E_SHAPE;
+    if (g->N % 16 || g->K % 128) return RAD_E_SHAPE;
+    g->nkb = g->K / 128;
+    return RAD_OK;
+}
+
+void lfill(RadLayout* out, const char* tag, uint32_t dt, long long d0, long long d1,
+           long long bytes) {
+    std::memset(out, 0, sizeof(*out));
+    out->tag = tag;
+    out->dtype = dt;
+    out->rank = 2;
+    out->shape[0] = d0;
+    out->shape[1] = d1;
+    out->align = 256;
+    out->bytes = bytes;
+}
+
+/* The selected planes by role. */
+struct Planes {
+    const RadTensor *codes = nullptr, *aux = nullptr, *scale = nullptr, *scale2 = nullptr,
+                    *mad = nullptr, *colf = nullptr;
+};
+bool planes_of(const RadEncoding* enc, const int* sel, const RadTensor* pl, int n, Planes* o) {
+    if (!sel || !pl) return false;
+    for (int i = 0; i < n; ++i) {
+        const char* r = r3di_enc::role(enc, sel, i);
+        if (!std::strncmp(r, "codes", RAD_ENC_STR)) o->codes = &pl[i];
+        else if (!std::strncmp(r, "scale", RAD_ENC_STR)) o->scale = &pl[i];
+        else if (!std::strncmp(r, "scale.1", RAD_ENC_STR)) o->scale2 = &pl[i];
+        else if (!std::strncmp(r, "trellis.mad", RAD_ENC_STR)) o->mad = &pl[i];
+        else if (!std::strncmp(r, "scale.col", RAD_ENC_STR)) o->colf = &pl[i];
+        else if (!std::strncmp(r, "zero", RAD_ENC_STR) || !std::strncmp(r, "table", RAD_ENC_STR) ||
+                 !std::strncmp(r, "grid", RAD_ENC_STR) || !std::strncmp(r, "trellis", RAD_ENC_STR))
+            o->aux = &pl[i];
+        else return false;
+    }
+    return true;
+}
+
+/* The weight's form and planes, checked against its geometry. */
+int weight_view(const RadParam* p, int n_p, const RadEncoding* enc, const int* sel,
+                const RadTensor* pl, int n, Geom* g, Form* f, int64_t* entries, Planes* v) {
+    int rc = geom(p, n_p, g);
+    if (rc != RAD_OK) return rc;
+    const char* d = r3di_pgets(p, n_p, "dtype");
+    const bool rot = d && std::strcmp(d, "i8a8h") == 0;
+    if (!classify(enc, rot ? "fwht128" : "", f, entries) || !built(word(*f))) return RAD_E_DTYPE;
+    if (!planes_of(enc, sel, pl, n, v) || !v->codes) return RAD_E_SHAPE;
+    const bool aux = f->kind != kSigned;
+    if (aux != (v->aux != nullptr) || (f->kind == kTrellisMad) != (v->mad != nullptr))
+        return RAD_E_SHAPE;
+    const long long kc = f->kind == kGrid ? g->K >> f->lv : g->K;
+    if (!r3di_enc::dims(*v->codes, g->N, kc)) return RAD_E_SHAPE;
+    if (is_trellis(f->kind) && g->N % ((long long)1 << f->lrun)) return RAD_E_SHAPE;
+    if (f->kind == kZero && !r3di_enc::dims(*v->aux, g->N, g->nkb)) return RAD_E_SHAPE;
+    return RAD_OK;
+}
+
+/* ---- bits ----------------------------------------------------------------------------------- */
+
+/* `n` <= 57 bits of a plane row from bit `o`. */
+inline uint64_t get_bits(const uint8_t* row, long long o, int n) {
+    const uint8_t* b = row + (o >> 3);
+    const int sh = (int)(o & 7);
+    const int bytes = (sh + n + 7) >> 3;
+    uint64_t w = 0;
+    for (int i = 0; i < bytes; ++i) w |= (uint64_t)b[i] << (8 * i);
+    return (w >> sh) & (n == 64 ? ~0ull : ((1ull << n) - 1ull));
+}
+/* OR `n` <= 57 bits into a zeroed buffer at bit `o`. */
+inline void put_bits(uint8_t* dst, long long o, uint64_t v, int n) {
+    uint8_t* b = dst + (o >> 3);
+    const int sh = (int)(o & 7);
+    const int bytes = (sh + n + 7) >> 3;
+    v <<= sh;
+    for (int i = 0; i < bytes; ++i) b[i] |= (uint8_t)(v >> (8 * i));
+}
+
+using r3di_par::par_for;
+
+/* 16-row tiles a relayout thread takes: about 16 MiB of codes. */
+long long tiles_a_thread(const Form& f, long long K) {
+    return std::max(1ll, ((long long)16 << 20) / std::max(1ll, (long long)(K / 128) * unit_bytes(f)));
+}
+
+/* Bits [o, o + n) of a plane row, n <= 32, read with one unaligned 8-byte load (fewer bytes where
+ * the plane ends within 8 bytes, at `end`). */
+inline uint32_t peek_bits(const uint8_t* row, long long o, int n, const uint8_t* end) {
+    const uint8_t* b = row + (o >> 3);
+    uint64_t w = 0;
+    if (end - b >= 8) std::memcpy(&w, b, 8);
+    else std::memcpy(&w, b, (size_t)(end - b));
+    return (uint32_t)((w >> (o & 7)) & ((1ull << n) - 1ull));
+}
+
+/* Appends fields of up to 32 bits to a byte-aligned stream, a dword at a time. */
+struct BitOut {
+    uint8_t* p;
+    uint64_t acc = 0;
+    int      n = 0;   /* bits held, below 32 between puts */
+    explicit BitOut(uint8_t* at) : p(at) {}
+    void put(uint64_t v, int w) {
+        acc |= v << n;
+        n += w;
+        if (n >= 32) {
+            const uint32_t x = (uint32_t)acc;
+            std::memcpy(p, &x, 4);
+            p += 4;
+            acc >>= 32;
+            n -= 32;
+        }
+    }
+    /* The held bits, a whole number of bytes at a segment's end. */
+    void done() {
+        for (; n > 0; n -= 8, acc >>= 8) *p++ = (uint8_t)acc;
+    }
+};
+
+/* Visits each code of the weight with its row-major position (row r, code column c in the codes
+ * plane) and its bit in the stored codes plane: the one definition of r3di_iqr.h's order, walked
+ * forwards by the relayout and backwards by the unrelayout. `per_tile(rt, visit)` gives a worker a
+ * whole 16-row tile so it can read its rows once. */
+template <typename V>
+void walk_tile(const Form& f, long long K, long long rt, V visit) {
+    const long long nkb = K / 128;
+    const long long ub = unit_bytes(f) * 8;
+    const int B = (int)f.bits;
+    for (long long kb = 0; kb < nkb; ++kb) {
+        const long long u0 = (rt * nkb + kb) * ub;
+        for (int lane = 0; lane < 32; ++lane) {
+            const long long l0 = u0 + (long long)lane * lane_bits(f), k0 = kb * 128 + 4 * lane;
+            if (is_trellis(f.kind)) {
+                for (int e = 0; e < 4; ++e)
+                    for (int q = 0; q < 16; ++q)
+                        visit(rt * 16 + 15 - q, k0 + e, l0 + (e * 16 + q) * B);
+                continue;
+            }
+            const int per = f.kind == kGrid ? 4 >> f.lv : 4;   /* codes a row */
+            for (int r = 0; r < 16; ++r)
+                for (int e = 0; e < per; ++e)
+                    visit(rt * 16 + r, f.kind == kGrid ? (k0 >> f.lv) + e : k0 + e,
+                          l0 + (r * per + e) * B);
+        }
+    }
+}
+
+/* The value a decoded code stands for, or a code no entry answers (-1000). */
+int scalar_value(const Form& f, const Planes& v, int64_t entries, long long r, long long c,
+                 uint32_t code) {
+    if (f.kind == kSigned) return (int)(code << (32 - f.bits)) >> (32 - f.bits);
+    if (f.kind == kTable)
+        return (int64_t)code < entries ? ((const int8_t*)v.aux->data)[code] : -1000;
+    if (f.kind == kZero) {
+        const int zb = unsigned_bits(v.aux->dtype);
+        return (int)code - (int)rad_load_bits(r3di_enc::row(*v.aux, r), zb, c / 128);
+    }
+    return 0;
+}
+
+/* The codes in r3di_iqr.h's lane segments. A trellis tile goes to r3di_hsimd::iqr_trellis_tile;
+ * for the other forms, a segment at a time, each of the tile's 16 rows gives a lane its codes
+ * 4l .. 4l + 3 (4/V for a grid) as one field read with a single load, and the segment is written
+ * as a stream of dwords. walk_tile's order, which the unrelayout walks, element
+ * for element: relayout_iqr_test holds the two to each other on every form. A code the form cannot
+ * read (no entry answers it, or its value is outside -127..127) refuses the weight. */
+int weight_relayout(const Form& f, const Geom& g, int64_t entries, const Planes& v, uint8_t* d,
+                    int64_t bytes) {
+    if (bytes != weight_bytes(f, g.N, g.K) || !v.codes->data) return RAD_E_SHAPE;
+    /* The segments cover the codes area whole; only what follows it is cleared. */
+    const int64_t cb = codes_bytes(f, g.N, g.K);
+    std::memset(d + cb, 0, (size_t)(bytes - cb));
+    std::atomic<int> bad{ RAD_OK };
+    const int B = (int)f.bits;
+    const bool tr = is_trellis(f.kind);
+    const int per = f.kind == kGrid ? 4 >> f.lv : 4;   /* codes a row gives a lane */
+    const int w = per * B;
+    const uint32_t m = (1u << B) - 1u;
+    const long long rb = rad_dtype_bytes(v.codes->dtype, v.codes->shape[1]);
+    const uint8_t* c0p = (const uint8_t*)v.codes->data;
+    const uint8_t* end = c0p + rb * g.N;
+    const long long ub = unit_bytes(f), lb = lane_bits(f) / 8;
+    /* Which codes refuse, for the forms whose check is the code alone. */
+    std::vector<uint8_t> refuse;
+    if (f.kind == kSigned || f.kind == kTable || f.kind == kGrid) {
+        refuse.assign((size_t)1 << B, 0);
+        for (uint32_t c = 0; c <= m; ++c) {
+            const int val = f.kind == kGrid ? 0 : scalar_value(f, v, entries, 0, 0, c);
+            refuse[c] = f.kind == kGrid ? (int64_t)c >= entries : (val < -127 || val > 127);
+        }
+    }
+    const int zb = f.kind == kZero ? unsigned_bits(v.aux->dtype) : 0;
+    par_for(g.N / 16, tiles_a_thread(f, g.K), [&](long long lo, long long hi) {
+        uint32_t ch[16];
+        int zero[16];
+        for (long long rt = lo; rt < hi; ++rt) {
+            const uint8_t* rows = c0p + rt * 16 * rb;
+            /* A trellis tile is a transpose of its codes, done a unit at a time in vector
+             * registers (r3di_hsimd.h). */
+            if (tr) {
+                r3di_hsimd::iqr_trellis_tile(rows, rb, B, g.nkb, d + rt * g.nkb * ub);
+                continue;
+            }
+            for (long long kb = 0; kb < g.nkb; ++kb) {
+                uint8_t* u = d + (rt * g.nkb + kb) * ub;
+                if (f.kind == kZero)
+                    for (int r = 0; r < 16; ++r)
+                        zero[r] = (int)rad_load_bits(r3di_enc::row(*v.aux, rt * 16 + r), zb, kb);
+                for (int lane = 0; lane < 32; ++lane) {
+                    const long long c = f.kind == kGrid ? (kb * 128 + 4 * lane) >> f.lv : kb * 128 + 4 * lane;
+                    for (int r = 0; r < 16; ++r) ch[r] = peek_bits(rows + r * rb, c * B, w, end);
+                    BitOut o(u + lane * lb);
+                    {
+                        if (!refuse.empty()) {
+                            uint32_t any = 0;
+                            for (int r = 0; r < 16; ++r)
+                                for (int e = 0; e < per; ++e) any |= refuse[(ch[r] >> (e * B)) & m];
+                            if (any) bad = RAD_E_FORMAT;
+                        } else if (f.kind == kZero) {
+                            for (int r = 0; r < 16; ++r)
+                                for (int e = 0; e < per; ++e) {
+                                    const int val = (int)((ch[r] >> (e * B)) & m) - zero[r];
+                                    if (val < -127 || val > 127) bad = RAD_E_FORMAT;
+                                }
+                        }
+                        for (int r = 0; r < 16; ++r) o.put(ch[r], w);
+                    }
+                    o.done();
+                }
+            }
+        }
+    });
+    if (bad != RAD_OK) return bad;
+    uint8_t* aux = d + aux_off(f, g.N, g.K);
+    if (f.kind == kTable || f.kind == kGrid || is_trellis(f.kind)) {
+        const long long n = f.kind == kTable ? entries
+                          : f.kind == kGrid ? entries << f.lv : entries;
+        const int8_t* t = (const int8_t*)v.aux->data;
+        for (long long i = 0; i < n; ++i)
+            if (t[i] < -127 && f.kind != kTable) return RAD_E_FORMAT;
+        if (f.kind == kTrellisMad) {
+            /* The kernels compute the values from A and B, which is all the layout keeps: the
+             * stored table must be that code. */
+            if (!v.mad || !v.mad->data) return RAD_E_SHAPE;
+            const uint32_t a = ((const uint32_t*)v.mad->data)[0], b = ((const uint32_t*)v.mad->data)[1];
+            for (long long st = 0; st < n; ++st)
+                if (mad_value((uint32_t)st, a, b) != t[st]) return RAD_E_FORMAT;
+            std::memcpy(aux, v.mad->data, 8);
+        } else {
+            std::memcpy(aux, t, (size_t)n);
+        }
+    } else if (f.kind == kZero) {
+        const int zb = unsigned_bits(v.aux->dtype);
+        for (long long r = 0; r < g.N; ++r)
+            for (long long kb = 0; kb < g.nkb; ++kb)
+                aux[tile_major(r, kb, g.nkb)] = (uint8_t)rad_load_bits(r3di_enc::row(*v.aux, r), zb, kb);
+    }
+    return RAD_OK;
+}
+
+int weight_unrelayout(const Form& f, const Geom& g, int64_t entries, const Planes& v,
+                      const uint8_t* s, int64_t bytes) {
+    if (bytes != weight_bytes(f, g.N, g.K) || !v.codes->data) return RAD_E_SHAPE;
+    const int B = (int)f.bits;
+    const long long rb = rad_dtype_bytes(v.codes->dtype, v.codes->shape[1]);
+    std::memset(v.codes->data, 0, (size_t)(rb * g.N));
+    par_for(g.N / 16, tiles_a_thread(f, g.K), [&](long long lo, long long hi) {
+        for (long long rt = lo; rt < hi; ++rt)
+            walk_tile(f, g.K, rt, [&](long long r, long long c, long long bit) {
+                put_bits((uint8_t*)v.codes->data + r * rb, c * B, get_bits(s, bit, B), B);
+            });
+    });
+    const uint8_t* aux = s + aux_off(f, g.N, g.K);
+    if (f.kind == kTable || f.kind == kGrid || is_trellis(f.kind)) {
+        const long long n = f.kind == kGrid ? entries << f.lv : entries;
+        if (f.kind == kTrellisMad) {
+            /* The table back from the constants the layout kept. */
+            uint32_t ab[2];
+            std::memcpy(ab, aux, 8);
+            for (long long st = 0; st < n; ++st)
+                ((int8_t*)v.aux->data)[st] = (int8_t)mad_value((uint32_t)st, ab[0], ab[1]);
+            if (v.mad && v.mad->data) std::memcpy(v.mad->data, aux, 8);
+        } else {
+            std::memcpy(v.aux->data, aux, (size_t)n);
+        }
+    } else if (f.kind == kZero) {
+        const int zb = unsigned_bits(v.aux->dtype);
+        const long long zr = rad_dtype_bytes(v.aux->dtype, v.aux->shape[1]);
+        std::memset(v.aux->data, 0, (size_t)(zr * g.N));
+        for (long long r = 0; r < g.N; ++r)
+            for (long long kb = 0; kb < g.nkb; ++kb)
+                rad_store_bits((uint8_t*)v.aux->data + r * zr, zb, kb, aux[tile_major(r, kb, g.nkb)]);
+    }
+    return RAD_OK;
+}
+
+/* ---- scales --------------------------------------------------------------------------------- */
+
+/* The bf16 bits of a row's scale for block kb: the plane's own, or the E4M3 times its second level
+ * rounded to nearest even (libquant's grid_tcq_settle). */
+uint16_t own_scale(const Form& f, const Planes& v, long long r, long long kb) {
+    if (f.scale == kBf16) return ((const uint16_t*)r3di_enc::row(*v.scale, r))[kb];
+    const uint8_t e = r3di_enc::row(*v.scale, r)[kb];
+    const float s2 = rad_load_f32(v.scale2->data, v.scale2->dtype, f.scale == kE4m3Row ? r : 0);
+    const float x = s2 * rad_fp8e4m3_to_f32(e);
+    uint32_t u;
+    std::memcpy(&u, &x, 4);
+    u += 0x7FFFu + ((u >> 16) & 1u);
+    return (uint16_t)(u >> 16);
+}
+
+int scale_view(const RadParam* p, int n_p, const RadEncoding* enc, const int* sel,
+               const RadTensor* pl, int n, Geom* g, Form* f, Planes* v) {
+    int rc = geom(p, n_p, g);
+    if (rc != RAD_OK) return rc;
+    const char* d = r3di_pgets(p, n_p, "dtype");
+    const bool rot = d && std::strcmp(d, "i8a8h") == 0;
+    int64_t entries = 0;
+    if (!classify(enc, rot ? "fwht128" : "", f, &entries) || !built(word(*f))) return RAD_E_DTYPE;
+    if (!planes_of(enc, sel, pl, n, v) || !v->scale || v->codes || v->aux) return RAD_E_SHAPE;
+    if (f->scale == kRowF32) {
+        if (v->scale2 || !r3di_enc::dims(*v->scale, g->N, 1)) return RAD_E_SHAPE;
+        if (v->colf && !r3di_enc::dims(*v->colf, 1, g->nkb)) return RAD_E_SHAPE;
+        if ((rad_enc_plane(enc, "scale.col") != nullptr) != (v->colf != nullptr)) return RAD_E_SHAPE;
+        return RAD_OK;
+    }
+    if ((f->scale != kBf16) != (v->scale2 != nullptr)) return RAD_E_SHAPE;
+    if (!r3di_enc::dims(*v->scale, g->N, g->nkb)) return RAD_E_SHAPE;
+    if (v->scale2 && (v->scale2->rank != 2 || v->scale2->shape[1] != 1 ||
+                      v->scale2->shape[0] != (f->scale == kE4m3Row ? g->N : 1)))
+        return RAD_E_SHAPE;
+    return RAD_OK;
+}
+
+int scale_relayout(const Form& f, const Geom& g, const Planes& v, uint8_t* d, int64_t bytes) {
+    if (bytes != scale_bytes(f, g.N, g.K) || !v.scale->data) return RAD_E_SHAPE;
+    std::memset(d, 0, (size_t)bytes);
+    if (f.scale == kRowF32) {
+        float* rs = (float*)d;
+        float* cf = (float*)(d + cf_off(f, g.N, g.K));
+        for (long long r = 0; r < g.N; ++r) rs[r] = *(const float*)r3di_enc::row(*v.scale, r);
+        for (long long kb = 0; kb < g.nkb; ++kb)
+            cf[kb] = v.colf ? ((const float*)v.colf->data)[kb] : 1.0f;
+        return RAD_OK;
+    }
+    for (long long r = 0; r < g.N; ++r)
+        for (long long kb = 0; kb < g.nkb; ++kb) {
+            const long long i = tile_major(r, kb, g.nkb);
+            if (f.scale == kBf16) ((uint16_t*)d)[i] = ((const uint16_t*)r3di_enc::row(*v.scale, r))[kb];
+            else d[i] = r3di_enc::row(*v.scale, r)[kb];
+        }
+    if (f.scale != kBf16) {
+        float* s2 = (float*)(d + s2_off(f, g.N, g.K));
+        const long long n2 = f.scale == kE4m3Row ? g.N : 1;
+        for (long long r = 0; r < n2; ++r) s2[r] = rad_load_f32(v.scale2->data, v.scale2->dtype, r);
+    }
+    if (f.lrb) {
+        /* Scales are positive, so their bf16 bits order as the values do. */
+        uint16_t* bp = (uint16_t*)(d + blk_off(f, g.N, g.K));
+        const long long rb = 1ll << f.lrb;
+        for (long long b = 0; b < g.N / rb; ++b)
+            for (long long kb = 0; kb < g.nkb; ++kb) {
+                uint16_t m = 0;
+                for (long long r = b * rb; r < b * rb + rb; ++r) m = std::max(m, own_scale(f, v, r, kb));
+                bp[b * g.nkb + kb] = m;
+            }
+    }
+    return RAD_OK;
+}
+
+int scale_unrelayout(const Form& f, const Geom& g, const Planes& v, const uint8_t* s,
+                     int64_t bytes) {
+    if (bytes != scale_bytes(f, g.N, g.K) || !v.scale->data) return RAD_E_SHAPE;
+    if (f.scale == kRowF32) {
+        const float* rs = (const float*)s;
+        const float* cf = (const float*)(s + cf_off(f, g.N, g.K));
+        for (long long r = 0; r < g.N; ++r) *(float*)((uint8_t*)v.scale->data + r * 4) = rs[r];
+        if (v.colf)
+            for (long long kb = 0; kb < g.nkb; ++kb) ((float*)v.colf->data)[kb] = cf[kb];
+        return RAD_OK;
+    }
+    for (long long r = 0; r < g.N; ++r)
+        for (long long kb = 0; kb < g.nkb; ++kb) {
+            const long long i = tile_major(r, kb, g.nkb);
+            uint8_t* row = (uint8_t*)v.scale->data + r * rad_dtype_bytes(v.scale->dtype, g.nkb);
+            if (f.scale == kBf16) ((uint16_t*)row)[kb] = ((const uint16_t*)s)[i];
+            else row[kb] = s[i];
+        }
+    /* The second level is f32 here and may be bf16 in the container; a bf16 one round-trips
+     * through f32 exactly. */
+    if (f.scale != kBf16) {
+        const float* s2 = (const float*)(s + s2_off(f, g.N, g.K));
+        const long long n2 = f.scale == kE4m3Row ? g.N : 1;
+        for (long long r = 0; r < n2; ++r) {
+            if (v.scale2->dtype == RAD_F32) {
+                ((float*)v.scale2->data)[r] = s2[r];
+            } else {
+                uint32_t u;
+                std::memcpy(&u, &s2[r], 4);
+                ((uint16_t*)v.scale2->data)[r] = (uint16_t)(u >> 16);
+            }
+        }
+    }
+    return RAD_OK;
+}
+
+}  /* namespace */
+
+/* ==================================================================== the hooks */
+
+extern "C" int r3di_rad_layout_iqr(const RadParam* p, int n_p, int operand, const RadEncoding* enc,
+                                  const int* sel, const RadTensor* pl, int n, RadLayout* out) {
+    if (!out) return RAD_E_INVAL;
+    Geom g;
+    Form f;
+    Planes v;
+    if (operand == IL_B) {
+        int64_t entries = 0;
+        const int rc = weight_view(p, n_p, enc, sel, pl, n, &g, &f, &entries, &v);
+        if (rc != RAD_OK) return rc;
+        lfill(out, "r3di.iqr.w", R3DI_DT_IQR_W | word(f), g.N, g.K, weight_bytes(f, g.N, g.K));
+        return RAD_OK;
+    }
+    if (operand == IL_BSCALE) {
+        const int rc = scale_view(p, n_p, enc, sel, pl, n, &g, &f, &v);
+        if (rc != RAD_OK) return rc;
+        lfill(out, "r3di.iqr.s", R3DI_DT_IQR_S | word(f), g.N, g.nkb, scale_bytes(f, g.N, g.K));
+        return RAD_OK;
+    }
+    return RAD_E_UNSUPPORTED;
+}
+
+extern "C" int r3di_rad_relayout_iqr(const RadParam* p, int n_p, int operand,
+                                    const RadEncoding* enc, const int* sel, const RadTensor* pl,
+                                    int n, void* dst, int64_t dst_bytes) {
+    Geom g;
+    Form f;
+    Planes v;
+    if (operand == IL_B) {
+        int64_t entries = 0;
+        const int rc = weight_view(p, n_p, enc, sel, pl, n, &g, &f, &entries, &v);
+        if (rc != RAD_OK) return rc;
+        if (v.aux && !v.aux->data) return RAD_E_SHAPE;
+        return weight_relayout(f, g, entries, v, (uint8_t*)dst, dst_bytes);
+    }
+    if (operand == IL_BSCALE) {
+        const int rc = scale_view(p, n_p, enc, sel, pl, n, &g, &f, &v);
+        if (rc != RAD_OK) return rc;
+        if (v.scale2 && !v.scale2->data) return RAD_E_SHAPE;
+        return scale_relayout(f, g, v, (uint8_t*)dst, dst_bytes);
+    }
+    return RAD_E_UNSUPPORTED;
+}
+
+extern "C" int r3di_rad_unrelayout_iqr(const RadParam* p, int n_p, int operand,
+                                      const RadEncoding* enc, const int* sel, const void* src,
+                                      int64_t src_bytes, const RadTensor* pl, int n) {
+    Geom g;
+    Form f;
+    Planes v;
+    if (operand == IL_B) {
+        int64_t entries = 0;
+        const int rc = weight_view(p, n_p, enc, sel, pl, n, &g, &f, &entries, &v);
+        if (rc != RAD_OK) return rc;
+        if (v.aux && !v.aux->data) return RAD_E_SHAPE;
+        return weight_unrelayout(f, g, entries, v, (const uint8_t*)src, src_bytes);
+    }
+    if (operand == IL_BSCALE) {
+        const int rc = scale_view(p, n_p, enc, sel, pl, n, &g, &f, &v);
+        if (rc != RAD_OK) return rc;
+        if (v.scale2 && !v.scale2->data) return RAD_E_SHAPE;
+        return scale_unrelayout(f, g, v, (const uint8_t*)src, src_bytes);
+    }
+    return RAD_E_UNSUPPORTED;
+}
+
+/* ==================================================================== embed_lookup's table
+ *
+ * The rows as the container stores them (r3di_iqr.h's embed_off): only the gather's handful of rows
+ * a step are decoded, so nothing is reordered, and nothing is widened. A plain bf16 table is the
+ * bf16 gather's. */
+namespace {
+enum { EL_WTE = 1 };
+
+int embed_view(const RadParam* p, int n_p, int operand, const RadEncoding* enc, const int* sel,
+               const RadTensor* pl, int n, Form* f, int64_t* entries, Planes* v, long long* rows,
+               long long* dim) {
+    if (operand != EL_WTE) return RAD_E_UNSUPPORTED;
+    *rows = r3di_pgeti_or(p, n_p, "n_vocab", 0);
+    *dim = r3di_pgeti_or(p, n_p, "n_embd", 0);
+    if (*rows <= 0 || *dim <= 0 || *dim % 128) return RAD_E_SHAPE;
+    if (rad_enc_is(enc, "plain")) return RAD_E_DTYPE;
+    const bool rot = !std::strncmp(enc->transform, "fwht128", RAD_ENC_STR);
+    if (!classify(enc, rot ? "fwht128" : "", f, entries)) return RAD_E_DTYPE;
+    f->rot = rot ? 1u : 0u;
+    if (!embed_built(word(*f))) return RAD_E_DTYPE;
+    if (!planes_of(enc, sel, pl, n, v) || !v->codes || !v->scale) return RAD_E_SHAPE;
+    if ((f->kind != kSigned) != (v->aux != nullptr)) return RAD_E_SHAPE;
+    if ((f->scale != kBf16) != (v->scale2 != nullptr)) return RAD_E_SHAPE;
+    const long long nkb = *dim / 128;
+    if (!r3di_enc::dims(*v->codes, *rows, code_cols(*f, *dim)) ||
+        !r3di_enc::dims(*v->scale, *rows, nkb))
+        return RAD_E_SHAPE;
+    if (f->kind == kTrellis && *rows % (1ll << f->lrun)) return RAD_E_SHAPE;
+    if (f->kind == kZero && !r3di_enc::dims(*v->aux, *rows, nkb)) return RAD_E_SHAPE;
+    return RAD_OK;
+}
+}  /* namespace */
+
+extern "C" int r3di_rad_layout_iqr_embed(const RadParam* p, int n_p, int operand,
+                                        const RadEncoding* enc, const int* sel, const RadTensor* pl,
+                                        int n, RadLayout* out) {
+    if (!out) return RAD_E_INVAL;
+    Form f;
+    int64_t entries = 0;
+    Planes v;
+    long long rows = 0, dim = 0;
+    const int rc = embed_view(p, n_p, operand, enc, sel, pl, n, &f, &entries, &v, &rows, &dim);
+    if (rc != RAD_OK) return rc;
+    lfill(out, "r3di.iqr.embed", R3DI_DT_IQR_W | word(f), rows, dim, embed_off(f, rows, dim).bytes);
+    return RAD_OK;
+}
+
+extern "C" int r3di_rad_relayout_iqr_embed(const RadParam* p, int n_p, int operand,
+                                          const RadEncoding* enc, const int* sel,
+                                          const RadTensor* pl, int n, void* dst,
+                                          int64_t dst_bytes) {
+    Form f;
+    int64_t entries = 0;
+    Planes v;
+    long long rows = 0, dim = 0;
+    const int rc = embed_view(p, n_p, operand, enc, sel, pl, n, &f, &entries, &v, &rows, &dim);
+    if (rc != RAD_OK) return rc;
+    const EmbedOff o = embed_off(f, rows, dim);
+    if (dst_bytes != o.bytes || !v.codes->data || !v.scale->data || (v.aux && !v.aux->data) ||
+        (v.scale2 && !v.scale2->data))
+        return RAD_E_SHAPE;
+    uint8_t* d = (uint8_t*)dst;
+    const long long nkb = dim / 128, crow = rad_dtype_bytes(v.codes->dtype, v.codes->shape[1]);
+    if (crow != o.codes_row) return RAD_E_SHAPE;
+    /* The codes are copied whole; only what follows them is cleared first. */
+    std::memcpy(d, v.codes->data, (size_t)(rows * crow));
+    if (dst_bytes > rows * crow) std::memset(d + rows * crow, 0, (size_t)(dst_bytes - rows * crow));
+    uint8_t* aux = d + o.aux;
+    if (f.kind == kTable || f.kind == kGrid || f.kind == kTrellis) {
+        const long long na = f.kind == kGrid ? entries << f.lv : entries;
+        const int8_t* t = (const int8_t*)v.aux->data;
+        for (long long i = 0; i < na; ++i)
+            if (t[i] < -127) return RAD_E_FORMAT;
+        std::memcpy(aux, t, (size_t)na);
+    } else if (f.kind == kZero) {
+        const int zb = unsigned_bits(v.aux->dtype);
+        for (long long r = 0; r < rows; ++r)
+            for (long long kb = 0; kb < nkb; ++kb)
+                aux[r * nkb + kb] = (uint8_t)rad_load_bits(r3di_enc::row(*v.aux, r), zb, kb);
+    }
+    const long long sb = f.scale == kBf16 ? 2 : 1;
+    for (long long r = 0; r < rows; ++r)
+        std::memcpy(d + o.sc + r * nkb * sb, r3di_enc::row(*v.scale, r), (size_t)(nkb * sb));
+    if (f.scale != kBf16) {
+        float* s2 = (float*)(d + o.s2);
+        for (long long r = 0; r < (f.scale == kE4m3Row ? rows : 1); ++r)
+            s2[r] = rad_load_f32(v.scale2->data, v.scale2->dtype, r);
+    }
+    if (f.lrb) {
+        uint16_t* bp = (uint16_t*)(d + o.blk);
+        const long long rb = 1ll << f.lrb;
+        for (long long b = 0; b < rows / rb; ++b)
+            for (long long kb = 0; kb < nkb; ++kb) {
+                uint16_t m = 0;
+                for (long long r = b * rb; r < b * rb + rb; ++r) m = std::max(m, own_scale(f, v, r, kb));
+                bp[b * nkb + kb] = m;
+            }
+    }
+    return RAD_OK;
+}
+
+/* ==================================================================== logits_gemm's head
+ *
+ * The rows of r3di_iqr.h's lm form: the container's packed codes and the row's scales, the table
+ * after the last row. A reorder of the stored bytes, so it inverts. */
+namespace {
+enum { LG_W = 1 };
+
+int lm_view(const RadParam* p, int n_p, int operand, const RadEncoding* enc, const int* sel,
+            const RadTensor* pl, int n, Form* f, int64_t* entries, Planes* v, long long* rows,
+            long long* dim) {
+    if (operand != LG_W) return RAD_E_UNSUPPORTED;
+    *rows = r3di_pgeti_or(p, n_p, "n_vocab", 0);
+    *dim = r3di_pgeti_or(p, n_p, "n_embd", 0);
+    if (*rows <= 0 || *dim <= 0 || *dim % 128) return RAD_E_SHAPE;
+    if (!classify(enc, "", f, entries) || !lm_built(word(*f))) return RAD_E_DTYPE;
+    if (!planes_of(enc, sel, pl, n, v) || !v->codes || !v->scale || !v->aux) return RAD_E_SHAPE;
+    if (!r3di_enc::dims(*v->codes, *rows, *dim) || !r3di_enc::dims(*v->scale, *rows, *dim / 128))
+        return RAD_E_SHAPE;
+    return RAD_OK;
+}
+}  /* namespace */
+
+extern "C" int r3di_rad_layout_iqr_logits(const RadParam* p, int n_p, int operand,
+                                         const RadEncoding* enc, const int* sel,
+                                         const RadTensor* pl, int n, RadLayout* out) {
+    if (!out) return RAD_E_INVAL;
+    Form f;
+    int64_t entries = 0;
+    Planes v;
+    long long rows = 0, dim = 0;
+    const int rc = lm_view(p, n_p, operand, enc, sel, pl, n, &f, &entries, &v, &rows, &dim);
+    if (rc != RAD_OK) return rc;
+    lfill(out, "r3di.iqr.lm", R3DI_DT_IQR_W | word(f), rows, lm_row(f, dim), lm_bytes(f, rows, dim));
+    return RAD_OK;
+}
+
+extern "C" int r3di_rad_relayout_iqr_logits(const RadParam* p, int n_p, int operand,
+                                           const RadEncoding* enc, const int* sel,
+                                           const RadTensor* pl, int n, void* dst,
+                                           int64_t dst_bytes) {
+    Form f;
+    int64_t entries = 0;
+    Planes v;
+    long long rows = 0, dim = 0;
+    const int rc = lm_view(p, n_p, operand, enc, sel, pl, n, &f, &entries, &v, &rows, &dim);
+    if (rc != RAD_OK) return rc;
+    if (dst_bytes != lm_bytes(f, rows, dim) || !v.codes->data || !v.scale->data || !v.aux->data)
+        return RAD_E_SHAPE;
+    uint8_t* d = (uint8_t*)dst;
+    const long long stride = lm_row(f, dim), cb = dim / 8 * f.bits, nkb = dim / 128;
+    /* Each row written once: its codes, its scales, then the padding cleared; then everything
+     * past the rows, the table's area included. */
+    const long long used = cb + 2 * nkb;
+    for (long long r = 0; r < rows; ++r) {
+        uint8_t* row = d + r * stride;
+        std::memcpy(row, r3di_enc::row(*v.codes, r), (size_t)cb);
+        std::memcpy(row + cb, r3di_enc::row(*v.scale, r), (size_t)(2 * nkb));
+        if (stride > used) std::memset(row + used, 0, (size_t)(stride - used));
+    }
+    if (dst_bytes > rows * stride) std::memset(d + rows * stride, 0, (size_t)(dst_bytes - rows * stride));
+    const int8_t* t = (const int8_t*)v.aux->data;
+    for (int64_t i = 0; i < entries; ++i)
+        if (t[i] < -127) return RAD_E_FORMAT;
+    std::memcpy(d + lm_tab(f, rows, dim), t, (size_t)entries);
+    return RAD_OK;
+}
+
+extern "C" int r3di_rad_unrelayout_iqr_logits(const RadParam* p, int n_p, int operand,
+                                             const RadEncoding* enc, const int* sel,
+                                             const void* src, int64_t src_bytes,
+                                             const RadTensor* pl, int n) {
+    Form f;
+    int64_t entries = 0;
+    Planes v;
+    long long rows = 0, dim = 0;
+    const int rc = lm_view(p, n_p, operand, enc, sel, pl, n, &f, &entries, &v, &rows, &dim);
+    if (rc != RAD_OK) return rc;
+    if (src_bytes != lm_bytes(f, rows, dim) || !v.codes->data || !v.scale->data || !v.aux->data)
+        return RAD_E_SHAPE;
+    const uint8_t* s = (const uint8_t*)src;
+    const long long stride = lm_row(f, dim), cb = dim / 8 * f.bits, nkb = dim / 128;
+    for (long long r = 0; r < rows; ++r) {
+        std::memcpy((uint8_t*)v.codes->data + r * cb, s + r * stride, (size_t)cb);
+        std::memcpy((uint8_t*)v.scale->data + r * nkb * 2, s + r * stride + cb, (size_t)(2 * nkb));
+    }
+    std::memcpy(v.aux->data, s + lm_tab(f, rows, dim), (size_t)entries);
+    return RAD_OK;
+}
+
+/* ==================================================================== logits_gemm_vocab's classes
+ *
+ * Each width class of the head is a gemm_nt_q weight of its own rows (operands 1 + 3i its codes,
+ * 2 + 3i its scales), stored as that row stores it, with the class's rows (`rows<i>`) and n_embd
+ * as its geometry and the rotated forms (the classes are fwht128). A class's vocabulary ids
+ * (3 + 3i) are read as stored. */
+namespace {
+int vocab_geom(const RadParam* p, int n_p, int operand, RadParam (&q)[4], int* il) {
+    if (operand < 1 || operand > 12 || (operand - 1) % 3 == 2) return RAD_E_UNSUPPORTED;
+    static const char* kRows[] = { "rows0", "rows1", "rows2", "rows3" };
+    const int i = (operand - 1) / 3;
+    std::memset(q, 0, sizeof q);
+    q[0].key = "N";
+    q[0].kind = RAD_P_INT;
+    q[0].ival = r3di_pgeti_or(p, n_p, kRows[i], 0);
+    q[1].key = "K";
+    q[1].kind = RAD_P_INT;
+    q[1].ival = r3di_pgeti_or(p, n_p, "n_embd", 0);
+    q[2].key = "group";
+    q[2].kind = RAD_P_INT;
+    q[2].ival = 128;
+    q[3].key = "dtype";
+    q[3].kind = RAD_P_STR;
+    q[3].sval = "i8a8h";
+    *il = (operand - 1) % 3 == 0 ? IL_B : IL_BSCALE;
+    return RAD_OK;
+}
+}  /* namespace */
+
+extern "C" int r3di_rad_layout_iqr_vocab(const RadParam* p, int n_p, int operand,
+                                        const RadEncoding* enc, const int* sel, const RadTensor* pl,
+                                        int n, RadLayout* out) {
+    RadParam q[4];
+    int il = 0;
+    const int rc = vocab_geom(p, n_p, operand, q, &il);
+    if (rc != RAD_OK) return rc;
+    Form f;
+    int64_t entries = 0;
+    if (!classify(enc, "fwht128", &f, &entries) || f.kind != kTrellisMad || f.scale != kRowF32 ||
+        f.lrb != 0 || f.lrun != 8)
+        return RAD_E_DTYPE;
+    return r3di_rad_layout_iqr(q, 4, il, enc, sel, pl, n, out);
+}
+
+extern "C" int r3di_rad_relayout_iqr_vocab(const RadParam* p, int n_p, int operand,
+                                          const RadEncoding* enc, const int* sel,
+                                          const RadTensor* pl, int n, void* dst,
+                                          int64_t dst_bytes) {
+    RadParam q[4];
+    int il = 0;
+    const int rc = vocab_geom(p, n_p, operand, q, &il);
+    if (rc != RAD_OK) return rc;
+    return r3di_rad_relayout_iqr(q, 4, il, enc, sel, pl, n, dst, dst_bytes);
+}
+
+extern "C" int r3di_rad_unrelayout_iqr_vocab(const RadParam* p, int n_p, int operand,
+                                            const RadEncoding* enc, const int* sel,
+                                            const void* src, int64_t src_bytes,
+                                            const RadTensor* pl, int n) {
+    RadParam q[4];
+    int il = 0;
+    const int rc = vocab_geom(p, n_p, operand, q, &il);
+    if (rc != RAD_OK) return rc;
+    return r3di_rad_unrelayout_iqr(q, 4, il, enc, sel, src, src_bytes, pl, n);
+}
+
diff --git a/libr3diqr/r3di_keyed.h b/libr3diqr/r3di_keyed.h
new file mode 100644
--- /dev/null
+++ b/libr3diqr/r3di_keyed.h
@@ -0,0 +1,33 @@
+/* r3di_keyed.h -- device blocks a kernel keeps between launches, keyed by the buffer they serve.
+ *
+ * Several rows keep arrival counters that must be zero when a launch starts and that the launch
+ * leaves zero: one block per (stream or device, output buffer), made at the first launch and
+ * replayed by recorded passes. They cannot live in the scratch, which other ops overwrite. The
+ * blocks are keyed by the output's address, so when the core frees the memory an output lived in
+ * (an engine of a process that loads and unloads models goes away), the blocks for it are freed
+ * too (rad_plugin_freed, abi/rad_abi.h); otherwise every load would leave its blocks behind.
+ */
+#pragma once
+#include <cstddef>
+
+namespace r3di {
+
+/* Which row's blocks: rows keep blocks of different sizes and protocols for the same output, so
+ * each has its own. */
+enum class Keyed : int { SplitFp8 = 1, GdnConv, MxDecode, M2xDecode, MxGemv };
+
+/* The zeroed block of `bytes` for (row, owner, out), made on first use. `owner` is the stream for
+ * a row whose launches overlap across streams, or null for one block per device. Null when it
+ * cannot be made; the caller then runs its unfused path.
+ *
+ * The lock is not held while a block is made. Zeroing it waits for the card, and under tensor
+ * parallelism the card can be inside an all-reduce whose other half the peer rank has yet to issue;
+ * if the peer's first launch then waited on this lock, neither rank would advance. */
+unsigned* keyed_block(Keyed row, const void* owner, const void* out, size_t bytes);
+
+/* State a row keeps under keys of its own, released when the memory [lo, hi) is freed. */
+using FreedFn = void (*)(const char* lo, const char* hi);
+/* Registers `f`; returns 0, so a file can register from a static initialiser. */
+int on_freed(FreedFn f);
+
+}  // namespace r3di
diff --git a/libr3diqr/r3di_keyed.hip b/libr3diqr/r3di_keyed.hip
new file mode 100644
--- /dev/null
+++ b/libr3diqr/r3di_keyed.hip
@@ -0,0 +1,91 @@
+/* r3di_keyed.hip -- device blocks keyed by the buffer they serve (r3di_keyed.h), and the release
+ * the core calls when it frees memory (rad_plugin_freed). */
+#include "r3di_keyed.h"
+
+#include <hip/hip_runtime.h>
+
+#include <cstdint>
+#include <map>
+#include <mutex>
+#include <tuple>
+#include <vector>
+
+namespace r3di {
+
+namespace {
+
+struct Block { unsigned* p; int dev; };
+using Key = std::tuple<int, int, const void*, const char*>;   /* row, device, owner, out */
+
+std::mutex& mu() { static std::mutex m; return m; }
+std::map<Key, Block>& blocks() { static std::map<Key, Block> b; return b; }
+std::vector<FreedFn>& freed_fns() { static std::vector<FreedFn> v; return v; }
+
+}  // namespace
+
+unsigned* keyed_block(Keyed row, const void* owner, const void* out, size_t bytes) {
+    int dev = 0;
+    if (hipGetDevice(&dev) != hipSuccess) return nullptr;
+    const Key key{ (int)row, dev, owner, static_cast<const char*>(out) };
+    {
+        std::lock_guard<std::mutex> lk(mu());
+        if (auto it = blocks().find(key); it != blocks().end()) return it->second.p;
+    }
+    void* p = nullptr;
+    if (hipMalloc(&p, bytes) != hipSuccess) return nullptr;
+    /* Zero before any launch reads it. In the engine hipMemset is the AQL backend's and has
+     * finished when it returns (core/device/aql.cpp); under HIP's own runtime (r3di_selftest) it
+     * runs on the null stream, which a non-blocking stream does not wait for, so wait here. */
+    if (hipMemset(p, 0, bytes) != hipSuccess || hipDeviceSynchronize() != hipSuccess) {
+        (void)hipFree(p);
+        return nullptr;
+    }
+    unsigned* kept = nullptr;
+    {
+        std::lock_guard<std::mutex> lk(mu());
+        const auto [it, fresh] = blocks().emplace(key, Block{ (unsigned*)p, dev });
+        if (fresh) return it->second.p;
+        kept = it->second.p;
+    }
+    (void)hipFree(p);   /* another thread made this key's block in the meantime */
+    return kept;
+}
+
+int on_freed(FreedFn f) {
+    std::lock_guard<std::mutex> lk(mu());
+    freed_fns().push_back(f);
+    return 0;
+}
+
+}  // namespace r3di
+
+/* The memory [base, base + bytes) is free and nothing launched against it runs any more: every
+ * block kept for an output inside it goes. */
+extern "C" void rad_plugin_freed(const void* base, int64_t bytes) {
+    using namespace r3di;
+    const char* lo = static_cast<const char*>(base);
+    const char* hi = lo + bytes;
+    std::vector<Block> gone;
+    std::vector<FreedFn> fns;
+    {
+        std::lock_guard<std::mutex> lk(mu());
+        for (auto it = blocks().begin(); it != blocks().end();) {
+            const char* out = std::get<3>(it->first);
+            if (out >= lo && out < hi) {
+                gone.push_back(it->second);
+                it = blocks().erase(it);
+            } else {
+                ++it;
+            }
+        }
+        fns = freed_fns();
+    }
+    int was = 0;
+    (void)hipGetDevice(&was);
+    for (const Block& b : gone) {
+        (void)hipSetDevice(b.dev);
+        (void)hipFree(b.p);
+    }
+    (void)hipSetDevice(was);
+    for (FreedFn f : fns) f(lo, hi);
+}
diff --git a/libr3diqr/r3di_narrow.h b/libr3diqr/r3di_narrow.h
new file mode 100644
--- /dev/null
+++ b/libr3diqr/r3di_narrow.h
@@ -0,0 +1,56 @@
+// RDNA3 form of RDNA4 IQR's narrow tile: decode a 16x128 weight unit into
+// per-wave LDS, reuse it across sixteen activation rows, fold per K128 scale.
+// gfx11's inputs replicate all sixteen K bytes; D holds interleaved weight rows.
+template<class F,bool GATED=false>
+__global__ __launch_bounds__(GATED?256:128) void iqr_narrow(Ctx c,const int8_t* x,const float* xs,
+    uint16_t* y,uint32_t M,uint32_t N,uint32_t xld,uint32_t sld,uint32_t yld,GatedOut go){
+    using D=Dec<F>;
+    const uint32_t tid=threadIdx.x,lane=tid&31,wave0=tid>>5,r=lane&15,h=lane>>4;
+    constexpr uint32_t waves=GATED?8:4;
+    const uint32_t half=GATED?wave0/4:0,wave=GATED?wave0%4:wave0;
+    const uint32_t rt=blockIdx.x+half*(N/32),m0=blockIdx.y*16;
+    __shared__ __attribute__((aligned(16))) uint8_t tr[waves][kTrBytes];
+    __shared__ float part[waves][256];
+    r3di_fp8::f8v sum=r3di_fp8::acc_zero();
+    typename D::Raw cur=D::fetch(c,rt,wave,lane,wave<c.nkb),next;
+    for(uint32_t kb=wave;kb<c.nkb;kb+=4){
+        if(kb+4<c.nkb)next=D::fetch(c,rt,kb+4,lane,true);
+        uint32_t w[16];D::template rows<false>(cur,c,1.0f,w);
+#pragma unroll
+        for(uint32_t q=0;q<16;++q)*(uint32_t*)(tr[wave0]+q*kTrPitch+4*lane)=w[q];
+        __builtin_amdgcn_fence(__ATOMIC_RELEASE,"wavefront","local");
+        __builtin_amdgcn_wave_barrier();
+        __builtin_amdgcn_fence(__ATOMIC_ACQUIRE,"wavefront","local");
+        r3di_fp8::i8v acc={0,0,0,0,0,0,0,0};
+#pragma unroll
+        for(uint32_t ks=0;ks<8;++ks){
+            auto wp=(const uint32_t*)(tr[wave0]+r*kTrPitch+ks*16);
+            auto xp=(const uint32_t*)(x+(size_t)min(m0+r,M-1)*xld+kb*128+ks*16);
+            r3di_fp8::i4v a={int(wp[0]),int(wp[1]),int(wp[2]),int(wp[3])};
+            r3di_fp8::i4v b={int(xp[0]),int(xp[1]),int(xp[2]),int(xp[3])};
+            acc=__builtin_amdgcn_wmma_i32_16x16x16_iu8_w32(true,a,true,b,acc,false);
+        }
+        const float act_scale=xs[(size_t)min(m0+r,M-1)*sld+kb];
+#pragma unroll
+        for(int j=0;j<8;++j) {
+            const float scale=act_scale*fold_f32<F>(c,rt*16+2*j+h,kb);
+            sum[j]=fmaf(float(acc[j]),scale,sum[j]);
+        }
+        __builtin_amdgcn_fence(__ATOMIC_RELEASE,"wavefront","local");
+        __builtin_amdgcn_wave_barrier();
+        __builtin_amdgcn_fence(__ATOMIC_ACQUIRE,"wavefront","local");
+        if(kb+4<c.nkb)cur=next;
+    }
+#pragma unroll
+    for(int j=0;j<8;++j)part[wave0][r*16+2*j+h]=sum[j];
+    __syncthreads();
+    for(uint32_t i=tid;i<256 && (!GATED || tid<128);i+=128){
+        const uint32_t m=m0+i/16,n=rt*16+i%16;
+        float v=part[0][i]+part[1][i];v+=part[2][i];v+=part[3][i];
+        if constexpr(GATED) {
+            float u=part[4][i]+part[5][i];u+=part[6][i];u+=part[7][i];
+            if(m<M)gated_put(go,m,n,v*row_scale<F>(c,n),u*row_scale<F>(c,n+go.n));
+        } else if(m<M)y[(size_t)m*yld+n]=r3di_bf16(v*row_scale<F>(c,n));
+    }
+    if constexpr(GATED)gated_tail(go,M,waves);
+}
diff --git a/libr3diqr/r3di_par.h b/libr3diqr/r3di_par.h
new file mode 100644
--- /dev/null
+++ b/libr3diqr/r3di_par.h
@@ -0,0 +1,28 @@
+/* r3di_par.h -- the load-time relayouts' split of one weight over the host's cores. */
+#pragma once
+
+#include <algorithm>
+#include <thread>
+#include <vector>
+
+namespace r3di_par {
+
+/* Runs f(lo, hi) over [0, n) in parallel chunks, one thread for every `per_thread` items' worth of
+ * work and at most 16. A model's weights relayout at load, gigabytes of them, so a large one is
+ * split over the host's cores; the loader already runs several relayouts side by side, so a small
+ * one stays on the calling thread rather than starting threads that would only contend. */
+template <typename F>
+void par_for(long long n, long long per_thread, F f) {
+    const long long hc = std::max(1u, std::min(16u, std::thread::hardware_concurrency()));
+    const long long nt = std::max(1ll, std::min(hc, n / std::max(1ll, per_thread)));
+    if (nt == 1) {
+        f(0ll, n);
+        return;
+    }
+    const long long per = (n + nt - 1) / nt;
+    std::vector<std::thread> th;
+    for (long long lo = 0; lo < n; lo += per) th.emplace_back(f, lo, std::min(n, lo + per));
+    for (std::thread& t : th) t.join();
+}
+
+}  // namespace r3di_par
diff --git a/libr3diqr/r3di_plugin.h b/libr3diqr/r3di_plugin.h
new file mode 100644
--- /dev/null
+++ b/libr3diqr/r3di_plugin.h
@@ -0,0 +1,1075 @@
+/* r3di_plugin.h -- what libr3di's translation units share.
+ *
+ * The row table (r3di_rows.cpp) and the weight layouts (r3di_layout.cpp) are pure host C++ and
+ * include only this file and the ABI; the launch shims include r3di.h and so <hip/hip_runtime.h>.
+ * The split lets the constraint table compile and be checked without ROCm, and is why every shim
+ * is declared here rather than beside its definition.
+ *
+ * Nothing in this header may include r3di.h.
+ */
+#ifndef RAD_R3DI_PLUGIN_H
+#define RAD_R3DI_PLUGIN_H
+
+#include "r3di_args.h"
+
+
+extern "C" {
+int r3di_rad_pixtral_patch(const RadArgs*, RadStream);
+int r3di_rad_position_scale(const RadArgs*, RadStream);
+int r3di_rad_ministral_rope(const RadArgs*, RadStream);
+int r3di_rad_pixtral_rope(const RadArgs*, RadStream);
+int r3di_rad_pixtral_merge(const RadArgs*, RadStream);
+int r3di_rad_embed_attn(const RadArgs*, RadStream);
+int64_t r3di_nemotron_scratch(const RadArgs*);
+int r3di_ministral_init(const RadParam*, int, int, int, void**);
+int r3di_pixtral_init(const RadParam*, int, int, int, void**);
+void r3di_rotary_fini(void*);
+}
+
+/* ================================================================== the priority ladder
+ *
+ * The selector ranks candidate rows by an integer priority (spec §2.1); where two rows of one op
+ * can match a geometry, it decides which serves. Each group states the reason for its order.
+ * Values are spaced by ten so a row can be slipped between two without renumbering.
+ */
+enum {
+    /* A two-shot row's constraints are a superset of the one-shot's at the same world_size, so it
+     * must rank higher to be reachable. Its lower bound on `numel` keeps small messages on the
+     * one-shot. */
+    R3DI_PRIO_AR_TWOSHOT   = 70,
+    R3DI_PRIO_AR_ONESHOT   = 60,
+
+    /* `attn_paged` is banded on q_len, and the decode row's bound (q_len<=10 at h256, q_len<=16 at
+     * h128) is a bucket boundary, not a partition: both rows match in the low band, so decode must
+     * outrank prefill. */
+    R3DI_PRIO_ATTN_DECODE  = 70,
+    R3DI_PRIO_ATTN_PREFILL = 60,
+    /* A lossy prefill row (e4m3 products) matches only a caller that states `prefill_fp8`, where
+     * the exact row matches too, so it ranks above it and below decode. */
+    R3DI_PRIO_ATTN_PREFILL_FP8 = 61,
+    /* The windowed kernels (r3di_attn_paged_window.hip) serve every q_len, so where their geometry
+     * meets another leg's (h256 at gqa 2) they match in both of that leg's bands and rank below
+     * both: on R9700 at the 31B's shapes (window 1024, fp8 cache) the h256/gqa2 decode kernel takes
+     * 0.26-0.71 of the windowed kernel's time at q_len 1..32 and its prefill kernel 0.43-0.67 at
+     * 33..512, bf16 cache similar. The windowed rows keep that geometry's non-causal band past
+     * q_len 32, and attn_paged_qrow, which no other kernel serves. */
+    R3DI_PRIO_ATTN_WINDOW  = 50,
+
+    /* At M<=16 with K%256==0 both bf16 skinny rows match and the m16 (dot2) kernel is taken. The
+     * m64 WMMA kernel is faster on every shape measured, so a caller wanting it at low M asks with
+     * M=64 to exclude m16. */
+    R3DI_PRIO_GEMM_M16     = 60,
+    R3DI_PRIO_GEMM_SKINNY  = 50,
+    /* The MXFP4 decode row outranks the MXFP4 skinny row, whose band it shares up to N = 36864. */
+    R3DI_PRIO_GEMM_MXDEC   = 55,
+    /* The MXFP4 gemv row (one to eight rows) outranks the decode row, whose band it shares there. */
+    R3DI_PRIO_GEMM_MXGEMV  = 58,
+    /* The decode kernel's short-K row outranks gemv_wide in the one corner of its band where the
+     * decode kernel is faster (33..64 rows, N >= 8192, K <= 2560). */
+    R3DI_PRIO_GEMM_MXDEC_SHORTK = 59,
+    /* The skinny m64 row has no upper bound on M, so the tiled bf16 row (M > 64 only) must outrank
+     * it, and stays below m16, whose band it never enters. */
+    R3DI_PRIO_GEMM_BF16_TILED = 55,
+
+    /* Bands already separate these from the skinny kernels (skinny is M<=64, these unbounded), so
+     * this pair only decides M>64. `pf` is the newer kernel and its tuned picks fall back to the
+     * tiled one, so it outranks. Not expressible here: the optimum crosses between the two kernels
+     * at a shape-dependent M, and tuning varies only within a kernel. */
+    R3DI_PRIO_GEMM_PREFILL = 40,
+    R3DI_PRIO_GEMM_TILED   = 30,
+
+    /* The block-scaled fp8 family. fp8a16 is a separate dtype and needs no ordering against these;
+     * the narrow fp8a8 row's M <= 16 is a subset of the tiled row's unbounded M, so it must
+     * outrank. No dtype string reaches both these and the skinny int8 GEMMs. */
+    R3DI_PRIO_GEMM_FP8_M16   = 60,
+    R3DI_PRIO_GEMM_FP8_TILED = 40,
+    /* The lm_head at fp8 (and int8), above the bf16 projection, which reads twice the bytes.
+     * The head's encoding, fixed at conversion, decides which rows are candidates (spec §4.3):
+     * these rows' layout hooks refuse a bf16 head, and the bf16 row has no hook for a scaled
+     * one. */
+    R3DI_PRIO_LOGITS_FP8     = 60,
