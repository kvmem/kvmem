diff --git a/libr3diqr/r3di_prefill_body.h b/libr3diqr/r3di_prefill_body.h
new file mode 100644
--- /dev/null
+++ b/libr3diqr/r3di_prefill_body.h
@@ -0,0 +1,320 @@
+// Adapted from pinned libr4d/r4d_gemm_8a8_prefill.h (Radiance v2).
+// r3di_gemm_8a8_prefill.h -- the int8 and fp8 prefill tile's body (gemm_8a8_prefill_body), shared
+// by r3di_gemm_fp8a8.hip's tiles and r3di_gemm_iqr.hip's, which decodes its weight in the body's
+// `begin` hook. Included inside an anonymous namespace after the includer's kWave (32) and kBlock
+// (128), with r3di_fp8_wmma.h's names in scope.
+
+// ---- the prefill tile's geometry ---------------------------------------------------------------
+//
+// A block owns 128 weight rows x 128 activation rows: eight waves as kPWW (weight) x kPWA
+// (activation), each wave kPTW weight tiles x kPTA activation tiles of 16 x 16. Eight accumulator
+// tiles a wave is a hard cap: each is two f32 sets (`raw` and `out`), so more spills. The staged K
+// tile is kPFK bytes, two per 128-column scale block. See gemm_8a8_prefill_kernel for the layout
+// and what was measured.
+constexpr uint32_t kPTW = 2, kPTA = 4, kPWW = 4, kPWA = 2;
+constexpr uint32_t kPBN = kPWW * kPTW * 16, kPBM = kPWA * kPTA * 16;   // weight x activation rows
+constexpr uint32_t kPWaves = kPWW * kPWA;
+constexpr uint32_t kPFK = 64;
+static_assert(kPBN == kBlock, "a block's weight rows are one scale row");
+// Activation bands per raster group of the prefill tile; see the kernel's grouping.
+constexpr uint32_t kGroupM = 8;
+/* The LDS the body's activation staging holds, which a `begin` hook may borrow. */
+constexpr uint32_t kPrefillLds = 2u * kPBM * (kPFK + 8u);
+
+// ---- the prefill tile ---------------------------------------------------------------------------
+//
+// 128 weight rows x 128 activation rows a block, eight waves as kPWW (weight) x kPWA (activation),
+// a wave kPTW weight tiles x kPTA activation tiles. The weight is the WMMA A operand, read from the
+// fragment-order plane straight into registers: a lane's 32 bytes are its four fragments for 64 k,
+// so a wave's load is one contiguous KiB and the weight never touches LDS. The activation is the B
+// operand, staged through LDS and read by the four waves that share its rows. A lane's accumulator
+// is eight consecutive weight rows of one activation row, so the fold takes one activation scale a
+// lane a tile (and the block's one weight scale), and the store is one 16-byte write.
+//
+// What decides the layout is LDS bandwidth. gfx1201 serves 64 bytes of LDS a clock per CU, loads
+// and stores alike, and issues an fp8 WMMA every 8 clocks per SIMD, so a CU has 256 bytes of LDS
+// per WMMA at the WMMA rate (libr4d/isa/wmmamix.hip). Staging both operands with one activation
+// tile x eight weight tiles a wave moves 288 bytes of fragment reads and 64 of stores per WMMA,
+// which alone caps a loop at ~73% of the WMMA rate (measured with nothing else in it). This layout
+// reads 128 bytes and stores 32 per WMMA, and the weight's 64 bytes come through the vector cache.
+//
+// At the 300 W limit every GEMM shape here is power-bound (sclk 2.1-2.3 GHz against 2.55 for bare
+// WMMA on random operands), so a variant's speed tracks the bytes it moves as much as the
+// instructions it issues. Measured against the both-operands-through-LDS 1x8 tile at the DiT's
+// shapes (M 18648) and LLM prefill shapes (M 300-4096), 160 TFLOP/s at gate_up:
+//   - this layout with the per-row activation scales gathered from global, mul + add fold: +12%;
+//   - the activation scales staged through LDS (`s_as`), one row a thread: +4%. A lane's gather
+//     touched sixteen cachelines a load, more bytes than its weight fragments;
+//   - the fold as one fma instead of a rounded multiply and an add: +4-5%. Not bit-identical to
+//     the separate multiply (rel_l2 ~2e-5 against it, both well inside bf16 output);
+//   - unconditional prefetch (the last tile's prefetch re-reads the last tile, discarded): +1%.
+//     A conditional load joins two paths with different counts and the compiler waits for zero;
+//   - the LDS-only barrier (lds_barrier) instead of __syncthreads: +1%; the latter's release waits
+//     for every outstanding load, the weight prefetch included;
+//   - kGroupM 8 instead of 16: +1-3%; 4 ties 8.
+// Measured and rejected:
+//   - 2 x 4 waves of 4 weight x 2 activation tiles (half the LDS reads, twice the weight bytes
+//     through the vector cache): 3-5% slower;
+//   - 8 x 1 waves (256 x 64 blocks, no weight tile read twice in a block): ties at o and gate_up;
+//   - the weight two tiles ahead: 240 VGPRs and scratch spills, 25-38% slower;
+//   - 12 or 16 waves (192 or 256 activation rows a block, up to a quarter less L2 traffic): ties
+//     to 1% slower, a higher clock at a lower rate per clock;
+//   - four threads an activation row, 16 bytes each (whole 64-byte segments a load): neutral;
+//   - raw buffer loads with 32-bit offsets for both operands: 20% slower;
+//   - s_setprio around the WMMA run: neutral. CU mode (-mcumode): ~10% slower.
+/* RB (I8 only): the weight's scale is one per RB rows and 128 K, as a trellis on libquant's tcq_rb
+ * grid widens (r3di_fp8_layout.cpp; the per-row plane holds the block's one value in each row):
+ * RB 8, a lane's eight accumulator rows, one scale per lane per tile; RB 32, a wave's two tiles,
+ * one scale per wave as the fp8 tile has. The fold is then the fp8 one, one fma per slot: the
+ * int32 accumulator starts each 128-K block at 0x4B400000, so the slot read as an f32 is exactly
+ * 12582912 + sum (|sum| <= 128 * 127 * 127 < 2^22) and needs no conversion. The scales are summed
+ * in `corr` (per lane and tile at RB 8, per lane at RB 32), and 12582912 times them leaves `out`
+ * every kRbFlush blocks and at the store, which keeps the f32 sum within a few bias terms of its
+ * value (6.8e-4 of the output's rms against the exact fold, under bf16's own rounding).
+ *
+ * M = 2048, one rank, the median of 7 interleaved rounds against the fp8 tile at the same clocks:
+ * RB 32 -4..0% (gate_up, down, ssm_inz, o), RB 8 -1..+3%, the per-row int8 tile +15..19%. */
+constexpr int kRbBias = 0x4B400000;
+constexpr float kRbBiasF = 12582912.0f;
+constexpr uint32_t kRbFlush = 8;
+// Keep upstream tiling/staging, but use exact int32 conversion for the fold.
+// The biased-float shortcut can amplify cancellation on long K.
+constexpr bool kUseBiasFold = false;
+template <int RB>
+__device__ __forceinline__ f8v rb_first() {
+    if constexpr (RB != 0 && kUseBiasFold) return __builtin_bit_cast(f8v, (i8v)(kRbBias));
+    else return acc_zero();
+}
+
+/* What the tile does around its K loop besides the GEMM: `begin(bm, bn, lds)` once the block's
+ * bands are known and before any weight load, with the activation's staging LDS (`kPrefillLds`
+ * bytes) free to borrow; `end(bn)` after the block's stores. The int8 and fp8 tiles do nothing; the
+ * IQR tile decodes its weight there (r3di_gemm_iqr.hip). */
+struct PrefillPlain {
+    __device__ void begin(uint32_t, uint32_t, uint8_t*) const {}
+    __device__ void end(uint32_t) const {}
+};
+
+/* ROWF (RB 32): the weight's scale is one f32 a row times one f32 a 128-K block for all rows (an
+ * IQR weight under kRowF32): the block's factor `Cf[kb]` is the fold's wave-uniform scale, as RB
+ * 32's, and each row's `Rs[n]` scales its outputs at the store. */
+/* SB (I8, RB 0): the K extent of one scale on both sides, 128 or IQ8R's 256. A block of SB
+ * columns is SB / kPFK staged tiles; the int32 sums run over all of them before the one fold
+ * (|sum| <= 256 * 127 * 127 < 2^24, exact in the f32 conversion), so at 256 the tile folds half as
+ * often. */
+template <bool I8, int RB, class Pre, bool ROWF = false, uint32_t SB = kBlock>
+__device__ __forceinline__ void gemm_8a8_prefill_body(
+    const uint8_t* __restrict__ A, const float* __restrict__ Sa, const uint8_t* __restrict__ W,
+    const uint16_t* __restrict__ Sw, uint16_t* __restrict__ C, uint32_t M, uint32_t K, uint32_t N,
+    uint32_t a_ld, uint32_t sa_ld, uint32_t sw_ld, const Pre& pre,
+    const float* __restrict__ Rs = nullptr, const float* __restrict__ Cf = nullptr) {
+    static_assert(I8 && ((RB == 32 && ROWF) || (RB == 0 && !ROWF)),
+                  "gfx11 supports row-F32 and per-row BF16 IQR scales");
+    static_assert(!ROWF || RB == 32, "a row's scale and a block's factor fold as RB 32's one scale");
+    static_assert(SB == kBlock || (I8 && RB == 0 && SB == 256u), "a 256 group is the per-row int8 tile's");
+    constexpr uint32_t kTPB = SB / kPFK;   // staged tiles a scale block
+    constexpr uint32_t P = lds_pitch<kPFK>();
+    static_assert(kPBM * 2u == kPWaves * kWave, "two threads stage an activation row");
+    // Double-buffered: one barrier a staged tile, which publishes it.
+    __shared__ __attribute__((aligned(16))) uint8_t s_a[2][kPBM * P];
+    static_assert(sizeof(s_a) == kPrefillLds, "the staging LDS a begin hook may borrow");
+    // The activation scales of the current and the next 128-column block, one per block row.
+    __shared__ float s_as[2][kPBM];
+
+    const uint32_t tid = threadIdx.x, lane = tid % kWave;
+    // Uniform per wave, and through readfirstlane known so, so what derives from it stays scalar.
+    const uint32_t wave = __builtin_amdgcn_readfirstlane(tid / kWave);
+    const uint32_t ww = wave % kPWW, wa = wave / kPWW;
+
+    // The grid runs in groups of kGroupM activation bands. Blocks dispatch in flattened-id order;
+    // with the plain x-fastest grid the activation is read once per 128 weight rows, which halves
+    // the rate once it exceeds the 64 MB MALL. Within a group the bands stay cached across the N
+    // sweep and the weight is read once per group. With kGroupM bands or fewer the plain order is
+    // used and the division skipped.
+    uint32_t bm = blockIdx.x, bn = blockIdx.y;
+    if (gridDim.x > kGroupM) {
+        const uint32_t per = kGroupM * gridDim.y;
+        const uint32_t lin = blockIdx.y * gridDim.x + blockIdx.x;
+        const uint32_t first = (lin / per) * kGroupM, r = lin % per;
+        const uint32_t gm = min(gridDim.x - first, kGroupM);
+        bm = first + r % gm;
+        bn = r / gm;
+    }
+    const uint32_t m0 = bm * kPBM, n0 = bn * kPBN;
+    const uint32_t ksuper = K / kSuperK, nkb = K / SB;
+    pre.begin(bm, bn, &s_a[0][0]);
+
+    // Staging: two threads a row, 32 bytes each. Rows past M re-read row M-1, and every load is
+    // issued unconditionally (the last tile's prefetch re-reads the last tile), so the loop has no
+    // branch and its waits count exactly; nothing past M is stored.
+    const uint32_t sr = tid / 2u, sc = (tid % 2u) * 32u;
+    const uint8_t* const asrc = A + (size_t)min(m0 + sr, M - 1u) * a_ld + sc;
+    // Thread t loads the scale of block row t % 128; both threads of a row write the same value.
+    const float* const ssrc = Sa + (size_t)min(m0 + tid % kPBM, M - 1u) * sa_ld;
+    // This wave's weight tiles, kTileBytes a 64-k supertile, `ksuper` supertiles a tile row.
+    const uint32_t wt0 = n0 / 16u + ww * kPTW;
+    const uint8_t* const wsrc = W + (size_t)wt0 * ksuper * kTileBytes + lane * kLaneBytes;
+    // Activation rows this wave reads from the staged tile, and the lane's column in each.
+    const uint32_t arow = wa * kPTA * 16u;
+
+    static_assert(!RB || I8, "RB is the int8 tile's");
+    static_assert(RB == 0 || RB == 8 || RB == 32, "a weight scale per 8 or 32 rows");
+    static_assert(RB != 32 || kPTW * 16 == 32, "RB 32 is a wave's rows");
+    constexpr uint32_t kCI = RB == 8 ? kPTW : 1u;   // corr's tiles: one per tile, or the wave's
+    f8v raw[kPTW][kPTA], out[kPTW][kPTA];
+    float corr[kCI][kPTA];
+#pragma unroll
+    for (uint32_t i = 0; i < kPTW; ++i)
+#pragma unroll
+        for (uint32_t j = 0; j < kPTA; ++j) {
+            out[i][j] = acc_zero();
+            if constexpr (RB != 0) raw[i][j] = acc_zero();
+        }
+#pragma unroll
+    for (uint32_t i = 0; i < kCI; ++i)
+#pragma unroll
+        for (uint32_t j = 0; j < kPTA; ++j) corr[i][j] = 0.0f;
+
+    Stage8 pa = stage8_load(asrc, true);
+    Stage8 w0[kPTW], w1[kPTW];
+#pragma unroll
+    for (uint32_t i = 0; i < kPTW; ++i)
+        w0[i] = stage8_load(wsrc + (size_t)i * ksuper * kTileBytes, true);
+    s_as[0][tid % kPBM] = ssrc[0];
+    float scn = ssrc[min(1u, nkb - 1u)];
+
+    /* One staged K tile, the first or second half of scale block `kb`: publish the activation
+     * tile (and in the second half the next block's scales), issue the next tile's loads, then four
+     * k steps from `cur`. The first k step of a block starts from a zero accumulator, so `raw` needs
+     * no clearing after the fold. */
+    auto tile = [&](uint32_t kb, uint32_t half, Stage8 (&cur)[kPTW], Stage8 (&nxt)[kPTW]) {
+        stage8_store<kPFK>(s_a[half % 2u], sr, sc, pa);
+        if (half == kTPB - 1u) s_as[(kb + 1u) % 2u][tid % kPBM] = scn;
+        lds_barrier();
+        const uint32_t c1 = min(kb * SB + (half + 1u) * kPFK, K - kPFK);
+        pa = stage8_load(asrc + c1, true);
+#pragma unroll
+        for (uint32_t i = 0; i < kPTW; ++i)
+            nxt[i] = stage8_load(wsrc + ((size_t)i * ksuper + c1 / kSuperK) * kTileBytes, true);
+        if (half == kTPB - 1u) scn = ssrc[min(kb + 2u, nkb - 1u)];
+#pragma unroll
+        for (uint32_t ks = 0; ks < kPFK / kK; ++ks) {
+            i2v bf[kPTA];
+#pragma unroll
+            for (uint32_t j = 0; j < kPTA; ++j) bf[j] = r3di_fp8::frag<kPFK>(s_a[half % 2u], arow + j * 16u, ks * kK, lane);
+#pragma unroll
+            for (uint32_t i = 0; i < kPTW; ++i) {
+                const i2v af = frag_of(cur[i], ks);
+#pragma unroll
+                for (uint32_t j = 0; j < kPTA; ++j)
+                    raw[i][j] = mma8<I8>(af, bf[j],
+                                         (half == 0u && ks == 0u) ? rb_first<RB>() : raw[i][j]);
+            }
+        }
+    };
+
+    for (uint32_t kb = 0; kb < nkb; ++kb) {
+        // The weight's scales for this block, read ahead of the two tiles that hide them: one bf16
+        // for the block's 128 rows, or with I8 one per row, a lane's eight rows of a tile adjacent
+        // in the tile-major [N/16][K/128][16] plane.
+        float ws = 0.0f;
+        uint4 w8lo[I8 && !RB ? kPTW : 1u], w8hi[I8 && !RB ? kPTW : 1u];
+        float wb[RB == 8 ? kPTW : 1u];
+        if constexpr (ROWF) {
+            ws = Cf[kb];
+        } else if constexpr (RB == 32) {
+            /* the wave's 32 rows hold one value: the first's, a wave-uniform load */
+            ws = bscale(Sw[((size_t)wt0 * nkb + kb) * 16u]);
+        } else if constexpr (RB == 8) {
+#pragma unroll
+            for (uint32_t i = 0; i < kPTW; ++i)
+                wb[i] = bscale(Sw[((size_t)(wt0 + i) * nkb + kb) * 16u + (lane >> 4) * 8u]);
+        } else if constexpr (I8) {
+#pragma unroll
+            for (uint32_t i = 0; i < kPTW; ++i) {
+                const uint16_t* s = Sw + ((size_t)(wt0 + i) * nkb + kb) * 16u;
+                w8lo[i] = *(const uint4*)s;
+                w8hi[i] = *(const uint4*)(s + 8u);
+            }
+        } else {
+            ws = bscale(Sw[(size_t)(n0 / kBlock) * sw_ld + kb]);
+        }
+        tile(kb, 0u, w0, w1);
+        tile(kb, 1u, w1, w0);
+        if constexpr (kTPB == 4u) {
+            tile(kb, 2u, w0, w1);
+            tile(kb, 3u, w1, w0);
+        }
+        if constexpr (RB != 0 && kUseBiasFold) {
+            if (kb % kRbFlush == 0u && kb) {   // the last kRbFlush blocks' bias, before this fold
+#pragma unroll
+                for (uint32_t i = 0; i < kPTW; ++i)
+#pragma unroll
+                    for (uint32_t j = 0; j < kPTA; ++j)
+#pragma unroll
+                        for (uint32_t t = 0; t < 8; ++t)
+                            out[i][j][t] = __builtin_fmaf(-kRbBiasF, corr[RB == 8 ? i : 0][j],
+                                                          out[i][j][t]);
+#pragma unroll
+                for (uint32_t i = 0; i < kCI; ++i)
+#pragma unroll
+                    for (uint32_t j = 0; j < kPTA; ++j) corr[i][j] = 0.0f;
+            }
+        }
+#pragma unroll
+        for (uint32_t j = 0; j < kPTA; ++j) {
+            const float as = s_as[kb % 2u][arow + j * 16u + frag_c(lane)];
+            if constexpr (RB == 32) corr[0][j] = __builtin_fmaf(ws, as, corr[0][j]);
+#pragma unroll
+            for (uint32_t i = 0; i < kPTW; ++i) {
+                if constexpr (RB != 0) {
+                    const float sb = (RB == 8 ? wb[i] : ws) * as;
+                    if constexpr (RB == 8) corr[i][j] += sb;
+#pragma unroll
+                    for (uint32_t t = 0; t < 8; ++t)
+                        out[i][j][t] = __builtin_fmaf(kUseBiasFold ? raw[i][j][t] : acc_val<I8>(raw[i][j][t]), sb, out[i][j][t]);
+                    continue;
+                }
+                float s[8];
+                if constexpr (I8) {
+                    /* gfx11 accumulator slot t is weight row 2*t + lane-half. */
+                    const uint32_t d[8] = { w8lo[i].x, w8lo[i].y, w8lo[i].z, w8lo[i].w,
+                                            w8hi[i].x, w8hi[i].y, w8hi[i].z, w8hi[i].w };
+#pragma unroll
+                    for (uint32_t t = 0; t < 8; ++t)
+                        s[t] = as * bscale((uint16_t)(d[t] >> (16u * (lane >> 4))));
+                } else {
+#pragma unroll
+                    for (uint32_t t = 0; t < 8; ++t) s[t] = ws * as;
+                }
+#pragma unroll
+                for (uint32_t t = 0; t < 8; ++t)
+                    out[i][j][t] = __builtin_fmaf(acc_val<I8>(raw[i][j][t]), s[t], out[i][j][t]);
+            }
+        }
+    }
+
+    // D is [weight row][activation row]: eight consecutive columns of one C row a lane a tile.
+#pragma unroll
+    for (uint32_t i = 0; i < kPTW; ++i)
+#pragma unroll
+        for (uint32_t j = 0; j < kPTA; ++j) {
+            const uint32_t m = m0 + arow + j * 16u + frag_c(lane);
+            const uint32_t n = n0 + (ww * kPTW + i) * 16u + acc_row(lane, 0);
+            if (m < M) {
+                f8v v = contiguous_acc(out[i][j], lane);
+                if constexpr (RB != 0 && kUseBiasFold)
+#pragma unroll
+                    for (uint32_t t = 0; t < 8; ++t)
+                        v[t] = __builtin_fmaf(-kRbBiasF, corr[RB == 8 ? i : 0][j], v[t]);
+                if constexpr (ROWF)
+#pragma unroll
+                    for (uint32_t t = 0; t < 8; ++t) v[t] *= Rs[n + t];
+                /* Packed in whole registers (bf16x2_rne, f32_to_bf16's bits). */
+                *(uint4*)(C + (size_t)m * N + n) =
+                    make_uint4(bf16x2_rne(v[0], v[1]), bf16x2_rne(v[2], v[3]),
+                               bf16x2_rne(v[4], v[5]), bf16x2_rne(v[6], v[7]));
+            }
+        }
+    pre.end(bn);
+}
diff --git a/libr3diqr/r3di_prefill_decode.h b/libr3diqr/r3di_prefill_decode.h
new file mode 100644
--- /dev/null
+++ b/libr3diqr/r3di_prefill_decode.h
@@ -0,0 +1,104 @@
+// Adapted from pinned libr4d/r4d_gemm_iqr.hip, IqrPre and prefill kernel.
+template <class F>
+struct IqrPre {
+    Ctx c;
+    uint8_t* fragp;
+    uint16_t* sc;          /* the fold scales the tile reads, or null where the scale buffer is */
+    unsigned int* ctl;     /* three counters an N tile */
+    uint32_t nbm;          /* the M bands: blocks an N tile */
+
+    __device__ void begin(uint32_t bm, uint32_t bn, uint8_t* lds) const {
+        (void)bm;
+        using D = Dec<F>;
+        static_assert(kPWaves * kTrBytes <= kPrefillLds, "a wave's transpose tile in the staging LDS");
+        __shared__ __attribute__((aligned(16))) int8_t s_tab[D::kTab];
+        __shared__ uint32_t s_part;
+        const uint32_t tid = threadIdx.x, lane = tid & (kWave - 1), wave = tid / kWave;
+        unsigned int* const claimed = ctl + 3u * bn;
+        unsigned int* const decoded = claimed + 1;
+        Ctx cc = c;
+        cc.tab = s_tab;
+        uint8_t* const tr = lds + wave * kTrBytes;
+        const uint32_t ksuper = c.nkb * 2u;
+        bool staged = false;
+        for (;;) {
+            if (tid == 0)
+                s_part = __hip_atomic_load(decoded, __ATOMIC_RELAXED, __HIP_MEMORY_SCOPE_AGENT) >= 8u
+                             ? 8u
+                             : __hip_atomic_fetch_add(claimed, 1u, __ATOMIC_RELAXED,
+                                                      __HIP_MEMORY_SCOPE_AGENT);
+            __syncthreads();
+            const uint32_t part = s_part;
+            __syncthreads();
+            if (part >= 8u) break;
+            if (!staged) {
+                D::stage(s_tab, cc, tid, kPWaves * kWave);
+                __syncthreads();
+                staged = true;
+            }
+            const uint32_t rt = bn * 8u + part;
+            /* A unit's codes are fetched a unit ahead of its decode, so a wave's units do not
+             * each wait out a memory round trip. */
+            typename D::Raw cur = D::fetch(cc, rt, wave, lane, wave < c.nkb), nxt;
+            for (uint32_t kb = wave; kb < c.nkb; kb += kPWaves) {
+                if (kb + kPWaves < c.nkb) nxt = D::fetch(cc, rt, kb + kPWaves, lane, true);
+                uint32_t w[16];
+                D::template rows<false>(cur, cc, rb_ratio<F>(cc, rt * 16u + (lane & 15u), kb), w);
+                if (kb + kPWaves < c.nkb) cur = nxt;
+                D::unzero(cc, rt, kb, w);
+                Stage8 s8[2];
+                frag(w, tr, lane, s8);
+#pragma unroll
+                for (uint32_t h = 0; h < 2; ++h) {
+                    uint8_t* d = fragp + ((size_t)rt * ksuper + 2u * kb + h) * kTileBytes +
+                                 lane * kLaneBytes;
+                    *(uint4*)d = s8[h].v;
+                    *(uint4*)(d + 16) = s8[h].w;
+                }
+            }
+            if (sc)
+                for (uint32_t i = tid; i < 16u * c.nkb; i += kPWaves * kWave) {
+                    const uint32_t kb = i / 16u;
+                    sc[((size_t)rt * c.nkb + kb) * 16u + i % 16u] =
+                        (uint16_t)fold_scale<F>(cc, rt * 16u + i % 16u, kb);
+                }
+            __threadfence();
+            __syncthreads();
+            if (tid == 0)
+                __hip_atomic_fetch_add(decoded, 1u, __ATOMIC_RELEASE, __HIP_MEMORY_SCOPE_AGENT);
+        }
+        if (tid == 0)
+            while (__hip_atomic_load(decoded, __ATOMIC_ACQUIRE, __HIP_MEMORY_SCOPE_AGENT) < 8u)
+                __builtin_amdgcn_s_sleep(2);
+        __syncthreads();
+    }
+
+    __device__ void end(uint32_t bn) const {
+        if (threadIdx.x != 0) return;
+        unsigned int* const claimed = ctl + 3u * bn;
+        if (__hip_atomic_fetch_add(claimed + 2, 1u, __ATOMIC_ACQ_REL, __HIP_MEMORY_SCOPE_AGENT) + 1u ==
+            nbm) {
+            __hip_atomic_store(claimed, 0u, __ATOMIC_RELAXED, __HIP_MEMORY_SCOPE_AGENT);
+            __hip_atomic_store(claimed + 1, 0u, __ATOMIC_RELAXED, __HIP_MEMORY_SCOPE_AGENT);
+            __hip_atomic_store(claimed + 2, 0u, __ATOMIC_RELAXED, __HIP_MEMORY_SCOPE_AGENT);
+        }
+    }
+};
+
+template <class F, int RB>
+__global__ __launch_bounds__(kPWaves * kWave) 
+void iqr_prefill_kernel(IqrPre<F> pre, const uint8_t* __restrict__ A, const float* __restrict__ Sa,
+                        const uint8_t* __restrict__ W, const uint16_t* __restrict__ Sw,
+                        uint16_t* __restrict__ C, uint32_t M, uint32_t K, uint32_t N, uint32_t a_ld,
+                        uint32_t sa_ld, uint32_t sw_ld) {
+    if constexpr (F::SC == kRowF32) {
+        constexpr Form f{ F::KIND, F::B, F::LV, F::L, F::LRB, F::SC, 0 };
+        const uint8_t* const sb = pre.c.S;
+        gemm_8a8_prefill_body<true, 32, IqrPre<F>, true>(
+            A, Sa, W, Sw, C, M, K, N, a_ld, sa_ld, sw_ld, pre, (const float*)sb,
+            (const float*)(sb + cf_off(f, N, K)));
+    } else {
+        gemm_8a8_prefill_body<true, RB>(A, Sa, W, Sw, C, M, K, N, a_ld, sa_ld, sw_ld, pre);
+    }
+}
+
diff --git a/libr3diqr/r3di_quant.hip b/libr3diqr/r3di_quant.hip
new file mode 100644
--- /dev/null
+++ b/libr3diqr/r3di_quant.hip
@@ -0,0 +1,102 @@
+#include "r3di_device.h"
+#include "r3di_args.h"
+#include <climits>
+namespace {
+template<bool GATED>
+__global__ __launch_bounds__(32) void quant(const uint16_t* x,int8_t* q,float* scale,
+    uint16_t* out,uint32_t n,uint32_t xld,uint32_t qld,uint32_t sld,uint32_t old,int act) {
+    const unsigned m=blockIdx.x,kb=blockIdx.y,lane=threadIdx.x;
+    const unsigned col=kb*128+4*lane;
+    float v[4];
+    for(unsigned j=0;j<4;++j) {
+        float g=__uint_as_float((uint32_t)x[(size_t)m*xld+col+j]<<16);
+        if constexpr(GATED) {
+            float u=__uint_as_float((uint32_t)x[(size_t)m*xld+n+col+j]<<16);
+            float a=(act==0?g:1.0f)/(1.0f+expf(-g));
+            uint16_t h=r3di_bf16(a*u);
+            if(out)out[(size_t)m*old+col+j]=h;
+            g=__uint_as_float((uint32_t)h<<16);
+        }
+        v[j]=g;
+    }
+    r3di_hadamard(v,lane);
+    float mx=0;
+    for(float f:v)mx=fmaxf(mx,fabsf(f));
+    for(int h=16;h;h>>=1)mx=fmaxf(mx,__shfl_xor(mx,h,32));
+    float sc=mx>0?mx*(1.0f/127.0f):1.0f,inv=1.0f/sc;
+    if(!lane)scale[(size_t)m*sld+kb]=sc;
+    for(unsigned j=0;j<4;++j)
+        q[(size_t)m*qld+col+j]=(int8_t)fminf(fmaxf(rintf(v[j]*inv),-127.0f),127.0f);
+}
+template<bool GATED> int launch(const RadArgs* a,RadStream stream) {
+    if(!a||r3di_geti_or(a,"chain",0))return RAD_E_INVAL;
+    auto x=r3di_opt(a,0),q=r3di_opt(a,1),s=r3di_opt(a,2),o=GATED?r3di_opt(a,3):nullptr;
+    if(!x||!q||!s||!x->data||!q->data||!s->data)return RAD_E_INVAL;
+    if(x->dtype!=RAD_BF16||q->dtype!=RAD_I8||s->dtype!=RAD_F32)return RAD_E_DTYPE;
+    long long n=r3di_geti_or(a,"n",0);
+    if(n<=0||n>INT_MAX||n%128||r3di_geti_or(a,"group",0)!=128)return RAD_E_SHAPE;
+    long long m=0,qr=0,sr=0,orr=0;
+    long long xld=r3di_rows_pitch(x,n*(GATED?2:1),&m),qld=r3di_rows_pitch(q,n,&qr),sld=r3di_rows_pitch(s,n/128,&sr);
+    bool has_o=o&&o->data;
+    long long old=has_o?r3di_rows_pitch(o,n,&orr):n;
+    if(m<=0||m>65535||qr!=m||sr!=m||(has_o&&orr!=m))return RAD_E_SHAPE;
+    if(xld<n*(GATED?2:1)||qld<n||sld<n/128||old<n||xld>INT_MAX||qld>INT_MAX||sld>INT_MAX||old>INT_MAX)return RAD_E_STRIDE;
+    if(has_o&&o->dtype!=RAD_BF16)return RAD_E_DTYPE;
+    int act=0;
+    if constexpr(GATED) {
+        const char* av=r3di_gets(a,"act");
+        if(av && std::strcmp(av,"silu") && std::strcmp(av,"sigmoid"))return RAD_E_UNSUPPORTED;
+        act=av&&!std::strcmp(av,"sigmoid");
+    }
+    return R3DI_EMIT(stream,(quant<GATED>),dim3((uint32_t)m,(uint32_t)(n/128)),dim3(32),0,
+        (const uint16_t*)x->data,(int8_t*)q->data,(float*)s->data,has_o?(uint16_t*)o->data:nullptr,
+        (uint32_t)n,(uint32_t)xld,(uint32_t)qld,(uint32_t)sld,(uint32_t)old,act);
+}
+}
+extern "C" int r3di_rad_had_quant_act_i8g(const RadArgs* a,RadStream s){return launch<false>(a,s);}
+extern "C" int r3di_rad_gated_had_quant_i8g(const RadArgs* a,RadStream s){return launch<true>(a,s);}
+
+namespace {
+__global__ __launch_bounds__(256) void norm_had_quant(const uint16_t* x,uint16_t* residual,
+ const void* w,int8_t* q,float* scale,uint16_t* out,int n,int xld,int rld,int qld,int sld,int old,
+ float eps,float wadd,bool wf32) {
+ extern __shared__ uint16_t values[];
+ __shared__ float sums[8];
+ const int row=blockIdx.x,lane=threadIdx.x&31,wave=threadIdx.x>>5;
+ float ss=0;
+ for(int j=threadIdx.x;j<n;j+=256){
+  uint16_t h=x[(size_t)row*xld+j];
+  if(residual){h=r3di_bf16(__uint_as_float((uint32_t)h<<16)+__uint_as_float((uint32_t)residual[(size_t)row*rld+j]<<16));residual[(size_t)row*rld+j]=h;}
+  values[j]=h;float v=__uint_as_float((uint32_t)h<<16);ss+=v*v;
+ }
+ for(int h=16;h;h>>=1)ss+=__shfl_down(ss,h,32);
+ if(!lane)sums[wave]=ss;__syncthreads();
+ float total=0;for(int i=0;i<8;++i)total+=sums[i];
+ float inv=rsqrtf(total/n+eps);
+ for(int kb=wave;kb<n/128;kb+=8){
+  float v[4];for(int j=0;j<4;++j){int c=kb*128+4*lane+j;float gain=wf32?((const float*)w)[c]:__uint_as_float((uint32_t)((const uint16_t*)w)[c]<<16);
+   uint16_t h=r3di_bf16(__uint_as_float((uint32_t)values[c]<<16)*inv*(gain+wadd));if(out)out[(size_t)row*old+c]=h;v[j]=__uint_as_float((uint32_t)h<<16);}
+  r3di_hadamard(v,lane);float mx=0;for(float f:v)mx=fmaxf(mx,fabsf(f));for(int h=16;h;h>>=1)mx=fmaxf(mx,__shfl_xor(mx,h,32));
+  const float sc=mx>0?mx*(1.0f/127.0f):1.0f;
+  if(!lane)scale[(size_t)row*sld+kb]=sc;
+  for(int j=0;j<4;++j)q[(size_t)row*qld+kb*128+4*lane+j]=(int8_t)fminf(fmaxf(rintf(v[j]/sc),-127.0f),127.0f);
+ }
+}
+}
+extern "C" int r3di_rad_rmsnorm_had_quant_i8g(const RadArgs* a,RadStream stream) {
+ if(!a||r3di_geti_or(a,"chain",0))return RAD_E_UNSUPPORTED;
+ auto x=r3di_opt(a,0),r=r3di_opt(a,1),w=r3di_opt(a,2),q=r3di_opt(a,3),s=r3di_opt(a,4),o=r3di_opt(a,5);
+ if(!x||!w||!q||!s||!x->data||!w->data||!q->data||!s->data)return RAD_E_INVAL;
+ bool res=r&&r->data,ob=o&&o->data;
+ if(x->dtype!=RAD_BF16||(res&&r->dtype!=RAD_BF16)||(ob&&o->dtype!=RAD_BF16)||(w->dtype!=RAD_BF16&&w->dtype!=RAD_F32)||q->dtype!=RAD_I8||s->dtype!=RAD_F32)return RAD_E_DTYPE;
+ const int64_t n=r3di_geti_or(a,"n",0);
+ if(n<=0||n>16384||n%128||r3di_geti_or(a,"group",0)!=128||r3di_numel(w)!=n||!r3di_contig(w))return RAD_E_SHAPE;
+ long long m=0,rm=0,qm=0,sm=0,om=0;
+ long long xl=r3di_rows_pitch(x,n,&m),rl=res?r3di_rows_pitch(r,n,&rm):n,ql=r3di_rows_pitch(q,n,&qm),sl=r3di_rows_pitch(s,n/128,&sm),ol=ob?r3di_rows_pitch(o,n,&om):n;
+ if(m<=0||m>65535||qm!=m||sm!=m||(res&&rm!=m)||(ob&&om!=m))return RAD_E_SHAPE;
+ if(xl<n||ql<n||rl<n||ol<n||sl<n/128||xl>INT_MAX||ql>INT_MAX||rl>INT_MAX||ol>INT_MAX||sl>INT_MAX)return RAD_E_STRIDE;
+ float eps=(float)r3di_getf(a,"eps",1e-6),wadd=(float)r3di_getf(a,"wadd",0);
+ if(!(eps>=0)||!std::isfinite(eps)||!std::isfinite(wadd))return RAD_E_INVAL;
+ return R3DI_EMIT(stream,norm_had_quant,dim3((uint32_t)m),dim3(256),(size_t)n*2,
+ (const uint16_t*)x->data,res?(uint16_t*)r->data:nullptr,w->data,(int8_t*)q->data,(float*)s->data,ob?(uint16_t*)o->data:nullptr,(int)n,(int)xl,(int)rl,(int)ql,(int)sl,(int)ol,eps,wadd,w->dtype==RAD_F32);
+}
diff --git a/libr3diqr/r3di_rope.hip b/libr3diqr/r3di_rope.hip
new file mode 100644
--- /dev/null
+++ b/libr3diqr/r3di_rope.hip
@@ -0,0 +1,302 @@
+// Portable scalar RoPE imported from Radiance v2 ddcb9c69; see rope-import.json.
+#include "r3di_device.h"
+#include "r3di_args.h"
+#include "rad_yarn.h"
+#include <climits>
+static constexpr uint32_t kThreads=256;
+__device__ inline float bf16_to_f32(uint16_t h){return __uint_as_float((uint32_t)h<<16);}
+__device__ inline uint16_t f32_to_bf16(float f){return r3di_bf16(f);}
+static inline int dt_bf16(const RadTensor* t){return t&&t->dtype==RAD_BF16?RAD_OK:RAD_E_DTYPE;}
+static inline int dt_i32(const RadTensor* t){return t&&(t->dtype==RAD_I32||t->dtype==RAD_U32)?RAD_OK:RAD_E_DTYPE;}
+#define R3DI_NEED(x) do {const int c=(x);if(c!=RAD_OK)return R3DI_NO(c);}while(0)
+__device__ __forceinline__ int rope_comp(int mode, uint32_t i, const int* sec, int n_sec,
+                                         uint32_t* j) {
+    *j = i;
+    if (mode == 3) {
+        if (i % 3 == 1 && (int)i < 3 * sec[1]) return 1;
+        if (i % 3 == 2 && (int)i < 3 * sec[2]) return 2;
+        return 0;
+    }
+    int c = 0, start = 0;
+    while (c + 1 < n_sec && (int)i >= start + sec[c]) { start += sec[c]; ++c; }
+    *j = i - (uint32_t)start;
+    return c;
+}
+
+// This qualification entry uses ordinary HIP launches; chained requests are rejected.
+#define R3DI_ROPE_PARAMS                                                                          \
+    uint16_t* __restrict__ qkv, const int32_t* __restrict__ pos, uint32_t head_dim,              \
+    uint32_t n_rope_heads, uint32_t rot, uint32_t nfreq, int den, int gptj, float theta,         \
+    float rscale, uint32_t row_pitch, int mode, int s0, int s1, int s2, int n_sec,               \
+    uint32_t plane, RadYarn yarn, RadLlama3 l3
+#define R3DI_ROPE_ARGS                                                                            \
+    qkv, pos, head_dim, n_rope_heads, rot, nfreq, den, gptj, theta, rscale, row_pitch, mode, s0, \
+    s1, s2, n_sec, plane, yarn, l3
+__device__ __forceinline__ void rope_body(R3DI_ROPE_PARAMS) {
+    const uint32_t m = blockIdx.x;
+    const uint32_t half = rot / 2;
+    const float div = rscale != 0.0f ? rscale : 1.0f;
+    const float p0 = (float)pos[m] / div;
+    const int sec[3] = { s0, s1, s2 };
+
+    for (uint32_t t = threadIdx.x + blockIdx.y * kThreads; t < n_rope_heads * half;
+         t += kThreads * gridDim.y) {
+        const uint32_t h = t / half, i = t % half;
+        uint16_t* __restrict__ hd = qkv + (size_t)m * row_pitch + (size_t)h * head_dim;
+        float inv = 1.0f / powf(theta, (float)(2 * i) / (float)den);
+        float p = p0;
+        if (plane) {
+            uint32_t j = i;
+            const int c = rope_comp(mode, i, sec, n_sec, &j);
+            p = (float)pos[(size_t)c * plane + m] / div;
+            if (mode == 4)
+                inv = 1.0f / powf(theta, (float)(2 * j) / (float)(2 * sec[c]));
+        }
+        inv = yarn.frequency(inv, (int)i);
+        inv = l3.frequency(inv);
+        /* The proportional ladder rotates the whole head with every frequency past nfreq zero
+         * (HF's _compute_proportional_rope_parameters): pair i is (i, i + head_dim/2), and pairs
+         * past nfreq turn by 0 (cos 1, sin 0), returning the value exactly. */
+        if (i >= nfreq) inv = 0.0f;
+        const float ang = p * inv;
+        float c, s;
+        sincosf(ang, &s, &c);
+        if (yarn.factor != 0.0f) { c *= yarn.magnitude; s *= yarn.magnitude; }
+        const uint32_t i0 = gptj ? 2 * i : i;
+        const uint32_t i1 = gptj ? 2 * i + 1 : i + half;
+        const float x0 = bf16_to_f32(hd[i0]), x1 = bf16_to_f32(hd[i1]);
+        hd[i0] = f32_to_bf16(x0 * c - x1 * s);
+        hd[i1] = f32_to_bf16(x0 * s + x1 * c);
+    }
+}
+__global__ __launch_bounds__(kThreads) void rope_kernel(R3DI_ROPE_PARAMS) {
+    rope_body(R3DI_ROPE_ARGS);
+}
+#undef R3DI_ROPE_ARGS
+#undef R3DI_ROPE_PARAMS
+
+// The same rotary at prefill row counts with each (token, pair) angle computed once. rope_kernel
+// gives every (head, pair) its own thread, which recomputes powf and the accurate sincosf for every
+// head; the angle depends on the token and the pair alone, so at 32 heads 31 of 32 evaluations are
+// repeats (q at 408 tokens: ~50 us on gfx1200). Here a thread owns one pair of one token and turns
+// that pair in every head. Byte-identical: the angle, cos and sin are rope_kernel's expressions on
+// the same inputs, and each head's two stores are its.
+__global__ __launch_bounds__(kThreads) void rope_rows_kernel(
+    uint16_t* __restrict__ qkv, const int32_t* __restrict__ pos, uint32_t M,
+    uint32_t head_dim, uint32_t n_rope_heads, uint32_t rot, uint32_t nfreq, int den, int gptj,
+    float theta, float rscale, uint32_t row_pitch,
+    int mode, int s0, int s1, int s2, int n_sec, uint32_t plane, RadYarn yarn, RadLlama3 l3) {
+    const uint32_t half = rot / 2;
+    const uint32_t rpb = kThreads / half;                 // rows a block; half <= kThreads
+    const uint32_t m = blockIdx.x * rpb + threadIdx.x / half, i = threadIdx.x % half;
+    if (threadIdx.x >= rpb * half || m >= M) return;
+    const float div = rscale != 0.0f ? rscale : 1.0f;
+    const float p0 = (float)pos[m] / div;
+    const int sec[3] = { s0, s1, s2 };
+
+    float inv = 1.0f / powf(theta, (float)(2 * i) / (float)den);
+    float p = p0;
+    if (plane) {
+        uint32_t j = i;
+        const int c = rope_comp(mode, i, sec, n_sec, &j);
+        p = (float)pos[(size_t)c * plane + m] / div;
+        if (mode == 4)
+            inv = 1.0f / powf(theta, (float)(2 * j) / (float)(2 * sec[c]));
+    }
+    inv = yarn.frequency(inv, (int)i);
+    inv = l3.frequency(inv);
+    if (i >= nfreq) inv = 0.0f;
+    const float ang = p * inv;
+    float c, s;
+    sincosf(ang, &s, &c);
+    if (yarn.factor != 0.0f) { c *= yarn.magnitude; s *= yarn.magnitude; }
+    const uint32_t i0 = gptj ? 2 * i : i;
+    const uint32_t i1 = gptj ? 2 * i + 1 : i + half;
+    uint16_t* __restrict__ row = qkv + (size_t)m * row_pitch;
+    for (uint32_t h = 0; h < n_rope_heads; ++h) {
+        uint16_t* __restrict__ hd = row + (size_t)h * head_dim;
+        const float x0 = bf16_to_f32(hd[i0]), x1 = bf16_to_f32(hd[i1]);
+        hd[i0] = f32_to_bf16(x0 * c - x1 * s);
+        hd[i1] = f32_to_bf16(x0 * s + x1 * c);
+    }
+}
+
+static int rope_launch(int64_t qkv, int64_t pos, int M, int head_dim, int n_rope_heads, int rot, int den,
+                       int gptj, float theta, float rscale, int row_pitch, int mode,
+                       const int* sec, int n_sec, int plane, RadYarn yarn, int64_t stream,
+                       int nfreq = -1, RadLlama3 l3 = RadLlama3{}, bool rows_form = false,
+                       bool chain = false) {
+    if (chain) return -3;
+    if (!qkv || !pos) return -1;
+    if (M <= 0 || head_dim <= 0 || n_rope_heads <= 0) return -2;
+    if (rot <= 0 || rot > head_dim || (rot & 1)) return -3;
+    if (n_sec < 0 || n_sec > 3 || (n_sec && !sec)) return -3;
+    if (!row_pitch) row_pitch = n_rope_heads * head_dim;
+    const uint32_t pairs = (uint32_t)n_rope_heads * (uint32_t)(rot / 2);
+    const uint32_t gy = (pairs + kThreads - 1) / kThreads;
+    const int s0 = n_sec > 0 ? sec[0] : 0, s1 = n_sec > 1 ? sec[1] : 0, s2 = n_sec > 2 ? sec[2] : 0;
+    if (nfreq < 0) nfreq = rot / 2;
+    /* Prefill rows with at least four heads: one angle a (token, pair), every head turned with it
+     * (rope_rows_kernel, the same bytes). Decode rows keep a thread a (head, pair), which spreads a
+     * single token over the card. Opt-in by op name (`rope_rows`): every other caller's launch is
+     * the one it had. */
+    if (rows_form && M >= 64 && n_rope_heads >= 4 && rot / 2 <= (int)kThreads) {
+        const uint32_t rpb = kThreads / (uint32_t)(rot / 2);
+        hipLaunchKernelGGL(rope_rows_kernel, dim3(((uint32_t)M + rpb - 1) / rpb), dim3(kThreads), 0,
+                           (hipStream_t)stream, (uint16_t*)qkv, (const int32_t*)pos, (uint32_t)M,
+                           (uint32_t)head_dim, (uint32_t)n_rope_heads, (uint32_t)rot,
+                           (uint32_t)nfreq, (int)den, gptj, theta, rscale, (uint32_t)row_pitch, mode,
+                           s0, s1, s2, n_sec, (uint32_t)plane, yarn, l3);
+        return hipGetLastError() == hipSuccess ? 0 : -4;
+    }
+#define R3DI_ROPE(K_)                                                                             \
+    hipLaunchKernelGGL(K_, dim3((uint32_t)M, gy), dim3(kThreads), 0, (hipStream_t)stream,        \
+                       (uint16_t*)qkv, (const int32_t*)pos, (uint32_t)head_dim,                  \
+                       (uint32_t)n_rope_heads, (uint32_t)rot, (uint32_t)nfreq, (int)den, gptj,   \
+                       theta, rscale, (uint32_t)row_pitch, mode, s0, s1, s2, n_sec,              \
+                       (uint32_t)plane, yarn, l3)
+    R3DI_ROPE(rope_kernel);
+#undef R3DI_ROPE
+    return hipGetLastError() == hipSuccess ? 0 : -4;
+}
+
+enum { RP_QKV = 0, RP_POS };
+
+/* `rows_form`: the row is `rope_rows`, which may turn every head of a (token, pair) with the one
+ * angle it computed (rope_rows_kernel). Every other caller passes false. */
+static int rope_emit(const RadArgs* a, RadStream s, bool rows_form) {
+    if (r3di_geti_or(a, "chain", 0)) return RAD_E_UNSUPPORTED;
+    const RadTensor* qkv = r3di_opt(a, RP_QKV);
+    const RadTensor* pos = r3di_opt(a, RP_POS);
+    if (!qkv || !pos) return R3DI_NO(RAD_E_INVAL);
+    R3DI_NEED(dt_bf16(qkv));
+    R3DI_NEED(dt_i32(pos));
+    if (!r3di_contig(pos)) return R3DI_NO(RAD_E_STRIDE);
+
+    const long long head_dim  = r3di_geti_or(a, "head_dim", 0);
+    const long long n_head    = r3di_geti_or(a, "n_head", 0);
+    const long long n_head_kv = r3di_geti_or(a, "n_head_kv", 0);
+    const long long rot       = r3di_geti_or(a, "rotary_dim", head_dim);
+    if (head_dim <= 0 || n_head <= 0 || n_head_kv < 0) return R3DI_NO(RAD_E_SHAPE);
+    if (rot <= 0 || rot > head_dim || (rot & 1)) return R3DI_NO(RAD_E_SHAPE);
+
+    /* `ladder`: `rotary` (default) measures the base ladder in `rot`; `head` in `head_dim` (the
+     * proportional variant). */
+    const char* lad = r3di_gets(a, "ladder");
+    long long den = rot;
+    if (lad) {
+        if (!std::strcmp(lad, "head")) den = head_dim;
+        else if (std::strcmp(lad, "rotary")) return R3DI_NO(RAD_E_UNSUPPORTED);
+    }
+    /* `head` is HF's proportional RoPE: the rotation spans the whole head (pair i is
+     * (i, i + head_dim/2)) and only the first rotary_dim/2 frequencies are non-zero. Pairing
+     * (i, i + rot/2) instead turns the wrong channels (Gemma 4's global layers, 128 of 512) and
+     * degrades long-range attention. */
+
+    /* The mode sets how many components a position has. With [M] positions, mrope and imrope are
+     * neox. With [C, M] positions and `sections`, each frequency reads its section's component
+     * (docs/OPS.md, `rope`). */
+    const char* mode = r3di_gets(a, "mode");
+    int gptj = 0, mc = 0;
+    if (mode) {
+        if (!std::strcmp(mode, "gptj")) gptj = 1;
+        else if (!std::strcmp(mode, "mrope")) mc = 2;
+        else if (!std::strcmp(mode, "imrope")) mc = 3;
+        else if (!std::strcmp(mode, "axial")) mc = 4;
+        else if (std::strcmp(mode, "neox")) return R3DI_NO(RAD_E_SCHEMA);
+    }
+    int sec[3] = { 0, 0, 0 }, n_sec = 0;
+    for (const char* v = r3di_gets(a, "sections"); v && *v;) {
+        char* e = nullptr;
+        const int64_t x = std::strtol(v, &e, 10);
+        if (e == v) break;
+        if (x <= 0 || n_sec >= 3) return R3DI_NO(RAD_E_SHAPE);
+        sec[n_sec++] = (int)x;
+        v = e;
+    }
+
+    const long long row = (n_head + 2 * n_head_kv) * head_dim;
+    long long M = 0;
+    const long long pitch = r3di_rows_pitch(qkv, row, &M);
+    if (pitch < 0) return R3DI_NO(RAD_E_STRIDE);
+    if (pos->rank < 1 || pos->rank > 2) return RAD_E_SHAPE;
+    const bool multi = pos->rank == 2;
+    const long long Mp = multi ? pos->shape[1] : r3di_numel(pos);
+    if (Mp <= 0 || M < Mp) return R3DI_NO(RAD_E_SHAPE);
+    int plane = 0;
+    if (multi) {
+        if (!mc || n_sec == 0) return R3DI_NO(RAD_E_SHAPE);
+        if (pos->shape[0] < (mc == 3 ? 3 : n_sec)) return R3DI_NO(RAD_E_SHAPE);
+        if (mc == 3 && n_sec != 3) return R3DI_NO(RAD_E_SHAPE);
+        if (mc != 3 && [&] { int t = 0; for (int c = 0; c < n_sec; ++c) t += sec[c];
+                             return t != (int)(rot / 2); }())
+            return R3DI_NO(RAD_E_SHAPE);
+        plane = (int)pos->shape[1];
+    }
+
+    const float theta  = (float)r3di_getf(a, "theta", 10000.0);
+    const float rscale = (float)r3di_getf(a, "scale", 1.0);
+    if (!(theta > 0.0f) || !std::isfinite(theta) || !std::isfinite(rscale) || rscale < 0.0f) return RAD_E_INVAL;
+    const RadYarn yarn = rad_yarn_args(a);
+    if (!rad_yarn_valid(yarn)) return R3DI_NO(RAD_E_INVAL);
+    /* No model uses YaRN with the axial vision rotary or a linear position divide. */
+    if (yarn.factor != 0.0f && (mc == 4 || rscale != 1.0f)) return R3DI_NO(RAD_E_UNSUPPORTED);
+    /* Llama 3's scaling: one-component positions only, and never beside YaRN (libref refuses
+     * both alike). */
+    const RadLlama3 l3 = rad_llama3_args(a);
+    if (!rad_llama3_valid(l3) || (l3.factor != 0.0f && yarn.factor != 0.0f))
+        return R3DI_NO(RAD_E_INVAL);
+    if (l3.factor != 0.0f && (mc == 4 || multi)) return R3DI_NO(RAD_E_UNSUPPORTED);
+    /* The Q and K heads rotate; the trailing V heads do not. */
+    long long rot_l = rot, nfreq = rot / 2;
+    if (den == head_dim && rot < head_dim && !multi && !gptj && mc == 0) rot_l = head_dim;
+    return rope_launch(r3di_addr(qkv), r3di_addr(pos), (int)Mp, (int)head_dim,
+                       (int)(n_head + n_head_kv), (int)rot_l, (int)den, gptj, theta, rscale,
+                       (int)pitch, mc, sec, n_sec, plane, yarn, (int64_t)(uintptr_t)s,
+                       (int)nfreq, l3, rows_form, r3di_geti_or(a, "chain", 0) != 0 && Mp <= 64) == 0
+        ? RAD_OK
+        : RAD_E_DEVICE;
+}
+
+extern "C" int r3di_rad_rope(const RadArgs* a, RadStream s) {
+    return rope_emit(a, s, false);
+}
+
+/* `rope_rows`: the same rotation, whose launch may compute one angle a (token, pair) and turn every
+ * head with it (rope_rows_kernel, the same bytes) at prefill row counts. */
+extern "C" int r3di_rad_rope_rows(const RadArgs* a, RadStream s) {
+    return rope_emit(a, s, true);
+}
+
+// Scalar body from v2 r4d_qk_norm_rope_gate.hip, ordinary HIP launch.
+__global__ __launch_bounds__(64) void rope_table_kernel(const void* pos,void* cs,
+    int64_t rows,int rot,int den,float theta,float scale,bool f32,bool i64,RadYarn yarn) {
+ const int64_t p=i64?((const int64_t*)pos)[blockIdx.x]:((const int32_t*)pos)[blockIdx.x];
+ if(p<0||p>=rows)return;
+ const int half=rot/2;const float at=(float)p/(scale!=0?scale:1.0f);
+ for(int i=threadIdx.x;i<half;i+=blockDim.x){
+  const float inv=yarn.frequency(1.0f/powf(theta,(float)(2*i)/(float)den),i);
+  float c,s;sincosf(at*inv,&s,&c);
+  if(yarn.factor!=0){c*=yarn.magnitude;s*=yarn.magnitude;}
+  const size_t o=(size_t)p*rot;
+  if(f32){((float*)cs)[o+i]=c;((float*)cs)[o+half+i]=s;}
+  else {((uint16_t*)cs)[o+i]=r3di_bf16(c);((uint16_t*)cs)[o+half+i]=r3di_bf16(s);}
+ }
+}
+extern "C" int r3di_rad_rope_table(const RadArgs* a,RadStream stream) {
+ if(!a||r3di_geti_or(a,"chain",0))return RAD_E_UNSUPPORTED;
+ auto p=r3di_opt(a,0),c=r3di_opt(a,1);
+ if(!p||!c||!p->data||!c->data)return RAD_E_INVAL;
+ if(!r3di_contig(p)||!r3di_contig(c))return RAD_E_STRIDE;
+ if((p->dtype!=RAD_I32&&p->dtype!=RAD_I64)||(c->dtype!=RAD_F32&&c->dtype!=RAD_BF16))return RAD_E_DTYPE;
+ const int64_t m=r3di_numel(p),rot=r3di_geti_or(a,"rot",0),n=r3di_numel(c);
+ if(m<=0||m>INT_MAX||rot<2||rot>INT_MAX||rot%2||n<=0||n%rot)return RAD_E_SHAPE;
+ int64_t den=rot;const char* ladder=r3di_gets(a,"ladder");
+ if(ladder){if(!strcmp(ladder,"head"))den=r3di_geti_or(a,"head_dim",0);else if(strcmp(ladder,"rotary"))return RAD_E_UNSUPPORTED;}
+ if(den<=0||den>INT_MAX)return RAD_E_SHAPE;
+ float theta=(float)r3di_getf(a,"theta",10000),scale=(float)r3di_getf(a,"scale",1);
+ auto y=rad_yarn_args(a);
+ if(!(theta>0)||!std::isfinite(theta)||!std::isfinite(scale)||scale<0||!rad_yarn_valid(y)||(y.factor!=0&&scale!=1))return RAD_E_INVAL;
+ return R3DI_EMIT(stream,rope_table_kernel,dim3((uint32_t)m),dim3(64),0,p->data,c->data,n/rot,(int)rot,(int)den,theta,scale,c->dtype==RAD_F32,p->dtype==RAD_I64,y);
+}
