diff --git a/libr3diqr/audit_gpu_test.inc b/libr3diqr/audit_gpu_test.inc
new file mode 100644
--- /dev/null
+++ b/libr3diqr/audit_gpu_test.inc
@@ -0,0 +1,23 @@
+// Merge audit: independent canonical-trellis oracle at dispatch boundaries,
+// large output widths and long reductions; no baseline kernel as the oracle.
+void audit_tests(Api& api) {
+    for(int bits:{2,3,4,5,6})
+        gemm_test(api,bits,bits==2?15:16,512,1,5120,false,4096);
+    gemm_test(api,5,16,512,1,5120,true,4096);
+    for(int m:{8,65}) {
+        gemm_test(api,4,16,1024,m,5120);
+        gemm_test(api,5,16,512,m,5120,true);
+    }
+    // More than four M bands exercises the prefill's grouped grid ordering,
+    // including a partial final group and repeated scratch reuse.
+    gemm_test(api,3,16,256,641,256);
+    gemm_test(api,5,16,512,641,256,true);
+    for(int bits:{2,3,4})embed_test(api,bits,true);
+    RadTensor t=tensor(nullptr,RAD_BF16,{2,3,128});long long rows=0;
+    t.stride[0]=512;
+    req(r3di_rows_pitch(&t,128,&rows)<0,"nonuniform batch pitch accepted");
+    t.stride[0]=384;req(r3di_rows_pitch(&t,128,&rows)==128&&rows==6,"dense batch refused");
+    t=tensor(nullptr,RAD_BF16,{2,1,128});t.stride[0]=256;t.stride[1]=7;
+    req(r3di_rows_pitch(&t,128,&rows)==256&&rows==2,"singleton batch pitch lost");
+    puts("IQR_MERGE_AUDIT_PASS");
+}
