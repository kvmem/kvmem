diff --git a/libr3diqr/r3di_wmma.h b/libr3diqr/r3di_wmma.h
new file mode 100644
--- /dev/null
+++ b/libr3diqr/r3di_wmma.h
@@ -0,0 +1,63 @@
+// RDNA3 adaptation of libr4d/r4d_fp8_wmma.h's int8 fragment interface.
+// Keep the stored 8-byte-per-half fragment plane; replicate its two halves into
+// gfx11's four-VGPR inputs. Accumulators stay in native interleaved row order
+// until the final store. This header deliberately exposes no FP8 instruction.
+#pragma once
+#include "r3di_device.h"
+#include "r3di_fp8_frag.h"
+namespace r3di_fp8 {
+typedef int i2v __attribute__((ext_vector_type(2)));
+typedef int i4v __attribute__((ext_vector_type(4)));
+typedef int i8v __attribute__((ext_vector_type(8)));
+typedef float f8v __attribute__((ext_vector_type(8)));
+constexpr uint32_t kK=16;
+__device__ inline f8v acc_zero(){return f8v{0,0,0,0,0,0,0,0};}
+__device__ inline uint32_t frag_c(uint32_t lane){return lane&15u;}
+__device__ inline uint32_t frag_k0(uint32_t lane){return (lane>>4)*8u;}
+// Output after contiguous_acc; the compute accumulator is deliberately different.
+__device__ inline uint32_t acc_row(uint32_t lane,uint32_t j){return (lane>>4)*8u+j;}
+template<bool I8>
+__device__ inline f8v mma8(i2v a,i2v b,f8v c){
+    static_assert(I8,"RDNA3 IQR uses native int8 WMMA");
+    const int lane=threadIdx.x&31,lo=lane&15,hi=lo+16;
+    i4v aa={__shfl(a[0],lo),__shfl(a[1],lo),__shfl(a[0],hi),__shfl(a[1],hi)};
+    i4v bb={__shfl(b[0],lo),__shfl(b[1],lo),__shfl(b[0],hi),__shfl(b[1],hi)};
+    return __builtin_bit_cast(f8v,__builtin_amdgcn_wmma_i32_16x16x16_iu8_w32(
+        true,aa,true,bb,__builtin_bit_cast(i8v,c),false));
+}
+template<bool I8> __device__ inline float acc_val(float x){
+    if constexpr(I8)return (float)__builtin_bit_cast(int,x);else return x;
+}
+__device__ inline f8v contiguous_acc(f8v x,uint32_t lane){
+    f8v y;
+#pragma unroll
+    for(int j=0;j<8;++j){
+        const int from=(lane&15u)+16*(j&1);
+        float low=__shfl(x[j/2],from),high=__shfl(x[4+j/2],from);
+        y[j]=(lane&16u)?high:low;
+    }
+    return y;
+}
+template<uint32_t FK> __device__ constexpr uint32_t lds_pitch(){return FK+8;}
+template<uint32_t FK>
+__device__ inline i2v frag(const uint8_t* lds,uint32_t row0,uint32_t k0,uint32_t lane){
+    uint2 v=*(const uint2*)(lds+(row0+frag_c(lane))*lds_pitch<FK>()+k0+frag_k0(lane));
+    return i2v{(int)v.x,(int)v.y};
+}
+struct Stage8{uint4 v,w;};
+__device__ inline i2v frag_of(const Stage8& s,uint32_t t){
+    uint2 g[4]={make_uint2(s.v.x,s.v.y),make_uint2(s.v.z,s.v.w),make_uint2(s.w.x,s.w.y),make_uint2(s.w.z,s.w.w)};
+    return i2v{(int)g[t].x,(int)g[t].y};
+}
+__device__ inline Stage8 stage8_load(const uint8_t* p,bool live){
+    return live?Stage8{*(const uint4*)p,*(const uint4*)(p+16)}:Stage8{};
+}
+template<uint32_t FK> __device__ inline void stage8_store(uint8_t* p,uint32_t row,uint32_t k,Stage8 s){
+    uint2 g[4]={make_uint2(s.v.x,s.v.y),make_uint2(s.v.z,s.v.w),make_uint2(s.w.x,s.w.y),make_uint2(s.w.z,s.w.w)};
+#pragma unroll
+    for(int j=0;j<4;++j)*(uint2*)(p+row*lds_pitch<FK>()+k+j*8)=g[j];
+}
+__device__ inline uint32_t bf16x2_rne(float a,float b){return (uint32_t)r3di_bf16(a)|((uint32_t)r3di_bf16(b)<<16);}
+// Preserve full HIP ordering first; a gfx11 LDS-only fence can be tuned separately.
+__device__ inline void lds_barrier(){__syncthreads();}
+}
diff --git a/libr3diqr/w2_bench.inc b/libr3diqr/w2_bench.inc
new file mode 100644
--- /dev/null
+++ b/libr3diqr/w2_bench.inc
@@ -0,0 +1,50 @@
+void w2_benchmark(HMODULE dll) {
+    using Raw=int(*)(int64_t,int64_t,int64_t,int64_t,int64_t,int64_t,int,int,int,int,int,int,int,int64_t);
+    Raw fn[]={sym<Raw>(dll,"r3d_gemm_nt_q_w2a8_dot2"),sym<Raw>(dll,"r3d_gemm_nt_q_w2a8")};
+    const int N=248320,K=5120,G=K/128;
+    std::vector<uint8_t> w((size_t)N*K/4),z(N*G);std::vector<uint16_t> scales(N*G);
+    for(auto& v:w)v=uint8_t(rng());for(auto& v:z)v=rng()%4;
+    for(auto& v:scales)v=rad_f32_to_f16((1+rng()%7)/256.0f);
+    RadEncoding enc{};rad_enc_copy_str(enc.scheme,"affine");enc.n_planes=3;
+    const char* roles[]={"codes","scale","zero"};uint32_t dt[]={RAD_U2,RAD_F16,RAD_U8};
+    for(int i=0;i<3;++i){rad_enc_copy_str(enc.plane[i].role,roles[i]);enc.plane[i].dtype=dt[i];enc.plane[i].kind=RAD_PLANE_TILED;enc.plane[i].block[0]=1;enc.plane[i].block[1]=i?128:1;}
+    int sel[]={1,2};RadTensor planes[]={tensor(scales.data(),RAD_F16,{N,G}),tensor(z.data(),RAD_U8,{N,G})};RadPlanesEntry ent[2];
+    int64_t bytes=rad_planes_plan(&enc,sel,planes,2,ent);req(bytes>0,"bench U2 plan");std::vector<uint8_t> joined(bytes);
+    rc(rad_planes_relayout(&enc,sel,planes,2,joined.data(),bytes),"bench U2 planes");
+    Dev d;auto dw=d.put(w.size(),w.data()),ds=d.put(joined.size(),joined.data());
+    hipStream_t stream;hc(hipStreamCreateWithFlags(&stream,hipStreamNonBlocking));
+    hipEvent_t begin,end;hc(hipEventCreate(&begin));hc(hipEventCreate(&end));
+    for(int M:{1,8,16}){
+        std::vector<int8_t> x(M*K);std::vector<float> as(M,1.0f/128),sum(G*16);
+        for(auto& v:x)v=int(rng()%255)-127;
+        for(int m=0;m<M;++m)for(int k=0;k<K;++k)sum[k/128*16+m]+=x[m*K+((k&~12)|((k&4)<<1)|((k&8)>>1))];
+        Dev a;auto dx=a.put(x.size(),x.data()),da=a.put(as.size()*4,as.data()),du=a.put(sum.size()*4,sum.data()),dy=a.put((size_t)M*N*2);
+        // Dev::put zeroes dy on the default stream. A nonblocking test stream
+        // must not race that memset and have its first measured output erased.
+        hc(hipDeviceSynchronize());
+        auto launch=[&](int i){rc(fn[i]((int64_t)dx,(int64_t)da,(int64_t)dw,(int64_t)ds,(int64_t)du,(int64_t)dy,M,N,K,128,K,N,0,(int64_t)stream),"U2 bench");};
+        std::vector<uint16_t> old(M*N),now(M*N);
+        for(int i=0;i<2;++i){for(int rep=0;rep<4;++rep)launch(i);hc(hipStreamSynchronize(stream));hc(hipMemcpy((i?now:old).data(),dy,(size_t)M*N*2,hipMemcpyDeviceToHost));}
+        double err=0,norm=0;size_t differences=0;
+        for(size_t i=0;i<old.size();++i){double v=fl(old[i]),u=fl(now[i]);req(std::isfinite(u),"U2 bench nonfinite");err+=(v-u)*(v-u);norm+=v*v;differences+=old[i]!=now[i];}
+        printf("W2_COMPARE M%d rel=%.9g differences=%zu norm=%.9g error=%.9g first_old=%g first_new=%g\n",M,std::sqrt(err/std::max(norm,1e-30)),differences,norm,err,fl(old[0]),fl(now[0]));
+        req(std::sqrt(err/std::max(norm,1e-30))<.007,"U2 large shape disagreement");
+        for(int m=0;m<M;++m)for(int r=0;r<32;++r){
+            int n=(int)((int64_t)r*(N-1)/31);float expected=0;
+            for(int g=0;g<G;++g){int dot=0;for(int k=g*128;k<(g+1)*128;++k){
+                int pos=(k&~12)|((k&4)<<1)|((k&8)>>1);
+                dot+=int(x[m*K+pos])*((w[(size_t)n*K/4+k/4]>>(2*(k&3)))&3);}
+                float sub=float(dot)-float(z[n*G+g])*sum[g*16+m];
+                expected+=(sub*as[m])*rad_f16_to_f32(scales[n*G+g]);}
+            if(now[(size_t)m*N+n]!=bf(expected))printf("W2_SAMPLE row%d col%d old%g new%g expected%g\n",m,n,fl(old[(size_t)m*N+n]),fl(now[(size_t)m*N+n]),fl(bf(expected)));
+            req(now[(size_t)m*N+n]==bf(expected),"U2 full-vocab sampled CPU mismatch");
+        }
+        std::vector<float> timings[2];
+        for(int rep=0;rep<7;++rep)for(int turn=0;turn<2;++turn){int i=(rep+turn)&1;
+            hc(hipEventRecord(begin,stream));for(int k=0;k<8;++k)launch(i);hc(hipEventRecord(end,stream));hc(hipEventSynchronize(end));float ms;hc(hipEventElapsedTime(&ms,begin,end));timings[i].push_back(ms/8);}
+        for(auto& t:timings)std::sort(t.begin(),t.end());
+        printf("W2_BENCH M%d N%d K%d dot2_ms=%.6f wmma_ms=%.6f speedup=%.4f different_bf16=%zu relative_l2=%.9g\n",M,N,K,timings[0][3],timings[1][3],timings[0][3]/timings[1][3],differences,std::sqrt(err/std::max(norm,1e-30)));fflush(stdout);
+    }
+    hc(hipEventDestroy(begin));hc(hipEventDestroy(end));hc(hipStreamDestroy(stream));
+    puts("W2_BENCH_PASS");
+}
diff --git a/libr3diqr/windows_host_test.cpp b/libr3diqr/windows_host_test.cpp
new file mode 100644
--- /dev/null
+++ b/libr3diqr/windows_host_test.cpp
@@ -0,0 +1,51 @@
+// Focused checks for the Windows boundaries changed during this ABI39 port.
+#include "device/device.h"
+#include "platform/file.h"
+#include "util/json.h"
+#include <windows.h>
+#include <winioctl.h>
+#include <algorithm>
+#include <array>
+#include <atomic>
+#include <cstdio>
+#include <filesystem>
+#include <stdexcept>
+#include <thread>
+#include <vector>
+void need(bool v,const char* s){if(!v)throw std::runtime_error(s);}
+int main(){try {
+ auto* h=rad::host_backend();need(h&&h->set(0)==RAD_OK,"host backend");
+ const int64_t g=h->vmem_granularity();need(g>=65536,"virtual-memory granule");
+ int64_t before=0,after=0;need(h->vram_used(0,&before)==RAD_OK,"accounting read");
+ auto* a=(uint8_t*)h->vmem_reserve(2*g,g);auto* b=(uint8_t*)h->vmem_reserve(g,g);
+ need(a&&b&&(uintptr_t)a%g==0&&(uintptr_t)b%g==0,"aligned reservations");
+ need(h->vmem_commit_units(a,g,g)==RAD_OK&&h->vmem_commit_host(b,g)==RAD_OK,"commit kinds");
+ std::fill(a,a+g,0x31);std::fill(b,b+g,0x92);
+ need(h->vmem_swap(a,b,g)==RAD_OK,"swap");
+ need(std::all_of(a,a+g,[](uint8_t x){return x==0x92;})&&std::all_of(b,b+g,[](uint8_t x){return x==0x31;}),"swap bytes");
+ need(h->vmem_swap(a,a+g/2,g)==RAD_E_INVAL,"overlap rejection");
+ need(h->vmem_decommit(a,g)==RAD_OK&&h->vmem_decommit(b,g)==RAD_OK,"decommit");
+ need(h->vmem_commit_units(a+g,g,g)==RAD_OK,"second subrange commit");a[g]=41;
+ need(h->vmem_decommit(a+g,g)==RAD_OK,"subrange decommit");
+ h->vmem_release(a,2*g);h->vmem_release(b,g);
+ need(h->vram_used(0,&after)==RAD_OK&&after==before,"accounting restored");
+ puts("PASS Windows virtual-memory alignment, subranges, swap, kinds and accounting");
+ const std::string path="windows-host-"+std::to_string(GetCurrentProcessId())+"-io.tmp";
+ {rad::platform::File f;std::string err;
+ need(f.open(path,rad::platform::File::Read|rad::platform::File::Write|rad::platform::File::Create|rad::platform::File::Truncate,&err),"file open");
+ DWORD got=0;need(DeviceIoControl((HANDLE)f.native_handle(),FSCTL_SET_SPARSE,nullptr,0,nullptr,0,&got,nullptr)!=0,"sparse test file");
+ const int64_t off=(1ll<<32)+12345;std::array<uint8_t,257> data{};for(int i=0;i<257;++i)data[i]=(uint8_t)(i*13);
+ need(f.write_at(data.data(),data.size(),off)==257&&f.flush(),"64-bit positioned write");
+ need(f.size()==off+257,"64-bit file size");std::atomic<bool> ok{true};std::vector<std::thread> workers;
+ for(int t=0;t<4;++t)workers.emplace_back([&]{for(int k=0;k<100;++k){std::array<uint8_t,257> buf{};if(f.read_at(buf.data(),buf.size(),off)!=257||buf!=data)ok=false;}});
+ for(auto& w:workers)w.join();need(ok,"concurrent positional reads");
+ rad::platform::FileView v;need(v.open(f,off,257)&&std::equal(data.begin(),data.end(),v.data()),"unaligned 64-bit mapping");v.close();
+ std::array<uint8_t,512> tail{};need(f.read_at(tail.data(),512,off)==257&&f.read_at(tail.data(),1,off+257)==0,"short read and EOF");
+ need(f.read_at(tail.data(),1,-1)<0&&!v.open(f,off+256,2),"invalid spans");
+ }
+ need(std::filesystem::remove(path),"remove own test file");puts("PASS Windows >4GiB file offsets, concurrent reads, mapping, EOF and bounds");
+ const int64_t lo=INT64_MIN+19;const uint64_t hi=UINT64_MAX-37;
+ rad::Json j=rad::Json::object();j["s"]=lo;j["u"]=hi;j["l"]=(long)-2147483647;j["ul"]=(unsigned long)4294967295u;
+ auto p=rad::Json::parse(j.dump());need(p["s"].get<int64_t>()==lo&&p["u"].get<uint64_t>()==hi&&p["l"].get<long>()==-2147483647&&p["ul"].get<unsigned long>()==4294967295u,"LLP64 JSON integer round trip");
+ puts("PASS LLP64 JSON signed/unsigned integer round trip");puts("WINDOWS_HOST_QUALIFICATION_PASS");return 0;
+ }catch(const std::exception& e){fprintf(stderr,"FAIL: %s\n",e.what());return 1;}}
