+/* r3di_args.h -- how a libr3di entry point reads its arguments.
+ *
+ * There is no adapter layer. An entry point takes `(const RadArgs*, RadStream)` and returns a
+ * status, the same RadLaunchFn contract every other plugin implements; an out-of-tree author can
+ * write the same kernel without an adapter they could not reach.
+ *
+ * This header holds the shared helpers: reading a parameter, finding an operand, testing
+ * contiguity. Most are one line over rad_abi.h.
+ *
+ * Nothing here includes r3di.h or HIP: host translation units (the row table, the layouts, the
+ * shape hooks) include it too, so those tables compile and can be checked without ROCm.
+ */
+#ifndef R3DI_ARGS_H
+#define R3DI_ARGS_H
+
+#include "rad_abi.h"
+#include "rad_plugin.h"
+
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+
+/* ================================================================== parameter access
+ *
+ * Forwards to rad_abi.h's static inline helpers, the ones a third-party plugin gets, keeping
+ * libr3di's spelling at its call sites. */
+static inline int r3di_geti(const RadArgs* a, const char* k, long long* out) {
+    return rad_args_geti(a, k, out);
+}
+
+static inline long long r3di_geti_or(const RadArgs* a, const char* k, long long dflt) {
+    return rad_args_geti_or(a, k, dflt);
+}
+
+static inline const char* r3di_gets(const RadArgs* a, const char* k) {
+    return rad_args_gets(a, k);
+}
+
+/* A float parameter is RAD_P_F64 (rad_types.h, docs/OPS.md "The four rules"), so `dval` arrives
+ * and the step path runs no strtod. Deliberately laxer than rad_args_getf_or: string and integer
+ * spellings are still read, because a tool or selftest may call a launch directly with no declare
+ * to enforce the type. */
+static inline double r3di_getf(const RadArgs* a, const char* k, double dflt) {
+    if (!a || !k) return dflt;
+    for (int i = 0; i < a->n_p; ++i) {
+        if (!a->p[i].key || std::strcmp(a->p[i].key, k) != 0) continue;
+        if (a->p[i].kind == RAD_P_F64) return a->p[i].dval;
+        if (a->p[i].kind == RAD_P_INT) return (double)a->p[i].ival;
+        if (a->p[i].kind == RAD_P_STR && a->p[i].sval && a->p[i].sval[0]) {
+            char* end = nullptr;
+            const double v = std::strtod(a->p[i].sval, &end);
+            return (end && end != a->p[i].sval) ? v : dflt;
+        }
+        return dflt;
+    }
+    return dflt;
+}
+
+/* An enumerated parameter: `act` is "silu" or "sigmoid", not 0 or 1, so a --debug-graph dump says
+ * what runs; the mapping to libr3di's integer lives in the shim. Returns -1 for an unknown name,
+ * which every caller turns into RAD_E_INVAL. `alt` is libr3di's own integer spelling of the same
+ * key (`mode` on gated_had_quant_i8), consulted only when the name is absent. */
+static inline int r3di_act_code(const RadArgs* a, const char* key, const char* alt, int dflt) {
+    if (const char* s = r3di_gets(a, key)) {
+        if (!std::strcmp(s, "silu") || !std::strcmp(s, "swish")) return 0;
+        if (!std::strcmp(s, "sigmoid")) return 1;
+        return -1;
+    }
+    long long v = 0;
+    if (alt && r3di_geti(a, alt, &v)) return (v == 0 || v == 1) ? (int)v : -1;
+    return dflt;
+}
+
+/* Same, off a bare RadParam list (init() and the layout hooks); forwards to rad_plugin.h's
+ * rad_param_*. */
+static inline long long r3di_pgeti_or(const RadParam* p, int n_p, const char* k, long long dflt) {
+    return rad_param_geti(p, n_p, k, dflt);
+}
+
+static inline const char* r3di_pgets(const RadParam* p, int n_p, const char* k) {
+    return rad_param_gets(p, n_p, k, nullptr);
+}
+
+/* ================================================================== operand access
+ *
+ * An absent optional operand is a null RadTensor.data (rad_abi.h). r3di_opt() returns null both
+ * past the end and for a present-but-null operand, so an optional test is one pointer test. For a
+ * required operand the caller turns null into RAD_E_INVAL: it is a bug in the issue, not a shape
+ * the kernel declines.
+ */
+static inline const RadTensor* r3di_opt(const RadArgs* a, int i) { return rad_arg_in(a, i); }
+
+static inline const void* r3di_p(const RadTensor* t) { return t ? t->data : nullptr; }
+
+/* The same for an operand a kernel writes, so an output cast reads as one rather than as a
+ * pointer laundered through `long`. */
+static inline void* r3di_wp(const RadTensor* t) { return t ? t->data : nullptr; }
+static inline intptr_t r3di_addr(const RadTensor* t) { return t ? (intptr_t)t->data : 0L; }
+
+static inline long long r3di_dim(const RadTensor* t, int i) {
+    if (!t || i < 0 || (uint32_t)i >= t->rank) return 0;
+    return t->shape[i];
+}
+
+static inline long long r3di_stride(const RadTensor* t, int i) {
+    if (!t || i < 0 || (uint32_t)i >= t->rank) return 0;
+    return t->stride[i];
+}
+
+static inline long long r3di_numel(const RadTensor* t) { return rad_tensor_numel(t); }
+
+/* [rows..., K] flattened to (M, K). Every per-row kernel in libr3di owns whole rows (one
+ * workgroup per row), so the leading axes are only a row count. The GEMM makes the same fold
+ * explicitly (see gemm_ops). */
+
+static inline int r3di_rows_of(const RadTensor* t, long long* M, long long* K) {
+    if (!t || t->rank < 1) return RAD_E_SHAPE;
+    *K = t->shape[t->rank - 1];
+    *M = 1;
+    for (uint32_t i = 0; i + 1 < t->rank; ++i) *M *= t->shape[i];
+    return (*M >= 1 && *K >= 1) ? RAD_OK : RAD_E_SHAPE;
+}
+
+/* Dense row-major over the whole tensor. libr3di's entry points take at most one pitch, so
+ * everything else must be tight, and the shim checks it. This is the "necessary condition only"
+ * boundary of spec §2.1: the constraint table settles geometry, contiguity is a property of the
+ * call. */
+static inline int r3di_contig(const RadTensor* t) { return rad_tensor_is_contiguous(t); }
+
+/* Contiguous in every axis but the leading one, whose stride is the row pitch libr3di takes as an
+ * explicit argument (`xpitch`, `a_stride`, `xrow`, ...). Returns the pitch in elements, or -1. */
+static inline long long r3di_row_pitch(const RadTensor* t) {
+    if (!t || t->rank == 0) return -1;
+    if (t->rank == 1) return 1;
+    long long acc = 1;
+    for (int i = (int)t->rank - 1; i >= 1; --i) {
+        if (t->shape[i] != 1 && t->stride[i] != acc) return -1;
+        acc *= t->shape[i];
+    }
+    return t->stride[0];
+}
+
+/* [rows..., n] read as (rows, n): the leading axes are a row count and only the last is
+ * structural. Returns the pitch in elements, or -1.
+ *
+ * A column slice must refuse. k out of a fused [tok, 2*kv_dim] projection, read as
+ * [tok*n_head_kv, head_dim] for a per-head norm, has rows `n` apart within a token and a buffer
+ * row apart between tokens; no single pitch describes that, and the leading stride would make the
+ * consumer read most heads from garbage. So the trailing axes must cover the whole row. */
+static inline long long r3di_rows_pitch(const RadTensor* t, long long n, long long* rows) {
+    if (!t || t->rank < 1 || n <= 0) return -1;
+    const long long nel = rad_tensor_numel(t);
+    if (nel % n) return -1;
+    *rows = nel / n;
+    if (t->rank == 1) return n;
+    if (t->shape[t->rank - 1] == n) {
+        if (t->stride[t->rank - 1] != 1) return -1;
+        // Flattening leading axes is legal only when every non-singleton
+        // axis advances by the same row pitch. A padded batch is not one
+        // uniformly pitched row array, even if its innermost rows are dense.
+        long long pitch = n, span = 1;
+        bool have_pitch = false;
+        for (int i = (int)t->rank - 2; i >= 0; --i) {
+            if (t->shape[i] == 1) continue;
+            if (!have_pitch) { pitch = t->stride[i]; have_pitch = true; }
+            if (t->stride[i] != pitch * span) return -1;
+            span *= t->shape[i];
+        }
+        return pitch;
+    }
+    if (rad_tensor_is_contiguous(t)) return n;
+    long long trail = 1;
+    for (int i = 1; i < (int)t->rank; ++i) trail *= t->shape[i];
+    return trail == n ? r3di_row_pitch(t) : -1;
+}
+
+/* An attention operand, [tokens, heads * head_dim] over its trailing axes: the token count, head
+ * count and row pitch in elements. False when the trailing axes are not whole heads or no single
+ * pitch describes the rows. */
+static inline bool r3di_head_rows(const RadTensor* t, long long head_dim, long long* n_tok,
+                                 long long* n_head, long long* ld) {
+    long long width = 1;
+    for (uint32_t i = 1; i < t->rank; ++i) width *= t->shape[i];
+    if (t->rank < 2 || width % head_dim) return false;
+    *n_head = width / head_dim;
+    *ld = r3di_rows_pitch(t, width, n_tok);
+    return *ld >= 0;
+}
+
+/* 16-byte alignment, needed by every kernel that pushes over P2P or issues a global_load_b128.
+ * The kernels do not check it, so the shim does. */
+static inline int r3di_aligned(const void* p, unsigned bytes) {
+    return p ? (((uintptr_t)p & (uintptr_t)(bytes - 1)) == 0) : 1;
+}
+
+/* ================================================================== which check refused
+ *
+ * A shim refuses in many places with the same few codes, so the engine's report names the kernel
+ * and geometry but not the failing condition. R3DI_NO() wraps a refusal and prints its own line
+ * when RAD_R3DI_TRACE is set; otherwise it is the bare return plus one cached-flag load on a path
+ * that is failing anyway. */
+static inline int r3di_trace_on(void) {
+    static int on = -1;
+    if (on < 0) { const char* e = std::getenv("RAD_R3DI_TRACE"); on = (e && *e && *e != '0'); }
+    return on;
+}
+static inline int r3di_refused(int code, const char* file, int line) {
+    if (r3di_trace_on()) std::fprintf(stderr, "[r3di] %s:%d refused -> %d\n", file, line, code);
+    return code;
+}
+#define R3DI_NO(code) r3di_refused((code), __FILE__, __LINE__)
+
+/* ================================================================== dtype helpers */
+/* Widest world any libr3di all-reduce serves, fixed by the 8-rank entry points' argument lists
+ * (seven explicit peers). */
+enum { R3DI_MAX_RANKS = 8, R3DI_MAX_PEERS = 7 };
+
+/* libr3di's all-reduce dtype code: 0 bf16, 1 fp16, 2 fp32. Returns -1 for anything else. */
+static inline int r3di_ar_dtype_code(const char* s) {
+    if (!s) return -1;
+    if (!std::strcmp(s, "bf16")) return 0;
+    if (!std::strcmp(s, "fp16") || !std::strcmp(s, "f16")) return 1;
+    if (!std::strcmp(s, "fp32") || !std::strcmp(s, "f32")) return 2;
+    return -1;
+}
+
+static inline int r3di_ar_esize(int code) { return code == 2 ? 4 : 2; }
+
+
+/* ================================================================== weight layout constants
+ *
+ * libr3di's compile-time constants, restated because r3di_layout.cpp is host code built without
+ * ROCm and cannot include r3di.h, and because the .rad container records them in the layout tag.
+ * r3di_gemm_args.h static_asserts the group constants against libr3di's macros.
+ */
+enum {
+    R3DI_W4_GROUP = 128,   /* K per (scale, zero) dword; libr3di R3DI_GEMM_W4_GROUP  */
+    R3DI_W4_KPB   = 64,    /* K per packed block: 4 k steps, 16 bytes per lane     */
+    R3DI_W8_GROUP = 128,   /* libr3di R3DI_GEMM_W8_GROUP and R3DI_GEMM_W8A8_GROUP     */
+    R3DI_W8_KPB   = 32,    /* K per packed block: 2 k steps, 16 bytes per lane     */
+    R3DI_W2_GROUP = 128,   /* libr3di R3DI_GEMM_W2A8_GROUP                           */
+    R3DI_MXFP4_GROUP = 32, /* K per E8M0 exponent, fixed by the OCP MX format      */
+    /* The block-scaled fp8 family's block, on both axes. Not a quantiser choice: it is the
+     * checkpoint's `quantization_config.weight_block_size`, and the bytes on disk follow it. It
+     * cannot be static_asserted against `r3di_gemm_fp8a8_block()` (a function, not a macro), so
+     * r3di_gemm_fp8a8.hip checks it at launch. */
+    R3DI_FP8_BLOCK = 128,
+    /* IQR's 8-bit format (IQ8R): int8 codes rotated 128 wide, one bf16 scale per row per 256 of K
+     * against an int8 activation with one f32 scale per (token, 256). Twice the int8 block, so a
+     * fold covers two 128-wide rotation blocks. */
+    R3DI_I8_GROUP_WIDE = 256,
+    R3DI_WAVE     = 32,
+    R3DI_NTILE    = 16     /* output rows per WMMA n-tile                          */
+};
+
+/* Plugin-private dtypes. The core never interprets these: rad_types.h reserves everything at or
+ * above RAD_DT_PLUGIN_BASE for this, and the layout hook sizes them. */
+enum {
+    R3DI_DT_W4_FRAG    = RAD_DT_PLUGIN_BASE + 0,  /* 4-bit codes in WMMA fragment order      */
+    R3DI_DT_W4_SZ      = RAD_DT_PLUGIN_BASE + 1,  /* (f16 scale, f16 -(1024+zero)) dwords    */
+    R3DI_DT_W8_FRAG    = RAD_DT_PLUGIN_BASE + 2,  /* 8-bit codes in the same fragment order  */
+    R3DI_DT_W8_S       = RAD_DT_PLUGIN_BASE + 3,  /* f16-only scale plane (w8a8)             */
+    R3DI_DT_W2_FRAG    = RAD_DT_PLUGIN_BASE + 4,
+    R3DI_DT_MXFP4_FRAG = RAD_DT_PLUGIN_BASE + 5,
+    R3DI_DT_E8M0       = RAD_DT_PLUGIN_BASE + 6,  /* [K/32][N] shared exponents, and Wref[N]  */
+    /* The grouped MoE GEMM's 4-bit expert weight. I4 at per-128 BF16 scales uses 16-column/64-K
+     * fragment tiles for coalesced register loads and the staged kernels' row-segment gather.
+     * Subgroup-scaled codebooks keep row-major packed nibbles. Both use an exact E4M3 table; the layout
+     * tag distinguishes their storage from each other and R3DI_DT_W4_FRAG. See r3di_layout.cpp. */
+    R3DI_DT_MOEW4      = RAD_DT_PLUGIN_BASE + 7,
+    /* The same GEMM's 5-bit expert weight: per row, the codebook layout's nibble plane of the
+     * codes' low four bits (the magnitude), then the sign bits, one dword per 32 elements in the order the
+     * kernel merges them (r3di_layout.cpp, moew5_row). A row is 5K/8 bytes. */
+    R3DI_DT_MOEW5      = RAD_DT_PLUGIN_BASE + 8,
+    /* The M2XFP4 GEMMs' stored weight: R3DI_DT_MXFP4_FRAG's fragment-order e2m1 codes, then the
+     * [K/32][N] meta plane the kernel reads beside the E8M0 exponents (r3di_layout.cpp, m2xfp4). */
+    R3DI_DT_M2XFP4_FRAG = RAD_DT_PLUGIN_BASE + 9
+};
+
+/* The grouped MoE GEMM's code tables, as the four dwords w4_e4m3's byte permutes read
+ * (r3di_moe.hip): entries 0..3, 4..7, 8..11 and 12..15, one E4M3 byte an entry, lowest entry in the
+ * low byte. `w4a8` and `w4a8h` decode a two's complement nibble, -8..7. `w4nla8h` decodes
+ * libquant's `table=w4nl` (magnitudes ascending, then their negatives); kW4nlTable is that table
+ * as a container stores it, which the layout hook compares with the container's table plane
+ * before serving it. */
+static constexpr uint32_t kW4IntPerm[4] = { 0x44403800u, 0x4E4C4A48u, 0xCACCCED0u, 0xB8C0C4C8u };
+static constexpr uint32_t kW4nlPerm[4]  = { 0x504B4539u, 0x5B595653u, 0xD0CBC5B9u, 0xDBD9D6D3u };
+static constexpr float kW4nlTable[16] = { 1.125f, 3.25f, 5.5f, 8.0f, 11.0f, 14.0f, 18.0f, 22.0f,
+                                          -1.125f, -3.25f, -5.5f, -8.0f, -11.0f, -14.0f, -18.0f,
+                                          -22.0f };
+/* w4nl's magnitudes as the int8 levels an int8 activation's WMMA multiplies, in units of
+ * kW4nlI8Unit: the integer set under 128 with the least squared distance from the table at one
+ * unit, and that unit, both over the code histogram of Qwen3.8-Flash-Next's GPTQ experts (19, 18,
+ * 17, 16, 12, 9, 5 and 4 percent by ascending magnitude), where the weight read this way is 2.4e-3
+ * of the stored one away in relative L2. w4nl_i8_dword packs entries 4d..4d+3 of the sixteen (the
+ * magnitudes, then their negatives) as kW4nlPerm packs its E4M3 bytes. */
+static constexpr int8_t kW4nlI8[8] = { 6, 17, 29, 42, 58, 74, 95, 116 };
+static constexpr float kW4nlI8Unit = 0.18965f;
+static constexpr uint32_t w4nl_i8_dword(int d) {
+    uint32_t v = 0;
+    for (int i = 0; i < 4; ++i) {
+        const int e = 4 * d + i;
+        const int8_t l = (int8_t)(e < 8 ? kW4nlI8[e] : -kW4nlI8[e - 8]);
+        v |= (uint32_t)(uint8_t)l << (8 * i);
+    }
+    return v;
+}
+
+/* `w5nl64a8h` decodes libquant's `table=w5nl`: thirty-two levels, sixteen magnitudes ascending
+ * then their negatives, so a code's high bit is its sign and its low four bits index the
+ * magnitudes. The kernel expands the magnitude from kW5nlMagPerm (their E4M3 bytes in w4_e4m3's
+ * dword order) and sets the sign bit from the sign plane. Every level is exact in E4M3. */
+static constexpr uint32_t kW5nlMagPerm[4] = { 0x4B484235u, 0x5453514Fu, 0x5A595856u, 0x5F5D5C5Bu };
+static constexpr float kW5nlTable[32] = {
+    0.8125f, 2.5f, 4.0f, 5.5f, 7.5f, 9.0f, 11.0f, 12.0f,
+    14.0f, 16.0f, 18.0f, 20.0f, 22.0f, 24.0f, 26.0f, 30.0f,
+    -0.8125f, -2.5f, -4.0f, -5.5f, -7.5f, -9.0f, -11.0f, -12.0f,
+    -14.0f, -16.0f, -18.0f, -20.0f, -22.0f, -24.0f, -26.0f, -30.0f };
+
+/* The fixed second-level scale of `w4nl64a8h`, `w4nl32a8h` and `w5nl64a8h`: it multiplies a
+ * weight's per-(row, 64 or 32 of K) E4M3 scale. A container states it (libquant's scale2_value=),
+ * and the layout hook compares it with this before serving. Fixed rather than per row because the
+ * experts' scales (with the rotation's 1/128 folded in) lie between 2^-15 and 2^-10.6 on
+ * Qwen3.8-Flash-Next at group 64 (slightly lower at 32, half a binade lower for w5nl). Under
+ * 2^-13 each is a normal E4M3 value, and E4M3 has three mantissa bits in every binade. */
+static constexpr float kW4G64Scale = 0x1p-13f;
+
+
+/* ================================================================== skinny-GEMM variants
+ *
+ * libr3di's five skinny-GEMM knobs, exposed as RadVariant.config so `rad-tune` can walk them and
+ * `--debug-graph` can name the pick (spec §15). The best setting depends on (N, K) and the M band.
+ *
+ * sk == 0 means "choose the largest legal split count at issue". Split-K requires
+ * K % (SK * group) == 0, so no fixed default is legal at every shape, and an illegal default would
+ * make an untuned install fail rather than run slowly (spec §15). The sentinel is resolved in one
+ * place, r3di_gemm_args.h:pick_sk.
+ */
+struct R3diGemmCfg { int wv, sk, mb, npw, nt; };
+
+/* The tiled and prefill GEMMs take one opaque variant index into libr3di's own switch of compiled
+ * tile arms; the row's tunable lists the arms a tuner may pick (r3di_rows.cpp, kTileArms). */
+struct R3diTileCfg { int variant; int bm; int bn; };
+
+/* The MXFP4 tiled GEMM's column width in 32-column units per wave: TN=2 gives a 256 x 64 block,
+ * TN=4 a 256 x 128 one. The crossover depends on M (see r3di_gemm_mxfp4a8_tiled.hip), so 0, the
+ * default, decides at issue; a fixed value is for a tuner. */
+struct R3diMxTileCfg { int tn; };
+
+/* The int4/int5 x int8 tiled GEMM's tile arm (r3di_gemm_wpa8i8_tiled.hip, WPT_ARMS). Arm 0 is the
+ * prefill tile as it always ran; the others serve the decode band above the skinny kernel's 64 rows. */
+struct R3diWpaCfg { int arm; };
+
+/* The MXFP4 decode GEMM's split-K width, K slab and weight-load hint. 0 on each is the rule in
+ * r3di_gemm_mxfp4a8_decode.hip (it needs M and the shape, which exist only at issue); `nt` 1 streams
+ * the weight past L2/MALL, 2 loads it plainly. */
+struct R3diMxDecCfg { int ks; int bk; int nt; };
+
+/* Split-KV segment count for the paged decode kernels. 0 is libr3di's split law (table in
+ * r3di_attn_paged_h256_gqa6.hip), which needs num_seqs and max_ctx from the issue, so it stays the
+ * default; fixed counts are for a tuner. RadScratchFn gets the same variant index, so the arena
+ * is sized for what this picks. */
+struct R3diSplitCfg { int splits; };
+
+/* The all-reduce launch geometry, passed to libr3di as nblocks/nthreads/drain/acq (and `pub` at
+ * width). Defaults: nthreads=1024, drain=3 (s_wait_storecnt, which fine-grained uncached scratch
+ * requires), acq=0, pub=1, and nblocks scaled by message size and clamped; nblocks == 0 selects
+ * that rule. */
+struct R3diArCfg { int nblocks; int nthreads; int drain; int acq; int pub; };
+
+/* rowtopk: RC is how many candidates a chunk keeps (>= R), NCH the requested chunk width (libr3di
+ * rounds it up to a multiple of eight columns, so the scratch hook asks r3di_rowtopk_bf16_chunks()
+ * for the real one), PT1 the stage-1 thread count. */
+struct R3diTopkCfg { int rc; int nch; int pt1; };
+
+/* The block-scaled fp8 matvec's rows a wave. Blocking trades waves for memory-level parallelism,
+ * so the best value depends on whether the kernel waits on loads or the ALU. The default rule is
+ * fitted to the current inner loop: any change to it (scale load width, activation dtype)
+ * requires re-fitting. 0 selects that rule; other values pin it for rad-tune. */
+struct R3diMvCfg { int rb; };
+
+
+
+extern "C" {
+/* -- the tuned configuration (r3di_rows.cpp) --
+ *
+ * The core picked a point in the space the row declared and appended it to RadArgs::p. These read
+ * it back, falling to the axis's default (defined once, in the RadTunable table) when a caller
+ * supplied none, so a checker with no tuned key runs what an untuned install runs. They cannot
+ * fail: the loader refuses a plugin whose default is not one of the axis's values. */
+void r3di_cfg_gemm   (const RadArgs*, struct R3diGemmCfg*);
+void r3di_cfg_tiled  (const RadArgs*, struct R3diTileCfg*);
+void r3di_cfg_prefill(const RadArgs*, struct R3diTileCfg*);
+void r3di_cfg_mxfp4_tiled(const RadArgs*, struct R3diMxTileCfg*);
+void r3di_cfg_wpa8i8 (const RadArgs*, struct R3diWpaCfg*);
+void r3di_cfg_mxfp4_decode(const RadArgs*, struct R3diMxDecCfg*);
+void r3di_cfg_split  (const RadArgs*, struct R3diSplitCfg*);
+void r3di_cfg_ar     (const RadArgs*, struct R3diArCfg*);
+/* Whether the four-rank fused junction takes its tail form from 5 rows (the row's `tail` axis). */
+int  r3di_cfg_ar_tail(const RadArgs*);
+/* The four-rank exact one-shot's size, in elements, from which it takes the exact two-shot instead
+ * (0: never); the all-reduce rows' `ts_min` axis. */
+long r3di_cfg_ar_ts_min(const RadArgs*);
+/* The prefetch's workgroup count (the row's `nb` axis). */
+int  r3di_cfg_prefetch_nb(const RadArgs*);
+void r3di_cfg_topk   (const RadArgs*, struct R3diTopkCfg*);
+void r3di_cfg_mv     (const RadArgs*, struct R3diMvCfg*);
+/* rmsnorm_quant_i8's decode form: 1 the row's operands in registers before the reductions, 0 the
+ * pass-per-read kernel; the row's `reg` axis. */
+int  r3di_cfg_rmsq8_reg(const RadArgs*);
+
+}  /* extern "C" */
+
+#endif  /* R3DI_ARGS_H */
diff --git a/libr3diqr/r3di_device.h b/libr3diqr/r3di_device.h
new file mode 100644
--- /dev/null
+++ b/libr3diqr/r3di_device.h
@@ -0,0 +1,36 @@
+#pragma once
+#include <hip/hip_runtime.h>
+#include <cstdint>
+#include "rad_abi.h"
+// Emit through the HIP stream supplied by the Windows engine, with no allocation
+// or synchronization on the launch path.
+template<class K, class... A>
+inline int r3di_emit(RadStream s, K k, dim3 grid, dim3 block, size_t lds, A... args) {
+    void* argv[] = { (void*)&args... };
+    return hipLaunchKernel((const void*)k,grid,block,argv,lds,(hipStream_t)s)==hipSuccess
+        ? RAD_OK : RAD_E_DEVICE;
+}
+#define R3DI_EMIT(s,k,g,b,l,...) r3di_emit(s,k,g,b,l,__VA_ARGS__)
+__device__ inline uint16_t r3di_bf16(float x) {
+    uint32_t u=__float_as_uint(x);
+    return (uint16_t)((u+0x7fffu+((u>>16)&1u))>>16);
+}
+namespace r3di_fp8 {
+__device__ inline float bscale(uint32_t s) {return __uint_as_float(s<<16);}
+__device__ inline float e4m3(uint32_t b) {
+    uint32_t e=(b>>3)&15u,m=b&7u,sign=(b&128u)<<24;
+    float x=e?__uint_as_float(((e+120u)<<23)|(m<<20)):(float)m*(1.0f/512.0f);
+    return __uint_as_float(__float_as_uint(x)|sign);
+}
+}
+// Unnormalised FWHT, in the same ascending butterfly order as libref and
+// libquant. IQR's stored weight scale already includes the inverse transform.
+__device__ inline void r3di_hadamard(float (&v)[4], uint32_t lane) {
+    for(int h=1;h<4;h<<=1) for(int j=0;j<4;++j) if(!(j&h)) {
+        float a=v[j],b=v[j+h];v[j]=a+b;v[j+h]=a-b;
+    }
+    for(int h=1;h<32;h<<=1) for(int j=0;j<4;++j) {
+        float other=__shfl_xor(v[j],h,32);
+        v[j]=(lane&h)?other-v[j]:v[j]+other;
+    }
+}
diff --git a/libr3diqr/r3di_dflash.hip b/libr3diqr/r3di_dflash.hip
new file mode 100644
--- /dev/null
+++ b/libr3diqr/r3di_dflash.hip
@@ -0,0 +1,28 @@
+// Radiance v2 RDNA4's fused vectorized two-tap DFlash2 convolution, gfx11 launch.
+#include "r3di_device.h"
+#include "r3di_args.h"
+#include "r3di_dflash_conv_body.h"
+#include <climits>
+namespace {
+__global__ __launch_bounds__(128) void dflash_conv(const uint16_t* x,const uint16_t* d,
+    const uint16_t* b,uint16_t* y,int h,int pitch,int ng,int blockmask) {
+    r3di_dflash_conv_body<2,16>(x,d,b,y,h,pitch,ng,h/8,blockmask,blockIdx.y,blockIdx.x*128+threadIdx.x);
+}
+}
+extern "C" int r3di_dflash_conv(const RadArgs* a,RadStream stream) {
+    if(!a||r3di_geti_or(a,"chain",0))return RAD_E_INVAL;
+    auto x=r3di_opt(a,0),d=r3di_opt(a,1),b=r3di_opt(a,2),y=r3di_opt(a,3);
+    if(!x||!d||!b||!y)return RAD_E_INVAL;
+    if(x->dtype!=RAD_BF16||d->dtype!=RAD_BF16||b->dtype!=RAD_BF16||y->dtype!=RAD_BF16)return RAD_E_DTYPE;
+    if(x->rank!=2||d->rank<2||y->rank!=2)return RAD_E_SHAPE;
+    const int64_t t=x->shape[0],h=x->shape[1],ng=r3di_geti_or(a,"NG",0),bs=r3di_geti_or(a,"block_size",0);
+    if(t<1||t>65535||h<128||h>8388608||h%128||ng!=h/16||bs<1||bs>INT_MAX||(bs&(bs-1)))return RAD_E_SHAPE;
+    if(r3di_geti_or(a,"taps",0)!=2||r3di_geti_or(a,"group_size",0)!=16)return RAD_E_SHAPE;
+    if(y->shape[0]!=t||y->shape[1]!=h||d->shape[0]!=t||r3di_numel(d)!=t*2*ng||r3di_numel(b)!=2*h)return RAD_E_SHAPE;
+    if(!r3di_contig(x)||!r3di_contig(y)||!r3di_contig(b)||r3di_row_pitch(d)!=4*ng)return RAD_E_STRIDE;
+    if(!r3di_aligned(x->data,16)||!r3di_aligned(y->data,16)||!r3di_aligned(b->data,16)||!r3di_aligned(d->data,2))return RAD_E_ALIGN;
+    if(x->data==y->data)return RAD_E_INVAL;
+    return R3DI_EMIT(stream,dflash_conv,dim3((h/8+127)/128,t),dim3(128),0,
+        (const uint16_t*)x->data,(const uint16_t*)d->data,(const uint16_t*)b->data,(uint16_t*)y->data,
+        (int)h,(int)(4*ng),(int)ng,(int)bs-1);
+}
diff --git a/libr3diqr/r3di_dflash_conv_body.h b/libr3diqr/r3di_dflash_conv_body.h
new file mode 100644
--- /dev/null
+++ b/libr3diqr/r3di_dflash_conv_body.h
@@ -0,0 +1,101 @@
+// Ported from pinned Radiance v2 libr4d; preserve vectorized fused math.
+// DFlash2 grouped dynamic depthwise convolution -- device math only.
+//
+// Free of <hip/hip_runtime.h> so the same source compiles standalone to gfx1201 assembly with a
+// stock clang (no ROCm) for ISA review, as well as into libr4d.so.
+//
+// The op, per DFlash2's _grouped_conv with taps=2, group_size=16:
+//
+//   out[t,h] = (base[0,h] + delta[t,0,g]) * x[t,h]
+//            + (base[1,h] + delta[t,1,g]) * x[t-1,h] * ((t % block) >= 1)     g = h / group
+//
+// The reference uses ~6 [T,H] elementwise passes plus a materialised [T, taps, num_groups, group]
+// coefficient tensor; the fused form reads x, delta and base once and writes out once.
+#pragma once
+
+typedef unsigned int   r3di_u32;
+typedef unsigned short r3di_u16;
+typedef r3di_u32 r3di_u32x4 __attribute__((ext_vector_type(4)));
+
+// A 16-byte load addressed both ways. Subscript the union member, never a bit-cast vector:
+// bit-casting a vector subscript silently yields element 0's bits.
+union R3diV8 { r3di_u32x4 v; r3di_u16 h[8]; };
+
+// Device functions under hipcc; plain always-inline functions under a standalone amdgcn clang.
+#ifndef R3DI_DEV
+#ifdef __HIP__
+#define R3DI_DEV __device__ __forceinline__
+#else
+#define R3DI_DEV static __attribute__((always_inline))
+#endif
+#endif
+
+R3DI_DEV float r3di_bf2f(r3di_u16 v) {
+    return __builtin_bit_cast(float, (r3di_u32)v << 16);
+}
+
+// f32 -> bf16 RTNE in software: gfx1201 has no bf16 convert instruction.
+R3DI_DEV r3di_u16 r3di_f2bf(float f) {
+    r3di_u32 u = __builtin_bit_cast(r3di_u32, f);
+    return (r3di_u16)((u + 0x7fffu + ((u >> 16) & 1u)) >> 16);
+}
+
+// One thread owns 8 contiguous channels (one dwordx4 in and out). The group size (16) is a multiple
+// of 8, so the group index and both delta scalars are uniform per thread and loaded once.
+template <int TAPS, int GROUP>
+R3DI_DEV void r3di_dflash_conv_body(const r3di_u16* __restrict__ x,
+                                  const r3di_u16* __restrict__ delta,
+                                  const r3di_u16* __restrict__ base,
+                                  r3di_u16* __restrict__ out,
+                                  int H, int dpitch, int NG, int vpr,
+                                  int blockmask, int t, int hv) {
+    if (hv >= vpr) return;
+
+    // Split each address into a wave-uniform pointer and a 32-bit lane offset (gfx12 saddr form).
+    // Do not change either of these:
+    //   * The mask: the backend folds a lane offset into saddr only if it can prove the byte offset
+    //     fits 32 bits. Without it each load pays a 64-bit v_add_co_u32/v_add_co_ci_u32 pair;
+    //     __builtin_assume does not propagate here, the AND does.
+    //   * Pointer + offset, not a vector-typed array indexed by lane, which makes the backend
+    //     materialise a 64-bit address per pointer.
+    const unsigned off = ((unsigned)hv & 0xFFFFFu) * 8u;
+    const unsigned g   = off / (unsigned)GROUP;
+
+    const r3di_u16* __restrict__ xrow = x + (int64_t)t * H;
+    r3di_u16*       __restrict__ orow = out + (int64_t)t * H;
+    const r3di_u16* __restrict__ drow = delta + (int64_t)t * dpitch;
+
+    R3diV8 x0; x0.v = *(const r3di_u32x4*)(xrow + off);
+    R3diV8 b0; b0.v = *(const r3di_u32x4*)(base + off);
+    const float d0 = r3di_bf2f(drow[g]);
+
+    float acc[8];
+#pragma unroll
+    for (int j = 0; j < 8; ++j)
+        acc[j] = (r3di_bf2f(b0.h[j]) + d0) * r3di_bf2f(x0.h[j]);
+
+    // Tap `tap` contributes only where the position within the block is >= tap. t is the
+    // workgroup's y index, so this is a scalar branch and skipped rows issue no shifted load.
+#pragma unroll
+    for (int tap = 1; tap < TAPS; ++tap) {
+        // Same saddr rule: uniform terms go into the pointer (adding tap*NG to the delta index
+        // instead loses saddr). The pointers are formed outside the branch, because the backend
+        // does not fold them into saddr from inside it; an unused address costs nothing.
+        const r3di_u16* __restrict__ xprev = xrow - (int64_t)tap * H;
+        const r3di_u16* __restrict__ btap  = base + (int64_t)tap * H;
+        const r3di_u16* __restrict__ dtap  = drow + (int64_t)tap * NG;
+        if ((t & blockmask) >= tap) {
+            R3diV8 xs; xs.v = *(const r3di_u32x4*)(xprev + off);
+            R3diV8 bt; bt.v = *(const r3di_u32x4*)(btap + off);
+            const float dt = r3di_bf2f(dtap[g]);
+#pragma unroll
+            for (int j = 0; j < 8; ++j)
+                acc[j] += (r3di_bf2f(bt.h[j]) + dt) * r3di_bf2f(xs.h[j]);
+        }
+    }
+
+    R3diV8 o;
+#pragma unroll
+    for (int j = 0; j < 8; ++j) o.h[j] = r3di_f2bf(acc[j]);
+    *(r3di_u32x4*)(orow + off) = o.v;
+}
diff --git a/libr3diqr/r3di_enc.h b/libr3diqr/r3di_enc.h
new file mode 100644
--- /dev/null
+++ b/libr3diqr/r3di_enc.h
@@ -0,0 +1,96 @@
+/* r3di_enc.h -- the encoding checks libr3di's relayouts make before rearranging a weight.
+ *
+ * A relayout that rearranged an encoding its kernel does not read would hand the kernel bytes
+ * that decode to other numbers; the layout hook refuses such a declaration by name instead. Pure
+ * host C++, like the rest of the declaration side.
+ */
+#pragma once
+#include "rad_abi.h"
+
+#include <cstring>
+
+namespace r3di_enc {
+
+/* The affine encoding a kernel reads: `codes`, a `scale` of dtype `scale` over [br x bc], an
+ * integer zero of dtype `zero` when `zero` is not RAD_DT_INVALID, `transform` exactly ("" for
+ * none), and no other plane. */
+inline bool affine(const RadEncoding* e, uint32_t codes, uint32_t scale, int64_t br, int64_t bc,
+                   uint32_t zero = RAD_DT_INVALID, const char* transform = "") {
+    if (!e || !rad_enc_is(e, "affine")) return false;
+    if (std::strncmp(e->transform, transform, RAD_ENC_STR) != 0) return false;
+    if (e->n_planes != (zero != RAD_DT_INVALID ? 3 : 2)) return false;
+    if (e->plane[0].dtype != codes || e->plane[0].block[1] != 1) return false;
+    const int s = rad_enc_find(e, "scale");
+    if (s < 0 || e->plane[s].dtype != scale || e->plane[s].kind != RAD_PLANE_TILED ||
+        e->plane[s].block[0] != br || e->plane[s].block[1] != bc) return false;
+    if (zero != RAD_DT_INVALID) {
+        const int z = rad_enc_find(e, "zero");
+        if (z < 0 || e->plane[z].dtype != zero || e->plane[z].block[0] != br ||
+            e->plane[z].block[1] != bc) return false;
+    }
+    return true;
+}
+
+/* The same with a scalar codebook: `codes` indexing a `table` plane of `entries` values of dtype
+ * `tab`, the `scale` as above, `transform` exactly, and no other plane. A declaration carries no
+ * plane bytes, so a kernel that decodes one fixed table compares the plane's contents at
+ * relayout. */
+inline bool affine_table(const RadEncoding* e, uint32_t codes, uint32_t scale, int64_t br,
+                         int64_t bc, uint32_t tab, int64_t entries, const char* transform = "") {
+    if (!e || !rad_enc_is(e, "affine")) return false;
+    if (std::strncmp(e->transform, transform, RAD_ENC_STR) != 0) return false;
+    if (e->n_planes != 3) return false;
+    if (e->plane[0].dtype != codes || e->plane[0].block[1] != 1) return false;
+    const int s = rad_enc_find(e, "scale");
+    if (s < 0 || e->plane[s].dtype != scale || e->plane[s].kind != RAD_PLANE_TILED ||
+        e->plane[s].block[0] != br || e->plane[s].block[1] != bc) return false;
+    const int t = rad_enc_find(e, "table");
+    return t >= 0 && e->plane[t].dtype == tab && e->plane[t].kind == RAD_PLANE_TABLE &&
+           e->plane[t].extent[0] == 1 && e->plane[t].extent[1] == entries;
+}
+
+/* affine_table's codebook with a second scale level: `scale.1` of dtype `scale2`, one value for
+ * the whole tensor (libquant's block2=*x*). Four planes: codes, scale, scale.1, table. */
+inline bool affine_table2(const RadEncoding* e, uint32_t codes, uint32_t scale, int64_t br,
+                          int64_t bc, uint32_t scale2, uint32_t tab, int64_t entries,
+                          const char* transform = "") {
+    if (!e || !rad_enc_is(e, "affine")) return false;
+    if (std::strncmp(e->transform, transform, RAD_ENC_STR) != 0) return false;
+    if (e->n_planes != 4) return false;
+    if (e->plane[0].dtype != codes || e->plane[0].block[1] != 1) return false;
+    const int s = rad_enc_find(e, "scale");
+    if (s < 0 || e->plane[s].dtype != scale || e->plane[s].kind != RAD_PLANE_TILED ||
+        e->plane[s].block[0] != br || e->plane[s].block[1] != bc) return false;
+    const int s2 = rad_enc_find(e, "scale.1");
+    if (s2 < 0 || e->plane[s2].dtype != scale2 || e->plane[s2].kind != RAD_PLANE_TILED ||
+        e->plane[s2].block[0] != 0 || e->plane[s2].block[1] != 0) return false;
+    const int t = rad_enc_find(e, "table");
+    return t >= 0 && e->plane[t].dtype == tab && e->plane[t].kind == RAD_PLANE_TABLE &&
+           e->plane[t].extent[0] == 1 && e->plane[t].extent[1] == entries;
+}
+
+/* The role of selected plane i. */
+inline const char* role(const RadEncoding* e, const int* sel, int i) {
+    return (e && sel && sel[i] >= 0 && sel[i] < e->n_planes) ? e->plane[sel[i]].role : "";
+}
+
+/* Does the selection name exactly these roles, in this order? */
+inline bool selects(const RadEncoding* e, const int* sel, int n, const char* a,
+                    const char* b = nullptr) {
+    const int want = b ? 2 : 1;
+    if (n != want) return false;
+    if (std::strncmp(role(e, sel, 0), a, RAD_ENC_STR) != 0) return false;
+    return !b || std::strncmp(role(e, sel, 1), b, RAD_ENC_STR) == 0;
+}
+
+/* A selected plane's bytes, row r. */
+inline const uint8_t* row(const RadTensor& t, int64_t r) {
+    return (const uint8_t*)t.data + r * rad_dtype_bytes(t.dtype, t.shape[1]);
+}
+
+/* The planes' extents match [rows, cols]. */
+inline bool dims(const RadTensor& t, int64_t rows, int64_t cols) {
+    return t.rank == 2 && t.shape[0] == rows && t.shape[1] == cols;
+}
+
+}  /* namespace r3di_enc */
diff --git a/libr3diqr/r3di_fp8_frag.h b/libr3diqr/r3di_fp8_frag.h
new file mode 100644
--- /dev/null
+++ b/libr3diqr/r3di_fp8_frag.h
@@ -0,0 +1,37 @@
+// r3di_fp8_frag.h -- where a byte of a block-scaled FP8 weight lives in WMMA fragment order. Pure
+// C++ (no HIP, no r3di.h) so the host layout hook and the device kernels share one definition.
+//
+// Why permute: the fp8a8 GEMMs read operands through r3di_fp8::frag(), which wants lane `l` to hold
+// row `l & 15` of a 16-row tile at k `(l >> 4) * 8`, eight bytes. From a row-major weight those
+// sixteen rows are `K` bytes apart, so a wave's load is sixteen transactions; the kernels stage
+// through LDS to transpose, at the cost of a barrier, 36 KiB per block and a second pass over the
+// weight. In fragment order the bytes are already in lane order.
+//
+// Why 64 k and not 16: a single fragment (16 rows x 16 k = 256 bytes) gives a wave one 256-byte
+// cacheline per request, which loses even to LDS staging. Four fragments give each lane 32
+// contiguous bytes and the wave a 1 KiB request, which beats both at every N and K in the family.
+//
+// The unit is a (16 row, 64 k) tile of 1024 bytes, laid out as 32 lanes x 32 bytes. Lane `l`'s
+// 32 bytes are its four fragments back to back: bytes `8t` are fragment `t`, covering
+// k `t*16 + (l>>4)*8` of row `l & 15`.
+//
+// K must be a multiple of 64 and N of 16; the 128 scale block already guarantees both.
+#pragma once
+#include <cstdint>
+
+namespace r3di_fp8 {
+
+enum { kFragRows = 16, kFragK = 16, kSuperK = 64, kTileBytes = 1024, kLaneBytes = 32 };
+
+// Bytes one [N][K] weight occupies in fragment order: exactly N*K, since this is a permutation.
+inline int64_t frag_bytes(int64_t N, int64_t K) { return N * K; }
+
+// The source (row, k) of a given (tile, lane, fragment, byte). The single definition of the
+// permutation: the host transform walks it forwards, the device kernels index it backwards.
+inline void frag_src(int64_t rt, int64_t ks, int64_t lane, int64_t t, int64_t j,
+                     int64_t* row, int64_t* k) {
+    *row = rt * (int64_t)kFragRows + (lane & 15);
+    *k   = ks * (int64_t)kSuperK + t * (int64_t)kFragK + (lane >> 4) * 8 + j;
+}
+
+}  // namespace r3di_fp8
diff --git a/libr3diqr/r3di_frag_decode.h b/libr3diqr/r3di_frag_decode.h
new file mode 100644
--- /dev/null
+++ b/libr3diqr/r3di_frag_decode.h
@@ -0,0 +1,29 @@
+// Same compressed-to-fragment transpose as the pinned RDNA4 IQR decoder.
+/* The unit's int8 tile in fragment order, two 64-K supertiles, through this wave's LDS tile `tr`.
+ * A wave's LDS accesses complete in order, so only the compiler must not move the reads above the
+ * writes; the second fence keeps the next unit's writes below these reads. */
+__device__ __forceinline__ void frag(const uint32_t (&w)[16], uint8_t* tr, uint32_t lane,
+                                     Stage8 (&s)[2]) {
+#pragma unroll
+    for (uint32_t q = 0; q < 16; ++q) *(uint32_t*)(tr + q * kTrPitch + 4u * lane) = w[q];
+    __builtin_amdgcn_fence(__ATOMIC_RELEASE, "wavefront", "local");
+    __builtin_amdgcn_wave_barrier();
+    __builtin_amdgcn_fence(__ATOMIC_ACQUIRE, "wavefront", "local");
+    const uint8_t* row = tr + (lane & 15u) * kTrPitch + (lane >> 4) * 8u;
+#pragma unroll
+    for (uint32_t h = 0; h < 2; ++h) {
+        uint32_t o[8];
+#pragma unroll
+        for (uint32_t t = 0; t < 4; ++t) {
+            const uint2 g = *(const uint2*)(row + h * 64u + t * 16u);
+            o[2 * t] = g.x;
+            o[2 * t + 1] = g.y;
+        }
+        s[h].v = make_uint4(o[0], o[1], o[2], o[3]);
+        s[h].w = make_uint4(o[4], o[5], o[6], o[7]);
+    }
+    __builtin_amdgcn_fence(__ATOMIC_RELEASE, "wavefront", "local");
+    __builtin_amdgcn_wave_barrier();
+    __builtin_amdgcn_fence(__ATOMIC_ACQUIRE, "wavefront", "local");
+}
+
diff --git a/libr3diqr/r3di_gated.h b/libr3diqr/r3di_gated.h
new file mode 100644
--- /dev/null
+++ b/libr3diqr/r3di_gated.h
@@ -0,0 +1,47 @@
+// Radiance v2 libr4d/r4d_gemm_iqr.hip's paired gate/up and last-arriver
+// epilogue. gfx11 keeps its native GEMV / WMMA arithmetic; no device-name tuning.
+struct GatedOut {
+    uint16_t* H;
+    int8_t* Q;
+    float* S;
+    uint16_t* Yb;
+    unsigned* cnt;
+    uint32_t n,q_ld,s_ld,y_ld;
+    int act;
+};
+__device__ inline void gated_put(const GatedOut& go,uint32_t m,uint32_t col,float vg,float vu) {
+    const float g=__uint_as_float(uint32_t(r3di_bf16(vg))<<16);
+    const float u=__uint_as_float(uint32_t(r3di_bf16(vu))<<16);
+    const float a=(go.act?1.0f:g)/(1.0f+expf(-g));
+    const uint16_t h=r3di_bf16(a*u);
+    go.H[(size_t)m*go.n+col]=h;
+    if(go.Yb)go.Yb[(size_t)m*go.y_ld+col]=h;
+}
+__device__ inline void gated_tail(const GatedOut& go,uint32_t M,uint32_t nw) {
+    __shared__ unsigned last;
+    const uint32_t tid=threadIdx.x,lane=tid&31,wave=tid>>5,g=blockIdx.x/8;
+    __threadfence();
+    __syncthreads();
+    if(!tid)last=__hip_atomic_fetch_add(go.cnt+g,1u,__ATOMIC_ACQ_REL,__HIP_MEMORY_SCOPE_AGENT);
+    __syncthreads();
+    if(last!=7)return;
+    if(!tid)__hip_atomic_store(go.cnt+g,0u,__ATOMIC_RELAXED,__HIP_MEMORY_SCOPE_AGENT);
+    __threadfence();
+    for(uint32_t m=wave;m<M;m+=nw) {
+        const uint32_t col=g*128+lane*4;
+        float v[4];
+#pragma unroll
+        for(uint32_t j=0;j<4;++j)v[j]=__uint_as_float(uint32_t(go.H[(size_t)m*go.n+col+j])<<16);
+        r3di_hadamard(v,lane);
+        float mx=0;
+#pragma unroll
+        for(float f:v)mx=fmaxf(mx,fabsf(f));
+        for(int sh=16;sh;sh>>=1)mx=fmaxf(mx,__shfl_xor(mx,sh,32));
+        const float sc=mx>0?mx*(1.0f/127.0f):1.0f,inv=1.0f/sc;
+        if(!lane)go.S[(size_t)m*go.s_ld+g]=sc;
+        uint32_t pk=0;
+#pragma unroll
+        for(uint32_t j=0;j<4;++j)pk|=(uint32_t(int(rintf(fminf(fmaxf(v[j]*inv,-127.0f),127.0f))))&255u)<<(j*8);
+        *(uint32_t*)(go.Q+(size_t)m*go.q_ld+col)=pk;
+    }
+}
diff --git a/libr3diqr/r3di_gemm.hip b/libr3diqr/r3di_gemm.hip
new file mode 100644
--- /dev/null
+++ b/libr3diqr/r3di_gemm.hip
@@ -0,0 +1,179 @@
+// IQR paths adapted from Radiance v2 libr4d: GEMV, narrow WMMA, and prefill
+// with one cooperative decode into temporary fragment storage per invocation.
+// Persistent weights retain their packed layout. See r3di_wmma.h for gfx11 ABI.
+#include "r3di_device.h"
+#include "r3di_wmma.h"
+#include "r3di_args.h"
+#include "r3di_iqr_dec.h"
+#include "r3di_keyed.h"
+#include <climits>
+namespace {
+using namespace r3di_iqr;
+using namespace r3di_iqr_dev;
+constexpr unsigned NW=4;
+constexpr uint32_t kWave=32,kBlock=128;
+using namespace r3di_fp8;
+#include "r3di_prefill_body.h"
+#include "r3di_frag_decode.h"
+#include "r3di_prefill_decode.h"
+#include "r3di_gated.h"
+#include "r3di_narrow.h"
+#include "r3di_gemv.h"
+template<class F,bool HEAD>
+__global__ __launch_bounds__(128) void product(Ctx c, const int8_t* x,
+    const int8_t* lo, const float* xs, void* y, uint32_t xld,uint32_t sld,
+    uint32_t yld,const int32_t* ids,int32_t off,uint32_t vocab) {
+    using D=Dec<F>;
+    const unsigned t=threadIdx.x,lane=t&31,wave=t>>5,rt=blockIdx.x,m=blockIdx.y;
+    __shared__ float red[NW][16];
+    float acc[16]={};
+    for(unsigned kb=wave;kb<c.nkb;kb+=NW) {
+        auto raw=D::fetch(c,rt,kb,lane,true);
+        uint32_t w[16];D::template rows<false>(raw,c,1.0f,w);
+        const uint32_t xv=*(const uint32_t*)(x+(size_t)m*xld+kb*128+4*lane);
+        uint32_t lv=0;
+        if constexpr(HEAD) lv=*(const uint32_t*)(lo+(size_t)m*xld+kb*128+4*lane);
+#pragma unroll
+        for(unsigned q=0;q<16;++q) {
+            int d=__builtin_amdgcn_sudot4(true,(int)w[q],true,(int)xv,0,false);
+            if constexpr(HEAD) d=d*128+__builtin_amdgcn_sudot4(true,(int)w[q],true,(int)lv,0,false);
+            const float sc=xs[(size_t)m*sld+kb]*fold_f32<F>(c,rt*16+q,kb);
+            acc[q]=fmaf((float)d,sc,acc[q]);
+        }
+    }
+#pragma unroll
+    for(unsigned q=0;q<16;++q) {
+        float v=acc[q];
+#pragma unroll
+        for(int h=16;h>0;h>>=1)v+=__shfl_down(v,h,32);
+        if(lane==0)red[wave][q]=v;
+    }
+    __syncthreads();
+    if(t<16) {
+        float v=red[0][t]+red[1][t];v+=red[2][t];v+=red[3][t];
+        v*=row_scale<F>(c,rt*16+t);
+        if constexpr(HEAD) {
+            const int64_t id=(int64_t)ids[rt*16+t]-off;
+            if(id>=0 && id<vocab)((float*)y)[(size_t)m*yld+id]=v;
+        } else ((uint16_t*)y)[(size_t)m*yld+rt*16+t]=r3di_bf16(v);
+    }
+}
+bool bounded(long long x){return x>0 && x<=INT_MAX;}
+bool present(const RadTensor* t){return t && t->data;}
+bool form_ok(const RadTensor* w,const RadTensor* s,long long n,long long k,Form* f) {
+    if(!present(w)||!present(s)||!is_weight_dtype(w->dtype)||!is_scale_dtype(s->dtype))return false;
+    if((w->dtype&kWordMask)!=(s->dtype&kWordMask))return false;
+    *f=form(w->dtype&kWordMask);
+    if(!built(word(*f)) || (f->lrun!=8 && f->lrun!=9 && f->lrun!=10) || n%(1ll<<f->lrun))return false;
+    return w->rank==2 && w->shape[0]==n && w->shape[1]==k && r3di_aligned(w->data,256) && r3di_aligned(s->data,4);
+}
+template<bool HEAD>
+int issue(const RadTensor* w,const RadTensor* s,Form f,const int8_t* x,const int8_t* lo,
+    const float* xs,void* y,uint32_t m,uint32_t n,uint32_t k,uint32_t xld,uint32_t sld,
+    uint32_t yld,const int32_t* ids,int32_t off,uint32_t vocab,RadStream stream,
+    void* scratch=nullptr) {
+    Ctx c{};c.W=(const uint8_t*)w->data;c.S=(const uint8_t*)s->data;c.N=n;c.nkb=k/128;c.run_tiles=(1u<<f.lrun)/16;
+#define GO(kind,b,lv,l,rb,sc) \
+    if(kernel_word(word(f))==FormT<kind,b,lv,l,rb,sc>::word()) { \
+        using F=FormT<kind,b,lv,l,rb,sc>; \
+        if constexpr(!HEAD) { \
+            if(m==1) { \
+                if(n>=4096)return R3DI_EMIT(stream,(iqr_gemv<F,4>),dim3(n/16),dim3(128),0,c,x,xs,(uint16_t*)y,GatedOut{}); \
+                return R3DI_EMIT(stream,(iqr_gemv<F,8>),dim3(n/16),dim3(256),0,c,x,xs,(uint16_t*)y,GatedOut{}); \
+            } \
+            if(m>64 && n%128==0 && yld==n) { \
+                IqrPre<F> pre{};pre.c=c;pre.fragp=(uint8_t*)scratch; \
+                pre.ctl=(unsigned int*)(pre.fragp+align256((int64_t)n*k));pre.nbm=(m+127)/128; \
+                if(hipMemsetAsync(pre.ctl,0,(size_t)(n/128)*12,(hipStream_t)stream)!=hipSuccess)return RAD_E_DEVICE; \
+                return R3DI_EMIT(stream,(iqr_prefill_kernel<F,(F::SC==kRowF32 ? 32 : 0)>),dim3(pre.nbm,n/128),dim3(256),0,pre, \
+                    (const uint8_t*)x,xs,pre.fragp,(const uint16_t*)s->data,(uint16_t*)y,m,k,n,xld,sld,k/128); \
+            } \
+            if(m>1)return R3DI_EMIT(stream,(iqr_narrow<F>),dim3(n/16,(m+15)/16),dim3(128),0,c,x,xs,(uint16_t*)y,m,n,xld,sld,yld,GatedOut{}); \
+        } \
+        return R3DI_EMIT(stream,(product<F,HEAD>),dim3(n/16,m),dim3(128),0,c,x,lo,xs,y,xld,sld,yld,ids,off,vocab); \
+    }
+    R3DI_IQR_FORMS(GO)
+#undef GO
+    return RAD_E_DTYPE;
+}
+}
+extern "C" int64_t r3di_gemm_scratch(const RadArgs* a) {
+    const int64_t m=r3di_geti_or(a,"M",0),n=r3di_geti_or(a,"N",0),k=r3di_geti_or(a,"K",0);
+    if(m<=64||m>65535||!bounded(n)||!bounded(k)||n%128||k%256)return 0;
+    return align256(n*k)+align256((n/128)*12);
+}
+extern "C" int r3di_gemm(const RadArgs* a,RadStream stream) {
+    if(!a||r3di_geti_or(a,"chain",0))return RAD_E_INVAL;
+    auto x=r3di_opt(a,0),xs=r3di_opt(a,1),w=r3di_opt(a,2),ws=r3di_opt(a,3),y=r3di_opt(a,4);
+    if(!present(x)||!present(xs)||!present(y)||!present(w))return RAD_E_INVAL;
+    if(x->dtype!=RAD_I8||xs->dtype!=RAD_F32||y->dtype!=RAD_BF16)return RAD_E_DTYPE;
+    if(x->rank!=2||xs->rank!=2||w->rank!=2||y->rank<2)return RAD_E_SHAPE;
+    long long m=x->shape[0],k=w->shape[1],n=w->shape[0];
+    if(!bounded(m)||m>65535||!bounded(n)||!bounded(k)||n%16||k%256||x->shape[1]!=k)return RAD_E_SHAPE;
+    if(y->shape[0]!=m||r3di_numel(y)!=m*n||xs->shape[0]!=m||xs->shape[1]!=k/128)return RAD_E_SHAPE;
+    long long xld=r3di_row_pitch(x),sld=r3di_row_pitch(xs),yld=r3di_row_pitch(y);
+    if(xld<k||sld<k/128||yld<n||xld%4||!bounded(xld)||!bounded(sld)||!bounded(yld))return RAD_E_STRIDE;
+    if(!r3di_aligned(x->data,4)||!r3di_aligned(xs->data,4)||!r3di_aligned(y->data,2))return RAD_E_ALIGN;
+    Form f;if(!form_ok(w,ws,n,k,&f))return RAD_E_DTYPE;
+    if(m>64 && n%128==0 && yld==n) {
+        const int64_t need=align256(n*k)+align256((n/128)*12);
+        if(!a->scratch||a->scratch_bytes<need||!r3di_aligned(a->scratch,256))return RAD_E_SHAPE;
+        if(!r3di_aligned(y->data,16)||(f.scale==kBf16&&!r3di_aligned(ws->data,16)))return RAD_E_ALIGN;
+    }
+    return issue<false>(w,ws,f,(const int8_t*)x->data,nullptr,(const float*)xs->data,y->data,
+        (uint32_t)m,(uint32_t)n,(uint32_t)k,(uint32_t)xld,(uint32_t)sld,(uint32_t)yld,nullptr,0,0,stream,a->scratch);
+}
+
+extern "C" int64_t r3di_gated_gemm_scratch(const RadArgs*);
+extern "C" int r3di_gated_gemm_fallback(const RadArgs*,RadStream);
+extern "C" int r3di_gated_gemm(const RadArgs* a,RadStream stream) {
+    if(!a||a->n_t<6||r3di_geti_or(a,"chain",0))return RAD_E_INVAL;
+    const auto x=r3di_opt(a,0),xs=r3di_opt(a,1),w=r3di_opt(a,2),ws=r3di_opt(a,3);
+    const auto q=r3di_opt(a,4),sc=r3di_opt(a,5),yb=r3di_opt(a,6);
+    if(!present(x)||!present(xs)||!present(w)||!present(q)||!present(sc))return RAD_E_INVAL;
+    if(x->dtype!=RAD_I8||xs->dtype!=RAD_F32||q->dtype!=RAD_I8||sc->dtype!=RAD_F32||
+       (present(yb)&&yb->dtype!=RAD_BF16))return RAD_E_DTYPE;
+    const int64_t n=r3di_geti_or(a,"N",0),k=r3di_geti_or(a,"K",0),bytes=r3di_gated_gemm_scratch(a);
+    if(!bytes||!a->scratch||a->scratch_bytes<bytes||!r3di_aligned(a->scratch,256))return RAD_E_SHAPE;
+    if(x->rank!=2||xs->rank!=2||w->rank!=2||!bounded(k)||k%256||n%256)return RAD_E_SHAPE;
+    const int64_t m=x->shape[0],h=n/2;
+    if(m<1||m>16||m>r3di_geti_or(a,"M",0)||x->shape[1]!=k||xs->shape[0]!=m||xs->shape[1]!=k/128)
+        return RAD_E_SHAPE;
+    long long qm=0,sm=0,ym=0;
+    const auto qld=r3di_rows_pitch(q,h,&qm),sld=r3di_rows_pitch(sc,h/128,&sm);
+    const auto yld=present(yb)?r3di_rows_pitch(yb,h,&ym):h;
+    const auto xld=r3di_row_pitch(x),xsld=r3di_row_pitch(xs);
+    if(qm!=m||sm!=m||(present(yb)&&ym!=m))return RAD_E_SHAPE;
+    if(qld<h||sld<h/128||yld<h||xld<k||xsld<k/128||xld%4||
+       !bounded(qld)||!bounded(sld)||!bounded(yld)||!bounded(xld)||!bounded(xsld))return RAD_E_STRIDE;
+    if(!r3di_aligned(x->data,4)||!r3di_aligned(xs->data,4)||!r3di_aligned(sc->data,4)||
+       (present(yb)&&!r3di_aligned(yb->data,2)))return RAD_E_ALIGN;
+    const char* act=r3di_gets(a,"act");
+    if(!act||(strcmp(act,"silu")&&strcmp(act,"sigmoid")))return RAD_E_INVAL;
+    Form f;if(!form_ok(w,ws,n,k,&f))return RAD_E_DTYPE;
+    // The old pair also handles uncommon unaligned code rows and allocation failure.
+    if(h/128>8192||qld%4||!r3di_aligned(q->data,4))return r3di_gated_gemm_fallback(a,stream);
+    GatedOut go{};
+    go.H=(uint16_t*)a->scratch;go.Q=(int8_t*)q->data;go.S=(float*)sc->data;
+    go.Yb=present(yb)?(uint16_t*)yb->data:nullptr;
+    go.n=(uint32_t)h;go.q_ld=(uint32_t)qld;go.s_ld=(uint32_t)sld;go.y_ld=(uint32_t)yld;
+    go.act=!strcmp(act,"sigmoid");
+    go.cnt=r3di::keyed_block(r3di::Keyed::SplitFp8,stream,q->data,8192*sizeof(unsigned));
+    if(!go.cnt)return r3di_gated_gemm_fallback(a,stream);
+    Ctx c{};c.W=(const uint8_t*)w->data;c.S=(const uint8_t*)ws->data;
+    c.N=(uint32_t)n;c.nkb=(uint32_t)k/128;c.run_tiles=(1u<<f.lrun)/16;
+    const auto xp=(const int8_t*)x->data;const auto sp=(const float*)xs->data;
+#define GO(kind,b,lv,l,rb,scf) \
+    if(kernel_word(word(f))==FormT<kind,b,lv,l,rb,scf>::word()) { \
+        using F=FormT<kind,b,lv,l,rb,scf>; \
+        if(m==1) { \
+            if(n>=4096)return R3DI_EMIT(stream,(iqr_gemv<F,4,true>),dim3(h/16),dim3(256),0,c,xp,sp,(uint16_t*)nullptr,go); \
+            return R3DI_EMIT(stream,(iqr_gemv<F,8,true>),dim3(h/16),dim3(512),0,c,xp,sp,(uint16_t*)nullptr,go); \
+        } \
+        return R3DI_EMIT(stream,(iqr_narrow<F,true>),dim3(h/16),dim3(256),0,c,xp,sp,(uint16_t*)nullptr, \
+            (uint32_t)m,(uint32_t)n,(uint32_t)xld,(uint32_t)xsld,0u,go); \
+    }
+    R3DI_IQR_FORMS(GO)
+#undef GO
+    return RAD_E_DTYPE;
+}
diff --git a/libr3diqr/r3di_gemv.h b/libr3diqr/r3di_gemv.h
new file mode 100644
--- /dev/null
+++ b/libr3diqr/r3di_gemv.h
@@ -0,0 +1,64 @@
+// Pinned libr4d/r4d_gemm_iqr.hip's MAD/row-F32 GEMV specialization:
+// prefetch packed codes, dot the hash bytes directly, periodically remove the
+// integer dot results, and reduce sixteen rows together. No expanded weights.
+// The upstream biased-float shortcut exceeded the independent long-K error
+// bound here, so retain exact int32 conversion at each scale block.
+__device__ inline float iqr_red16(float (&a)[16],uint32_t lane){
+    float b[8],c[4],d[2];
+#pragma unroll
+    for(int q=0;q<16;++q)a[q]+=__shfl_xor(a[q],1);
+#pragma unroll
+    for(int j=0;j<8;++j){float v=(lane&1)?float(a[8+j]):float(a[j]);b[j]=v+__shfl_xor(v,2);}
+#pragma unroll
+    for(int j=0;j<4;++j){float v=(lane&2)?float(b[4+j]):float(b[j]);c[j]=v+__shfl_xor(v,4);}
+#pragma unroll
+    for(int j=0;j<2;++j){float v=(lane&4)?float(c[2+j]):float(c[j]);d[j]=v+__shfl_xor(v,8);}
+    float v=(lane&8)?float(d[1]):float(d[0]);return v+__shfl_xor(v,16);
+}
+__device__ inline uint32_t iqr_redrow(uint32_t lane){
+    return (lane&1)<<3|(lane&2)<<1|(lane&4)>>1|(lane&8)>>3;
+}
+template<class F,uint32_t KW,bool GATED=false>
+__global__ __launch_bounds__((GATED?2:1)*KW*32) void iqr_gemv(Ctx c,const int8_t* x,const float* xs,uint16_t* y,GatedOut go){
+    using D=Dec<F,true>;
+    static_assert(F::KIND==kTrellisMad && F::LRB==0 &&
+                  (F::SC==kRowF32 || F::SC==kBf16), "specialized MAD scale path");
+    const uint32_t tid=threadIdx.x,lane=tid&31,wave0=tid>>5;
+    const uint32_t half=GATED?wave0/KW:0,wave=GATED?wave0%KW:wave0;
+    const uint32_t rt=blockIdx.x+half*(c.N/32);
+    __shared__ float sums[(GATED?2:1)*KW][16];
+    float acc[16]={};
+    typename D::Raw cur=D::fetch(c,rt,wave,lane,wave<c.nkb),next;
+    for(uint32_t kb=wave;kb<c.nkb;kb+=KW){
+        if(kb+KW<c.nkb)next=D::fetch(c,rt,kb+KW,lane,true);
+        uint32_t xv=*(const uint32_t*)(x+kb*128+4*lane),xx[4],hash[16][4];
+        D::hashes(cur,c,hash);
+#pragma unroll
+        for(int e=0;e<4;++e)xx[e]=__builtin_amdgcn_perm(0u,xv,e*0x01010101u);
+        const int bias=-__builtin_amdgcn_sudot4(true,(int)xv,false,0x7e7e7e7e,0,false);
+#pragma unroll
+        for(int q=0;q<16;++q){
+            int v=bias;
+#pragma unroll
+            for(int e=0;e<4;++e)v=__builtin_amdgcn_sudot4(false,(int)hash[q][e],true,(int)xx[e],v,false);
+            const float scale=xs[kb]*fold_f32<F>(c,rt*16+q,kb);
+            acc[q]=fmaf(float(v),scale,acc[q]);
+        }
+        if(kb+KW<c.nkb)cur=next;
+    }
+    float v=iqr_red16(acc,lane);if(lane<16)sums[wave0][lane]=v;
+    __syncthreads();
+    if(tid<16){
+        float total=0;
+#pragma unroll
+        for(uint32_t w=0;w<KW;++w)total+=sums[w][tid];
+        const uint32_t row=rt*16+iqr_redrow(tid);
+        if constexpr(GATED) {
+            float up=0;
+#pragma unroll
+            for(uint32_t w=0;w<KW;++w)up+=sums[KW+w][tid];
+            gated_put(go,0,row,total*row_scale<F>(c,row),up*row_scale<F>(c,row+go.n));
+        } else y[row]=r3di_bf16(total*row_scale<F>(c,row));
+    }
+    if constexpr(GATED)gated_tail(go,1,2*KW);
+}
diff --git a/libr3diqr/r3di_hsimd.h b/libr3diqr/r3di_hsimd.h
new file mode 100644
--- /dev/null
+++ b/libr3diqr/r3di_hsimd.h
@@ -0,0 +1,66 @@
+/* r3di_hsimd.h -- libr3di's host-side hot loops (the load-time relayouts), dispatched by CPU feature
+ * as the core's util/simd.h is: the plugin runs on machines it was not built on, so no
+ * -march=native. r3di_hsimd_kernels.cpp is compiled once per level into separate objects with their
+ * own -m flags (cmake/RadSimdLevels.cmake); r3di_hsimd.cpp (baseline, no -m flags) picks one at
+ * first use through __builtin_cpu_supports, which also checks the OS has enabled the register
+ * state.
+ *
+ * Every function here moves bits and has one exact result: all levels agree bit for bit on every
+ * input, which tests/relayout_iqr_test.cpp and tests/relayout_parity_test.cpp check by forcing
+ * each level (force_level) against the scalar level and a reference written in the test.
+ *
+ * Levels, as util/simd.h: 0 scalar, 1 SSE4.1/4.2, 2 AVX (integer work in 128-bit halves), 3 AVX2,
+ * 4 AVX-512 F/BW/DQ/VL. On a non-x86 build only the scalar level exists.
+ */
+#pragma once
+
+#include <cstdint>
+
+namespace r3di_hsimd {
+
+enum Level { kScalar = 0, kSse4 = 1, kAvx = 2, kAvx2 = 3, kAvx512 = 4, kLevels = 5 };
+
+/* The highest level this CPU and OS can execute, computed once. */
+int         detect_level();
+/* The level in use (detect_level() unless forced). */
+int         level();
+const char* level_name(int lvl);
+/* Forces a level, clamped to detect_level(); for tests only. Returns the level now in use. */
+int         force_level(int lvl);
+
+/* MoE w4 codes between canonical and kernel nibble order, `bytes` (a multiple of four) from `s` to
+ * `d`: in every dword, canonical nibble i (element i, two a byte, the first low) goes to nibble
+ * 2i (i < 4) or 2(i - 4) + 1, a perfect shuffle of the dword's halves (r3di_layout.cpp); `forward`
+ * false undoes it. */
+void moew4_permute(const uint8_t* s, uint8_t* d, int64_t bytes, bool forward);
+
+/* One 16-row tile of an IQR trellis weight into its `nkb` stored units (r3di_iqr.h, "the codes:
+ * lane segments"): `rows` is the tile's first row of B-bit codes (2 <= B <= 7, LSB first), rows
+ * `rb` bytes apart; unit kb, at `out` + kb * 256 * B, holds for each lane l and column
+ * e = 0..3 the 16 codes of column 128 kb + 4 l + e bottom-up (row 15 first). Reads only the
+ * tile's own bytes. */
+void iqr_trellis_tile(const uint8_t* rows, int64_t rb, int B, int64_t nkb, uint8_t* out);
+
+/* One 16-row tile of a w2a8 weight's u2 codes into its `kpb` stored units (r3di_layout.cpp,
+ * w2_slot): `rows` is the tile's first row of codes (four a byte, the first in the low bits), rows
+ * `rb` bytes apart; unit kb, at `out` + 512 kb, holds for half lh and row r, at
+ * 16 (16 lh + r), four dwords d, whose field 4j + b + 2h is the code of column
+ * 128 kb + 16 (2d + h) + 8b + 4 lh + j. Reads only the tile's own bytes. */
+void w2a8_tile(const uint8_t* rows, int64_t rb, int64_t kpb, uint8_t* out);
+
+/* A 16-row tile of dwords transposed: out[16 c + r] = in[r * stride + c] for r < 16, c < cols
+ * (dword units; `in` rows `stride` dwords apart). MXFP4's stored codes are this (r3di_layout.cpp,
+ * mx_slot): each 16-code group's two 4-byte halves go to the n-tile's slots whole. */
+void dword_transpose16(const uint32_t* in, int64_t stride, int64_t cols, uint32_t* out);
+
+/* A rows x cols byte matrix transposed: out[c * rows + r] = in[r * cols + c]. MXFP4's exponents go
+ * from canonical [N][K/32] to the stored [K/32][N] so. */
+void byte_transpose(const uint8_t* in, int64_t rows, int64_t cols, uint8_t* out);
+
+/* One 16-row tile of a block-FP8 or int8 weight into fragment order (r3di_fp8_frag.h): `rows` is
+ * the tile's first row of byte codes, rows K bytes apart; the `ksuper` 1024-byte units at `out`
+ * hold, for each 64-byte K step, lane l's 32 bytes at 32 l: row l % 16's qwords 2t + l / 16 for
+ * t = 0..3. Reads only the tile's own bytes. */
+void fp8_frag_tile(const uint8_t* rows, int64_t K, int64_t ksuper, uint8_t* out);
+
+}  // namespace r3di_hsimd
diff --git a/libr3diqr/r3di_hsimd_kernels.cpp b/libr3diqr/r3di_hsimd_kernels.cpp
new file mode 100644
--- /dev/null
+++ b/libr3diqr/r3di_hsimd_kernels.cpp
@@ -0,0 +1,770 @@
+/* r3di_hsimd_kernels.cpp -- the per-level bodies behind r3di_hsimd.h. Compiled once per level with
+ * R3DI_HSIMD_LEVEL=0..4 and matching -m flags (cmake/RadSimdLevels.cmake); names carry the level's
+ * suffix and r3di_hsimd.cpp holds the table. Every body moves bits and is exact: each level gives
+ * the scalar level's bytes on every input.
+ *
+ * The trellis tile is three passes over a 16-row x 128-K unit, all in L1: each row's 128 B-bit
+ * codes are unpacked to bytes, the 16 x 128 byte matrix is transposed with its rows reversed (the
+ * stored order is column-major, row 15 first), and the 2048 bytes are packed back to B bits, which
+ * is the unit: lane l's segment is columns 4l .. 4l + 3, 16 codes each, so the transposed matrix's
+ * rows in order are the segments in order.
+ *
+ * The w2a8 tile moves 2-bit codes within a row: each stored dword is four bytes of the row's unit
+ * gathered and transposed as a 4 x 4 matrix of 2-bit fields, a shuffle and two delta swaps.
+ */
+#include "r3di_hsimd.h"
+
+#include <cstring>
+
+#if R3DI_HSIMD_LEVEL >= 1
+#include <immintrin.h>
+#endif
+
+#if   R3DI_HSIMD_LEVEL == 0
+#define R3DI_HSIMD_SUFFIX _sc
+#elif R3DI_HSIMD_LEVEL == 1
+#define R3DI_HSIMD_SUFFIX _s4
+#elif R3DI_HSIMD_LEVEL == 2
+#define R3DI_HSIMD_SUFFIX _v1
+#elif R3DI_HSIMD_LEVEL == 3
+#define R3DI_HSIMD_SUFFIX _v2
+#elif R3DI_HSIMD_LEVEL == 4
+#define R3DI_HSIMD_SUFFIX _v3
+#else
+#error "R3DI_HSIMD_LEVEL out of range"
+#endif
+
+#define R3DI_HSIMD_CAT2(a, b) a##b
+#define R3DI_HSIMD_CAT(a, b)  R3DI_HSIMD_CAT2(a, b)
+#define R3DI_HSIMD_FN(name)   R3DI_HSIMD_CAT(r3di_hsimd_##name, R3DI_HSIMD_SUFFIX)
+
+namespace {
+
+/* `n` bytes from L1 scratch to a destination the host never reads back (a pinned staging ring or a
+ * pool slot the card reads), with streaming stores where both are aligned: an ordinary store first
+ * reads each destination line in, which during a restore is DRAM traffic beside the drive's DMA.
+ * The caller fences once (stream_fence) before the bytes are handed on. */
+inline bool stream_copy(uint8_t* d, const uint8_t* s, int64_t n) {
+#if R3DI_HSIMD_LEVEL == 4
+    if ((((uintptr_t)d | (uintptr_t)s | (uintptr_t)n) & 63) == 0) {
+        for (int64_t i = 0; i < n; i += 64)
+            _mm512_stream_si512((__m512i*)(d + i), _mm512_load_si512((const __m512i*)(s + i)));
+        return true;
+    }
+#elif R3DI_HSIMD_LEVEL == 3
+    if ((((uintptr_t)d | (uintptr_t)s | (uintptr_t)n) & 31) == 0) {
+        for (int64_t i = 0; i < n; i += 32)
+            _mm256_stream_si256((__m256i*)(d + i), _mm256_load_si256((const __m256i*)(s + i)));
+        return true;
+    }
+#elif R3DI_HSIMD_LEVEL >= 1
+    if ((((uintptr_t)d | (uintptr_t)s | (uintptr_t)n) & 15) == 0) {
+        for (int64_t i = 0; i < n; i += 16)
+            _mm_stream_si128((__m128i*)(d + i), _mm_load_si128((const __m128i*)(s + i)));
+        return true;
+    }
+#endif
+    std::memcpy(d, s, (size_t)n);
+    return false;
+}
+
+/* Orders the streaming stores before whatever publishes the bytes. */
+inline void stream_fence(bool streamed) {
+#if R3DI_HSIMD_LEVEL >= 1
+    if (streamed) _mm_sfence();
+#else
+    (void)streamed;
+#endif
+}
+
+/* ---- the MoE w4 nibble shuffle ------------------------------------------------------------- */
+
+/* Scalar, two dwords at a time: forward swaps each dword's middle bytes, then each half's middle
+ * nibbles; back does the steps in reverse. */
+inline uint64_t mw_bytes(uint64_t x) {
+    return (x & 0xFF0000FFFF0000FFull) | ((x & 0x0000FF000000FF00ull) << 8) |
+           ((x >> 8) & 0x0000FF000000FF00ull);
+}
+inline uint64_t mw_nibbles(uint64_t x) {
+    return (x & 0xF00FF00FF00FF00Full) | ((x & 0x00F000F000F000F0ull) << 4) |
+           ((x >> 4) & 0x00F000F000F000F0ull);
+}
+void mw_scalar(const uint8_t* s, uint8_t* d, int64_t bytes, bool fwd) {
+    int64_t i = 0;
+    for (; i + 8 <= bytes; i += 8) {
+        uint64_t x;
+        std::memcpy(&x, s + i, 8);
+        x = fwd ? mw_nibbles(mw_bytes(x)) : mw_bytes(mw_nibbles(x));
+        std::memcpy(d + i, &x, 8);
+    }
+    if (i < bytes) {   /* one dword left; no step crosses dwords */
+        uint32_t w;
+        std::memcpy(&w, s + i, 4);
+        uint64_t x = w;
+        x = fwd ? mw_nibbles(mw_bytes(x)) : mw_bytes(mw_nibbles(x));
+        w = (uint32_t)x;
+        std::memcpy(d + i, &w, 4);
+    }
+}
+
+/* Vector form: output byte b of a dword is a low nibble of input byte A[b] and a high nibble of
+ * input byte B[b], each from the input byte's low or high half. Forward, byte b takes element b
+ * low and b + 4 high: A = (0, 0, 1, 1), B = (2, 2, 3, 3), odd bytes from the high halves. Back,
+ * A = (0, 2, 0, 2), B = (1, 3, 1, 3), bytes 2 and 3 from the high halves. */
+#if R3DI_HSIMD_LEVEL >= 1
+inline int8_t mw_idx(int k, bool fwd) {   /* A's byte for output byte k of a 16-byte lane */
+    const int dw = k & ~3, b = k & 3;
+    return (int8_t)(dw + (fwd ? (b >> 1) : (b & 1) * 2));
+}
+/* Whether a permute streams its output (stream_copy says why): a whole weight into its pinned or
+ * pool destination does, aligned to the vector. A row into scratch the caller reads straight back
+ * (moew4_frag_permute, moew5_row: a few KiB) keeps ordinary stores, which leave it in cache. */
+inline bool mw_stream(const uint8_t* d, int64_t bytes, int vec) {
+    return bytes >= ((int64_t)64 << 10) && ((uintptr_t)d & (uintptr_t)(vec - 1)) == 0;
+}
+#endif
+
+#if R3DI_HSIMD_LEVEL == 1 || R3DI_HSIMD_LEVEL == 2
+void mw_vec(const uint8_t* s, uint8_t* d, int64_t bytes, bool fwd) {
+    alignas(16) int8_t t[16];
+    for (int k = 0; k < 16; ++k) t[k] = mw_idx(k, fwd);
+    const __m128i ia = _mm_load_si128((const __m128i*)t);
+    const __m128i ib = _mm_add_epi8(ia, _mm_set1_epi8(fwd ? 2 : 1));
+    const __m128i m = fwd ? _mm_set1_epi16((short)0xFF00) : _mm_set1_epi32((int)0xFFFF0000);
+    const __m128i lo = _mm_set1_epi8(0x0F), hi = _mm_set1_epi8((char)0xF0);
+    const bool nt = mw_stream(d, bytes, 16);
+    int64_t i = 0;
+    for (; i + 16 <= bytes; i += 16) {
+        const __m128i x = _mm_loadu_si128((const __m128i*)(s + i));
+        const __m128i a = _mm_shuffle_epi8(x, ia), b = _mm_shuffle_epi8(x, ib);
+        const __m128i a2 = _mm_blendv_epi8(a, _mm_srli_epi16(a, 4), m);
+        const __m128i b2 = _mm_blendv_epi8(_mm_slli_epi16(b, 4), b, m);
+        const __m128i v = _mm_or_si128(_mm_and_si128(a2, lo), _mm_and_si128(b2, hi));
+        if (nt) _mm_stream_si128((__m128i*)(d + i), v);
+        else    _mm_storeu_si128((__m128i*)(d + i), v);
+    }
+    stream_fence(nt);
+    mw_scalar(s + i, d + i, bytes - i, fwd);
+}
+#elif R3DI_HSIMD_LEVEL == 3
+void mw_vec(const uint8_t* s, uint8_t* d, int64_t bytes, bool fwd) {
+    alignas(32) int8_t t[32];
+    for (int k = 0; k < 32; ++k) t[k] = mw_idx(k & 15, fwd);
+    const __m256i ia = _mm256_load_si256((const __m256i*)t);
+    const __m256i ib = _mm256_add_epi8(ia, _mm256_set1_epi8(fwd ? 2 : 1));
+    const __m256i m = fwd ? _mm256_set1_epi16((short)0xFF00) : _mm256_set1_epi32((int)0xFFFF0000);
+    const __m256i lo = _mm256_set1_epi8(0x0F), hi = _mm256_set1_epi8((char)0xF0);
+    const bool nt = mw_stream(d, bytes, 32);
+    int64_t i = 0;
+    for (; i + 32 <= bytes; i += 32) {
+        const __m256i x = _mm256_loadu_si256((const __m256i*)(s + i));
+        const __m256i a = _mm256_shuffle_epi8(x, ia), b = _mm256_shuffle_epi8(x, ib);
+        const __m256i a2 = _mm256_blendv_epi8(a, _mm256_srli_epi16(a, 4), m);
+        const __m256i b2 = _mm256_blendv_epi8(_mm256_slli_epi16(b, 4), b, m);
+        const __m256i v = _mm256_or_si256(_mm256_and_si256(a2, lo), _mm256_and_si256(b2, hi));
+        if (nt) _mm256_stream_si256((__m256i*)(d + i), v);
+        else    _mm256_storeu_si256((__m256i*)(d + i), v);
+    }
+    stream_fence(nt);
+    mw_scalar(s + i, d + i, bytes - i, fwd);
+}
+#elif R3DI_HSIMD_LEVEL == 4
+void mw_vec(const uint8_t* s, uint8_t* d, int64_t bytes, bool fwd) {
+    alignas(64) int8_t t[64];
+    for (int k = 0; k < 64; ++k) t[k] = mw_idx(k & 15, fwd);
+    const __m512i ia = _mm512_load_si512(t);
+    const __m512i ib = _mm512_add_epi8(ia, _mm512_set1_epi8(fwd ? 2 : 1));
+    const __mmask64 m = fwd ? 0xAAAAAAAAAAAAAAAAull : 0xCCCCCCCCCCCCCCCCull;
+    const __m512i lo = _mm512_set1_epi8(0x0F);
+    const bool nt = mw_stream(d, bytes, 64);
+    int64_t i = 0;
+    for (; i + 64 <= bytes; i += 64) {
+        const __m512i x = _mm512_loadu_si512(s + i);
+        const __m512i a = _mm512_shuffle_epi8(x, ia), b = _mm512_shuffle_epi8(x, ib);
+        const __m512i a2 = _mm512_mask_mov_epi8(a, m, _mm512_srli_epi16(a, 4));
+        const __m512i b2 = _mm512_mask_mov_epi8(_mm512_slli_epi16(b, 4), m, b);
+        /* lo ? a2 : b2, bit by bit */
+        const __m512i v = _mm512_ternarylogic_epi64(lo, a2, b2, 0xCA);
+        if (nt) _mm512_stream_si512((__m512i*)(d + i), v);
+        else    _mm512_storeu_si512(d + i, v);
+    }
+    stream_fence(nt);
+    mw_scalar(s + i, d + i, bytes - i, fwd);
+}
+#endif
+
+/* ---- the trellis tile ------------------------------------------------------------------------ */
+
+/* A row's codes for one unit: 128 codes, 16 B bytes. */
+constexpr int kCodes = 128;
+
+#if R3DI_HSIMD_LEVEL == 0
+/* 128 codes of B bits from `s` to one byte each. */
+void unpack_row(const uint8_t* s, int B, uint8_t* u) {
+    const uint64_t m = (1u << B) - 1u;
+    for (int g = 0; g < kCodes / 8; ++g) {
+        uint64_t x = 0;
+        std::memcpy(&x, s + g * B, (size_t)B);
+        for (int i = 0; i < 8; ++i) u[g * 8 + i] = (uint8_t)((x >> (i * B)) & m);
+    }
+}
+/* T[k][q] = U[15 - q][k]. */
+void transpose_rev(const uint8_t (*U)[kCodes], uint8_t* T) {
+    for (int k = 0; k < kCodes; ++k)
+        for (int q = 0; q < 16; ++q) T[k * 16 + q] = U[15 - q][k];
+}
+/* `n` bytes of B-bit values to the stream, eight values (B bytes) at a time. */
+void pack(const uint8_t* t, int n, int B, uint8_t* out) {
+    for (int g = 0; g < n / 8; ++g) {
+        uint64_t x = 0;
+        for (int i = 0; i < 8; ++i) x |= (uint64_t)t[g * 8 + i] << (i * B);
+        std::memcpy(out + g * B, &x, (size_t)B);
+    }
+}
+#else
+/* 128-bit lanes, shared by every vector level: one lane unpacks 16 codes (2B bytes) or packs 16
+ * bytes. Unpacking spreads the lane's two B-byte halves to its 64-bit halves, then halves each
+ * width in turn (64 -> 32 -> 16 -> 8 bits a field); packing runs the same steps backwards. The
+ * shift counts follow B, so they go in a register. */
+struct Lanes {
+    __m128i up_idx, pk_idx, c4, c2, c1, c32, c16, c8;
+    __m128i m4, m2, m1, k32, k16, k8;
+    explicit Lanes(int B) {
+        alignas(16) int8_t u[16], p[16];
+        for (int i = 0; i < 16; ++i) {
+            u[i] = (int8_t)(i < 8 ? (i < B ? i : -128) : (i - 8 < B ? B + (i - 8) : -128));
+            p[i] = (int8_t)(i < B ? i : i < 2 * B ? 8 + (i - B) : -128);
+        }
+        up_idx = _mm_load_si128((const __m128i*)u);
+        pk_idx = _mm_load_si128((const __m128i*)p);
+        c4 = _mm_cvtsi32_si128(4 * B);
+        c2 = _mm_cvtsi32_si128(2 * B);
+        c1 = _mm_cvtsi32_si128(B);
+        c32 = _mm_cvtsi32_si128(32);
+        c16 = _mm_cvtsi32_si128(16);
+        c8 = _mm_cvtsi32_si128(8);
+        m4 = _mm_set1_epi64x((long long)((1ull << (4 * B)) - 1ull));
+        m2 = _mm_set1_epi32((int)((1u << (2 * B)) - 1u));
+        m1 = _mm_set1_epi16((short)((1u << B) - 1u));
+        k32 = _mm_set1_epi64x(0xFFFFFFFFll);
+        k16 = _mm_set1_epi32(0xFFFF);
+        k8 = _mm_set1_epi16(0xFF);
+    }
+};
+#endif
+
+#if R3DI_HSIMD_LEVEL == 1 || R3DI_HSIMD_LEVEL == 2
+inline __m128i unpack16(const Lanes& L, __m128i x) {
+    x = _mm_shuffle_epi8(x, L.up_idx);
+    x = _mm_or_si128(_mm_and_si128(x, L.m4), _mm_sll_epi64(_mm_srl_epi64(x, L.c4), L.c32));
+    x = _mm_or_si128(_mm_and_si128(x, L.m2), _mm_sll_epi32(_mm_srl_epi32(x, L.c2), L.c16));
+    return _mm_or_si128(_mm_and_si128(x, L.m1), _mm_sll_epi16(_mm_srl_epi16(x, L.c1), L.c8));
+}
+inline __m128i pack16(const Lanes& L, __m128i x) {
+    x = _mm_or_si128(_mm_and_si128(x, L.k8), _mm_sll_epi16(_mm_srl_epi16(x, L.c8), L.c1));
+    x = _mm_or_si128(_mm_and_si128(x, L.k16), _mm_sll_epi32(_mm_srl_epi32(x, L.c16), L.c2));
+    x = _mm_or_si128(_mm_and_si128(x, L.k32), _mm_sll_epi64(_mm_srl_epi64(x, L.c32), L.c4));
+    return _mm_shuffle_epi8(x, L.pk_idx);
+}
+/* `s` may be read 16 bytes past each group: the caller pads where the plane ends. */
+void unpack_row(const Lanes& L, const uint8_t* s, int B, uint8_t* u) {
+    for (int g = 0; g < kCodes / 16; ++g)
+        _mm_storeu_si128((__m128i*)(u + g * 16),
+                         unpack16(L, _mm_loadu_si128((const __m128i*)(s + g * 2 * B))));
+}
+/* Four rounds of interleaving rows i and i + 8 transpose a 16 x 16 byte block: each round rotates
+ * an element's 8-bit (row, column) address left by one bit. */
+void transpose_rev(const uint8_t (*U)[kCodes], uint8_t* T) {
+    for (int c = 0; c < kCodes / 16; ++c) {
+        __m128i x[16], y[16];
+        for (int q = 0; q < 16; ++q) x[q] = _mm_loadu_si128((const __m128i*)(U[15 - q] + 16 * c));
+        for (int round = 0; round < 4; ++round) {
+            for (int i = 0; i < 8; ++i) {
+                y[2 * i] = _mm_unpacklo_epi8(x[i], x[i + 8]);
+                y[2 * i + 1] = _mm_unpackhi_epi8(x[i], x[i + 8]);
+            }
+            for (int i = 0; i < 16; ++i) x[i] = y[i];
+        }
+        for (int j = 0; j < 16; ++j) _mm_storeu_si128((__m128i*)(T + (16 * c + j) * 16), x[j]);
+    }
+}
+/* Writes up to 16 bytes past the 2B n / 16 the stream holds: `out` has room. */
+void pack(const Lanes& L, const uint8_t* t, int n, int B, uint8_t* out) {
+    for (int g = 0; g < n / 16; ++g)
+        _mm_storeu_si128((__m128i*)(out + g * 2 * B), pack16(L, _mm_loadu_si128((const __m128i*)(t + g * 16))));
+}
+#elif R3DI_HSIMD_LEVEL == 3
+inline __m256i bc(__m128i x) { return _mm256_broadcastsi128_si256(x); }
+inline __m256i unpack32(const Lanes& L, __m256i x) {
+    x = _mm256_shuffle_epi8(x, bc(L.up_idx));
+    x = _mm256_or_si256(_mm256_and_si256(x, bc(L.m4)), _mm256_sll_epi64(_mm256_srl_epi64(x, L.c4), L.c32));
+    x = _mm256_or_si256(_mm256_and_si256(x, bc(L.m2)), _mm256_sll_epi32(_mm256_srl_epi32(x, L.c2), L.c16));
+    return _mm256_or_si256(_mm256_and_si256(x, bc(L.m1)), _mm256_sll_epi16(_mm256_srl_epi16(x, L.c1), L.c8));
+}
+inline __m256i pack32(const Lanes& L, __m256i x) {
+    x = _mm256_or_si256(_mm256_and_si256(x, bc(L.k8)), _mm256_sll_epi16(_mm256_srl_epi16(x, L.c8), L.c1));
+    x = _mm256_or_si256(_mm256_and_si256(x, bc(L.k16)), _mm256_sll_epi32(_mm256_srl_epi32(x, L.c16), L.c2));
+    x = _mm256_or_si256(_mm256_and_si256(x, bc(L.k32)), _mm256_sll_epi64(_mm256_srl_epi64(x, L.c32), L.c4));
+    return _mm256_shuffle_epi8(x, bc(L.pk_idx));
+}
+void unpack_row(const Lanes& L, const uint8_t* s, int B, uint8_t* u) {
+    for (int g = 0; g < kCodes / 16; g += 2) {
+        const __m256i x = _mm256_inserti128_si256(
+            _mm256_castsi128_si256(_mm_loadu_si128((const __m128i*)(s + g * 2 * B))),
+            _mm_loadu_si128((const __m128i*)(s + (g + 1) * 2 * B)), 1);
+        _mm256_storeu_si256((__m256i*)(u + g * 16), unpack32(L, x));
+    }
+}
+/* Two 16 x 16 blocks at once, one a 128-bit lane. */
+void transpose_rev(const uint8_t (*U)[kCodes], uint8_t* T) {
+    for (int c = 0; c < kCodes / 16; c += 2) {
+        __m256i x[16], y[16];
+        for (int q = 0; q < 16; ++q) x[q] = _mm256_loadu_si256((const __m256i*)(U[15 - q] + 16 * c));
+        for (int round = 0; round < 4; ++round) {
+            for (int i = 0; i < 8; ++i) {
+                y[2 * i] = _mm256_unpacklo_epi8(x[i], x[i + 8]);
+                y[2 * i + 1] = _mm256_unpackhi_epi8(x[i], x[i + 8]);
+            }
+            for (int i = 0; i < 16; ++i) x[i] = y[i];
+        }
+        for (int j = 0; j < 16; ++j) {
+            _mm_storeu_si128((__m128i*)(T + (16 * c + j) * 16), _mm256_castsi256_si128(x[j]));
+            _mm_storeu_si128((__m128i*)(T + (16 * (c + 1) + j) * 16), _mm256_extracti128_si256(x[j], 1));
+        }
+    }
+}
+void pack(const Lanes& L, const uint8_t* t, int n, int B, uint8_t* out) {
+    for (int g = 0; g < n / 16; g += 2) {
+        const __m256i x = pack32(L, _mm256_loadu_si256((const __m256i*)(t + g * 16)));
+        _mm_storeu_si128((__m128i*)(out + g * 2 * B), _mm256_castsi256_si128(x));
+        _mm_storeu_si128((__m128i*)(out + (g + 1) * 2 * B), _mm256_extracti128_si256(x, 1));
+    }
+}
+#elif R3DI_HSIMD_LEVEL == 4
+inline __m512i bc(__m128i x) { return _mm512_broadcast_i32x4(x); }
+inline __m512i unpack64(const Lanes& L, __m512i x) {
+    x = _mm512_shuffle_epi8(x, bc(L.up_idx));
+    x = _mm512_or_si512(_mm512_and_si512(x, bc(L.m4)), _mm512_sll_epi64(_mm512_srl_epi64(x, L.c4), L.c32));
+    x = _mm512_or_si512(_mm512_and_si512(x, bc(L.m2)), _mm512_sll_epi32(_mm512_srl_epi32(x, L.c2), L.c16));
+    return _mm512_or_si512(_mm512_and_si512(x, bc(L.m1)), _mm512_sll_epi16(_mm512_srl_epi16(x, L.c1), L.c8));
+}
+inline __m512i pack64(const Lanes& L, __m512i x) {
+    x = _mm512_or_si512(_mm512_and_si512(x, bc(L.k8)), _mm512_sll_epi16(_mm512_srl_epi16(x, L.c8), L.c1));
+    x = _mm512_or_si512(_mm512_and_si512(x, bc(L.k16)), _mm512_sll_epi32(_mm512_srl_epi32(x, L.c16), L.c2));
+    x = _mm512_or_si512(_mm512_and_si512(x, bc(L.k32)), _mm512_sll_epi64(_mm512_srl_epi64(x, L.c32), L.c4));
+    return _mm512_shuffle_epi8(x, bc(L.pk_idx));
+}
+void unpack_row(const Lanes& L, const uint8_t* s, int B, uint8_t* u) {
+    for (int g = 0; g < kCodes / 16; g += 4) {
+        __m512i x = _mm512_castsi128_si512(_mm_loadu_si128((const __m128i*)(s + g * 2 * B)));
+        x = _mm512_inserti32x4(x, _mm_loadu_si128((const __m128i*)(s + (g + 1) * 2 * B)), 1);
+        x = _mm512_inserti32x4(x, _mm_loadu_si128((const __m128i*)(s + (g + 2) * 2 * B)), 2);
+        x = _mm512_inserti32x4(x, _mm_loadu_si128((const __m128i*)(s + (g + 3) * 2 * B)), 3);
+        _mm512_storeu_si512(u + g * 16, unpack64(L, x));
+    }
+}
+/* Four 16 x 16 blocks at once, one a 128-bit lane. */
+void transpose_rev(const uint8_t (*U)[kCodes], uint8_t* T) {
+    for (int c = 0; c < kCodes / 16; c += 4) {
+        __m512i x[16], y[16];
+        for (int q = 0; q < 16; ++q) x[q] = _mm512_loadu_si512(U[15 - q] + 16 * c);
+        for (int round = 0; round < 4; ++round) {
+            for (int i = 0; i < 8; ++i) {
+                y[2 * i] = _mm512_unpacklo_epi8(x[i], x[i + 8]);
+                y[2 * i + 1] = _mm512_unpackhi_epi8(x[i], x[i + 8]);
+            }
+            for (int i = 0; i < 16; ++i) x[i] = y[i];
+        }
+        for (int j = 0; j < 16; ++j) {
+            _mm_storeu_si128((__m128i*)(T + (16 * c + j) * 16), _mm512_extracti32x4_epi32(x[j], 0));
+            _mm_storeu_si128((__m128i*)(T + (16 * (c + 1) + j) * 16), _mm512_extracti32x4_epi32(x[j], 1));
+            _mm_storeu_si128((__m128i*)(T + (16 * (c + 2) + j) * 16), _mm512_extracti32x4_epi32(x[j], 2));
+            _mm_storeu_si128((__m128i*)(T + (16 * (c + 3) + j) * 16), _mm512_extracti32x4_epi32(x[j], 3));
+        }
+    }
+}
+void pack(const Lanes& L, const uint8_t* t, int n, int B, uint8_t* out) {
+    for (int g = 0; g < n / 16; g += 4) {
+        const __m512i x = pack64(L, _mm512_loadu_si512(t + g * 16));
+        _mm_storeu_si128((__m128i*)(out + g * 2 * B), _mm512_extracti32x4_epi32(x, 0));
+        _mm_storeu_si128((__m128i*)(out + (g + 1) * 2 * B), _mm512_extracti32x4_epi32(x, 1));
+        _mm_storeu_si128((__m128i*)(out + (g + 2) * 2 * B), _mm512_extracti32x4_epi32(x, 2));
+        _mm_storeu_si128((__m128i*)(out + (g + 3) * 2 * B), _mm512_extracti32x4_epi32(x, 3));
+    }
+}
+#endif
+
+/* ---- the w2a8 tile --------------------------------------------------------------------------- */
+
+/* Dword d of half lh gathers four bytes of the unit's 32: bytes 8d + lh + {0, 2, 4, 6}, which
+ * are codes 4 lh .. 4 lh + 3 of columns 16 (2d + h) + 8b for (b, h) = (0, 0), (1, 0), (0, 1),
+ * (1, 1), a 4 x 4 matrix of 2-bit fields with group s = b + 2h in byte s. The stored dword has
+ * code j of group s in field 4j + s, its transpose: two delta swaps, the 2 x 2 blocks' corners
+ * then the blocks. */
+inline uint32_t w2_transpose(uint32_t x) {
+    uint32_t t = (x ^ (x >> 6)) & 0x00CC00CCu;
+    x ^= t ^ (t << 6);
+    t = (x ^ (x >> 12)) & 0x0000F0F0u;
+    return x ^ t ^ (t << 12);
+}
+
+#if R3DI_HSIMD_LEVEL == 0
+void w2_row(const uint8_t* s, int64_t kpb, uint8_t* o) {
+    for (int64_t kb = 0; kb < kpb; ++kb, s += 32, o += 512)
+        for (int lh = 0; lh < 2; ++lh)
+            for (int d = 0; d < 4; ++d) {
+                const uint8_t* b = s + 8 * d + lh;
+                const uint32_t x = (uint32_t)b[0] | (uint32_t)b[2] << 8 | (uint32_t)b[4] << 16 |
+                                   (uint32_t)b[6] << 24;
+                const uint32_t w = w2_transpose(x);
+                std::memcpy(o + 256 * lh + 4 * d, &w, 4);
+            }
+}
+#else
+/* A 16-byte lane of a unit holds the bytes of dwords d = 2m, 2m + 1: the shuffle gathers half 0's
+ * two dwords, then half 1's, and the transpose runs on all four. */
+inline __m128i w2_idx() { return _mm_setr_epi8(0, 2, 4, 6, 8, 10, 12, 14, 1, 3, 5, 7, 9, 11, 13, 15); }
+#endif
+
+#if R3DI_HSIMD_LEVEL == 1 || R3DI_HSIMD_LEVEL == 2
+inline __m128i w2_lane(__m128i x, __m128i idx) {
+    x = _mm_shuffle_epi8(x, idx);
+    __m128i t = _mm_and_si128(_mm_xor_si128(x, _mm_srli_epi32(x, 6)), _mm_set1_epi32(0x00CC00CC));
+    x = _mm_xor_si128(x, _mm_xor_si128(t, _mm_slli_epi32(t, 6)));
+    t = _mm_and_si128(_mm_xor_si128(x, _mm_srli_epi32(x, 12)), _mm_set1_epi32(0x0000F0F0));
+    return _mm_xor_si128(x, _mm_xor_si128(t, _mm_slli_epi32(t, 12)));
+}
+void w2_row(const uint8_t* s, int64_t kpb, uint8_t* o) {
+    const __m128i idx = w2_idx();
+    for (int64_t kb = 0; kb < kpb; ++kb, s += 32, o += 512) {
+        const __m128i a = w2_lane(_mm_loadu_si128((const __m128i*)s), idx);
+        const __m128i b = w2_lane(_mm_loadu_si128((const __m128i*)(s + 16)), idx);
+        _mm_storeu_si128((__m128i*)o, _mm_unpacklo_epi64(a, b));
+        _mm_storeu_si128((__m128i*)(o + 256), _mm_unpackhi_epi64(a, b));
+    }
+}
+#elif R3DI_HSIMD_LEVEL == 3
+void w2_row(const uint8_t* s, int64_t kpb, uint8_t* o) {
+    const __m256i idx = _mm256_broadcastsi128_si256(w2_idx());
+    const __m256i k6 = _mm256_set1_epi32(0x00CC00CC), k12 = _mm256_set1_epi32(0x0000F0F0);
+    for (int64_t kb = 0; kb < kpb; ++kb, s += 32, o += 512) {
+        __m256i x = _mm256_shuffle_epi8(_mm256_loadu_si256((const __m256i*)s), idx);
+        __m256i t = _mm256_and_si256(_mm256_xor_si256(x, _mm256_srli_epi32(x, 6)), k6);
+        x = _mm256_xor_si256(x, _mm256_xor_si256(t, _mm256_slli_epi32(t, 6)));
+        t = _mm256_and_si256(_mm256_xor_si256(x, _mm256_srli_epi32(x, 12)), k12);
+        x = _mm256_xor_si256(x, _mm256_xor_si256(t, _mm256_slli_epi32(t, 12)));
+        /* Quadwords (a0, a1, b0, b1) to (a0, b0, a1, b1): half 0, then half 1. */
+        x = _mm256_permute4x64_epi64(x, 0xD8);
+        _mm_storeu_si128((__m128i*)o, _mm256_castsi256_si128(x));
+        _mm_storeu_si128((__m128i*)(o + 256), _mm256_extracti128_si256(x, 1));
+    }
+}
+#elif R3DI_HSIMD_LEVEL == 4
+void w2_row(const uint8_t* s, int64_t kpb, uint8_t* o) {
+    const __m512i idx = _mm512_broadcast_i32x4(w2_idx());
+    const __m512i k6 = _mm512_set1_epi32(0x00CC00CC), k12 = _mm512_set1_epi32(0x0000F0F0);
+    const __m512i perm = _mm512_setr_epi64(0, 2, 1, 3, 4, 6, 5, 7);
+    int64_t kb = 0;
+    /* Two units a step; xor-and-xor is one ternary op. */
+    for (; kb + 2 <= kpb; kb += 2, s += 64, o += 1024) {
+        __m512i x = _mm512_shuffle_epi8(_mm512_loadu_si512(s), idx);
+        __m512i t = _mm512_and_si512(_mm512_xor_si512(x, _mm512_srli_epi32(x, 6)), k6);
+        x = _mm512_ternarylogic_epi32(x, t, _mm512_slli_epi32(t, 6), 0x96);
+        t = _mm512_and_si512(_mm512_xor_si512(x, _mm512_srli_epi32(x, 12)), k12);
+        x = _mm512_ternarylogic_epi32(x, t, _mm512_slli_epi32(t, 12), 0x96);
+        x = _mm512_permutexvar_epi64(perm, x);
+        _mm_storeu_si128((__m128i*)o, _mm512_extracti32x4_epi32(x, 0));
+        _mm_storeu_si128((__m128i*)(o + 256), _mm512_extracti32x4_epi32(x, 1));
+        _mm_storeu_si128((__m128i*)(o + 512), _mm512_extracti32x4_epi32(x, 2));
+        _mm_storeu_si128((__m128i*)(o + 768), _mm512_extracti32x4_epi32(x, 3));
+    }
+    if (kb < kpb) {
+        const __m256i idx2 = _mm512_castsi512_si256(idx);
+        __m256i x = _mm256_shuffle_epi8(_mm256_loadu_si256((const __m256i*)s), idx2);
+        __m256i t = _mm256_and_si256(_mm256_xor_si256(x, _mm256_srli_epi32(x, 6)), _mm512_castsi512_si256(k6));
+        x = _mm256_ternarylogic_epi32(x, t, _mm256_slli_epi32(t, 6), 0x96);
+        t = _mm256_and_si256(_mm256_xor_si256(x, _mm256_srli_epi32(x, 12)), _mm512_castsi512_si256(k12));
+        x = _mm256_ternarylogic_epi32(x, t, _mm256_slli_epi32(t, 12), 0x96);
+        x = _mm256_permute4x64_epi64(x, 0xD8);
+        _mm_storeu_si128((__m128i*)o, _mm256_castsi256_si128(x));
+        _mm_storeu_si128((__m128i*)(o + 256), _mm256_extracti128_si256(x, 1));
+    }
+}
+#endif
+
+/* ---- the 16-row dword transpose ---------------------------------------------------------------- */
+
+void dt_scalar(const uint32_t* in, int64_t stride, int64_t c0, int64_t cols, uint32_t* out) {
+    for (int64_t c = c0; c < cols; ++c)
+        for (int r = 0; r < 16; ++r) out[16 * c + r] = in[r * stride + c];
+}
+
+#if R3DI_HSIMD_LEVEL >= 1
+/* Rows 4g .. 4g + 3 of columns c .. c + 3: v[i] becomes column c + i of those rows. */
+inline void dt_4x4(const uint32_t* in, int64_t stride, int64_t c, int g, __m128i v[4]) {
+    const uint32_t* p = in + 4 * g * stride + c;
+    const __m128i a = _mm_loadu_si128((const __m128i*)p);
+    const __m128i b = _mm_loadu_si128((const __m128i*)(p + stride));
+    const __m128i e = _mm_loadu_si128((const __m128i*)(p + 2 * stride));
+    const __m128i f = _mm_loadu_si128((const __m128i*)(p + 3 * stride));
+    const __m128i ab0 = _mm_unpacklo_epi32(a, b), ab1 = _mm_unpackhi_epi32(a, b);
+    const __m128i ef0 = _mm_unpacklo_epi32(e, f), ef1 = _mm_unpackhi_epi32(e, f);
+    v[0] = _mm_unpacklo_epi64(ab0, ef0);
+    v[1] = _mm_unpackhi_epi64(ab0, ef0);
+    v[2] = _mm_unpacklo_epi64(ab1, ef1);
+    v[3] = _mm_unpackhi_epi64(ab1, ef1);
+}
+#endif
+
+#if R3DI_HSIMD_LEVEL == 1 || R3DI_HSIMD_LEVEL == 2
+void dt_vec(const uint32_t* in, int64_t stride, int64_t cols, uint32_t* out) {
+    int64_t c = 0;
+    for (; c + 4 <= cols; c += 4)
+        for (int g = 0; g < 4; ++g) {
+            __m128i v[4];
+            dt_4x4(in, stride, c, g, v);
+            for (int i = 0; i < 4; ++i) _mm_storeu_si128((__m128i*)(out + 16 * (c + i) + 4 * g), v[i]);
+        }
+    dt_scalar(in, stride, c, cols, out);
+}
+#elif R3DI_HSIMD_LEVEL == 3
+/* Eight columns a step: the 4 x 4 transpose in each 128-bit lane, the high lane columns c + 4 ..
+ * c + 7. */
+void dt_vec(const uint32_t* in, int64_t stride, int64_t cols, uint32_t* out) {
+    int64_t c = 0;
+    for (; c + 8 <= cols; c += 8)
+        for (int g = 0; g < 4; ++g) {
+            const uint32_t* p = in + 4 * g * stride + c;
+            const __m256i a = _mm256_loadu_si256((const __m256i*)p);
+            const __m256i b = _mm256_loadu_si256((const __m256i*)(p + stride));
+            const __m256i e = _mm256_loadu_si256((const __m256i*)(p + 2 * stride));
+            const __m256i f = _mm256_loadu_si256((const __m256i*)(p + 3 * stride));
+            const __m256i ab0 = _mm256_unpacklo_epi32(a, b), ab1 = _mm256_unpackhi_epi32(a, b);
+            const __m256i ef0 = _mm256_unpacklo_epi32(e, f), ef1 = _mm256_unpackhi_epi32(e, f);
+            const __m256i v[4] = { _mm256_unpacklo_epi64(ab0, ef0), _mm256_unpackhi_epi64(ab0, ef0),
+                                   _mm256_unpacklo_epi64(ab1, ef1), _mm256_unpackhi_epi64(ab1, ef1) };
+            for (int i = 0; i < 4; ++i) {
+                _mm_storeu_si128((__m128i*)(out + 16 * (c + i) + 4 * g), _mm256_castsi256_si128(v[i]));
+                _mm_storeu_si128((__m128i*)(out + 16 * (c + 4 + i) + 4 * g), _mm256_extracti128_si256(v[i], 1));
+            }
+        }
+    for (; c + 4 <= cols; c += 4)
+        for (int g = 0; g < 4; ++g) {
+            __m128i v[4];
+            dt_4x4(in, stride, c, g, v);
+            for (int i = 0; i < 4; ++i) _mm_storeu_si128((__m128i*)(out + 16 * (c + i) + 4 * g), v[i]);
+        }
+    dt_scalar(in, stride, c, cols, out);
+}
+#elif R3DI_HSIMD_LEVEL == 4
+/* Four columns a step, each one whole 64-byte column of the tile: four 4 x 4 transposes, one per
+ * group of rows, joined lane by lane. */
+void dt_vec(const uint32_t* in, int64_t stride, int64_t cols, uint32_t* out) {
+    int64_t c = 0;
+    for (; c + 4 <= cols; c += 4) {
+        __m128i v[4][4];
+        for (int g = 0; g < 4; ++g) dt_4x4(in, stride, c, g, v[g]);
+        for (int i = 0; i < 4; ++i) {
+            __m512i z = _mm512_castsi128_si512(v[0][i]);
+            z = _mm512_inserti32x4(z, v[1][i], 1);
+            z = _mm512_inserti32x4(z, v[2][i], 2);
+            z = _mm512_inserti32x4(z, v[3][i], 3);
+            _mm512_storeu_si512(out + 16 * (c + i), z);
+        }
+    }
+    dt_scalar(in, stride, c, cols, out);
+}
+#endif
+
+/* ---- the byte transpose ----------------------------------------------------------------------- */
+
+void bt_scalar(const uint8_t* in, int64_t rows, int64_t cols, int64_t r0, int64_t r1, int64_t c0,
+               int64_t c1, uint8_t* out) {
+    for (int64_t r = r0; r < r1; ++r)
+        for (int64_t c = c0; c < c1; ++c) out[c * rows + r] = in[r * cols + c];
+}
+
+#if R3DI_HSIMD_LEVEL >= 1
+/* A 16 x 16 block at (r, c): four rounds of interleaving rows i and i + 8, as the trellis tile's
+ * transpose (without its row reversal). */
+void bt_block(const uint8_t* in, int64_t rows, int64_t cols, int64_t r, int64_t c, uint8_t* out) {
+    __m128i x[16], y[16];
+    for (int q = 0; q < 16; ++q) x[q] = _mm_loadu_si128((const __m128i*)(in + (r + q) * cols + c));
+    for (int round = 0; round < 4; ++round) {
+        for (int i = 0; i < 8; ++i) {
+            y[2 * i] = _mm_unpacklo_epi8(x[i], x[i + 8]);
+            y[2 * i + 1] = _mm_unpackhi_epi8(x[i], x[i + 8]);
+        }
+        for (int i = 0; i < 16; ++i) x[i] = y[i];
+    }
+    for (int j = 0; j < 16; ++j) _mm_storeu_si128((__m128i*)(out + (c + j) * rows + r), x[j]);
+}
+#endif
+
+#if R3DI_HSIMD_LEVEL == 3 || R3DI_HSIMD_LEVEL == 4
+/* Two 16 x 16 blocks side by side, one a 128-bit lane: rows r .. r + 15, columns c .. c + 31. */
+void bt_block2(const uint8_t* in, int64_t rows, int64_t cols, int64_t r, int64_t c, uint8_t* out) {
+    __m256i x[16], y[16];
+    for (int q = 0; q < 16; ++q) x[q] = _mm256_loadu_si256((const __m256i*)(in + (r + q) * cols + c));
+    for (int round = 0; round < 4; ++round) {
+        for (int i = 0; i < 8; ++i) {
+            y[2 * i] = _mm256_unpacklo_epi8(x[i], x[i + 8]);
+            y[2 * i + 1] = _mm256_unpackhi_epi8(x[i], x[i + 8]);
+        }
+        for (int i = 0; i < 16; ++i) x[i] = y[i];
+    }
+    for (int j = 0; j < 16; ++j) {
+        _mm_storeu_si128((__m128i*)(out + (c + j) * rows + r), _mm256_castsi256_si128(x[j]));
+        _mm_storeu_si128((__m128i*)(out + (c + 16 + j) * rows + r), _mm256_extracti128_si256(x[j], 1));
+    }
+}
+#endif
+
+void bt_run(const uint8_t* in, int64_t rows, int64_t cols, uint8_t* out) {
+#if R3DI_HSIMD_LEVEL == 0
+    bt_scalar(in, rows, cols, 0, rows, 0, cols, out);
+#else
+    const int64_t R = rows / 16 * 16, C = cols / 16 * 16;
+    for (int64_t r = 0; r < R; r += 16) {
+        int64_t c = 0;
+#if R3DI_HSIMD_LEVEL >= 3
+        for (; c + 32 <= C; c += 32) bt_block2(in, rows, cols, r, c, out);
+#endif
+        for (; c < C; c += 16) bt_block(in, rows, cols, r, c, out);
+    }
+    bt_scalar(in, rows, cols, 0, R, C, cols, out);
+    bt_scalar(in, rows, cols, R, rows, 0, cols, out);
+#endif
+}
+
+}  // namespace
+
+extern "C" void R3DI_HSIMD_FN(byte_transpose)(const uint8_t* in, int64_t rows, int64_t cols, uint8_t* out) {
+    bt_run(in, rows, cols, out);
+}
+
+extern "C" void R3DI_HSIMD_FN(dword_transpose16)(const uint32_t* in, int64_t stride, int64_t cols,
+                                                uint32_t* out) {
+#if R3DI_HSIMD_LEVEL == 0
+    dt_scalar(in, stride, 0, cols, out);
+#else
+    dt_vec(in, stride, cols, out);
+#endif
+}
+
+extern "C" void R3DI_HSIMD_FN(w2a8_tile)(const uint8_t* rows, int64_t rb, int64_t kpb, uint8_t* out) {
+    for (int r = 0; r < 16; ++r) w2_row(rows + r * rb, kpb, out + 16 * r);
+}
+
+extern "C" void R3DI_HSIMD_FN(moew4_permute)(const uint8_t* s, uint8_t* d, int64_t bytes, bool fwd) {
+#if R3DI_HSIMD_LEVEL == 0
+    mw_scalar(s, d, bytes, fwd);
+#else
+    mw_vec(s, d, bytes, fwd);
+#endif
+}
+
+extern "C" void R3DI_HSIMD_FN(iqr_trellis_tile)(const uint8_t* rows, int64_t rb, int B, int64_t nkb,
+                                               uint8_t* out) {
+    alignas(64) uint8_t U[16][kCodes];
+    alignas(64) uint8_t T[kCodes * 16];
+    const int64_t per = 16 * B, ub = 256 * B;
+#if R3DI_HSIMD_LEVEL >= 1
+    alignas(64) uint8_t pad[16 * 8 + 64];   /* a row's 16 B bytes with room to read past */
+    alignas(64) uint8_t pk[256 * 8 + 64];   /* a unit with room to write past */
+    const Lanes L(B);
+    bool streamed = false;
+#endif
+    for (int64_t kb = 0; kb < nkb; ++kb) {
+        for (int r = 0; r < 16; ++r) {
+            const uint8_t* s = rows + r * rb + kb * per;
+#if R3DI_HSIMD_LEVEL == 0
+            unpack_row(s, B, U[r]);
+#else
+            /* The vector unpack reads up to 16 bytes past a group; only the tile's last row of
+             * its last unit may end where the plane does. */
+            if (r == 15 && kb == nkb - 1) {
+                std::memcpy(pad, s, (size_t)per);
+                s = pad;
+            }
+            unpack_row(L, s, B, U[r]);
+#endif
+        }
+        transpose_rev(U, T);
+#if R3DI_HSIMD_LEVEL == 0
+        pack(T, kCodes * 16, B, out + kb * ub);
+#else
+        pack(L, T, kCodes * 16, B, pk);
+        streamed |= stream_copy(out + kb * ub, pk, ub);
+#endif
+    }
+#if R3DI_HSIMD_LEVEL >= 1
+    stream_fence(streamed);
+#endif
+}
+
+/* A row's eight qwords of one 64-byte K step: the even ones to lane r, the odd ones to lane
+ * 16 + r, 32 bytes each (r3di_fp8_frag.h, frag_src). */
+/* With `out` aligned the 32-byte pieces go out as streaming stores (stream_copy says why); the two
+ * of a destination line are written by consecutive rows, so the line leaves whole. */
+template <bool kStream>
+inline void fp8_frag_body(const uint8_t* rows, int64_t K, int64_t ksuper, uint8_t* out) {
+#if R3DI_HSIMD_LEVEL == 4
+    const __m512i idx = _mm512_setr_epi64(0, 2, 4, 6, 1, 3, 5, 7);
+#endif
+#if R3DI_HSIMD_LEVEL >= 3
+    auto put = [](uint8_t* d, __m256i v) {
+        if (kStream) _mm256_stream_si256((__m256i*)d, v);
+        else         _mm256_storeu_si256((__m256i*)d, v);
+    };
+#elif R3DI_HSIMD_LEVEL >= 1
+    auto put = [](uint8_t* d, __m128i v) {
+        if (kStream) _mm_stream_si128((__m128i*)d, v);
+        else         _mm_storeu_si128((__m128i*)d, v);
+    };
+#endif
+    for (int64_t ks = 0; ks < ksuper; ++ks) {
+        uint8_t* t = out + ks * 1024;
+        for (int r = 0; r < 16; ++r) {
+            const uint8_t* s = rows + r * K + ks * 64;
+            uint8_t* lo = t + 32 * r;
+            uint8_t* hi = t + 32 * (16 + r);
+#if R3DI_HSIMD_LEVEL == 4
+            const __m512i x = _mm512_permutexvar_epi64(idx, _mm512_loadu_si512(s));
+            put(lo, _mm512_castsi512_si256(x));
+            put(hi, _mm512_extracti64x4_epi64(x, 1));
+#elif R3DI_HSIMD_LEVEL == 3
+            const __m256i a = _mm256_permute4x64_epi64(_mm256_loadu_si256((const __m256i*)s), 0xD8);
+            const __m256i b = _mm256_permute4x64_epi64(_mm256_loadu_si256((const __m256i*)(s + 32)), 0xD8);
+            put(lo, _mm256_permute2x128_si256(a, b, 0x20));
+            put(hi, _mm256_permute2x128_si256(a, b, 0x31));
+#elif R3DI_HSIMD_LEVEL >= 1
+            const __m128i a = _mm_loadu_si128((const __m128i*)s);
+            const __m128i b = _mm_loadu_si128((const __m128i*)(s + 16));
+            const __m128i c = _mm_loadu_si128((const __m128i*)(s + 32));
+            const __m128i d = _mm_loadu_si128((const __m128i*)(s + 48));
+            put(lo, _mm_unpacklo_epi64(a, b));
+            put(lo + 16, _mm_unpacklo_epi64(c, d));
+            put(hi, _mm_unpackhi_epi64(a, b));
+            put(hi + 16, _mm_unpackhi_epi64(c, d));
+#else
+            for (int q = 0; q < 4; ++q) {
+                std::memcpy(lo + 8 * q, s + 16 * q, 8);
+                std::memcpy(hi + 8 * q, s + 16 * q + 8, 8);
+            }
+#endif
+        }
+    }
+}
+
+extern "C" void R3DI_HSIMD_FN(fp8_frag_tile)(const uint8_t* rows, int64_t K, int64_t ksuper,
+                                            uint8_t* out) {
+#if R3DI_HSIMD_LEVEL >= 1
+    if (((uintptr_t)out & 63) == 0) {
+        fp8_frag_body<true>(rows, K, ksuper, out);
+        stream_fence(true);
+        return;
+    }
+#endif
+    fp8_frag_body<false>(rows, K, ksuper, out);
+}
