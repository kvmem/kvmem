diff --git a/crates/hipfire-kvmem/tests/prefix_fork_smoke.rs b/crates/hipfire-kvmem/tests/prefix_fork_smoke.rs
index 2cc448ce97ab543f06e9c4e765feabf12e2954db..352c6b2211bb7d7eb1b5c5d943d77b013976c4ee 100644
--- a/crates/hipfire-kvmem/tests/prefix_fork_smoke.rs
+++ b/crates/hipfire-kvmem/tests/prefix_fork_smoke.rs
@@ -204,3 +204,49 @@ fn snapshot_capture_refuses_a_store_without_packed_records() {
     assert!(!raw.has_packed(1));
     assert!(raw.capture_snapshot(1, None).is_err());
