+        }
+        const int kv=head/(heads/kv_heads);
+        for(int i=0;i<64;++i) {
+            const int key=page*64+i;
+            float dot[Group]={};
+            if(key<end) {
+                const size_t base=(size_t(key)*kv_heads+kv)*Dim;
+                #pragma unroll
+                for(int d=lane;d<Dim;d+=32) {
+                    const size_t at=base+d;
+                    const float k=Quantized ? float(quant.codes[at])*__half2float(reinterpret_cast<const __half*>(quant.scales)[at/32])
+                                            : __half2float(reinterpret_cast<const __half*>(keys)[at]);
+                    #pragma unroll
+                    for(int g=0;g<Group;++g)dot[g]+=query[g][d/32]*k;
+                }
+            }
