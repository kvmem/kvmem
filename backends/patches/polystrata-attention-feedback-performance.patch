+__global__ void page_mass_merge(const float2* parts,const int64_t* cfg,const int32_t* map,
+    float* mass,int stride,int heads,int layers) {
+    const int head=int(blockIdx.x),local=int(blockIdx.y),t=int(threadIdx.x),lane=t&31,warp=t>>5;
