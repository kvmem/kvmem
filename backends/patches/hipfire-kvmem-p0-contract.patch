+fn digest_files(root: &Path, paths: &mut [PathBuf]) -> String {
+    paths.sort_by(|a, b| a.to_string_lossy().cmp(&b.to_string_lossy()));
+    let mut hasher = Sha256::new();
+    for relative in paths.iter() {
+        let display = relative.to_string_lossy().replace('\\', "/");
+        hasher.update(display.as_bytes());
+        hasher.update([0]);
+        let path = root.join(relative);
+        let bytes = fs::read(&path).unwrap_or_else(|error| {
+            panic!("hipfire-kvmem: cannot read {} for pin check: {error}", path.display())
+        });
+        hasher.update(bytes);
+        hasher.update([0]);
+    }
+    let digest = hasher.finalize();
+    let mut output = String::with_capacity(digest.len() * 2);
+    for byte in digest {
+        write!(&mut output, "{byte:02x}").expect("writing to String cannot fail");
+    }
+    output
+}
+
+fn collect_files(directory: &Path, files: &mut Vec<PathBuf>) {
+    let entries = fs::read_dir(directory).unwrap_or_else(|error| {
+        panic!("hipfire-kvmem: cannot read {}: {error}", directory.display())
+    });
+    for entry in entries {
+        let path = entry.expect("reading a directory entry").path();
+        if path.is_dir() {
+            collect_files(&path, files);
+        } else if path.is_file() {
+            files.push(path);
+        }
+    }
