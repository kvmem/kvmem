+void copy_yield_gates_and_recovers() {
+    NgramCopySignal copy;
+    require(!copy.should_copy(0, 1.0F), "an empty match cannot replace neural drafting");
+    require(copy.should_copy(15, 10.0F), "the first copy round must measure yield");
+    copy.observe(15, 0);
+    require(copy.should_copy(15, 10.0F), "one sample must not disable cold-start measurement");
+    copy.observe(15, 0);
+    for (int skipped = 0; skipped < 8; ++skipped) {
+        require(!copy.should_copy(15, 1.0F), "unproductive copies must yield to the neural drafter");
+    }
+    require(copy.should_copy(15, 1.0F), "starved copy sources must receive a bounded probe");
+    copy.observe(15, 15);
+    require(copy.should_copy(15, 1.0F), "a productive probe must reopen copying");
+
+    NgramCopySignal productive;
+    productive.observe(10, 10);
+    productive.observe(10, 10);
+    require(productive.should_copy(10, 7.0F), "long productive copies should beat neural yield");
+    require(!productive.should_copy(2, 7.0F), "a shorter match must be priced at its actual length");
+    require(!productive.should_copy(10, 10.0F / 1.3F), "equal yield at the margin must keep neural drafting");
+    productive.reset();
+    require(productive.expected(10) == 0.0F && productive.should_copy(10, 100.0F),
+            "a new request must not inherit another request's yield or rejection streak");
+
+    NgramCopySignal independent;
+    independent.observe(15, 0);
+    independent.observe(15, 0);
+    require(!independent.should_copy(15, 1.0F) && productive.should_copy(15, 100.0F),
+            "concurrent request estimates must remain independent");
+}
