index 0000000000000000000000000000000000000000..77eaac5c1d1bfd11aa626da9a9fcef038867455a
--- /dev/null
+++ b/src/models/qwen3_5/program/planning/memory_statistics_copy_plan.h
@@ -0,0 +1,37 @@
+#pragma once
+#include "models/qwen3_5/execution/memory_statistics.h"
+#include <optional>
+
+namespace ninfer::models::qwen3_5::detail {
+// Adjacent layers of one rank have the same row pitches. Flatten them into one
+// 2D transfer, preserving each copied byte and every untouched Query tail/head.
+// Key and Query buffers are independent; collect their runs separately so that
+// an interleaved Query descriptor does not split a contiguous Key run.
+template<class Visit>
+void for_each_coalesced_statistics_copy(const execution::MemoryStatistics& statistics,
+                                        bool include_query, std::uint32_t query_count,
+                                        Visit&& visit) {
+    using Copy = execution::MemoryStatisticsCopy;
+    std::optional<Copy> key, query;
+    auto flush = [&](std::optional<Copy>& pending) {
+        if (pending) { visit(*pending); pending.reset(); }
+    };
+    statistics.for_each_host_copy(include_query, query_count, [&](const Copy& copy) {
+        auto& pending = copy.destination_offset < statistics.key_bytes() ? key : query;
+        if (pending && pending->rank == copy.rank &&
+            pending->width_bytes == copy.width_bytes &&
+            pending->destination_pitch == copy.destination_pitch &&
+            static_cast<const std::byte*>(pending->source) +
+                pending->width_bytes * pending->rows == copy.source &&
+            pending->destination_offset + pending->destination_pitch * pending->rows ==
+                copy.destination_offset) {
+            pending->rows += copy.rows;
+        } else {
+            flush(pending);
+            pending = copy;
+        }
+    });
+    flush(key);
+    flush(query);
+}
+} // namespace ninfer::models::qwen3_5::detail
