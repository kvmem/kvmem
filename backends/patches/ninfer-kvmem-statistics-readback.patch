index 0000000000000000000000000000000000000000..dd33536aca587ca5dde20cfa496385160a8bf338
--- /dev/null
+++ b/src/models/qwen3_5/program/planning/attention_feedback_readback.h
@@ -0,0 +1,69 @@
+#pragma once
+
+#include "models/qwen3_5/execution/memory_statistics.h"
+
+#include <array>
+#include <limits>
+
+namespace ninfer::models::qwen3_5::detail {
+
+struct AttentionFeedbackCopy {
+    std::size_t rank;
+    std::int32_t slot;
+    std::int32_t layer;
+    std::uint32_t local_heads;
+    std::size_t native_pages;
+    std::size_t elements;
+    std::size_t host_offset;
+};
+
+struct AttentionFeedbackReadback {
+    std::vector<AttentionFeedbackCopy> copies;
+    std::size_t bytes = 0;
+};
+
+// Preserve the existing layer-then-rank summation order. Separate pinned host
+// destinations let all three products reuse each rank's device scratch/output
+// in stream order, with one completion wait per participating rank.
+inline AttentionFeedbackReadback attention_feedback_readback(
+    const execution::MemoryStatistics& statistics, std::uint32_t head_dim,
+    std::uint32_t rows) {
+    if (!statistics.layers || !head_dim || !rows || rows > 64 ||
+        statistics.query_width % head_dim)
+        throw std::logic_error("KVMem attention readback has invalid geometry");
+    AttentionFeedbackReadback plan;
+    const std::array<std::int32_t, 3> layers{0,
+        static_cast<std::int32_t>(statistics.layers / 2),
+        static_cast<std::int32_t>(statistics.layers - 1)};
+    for (std::int32_t slot = 0; slot < 3; ++slot) {
+        if (slot && layers[slot] == layers[slot - 1]) continue;
+        std::uint64_t heads = 0;
+        for (std::size_t rank = 0; rank < statistics.ranks.size(); ++rank) {
+            const auto& shard = statistics.ranks[rank];
+            if (!shard.attention_queries.data || std::uint64_t(layers[slot]) < shard.first_layer ||
+                std::uint64_t(layers[slot]) >=
+                    std::uint64_t(shard.first_layer) + shard.key_sums.ne[2]) continue;
+            const auto& mass = shard.attention_output;
+            if (shard.attention_queries.ne[0] <= 0 ||
+                shard.attention_queries.ne[0] % head_dim ||
+                shard.attention_queries.ne[2] != 3 || !mass.data ||
+                mass.dtype != DType::FP32 || !mass.is_contiguous() ||
+                mass.ne[0] <= 0 || mass.ne[1] < rows || mass.ne[2] != 1 || mass.ne[3] != 1)
+                throw std::logic_error("KVMem attention readback shard is invalid");
+            const auto local_heads =
+                static_cast<std::uint32_t>(shard.attention_queries.ne[0] / head_dim);
+            const auto elements = std::size_t(mass.ne[0]) * rows;
+            if (elements > (std::numeric_limits<std::size_t>::max() - plan.bytes) / sizeof(float))
+                throw std::overflow_error("KVMem attention readback exceeds host size");
+            plan.copies.push_back({rank, slot, layers[slot], local_heads,
+                static_cast<std::size_t>(mass.ne[0]), elements, plan.bytes});
+            plan.bytes += elements * sizeof(float);
+            heads += local_heads;
+        }
+        if (heads != statistics.query_width / head_dim)
+            throw std::logic_error("KVMem attention feedback does not cover every query head");
+    }
+    return plan;
+}
+
+} // namespace ninfer::models::qwen3_5::detail
