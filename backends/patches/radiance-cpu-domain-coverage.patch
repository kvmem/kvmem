diff --git a/tests/cpu_domain_coverage_test.cpp b/tests/cpu_domain_coverage_test.cpp
new file mode 100644
--- /dev/null
+++ b/tests/cpu_domain_coverage_test.cpp
@@ -0,0 +1,103 @@
+/* Explicit whole-region CPU execution must validate its own execution domain. */
+#include "rad_test.h"
+#include "rad_core.h"
+
+using namespace rad;
+
+namespace {
+Program fixture(bool forced, bool weighted = false) {
+    Program p;
+    p.ops.resize(2);
+    p.ops[1].op = "attn_dense";
+    p.ops[1].index = 1;
+    p.ops[1].host_forced = forced;
+    if (weighted) p.ops[1].weights = {1};
+    return p;
+}
+
+void miss(Program& p, int domain, const char* span = "M <= 256", int index = 1) {
+    Program::Miss m;
+    m.op = "attn_dense";
+    m.index = index;
+    m.domain = domain;
+    m.span = span;
+    m.why = "no kernel matched";
+    p.misses.push_back(m);
+}
+}
+
+TEST(forced_cpu_weightless_attention_needs_no_device_band) {
+    auto p = fixture(true);
+    miss(p, RAD_DOMAIN_DEVICE);
+    CHECK(p.device_holes(false).empty());
+    CHECK(p.device_holes(true).empty());
+}
+
+TEST(forced_cpu_requires_host_even_when_device_kernel_exists) {
+    auto p = fixture(true);
+    miss(p, RAD_DOMAIN_HOST);
+    for (bool host_backend : {false, true}) {
+        const auto holes = p.device_holes(host_backend);
+        CHECK_EQ(holes.size(), 1u);
+        if (holes.size() != 1) continue;
+        CHECK(holes[0] == &p.misses[0]);
+        CHECK_EQ(holes[0]->domain, RAD_DOMAIN_HOST);
+    }
+}
+
+TEST(forced_cpu_without_either_kernel_reports_only_its_host_requirement) {
+    auto p = fixture(true);
+    miss(p, RAD_DOMAIN_DEVICE);
+    miss(p, RAD_DOMAIN_HOST);
+    const auto holes = p.device_holes(false);
+    CHECK_EQ(holes.size(), 1u);
+    if (holes.size() != 1) return;
+    CHECK(holes[0] == &p.misses[1]);
+}
+
+TEST(forced_cpu_coverage_is_per_band_and_per_instance) {
+    auto p = fixture(true);
+    p.ops.resize(3);
+    p.ops[2].op = "attn_dense";
+    p.ops[2].index = 2;
+    miss(p, RAD_DOMAIN_DEVICE, "M <= 128");
+    miss(p, RAD_DOMAIN_DEVICE, "M <= 256");
+    miss(p, RAD_DOMAIN_HOST, "M <= 256");
+    miss(p, RAD_DOMAIN_DEVICE, "M <= 128", 2);
+    const auto holes = p.device_holes(false);
+    CHECK_EQ(holes.size(), 2u);
+    if (holes.size() != 2) return;
+    CHECK(holes[0] == &p.misses[2]);
+    CHECK(holes[1] == &p.misses[3]);
+    CHECK_EQ(holes[0]->domain, RAD_DOMAIN_HOST);
+    CHECK_EQ(holes[1]->domain, RAD_DOMAIN_DEVICE);
+}
+
+TEST(ordinary_weightless_device_ops_do_not_fall_back_to_host) {
+    auto p = fixture(false);
+    miss(p, RAD_DOMAIN_DEVICE);
+    const auto holes = p.device_holes(false);
+    CHECK_EQ(holes.size(), 1u);
+    if (holes.size() != 1) return;
+    CHECK(holes[0] == &p.misses[0]);
+    CHECK(p.device_holes(true).empty());
+}
+
+TEST(ordinary_weighted_host_placement_keeps_existing_rules) {
+    auto p = fixture(false, true);
+    miss(p, RAD_DOMAIN_DEVICE);
+    CHECK(p.device_holes(false).empty());
+    miss(p, RAD_DOMAIN_HOST);
+    const auto holes = p.device_holes(false);
+    CHECK_EQ(holes.size(), 1u);
+    if (holes.size() != 1) return;
+    CHECK(holes[0] == &p.misses[0]);
+}
+
+TEST(optional_host_miss_does_not_reject_ordinary_device_execution) {
+    auto p = fixture(false);
+    miss(p, RAD_DOMAIN_HOST);
+    CHECK(p.device_holes(false).empty());
+}
+
+RAD_TEST_MAIN()
