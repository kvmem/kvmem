+++ b/terminal/serve/test_kvmem.py
@@ -0,0 +1,97 @@
+"""Focused KVMem frontend tests, including multimodal query-span expansion."""
+from __future__ import annotations
+
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+
+sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
+
+from serve.frontend import ChatTemplate  # noqa: E402
+from serve.kvmem import Prompt  # noqa: E402
+from serve.server import ByteTokenizer, MockEngine, Service  # noqa: E402
+
+
+ROOT = Path(__file__).resolve().parents[1]
+
+
+class FakeVision:
+    def __init__(self, directory: str):
+        self.dir = Path(directory)
+        self.rows = self.dir / "image.sve"
+        self.rows.write_bytes(b"rows")
+
+    def encode(self, source):
+        return self.rows, 5
+
+
+class KvmemVisionQuery(unittest.TestCase):
+    def service(self, directory):
+        tok = ByteTokenizer()
+        engine = MockEngine(tok, "ok", max_context=4096)
+        engine.info = {"kvmem": 1}
+        return tok, Service(engine, tok, ChatTemplate(ROOT / "serve/chat_template.jinja"),
+                            vision=FakeVision(directory))
+
+    def test_image_before_query_keeps_exact_text_span(self):
+        with tempfile.TemporaryDirectory() as directory:
+            tok, svc = self.service(directory)
+            messages = [{"role": "user", "content": [
+                {"type": "image", "source": "x.png"},
+                {"type": "text", "text": "answer only CODE-7319"},
+            ]}]
+            ids, _, _ = svc.prepare(messages, None, {}, max_new=8)
+            self.assertIsInstance(ids, Prompt)
+            begin, end = ids.kvmem_query
+            query = tok.decode(ids[begin:end])
+            self.assertIn("answer only CODE-7319", query)
+            self.assertNotIn("<|image_pad|>", query)
+            self.assertEqual(ids.count(tok.encode("<|image_pad|>", parse_special=True)[0]), 5)
+            svc.drop_embeddings()
+
+    def test_optional_history_template_failure_keeps_valid_generation(self):
+        with tempfile.TemporaryDirectory() as directory:
+            path = Path(directory) / 'custom.jinja'
+            path.write_text('{% if not add_generation_prompt %}{{ missing.history }}{% endif %}'
+                            '{% for m in messages %}<{{ m.role }}>{{ m.content }}</{{ m.role }}>{% endfor %}'
+                            '{% if add_generation_prompt %}<assistant>{% endif %}', encoding='utf-8')
+            tok = ByteTokenizer()
+            engine = MockEngine(tok, 'ok', max_context=4096)
+            engine.info = {'kvmem': 1}
+            svc = Service(engine, tok, ChatTemplate(path))
+            ids, _, _ = svc.prepare([{'role':'user','content':'answer normally'}],None,{},max_new=8)
+            self.assertIsInstance(ids, Prompt)
+            self.assertEqual(ids.kvmem_canonical_end, -1)
+            self.assertIn('answer normally', tok.decode(ids))
+
+    def test_required_template_failure_still_rejects_request(self):
+        with tempfile.TemporaryDirectory() as directory:
+            path = Path(directory) / 'invalid.jinja'
+            path.write_text("{{ raise_exception('required prompt invalid') }}", encoding='utf-8')
+            tok = ByteTokenizer()
+            engine = MockEngine(tok, 'ok', max_context=4096)
+            engine.info = {'kvmem': 1}
+            svc = Service(engine, tok, ChatTemplate(path))
+            with self.assertRaisesRegex(ValueError, 'required prompt invalid'):
+                svc.prepare([{'role':'user','content':'valid text'}],None,{},max_new=8)
+
+    def test_image_between_text_parts_expands_inside_query(self):
+        with tempfile.TemporaryDirectory() as directory:
+            tok, svc = self.service(directory)
+            messages = [{"role": "user", "content": [
+                {"type": "text", "text": "read this "},
+                {"type": "image", "source": "x.png"},
+                {"type": "text", "text": " and return CODE-7319"},
+            ]}]
+            ids, _, _ = svc.prepare(messages, None, {}, max_new=8)
+            begin, end = ids.kvmem_query
+            query = tok.decode(ids[begin:end])
+            self.assertIn("read this", query)
+            self.assertIn("return CODE-7319", query)
+            self.assertEqual(ids[begin:end].count(tok.encode("<|image_pad|>", parse_special=True)[0]), 5)
+            svc.drop_embeddings()
+
+
+if __name__ == "__main__":
+    unittest.main()
