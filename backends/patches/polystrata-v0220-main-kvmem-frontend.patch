+  .st-tab { padding: 0 8px; }
+  #pill-text { display: none; }
+  .chat { padding: var(--st-s-5) var(--st-s-4); }
+  .composer-wrap { padding: 0 var(--st-s-3) var(--st-s-3); }
+  .monitor, .about { padding: var(--st-s-4); }
+  .facts { grid-template-columns: 1fr; gap: 2px; }
+  .facts dd { margin-bottom: var(--st-s-2); }
+}
+
+/* the header's model list (more than one model installed) */
+.model-select{height:30px;max-width:280px;padding:0 var(--st-s-2);border-radius:var(--st-r-md);border:1px solid var(--st-line);background:var(--st-surface-2);color:var(--st-ink);font:inherit;font-size:var(--st-fs-sm)}
+.model-select:disabled{opacity:.6}
+/* Images tab (POST /v1/images/generations) */
+.img-form{display:flex;flex-direction:column;gap:12px}
+.img-prompt{height:auto;padding:10px 14px;resize:vertical}
+.img-row{display:flex;gap:12px;align-items:flex-end;flex-wrap:wrap}
+.img-results{display:flex;flex-direction:column;gap:12px}
+.img-results figure{margin:0}
+.img-results img{max-width:100%;border-radius:var(--st-r-lg);display:block}
+.img-results figcaption{font-size:var(--st-fs-sm, 13px);color:var(--st-ink-2, inherit);margin-top:4px}
+
+/* Swipes and Regeneration */
+.swipe-count { font-size: 11px; opacity: 0.7; padding: 0 4px; align-self: center; }
+.st-msg__meta { display: flex; align-items: center; gap: 4px; flex-wrap: wrap; }
+.st-msg__meta [data-msg-regen]:disabled { opacity: 0.4; cursor: not-allowed; }
+
+/* Editing user messages */
+.edit-box { width: 100%; box-sizing: border-box; font: inherit; resize: vertical; min-height: 2.5em; }
+.edit-actions { display: flex; gap: 6px; margin-top: 6px; }
