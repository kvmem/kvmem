diff --git a/terminal/serve/test_web_sampling.py b/terminal/serve/test_web_sampling.py
new file mode 100644
index 0000000..2e38914
--- /dev/null
+++ b/terminal/serve/test_web_sampling.py
@@ -0,0 +1,82 @@
+"""serve/test_web_sampling.py - the web page sends no sampling of its own until the user changes it (0.1.45, #2685).
+
+The page used to send temperature 0.6 / top_p 0.95 / top_k 20 with every request, so the server's model-card defaults
+(thinking 1.0, not thinking 0.7 + presence penalty) never applied to it.  Pins, with node, the page's own functions:
+KVMem resolves displayed values from the service and sends only explicit chat overrides;
+an explicit value equal to a default is still an override, and 0 is greedy.
+Skipped without node.
+
+    python -m unittest serve.test_web_sampling -v
+"""
+from __future__ import annotations
+
+import json
+import shutil
+import subprocess
+import unittest
+from pathlib import Path
+
+APP = Path(__file__).resolve().parent / "web" / "kvmem-app.js"
+
+
+def slice_between(src: str, start: str, end: str) -> str:
+    a = src.index(start)
+    return src[a:src.index(end, a)]
+
+
+@unittest.skipUnless(shutil.which("node"), "node is not installed")
+class WebSampling(unittest.TestCase):
+    @classmethod
+    def setUpClass(cls):
+        src = APP.read_text(encoding="utf-8")
+        cls.defaults = slice_between(src, "const DEFAULTS", "let settings")
+        cls.shared = slice_between(src, "function sharedDefaults", "async function saveShared")
+        cls.keys = slice_between(src, "const settingKeys =", "function resolveChatSettings")
+        cls.body = slice_between(src, "  for (const [key, value] of Object.entries(chatOverrides)) {",
+                                 "  if (projectionLoaded())")
+
+    def run_js(self, settings: dict, pieces: str, overrides: dict):
+        js = (self.defaults + "function projectionLoaded() { return false; }\n" + self.shared +
+              self.keys + f"\nconst settings = {json.dumps(settings)};\n"
+              f"const chatOverrides = {json.dumps(overrides)};\nconst body = {{}};\n{pieces}\n"
+              "console.log(JSON.stringify({body, shared: sharedDefaults(settings)}));")
+        out = subprocess.run(["node", "-e", js], capture_output=True, text=True, timeout=30)
+        self.assertEqual(out.returncode, 0, out.stderr)
+        return json.loads(out.stdout)
+
+    def sampling(self, overrides=None, **kw):
+        s = {"thinking": "high", "temperature": 1.0, "top_p": 0.95, "top_k": 20,
+             "max": "", "seed": "", "esp": True, "budget": 0}
+        s.update(kw)
+        r = self.run_js(s, self.body, overrides or {})
+        return r["body"], r["shared"]
+
+    def test_untouched_sends_nothing(self):
+        for t in (1.0, 0.6):                       # the shown default, and the old stored default
+            body, shared = self.sampling(temperature=t)
+            self.assertEqual(body, {})
+            self.assertEqual(shared, {"reasoning_effort": "high", "reasoning_budget_tokens": 0})
+
+    def test_only_explicit_changes_are_sent(self):
+        body, shared = self.sampling(overrides={"temperature": 0.3}, temperature=0.3)
+        self.assertEqual(body, {"temperature": 0.3})
+        self.assertEqual(shared["temperature"], 0.3)
+        body, _ = self.sampling(overrides={"top_k": 40}, top_k=40)
+        self.assertEqual(body, {"top_k": 40})
+        body, _ = self.sampling(overrides={"temperature": 0.6}, temperature=0.6, top_p=0.9)
+        self.assertEqual(body["temperature"], 0.6)
+
+    def test_zero_is_greedy(self):
+        body, shared = self.sampling(overrides={"temperature": 0}, temperature=0)
+        self.assertEqual(body, {"temperature": 0})
+        self.assertEqual(shared["temperature"], 0)
+
+    def test_service_values_do_not_become_overrides(self):
+        body, _ = self.sampling(temperature=0.2, top_p=0.7, top_k=31)
+        self.assertEqual(body, {})
+        body, _ = self.sampling(overrides={"temperature": 1.0, "preserve": False})
+        self.assertEqual(body, {"temperature": 1.0, "chat_template_kwargs": {"preserve_thinking": False}})
+
+
+if __name__ == "__main__":
+    unittest.main()
