+                                   box-shadow: var(--st-sh-card); }
+.drawer-actions { display: grid; grid-template-columns: 1fr 1fr; gap: var(--st-s-3); flex-shrink:0; padding:14px 20px; border-top:1px solid var(--st-line); }
+.st-toast { animation: toast-in 180ms var(--st-ease); }
+@keyframes toast-in { from { opacity: 0; transform: translateY(6px); } }
+
+/* ---------------------------------------------------------------- narrow screens */
+/* tabs that do not fit the header (a narrow phone, or Images on) scroll instead of widening the page */
