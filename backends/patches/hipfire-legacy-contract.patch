+            catalog.lookup(&[1, 2, 3], None, 2, true).unwrap(),
+            vec![text]
+        );
+        assert_eq!(
+            catalog.lookup(&[1, 2, 3], Some(77), 2, true).unwrap(),
+            vec![image]
+        );
+        assert!(catalog
+            .lookup(&[1, 2, 3], Some(78), 3, true)
+            .unwrap()
+            .is_empty());
+        assert!(catalog
+            .lookup(&[1, 2, 3], Some(77), 1, true)
+            .unwrap()
+            .is_empty());
+        assert!(catalog
+            .lookup(&[1, 2, 3], None, 0, true)
+            .unwrap()
+            .is_empty());
