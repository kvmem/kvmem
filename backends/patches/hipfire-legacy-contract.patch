+
+    #[test]
+    fn native_frontier_can_precede_transcript_but_is_not_full_continuation() {
+        let mut catalog = LegacyHistoryCatalog::new(1, 100).unwrap();
+        let id = catalog
+            .publish(1, 1, vec![1, 2, 99], 2, None, 1, 0)
