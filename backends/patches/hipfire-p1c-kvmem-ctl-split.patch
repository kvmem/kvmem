+    /// and reuse forks it directly (Mean-K preserved).
+    #[test]
+    fn single_tier_pack_freeze_and_reuse() {
+        std::env::set_var("HIPFIRE_KVMEM_HOST_BYTES", "16777216");
+        let dir = std::env::temp_dir().join(format!("kvmem-cache-test-{}", std::process::id()));
