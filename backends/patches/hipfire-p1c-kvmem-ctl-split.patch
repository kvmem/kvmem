index 0000000000000000000000000000000000000000..0ecd51adffe1b51799d82b6ca3f4c238333067f6
--- /dev/null
+++ b/crates/hipfire-arch-qwen35/src/kvmem_ctl/plan.rs
@@ -0,0 +1,563 @@
+// SPDX-License-Identifier: Apache-2.0
+// Copyright (c) 2026 Kaden Schutt
+// hipfire — see LICENSE and NOTICE in the project root.
+
+use super::*;
+
+impl KvMemCtl {
+    pub fn new(
+        n_slots: usize,
+        plan: &KvMemPlan,
+        geom: &KvMemGeometry,
+    ) -> Result<Self, String> {
+        let strategy = resolve_recall_strategy(env_raw("HIPFIRE_KVMEM_RECALL_STRATEGY"))?;
+        Self::new_with_strategy(n_slots, plan, geom, strategy)
+    }
+
+    /// Construct with the recall strategy injected instead of read from the
+    /// process config. The config is a START-TIME SNAPSHOT
+    /// (`hipfire_config::active_or_local_process_config` is a `OnceLock`), so a
+    /// test that `set_var`s `HIPFIRE_KVMEM_RECALL_STRATEGY` after the first
+    /// config read would be an order-dependent coin flip; injecting the strategy
+    /// avoids that. `pub(crate)` so the cross-module P4.1② G1 driver fixture can
+    /// construct a Layerwise controller deterministically (the env-snapshot
+    /// `new` cannot). Visibility-only widening — no production behaviour change.
+    pub(crate) fn new_with_strategy(
+        n_slots: usize,
+        plan: &KvMemPlan,
+        geom: &KvMemGeometry,
+        strategy: RecallStrategy,
+    ) -> Result<Self, String> {
+        Self::construct(n_slots, plan, geom, strategy, None)
+    }
+
+    pub fn new_with_config(
+        n_slots: usize,
+        plan: &KvMemPlan,
+        geom: &KvMemGeometry,
+        config: Option<&hipfire_config::kvmem::ResolvedConfig>,
+    ) -> Result<Self, String> {
+        match config {
+            Some(config) => {
+                if !config.enabled || config.block_tokens as usize != KV_BLOCK_TOKENS
+                    || config.budget_tokens as usize / KV_BLOCK_TOKENS != plan.budget_blocks
+                {
+                    return Err("kvmem: resolved Legacy configuration differs from admitted pool geometry".into());
+                }
+                Self::construct(n_slots, plan, geom, RecallStrategy::Legacy, Some(config.clone()))
+            }
+            None => Self::new(n_slots, plan, geom),
+        }
+    }
+
+    fn construct(
+        n_slots: usize,
+        plan: &KvMemPlan,
+        geom: &KvMemGeometry,
+        strategy: RecallStrategy,
+        legacy: Option<hipfire_config::kvmem::ResolvedConfig>,
+    ) -> Result<Self, String> {
+        if n_slots == 0 || geom.n_fa_layers == 0 || geom.head_dim == 0 {
+            return Err("kvmem: zero-sized controller request".to_string());
+        }
+        let k_width = geom.n_kv_heads * geom.head_dim;
+        let q_width = geom.n_heads * geom.head_dim;
+        // P4.1② G3 (design §A.8): under Layerwise + native MTP the host co-archive
+        // is the COMPOSITE `kvmem-main-mtp-pages-v4` record — the trunk's
+        // `n_fa_layers` ordinals PLUS one appended head aux plane at ordinal
+        // `n_fa_layers` (ninfer `model = layer_types.size()`). The core raw store
+        // lays each layer out as an INDEPENDENT per-block allocation
+        // (raw_kv_store.cpp:154/404), so appending the aux ordinal leaves every
+        // trunk layer's bytes untouched (the trunk write/restore loops address
+        // `0..n_fa_layers` only). Legacy / AR-only keep `n_fa_layers` exactly, so
+        // the default record is byte-neutral. The trunk GPU paged arena is
+        // UNCHANGED; only this host record gains the aux layer.
+        let head_plane = strategy.is_layerwise() && geom.mtp_head;
+        let n_record_layers = if head_plane { geom.n_fa_layers + 1 } else { geom.n_fa_layers };
+        let raw_cfg = RawStoreConfig {
+            n_layer: n_record_layers as u32,
+            n_embd_k: k_width as u32,
+            n_embd_v: k_width as u32,
+            block_tokens: KV_BLOCK_TOKENS as u32,
+            k_row_bytes: 0,
+            k_gpu_row_bytes: geom.per_pos_bytes as u64,
+            v_gpu_row_bytes: geom.per_pos_v_bytes as u64,
+        };
+        let sink = legacy.as_ref().map_or_else(
+            || env_usize("HIPFIRE_KVMEM_SINK_BLOCKS").unwrap_or(1),
+            |c| c.sink_tokens as usize / KV_BLOCK_TOKENS,
+        );
+        let recent = legacy.as_ref().map_or_else(
+            || env_usize("HIPFIRE_KVMEM_RECENT_BLOCKS").unwrap_or(1),
+            |c| c.recent_tokens as usize / KV_BLOCK_TOKENS,
+        );
+        if sink + recent > plan.budget_blocks {
+            return Err(format!(
+                "kvmem: sink ({sink}) + recent ({recent}) blocks exceed the \
+                 residency budget ({}); lower HIPFIRE_KVMEM_SINK_BLOCKS / \
+                 HIPFIRE_KVMEM_RECENT_BLOCKS or raise the budget",
+                plan.budget_blocks
+            ));
+        }
+        let budget_tokens = (plan.budget_blocks * KV_BLOCK_TOKENS) as u32;
+        let gen_reserve = legacy.as_ref().map_or_else(
+            || env_u64("HIPFIRE_KVMEM_GEN_RESERVE").unwrap_or(DEFAULT_GEN_RESERVE),
+            |c| u64::from(c.gen_reserve_tokens),
+        );
+        if gen_reserve == 0 {
+            return Err("kvmem: HIPFIRE_KVMEM_GEN_RESERVE must be positive".to_string());
+        }
+        let checkpoint_retention = match env_raw("HIPFIRE_KVMEM_CHECKPOINT_POLICY").as_deref() {
+            Some("spread") => {
+                let count = env_usize("HIPFIRE_KVMEM_CHECKPOINT_COUNT").unwrap_or(4).clamp(1, 64);
+                let mib = env_u64("HIPFIRE_KVMEM_CHECKPOINT_MIB").unwrap_or(512).max(1);
+                let interval = env_u64("HIPFIRE_KVMEM_CHECKPOINT_INTERVAL").unwrap_or(4096).max(1);
+                let min_gap = env_u64("HIPFIRE_KVMEM_CHECKPOINT_MIN_GAP").unwrap_or(0);
+                Some((count, mib << 20, interval, min_gap))
+            }
+            _ => None,
+        };
+
+        // ── opt-in policy knobs (defaults reproduce the historical behaviour) ──
+        // LRFU replaces the raw retrieval score with a decaying heavy-hitter
+        // history in the core's `selection_score`; lambda/top tune that decay.
+        let lrfu = legacy.as_ref().map_or_else(|| env_flag("HIPFIRE_KVMEM_LRFU"), |c| c.lrfu);
+        let lrfu_lambda = legacy.as_ref().map_or_else(
+            || env_f64("HIPFIRE_KVMEM_LRFU_LAMBDA").unwrap_or(0.5), |c| c.lrfu_lambda,
+        );
+        let lrfu_top = legacy.as_ref().map_or_else(
+            || env_f64("HIPFIRE_KVMEM_LRFU_TOP").unwrap_or(0.9), |c| c.lrfu_top_fraction,
+        );
+        let select_method = match legacy.as_ref().map(|_| "retrieval".to_string())
+            .or_else(|| env_raw("HIPFIRE_KVMEM_SELECT_METHOD")) {
+            Some(v) => parse_select_method(&v).ok_or_else(|| {
+                format!("kvmem: HIPFIRE_KVMEM_SELECT_METHOD={v} invalid (retrieval|h2o|recency)")
+            })?,
+            None => 0,
+        };
+        if select_method == 1 {
+            return Err(
+                "kvmem: SELECT_METHOD=h2o needs the per-block attention-heat tap \
+                 (hipfire-h2o-heat patch); use retrieval or recency for now"
+                    .to_string(),
+            );
+        }
+        // The core KvMemStore constructor enforces this; fail here with a clear
+        // message instead of an opaque C++ exception at store creation.
+        if lrfu && select_method != 0 {
+            return Err("kvmem: LRFU requires SELECT_METHOD=retrieval (core constraint)".to_string());
+        }
+        if lrfu {
+            if !(0.0..=1.0).contains(&lrfu_lambda) {
+                return Err(format!("kvmem: LRFU_LAMBDA={lrfu_lambda} out of range [0,1]"));
+            }
+            if !(lrfu_top > 0.0 && lrfu_top <= 1.0) {
+                return Err(format!("kvmem: LRFU_TOP={lrfu_top} out of range (0,1]"));
+            }
+        }
+        // Watermark ratios are stored on the config; the page thresholds are
+        // derived from the CORE watermark functions after the stores exist.
+        let wm_high_env = if legacy.is_none() { env_f64("HIPFIRE_KVMEM_GPU_HIGH_WATERMARK") } else { None };
+        let wm_low_env = if legacy.is_none() { env_f64("HIPFIRE_KVMEM_GPU_LOW_WATERMARK") } else { None };
+        let watermark_enabled = wm_high_env.is_some() || wm_low_env.is_some();
+        let wm_high = wm_high_env.unwrap_or(0.95);
+        let wm_low = wm_low_env.unwrap_or(0.85);
+        if watermark_enabled
+            && (!(wm_high > 0.0 && wm_high <= 1.0)
+                || !(wm_low > 0.0 && wm_low <= 1.0)
+                || wm_low > wm_high)
+        {
+            return Err(format!(
+                "kvmem: GPU_HIGH/LOW_WATERMARK must satisfy 0 < low <= high <= 1 \
+                 (got high={wm_high}, low={wm_low})"
+            ));
+        }
+
+        // Query span: 1 keeps the single-row mean-K retrieval (byte-identical);
+        // >1 accumulates a per-slot host Q ring and scores by page-softmax.
+        let query_span = if legacy.is_some() { 1 } else {
+            env_usize("HIPFIRE_KVMEM_QUERY_SPAN").unwrap_or(1)
+        };
+        if !(1..=512).contains(&query_span) {
+            return Err(format!(
+                "kvmem: HIPFIRE_KVMEM_QUERY_SPAN={query_span} out of range [1,512]"
+            ));
+        }
+
+        // ── Layerwise fail-closed policy guards (design §4, R2d-D1) ──
+        // Pure decision table (see resolve_layerwise_policy): under Layerwise
+        // each global working-set knob the per-layer subsystem replaces is an
+        // explicit Err; Legacy is admitted unconditionally (range checks above
+        // already ran), so the default serve stays byte-neutral.
+        resolve_layerwise_policy(strategy, select_method, lrfu, watermark_enabled, query_span)?;
+
+        // P4.1③ H5: resolve the head-history policy (FirstLayer auto-default under
+        // Layerwise+MTP; UpstreamGlobal opt-in via env). Legacy / AR-only carry
+        // Unspecified unread, so the default serve stays byte-neutral.
+        let layerwise_mtp_history = resolve_layerwise_mtp_history(
+            env_raw("HIPFIRE_KVMEM_LAYERWISE_MTP_HISTORY"),
+            strategy,
+            geom.mtp_head,
+        )?;
+
+        // Recall execution model. Legacy (the default) keeps the historical
+        // whole-working-set path byte-identical. Layerwise enables the per-layer
+        // composite-slot subsystem: D2 adds the write-through sealed host
+        // archive; the driver + packed GPU residency land in D3/D4. The strategy
+        // is injected by `new` (env) or `new_with_strategy` (tests) so every
+        // downstream Layerwise-only path shares one switch.
+
+        let kv_cfg = KvStoreConfig {
+            block_tokens: KV_BLOCK_TOKENS as u32,
+            select_budget: budget_tokens,
+            prefill_budget: 0,
+            gen_budget: budget_tokens,
+            sink_blocks: sink as u32,
+            recent_blocks: recent as u32,
+            select_method,
+            lrfu: lrfu as u32,
+            lrfu_lambda,
+            lrfu_top_fraction: lrfu_top,
+            gpu_high_watermark: wm_high,
+            gpu_low_watermark: wm_low,
+            ..KvStoreConfig::default()
+        };
+
+        let host_bytes = legacy.as_ref().map_or_else(
+            || env_u64("HIPFIRE_KVMEM_HOST_BYTES").unwrap_or(DEFAULT_HOST_BYTES).max(1),
+            |c| c.host_bytes,
+        );
+        // 期3 G3: internal content groups (fairness-only; ninfer
+        // `--kvmem-sessions` analogue). 0 keeps the historical LRU catalog.
+        let content_groups = env_usize("HIPFIRE_KVMEM_CONTENT_GROUPS").unwrap_or(0);
+        if content_groups > 1024 {
+            return Err(format!(
+                "kvmem: HIPFIRE_KVMEM_CONTENT_GROUPS={content_groups} out of range [0,1024]"
+            ));
+        }
+        // 期3 G3 single-tier: `HIPFIRE_KVMEM_CACHE_DIR` owns the PERSISTENT
+        // pack tier. Packs are the one persistent copy, billed under
+        // `HIPFIRE_KVMEM_CACHE_BYTES` and separate from the spill account;
+        // there is no second storage account (the cache metrics stay 0).
+        let content_cache_dir = env_raw("HIPFIRE_KVMEM_CACHE_DIR").filter(|d| !d.is_empty());
+        if let Some(dir) = content_cache_dir.as_ref() {
+            let dir = PathBuf::from(dir);
+            std::fs::create_dir_all(&dir)
+                .map_err(|e| format!("kvmem cache dir {}: {e}", dir.display()))?;
+            if let Some(spill) = env_raw("HIPFIRE_KVMEM_SPILL_DIR") {
+                if !spill.is_empty() && PathBuf::from(&spill) == dir {
+                    return Err("kvmem: HIPFIRE_KVMEM_CACHE_DIR must differ from \
+                                HIPFIRE_KVMEM_SPILL_DIR (separate accounts)"
+                        .to_string());
+                }
+            }
+        }
+        let content_cache_dir = content_cache_dir.map(PathBuf::from);
+
+        // 期3 G3 P1.1: pack files live beside the content account; scanning
+        // here rebuilds the cold index after a restart (metadata only).
+        let cold_bytes = env_u64("HIPFIRE_KVMEM_CACHE_BYTES")
+            .unwrap_or(DEFAULT_CONTENT_CACHE_BYTES)
+            .max(1);
+        let cold_dir = content_cache_dir;
+        let cold_packs = match cold_dir.as_ref() {
+            Some(dir) => ColdPackIndex::scan(
+                dir,
+                layout_fingerprint(&raw_cfg),
+                n_record_layers as u32,
+                KV_BLOCK_TOKENS as u32,
+                1 << 20,
+            ),
+            None => ColdPackIndex::default(),
+        };
+        let (spill_dir, spill_bytes) = match legacy.as_ref() {
+            Some(c) => (c.disk_path.clone(), c.disk_bytes),
+            None => (
+                env_raw("HIPFIRE_KVMEM_SPILL_DIR").map(PathBuf::from),
+                env_u64("HIPFIRE_KVMEM_SPILL_BYTES").unwrap_or(DEFAULT_SPILL_BYTES).max(1),
+            ),
+        };
+        let storage = match spill_dir {
+            Some(dir) => {
+                std::fs::create_dir_all(&dir)
+                    .map_err(|e| format!("kvmem spill dir {}: {e}", dir.display()))?;
+                Storage::new_tiered(host_bytes, &dir, spill_bytes)
+            }
+            None => Storage::new_ram(host_bytes),
+        }
+        .map_err(|e| format!("kvmem storage: {e}"))?;
+
+        let mut slots = Vec::with_capacity(n_slots);
+        let ring_cap = if query_span > 1 {
+            n_record_layers * query_span * q_width
+        } else {
+            0
+        };
+        for _ in 0..n_slots {
+            slots.push(SlotState {
+                raw: RawStore::new(raw_cfg, Some(&storage))
+                    .map_err(|e| format!("kvmem raw store: {e}"))?,
+                kv: KvStore::new(&kv_cfg).map_err(|e| format!("kvmem store: {e}"))?,
+                last_select_full: 0,
+                fed: 0,
+                turn_start: 0,
+                first_decode_done: false,
+                q_ring: vec![0f32; ring_cap],
+                q_ring_len: 0,
+                q_ring_cursor: 0,
+                lw_incarnation: 0,
+                lw_seq: 0,
+                lw_pressure: None,
+                lw_output_pressure: None,
+                lw_keep: Vec::new(),
+                lw_query_due: false,
+                request_query: None,
+                last_query: None,
+                convo_group: 0,
+                last_freeze_id: None,
+                lw_import_blocks: Cell::new(None),
+                lw_pending_output: None,
+                lw_head: None,
+                lw_aux_selection: None,
+            });
+        }
+
+        // Derive the watermark hysteresis band from the CORE watermark functions
+        // applied to the per-slot resident budget pool (budget_blocks pages):
+        // keep_target <= spill_trigger <= budget_blocks, so the band can only
+        // make residency more conservative than the default, never overshoot the
+        // physical pool. The keep target narrows the core selection budget via
+        // set_runtime_select_budget (re-applied on reset_slot).
+        let watermark = if watermark_enabled {
+            let high_tok = slots[0].kv.gpu_high_watermark_tokens(budget_tokens);
+            let low_tok = slots[0].kv.gpu_low_watermark_tokens(budget_tokens);
+            let trigger = (high_tok as usize / KV_BLOCK_TOKENS).clamp(1, plan.budget_blocks);
+            let keep = (low_tok as usize / KV_BLOCK_TOKENS).clamp(1, trigger);
+            if keep < sink + recent {
+                return Err(format!(
+                    "kvmem: watermark keep target ({keep} blocks) is below sink+recent \
+                     ({}); raise GPU_LOW_WATERMARK or lower SINK/RECENT_BLOCKS",
+                    sink + recent
+                ));
+            }
+            for st in &slots {
+                st.kv
+                    .set_runtime_select_budget((keep * KV_BLOCK_TOKENS) as u32)
+                    .map_err(|e| format!("kvmem watermark select budget: {e}"))?;
+            }
+            Some((trigger, keep))
+        } else {
+            None
+        };
+
+        if (time_flag() || env_flag("HIPFIRE_KVMEM_TRACE"))
+            && (lrfu || select_method != 0 || watermark_enabled || query_span > 1 || strategy.is_layerwise())
+        {
+            eprintln!(
+                "[kvmem] policy: strategy={strategy:?} select_method={select_method} lrfu={lrfu} \
+                 lambda={lrfu_lambda} top={lrfu_top} watermark={watermark:?} \
+                 query_span={query_span} budget_blocks={} content_groups={content_groups}",
+                plan.budget_blocks
+            );
+        }
+
+        // Resolve the layerwise activation quotas only under Layerwise; Legacy
+        // carries the unread ninfer seeds so a malformed quota env can never
+        // change the byte-neutral default path (design §3.11).
+        let layerwise_quotas = if strategy.is_layerwise() {
+            resolve_layerwise_quotas(
+                env_raw("HIPFIRE_KVMEM_LAYERWISE_ACTIVATION_RAM_MIB"),
+                env_raw("HIPFIRE_KVMEM_LAYERWISE_ACTIVATION_DISK_MIB"),
+                env_raw("HIPFIRE_KVMEM_LAYERWISE_STAGING_MIB"),
+                env_raw("HIPFIRE_KVMEM_LAYERWISE_METADATA_MIB"),
+                env_raw("HIPFIRE_KVMEM_LAYERWISE_ACTIVATION_METADATA_MIB"),
+                env_raw("HIPFIRE_KVMEM_SPILL_DIR").map(PathBuf::from),
+            )?
+        } else {
+            LayerwiseQuotas::default()
+        };
+
+        Ok(Self {
+            slots,
+            storage,
+            raw_cfg,
+            kv_cfg,
+            legacy,
+            budget_blocks: plan.budget_blocks,
+            interval: plan.interval,
+            trace: env_flag("HIPFIRE_KVMEM_TRACE"),
+            n_fa_layers: geom.n_fa_layers,
+            n_heads: geom.n_heads,
+            n_kv_heads: geom.n_kv_heads,
+            head_dim: geom.head_dim,
+            kv_mode: geom.kv_mode,
+            q_width,
+            k_page_bytes: KV_BLOCK_TOKENS * geom.per_pos_bytes,
+            v_page_bytes: KV_BLOCK_TOKENS * geom.per_pos_v_bytes,
+            page_k: vec![0u8; KV_BLOCK_TOKENS * geom.per_pos_bytes],
+            page_v: vec![0u8; KV_BLOCK_TOKENS * geom.per_pos_v_bytes],
+            wt_k: vec![0u8; if strategy.is_layerwise() { geom.max_rows * geom.per_pos_bytes } else { 0 }],
+            wt_v: vec![0u8; if strategy.is_layerwise() { geom.max_rows * geom.per_pos_v_bytes } else { 0 }],
+            staging: vec![0f32; geom.max_rows * k_width],
+            sums: vec![0f32; n_record_layers * q_width],
+            q_row: vec![0f32; q_width],
+            // Trunk ordinals carry one tapped Q row each; the appended head aux
+            // ordinal (head_plane only) is zeroed so the core retrieval scorer
+            // skips it — trunk selection scores `0..n_fa_layers` exactly as before.
+            counts: {
+                let mut c = vec![1u32; n_record_layers];
+                if head_plane {
+                    c[geom.n_fa_layers] = 0;
+                }
+                c
+            },
+            xfer_slab: None,
+            batch_xfer: batch_xfer_flag(),
+            strategy,
+            layerwise_quotas,
+            select_method,
+            watermark,
+            query_span,
+            q_span: vec![0f32; ring_cap],
+            q_layer_rows: vec![0u32; if query_span > 1 { n_record_layers } else { 0 }],
+            head_plane,
+            layerwise_mtp_history,
+            aux_ordinal: geom.n_fa_layers as u32,
+            n_record_layers,
+            gen_reserve,
+            checkpoint_retention,
+            // P4.3: bounded frozen-prefix catalog; empty until the engine
+            // freezes a prefix (PREFIX_PIN on). 期3 G3: with content groups the
+            // bound is the core version limit C = max(2N, 1); otherwise 4.
+            prefix_catalog: PrefixCatalog::new(if content_groups > 0 {
+                (2 * content_groups).max(1)
+            } else {
+                4
+            }),
+            content_groups,
+            content_retirements_total: 0,
+            cold_dir,
+            cold_bytes,
+            cold_packs,
+            cold_displaced: Vec::new(),
+            cold_pack_hits_total: 0,
+            cold_pack_misses_total: 0,
+            spill_pages_total: 0,
+            restore_pages_total: 0,
+            prefix_freezes_total: 0,
+            prefix_hits_total: 0,
+            prefix_misses_total: 0,
+            prefix_evictions_total: 0,
+            prefix_catalog_hits_total: 0,
+            prefix_restore_hits_total: 0,
+            prefix_demotions_total: 0,
+            draft_images_total: 0,
+            draft_image_hits_total: 0,
+            draft_image_misses_total: 0,
+        })
+    }
+
+    /// P4.4: the KV tier this controller resolves to (per-tier layerwise format
+    /// identity + admission). The layout adapter and backend identity read it.
+    pub fn kv_mode(&self) -> KvMode {
+        self.kv_mode
+    }
+
+    /// Resolved recall execution model (`HIPFIRE_KVMEM_RECALL_STRATEGY`).
+    /// The engine gates the Layerwise subsystem (write-through archive,
+    /// per-layer driver, packed residency) on this; Legacy is the default.
+    pub fn strategy(&self) -> RecallStrategy {
+        self.strategy
+    }
+
+    /// Resolved layerwise activation quotas (design §3.11, ③-E1). The Layerwise
+    /// carrier creates its projected-Q tape accounts against these; Legacy never
+    /// reads them. Borrowed for the carrier's lifetime (the accounts are built
+    /// per query from the copied limits, so no borrow outlives the controller).
+    pub fn layerwise_quotas(&self) -> &LayerwiseQuotas {
+        &self.layerwise_quotas
+    }
+
+    /// Borrow slot `slot`'s statistics store (`RawStore`) and policy (`KvStore`)
+    /// for the Layerwise driver (design §3.9a/§3.9b). `LayerwiseDriver<'a>`
+    /// borrows these for the query's lifetime; the caller must NOT [`Self::reset_slot`]
+    /// while the borrow is live — reset replaces the `SlotState` wholesale (a new
+    /// `RawStore`/`KvStore`), invalidating it, so the driver is rebuilt per query.
+    /// `None` when the slot is out of range. The stores stay owned by this
+    /// controller: the driver only reads statistics and sets the runtime select
+    /// budget through them (both `&self` operations on the C++ handles).
+    pub fn layerwise_stores(&self, slot: usize) -> Option<(&RawStore, &KvStore)> {
+        self.slots.get(slot).map(|st| (&st.raw, &st.kv))
+    }
+
+    /// Synthesize a fresh, page-aligned selection policy for one layerwise
+    /// query (design §3.9g refinement). The core layerwise picker
+    /// (`prepare_selection`) admits ONLY a canonical index of sealed full pages
+    /// (`total_tokens % block == 0`, every block full), but the shared per-slot
+    /// `kv` store tracks ALL fed tokens — including the partial tail — for the
+    /// Legacy path. So the layerwise carrier owns this fresh policy indexing the
+    /// `fed / 128` sealed canonical pages; the partial tail lives only in the
+    /// statistics store (`raw`) and is restored as the suffix stripe. Scoped to
+    /// the query and never shared, so the Legacy `kv` store is untouched
+    /// (byte-neutral). The driver's `begin_query` sets the runtime select budget,
+    /// so the config's initial budget is only a placeholder here.
+    pub fn layerwise_policy(&self, fed: u32) -> Result<KvStore, String> {
+        let full_pages = fed / KV_BLOCK_TOKENS as u32;
+        let policy =
+            KvStore::new(&self.kv_cfg).map_err(|e| format!("kvmem layerwise policy: {e}"))?;
+        policy
+            .register_append(full_pages * KV_BLOCK_TOKENS as u32)
+            .map_err(|e| format!("kvmem layerwise policy append: {e}"))?;
+        Ok(policy)
+    }
+
+    /// 期4 (KVMem/nInfer DFlash2 integration): the draft's local-attention
+    /// lower bound in logical token positions — the start of the continuous
+    /// recent suffix the Layerwise selection retains
+    /// (nInfer `dflash_context_floor = main_frontier − recent_blocks·page_tokens`).
+    /// The draft ring, proposal positions and cyclic slot addressing stay
+    /// logical; only the target verify uses compact positions. 0 under Legacy,
+    /// where the whole context stays resident and the draft span is unchanged.
+    pub fn draft_conditioning_floor(&self, slot: usize, position: usize) -> usize {
+        if !self.strategy.is_layerwise() {
+            return 0;
+        }
+        let fed = self
+            .fed_tokens(slot)
+            .map(|f| f as usize)
+            .unwrap_or(position)
+            .min(position);
+        let recent = self.kv_cfg.recent_blocks as usize * KV_BLOCK_TOKENS;
+        fed.saturating_sub(recent)
+    }
+
+    /// Per-slot resident page budget (full pages + partial tail).
+    pub fn budget_blocks(&self) -> usize {
+        self.budget_blocks
+    }
+
+    /// Always-resident sink pages (`HIPFIRE_KVMEM_SINK_BLOCKS`). The layerwise
+    /// Query selection charges these inside the same budget as any mandatory
+    /// (media) pins, so an admission check must add them.
+    pub fn sink_blocks(&self) -> usize {
+        self.kv_cfg.sink_blocks as usize
+    }
+
+    /// Always-resident recent pages (`HIPFIRE_KVMEM_RECENT_BLOCKS`). Together
+    /// with the sink they form the fixed allocation every layerwise selection
+    /// budget must cover.
+    pub fn recent_blocks(&self) -> usize {
+        self.kv_cfg.recent_blocks as usize
+    }
+
+    /// P2.2a: generation reserve R (ninfer `reserve_tokens`).
+    pub fn gen_reserve(&self) -> u64 {
+        self.gen_reserve
+    }
+
+    /// Layerwise window capacity: resident budget B + generation reserve R
+    /// (ninfer `device_tokens = selected_tokens + reserve_tokens`).
+    pub fn window_capacity_tokens(&self) -> u64 {
+        (self.budget_blocks as u64) * KV_BLOCK_TOKENS as u64 + self.gen_reserve
+    }
+}
diff --git a/crates/hipfire-arch-qwen35/src/kvmem_ctl/prefix.rs b/crates/hipfire-arch-qwen35/src/kvmem_ctl/prefix.rs
new file mode 100644
index 0000000000000000000000000000000000000000..f144ba1bd8a0705da7fdef2f729290567be66d1a
--- /dev/null
+++ b/crates/hipfire-arch-qwen35/src/kvmem_ctl/prefix.rs
@@ -0,0 +1,637 @@
+// SPDX-License-Identifier: Apache-2.0
+// Copyright (c) 2026 Kaden Schutt
+// hipfire — see LICENSE and NOTICE in the project root.
+
+use super::*;
+
+impl KvMemCtl {
+    // ── P4.3 KVMem-native prefix sharing (host model) ─────────────────────
+    //
+    // ninfer-aligned: freeze an IMMUTABLE canonical archive at a page-aligned
+    // frontier, then reuse it across sessions via provenance-validated forks.
+    // The GPU page PIN (seal + cache refs + share_published_pages) and the
+    // DeltaNet checkpoint restore are engine-side (serve admit); these methods
+    // own the host store half. Every path is additive: with PREFIX_PIN off the
+    // engine never calls them and the catalog stays empty (byte-neutral).
+
+    /// Freeze slot `slot`'s prefix `[0, frontier)` into an immutable canonical
+    /// archive and catalog it. `frontier` must be page-aligned and `<= fed`;
+    /// `prefix_tokens` is the FULL token proof (must equal the fed prefix).
+    /// Returns `(checkpoint id, displaced entries, deduped)` — the engine must
+    /// release the displaced entries' GPU cache refs, and on `deduped` it must
+    /// NOT take new refs (the existing entry already pins the same pages).
+    /// Fail-closed before any mutation of the slot (the fork seals the source's
+    /// packed records but never changes their bytes; the source keeps appending
+    /// to fresh blocks).
+    pub fn freeze_prefix(
+        &mut self,
+        slot: usize,
+        frontier: u32,
+        prefix_tokens: &[u32],
+    ) -> Result<(u64, Vec<PrefixCheckpoint>, bool), String> {
+        self.freeze_prefix_with_media(slot, frontier, prefix_tokens, None, Vec::new())
+    }
+
+    /// G7: freeze with the image-turn media identity (digest + image token
+    /// spans) recorded in the checkpoint and the persistent pack meta. The
+    /// engine passes the session's sticky digest on image turns; text-only
+    /// freezes pass `(None, vec![])`.
+    pub fn freeze_prefix_with_media(
+        &mut self,
+        slot: usize,
+        frontier: u32,
+        prefix_tokens: &[u32],
+        media_digest: Option<u64>,
+        media_spans: Vec<(u32, u32)>,
+    ) -> Result<(u64, Vec<PrefixCheckpoint>, bool), String> {
+        let st = self
+            .slots
+            .get(slot)
+            .ok_or_else(|| format!("kvmem: freeze_prefix slot {slot} out of range"))?;
+        if frontier == 0 || frontier % PREFIX_PAGE_TOKENS != 0 {
+            return Err(format!(
+                "kvmem freeze_prefix: frontier {frontier} must be a positive multiple of \
+                 {PREFIX_PAGE_TOKENS} (GPU sharing is page-granular)"
+            ));
+        }
+        if frontier > st.fed {
+            return Err(format!(
+                "kvmem freeze_prefix: frontier {frontier} exceeds fed {}",
+                st.fed
+            ));
+        }
+        if prefix_tokens.len() != frontier as usize {
+            return Err(format!(
+                "kvmem freeze_prefix: token proof len {} != frontier {frontier}",
+                prefix_tokens.len()
+            ));
+        }
+        let layout_id = layout_fingerprint(&self.raw_cfg);
+        let fingerprint = hipfire_runtime::checkpoint_pool::prefix_fingerprint(prefix_tokens);
+        // 期2.3: the question that owns this checkpoint (import identity).
+        let original_query = st.request_query;
+        // Dedup BEFORE forking/sealing: an identical frontier+proof already
+        // pins the same pages; a second archive would double the cache refs.
+        // The catalog stays token-keyed; the media digest gates serving and
+        // scopes the pack path and the recurrent-state key.
+        if let Some(existing) = self.prefix_catalog.find_exact(frontier, fingerprint) {
+            return Ok((existing, Vec::new(), true));
+        }
+        // Canonical archive: packed records become sealed shared sources;
+        // mean-K stays private to the archive; the branch is truncated to the
+        // frontier (core fork_prefix contract). The source store keeps its
+        // own mutable statistics for blocks beyond the frontier.
+        let mut canonical = st
+            .raw
+            .fork_prefix(frontier)
+            .map_err(|e| format!("kvmem freeze_prefix fork: {e}"))?;
+        let blocks = frontier / KV_BLOCK_TOKENS as u32;
+        let mean_tail = st
+            .raw
+            .mean_checkpoint(frontier)
+            .map_err(|e| format!("kvmem freeze_prefix mean checkpoint: {e}"))?;
+        // 期3 G4: the canonical side is also the core `KvSnapshot` over the
+        // sealed packed records of the canonical's account (block-major,
+        // layer-major, K then V). The snapshot is the catalog-visible immutable
+        // object the G2/G3 directories share. Host-only fixtures without a
+        // packed archive carry no snapshot (missing records are not an error).
+        // 期3 G3 follow-up (nInfer origin inheritance): reuse the SealedKvBlock
+        // objects of this slot's previous checkpoint when the record storage
+        // identity matches (same session, shared sealed records).
+        let previous_snapshot = st
+            .last_freeze_id
+            .and_then(|pid| self.prefix_catalog.get(pid))
+            .and_then(|c| c.kv_snapshot.as_ref());
+        let kv_snapshot = if canonical.has_packed(blocks) {
+            let snapshot = canonical
+                .capture_snapshot(blocks, previous_snapshot)
+                .map_err(|e| format!("kvmem freeze_prefix snapshot: {e}"))?;
+            if !snapshot.covers_packed(blocks, self.n_record_layers as u32) {
+                return Err(format!(
+                    "kvmem freeze_prefix snapshot: incomplete {blocks}×{} packed grid",
+                    self.n_record_layers
+                ));
+            }
+            Some(snapshot)
+        } else {
+            None
+        };
+        let id = self.prefix_catalog.mint_id();
+        let mut entry = PrefixCheckpoint::new(
+            id,
+            frontier,
+            prefix_tokens.to_vec(),
+            mean_tail,
+            st.lw_incarnation,
+            layout_id,
+            canonical,
+        );
+        entry.original_query = original_query;
+        entry.group = st.convo_group;
+        entry.media_digest = media_digest;
+        entry.media_spans = media_spans.clone();
+        if self.content_groups > 0
+            && hipfire_config::developer_var("HIPFIRE_KVMEM_TRACE")
+                .ok()
+                .is_some_and(|v| v == "1" || v == "on" || v == "true")
+        {
+            eprintln!(
+                "[kvmem-content] freeze slot={slot} frontier={frontier} group={} entries={}",
+                st.convo_group,
+                self.prefix_catalog.len()
+            );
+        }
+        entry.kv_snapshot = kv_snapshot;
+        // 期3 G3 P1.1: persist the canonical prefix as a pack file. Failure
+        // never blocks the freeze (persistence is an optional tier); the byte
+        // cap prunes the oldest packs.
+        if let Some(dir) = self.cold_dir.clone() {
+            let meta = ContentPackMeta {
+                version: ContentPackMeta::VERSION,
+                layout_id,
+                frontier,
+                tokens: entry.prefix_tokens.clone(),
+                mean_tail: entry.mean_tail.clone(),
+                group: entry.group,
+                original_query: entry.original_query,
+                n_record_layers: self.n_record_layers as u32,
+                media_digest: entry.media_digest,
+                media_spans: entry.media_spans.clone(),
+            };
+            // G7: the file name carries the media identity. Two images with
+            // the same token stream share the token fingerprint; without the
+            // digest suffix their packs would overwrite each other.
+            let media_tag = match media_digest {
+                None => String::new(),
+                Some(d) => format!("-m{d:016x}"),
+            };
+            let path = dir.join(format!(
+                "p{layout_id:016x}-{frontier:08}-{fingerprint:016x}{media_tag}.hkpack"
+            ));
+            // Idempotent publish: a previous freeze of this exact token proof
+            // already left a complete pack + recurrent sidecar pair. Reusing
+            // it avoids rewriting ~pack + DN bytes and guarantees the pair
+            // stays coherent (the sidecar is only skipped with its pack).
+            let side = sidecar_path(&path);
+            let complete_pair = self.cold_packs.contains_path(&path)
+                && std::fs::metadata(&path)
+                    .map(|m| m.len() > 0)
+                    .unwrap_or(false)
+                && std::fs::metadata(&side)
+                    .map(|m| m.len() >= SIDECAR_MIN_BYTES)
+                    .unwrap_or(false);
+            let written = if complete_pair {
+                if hipfire_config::developer_var("HIPFIRE_KVMEM_TRACE")
+                    .ok()
+                    .is_some_and(|v| v == "1" || v == "on" || v == "true")
+                {
+                    eprintln!(
+                        "[kvmem-pack] reuse complete pack+sidecar frontier={frontier}"
+                    );
+                }
+                Ok(())
+            } else {
+                // A rewrite must never pair a fresh pack with a stale sidecar.
+                let _ = std::fs::remove_file(&side);
+                self.cold_packs.set_sidecar_bytes(&path, 0);
+                meta.encode().and_then(|bytes| {
+                    entry
+                        .canonical()
+                        .write_prefix_pack(blocks, &path, &bytes)
+                        .map_err(|e| e.to_string())
+                })
+            };
+            match written {
+                Ok(()) => {
+                    entry.pack_path = Some(path.clone());
+                    if !self.cold_packs.contains_path(&path) {
+                        let bytes = std::fs::metadata(&path).map(|m| m.len()).unwrap_or(0);
+                        self.cold_packs.insert(ColdPack {
+                            path: path.clone(),
+                            meta,
+                            fingerprint,
+                            bytes,
+                            sidecar_bytes: 0,
+                            stamp: 0,
+                        });
+                    }
+                    let removed = self.cold_packs.prune_to(self.cold_bytes);
+                    if !removed.is_empty()
+                        && hipfire_config::developer_var("HIPFIRE_KVMEM_TRACE")
+                            .ok()
+                            .is_some_and(|v| v == "1" || v == "on" || v == "true")
+                    {
+                        eprintln!(
+                            "[kvmem-pack] pruned {} pack(s), {} bytes retained",
+                            removed.len(),
+                            self.cold_packs.total_bytes()
+                        );
+                    }
+                }
+                Err(e) => eprintln!("[kvmem-pack] write skipped: {e}"),
+            }
+        }
+        // 期3 G3: group-aware publication retires the whole least-recently-used
+        // group before entry trimming; the plain LRU path stays the default.
+        let (inserted, displaced) = if self.content_groups > 0 && st.convo_group != 0 {
+            let (id, displaced, _deduped) = self
+                .prefix_catalog
+                .insert_group_aware(entry, self.content_groups)
+                .map_err(|e| format!("kvmem freeze_prefix catalog: {e}"))?;
+            self.content_retirements_total += displaced.len() as u64;
+            (id, displaced)
+        } else {
+            self.prefix_catalog
+                .insert_displacing(entry)
+                .map_err(|e| format!("kvmem freeze_prefix catalog: {e}"))?
+        };
+        if inserted.is_some() {
+            self.prefix_freezes_total += 1;
+        }
+        let frozen_id = inserted.unwrap_or(id);
+        if let Some(st) = self.slots.get_mut(slot) {
+            st.last_freeze_id = Some(frozen_id);
+        }
+
+        let mut displaced = displaced;
+        if let Some((count, bytes, interval, min_gap)) = self.checkpoint_retention {
+            let pruned = self.prefix_catalog.prune_policy(count, bytes, interval, min_gap);
+            self.prefix_evictions_total += pruned.len() as u64;
+            displaced.extend(pruned);
+        }
+        self.prefix_evictions_total += 0;
+        Ok((inserted.unwrap_or(id), displaced, false))
+    }
+
+    /// Look up the longest cataloged prefix fully proven by `prompt`.
+    /// Returns the checkpoint id (engine then validates + forks).
+    pub fn prefix_lookup(&mut self, prompt: &[u32]) -> Option<u64> {
+        self.prefix_lookup_media(prompt, None)
+    }
+
+    /// G7: media-aware prefix lookup. A checkpoint covering an image span is
+    /// eligible only when the incoming request's media digest matches it.
+    pub fn prefix_lookup_media(&mut self, prompt: &[u32], media: Option<u64>) -> Option<u64> {
+        let layout = layout_fingerprint(&self.raw_cfg);
+        if let Some(hit) = self.prefix_catalog.lookup_media(prompt, layout, media) {
+            self.prefix_catalog_hits_total += 1;
+            self.prefix_hits_total += 1;
+            return Some(hit);
+        }
+        // 期3 G3 P1.1: a cold pack hit loads the payload and publishes a
+        // normal catalog entry; the caller then reuses it through the usual
+        // proof path (restart reuse still needs the DN checkpoint, patch 35).
+        if let Some(index) = self.cold_packs.lookup_media(prompt, layout, media) {
+            let pack = self.cold_packs.packs()[index].clone();
+            match self.load_cold_pack(&pack) {
+                Ok(id) => {
+                    // G7 Stage C: the hot catalog is token-keyed. A pack load
+                    // can dedup into a live entry that belongs to a DIFFERENT
+                    // image (identical `image_pad` token stream). Serving it
+                    // would hand over the other image's KV — stay a miss.
+                    let identity_ok = self
+                        .prefix_catalog
+                        .get(id)
+                        .map(|e| e.media_digest == pack.meta.media_digest)
+                        .unwrap_or(false);
+                    if !identity_ok {
+                        self.cold_pack_misses_total += 1;
+                        eprintln!(
+                            "[kvmem-pack] cold load identity mismatch \
+                             (media digest) — miss"
+                        );
+                        return None;
+                    }
+                    self.cold_pack_hits_total += 1;
+                    self.prefix_hits_total += 1;
+                    if hipfire_config::developer_var("HIPFIRE_KVMEM_TRACE")
+                        .ok()
+                        .is_some_and(|v| v == "1" || v == "on" || v == "true")
+                    {
+                        eprintln!(
+                            "[kvmem-pack] cold hit frontier={} path={}",
+                            pack.meta.frontier,
+                            pack.path.display()
+                        );
+                    }
+                    return Some(id);
+                }
+                Err(e) => {
+                    self.cold_pack_misses_total += 1;
+                    eprintln!("[kvmem-pack] cold load failed: {e}");
+                }
+            }
+        }
+        // G7 Stage E probe: distinguish a media-identity refusal from a token
+        // proof miss. The candidate below proves by FULL token equality; only
+        // the image identity gate refused it. Trace-only, read-only.
+        if hipfire_config::developer_var("HIPFIRE_KVMEM_TRACE")
+            .ok()
+            .is_some_and(|v| v == "1" || v == "on" || v == "true")
+        {
+            let layout = layout_fingerprint(&self.raw_cfg);
+            let rejected = self
+                .prefix_catalog
+                .probe_media_reject(prompt, layout, media)
+                .or_else(|| self.cold_packs.probe_media_reject(prompt, layout, media));
+            if let Some((frontier, digest)) = rejected {
+                let fmt = |d: Option<u64>| {
+                    d.map(|x| format!("{x:016x}"))
+                        .unwrap_or_else(|| "none".to_string())
+                };
+                eprintln!(
+                    "[kvmem-media] lookup miss: token candidate frontier={frontier} \
+                     digest={} request digest={} -> media identity gate",
+                    fmt(digest),
+                    fmt(media)
+                );
+            }
+        }
+        self.prefix_misses_total += 1;
+        None
+    }
+
+    /// Drain catalog entries displaced by a cold pack load so the engine can
+    /// release their GPU cache refs.
+    pub fn take_cold_displaced(&mut self) -> Vec<PrefixCheckpoint> {
+        std::mem::take(&mut self.cold_displaced)
+    }
+
+    /// Load one pack file into a fresh store (content account when enabled),
+    /// prove the metadata is unchanged, capture the KvSnapshot and publish the
+    /// entry into the hot catalog.
+    fn load_cold_pack(&mut self, pack: &ColdPack) -> Result<u64, String> {
+        let layout = layout_fingerprint(&self.raw_cfg);
+        if pack.meta.layout_id != layout
+            || pack.meta.n_record_layers as usize != self.n_record_layers
+            || pack.meta.frontier == 0
+            || pack.meta.frontier % KV_BLOCK_TOKENS as u32 != 0
+        {
+            return Err("pack geometry/layout mismatch".to_string());
+        }
+        let store = RawStore::new(self.raw_cfg, Some(&self.storage))
+            .map_err(|e| format!("pack store: {e}"))?;
+        let meta_bytes = store
+            .read_prefix_pack(&pack.path)
+            .map_err(|e| format!("pack read: {e}"))?;
+        let meta = ContentPackMeta::decode(&meta_bytes)
+            .map_err(|e| format!("pack meta: {e}"))?;
+        if meta.tokens != pack.meta.tokens || meta.frontier != pack.meta.frontier {
+            return Err("pack metadata changed since scan".to_string());
+        }
+        let blocks = meta.frontier / KV_BLOCK_TOKENS as u32;
+        let kv_snapshot = if store.has_packed(blocks) {
+            let snap = store
+                .capture_snapshot(blocks, None)
+                .map_err(|e| format!("pack snapshot: {e}"))?;
+            if !snap.covers_packed(blocks, self.n_record_layers as u32) {
+                return Err("pack snapshot grid incomplete".to_string());
+            }
+            Some(snap)
+        } else {
+            None
+        };
+        let id = self.prefix_catalog.mint_id();
+        let mut entry = PrefixCheckpoint::new(
+            id,
+            meta.frontier,
+            meta.tokens.clone(),
+            meta.mean_tail.clone(),
+            0,
+            layout,
+            store,
+        );
+        entry.original_query = meta.original_query;
+        entry.group = meta.group;
+        entry.media_digest = meta.media_digest;
+        entry.media_spans = meta.media_spans.clone();
+        entry.kv_snapshot = kv_snapshot;
+        entry.pack_path = Some(pack.path.clone());
+        let (inserted, displaced) = if self.content_groups > 0 && entry.group != 0 {
+            let (id, displaced, _deduped) = self
+                .prefix_catalog
+                .insert_group_aware(entry, self.content_groups)
+                .map_err(|e| format!("pack catalog: {e}"))?;
+            self.content_retirements_total += displaced.len() as u64;
+            (id, displaced)
+        } else {
+            self.prefix_catalog
+                .insert_displacing(entry)
+                .map_err(|e| format!("pack catalog: {e}"))?
+        };
+        self.cold_displaced.extend(displaced);
+        Ok(inserted.unwrap_or(id))
+    }
+
+    /// Look up the longest cataloged prefix fully proven by `prompt` whose
+    /// frontier is at most `max_frontier` (import narrowing fallback).
+    pub fn prefix_lookup_capped(&mut self, prompt: &[u32], max_frontier: u32) -> Option<u64> {
+        self.prefix_lookup_capped_media(prompt, max_frontier, None)
+    }
+
+    /// G7: media-aware capped lookup for import narrowing.
+    pub fn prefix_lookup_capped_media(
+        &mut self,
+        prompt: &[u32],
+        max_frontier: u32,
+        media: Option<u64>,
+    ) -> Option<u64> {
+        let layout = layout_fingerprint(&self.raw_cfg);
+        let hit = self
+            .prefix_catalog
+            .lookup_at_most_media(prompt, layout, max_frontier, media);
+        if hit.is_some() {
+            self.prefix_catalog_hits_total += 1;
+            self.prefix_hits_total += 1;
+        } else {
+            // G7 Stage E probe: a capped lookup narrowed to `max_frontier` can
+            // miss on the media identity alone; name the refused candidate.
+            if hipfire_config::developer_var("HIPFIRE_KVMEM_TRACE")
+                .ok()
+                .is_some_and(|v| v == "1" || v == "on" || v == "true")
+            {
+                if let Some((frontier, digest)) =
+                    self.prefix_catalog.probe_media_reject(prompt, layout, media)
+                {
+                    let fmt = |d: Option<u64>| {
+                        d.map(|x| format!("{x:016x}"))
+                            .unwrap_or_else(|| "none".to_string())
+                    };
+                    eprintln!(
+                        "[kvmem-media] capped lookup miss: token candidate frontier={frontier} \
+                         digest={} request digest={} cap={max_frontier} -> media identity gate",
+                        fmt(digest),
+                        fmt(media)
+                    );
+                }
+            }
+            self.prefix_misses_total += 1;
+        }
+        hit
+    }
+
+    /// Read a cataloged checkpoint (engine attaches GPU pages / reads the
+    /// frontier + mean_tail for the DeltaNet restore pairing).
+    pub fn prefix_checkpoint(&self, id: u64) -> Option<&PrefixCheckpoint> {
+        self.prefix_catalog.get(id)
+    }
+
+    /// 期4: DFlash2 draft image instrumentation (captures / restore hits /
+    /// misses). Pure bookkeeping — never read back into selection/residency.
+    pub fn note_draft_image_capture(&mut self) {
+        self.draft_images_total += 1;
+    }
+
+    pub fn note_draft_image_hit(&mut self) {
+        self.draft_image_hits_total += 1;
+    }
+
+    pub fn note_draft_image_miss(&mut self) {
+        self.draft_image_misses_total += 1;
+    }
+
+    /// G3 follow-up: a reuse conversion proceeded without pinned pages and
+    /// restored them from the sealed archive (demoted or restart entry).
+    pub fn note_prefix_restore_hit(&mut self) {
+        self.prefix_restore_hits_total += 1;
+    }
+
+    /// Mutable access (engine attaches `gpu_pages` after sealing + cache refs).
+    pub fn prefix_checkpoint_mut(&mut self, id: u64) -> Option<&mut PrefixCheckpoint> {
+        self.prefix_catalog.get_mut(id)
+    }
+
+    /// Remove a checkpoint, returning it so the engine can release its GPU
+    /// cache refs (session close / explicit release).
+    pub fn release_prefix(&mut self, id: u64) -> Option<PrefixCheckpoint> {
+        self.prefix_catalog.remove(id)
+    }
+
+    /// Pop the LRU checkpoint (admission pressure reclaim); the engine
+    /// releases its GPU cache refs. `None` when the catalog is empty.
+    pub fn pop_lru_prefix(&mut self) -> Option<PrefixCheckpoint> {
+        let popped = self.prefix_catalog.pop_lru();
+        if popped.is_some() {
+            self.prefix_evictions_total += 1;
+        }
+        popped
+    }
+
+    /// G3 follow-up: admission-pressure residency demotion. Drops the LRU
+    /// checkpoint's pinned pages but KEEPS its catalog entry (nInfer: the
+    /// directory and GPU residency are separate), so a later reuse restores
+    /// the pages from the sealed archive under Layerwise. Returns the entry id
+    /// and the released page indices, or `None` when no entry pins any page.
+    /// Legacy keeps [`Self::pop_lru_prefix`] (its reuse needs resident pages).
+    pub fn demote_lru_prefix(&mut self) -> Option<(u64, Vec<u32>)> {
+        let demoted = self.prefix_catalog.demote_lru();
+        if demoted.is_some() {
+            self.prefix_demotions_total += 1;
+        }
+        demoted
+    }
+
+    /// Live observability snapshot (`/metrics` via `EngineStats.kvmem`).
+    /// Cheap integer reads from the host stores: no device work, no
+    /// allocation, and no path reads it back into selection/residency, so it
+    /// cannot change KV bytes.
+    pub fn stats(&self) -> KvMemStats {
+        let mut payload_bytes = 0u64;
+        let mut blocks = 0u64;
+        let mut tokens = 0u64;
+        for st in &self.slots {
+            payload_bytes += st.raw.payload_bytes();
+            blocks += u64::from(st.kv.block_count());
+            tokens += u64::from(st.kv.total_tokens());
+        }
+        let page_bytes = (self.k_page_bytes + self.v_page_bytes) as u64;
+        let prefix_host = self.prefix_catalog.host_accounting();
+        KvMemStats {
+            enabled: true,
+            layerwise: self.strategy.is_layerwise(),
+            host_charged_bytes: self.storage.charged_bytes(),
+            disk_bytes: self.storage.disk_bytes(),
+            payload_bytes,
+            blocks,
+            tokens,
+            spill_pages: self.spill_pages_total,
+            restore_pages: self.restore_pages_total,
+            spill_bytes: self.spill_pages_total.saturating_mul(page_bytes),
+            restore_bytes: self.restore_pages_total.saturating_mul(page_bytes),
+            prefix_entries: self.prefix_catalog.len() as u64,
+            prefix_pinned_pages: self.prefix_catalog.pinned_pages(),
+            prefix_host_bytes: prefix_host.unique,
+            prefix_host_bytes_gross: prefix_host.gross,
+            prefix_freezes: self.prefix_freezes_total,
+            prefix_hits: self.prefix_hits_total,
+            prefix_misses: self.prefix_misses_total,
+            prefix_evictions: self.prefix_evictions_total,
+            prefix_demotions: self.prefix_demotions_total,
+            prefix_catalog_hits: self.prefix_catalog_hits_total,
+            prefix_restore_hits: self.prefix_restore_hits_total,
+            content_groups: self.prefix_catalog.group_count() as u64,
+            content_retirements: self.content_retirements_total,
+            // Single tier: packs are files, so there is no second account.
+            content_cache_bytes: 0,
+            content_cache_disk_bytes: 0,
+            content_packs: self.cold_packs.len() as u64,
+            content_pack_bytes: self.cold_packs.total_bytes(),
+            cold_pack_hits: self.cold_pack_hits_total,
+            cold_pack_misses: self.cold_pack_misses_total,
+            draft_images: self.draft_images_total,
+            draft_image_hits: self.draft_image_hits_total,
+            draft_image_misses: self.draft_image_misses_total,
+        }
+    }
+
+    /// 期2.3: the query span stored with a cataloged checkpoint (import
+    /// identity). `None` for checkpoints frozen before a proven span existed.
+    pub fn prefix_original_query(&self, id: u64) -> Option<(u64, u64)> {
+        self.prefix_catalog.get(id).and_then(|c| c.original_query)
+    }
+
+    /// 期3 G3 P1.1: the pack file backing a cataloged checkpoint (the DN
+    /// sidecar lives beside it as `<pack>.dn`). Returns `None` once the pack
+    /// was pruned from the disk index, so callers never create an orphan
+    /// sidecar for a vanished pack.
+    pub fn prefix_pack_path(&self, id: u64) -> Option<std::path::PathBuf> {
+        let path = self
+            .prefix_catalog
+            .get(id)
+            .and_then(|c| c.pack_path.clone())?;
+        self.cold_packs.contains_path(&path).then_some(path)
+    }
+
+    /// A complete reusable pack + recurrent sidecar pair already exists for
+    /// `id` (post-freeze). The engine skips the DN export when true.
+    pub fn prefix_sidecar_ready(&self, id: u64) -> bool {
+        let Some(pack) = self.prefix_pack_path(id) else {
+            return false;
+        };
+        std::fs::metadata(sidecar_path(&pack))
+            .map(|m| m.len() >= SIDECAR_MIN_BYTES)
+            .unwrap_or(false)
+    }
+
+    /// Record the recurrent sidecar written beside a pack. The whole cache
+    /// directory (packs + sidecars) is re-pruned under `HIPFIRE_KVMEM_CACHE_BYTES`.
+    /// When the pack disappeared meanwhile, drop the orphan sidecar instead.
+    pub fn note_pack_sidecar(&mut self, path: &std::path::Path, bytes: u64) {
+        if !self.cold_packs.set_sidecar_bytes(path, bytes) {
+            let _ = std::fs::remove_file(sidecar_path(path));
+            return;
+        }
+        let removed = self.cold_packs.prune_to(self.cold_bytes);
+        if !removed.is_empty()
+            && hipfire_config::developer_var("HIPFIRE_KVMEM_TRACE")
+                .ok()
+                .is_some_and(|v| v == "1" || v == "on" || v == "true")
+        {
+            eprintln!(
+                "[kvmem-pack] pruned {} pack(s), {} disk bytes retained",
+                removed.len(),
+                self.cold_packs.disk_bytes()
+            );
+        }
+    }
+}
