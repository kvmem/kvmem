+                        // double-occupy the slot. Reject and close instead.
+                        let _ = send_event(
+                            &req.reply,
+                            Event::Rejected {
+                                class: RejectClass::Internal,
+                                reason: format!("continuation begin_turn failed: {e}"),
+                            },
+                        );
