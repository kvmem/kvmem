+    // ring and draft KV are conversation-scoped, and the next request
+    // re-allocates lazily on its first prefill chunk.
+    if let Some(st) = rig.model.dflash_states[slot.0].take() {
+        st.free_gpu(&mut rig.gpu);
+    }
