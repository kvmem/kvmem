+        let suffix_tokens = req.prompt_tokens.len().saturating_sub(prefix_reused);
+        let needed_pages = suffix_tokens
+            .saturating_add(req.max_tokens.max(1))
+            .div_ceil(PAGE_TOKENS)
+            .saturating_add(1);
