-            resolve_layerwise_policy(RecallStrategy::Legacy, sm, lrfu, wm, qs)
-                .unwrap_or_else(|e| {
-                    panic!("Legacy must admit sm={sm} lrfu={lrfu} wm={wm} qs={qs}: {e}")
