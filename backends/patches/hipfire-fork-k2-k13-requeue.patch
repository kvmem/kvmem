-            .unwrap_or_else(|| "engine shutdown".to_string());
-        fail_all_active(&mut rig, &mut slots, &mut work, reason);
-    }
-
-    // Drain the wait queue on shutdown: reject every parked request so no
-    // client is left waiting forever. The wait queue is pure host state —
-    // no GPU resources to free, just event delivery.
-    let shutdown_reason = poison
-        .clone()
-        .unwrap_or_else(|| "engine shutdown".to_string());
-    for waiter in rig.wait_queue.expire(u64::MAX) {
-        if let Some(parked) = rig.parked_requests.remove(&waiter.id) {
-            let _ = send_event(
-                &parked.req.reply,
-                Event::Rejected {
-                    class: RejectClass::Internal,
-                    reason: shutdown_reason.clone(),
-                },
-            );
-            lock_stats(&stats).note_rejected();
-        }
-    }
-
-    // Free GPU after poisoning/shutdown drain. Graph is destroyed before buffers.
-    let free_res = rig.free_gpu(graph);
-    match (poison, free_res) {
-        (Some(p), Ok(())) => Err(p),
-        (Some(p), Err(e)) => Err(format!("{p}; teardown failed: {e}")),
-        (None, Ok(())) => Ok(()),
-        (None, Err(e)) => Err(e),
-    }
-}
-
-/// G7: the session's media identity + image spans over `tokens` (the frozen
-/// prefix). Text-only sessions and pre-image prefixes yield `(None, vec![])`.
-#[cfg(feature = "kvmem")]
-fn kvmem_session_media(rig: &Rig, session: SessionId) -> (Option<u64>, Vec<(u32, u32)>) {
-    let Some(sess) = rig.sessions.get(session) else {
-        return (None, Vec::new());
-    };
-    if !sess.has_image || sess.media_n_visual == 0 {
-        return (sess.media_digest.filter(|_| sess.has_image), Vec::new());
-    }
-    let Some(pad) = rig.tokenizer.special_token_id("<|image_pad|>") else {
-        return (sess.media_digest, Vec::new());
-    };
-    // Spans over the FULL session token stream: a mid-image boundary must be
-    // recognized as a split even though the prefix truncates the run.
-    let spans: Vec<(u32, u32)> =
-        crate::kvmem_media::spans_from_pad_runs(&sess.tokens, pad, sess.media_n_visual)
-            .into_iter()
-            .map(|s| (s.begin as u32, s.end as u32))
-            .collect();
-    (sess.media_digest, spans)
-}
-
-/// P2.2b2: freeze the canonical host prefix, release displaced GPU refs and PIN
-/// this prefix's pages. Shared by the prefill-boundary freeze (after its
-/// DeltaNet capture) and the terminal endpoint freeze (which reuses a coverage
-/// checkpoint instead of capturing at a frontier the live recurrent state no
-/// longer holds).
-#[cfg(feature = "kvmem")]
-fn kvmem_catalog_and_pin(
-    rig: &mut Rig,
-    s: usize,
-    boundary: u32,
-    tokens: &[u32],
-    page_indices: &[u32],
-    media_digest: Option<u64>,
-    media_spans: Vec<(u32, u32)>,
-) -> Result<(), String> {
-    let ctl = rig
-        .model
-        .kvmem
-        .as_mut()
-        .ok_or_else(|| "kvmem freeze: no controller".to_string())?;
-    let (id, displaced, deduped) =
-        ctl.freeze_prefix_with_media(s, boundary, tokens, media_digest, media_spans)?;
-    for d in displaced {
-        if let Some(pp) = rig.pool.page_pool_mut() {
-            for &phys in &d.gpu_pages {
-                let _ = pp.release_cache_ref(phys);
-            }
-        }
-    }
-    if !deduped {
-        let pp = rig
-            .pool
-            .page_pool_mut()
-            .ok_or_else(|| "kvmem freeze: not paged".to_string())?;
-        let mut taken: Vec<u32> = Vec::new();
-        let mut ref_err = None;
-        for &phys in page_indices {
-            match pp.add_cache_ref(phys) {
-                Ok(()) => taken.push(phys),
-                Err(e) => {
-                    ref_err = Some(e);
-                    break;
-                }
-            }
-        }
-        if let Some(e) = ref_err {
-            for phys in taken {
-                let _ = pp.release_cache_ref(phys);
-            }
-            ctl.release_prefix(id);
-            return Err(format!("kvmem freeze cache ref: {e}"));
-        }
-        if let Some(ckpt) = ctl.prefix_checkpoint_mut(id) {
-            ckpt.gpu_pages = page_indices.to_vec();
-        }
-    }
-    // 期4: co-archive the DFlash2 draft conditioning image (KVMem/nInfer
-    // "native full sequence-state serialization"). Only when the draft's live
-    // seeded frontier equals this checkpoint's frontier — the cached ring
-    // cannot reconstruct an earlier frontier, so those checkpoints carry no
-    // image and reseed on reuse. Capture failure never drops the KV
-    // checkpoint (the target prefix stays reusable; only the draft reseeds).
-    // Layerwise only: Legacy keeps the historical AR-on-reuse path and stays
-    // byte/time-neutral (no image copies).
-    if !deduped && ctl.strategy().is_layerwise() {
-        let boundary_usize = boundary as usize;
-        let capture = match (
-            rig.model.dflash.as_ref(),
-            rig.model.dflash_states[s].as_ref(),
-        ) {
-            (Some(shared), Some(st)) if st.seeded_through == boundary_usize => {
-                let floor = ctl.draft_conditioning_floor(s, boundary_usize);
-                Some(crate::dflash_slot::dflash_capture_image(
-                    &rig.gpu,
-                    shared,
-                    st,
-                    boundary_usize,
-                    floor,
-                ))
-            }
-            _ => None,
-        };
-        match capture {
-            Some(Ok(img)) => {
-                if let Some(ckpt) = ctl.prefix_checkpoint_mut(id) {
-                    ckpt.draft_image = Some(img);
-                }
-                ctl.note_draft_image_capture();
-            }
-            Some(Err(e)) => {
-                eprintln!("[kvmem-draft-image] capture skipped at {boundary}: {e}");
-            }
-            None => {}
-        }
-    }
-    // 期3 G3 P1.1 dn-persist: co-locate the recurrent state with the pack.
-    // Live-frontier freezes export the live DN state; endpoint/coverage
-    // freezes label an earlier frontier whose state lives in the checkpoint
-    // pool (the coverage capture), so export THAT snapshot's bytes. Without a
-    // source the pack carries no sidecar (restart reuse falls back to cold).
-    if !deduped {
-        if let Some(pack) = ctl.prefix_pack_path(id) {
-            if ctl.prefix_sidecar_ready(id) {
-                if hipfire_config::developer_var("HIPFIRE_KVMEM_TRACE")
-                    .ok()
-                    .is_some_and(|v| v == "1" || v == "on" || v == "true")
-                {
-                    eprintln!("[kvmem-pack] DN sidecar reused at frontier {boundary}");
-                }
-            } else {
-                let dn_path = crate::kvmem_prefix::sidecar_path(&pack);
-                let live = ctl.fed_tokens(s) == Some(boundary);
-                let exported: Result<Vec<u8>, String> = if live {
-                    crate::speculative::DeltaNetSnapshot::export_host_from_state(
-                        &rig.gpu,
-                        &rig.model.dn_states[s],
-                    )
-                } else {
-                    let domain = rig
-                        .cache_domain
-                        .as_ref()
-                        .ok_or_else(|| "no cache domain".to_string())?;
-                    let fp = crate::checkpoint::checkpoint_fingerprint(
-                        &tokens[..boundary as usize],
-                        media_digest,
-                    );
-                    match rig
-                        .model
-                        .checkpoint_pool
-                        .as_ref()
-                        .and_then(|pool| pool.peek(domain, boundary as u64, fp))
-                    {
-                        Some(snapshot) => snapshot.export_host(&rig.gpu),
-                        None => Err("no recurrent checkpoint at the frozen frontier".to_string()),
-                    }
-                };
-                match exported {
-                    Ok(bytes) => {
-                        let tmp = std::path::PathBuf::from(format!("{}.tmp", dn_path.display()));
-                        match std::fs::write(&tmp, &bytes)
-                            .and_then(|_| std::fs::rename(&tmp, &dn_path))
-                        {
-                            Ok(()) => {
-                                ctl.note_pack_sidecar(&pack, bytes.len() as u64);
-                                if hipfire_config::developer_var("HIPFIRE_KVMEM_TRACE")
-                                    .ok()
-                                    .is_some_and(|v| v == "1" || v == "on" || v == "true")
-                                {
-                                    eprintln!(
-                                        "[kvmem-pack] DN sidecar {} bytes at frontier {boundary} (live={live})",
-                                        bytes.len()
-                                    );
-                                }
-                            }
-                            Err(e) => eprintln!("[kvmem-pack] DN sidecar skipped: {e}"),
-                        }
-                    }
-                    Err(e) => eprintln!("[kvmem-pack] DN sidecar skipped: {e}"),
-                }
-            }
-        }
-    }
-    Ok(())
-}
-
-/// P2.2b2 decode-side coverage capture (ninfer `CheckpointCapturePlan`):
-/// capture one recurrent checkpoint at each page-aligned frontier that is also
-/// a multiple of the configured interval. The live state cannot rewind, so the
-/// terminal endpoint freeze can only label a frontier whose DN state exists;
-/// coverage captures provide exactly those anchors. Soft: a pool refusal or a
-/// HIP error skips the boundary, never the serve loop.
-#[cfg(feature = "kvmem")]
-fn kvmem_coverage_capture(rig: &mut Rig, slots: &mut [Option<InFlight>], work: &[PendingWork]) {
-    if !rig.kvmem_prefix_pin || !rig.kvmem_prefix_coverage {
-        return;
-    }
-    let Some(domain) = rig.cache_domain.clone() else {
-        return;
-    };
-    let block = crate::kvmem_ctl::KV_BLOCK_TOKENS as u64;
-    let interval = rig.kvmem_prefix_coverage_interval as u64;
-    for s in 0..slots.len() {
-        if !work[s].decoding {
-            continue;
-        }
-        let Some(frame) = slots[s].as_ref() else {
-            continue;
-        };
-        let session = frame.session;
-        let Some(sess) = rig.sessions.get(session) else {
-            continue;
-        };
-        if sess.has_image {
-            continue;
-        }
-        let Some(fed) = rig
-            .model
-            .kvmem
-            .as_ref()
-            .and_then(|ctl| ctl.fed_tokens(s))
-        else {
-            continue;
-        };
-        let fed = fed as u64;
-        if fed == 0 || fed % block != 0 || fed % interval != 0 {
-            continue;
-        }
-        let boundary = fed as u32;
-        if sess.tokens.len() < boundary as usize {
-            continue;
-        }
-        let tokens: Vec<u32> = sess.tokens[..boundary as usize].to_vec();
-        let fp = crate::checkpoint::checkpoint_fingerprint(&tokens, None);
-        let model = &mut rig.model;
-        let Some(pool) = model.checkpoint_pool.as_mut() else {
-            continue;
-        };
-        if pool.peek(&domain, fed, fp).is_some() {
-            continue;
-        }
-        let state = &model.dn_states[s];
-        match crate::checkpoint::capture_checkpoint(
-            &mut rig.gpu,
-            pool,
-            &domain,
-            fed,
-            &tokens,
-            None, // coverage is text-only (vision sessions skip it)
-            state,
-        ) {
-            Ok(id) if id == crate::checkpoint::CheckpointId::NONE => {
-                // Pool ceiling refused capture; the boundary stays unreusable.
-            }
-            Ok(_) => {
-                if let Some(f) = slots[s].as_mut() {
-                    f.last_coverage_boundary = fed as usize;
-                }
-                if rig.gpu.slot_trace() {
-                    eprintln!("[kvmem-prefix] slot {s} coverage checkpoint at {fed}");
-                }
-            }
-            Err(e) => eprintln!("[kvmem-prefix] coverage capture skipped: {e:?}"),
-        }
-    }
-}
-
-/// P2.2b2 terminal endpoint freeze: freeze the page-aligned accepted frontier
-/// (including generated rows) using an existing coverage checkpoint as the
-/// recurrent-state proof. Pages must be resident (PIN is page-granular), so a
-/// conversation that overflowed the resident budget simply skips the endpoint.
-#[cfg(feature = "kvmem")]
-fn kvmem_freeze_endpoint(rig: &mut Rig, slots: &mut [Option<InFlight>], s: usize) {
-    if !rig.kvmem_prefix_pin {
-        return;
-    }
-    let Some(frame) = slots[s].as_ref() else {
-        return;
-    };
-    let session = frame.session;
-    let last_frozen = frame.last_frozen_boundary;
-    let Some(sess) = rig.sessions.get(session) else {
-        return;
-    };
-    let Some(fed) = rig
-        .model
-        .kvmem
-        .as_ref()
-        .and_then(|ctl| ctl.fed_tokens(s))
-    else {
-        return;
-    };
-    let block = crate::kvmem_ctl::KV_BLOCK_TOKENS as u32;
-    let aligned = (fed / block) * block;
-    let anchor = frame.last_coverage_boundary as u32;
-    let mut boundary = aligned;
-    if boundary == 0 || (boundary as usize) <= last_frozen {
-        boundary = anchor;
-    }
-    if boundary == 0
-        || boundary > fed
-        || (boundary as usize) <= last_frozen
-        || sess.tokens.len() < boundary as usize
-    {
-        return;
-    }
-    let n_pages = (boundary / block) as usize;
-    let Some(bt) = rig.pool.block_table(SlotId(s)) else {
-        return;
-    };
-    if bt.num_pages() < n_pages {
-        return;
-    }
-    let page_indices: Vec<u32> = bt.page_indices()[..n_pages].to_vec();
-    if page_indices
-        .iter()
-        .any(|&p| p == rdna_compute::page_pool::SPILLED_PAGE)
-    {
-        return;
-    }
-    let tokens: Vec<u32> = sess.tokens[..boundary as usize].to_vec();
-    // G7: the endpoint frontier must not split an image span; carry the
-    // session's media identity into the checkpoint.
-    let (media_digest, all_spans) = kvmem_session_media(rig, session);
-    if let Some(&(b, e)) = all_spans
-        .iter()
-        .find(|&&(b, e)| b < boundary && boundary < e)
-    {
-        // G7 Stage E probe: the endpoint replay anchor refuses this frontier.
-        if hipfire_config::developer_var("HIPFIRE_KVMEM_TRACE")
-            .ok()
-            .is_some_and(|v| v == "1" || v == "on" || v == "true")
-        {
-            eprintln!(
-                "[kvmem-media] endpoint freeze skip boundary={boundary} \
-                 splits span=[{b},{e})"
-            );
-        }
-        return;
-    }
-    let media_spans: Vec<(u32, u32)> = all_spans
-        .iter()
-        .copied()
-        .filter(|&(_, e)| e <= boundary)
-        .collect();
-    // G7 Stage E probe: endpoint frontier carries a media-aligned identity.
-    if hipfire_config::developer_var("HIPFIRE_KVMEM_TRACE")
-        .ok()
-        .is_some_and(|v| v == "1" || v == "on" || v == "true")
-    {
-        let fmt = |d: Option<u64>| {
-            d.map(|x| format!("{x:016x}"))
-                .unwrap_or_else(|| "none".to_string())
-        };
-        eprintln!(
-            "[kvmem-media] endpoint freeze boundary={boundary} digest={} spans={} inside={}",
-            fmt(media_digest),
-            all_spans.len(),
-            media_spans.len()
-        );
-    }
-    let Some(domain) = rig.cache_domain.as_ref() else {
-        return;
-    };
-    let Some(pool) = rig.model.checkpoint_pool.as_ref() else {
-        return;
-    };
-    if pool
-        .peek(
-            domain,
-            boundary as u64,
-            crate::checkpoint::checkpoint_fingerprint(&tokens, media_digest),
-        )
-        .is_none()
-    {
-        return;
-    }
-    match kvmem_catalog_and_pin(
-        rig,
-        s,
-        boundary,
-        &tokens,
-        &page_indices,
-        media_digest,
-        media_spans,
-    ) {
-        Ok(()) => {
-            if let Some(f) = slots[s].as_mut() {
-                f.last_frozen_boundary = boundary as usize;
-            }
-            if rig.gpu.slot_trace() {
-                eprintln!("[kvmem-prefix] slot {s} endpoint freeze at {boundary}");
-            }
-        }
-        Err(e) => eprintln!("[kvmem-prefix] endpoint freeze skipped: {e}"),
-    }
-}
-
-fn should_retain_terminal_tok(reason: DoneReason) -> bool {
-    matches!(reason, DoneReason::MaxTokens)
-}
-
-/// The materialized-row frontier a Done-time publication may seal up to.
-///
-/// `sess.tokens.len()` is the authoritative token stream, which can run one
-/// token AHEAD of the KV rows: a MaxTokens-terminated request retains its
-/// final sampled token without forwarding it (no row exists for it yet).
-/// Publication must never seal a page covering that unmaterialized row.
-fn done_publish_frontier(total_tokens: usize, state_boundary: usize) -> usize {
-    state_boundary.min(total_tokens)
-}
-
-fn handle_command(
-    rig: &mut Rig,
-    slots: &mut [Option<InFlight>],
-    work: &mut [PendingWork],
-    stats: &Arc<Mutex<EngineStats>>,
-    interrupts: &mut [bool],
-    cmd: EngineCommand,
-) {
-    match cmd {
-        EngineCommand::Submit(req) => {
-            // FIFO admission age (spec §5.3 S3): while older work sits in the
-            // waiting room, a newcomer must not take a free slot ahead of it
-            // — under continuous arrivals that would starve every waiter
-            // until its (wall-clock) deadline expired. Park the newcomer;
-            // the drain loop below the command path pops in enqueue order
-            // and admits as slots free.
-            if rig.wait_queue.queued_count() > 0 {
-                let waiter_id = rig.next_waiter_id;
-                rig.next_waiter_id += 1;
-                let bytes = req.queue_bytes.max(1);
-                match rig.wait_queue.try_enqueue(waiter_id, bytes, rig.tick) {
-                    Ok(()) => {
-                        rig.parked_requests.insert(
-                            waiter_id,
-                            ParkedRequest {
-                                req,
-                                enqueued_at: std::time::Instant::now(),
-                            },
-                        );
-                    }
-                    Err(we) => {
-                        let _ = send_event(
-                            &req.reply,
-                            Event::Rejected {
-                                class: RejectClass::Overload,
-                                reason: format!("serve queue full: {we}"),
-                            },
-                        );
-                        lock_stats(stats).note_rejected();
-                    }
-                }
-            } else {
-                admit(rig, slots, work, stats, req);
-            }
-        }
-        EngineCommand::CancelWaiting { request_tag } => {
-            // Cancellation for work that has no session yet (spec §4.6 C6:
-            // "removes queued work by attempt identity even before Accepted
-            // supplies a session ID"). The daemon correlates by the tag it
-            // stamped on the SubmitRequest.
-            let waiter_ids: Vec<u64> = rig
-                .parked_requests
-                .iter()
-                .filter(|(_, p)| p.req.request_tag == request_tag)
-                .map(|(id, _)| *id)
-                .collect();
-            for waiter_id in waiter_ids {
-                if let Some(parked) = rig.parked_requests.remove(&waiter_id) {
-                    rig.wait_queue.remove(waiter_id);
-                    let _ = send_event(
-                        &parked.req.reply,
-                        Event::Rejected {
-                            class: RejectClass::Cancel,
-                            reason: "cancelled while queued".to_string(),
-                        },
-                    );
-                    lock_stats(stats).note_rejected();
-                }
-            }
-        }
-        EngineCommand::Close { session, reply } => {
-            let sid = SessionId(session);
-            // At the engine-loop command boundary: if session is in flight,
-            // cancel it — remove InFlight, drop its reply sender (Event channel),
-            // clear work, forget swap, close SessionTable/pool/admission, then ack.
-            // Idle close does the same forget/close. No ignored close.
-            if let Some(idx) = slots
-                .iter()
-                .position(|s| s.as_ref().map(|f| f.session == sid).unwrap_or(false))
-            {
-                if let Some(mut inflight) = slots[idx].take() {
-                    release_pin_ticket(rig, &mut inflight.pin_ticket);
-                    drop(inflight.reply);
-                }
-                clear_work_slot(&mut work[idx]);
-                #[cfg(feature = "kvmem")]
-                if let Some(run) = rig.legacy_queries.get_mut(idx) {
-                    *run = None;
-                    rig.legacy_query_decided[idx] = false;
-                }
-                rig.model.clear_slot_vl_state(&mut rig.gpu, idx);
-                let _ = rig.fair_queue.remove(session);
-            }
-            rig.swap.forget(session);
-            rig.sessions.close(&mut rig.pool, &mut rig.adm, sid);
-            let _ = reply.send(Ok(()));
-        }
-        EngineCommand::Interrupt { session } => {
-            // Set the transient per-slot flag; the serve loop drains it at the
-            // top of the next scheduler step (before any per-slot work), so
-            // the pass ends at a token boundary with the session's KV intact.
-            // Unknown/parked sessions are a no-op: the daemon only interrupts
-            // after it has been told the session was accepted.
-            if let Some(idx) = slots.iter().position(|s| {
-                s.as_ref()
-                    .map(|f| f.session == SessionId(session))
-                    .unwrap_or(false)
-            }) {
-                if let Some(flag) = interrupts.get_mut(idx) {
-                    *flag = true;
-                }
-            }
-        }
-        EngineCommand::Reset { reply } => {
-            if slots.iter().any(|s| s.is_some()) {
-                let _ = reply.send(Err("reset rejected: requests in flight".to_string()));
-                return;
-            }
-            if rig.wait_queue.queued_count() > 0 {
-                let _ = reply.send(Err(
-                    "reset rejected: requests queued in the wait room".to_string()
-                ));
-                return;
-            }
-            let ids: Vec<u64> = rig.sessions.iter().map(|(id, _)| id).collect();
-            for id in ids {
-                rig.swap.forget(id);
-                rig.sessions
-                    .close(&mut rig.pool, &mut rig.adm, SessionId(id));
-            }
-            // Reset returns the engine to a cold empty table: parked
-            // inactive histories and any half-finished Query checkpoint go
-            // with it (their host stores belong to sessions that no longer
-            // exist).
-            #[cfg(feature = "kvmem")]
-            {
-                for run in rig.legacy_queries.iter_mut() {
-                    *run = None;
-                }
-                for decided in rig.legacy_query_decided.iter_mut() {
-                    *decided = false;
-                }
-                if let Some(catalog) = rig.legacy_history.as_mut() {
-                    if let Ok(dropped) = catalog.clear() {
-                        eprintln!(
-                            "[kvmem-legacy] HistoryReset dropped_entries={}",
-                            dropped.len()
-                        );
-                    }
-                }
-            }
-            // Drop prefix cache state so subsequent lookups miss (spec §4.6).
-            // The radix index owns cache leases taken at publication: it
-            // MUST release them into the pool before being replaced, or
-            // every published page strands CacheOnly and the pool drains to
-            // zero free pages within a few reset cycles (A20 leak).
-            if rig.prefix_cache {
-                if let Some(pp) = rig.pool.page_pool_mut() {
-                    if let Some(idx) = rig.prefix_index.as_mut() {
-                        let released_pages = idx.release_all(pp);
-                        pp.drain_completed();
-                        if rig.gpu.slot_trace() {
-                            eprintln!("[slot-trace] reset released {released_pages} cached pages");
-                        }
-                    }
-                    // Fresh empty index: every subsequent lookup misses. The
-                    // retained-byte ceiling must be re-applied — a bare
-                    // `PrefixIndex::new` has no ceiling, and losing it here
-                    // silently unbounded cache retention for the rest of
-                    // the process lifetime.
-                    let mut idx = hipfire_runtime::prefix_index::PrefixIndex::new(1 << 16);
-                    idx.set_max_retained_bytes(rig.prefix_cache_max_bytes.unwrap_or(usize::MAX));
-                    rig.prefix_index = Some(idx);
-                }
-                // Drain and free GPU blobs from the checkpoint pool.
-                if let Some(pool) = rig.model.checkpoint_pool.as_mut() {
