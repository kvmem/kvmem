+            .pool
+            .page_pool()
+            .map(|pp| pp.k_page_bytes() + pp.v_page_bytes())
+            .unwrap_or(0);
+        let free = rig.pool.page_pool().map(|pp| pp.free_pages()).unwrap_or(0);
