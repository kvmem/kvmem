@@ -0,0 +1,126 @@
+#include "models/qwen3_5/program/storage/layerwise_kv_transfer.h"
+#include <algorithm>
+#include <array>
+#include <cstring>
+#include <limits>
+
+namespace ninfer::models::qwen3_5::detail {
+namespace {
+bool same_history(const kvmem::MemoryStamp& a,const kvmem::MemoryStamp& b) {
+    auto left=a,right=b;left.view_version=right.view_version=0;return left==right;
+}
+bool same_view(const kvmem::ExecutionView& a,const kvmem::ExecutionView& b) {
+    if (!(a.stamp==b.stamp) || a.visible_tokens!=b.visible_tokens || a.blocks.size()!=b.blocks.size()) return false;
+    for (std::size_t i=0;i<a.blocks.size();++i)
+        if (!(a.blocks[i].block==b.blocks[i].block) || a.blocks[i].compact_start!=b.blocks[i].compact_start) return false;
+    return true;
+}
+struct Drain {
+    DeviceContext& device;bool armed=false;
+    ~Drain() { if (armed) try { device.synchronize(); } catch (...) {} }
+    void finish() { device.synchronize();armed=false; }
+};
+}
+
+kvmem::ExecutionView restore_native_layer_stripe(
+    const NativeFrozenLayerArchive& archive,const kvmem::MemorySnapshot& current,
+    const kvmem::LayerWorkingSetPlan& layer,DeviceKVPagePool& pool,KVAddressSpaceStore& addresses,
+    KVAddressSpaceHandle address,DeviceContext& device,RankStreams streams,PinnedHostBuffer& staging,
+    std::uint64_t pool_offset,bool verify) {
+    archive.descriptor.validate();
+    if (!(current.stamp==layer.plan.expected) || !same_history(current.stamp,archive.canonical.stamp) ||
+        current.blocks.size()!=archive.canonical.blocks.size() || archive.records.size()!=current.blocks.size() ||
+        !layer.plan.spill.empty() || streams.size()!=device.size() || pool.rank_count()>device.size())
+        throw std::logic_error("native stripe restore has stale or incomplete canonical history");
+    const auto& canonical=archive.descriptor.layout;
+    for (std::size_t i=0;i<current.blocks.size();++i) {
+        const auto& source=archive.canonical.blocks[i];
+        if (!(current.blocks[i].block==source.block) || source.block.id!=i ||
+            source.block.original_start!=std::uint64_t(i)*64 ||
+            source.host_version!=source.block.content_version || !archive.records[i] ||
+            archive.records[i].size()!=canonical.record_bytes)
+            throw std::logic_error("native stripe restore lacks a complete current canonical record");
+    }
+    std::vector<std::uint64_t> selected;selected.reserve(layer.plan.next.blocks.size());
+    for (const auto& item:layer.plan.next.blocks) selected.push_back(item.block.id);
+    const auto checked=kvmem::plan_working_set(archive.descriptor,current,selected,
+        layer.plan.mandatory,layer.plan.budget);
+    if (!same_view(checked.next,layer.plan.next) || !checked.spill.empty() ||
+        canonical.block_tokens!=64 || layer.plan.next.blocks.size()>UINT32_MAX)
+        throw std::logic_error("native stripe plan differs from its canonical source");
+    const kvmem::NativeKvLayerRegions regions(canonical,layer.model_layer);
+    if (regions.packed_bytes()!=layer.payload.packed_bytes() ||
+        regions.regions().size()!=layer.payload.regions().size())
+        throw std::logic_error("native stripe payload differs from the model-layer layout");
+    for (std::size_t i=0;i<regions.regions().size();++i)
+        if (!(regions.regions()[i].plane==layer.payload.regions()[i].plane) ||
+            regions.regions()[i].packed_offset!=layer.payload.regions()[i].packed_offset)
+            throw std::logic_error("native stripe payload changed a native region");
+
+    auto host=plan_host_kv_page_layout(pool.geometry());
+    const auto full_host=host;
+    if (pool_offset>canonical.record_bytes || host.page_stride>canonical.record_bytes-pool_offset ||
+        regions.packed_bytes()>std::numeric_limits<std::size_t>::max() ||
+        staging.size()<regions.packed_bytes() || (verify && staging.size()<full_host.page_stride))
+        throw std::invalid_argument("native stripe staging or canonical pool extent is too small");
+    std::vector<std::size_t> planes;planes.reserve(regions.regions().size());
+    for (const auto& region:regions.regions()) {
+        std::size_t found=host.planes.size();
+        for (std::size_t i=0;i<full_host.planes.size();++i)
+            if (full_host.planes[i].offset+pool_offset==region.plane.offset) {found=i;break;}
+        if (found==host.planes.size() || host.planes[found].page_payload_bytes!=region.plane.bytes ||
+            pool.plane_rank(found)!=region.plane.rank ||
+            std::find(planes.begin(),planes.end(),found)!=planes.end())
+            throw std::logic_error("native stripe region does not match its pool/rank plane");
+        planes.push_back(found);host.planes[found].offset=static_cast<std::size_t>(region.packed_offset);
+    }
+    // Keep the complete native geometry inventory; only selected offsets and
+    // the host record pitch differ. The pool's existing restricted-plane copy
+    // accesses exactly these regions, preserving native codes/scales verbatim.
+    host.page_stride=static_cast<std::size_t>(regions.packed_bytes());
+    KVLayerStripeWrite::require_unpublished_destination(addresses,address,pool,
+        static_cast<std::uint32_t>(selected.size()));
+    for (std::size_t rank=0;rank<device.size();++rank) {
+        DeviceBinding binding(device.rank(rank).device);
+        cudaStreamCaptureStatus status=cudaStreamCaptureStatusNone;
+        CUDA_CHECK(cudaStreamIsCapturing(streams[rank],&status));
+        if (status!=cudaStreamCaptureStatusNone)
+            throw std::logic_error("native stripe restore requires an eager Program boundary");
+    }
+    // All metadata and geometry checks precede the first native mutation.
+    // Per-page immutable sources remain cold; the one bounded pinned staging
+    // record is reused only after every producer-rank copy has drained.
+    Drain drain{device};
+    for (std::size_t slot=0;slot<selected.size();++slot) {
+        const auto& source=archive.records.at(static_cast<std::size_t>(selected[slot]));
+        regions.read(source,0,staging.data(),static_cast<std::size_t>(regions.packed_bytes()));
+        const std::array records{static_cast<const std::byte*>(staging.data())};
+        const std::array destinations{addresses.physical_page(address,static_cast<std::uint32_t>(slot))};
+        drain.armed=true;
+        for (auto plane:planes)
+            pool.copy_from_host_records(records,{},destinations,host,plane,plane+1,streams);
+        drain.finish();
+        if (verify) {
+            // Diagnostic readback uses the existing full-page native API; it
+            // compares only the selected stripes, never calls them a canonical
+            // composite record and never inserts them into Host storage.
+            const std::array outputs{static_cast<std::byte*>(staging.data())};
+            drain.armed=true;pool.copy_to_host_records(destinations,outputs,{},full_host,streams);drain.finish();
+            std::array<std::byte,4096> reference;
+            for (const auto& region:regions.regions()) {
+                std::uint64_t offset=0;
+                while (offset<region.plane.bytes) {
+                    const auto count=static_cast<std::size_t>(std::min<std::uint64_t>(reference.size(),region.plane.bytes-offset));
+                    source.read(static_cast<std::size_t>(region.plane.offset+offset),reference.data(),count);
+                    const auto* native=static_cast<const std::byte*>(staging.data())+
+                        static_cast<std::size_t>(region.plane.offset-pool_offset+offset);
+                    if (std::memcmp(native,reference.data(),count))
+                        throw std::runtime_error("native layer stripe readback differs from sealed source bytes");
+                    offset+=count;
+                }
+            }
+        }
+    }
+    return checked.next;
+}
+} // namespace ninfer::models::qwen3_5::detail
diff --git a/src/models/qwen3_5/program/storage/layerwise_kv_transfer.h b/src/models/qwen3_5/program/storage/layerwise_kv_transfer.h
