+        auto scope = work_.scope();
+        text_rope(storage.rope_positions, *config_.rope_parameters, rope_yarn_,
+                   storage.query, storage.key, ctx_.stream);
+        MemoryStatisticsShard local;
+        std::int32_t statistics_layer;
+        const auto* statistics = memory_statistics_for_layer(prepared.identity_.attention_layer, local, statistics_layer);
+        capture_post_rope_query(storage.query, prepared.identity_.attention_layer, statistics);
