+// One stable Program-owned capture area; never moved/resized after graph capture.
+// Program declares it before graph caches, while its persistent arenas precede it.
+class NativeLayerwiseGraphFeedbackStorage {
+public:
+    NativeLayerwiseGraphFeedbackStorage(ProgramImpl&,const SequencePlanImpl&,std::span<const DeviceSpan>);
+    ~NativeLayerwiseGraphFeedbackStorage();
+    NativeLayerwiseGraphFeedbackStorage(const NativeLayerwiseGraphFeedbackStorage&)=delete;
