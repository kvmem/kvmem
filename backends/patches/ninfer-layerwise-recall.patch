+        std::uint64_t(max_physical_rows)*max_batch_size>std::uint64_t(INT32_MAX))
+        throw std::logic_error("layerwise graph capture has an invalid native physical extent");
+    const auto rows=std::uint64_t(max_physical_rows)*max_batch_size;
+    for (std::size_t i=0;i<slots.size();++i) {
+        const auto& s=slots[i];
+        if (s.query.ne[0]<=0 || !s.query_heads ||
+            std::uint64_t(s.query.ne[0])>std::uint64_t(INT64_MAX)/s.query_heads/rows)
+            throw std::length_error("layerwise graph Q descriptor extent overflows");
+        if (!s.query_heads || !s.global_query_heads || s.first_query_head>s.global_query_heads ||
+            s.query_heads>s.global_query_heads-s.first_query_head || s.query.ne[0]<=0 ||
+            !plane(s.query,DType::BF16,std::uint64_t(s.query.ne[0])*s.query_heads*rows) ||
+            s.query.ne[1]!=s.query_heads || s.query.ne[2]!=rows || s.query.ne[3]!=1 ||
+            !plane(s.positions,DType::I32,rows) || !plane(s.table_rows,DType::I32,max_batch_size) ||
+            !plane(s.completed_epoch,DType::I64,1) || !plane(s.ingress_epoch,DType::I64,1))
+            throw std::logic_error("layerwise graph capture has incomplete native Q/control backing");
+        if (std::uint64_t(s.query.ne[0])>std::uint64_t(INT64_MAX)/s.query_heads/rows)
+            throw std::length_error("layerwise graph Q tensor extent overflows its native byte domain");
+        std::uint64_t covered=0;
+        for (std::size_t j=0;j<slots.size();++j) {
+            const auto& t=slots[j];
+            if (t.model_layer!=s.model_layer) continue;
+            if (t.attention_layer!=s.attention_layer || t.global_query_heads!=s.global_query_heads ||
+                t.query.ne[0]!=s.query.ne[0])
+                throw std::logic_error("layerwise graph target head descriptors disagree");
+            if (i!=j && (t.rank==s.rank ||
+                (t.first_query_head<s.first_query_head+s.query_heads &&
+                 s.first_query_head<t.first_query_head+t.query_heads)))
+                throw std::logic_error("layerwise graph target heads overlap");
+            covered+=t.query_heads;
+        }
+        if (covered!=s.global_query_heads)
+            throw std::logic_error("layerwise graph target heads are not complete");
+        if (i && (slots[i-1].model_layer>s.model_layer ||
+            (slots[i-1].model_layer==s.model_layer && slots[i-1].first_query_head>=s.first_query_head)))
+            throw std::logic_error("layerwise graph capture targets are out of native head order");
+    }
+}
+void capture_layerwise_graph_attention(const LayerwiseGraphCaptureView& view,
+    std::uint32_t model,std::uint32_t ordinal,std::size_t rank,const Tensor& q,
+    const Tensor& positions,const Tensor& tables,cudaStream_t stream) {
+    const auto found=std::find_if(view.slots.begin(),view.slots.end(),[&](const auto& s) {
+        return s.model_layer==model && s.attention_layer==ordinal && s.rank==rank;
+    });
+    if (found==view.slots.end() || !q.data || q.dtype!=DType::BF16 || !q.is_contiguous() ||
+        q.ne[0]!=found->query.ne[0] || q.ne[1]!=found->query_heads || q.ne[2]<=0 || q.ne[3]!=1 ||
+        q.ne[2]>found->query.ne[2] || !positions.data || positions.dtype!=DType::I32 ||
+        !positions.is_contiguous() || positions.numel()!=q.ne[2] || !tables.data ||
+        tables.dtype!=DType::I32 || !tables.is_contiguous() || tables.numel()<=0 ||
+        tables.numel()>view.max_batch_size || q.ne[2]%tables.numel() ||
+        q.ne[2]/tables.numel()>view.max_physical_rows)
+        throw std::logic_error("native graph Q/control differs from its admitted target capture");
+    CUDA_CHECK(cudaMemcpyAsync(found->query.data,q.data,q.bytes(),cudaMemcpyDeviceToDevice,stream));
+    CUDA_CHECK(cudaMemcpyAsync(found->positions.data,positions.data,positions.bytes(),cudaMemcpyDeviceToDevice,stream));
+    CUDA_CHECK(cudaMemcpyAsync(found->table_rows.data,tables.data,tables.bytes(),cudaMemcpyDeviceToDevice,stream));
+    CUDA_CHECK(cudaMemcpyAsync(found->completed_epoch.data,found->ingress_epoch.data,sizeof(std::uint64_t),cudaMemcpyDeviceToDevice,stream));
+}
