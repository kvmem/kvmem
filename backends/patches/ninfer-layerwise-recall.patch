+        }
+        const auto visible=static_cast<std::uint32_t>(auxiliary_tokens+begin-identity.evaluation.begin+n);
+        if (logits && input_owner->initial_mtp_extent) {
+            Tensor draft0=p.io.mtp->draft_tokens.slice(0,0,1),output=p.io.logits.slice(1,0,1);
