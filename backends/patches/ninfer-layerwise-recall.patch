+            auto position=p.io.mtp->position.slice(0,0,1);
+            ops::set_i32_scalar(position,static_cast<std::int32_t>(visible)-1,p.device.stream);
+            ops::set_i32_scalar(p.io.rope_delta,sequence.rope_delta+static_cast<std::int32_t>(pending_maps.auxiliary_removed_tokens),p.device.stream);
+            for (std::uint32_t i=1;i<input_owner->initial_mtp_extent;++i) {
+                auto scope=p.work.scope();Tensor next=p.work.alloc(DType::BF16,{dimension(p.parameters.model.config().text.hidden_size),1});
+                auto previous=p.io.mtp->draft_tokens.slice(0,static_cast<std::int32_t>(i)-1,1);
+                auto next_token=p.io.mtp->draft_tokens.slice(0,static_cast<std::int32_t>(i),1);
+                card.mtp_forward_ar_step(previous,p.io.mtp->ar_hidden,position,{visible+i,visible+i},next,output,next_token);
+                CUDA_CHECK(cudaMemcpyAsync(p.io.mtp->ar_hidden.data,next.data,next.bytes(),cudaMemcpyDeviceToDevice,p.device.stream));
+                ops::increment_i32_scalar(position,p.device.stream);
+            }
+            ops::set_i32_scalar(p.io.rope_delta,sequence.rope_delta+static_cast<std::int32_t>(identity.evaluation.begin-history_tokens),p.device.stream);
+        } else card.query_mtp_prefill(ids,hidden,positions,rope,{visible,visible},false,nullptr,nullptr,nullptr,embedding);
+    }
+    void abort() noexcept {
+        if (accepted || invalid) return;
+        if (runner) runner->abort();
+        try { program.device.synchronize(); } catch (...) {}
+        // The native request's private PF matrix can borrow the sole Program
+        // Query supplement. Retire it before the outer work slot releases;
+        // otherwise a failed request could overlap the next owner's credit.
+        if (sequence.window.layerwise_request) sequence.window.layerwise_request->abort();
+        if (mutated) { sequence.window.stamp.valid=false;sequence.window.layerwise_rewrite_pending=true; }
+        if (transaction) transaction->abort();invalid=true;
+    }
+};
