+namespace ninfer::models::qwen3_5::detail {
+class NativeSourceVersionAccount;
+class NativeSourceQuotaExceeded final : public std::length_error {
+public:
+    NativeSourceQuotaExceeded(const char* message, const NativeSourceVersionAccount* owner,
+                              std::uint64_t requested, std::uint64_t available)
+        : std::length_error(message), account(owner), growth(requested), shortfall(requested-available) {}
+    const NativeSourceVersionAccount* const account;
+    const std::uint64_t growth, shortfall;
+};
+class NativeSourceVersionCharge {
+public:
+    NativeSourceVersionCharge()=default;
+    NativeSourceVersionCharge(const NativeSourceVersionCharge&)=delete;
+    NativeSourceVersionCharge& operator=(const NativeSourceVersionCharge&)=delete;
+    NativeSourceVersionCharge(NativeSourceVersionCharge&& other) noexcept
+        :account_(std::move(other.account_)),bytes_(std::exchange(other.bytes_,0)) {}
+    NativeSourceVersionCharge& operator=(NativeSourceVersionCharge&&) noexcept;
+    ~NativeSourceVersionCharge();
+    void shrink(std::uint64_t bytes);
+    void resize(std::uint64_t bytes);
+    NativeSourceVersionCharge split(std::uint64_t bytes);
+    // Merge an already charged Waiting delta without temporarily reserving it
+    // twice. The class fields/layout and all existing methods remain unchanged.
+    void absorb_same_account(NativeSourceVersionCharge&& other);
+    std::uint64_t bytes() const noexcept {return bytes_;}
+    const std::shared_ptr<NativeSourceVersionAccount>& account() const noexcept {return account_;}
+private:
+    friend class NativeSourceVersionAccount;
+    NativeSourceVersionCharge(std::shared_ptr<NativeSourceVersionAccount> account,std::uint64_t bytes)
+        :account_(std::move(account)),bytes_(bytes) {}
+    void release() noexcept;
+    std::shared_ptr<NativeSourceVersionAccount> account_;
+    std::uint64_t bytes_=0;
+};
+// Shared by source versions, checkpoints and same-account forks. A removed
+// catalog entry cannot make a still-borrowed immutable index free of charge.
+class NativeSourceVersionAccount : public std::enable_shared_from_this<NativeSourceVersionAccount> {
+public:
+    explicit NativeSourceVersionAccount(std::uint64_t limit):limit_(limit) {
+        if (!limit || limit==UINT64_MAX) throw std::invalid_argument("native source-version account must be finite and positive");
+    }
+    NativeSourceVersionCharge reserve(std::uint64_t bytes) {
+        auto owner=shared_from_this();
+        std::lock_guard lock(mutex_);
+        if (used_>limit_) throw std::logic_error("native source account exceeds its limit");
+        if (bytes>limit_-used_) throw NativeSourceQuotaExceeded(
+            "native immutable source index/metadata account exhausted",this,bytes,limit_-used_);
+        used_+=bytes;return {std::move(owner),bytes};
+    }
+    std::uint64_t limit() const noexcept {return limit_;}
+    std::uint64_t charged_bytes() const {std::lock_guard lock(mutex_);return used_;}
+private:
+    friend class NativeSourceVersionCharge;
+    mutable std::mutex mutex_;std::uint64_t limit_,used_=0;
+};
+inline void NativeSourceVersionCharge::release() noexcept {
+    if (account_) {std::lock_guard lock(account_->mutex_);account_->used_-=bytes_;}account_.reset();bytes_=0;
+}
+inline NativeSourceVersionCharge::~NativeSourceVersionCharge() {release();}
+inline NativeSourceVersionCharge& NativeSourceVersionCharge::operator=(NativeSourceVersionCharge&& other) noexcept {
+    if (this!=&other) {release();account_=std::move(other.account_);bytes_=std::exchange(other.bytes_,0);}return *this;
+}
+inline void NativeSourceVersionCharge::shrink(std::uint64_t bytes) {
+    if (bytes>bytes_) throw std::logic_error("native immutable source exceeded its admitted metadata extent");
+    if (account_) {std::lock_guard lock(account_->mutex_);account_->used_-=bytes_-bytes;}bytes_=bytes;
+}
+inline void NativeSourceVersionCharge::resize(std::uint64_t bytes) {
+    if (bytes<=bytes_) {shrink(bytes);return;}
+    if (!account_) throw std::logic_error("native metadata growth has no owning account");
+    std::lock_guard lock(account_->mutex_);
+    const auto growth=bytes-bytes_;
+    if (account_->used_>account_->limit_) throw std::logic_error("native source account exceeds its limit");
+    if (growth>account_->limit_-account_->used_) throw NativeSourceQuotaExceeded(
+        "native shared metadata account exhausted",account_.get(),growth,account_->limit_-account_->used_);
+    account_->used_+=growth;bytes_=bytes;
+}
+inline NativeSourceVersionCharge NativeSourceVersionCharge::split(std::uint64_t bytes) {
+    if (!account_ || bytes>bytes_) throw std::length_error("native metadata publication exceeds its admitted lease");
+    bytes_-=bytes;return {account_,bytes};
+}
+
+inline void NativeSourceVersionCharge::absorb_same_account(NativeSourceVersionCharge&& other) {
+    if (this==&other || !account_ || account_!=other.account_ || other.bytes_>UINT64_MAX-bytes_)
+        throw std::logic_error("native metadata merge requires distinct same-account charged leases");
+    bytes_+=std::exchange(other.bytes_,0);other.account_.reset();
+}
+
+struct NativeCanonicalHistoryVersion {
+    kvmem::MemoryDescriptor descriptor;
+    kvmem::MemoryStamp accepted;
+    std::uint64_t epoch=0;
+    std::uint32_t frontier=0;
+    // Sealed full native records, including exact K/V/scales and auxiliary
+    // planes. Forks share their original HostKvStorage charge; a first write
+    // detaches through its existing COW path. No tensor is reencoded here.
+    std::vector<kvmem::HostKvRecord> records;
+    std::vector<std::uint32_t> valid_tokens;
+    // Exact represented FP32 k_sum/count. Persistent post-RoPE/quantized K
+    // cannot reconstruct this index; mean*count is not an equivalent copy.
+    std::shared_ptr<const kvmem::RawKvStore> mean_index;
+    NativeSourceVersionCharge charge;
+    static std::uint64_t descriptor_bytes(const kvmem::MemoryDescriptor& d) {
+        return d.identity.backend.capacity()+d.identity.revision.capacity()+d.identity.model.capacity()+d.identity.state_schema.capacity()+
+            d.layout.format.capacity()+d.layout.planes.capacity()*sizeof(kvmem::PayloadPlane);
+    }
+    std::uint64_t metadata_bytes() const {
+        return sizeof(*this)+64+descriptor_bytes(descriptor)+records.capacity()*sizeof(kvmem::HostKvRecord)+
+            valid_tokens.capacity()*sizeof(std::uint32_t)+(mean_index?mean_index->allocated_bytes():0);
+    }
+    void validate() const {
+        if (!epoch || !frontier || accepted.frontier!=frontier || !accepted.valid || !mean_index ||
+            records.size()!=(std::uint64_t(frontier)+63)/64 || valid_tokens.size()!=records.size() || !charge.account())
+            throw std::logic_error("native checkpoint has incomplete immutable canonical ownership");
+        for (std::size_t id=0;id<records.size();++id) {
+            const auto valid=std::min<std::uint64_t>(64,frontier-id*64);
+            if (!records[id] || records[id].size()!=descriptor.layout.record_bytes || valid_tokens[id]!=valid)
+                throw std::logic_error("native immutable source changed its original page geometry");
+            for (std::uint32_t layer=0;layer<mean_index->config().n_layer;++layer)
+                if (mean_index->mean_k_tokens(static_cast<std::uint32_t>(id),layer)!=valid)
+                    throw std::logic_error("native immutable source lost exact Mean-K counts");
+        }
+    }
+};
