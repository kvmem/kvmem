--- /dev/null
+++ b/src/models/qwen3_5/program/native_dflash_features.h
@@ -0,0 +1,28 @@
+#pragma once
+#include "models/qwen3_5/program/native_query_runner.h"
+
+namespace ninfer::models::qwen3_5::detail {
+// Retains exactly the model's configured BF16 target residual taps across the
+// layer-major Query. This owns no GPU allocation or model operation: append()
+// restores the native feature concatenation and invokes the existing draft
+// context projection/materialization at original logical token positions.
+class NativeLayerwiseDFlashFeatures {
+public:
+    NativeLayerwiseDFlashFeatures(const TextConfig&,const DraftConfig&,
+        kvmem::LayerwiseQueryIdentity,std::uint32_t chunk,NativeQueryActivationLimits&);
+    ~NativeLayerwiseDFlashFeatures();
+    NativeLayerwiseDFlashFeatures(const NativeLayerwiseDFlashFeatures&)=delete;
+    NativeLayerwiseDFlashFeatures& operator=(const NativeLayerwiseDFlashFeatures&)=delete;
+    void capture(std::uint32_t model_layer,std::uint64_t begin,const Tensor&,cudaStream_t);
+    // Pure bounded native staging. Does not project, append or publish a draft
+    // frontier; callers may inspect the same bytes before native consumption.
+    void restore(std::uint64_t begin,std::uint32_t rows,const Tensor& features,
+        const Tensor& positions,cudaStream_t);
+    void append(execution::PrefillContext&,std::uint64_t begin,std::uint32_t rows);
+    bool complete() const noexcept;
+private:
+    struct Impl;
+    std::unique_ptr<Impl> impl_;
+};
+std::uint64_t native_dflash_feature_staging_bytes(const TextConfig&,std::uint32_t chunk);
+}
diff --git a/src/models/qwen3_5/program/native_feedback_workspace.h b/src/models/qwen3_5/program/native_feedback_workspace.h
new file mode 100644
index 0000000000000000000000000000000000000000..6885289fbcbc9f3d64c207570cb58d34927753f2
--- /dev/null
+++ b/src/models/qwen3_5/program/native_feedback_workspace.h
@@ -0,0 +1,103 @@
+#pragma once
+#include "models/qwen3_5/program/storage/layerwise_feedback.h"
+#include "kvmem/layerwise_window.hpp"
+#include "ninfer/base.h"
+#include <algorithm>
+#include <array>
+#include <limits>
+#include <memory>
+
+namespace ninfer::models::qwen3_5::detail {
+inline std::uint64_t feedback_add(std::uint64_t a,std::uint64_t b) {
+    if (b>UINT64_MAX-a) throw std::length_error("feedback workspace byte sum overflows");return a+b;
+}
+inline std::uint64_t feedback_mul(std::uint64_t a,std::uint64_t b) {
+    if (b && a>UINT64_MAX/b) throw std::length_error("feedback workspace byte count overflows");return a*b;
+}
+// Only dimensions enter this value. The owning Program const member is
+// constructed once from the actual startup candidate tensor layout; PF/Query
+// controls never borrow or mutate this Output upload source.
+inline std::array<std::int32_t,4> native_output_candidate_ranges(std::uint64_t columns) {
+    if (!columns || columns>std::uint64_t(INT32_MAX))
+        throw std::length_error("native candidate range exceeds its actual int32 layout");
+    return {0,static_cast<std::int32_t>(columns),0,0};
+}
+struct NativeFeedbackWorkspacePlan {
+    std::uint64_t workspace_bytes=0,snapshot_bytes=0,query_extra_bytes=0;
+};
+// Engineering storage bound, not a sampling or ranking rule. The row bound
+// counts at most the existing stride schedule and the full physical verifier.
+inline NativeFeedbackWorkspacePlan plan_native_feedback_workspace(
+    const kvmem::LayerwiseRequestEnvelope& e,std::uint64_t capacity,
+    std::uint32_t layers,std::uint32_t ranks,std::uint32_t physical_rows,
+    const kvmem::LayerwisePrefillOptions& pf,std::uint64_t owner_bytes) {
+    const auto end=feedback_add(e.prompt_end,e.output_tokens);
+    if (!layers || !ranks || !physical_rows || physical_rows>64 || !pf.block_tokens || end>capacity)
+        throw std::logic_error("active feedback entitlement lacks a complete native request envelope");
+    const auto pages=feedback_add(end,pf.block_tokens-1)/pf.block_tokens;
+    const auto visible=feedback_add(std::min<std::uint64_t>(feedback_add(pf.select_tokens,pf.reserve_tokens),end),pf.block_tokens-1)/pf.block_tokens;
+    // Core vectors are checked against actual capacity before publication;
+    // reserve two capacities for each public logical-domain vector.
+    const auto state=feedback_mul(feedback_mul(2,layers),sizeof(kvmem::LayerwisePrefillState)+sizeof(kvmem::LayerwiseOutputState));
+    const auto values=feedback_mul(feedback_mul(feedback_mul(2,layers),pages),
+        sizeof(kvmem::LayerwisePrefillValue)+2*sizeof(std::pair<std::uint64_t,double>));
+    const auto snapshot=feedback_add(sizeof(NativeLayerwiseFeedbackSnapshot)+128,feedback_add(state,values));
+    const auto pf_rows=pf.stride?feedback_add(pf.reserve_tokens,pf.stride-1)/pf.stride:1;
+    const auto rows=std::uint64_t(physical_rows);
+    const auto query_rows=std::max<std::uint64_t>(physical_rows,pf_rows);
+    const auto matrix=feedback_mul(feedback_mul(feedback_mul(rows,visible),layers),sizeof(double));
+    const auto maps=feedback_mul(feedback_mul(visible,layers),64);
+    const auto heads=feedback_mul(feedback_mul(layers,ranks),256);
+    const auto parser=feedback_mul(e.prompt_end,sizeof(std::uint32_t));
+    const auto control=feedback_mul(feedback_add(pf.reserve_tokens,feedback_mul(rows,8)),64);
+    // Live/core-private/next/packet state coexist at commit. Accepted CPs have
+    // their OWN source-account funding and cannot pin this reusable credit.
+    auto bytes=feedback_add(feedback_add(owner_bytes,2048),feedback_add(feedback_mul(snapshot,8),feedback_mul(matrix,6)));
+    bytes=feedback_add(bytes,feedback_add(parser,feedback_add(heads,feedback_add(maps,control))));
+    const auto extra_rows=query_rows-rows;
+    const auto extra_matrix=feedback_mul(feedback_mul(feedback_mul(extra_rows,visible),layers),sizeof(double));
+    const auto extra=feedback_add(feedback_mul(extra_matrix,6),feedback_mul(extra_rows,512));
+    return {bytes,snapshot,extra};
+}
+inline std::shared_ptr<NativeSourceVersionAccount> reserve_native_feedback_workspace(
+    const std::shared_ptr<NativeSourceVersionAccount>& parent,std::uint64_t bytes,std::uint64_t capacity=0) {
+    if (!parent || !bytes || (capacity && capacity<bytes)) throw std::logic_error("active feedback workspace has no valid Program account/capacity");
+    NativeSourceVersionCharge charge;
+    try {charge=parent->reserve(bytes);}
+    catch (const std::length_error&) {throw kvmem::MemoryError(kvmem::MemoryErrorCode::BudgetExceeded,
+        "active request feedback entitlement exceeds the shared metadata limit");}
+    // A retained live snapshot must keep the parent reservation valid even
+    // during exceptional owner retirement. Normal CP/retained boundaries copy
+    // it into the source account and release the complete active entitlement.
+    auto funding=std::make_shared<NativeSourceVersionCharge>(std::move(charge));
+    return std::shared_ptr<NativeSourceVersionAccount>(new NativeSourceVersionAccount(capacity?capacity:bytes),
+        [funding=std::move(funding)](NativeSourceVersionAccount* account){delete account;});
+}
+inline NativeSourceVersionCharge reserve_native_source_feedback(
+    const std::shared_ptr<NativeSourceVersionAccount>& account,std::uint64_t bytes) {
+    if (!account || !bytes) throw std::logic_error("immutable feedback has no complete source funding account");
+    try {return account->reserve(bytes);}
+    catch (const std::length_error&) {throw kvmem::MemoryError(kvmem::MemoryErrorCode::BudgetExceeded,
+        "immutable accepted-feedback publication exceeds its independent source limit");}
+}
+struct NativeQueryWorkIdentity {
+    std::uint32_t lane=0;
+    std::uint64_t lane_epoch=0,request=0;
+    bool operator==(const NativeQueryWorkIdentity&) const=default;
+};
+class NativeLayerwiseQueryWorkSlot {
+public:
+    bool occupied() const noexcept {return active_;}
+    bool owns(NativeQueryWorkIdentity id) const noexcept {return active_ && id==owner_;}
+    bool acquire(NativeQueryWorkIdentity id) {
+        if (!id.request || !id.lane_epoch || id.lane>=kMaximumConcurrency) throw std::logic_error("Query work slot has no actual native lane/request generation");
+        if (active_) return false;owner_=id;active_=true;return true;
+    }
+    void release(NativeQueryWorkIdentity id) {
+        if (!owns(id)) throw std::logic_error("Query work slot released by a foreign generation");active_=false;
+    }
+private:
+    NativeQueryWorkIdentity owner_;
+    bool active_=false;
+};
+} // namespace ninfer::models::qwen3_5::detail
diff --git a/src/models/qwen3_5/program/native_graph_feedback.cpp b/src/models/qwen3_5/program/native_graph_feedback.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..34485a5f27b5676fc04d2ee91648bf076a7ee630
--- /dev/null
+++ b/src/models/qwen3_5/program/native_graph_feedback.cpp
@@ -0,0 +1,155 @@
+#include "models/qwen3_5/program/native_graph_feedback.h"
+#include "models/qwen3_5/program/program_impl.h"
+#include "models/qwen3_5/execution/attention.h"
+#include <algorithm>
+#include <limits>
+#include <stdexcept>
+
+namespace ninfer::models::qwen3_5::detail {
+namespace {
+std::uint64_t graph_add(std::uint64_t a,std::uint64_t b) {
+    if (b>UINT64_MAX-a) throw std::length_error("graph feedback byte sum overflows");return a+b;
+}
+std::uint64_t graph_mul(std::uint64_t a,std::uint64_t b) {
+    if (b && a>UINT64_MAX/b) throw std::length_error("graph feedback byte count overflows");return a*b;
+}
+}
+NativeLayerwiseGraphFeedbackStorage::NativeLayerwiseGraphFeedbackStorage(
+    ProgramImpl& p,const SequencePlanImpl& plan,std::span<const DeviceSpan> backing):p_(p) {
+    const auto& config=p.parameters.model.config().text;
+    if (!plan.use_cuda_graph || plan.kvmem.recall_strategy!=kvmem::RecallStrategy::Layerwise ||
+        !p.layerwise_feedback_account || !p.memory_statistics || backing.size()!=p.device.size())
+        throw std::logic_error("graph feedback requires its own admitted native Program");
+    const auto physical=widest_verify_window(plan)+1U;
+    if (!physical || physical>64 || !plan.max_concurrency)
+        throw std::logic_error("graph feedback has invalid full physical width");
+    std::uint64_t count=0;
+    for (const auto& rank:plan.persistent.memory_statistics) count=graph_add(count,rank.layers);
+    const auto meta=graph_add(graph_add(sizeof(*this)+64,graph_mul(graph_mul(2,count),sizeof(execution::LayerwiseGraphAttentionSlot))),
+        graph_mul(graph_mul(2,p.device.size()),sizeof(CudaCompletionEvent)));
+    // This reservation precedes any NativeLayerwiseRequest::reclaim_metadata().
+    metadata_=p.layerwise_feedback_account->reserve(meta);
+    slots_.reserve(static_cast<std::size_t>(count));
+    epoch_ready_.reserve(p.device.size());
+    if (epoch_ready_.capacity()>2*p.device.size()) throw std::length_error("graph epoch event directory exceeded admission");
+    for (std::size_t rank=0;rank<p.device.size();++rank) epoch_ready_.emplace_back(p.device.rank(rank));
+    if (slots_.capacity()>2*count) throw std::length_error("graph feedback descriptor capacity exceeded admission");
+    for (std::uint32_t model=0;model<config.layer_types.size();++model) {
+        if (config.layer_types[model]!=MixerKind::FullAttention) continue;
+        const auto ordinal=config.compact_layer_indices.at(model);
+        for (std::size_t rank=0;rank<p.device.size();++rank) {
+            const auto& l=plan.persistent.memory_statistics.at(rank);
+            if (!l.layers || ordinal<l.first_layer || ordinal>=l.first_layer+l.layers ||
+                (!p.parameters.text.tensor_parallel() && p.parameters.text.layers.at(model).rank!=rank)) continue;
+            const auto local=static_cast<std::int32_t>(ordinal-l.first_layer);
+            const auto& stats=p.memory_statistics->ranks.at(rank);
+            const auto heads=static_cast<std::uint32_t>(stats.query_values.ne[0]/config.attention->head_dim);
+            slots_.push_back({model,ordinal,rank,
+                static_cast<std::uint32_t>(stats.query_offset/config.attention->head_dim),heads,static_cast<std::uint32_t>(config.attention->num_attention_heads),
+                l.graph_queries.bind(backing[rank]).slice(2,local,1).view({static_cast<std::int32_t>(config.attention->head_dim),static_cast<std::int32_t>(heads),static_cast<std::int32_t>(physical*plan.max_concurrency)}),
+                l.graph_positions.bind(backing[rank]).slice(1,local,1).view({static_cast<std::int32_t>(physical*plan.max_concurrency)}),
+                l.graph_tables.bind(backing[rank]).slice(1,local,1).view({static_cast<std::int32_t>(plan.max_concurrency)}),
+                l.graph_epochs.bind(backing[rank]).slice(0,local,1),l.graph_ingress_epoch.bind(backing[rank])});
+        }
+    }
+    if (slots_.size()!=count) throw std::logic_error("graph feedback omitted native target/head slots");
+    view_={slots_,physical,plan.max_concurrency};view_.validate();
+    // Stable H2D epoch inputs and readback are charged to the ONE public staging limit.
+    const auto bytes=graph_mul(graph_add(p.device.size(),count),sizeof(std::uint64_t));
+    if (!bytes || bytes>=p.kvmem_options.layerwise.staging_bytes || bytes>SIZE_MAX)
+        throw std::length_error("graph feedback control staging exceeds explicit resources");
+    staging_=std::make_unique<PinnedHostBuffer>(static_cast<std::size_t>(bytes));
+    for (std::size_t rank=0;rank<p.device.size();++rank) {
+        const auto& l=plan.persistent.memory_statistics.at(rank);if (!l.layers) continue;
+        DeviceBinding binding(p.device.rank(rank).device);const auto stream=p.device.stream_for_rank(rank);
+        CUDA_CHECK(cudaMemsetAsync(l.graph_ingress_epoch.bind(backing[rank]).data,0,sizeof(std::uint64_t),stream));
+        CUDA_CHECK(cudaMemsetAsync(l.graph_epochs.bind(backing[rank]).data,0,l.graph_epochs.region.bytes,stream));
+    }
+}
+NativeLayerwiseGraphFeedbackStorage::~NativeLayerwiseGraphFeedbackStorage() {abort(frame_.epoch());}
+std::uint64_t NativeLayerwiseGraphFeedbackStorage::arm(const NativeGraphOutputIdentity& identity,
+    const DecodeGraphProfile& profile) {
+    identity.validate();const auto physical=identity.physical;
+    if (frame_.epoch() || physical>view_.max_physical_rows || identity.batch>view_.max_batch_size || p_.device.active_rank()!=0)
+        throw std::logic_error("graph feedback cannot arm a foreign or pending native round");
+    const auto belongs=[&](const DecodeGraphFamily& family) {
+        return std::any_of(family.profiles.begin(),family.profiles.end(),[&](const auto& p){return &p==&profile;});
+    };
+    const auto backend=p_.speculative_backend;
+    const bool family=backend==SpeculativeBackend::None?belongs(p_.ordinary_graphs):
+        backend==SpeculativeBackend::Mtp?(belongs(p_.mtp_graphs)||belongs(p_.ngram_graphs)):
+        backend==SpeculativeBackend::DFlash2?(belongs(p_.dflash_graphs)||belongs(p_.ngram_graphs)):false;
+    std::uint32_t maximum_local=0;
+    for (std::uint32_t row=0;row<identity.batch;++row) maximum_local=std::max(maximum_local,identity.rows[row].local);
+    // Native selects a compact cohort profile using its maximum actual row L.
+    // A shorter row is legal below the profile's minimum frontier.
+    if (!family || profile.batch_size!=identity.batch || maximum_local<profile.min_execution_frontier || maximum_local>profile.max_execution_frontier ||
+        (profile.verify_window && profile.verify_window+1U!=physical) ||
+        (backend==SpeculativeBackend::None && physical!=1) ||
+        (backend==SpeculativeBackend::Mtp && !profile.verify_window) ||
+        (backend==SpeculativeBackend::DFlash2 && !profile.verify_window && physical!=p_.draft_window+1U))
+        throw std::logic_error("native graph Output selected a foreign family/profile/physical width");
+    profile_=&profile;profile_min_=profile.min_execution_frontier;profile_max_=profile.max_execution_frontier;profile_class_=profile.topology_class;
+    const auto epoch=frame_.arm(identity);
+    auto* host=static_cast<std::uint64_t*>(staging_->data());
+    try {
+        // Each actual producer stream sees its ingress before the graph can execute
+        // work on that stream. Native PP/TP capture joins these same streams.
+        for (std::size_t rank=0;rank<p_.device.size();++rank) {
+            const auto found=std::find_if(slots_.begin(),slots_.end(),[&](const auto& s){return s.rank==rank;});
+            if (found==slots_.end()) continue;
+            DeviceBinding binding(p_.device.rank(rank).device);const auto stream=p_.device.stream_for_rank(rank);
+            execution::require_current_layer_query_eager(stream);host[rank]=epoch;
+            CUDA_CHECK(cudaMemcpyAsync(found->ingress_epoch.data,host+rank,sizeof(std::uint64_t),cudaMemcpyHostToDevice,stream));
+            epoch_ready_[rank].record(stream);
+        }
+        // A replay may schedule captured work on internal graph streams rather
+        // than the original secondary stream. Make ENTRY launch depend on all
+        // secondary epoch uploads, not merely on native per-stream FIFO order.
+        {
+            DeviceBinding binding(p_.device.rank(0).device);
+            for (std::size_t rank=1;rank<p_.device.size();++rank) {
+                const bool attention=std::any_of(slots_.begin(),slots_.end(),[&](const auto& s){return s.rank==rank;});
+                if (attention) epoch_ready_[rank].wait(p_.device.stream_for_rank(0));
+            }
+        }
+    } catch (...) {abort(epoch);throw;}
+    return epoch;
+}
+void NativeLayerwiseGraphFeedbackStorage::fence(std::uint64_t epoch,const NativeGraphOutputIdentity& identity) {
+    frame_.verify(epoch,identity);
+    if (!profile_ ||
+        profile_->min_execution_frontier!=profile_min_ || profile_->max_execution_frontier!=profile_max_ ||
+        profile_->topology_class!=profile_class_)
+        throw std::logic_error("graph feedback frame identity changed before collection");
+    p_.device.synchronize();
+    auto* epochs=static_cast<std::uint64_t*>(staging_->data())+p_.device.size();
+    for (std::size_t i=0;i<slots_.size();++i) {
+        const auto& slot=slots_[i];DeviceBinding binding(p_.device.rank(slot.rank).device);
+        CUDA_CHECK(cudaMemcpyAsync(epochs+i,slot.completed_epoch.data,sizeof(std::uint64_t),cudaMemcpyDeviceToHost,p_.device.stream_for_rank(slot.rank)));
+    }
+    p_.device.synchronize();
+    for (std::size_t i=0;i<slots_.size();++i) if (epochs[i]!=epoch)
+        throw std::logic_error("native graph omitted or reused a target/head capture epoch");
+    frame_.mark_fenced(epoch);
+}
+execution::LayerwiseGraphExecutionPermit NativeLayerwiseGraphFeedbackStorage::capture_permit(
+    std::uint32_t physical,std::uint32_t batch) const {
+    if (frame_.epoch() || !physical || physical>view_.max_physical_rows || !batch || batch>view_.max_batch_size)
+        throw std::logic_error("startup capture cannot borrow an active graph cohort");
+    return {&view_,physical,batch,0,false};
+}
+execution::LayerwiseGraphExecutionPermit NativeLayerwiseGraphFeedbackStorage::replay_permit(
+    std::uint64_t epoch,const NativeGraphOutputIdentity& identity) const {
+    frame_.verify(epoch,identity);
+    return {&view_,identity.physical,identity.batch,epoch,true};
+}
+void NativeLayerwiseGraphFeedbackStorage::release(std::uint64_t epoch) {
+    frame_.release(epoch);profile_=nullptr;
+}
+void NativeLayerwiseGraphFeedbackStorage::abort(std::uint64_t epoch) noexcept {
+    if (!epoch || frame_.epoch()!=epoch) return;
+    try {p_.device.synchronize();} catch (...) {}
+    frame_.discard_after_drain(epoch);profile_=nullptr;
+}
+} // namespace ninfer::models::qwen3_5::detail
