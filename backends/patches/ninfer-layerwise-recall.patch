+#include <limits>
+
+namespace ninfer::serve {
+std::optional<RequestedKvmemQueryPolicy> parse_layerwise_query_policy(const RequestJson& body) {
+    if (!body.contains("kvmem") || body.at("kvmem").is_null()) return {};
+    const auto& value=body.at("kvmem");
+    if (!value.is_object()) bad_request("kvmem must be an object","kvmem");
+    if (!value.contains("reselect") && !value.contains("query_begin") && !value.contains("query_end")) return {};
+    RequestedKvmemQueryPolicy policy;
+    if (value.contains("reselect")) {
+        if (!value.at("reselect").is_string()) bad_request("kvmem.reselect must be auto, force, or off","kvmem.reselect");
+        try {policy.reselect=parse_kvmem_reselect(value.at("reselect").get<std::string>());}
+        catch (const std::invalid_argument& error) {bad_request(error.what(),"kvmem.reselect");}
+    }
+    const auto coordinate=[&](const char* field) -> std::optional<std::uint64_t> {
+        if (!value.contains(field)) return {};
+        const auto& item=value.at(field);const auto name=std::string("kvmem.")+field;
+        if (!item.is_number_integer() || (!item.is_number_unsigned() && item.get<std::int64_t>()<0))
+            bad_request(name+" must be a nonnegative token position",name);
+        const auto result=item.get<std::uint64_t>();
+        if (result>std::numeric_limits<std::uint32_t>::max()) bad_request(name+" exceeds the native token domain",name);
+        return result;
+    };
+    policy.begin=coordinate("query_begin");policy.end=coordinate("query_end");
+    if (policy.end && !policy.begin) bad_request("kvmem.query_end requires query_begin","kvmem.query_end");
+    if (policy.reselect==KvmemReselect::Off && (policy.begin || policy.end))
+        bad_request("kvmem.reselect=off forbids an explicit Query span","kvmem.reselect");
+    return policy;
+}
+
+void apply_layerwise_query_policy(PreparedPrompt& prompt,const RequestedKvmemQueryPolicy& requested) {
+    KvmemRequestPolicy policy;policy.reselect=requested.reselect;
+    if (requested.begin) policy.query=KvmemQuerySpan{*requested.begin,requested.end.value_or(prompt.summary().prompt_tokens)};
+    try {prompt.set_layerwise_request_policy(policy);}
+    catch (const std::invalid_argument& error) {
+        bad_request(error.what(),requested.begin?"kvmem.query_begin":"kvmem.reselect");
+    }
+}
+} // namespace ninfer::serve
