+        throw std::logic_error("Query residual partial is outside its native tensor share");
+    require_tensor_shape(*residual_partial_,DType::FP32,
+        {dimension(config_.hidden_size),residual.ne[1]},"Query tensor residual partial");
+    require_stable_query_tensor(*residual_partial_,"Query tensor residual partial");
