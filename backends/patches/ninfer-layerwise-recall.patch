+void TextContext::consume_query_attention(PreparedLayerQuery& prepared, const Tensor& kv_table_row,
+    ops::CausalAttentionExecutionEnvelope envelope) {
+    if (prepared.state_ != PreparedLayerQuery::State::Projected || prepared.stream_ != ctx_.stream ||
+        active_sequence_batch_ != 0 || !active_segments_.empty() || attention_partial_ != nullptr)
+        throw std::logic_error("prepared Query attention requires one projected bundle on its producer stream");
+    require_current_layer_query_eager(ctx_.stream);
+    const auto& w = query_attention_parameters(prepared.identity_);
+    const auto& config = layer_config();
+    auto& storage = prepared.storage_;
+    const auto T = storage.residual.ne[1];
+    validate_query_storage(storage, config, T, storage.rope_positions.ne[1], work_);
+    require_tensor_shape(kv_table_row, DType::I32, {1}, "prepared Query table row");
+    validate_query_source(kv_table_row, kv_table_row, storage);
+    if (query_storage_overlaps(kv_table_row.data, kv_table_row.bytes(), work_.base(), work_.capacity()))
+        throw std::invalid_argument("prepared Query table row needs storage outside execution workspace");
+    validate_query_partial(storage);
+    prepared.state_ = PreparedLayerQuery::State::Consuming;
