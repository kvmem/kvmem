+NativeLayerwiseProgramQuery::NativeLayerwiseProgramQuery(ProgramImpl& p,SequenceState& s,RequestControl& r,
+    execution::PrefillContext& context,std::uint64_t id,std::shared_ptr<KvmemPrefixCheckpoint> source,
+    NativeLayerwiseQueryResources resources)
+    :impl_(std::make_unique<Impl>(p,s,r,context,id,std::move(source),std::move(resources))) {}
+NativeLayerwiseProgramQuery::~NativeLayerwiseProgramQuery() {
+    if (!impl_) return;abort();
+    auto& program=impl_->program;const auto lease=impl_->work_identity;
+    // Destroy every sealed source/staging account BEFORE a waiter may acquire
+    // the same complete Query resources or startup-owned device slab.
+    impl_.reset();
+    if (program.layerwise_query_work.owns(lease)) program.layerwise_query_work.release(lease);
+}
+bool NativeLayerwiseProgramQuery::complete() const noexcept { return impl_->runner->complete(); }
+kvmem::LayerwiseQueryWork NativeLayerwiseProgramQuery::work() const noexcept { return impl_->transaction->work(); }
+std::uint64_t NativeLayerwiseProgramQuery::scored_rows() const noexcept {return impl_->scored_rows;}
+NativeLayerwiseProbeWork NativeLayerwiseProgramQuery::probe_work() const noexcept {return impl_->probe_work;}
+NativeQueryRunnerStep NativeLayerwiseProgramQuery::advance(execution::PrefillContext& context) {
+    auto& p=*impl_;p.validate_owner(context);
+    if (p.accepted || p.invalid) throw std::logic_error("native Program Query is already closed");
+    p.active_context=&context;
+    try { const auto result=p.runner->advance(context,p.input->token_ids);p.active_context=nullptr;return result; }
+    catch (...) { p.active_context=nullptr;p.abort();throw; }
+}
+void NativeLayerwiseProgramQuery::accept() {
+    auto& q=*impl_;auto& p=q.program;auto& s=q.sequence;auto& window=s.window;
+    if (q.accepted || q.invalid || !q.runner->complete() || !window.layerwise_rewrite_pending ||
+        q.transaction->phase()!=kvmem::LayerwiseRequestPhase::AwaitingAcceptance ||
+        (p.backend_kv_pages && (!q.auxiliary_restored || !q.auxiliary_boundary_ready)) ||
+        (q.dflash_features && !q.dflash_features->complete()))
+        throw std::logic_error("native Program Query cannot publish incomplete target/GDN/auxiliary work");
+    try {
+        p.device.synchronize();
+        auto maps=q.pending_maps;const auto begin=static_cast<std::uint32_t>(q.identity.evaluation.begin);
+        const auto end=static_cast<std::uint32_t>(q.identity.evaluation.end);
+        maps.accepted_target_append(begin,end);if (maps.has_auxiliary) maps.accepted_auxiliary_append(begin,end);
+        maps.validate(end);
+        // Prepare metadata privately before exposing native accepted coverage.
+        auto stamp=window.stamp;stamp.frontier=end;++stamp.history_revision;++stamp.view_version;
+        auto graph=kvmem::prepare_graph_accept(window.graph,window.graph.accepted_through,end,{},32u<<20);
+        std::vector<kvmem::LayerMemorySnapshot> accepted;
+        for (const auto& layer:maps.target) {
+            kvmem::MemorySnapshot snapshot;snapshot.stamp=stamp;snapshot.stamp.view_version=layer.view_version;
+            for (std::uint32_t id=0;id<kv_pages_for_tokens(end);++id) {
+                const auto count=valid_columns(id,end);
+                snapshot.blocks.push_back({{stamp.session,id,std::uint64_t(id)*64,count,count,0},id<q.archive.canonical.blocks.size()?count:0});
+            }
+            snapshot.resident.assign(layer.pages.begin(),layer.pages.end());accepted.push_back({layer.model_layer,std::move(snapshot)});
+        }
+        q.policy->register_append(q.rows);
+        p.copy_tail(s,q.runner->tail_hidden());p.device.synchronize();
+        p.text_kv_addresses->commit_frontier(s.kv->text,q.history_tokens+q.rows);
+        p.text_kv_addresses->destructive_truncate(s.kv->text,q.history_tokens+q.rows);
+        if (p.backend_kv_pages) {
+            p.backend_kv_addresses->commit_frontier(*s.kv->backend,q.auxiliary_tokens+q.rows);
+            // The native draft IDs already live in round storage. Release AR
+            // scratch before the accepted Query can be checkpointed or forked.
+            p.backend_kv_addresses->destructive_truncate(*s.kv->backend,q.auxiliary_tokens+q.rows);
