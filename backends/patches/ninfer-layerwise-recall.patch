+std::uint64_t checked_product(std::uint64_t a,std::uint64_t b) {
+    if (b && a>UINT64_MAX/b) throw std::length_error("native layerwise feedback byte count overflows");return a*b;
+}
+std::uint64_t checked_sum(std::uint64_t a,std::uint64_t b) {
+    if (b>UINT64_MAX-a) throw std::length_error("native layerwise feedback byte sum overflows");return a+b;
