+            if (progress.next_rank>=shards.size() || shards[progress.next_rank].rank!=frame.identity.rank)
+                throw std::logic_error("native tensor feedback repeated, omitted or reordered a head shard");
+            head=&shards[progress.next_rank];tile=&progress;
+            const auto& actual=p.memory_statistics->ranks.at(frame.identity.rank);
+            if (head->model!=frame.identity.model_layer || head->ordinal!=frame.identity.attention_layer ||
+                actual.query_offset!=head->first*256 || actual.query_values.ne[0]!=head->count*256 ||
+                frame.identity.attention_layer<actual.first_layer ||
+                std::uint64_t(frame.identity.attention_layer)>=std::uint64_t(actual.first_layer)+actual.key_sums.ne[2])
