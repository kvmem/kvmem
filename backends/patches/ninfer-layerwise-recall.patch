diff --git a/src/models/qwen3_5/program/storage/layerwise_admission.h b/src/models/qwen3_5/program/storage/layerwise_admission.h
new file mode 100644
index 0000000000000000000000000000000000000000..b5099852324a70092ce8ee4b482e110a30f9a1fd
--- /dev/null
+++ b/src/models/qwen3_5/program/storage/layerwise_admission.h
@@ -0,0 +1,161 @@
+#pragma once
+
+#include "models/qwen3_5/program/storage/checkpoint_buffer_pool.h"
+#include <cstdio>
+#include <cstdint>
+#include <memory>
+#include <stdexcept>
+#include <vector>
+
+namespace ninfer::models::qwen3_5::detail {
+
+// Allocation phases, not semantic checkpoint-purpose aliases. Several existing
+// purposes may share one CP; the native pool charges the real image only once.
+enum class NativeLayerwiseCheckpointRole : std::uint8_t {
+    General,
+    QueryBoundary,
+    ProbeResident,
+    PrefillBoundary,
+    Endpoint,
+};
+
+struct NativeLayerwiseCheckpointCredit {
+    NativeLayerwiseCheckpointRole role=NativeLayerwiseCheckpointRole::General;
+    std::uint32_t frontier=0;
+    std::uint64_t image_bytes=0,index_bound=0,checkpoint_bound=0,feedback_bound=0;
+    std::shared_ptr<PinnedHostBuffer> image;
+    std::shared_ptr<KvmemCheckpointBufferPool> pool;
+    NativeSourceVersionCharge metadata;
+    bool consumed=false,published=false;
+    NativeLayerwiseCheckpointCredit()=default;
+    NativeLayerwiseCheckpointCredit(const NativeLayerwiseCheckpointCredit&)=delete;
+    NativeLayerwiseCheckpointCredit& operator=(const NativeLayerwiseCheckpointCredit&)=delete;
+    NativeLayerwiseCheckpointCredit(NativeLayerwiseCheckpointCredit&&) noexcept=default;
+    NativeLayerwiseCheckpointCredit& operator=(NativeLayerwiseCheckpointCredit&&) noexcept=default;
+    ~NativeLayerwiseCheckpointCredit() noexcept {
+        // A taken credit can still fail before a checkpoint owns its image.
+        // Its local CP is declared later and releases first during unwinding.
+        if (!published && pool) {
+            image.reset();
+            try {pool->trim();} catch (...) {}
+        }
+    }
+};
+
+// One finite Program-owned Waiting reservation. The history preparation and
+// active NativeRequest share this owner, so publication cannot release a
+// promise before the later aligned native capture actually consumes it.
+// No Tensor, arena allocation or borrowed CPU ingress array escapes here.
+struct NativeLayerwiseAdmission {
+    const void* input_owner=nullptr;
+    std::uint32_t prompt_end=0,source_frontier=0,query_begin=0,query_end=0;
+    std::uint64_t source_epoch=0;
+    std::shared_ptr<const NativeCanonicalHistoryVersion> source;
+    std::shared_ptr<KvmemCheckpointBufferPool> pool;
+    NativeSourceVersionCharge control_metadata;
+    // Filled by the separate fresh-history planner; transferred once into the
+    // new window's existing statistics_metadata field, never reserved twice.
+    NativeSourceVersionCharge fresh_statistics_metadata;
+    std::uint64_t fresh_statistics_bound=0;
+    // Graph/cohort adapter supplies all actual feedback funding in Waiting.
+    std::shared_ptr<NativeSourceVersionAccount> feedback_runtime_account;
+    NativeSourceVersionCharge retained_feedback_credit,query_feedback_growth;
+    std::uint64_t feedback_workspace_bytes=0,feedback_query_extra_bytes=0,feedback_snapshot_bytes=0,query_feedback_required=0;
+    std::vector<NativeLayerwiseCheckpointCredit> checkpoints;
+    bool verify=false,bound=false;
+
+    const std::shared_ptr<NativeSourceVersionAccount>& account() const noexcept {
+        return control_metadata.account();
+    }
+    bool has(NativeLayerwiseCheckpointRole role,std::uint32_t frontier) const noexcept {
+        for (const auto& credit:checkpoints)
+            if (!credit.consumed && credit.role==role && credit.frontier==frontier) return true;
+        return false;
+    }
+    NativeLayerwiseCheckpointCredit take(NativeLayerwiseCheckpointRole role,
+        std::uint32_t frontier,std::uint64_t image_bytes) {
+        for (auto& credit:checkpoints) {
+            if (credit.consumed || credit.role!=role || credit.frontier!=frontier) continue;
+            if (!bound || !account() || !pool || !credit.image || credit.image_bytes!=image_bytes ||
+                credit.image->size()!=image_bytes || credit.metadata.account()!=account() ||
+                credit.metadata.bytes()!=credit.index_bound+credit.checkpoint_bound+credit.feedback_bound)
+                throw std::logic_error("native checkpoint differs from its exact Waiting image/metadata credit");
+            NativeLayerwiseCheckpointCredit result;
+            result.role=credit.role;result.frontier=credit.frontier;result.image_bytes=credit.image_bytes;
+            result.index_bound=credit.index_bound;result.checkpoint_bound=credit.checkpoint_bound;result.feedback_bound=credit.feedback_bound;
+            result.image=std::move(credit.image);result.pool=std::move(credit.pool);
+            result.metadata=std::move(credit.metadata);
+            credit.consumed=true;
+            if (verify) std::fprintf(stderr,
+                "KVMEM_LAYERWISE_ADMISSION action=consume role=%u frontier=%u image_bytes=%llu metadata_bytes=%llu source_used=%llu pool_allocated=%zu pool_idle=%zu\n",
+                unsigned(role),frontier,(unsigned long long)image_bytes,
+                (unsigned long long)result.metadata.bytes(),(unsigned long long)account()->charged_bytes(),
+                pool->allocated_bytes(),pool->idle_bytes());
+            return result;
+        }
+        throw std::logic_error("native checkpoint has no matching Waiting phase credit");
+    }
+    void finish_input() {
+        // A real saved nearby CP or an optional input representative can
+        // suppress an ordinary PromptTail after admission. Its unused actual
+        // image is returned at this Input fence, not held through generation.
+        bool skipped_ordinary=false;
+        for (auto& credit:checkpoints) if (!credit.consumed) {
+            if (credit.role!=NativeLayerwiseCheckpointRole::PrefillBoundary)
+                throw std::logic_error("native input missed a required Query checkpoint phase credit");
+            credit.image.reset();credit.metadata={};credit.pool.reset();credit.consumed=true;
+            skipped_ordinary=true;
+        }
+        if (skipped_ordinary && pool) pool->trim();
+        if (skipped_ordinary && verify) std::fprintf(stderr,
+            "KVMEM_LAYERWISE_ADMISSION action=input_release skipped_ordinary=1 pool_allocated=%zu pool_idle=%zu source_used=%llu\n",
+            pool?pool->allocated_bytes():0,pool?pool->idle_bytes():0,
+            (unsigned long long)(account()?account()->charged_bytes():0));
+        if (fresh_statistics_metadata.account())
+            throw std::logic_error("native input did not consume its fresh statistics admission");
+        if (feedback_runtime_account || retained_feedback_credit.account() || query_feedback_growth.bytes())
+            throw std::logic_error("native input did not consume its complete feedback admission");
+        input_owner=nullptr;
+    }
+    void publish_feedback_pool(NativeSourceVersionCharge& program_pool) {
+        if (!bound || !query_feedback_required || !query_feedback_growth.account())
+            throw std::logic_error("native publication has no admitted shared Query feedback funding");
+        const auto current=program_pool.bytes();
+        if (program_pool.account() && program_pool.account()!=query_feedback_growth.account())
+            throw std::logic_error("native Query feedback publication changed Program accounts");
+        const auto missing=query_feedback_required>current?query_feedback_required-current:0;
+        if (missing>query_feedback_growth.bytes())
+            throw std::logic_error("native Query feedback publication exceeded its Waiting delta");
+        if (missing) {
+            auto delta=query_feedback_growth.split(missing);
+            if (program_pool.account()) program_pool.absorb_same_account(std::move(delta));
+            else program_pool=std::move(delta);
+        }
+        query_feedback_growth={};
+    }
+    ~NativeLayerwiseAdmission() noexcept {
+        // Releasing an unused lease can return its image to the reusable pool.
+        // Trim those idle allocations explicitly; cancellation must not leave
+        // an apparently free pool consuming this Program's hard source quota.
+        const auto account_owner=account();
+        const auto allocated=pool?pool->allocated_bytes():0;
+        const auto idle=pool?pool->idle_bytes():0;
+        const auto used=account_owner?account_owner->charged_bytes():0;
+        bool unused=false;
+        for (const auto& credit:checkpoints) unused=unused || (!credit.consumed && bool(credit.image));
+        checkpoints.clear();
+        // Successful consumption preserves the ordinary reusable pool. Only
+        // unused reservations from a cancelled/refused input force idle trim.
+        // A later Waiting quota refusal may separately reclaim idle cache and
+        // retry; active checkpoint leases are never part of that reclaim.
+        try {if (unused && pool) pool->trim();} catch (...) {}
+        source.reset();fresh_statistics_metadata={};retained_feedback_credit={};
+        feedback_runtime_account.reset();query_feedback_growth={};control_metadata={};
+        if (verify) std::fprintf(stderr,
+            "KVMEM_LAYERWISE_ADMISSION action=release unused_reservations=%u pool_allocated_before=%zu pool_idle_before=%zu source_used_before=%llu pool_allocated_after=%zu pool_idle_after=%zu source_used_after=%llu\n",
+            unsigned(unused),allocated,idle,(unsigned long long)used,pool?pool->allocated_bytes():0,
+            pool?pool->idle_bytes():0,(unsigned long long)(account_owner?account_owner->charged_bytes():0));
+    }
+};
+
+} // namespace ninfer::models::qwen3_5::detail
diff --git a/src/models/qwen3_5/program/storage/layerwise_admission_plan.h b/src/models/qwen3_5/program/storage/layerwise_admission_plan.h
new file mode 100644
index 0000000000000000000000000000000000000000..b8bab89180bf648b238832a4b1435a996c794f54
--- /dev/null
+++ b/src/models/qwen3_5/program/storage/layerwise_admission_plan.h
@@ -0,0 +1,73 @@
+#pragma once
+
+#include "models/qwen3_5/program/storage/layerwise_admission.h"
+#include "kvmem/layerwise_import.hpp"
+#include <algorithm>
+#include <array>
+#include <limits>
+
+namespace ninfer::models::qwen3_5::detail {
+
+struct NativeCheckpointPhase {
+    NativeLayerwiseCheckpointRole role=NativeLayerwiseCheckpointRole::General;
+    std::uint32_t frontier=0;
+    bool new_canonical_index=false;
+};
+struct NativeQueryAdmissionPlan {
+    kvmem::LayerwiseWindowState source,after_import,at_query;
+    std::array<NativeCheckpointPhase,2> checkpoints{};
+    std::uint32_t checkpoint_count=0;
+    std::uint64_t old_tail_rows=0,ordinary_credits=0,resident_pressure_actions=0;
+    bool has_query=false,refresh=false,probe_pressure=false;
+};
+
+// This predicts only the H/L allocation schedule. It calls the SAME immutable
+// action/admit/import policy as the native owner, never scores Q, picks page
+// IDs, reads KV, or publishes speculative statistics/accepted state.
+inline NativeQueryAdmissionPlan plan_native_query_admission(
+    const kvmem::LayerwiseWindowPlan& window,kvmem::LayerwiseWindowState source,
+    std::uint32_t native_prefill_hint,bool upstream_global) {
+    NativeQueryAdmissionPlan result;result.source=source;result.after_import=source;result.at_query=source;
+    const auto evaluation=window.query_evaluation();
+    if (!evaluation) return result;
+    if (!native_prefill_hint || source.history>evaluation->begin ||
+        evaluation->begin>std::numeric_limits<std::uint32_t>::max())
+        throw std::logic_error("native Waiting Query plan lacks its exact source/evaluation extent");
+    result.has_query=true;
+    auto state=source;
+    const auto imported=kvmem::plan_layerwise_import(window,state);
+    if (imported.pressure()) {state.visible_tokens=imported.restore_tokens;++result.resident_pressure_actions;}
+    result.after_import=state;
+    const auto initial=state.history;
+    while (state.history<evaluation->begin) {
+        const auto action=window.action(state);
+        if (action==kvmem::LayerwiseWindowAction::Pressure) {
+            state.visible_tokens=window.selection_budget(state.history);
+            ++result.resident_pressure_actions;
+        } else if (action!=kvmem::LayerwiseWindowAction::None) {
+            throw std::logic_error("native Waiting Query reconstruction differs from literal action policy");
+        }
+        const auto desired=std::min<std::uint64_t>(native_prefill_hint,evaluation->begin-state.history);
+        const auto count=window.admit(state,desired);
+        if (!count || count>desired || state.visible_tokens>window.capacity()-count)
+            throw std::logic_error("native Waiting Query reconstruction has no exact complete tile credit");
+        state.history+=count;state.visible_tokens+=count;++result.ordinary_credits;
+    }
+    if (window.action(state)!=kvmem::LayerwiseWindowAction::Query)
+        throw std::logic_error("native Waiting Query reconstruction missed its exact aligned boundary");
+    result.old_tail_rows=state.history-initial;result.at_query=state;
+    result.refresh=state.history>=window.selection_budget(state.history);
+    if (initial<state.history && state.history) {
+        result.checkpoints[result.checkpoint_count++]={NativeLayerwiseCheckpointRole::QueryBoundary,
+            static_cast<std::uint32_t>(state.history),true};
+    }
+    const auto rows=evaluation->end-evaluation->begin;
+    if (upstream_global && result.refresh && state.visible_tokens+rows>window.capacity()-64) {
+        result.probe_pressure=true;
+        result.checkpoints[result.checkpoint_count++]={NativeLayerwiseCheckpointRole::ProbeResident,
+            static_cast<std::uint32_t>(state.history),false};
+    }
+    return result;
+}
+
+} // namespace ninfer::models::qwen3_5::detail
