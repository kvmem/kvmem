+                auto scratch=shard.attention_scratch.slice(2,0,n),norms=shard.attention_norms.slice(2,0,n),mass=shard.attention_output.slice(1,0,n);
+                const auto bytes=mass.bytes();if (bytes>p.memory_statistics_host->size()) throw std::length_error("native feedback readback exceeds pinned account");
