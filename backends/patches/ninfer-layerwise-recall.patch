+            throw std::logic_error("native MTP boundary lost its exact prefix hidden/own canonical record");
+        auto& pool=p.backend_kv_pages->physical_pool();
+        const auto layout=plan_host_kv_page_layout(pool.geometry());
+        const auto offset=plan_host_kv_page_layout(p.text_kv_pages->physical_pool().geometry()).page_stride;
+        const auto scratch_slot=auxiliary_tokens/64;
+        KVLayerStripeWrite::require_unpublished_destination(*p.backend_kv_addresses,*sequence.kv->backend,pool,scratch_slot+1);
+        const std::array scratch{p.backend_kv_addresses->physical_page(*sequence.kv->backend,scratch_slot)};
+        const std::array inputs{static_cast<const std::byte*>(p.memory_kv_staging->data())};
+        const std::array outputs{static_cast<std::byte*>(p.memory_kv_staging->data())};
+        // The scratch page is the unpublished first Query page, so no extra
+        // physical capacity or selected-history row is introduced. Later real
