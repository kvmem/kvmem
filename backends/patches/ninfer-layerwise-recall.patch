+bool same_options(const kvmem::LayerwiseOutputOptions& a,const kvmem::LayerwiseOutputOptions& b) {
+    return a.scope==b.scope && a.interval==b.interval && a.decay==b.decay && a.commit_max_bytes==b.commit_max_bytes;
