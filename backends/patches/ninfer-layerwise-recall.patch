diff --git a/src/models/qwen3_5/program/native_output_cohort.cpp b/src/models/qwen3_5/program/native_output_cohort.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..888756f3870db11ae7da7d060ec7aa5ef2e9e793
--- /dev/null
+++ b/src/models/qwen3_5/program/native_output_cohort.cpp
@@ -0,0 +1,140 @@
+#include "models/qwen3_5/program/native_output_cohort.h"
+#include "models/qwen3_5/program/program_impl.h"
+#include "models/qwen3_5/program/native_graph_feedback.h"
+#include <algorithm>
+#include <stdexcept>
+
+namespace ninfer::models::qwen3_5::detail {
+NativeLayerwiseDecodePreparation::NativeLayerwiseDecodePreparation(ProgramImpl& p,
+    std::span<const std::uint32_t> lanes):p_(p) {
+    if (p.kvmem_options.recall_strategy!=kvmem::RecallStrategy::Layerwise) return;
+    if (lanes.empty() || lanes.size()>saved_.size()) throw std::logic_error("decode preparation has invalid membership");
+    bool any=false,all=true;
+    for (auto lane:lanes) {
+        if (lane>=p.max_concurrency || std::any_of(saved_.begin(),saved_.begin()+size_,[&](const auto& r){return r.lane==lane;}))
+            throw std::logic_error("decode preparation has a foreign/duplicate lane");
+        auto* owner=p.active_sequence(lane).window.layerwise_request.get();any=any||owner;all=all&&owner;
+        const auto& request=p.requests[lane];
+        saved_[size_++]={lane,p.lane_epochs.at(lane),request.ngram_copy_source,
+            request.ngram_copy_offset,request.ngram_copy_ledger,owner};
+    }
+    if (any && !all) throw std::logic_error("one Native cohort cannot mix layerwise and legacy owners");
+    enabled_=all;
+}
+bool NativeLayerwiseDecodePreparation::withdraw_if_unsubmitted() {
+    if (!enabled_ || submitted_) return false;
+    if (withdrawn_) return true;
+    // Address-table/control uploads may already have been queued; no model
+    // kernel has been submitted, but their sources must not retire unfenced.
+    p_.device.synchronize();
+    for (std::uint32_t row=0;row<size_;++row) {
+        const auto& saved=saved_[row];
+        if (p_.lane_epochs.at(saved.lane)!=saved.epoch ||
+            p_.active_sequence(saved.lane).window.layerwise_request.get()!=saved.owner)
+            throw std::logic_error("unsubmitted cohort retained a recycled owner");
+        saved.owner->withdraw_output_before_submit();
+        auto& request=p_.requests[saved.lane];request.ngram_copy_source=saved.source;
+        request.ngram_copy_offset=saved.offset;request.ngram_copy_ledger=saved.ledger;
+    }
+    withdrawn_=true;return true;
+}
+NativeLayerwiseDecodePreparation::~NativeLayerwiseDecodePreparation() {
+    if (!enabled_ || submitted_ || withdrawn_) return;
+    try {(void)withdraw_if_unsubmitted();}
+    catch (...) {
+        std::array<std::uint32_t,kMaximumConcurrency> lanes{};
+        for (std::uint32_t i=0;i<size_;++i) lanes[i]=saved_[i].lane;
+        p_.clear_execution_failure_lanes(std::span<const std::uint32_t>(lanes.data(),size_));
+    }
+}
+NativeLayerwiseOutputCohort::NativeLayerwiseOutputCohort(ProgramImpl& p,
+    std::span<const std::uint32_t> lanes,std::uint32_t physical):p_(p),width_(physical) {
+    if (lanes.empty() || lanes.size()>rows_.size() || !physical || physical>64)
+        throw std::logic_error("Output cohort has invalid native physical dimensions");
+    for (auto lane:lanes) {
+        if (lane>=p.max_concurrency || std::any_of(rows_.begin(),rows_.begin()+size_,[&](const auto& r){return r.lane==lane;}))
+            throw std::logic_error("Output cohort contains a foreign or duplicate lane");
+        auto* owner=p.active_sequence(lane).window.layerwise_request.get();
+        if (!owner) throw std::logic_error("layerwise Output cohort contains a legacy row");
+        rows_[size_++]=owner->output_row();
+    }
+    observer_.owner=this;observer_.physical_rows=physical;observer_.batch_size=size_;
+    observer_.attended=[](void* owner,const execution::CurrentLayerAttentionFrame& frame) {
+        static_cast<NativeLayerwiseOutputCohort*>(owner)->attended(frame);
+    };
+}
+NativeLayerwiseOutputCohort::~NativeLayerwiseOutputCohort() {
+    if (!graph_epoch_) return;
+    // One failure invalidates this submitted native unit, never an accepted
+    // peer prefix. Drain the whole graph before any owner/source is released.
+    graph_storage_->abort(graph_epoch_);
+    for (std::uint32_t row=0;row<size_;++row) {
+        const auto& r=rows_[row];
+        if (p_.lane_epochs.at(r.lane)==r.lane_epoch &&
+            p_.active_sequence(r.lane).window.layerwise_request.get()==r.owner)
+            r.owner->abort_graph_output(graph_epoch_);
+    }
+}
+void NativeLayerwiseOutputCohort::arm_graph(const DecodeGraphProfile& profile) {
+    if (graph_epoch_ || !p_.layerwise_graph_feedback)
+        throw std::logic_error("graph cohort has no exclusive stable Program storage");
+    graph_identity_.physical=width_;graph_identity_.batch=size_;
+    for (std::uint32_t row=0;row<size_;++row) {
+        const auto& r=rows_[row];
+        if (p_.lane_epochs.at(r.lane)!=r.lane_epoch ||
+            p_.active_sequence(r.lane).window.layerwise_request.get()!=r.owner ||
+            !native_output_binding_matches(r,r.owner->output_row()))
+            throw std::logic_error("graph cohort changed before native submission");
+        graph_identity_.rows[row]={r.request_id,r.lane_epoch,r.source,r.lane,r.logical_begin,
+            r.local_begin,r.valid_rows,r.table_row};
+    }
+    graph_storage_=p_.layerwise_graph_feedback.get();
+    graph_epoch_=graph_storage_->arm(graph_identity_,profile);
+    for (std::uint32_t row=0;row<size_;++row)
+        rows_[row].owner->prepare_graph_output(graph_epoch_,width_);
+}
+execution::LayerwiseGraphExecutionPermit NativeLayerwiseOutputCohort::graph_permit() const {
+    if (!graph_storage_ || !graph_epoch_) throw std::logic_error("graph copy cohort is not armed");
+    return graph_storage_->replay_permit(graph_epoch_,graph_identity_);
+}
+void NativeLayerwiseOutputCohort::collect_graph() {
+    if (!graph_storage_ || !graph_epoch_) throw std::logic_error("graph cohort has no pending current epoch");
+    graph_storage_->fence(graph_epoch_,graph_identity_);
+    // All K/scales and mappings are still the same as at each captured native
+    // attention. Populate every row's PRIVATE matrix before Native Rawresolve.
+    const auto count=width_*size_;
+    for (const auto& slot:graph_storage_->view().slots) {
+        const auto query=slot.query.slice(2,0,static_cast<std::int32_t>(count));
+        const auto positions=slot.positions.slice(0,0,static_cast<std::int32_t>(count));
+        const auto tables=slot.table_rows.slice(0,0,static_cast<std::int32_t>(size_));
+        attended({{slot.model_layer,slot.attention_layer,slot.rank},query,positions,tables,
+            p_.device.stream_for_rank(slot.rank)});
+    }
+    // Complete all checks before clearing any borrowed pending owner tag.
+    for (std::uint32_t row=0;row<size_;++row)
+        rows_[row].owner->validate_graph_output_complete(graph_epoch_);
+    for (std::uint32_t row=0;row<size_;++row)
+        rows_[row].owner->complete_graph_output(graph_epoch_);
+    graph_storage_->release(graph_epoch_);graph_epoch_=0;graph_storage_=nullptr;
+}
+void NativeLayerwiseOutputCohort::attended(const execution::CurrentLayerAttentionFrame& frame) {
+    const auto count=std::uint64_t(width_)*size_;
+    if (frame.query.ne[2]!=count || frame.query.ne[3]!=1 || !frame.query.is_contiguous() ||
+        frame.cache_positions.numel()!=count || !frame.cache_positions.is_contiguous() ||
+        frame.table_rows.numel()!=size_ || !frame.table_rows.is_contiguous())
+        throw std::logic_error("target Q/control does not match its actual cohort row packing");
+    const auto positions=frame.cache_positions.view({static_cast<std::int32_t>(count)});
+    const auto tables=frame.table_rows.view({static_cast<std::int32_t>(size_)});
+    for (std::uint32_t row=0;row<size_;++row) {
+        const auto& binding=rows_[row];
+        if (p_.lane_epochs.at(binding.lane)!=binding.lane_epoch ||
+            p_.active_sequence(binding.lane).window.layerwise_request.get()!=binding.owner)
+            throw std::logic_error("target Output cohort retained a recycled lane");
+        const auto range=native_output_row_range(width_,size_,row);
+        const auto query=frame.query.slice(2,static_cast<std::int32_t>(range.begin),static_cast<std::int32_t>(range.count));
+        const auto pos=positions.slice(0,static_cast<std::int32_t>(range.begin),static_cast<std::int32_t>(range.count));
+        const auto table=tables.slice(0,static_cast<std::int32_t>(row),1);
+        binding.owner->observe_output_row(binding,{frame.identity,query,pos,table,frame.producer_stream});
+    }
+}
+} // namespace ninfer::models::qwen3_5::detail
