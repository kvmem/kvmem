+        reclaim_metadata();
+        Capture next;next.begin=begin;next.count=count;next.local_begin=local;next.query=query;
+        next.output=output_tokens!=nullptr || deferred_output;next.deferred_output=deferred_output;
+        const auto accepted_bytes=sequence.window.layer_views.feedback?sequence.window.layer_views.feedback->allocated_bytes():sizeof(NativeLayerwiseFeedbackSnapshot)+64;
+        if (accepted_bytes>runtime_metadata.bytes()/4)
+            throw std::length_error("native retained feedback leaves no admitted private reducer space");
+        auto prepared_output=output_tokens?std::make_unique<kvmem::LayerwiseOutputPressure>(*output):nullptr;
+        // A fresh Query is the first public prefill, irrespective of causal
+        // projection/consumption chunking. Only actual replay is excluded.
+        if (output_tokens) {
+            const auto mask=prepared_output->prepare(request_id,begin,*output_tokens);
