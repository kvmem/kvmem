+        CUDA_CHECK(cudaMemcpyAsync(positions.data,cache_host.data(),4,cudaMemcpyHostToDevice,p.device.stream));
+        CUDA_CHECK(cudaMemcpyAsync(rope.data,rope_host.data(),4*rope_axes,cudaMemcpyHostToDevice,p.device.stream));
+        execution::TextContext card(p.device,p.parameters,p.work,context.text_kv,context.execution.linear_attention,
+            p.io,p.prefill_hidden,p.prefill_chunk,begin,context.mtp_kv,&context.text_cache,context.mtp_cache);
+        card.set_expert_runtime(p.experts.get());card.set_rope_yarn(p.rope_yarn);card.set_mtp_attention_window(p.mtp_attention_window);
+        execution::configure_text_card(card,context.execution,nullptr,context.state_source_slot,context.state_destination_slot,0);
+        card.set_stage_runtime(context.execution.stages);
+        Tensor composed;const Tensor* embedding=nullptr;
