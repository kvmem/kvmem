+struct NativeLayerwiseQueryResources {
+    // Full ordinary-request provenance; prompt_end is never the current tile.
+    // query is the trusted frontend user span. replay, when present, names the
+    // aligned-source evaluation suffix (including framing), not a second Q run.
+    kvmem::LayerwiseRequestEnvelope envelope;
+    NativeQueryActivationLimits activation;
+    // Frozen Mean-K copy and native transfer staging are separate from the
+    // canonical full-record KV account and from the projection/residual tapes.
+    std::uint64_t frozen_index_host_bytes=0;
+    std::uint64_t transfer_staging_host_bytes=0;
+    // Persistent immutable CP index/descriptor versions use one shared finite
+    // account across native history forks; canonical KV bytes remain in H/D.
+    std::uint64_t source_versions_host_bytes=64u<<20;
+    // Independent literal layerwise policy, not legacy retrieval configuration.
+    std::uint32_t selected_tokens=0,sink_blocks=0,recent_blocks=0;
+    float attention_scale=0;
+    bool borrow_program_buffers=false;
+    // Independent auxiliary resident-only Pressure result. It may retain a
+    // different extent from target B; target Query never scores draft/MTP Q.
+    std::vector<std::uint32_t> auxiliary_selected;
+};
+
+// Internal Program-owned execution owner, deliberately separate from public
+// strategy selection/capability advertising. Before admission the caller must
+// restore/reconstruct the exact aligned prefix, including its GDN StateImage,
+// and retain the original source checkpoint. The owning RequestControl holds
+// the immutable PreparedPromptData through every finite advance.
+//
+// The owner reserves resources, freezes native source bytes/index, establishes
+// complete-address COW, then runs the real target layer-major forward and MTP.
+// First-layer MTP uses no private probe. Explicit upstream-global MTP first
+// runs the separate private target probe and restores its exact native source;
+// both modes then perform the real fresh-Q layerwise Query exactly once.
+// Failure drains native work and marks
+// the attempted continuation invalid; old immutable source leases/checkpoints
+// remain alive until this owner is retired by the Program.
+class NativeLayerwiseProgramQuery {
+public:
+    NativeLayerwiseProgramQuery(ProgramImpl&,SequenceState&,RequestControl&,
+        execution::PrefillContext&,std::uint64_t request_id,
+        std::shared_ptr<KvmemPrefixCheckpoint>,NativeLayerwiseQueryResources);
+    ~NativeLayerwiseProgramQuery();
+    NativeLayerwiseProgramQuery(const NativeLayerwiseProgramQuery&)=delete;
+    NativeLayerwiseProgramQuery& operator=(const NativeLayerwiseProgramQuery&)=delete;
+    NativeQueryRunnerStep advance(execution::PrefillContext&);
+    bool complete() const noexcept;
+    // Publish only after the target/GDN/MTP work has fenced. The ordinary
+    // Program request completion still owns ledger/generated-token acceptance.
+    void accept();
+    void abort() noexcept;
+    kvmem::LayerwiseQueryWork work() const noexcept;
+    std::uint64_t scored_rows() const noexcept;
+    NativeLayerwiseProbeWork probe_work() const noexcept;
+private:
+    struct Impl;
+    std::unique_ptr<Impl> impl_;
+};
