+    try {
+        if (writer) {
+            writer->copy_native_pages();writer->commit();
+            p.backend_kv_addresses->destructive_truncate(*sequence.kv->backend,local-1);
+            // A one-column accepted partial page was removed by truncation.
+            // Rebind it before the original native last-row store.
+            p.backend_kv_addresses->ensure_mapped_to_tokens(*sequence.kv->backend,local+lead,native_streams);
+        }
+        replacement.read(offset,p.memory_kv_staging->data(),layout.page_stride);
+        const std::array inputs{static_cast<const std::byte*>(p.memory_kv_staging->data())};
+        const std::array source_pages{p.backend_kv_addresses->physical_page(*sequence.kv->backend,slot)};
+        pool.copy_from_host_records(inputs,{},source_pages,layout,native_streams);
+        auto bridge=context;bridge.cache_position_shift=window.layer_views.auxiliary_removed_tokens;
+        auto token=p.io.mtp->target_input_ids.slice(0,0,1);
+        ops::set_i32_scalar(token,next_token,p.device.stream);
+        const bool current_row=!resident && build_proposal;
+        ops::set_i32_scalar(p.io.rope_delta,sequence.rope_delta+
+            static_cast<std::int32_t>(window.layer_views.auxiliary_removed_tokens)-(current_row?1:0),p.device.stream);
+        // For cold last blocks, cache L+63 is a transfer scratch coordinate.
+        // The explicit native RoPE axes remain the original position H-1.
+        execution::mtp_bridge_and_propose(bridge,token,sequence.tail_hidden,
+            static_cast<std::int32_t>(resident?frontier-1:(current_row?frontier:frontier+63)),original_rope,build_proposal,next_embedding);
+        const std::array pages{p.backend_kv_addresses->physical_page(*sequence.kv->backend,slot)};
+        const std::array outputs{static_cast<std::byte*>(p.memory_kv_staging->data())};
+        pool.copy_to_host_records(pages,outputs,{},layout,native_streams);p.device.synchronize();
+        if (current_row) {
+            // A zero-suffix proposal's shifted row H-1 is a CURRENT auxiliary
+            // query from hidden_H-1 + newly sampled token_H. It self-attends
+            // once at cache L, outside selected historical IDs. Copy its exact
+            // native code/scale row back to canonical row63, without retaining
+            // it as an extra historical selection. AR rows remain temporary.
+            const auto& shapes=pool.geometry().planes;
+            if (shapes.size()!=layout.planes.size()) throw std::logic_error("native MTP boundary plane inventory changed");
+            for (std::size_t i=0;i<shapes.size();++i) {
+                const auto bytes=std::size_t(shapes[i].leading_extent)*dtype_size(shapes[i].dtype);
+                for (std::int32_t head=0;head<shapes[i].head_extent;++head) {
+                    const auto base=layout.planes[i].offset+std::size_t(head)*64*bytes;
+                    replacement.write(offset+base+63*bytes,static_cast<const std::byte*>(p.memory_kv_staging->data())+base,bytes);
+                }
+            }
+        } else replacement.write(offset,p.memory_kv_staging->data(),layout.page_stride);
+        replacement.seal();
+        if (resident) p.backend_kv_addresses->commit_frontier(*sequence.kv->backend,local);
+        // Proposal IDs now live in the native round buffers. Temporary future
+        // AR rows cannot become a checkpoint's accepted auxiliary ownership.
+        p.backend_kv_addresses->destructive_truncate(*sequence.kv->backend,local);
+        window.archive[id]=std::move(replacement);window.canonical_source.reset();
+        window.layer_views.source_epoch=next_source_epoch();++window.layer_views.auxiliary_view_version;
+        ++window.stamp.view_version;sequence.mtp_kv_valid=frontier;
+        ops::set_i32_scalar(p.io.rope_delta,sequence.rope_delta+
+            static_cast<std::int32_t>(window.removed_tokens),p.device.stream);
+        window.layerwise_rewrite_pending=false;
+    } catch (...) {
+        (void)cudaStreamSynchronize(p.device.stream);window.stamp.valid=false;
+        // Keep the unpublished marker: the owning executor must restore its
+        // immutable source CP or release this failed address before reuse.
+        throw;
+    }
+}
+}
