+        // allocating their control blocks. Existing v1 Work is already funded.
+        const auto descriptor_planes=std::uint64_t(parameters.model.config().text.full_attention_layers)*
+            std::max<std::size_t>(1,device.size())*4+(backend_kv_pages?4:0);
+        const auto pricing_bytes=admission_add(checkpoint?2*checkpoint->graph.bytes():2*sizeof(kvmem::GraphSnapshot),
+            admission_add(admission_mul(2*(staged.prompt.memory_messages.size()+1),sizeof(kvmem::GraphMessageSpan)),
+                admission_add(admission_mul(6*descriptor_planes,sizeof(kvmem::PayloadPlane)),
