+    }
+    std::cout << "PASS prepared native attention: independent represented oracle, original positions, one-use and failures\n";
+}
+} // namespace
+
+int main() {
+    if (ninfer::test::cuda_unavailable()) return 77;
+    try { run(); return 0; }
+    catch (const std::exception& e) { std::cerr << "FAIL " << e.what() << '\n'; return 1; }
