+    std::uint32_t sink_blocks=0,recent_blocks=0;
+    // Accepted snapshots and unaccepted native matrices have a separate bound.
+    std::uint64_t feedback_host_bytes=32u<<20;
+    NativeLayerwiseQueryResources query;
+};
+
+// One active ordinary request. Accepted state lives in layer_views.feedback;
+// all transient capture/credit belongs here and is drained before retirement.
+// The native Program uses actual H/L and the complete trusted request envelope.
+class NativeLayerwiseRequest {
+public:
+    NativeLayerwiseRequest(ProgramImpl&,SequenceState&,RequestControl&,
+        std::uint64_t request_id,kvmem::LayerwiseRequestEnvelope,NativeLayerwiseRequestOptions);
+    NativeLayerwiseRequest(ProgramImpl&,SequenceState&,RequestControl&,
+        std::uint64_t request_id,kvmem::LayerwiseRequestEnvelope,NativeLayerwiseRequestOptions,
+        std::shared_ptr<NativeLayerwiseAdmission>);
+    static void prepare_feedback_admission(ProgramImpl&,NativeLayerwiseAdmission&,
+        const kvmem::LayerwiseRequestEnvelope&,const kvmem::LayerwisePrefillOptions&);
+    std::uint64_t checkpoint_metadata_reserved() const noexcept;
+    std::unique_ptr<NativeLayerwiseCheckpointCredit> take_checkpoint_admission(
+        NativeLayerwiseCheckpointRole,std::uint32_t frontier,std::uint64_t bytes);
+    ~NativeLayerwiseRequest();
+    NativeLayerwiseRequest(const NativeLayerwiseRequest&)=delete;
+    NativeLayerwiseRequest& operator=(const NativeLayerwiseRequest&)=delete;
+    std::uint32_t admit_prefill(std::uint32_t desired);
+    // count is one literal semantic Window credit. A native Vision tile may
+    // consume a shorter part; its complete sampling frame remains pending.
+    void prepare_prefill(std::uint32_t begin,std::uint32_t count);
+    void prepare_prefill(std::uint32_t begin,std::uint32_t count,std::uint32_t native_rows);
+    const execution::CurrentLayerQueryBoundary& boundary() const;
+    void accept_prefill(std::uint32_t begin,std::uint32_t end);
+    // Query uses one complete accepted matrix, irrespective of native chunks.
+    void prepare_query(std::uint32_t begin,std::uint32_t count,std::uint32_t local_begin);
+    void restored_query_view(std::uint32_t model_layer,const kvmem::ExecutionView&);
+    void accept_query(const kvmem::MemoryStamp& accepted);
+    // The reference skips recall when H is smaller than the exact selected
+    // budget. Reserve the whole aligned evaluation, then run ordinary native
+    // chunks with one Prefill sample frame and the existing resident maps.
+    bool query_refresh_required() const;
+    // Warm imports can reach A with too many old-view physical tokens for the
+    // private upstream-global probe. Reference bind first applies ordinary
+    // resident-only Pressure to startup K, never Query's smaller semantic B.
+    bool prepare_mtp_probe_window();
+    // Fenced import is a separate phase; it can require resident Pressure at
+    // a partial accepted H before the next ordinary block action is reached.
+    bool prepare_import_start();
+    void prepare_no_refresh_query();
+    // Prefill input can retire while accepted Output feedback keeps this owner.
+    void detach_prefill();
+    std::uint32_t admit_output(std::uint32_t desired);
+    // Bind actual valid credit separately from the fixed native verifier and
+    // auxiliary/noise widths. All mappings and metadata are admitted before
+    // native execution; Rawresolve/cancel drains this temporary grant.
+    NativeOutputPhysicalPlan prepare_output_physical(std::uint32_t valid_rows,
+                                                     std::uint32_t physical_target_rows);
+    NativeOutputPhysicalPlan prepare_dflash_output_physical(std::uint32_t valid_rows,std::uint32_t target_rows,std::uint32_t noise_rows);
+    void prepare_output_control(std::uint32_t valid_rows);
+    void prepare_output(std::uint32_t begin,std::span<const TokenId> consumed);
+    void accept_output(const kvmem::MemoryStamp& accepted,std::uint32_t accepted_rows);
+    // Masked drafts are produced on-device immediately before verification.
+    // Capture bounded candidate mass first; bind exact consumed ledger IDs
+    // only after native raw resolution, before shared parser/mass acceptance.
+    void prepare_output_candidates(std::uint32_t begin,std::uint32_t valid_rows);
+    void accept_output_tokens(const kvmem::MemoryStamp&,std::span<const TokenId> consumed);
+    // Cancelled speculative verification has not consumed its input prefix.
+    // Discard only private parser/mass reservations after the native owner has
+    // resolved its state/KV; keep the last accepted feedback snapshot intact.
+    void discard_output();
+    bool query_workspace_needed() const noexcept;
+    std::uint64_t request_identity() const noexcept;
+    NativeLayerwiseBatchRow output_row() const;
+    void observe_output_row(const NativeLayerwiseBatchRow&,const execution::CurrentLayerAttentionFrame&);
+    // Undo PRE-SUBMIT preparation only; Native abort remains conservative after
+    // model submission and may invalidate a grant before attention was reached.
+    void withdraw_output_before_submit();
+    // Borrow the cohort epoch only. Storage arm/fence/release belongs to the
+    // complete native unit; one owner cannot release another row's capture.
+    void prepare_graph_output(std::uint64_t epoch,std::uint32_t physical_rows);
+    void validate_graph_output_complete(std::uint64_t epoch) const;
+    void complete_graph_output(std::uint64_t epoch) noexcept;
+    void abort_graph_output(std::uint64_t epoch) noexcept;
+    NativeLayerwiseOutputWork output_work() const noexcept;
+    bool query_due() const;
+    bool pending_native() const noexcept;
+    const kvmem::LayerwiseWindowPlan& plan() const;
+    const NativeLayerwiseRequestOptions& options() const;
+    void retire();
+    void abort() noexcept;
+private:
+    struct Impl;std::unique_ptr<Impl> impl_;
+};
