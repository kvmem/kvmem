diff --git a/src/models/qwen3_5/program/native_dflash_copy.h b/src/models/qwen3_5/program/native_dflash_copy.h
new file mode 100644
index 0000000000000000000000000000000000000000..6861550bbcb1552025e661e7ee3dde0593578d90
--- /dev/null
+++ b/src/models/qwen3_5/program/native_dflash_copy.h
@@ -0,0 +1,26 @@
+#pragma once
+#include <cstddef>
+#include <cstdint>
+#include <limits>
+#include <stdexcept>
+namespace ninfer::models::qwen3_5::detail {
+struct NativeDFlashCopyPlan {
+    std::uint32_t target_drafts=0,noise_drafts=0,batch=0;
+    bool pack_leading_prefix=false;
+    std::size_t source_pitch=0,target_pitch=0,sparse_source_pitch=0,sparse_target_pitch=0;
+};
+// Pure geometry for the explicit new owner path. No proposal/acceptance math.
+inline NativeDFlashCopyPlan plan_native_dflash_copy(std::uint32_t neural,std::uint32_t copy,
+    std::uint32_t batch,std::uint32_t maximum_batch,std::uint32_t candidates) {
+    if (!neural || neural>15 || !copy || copy>63 || !batch || batch>maximum_batch ||
+        (batch>1 && copy>15) || !candidates || candidates>UINT32_MAX/sizeof(std::uint32_t))
+        throw std::invalid_argument("layerwise DF2 copy geometry is outside native width domains");
+    const auto sparse=std::size_t(candidates)*sizeof(std::uint32_t);
+    if (sparse>std::numeric_limits<std::size_t>::max()/63)
+        throw std::length_error("DF2 sparse row pitch overflows");
+    const auto noise=batch==1?0U:(neural>copy?neural:copy);
+    return {copy,noise,batch,batch>1 && neural>copy,
+        std::size_t(neural)*sizeof(std::uint32_t),std::size_t(copy)*sizeof(std::uint32_t),
+        std::size_t(neural)*sparse,std::size_t(copy)*sparse};
+}
+} // namespace ninfer::models::qwen3_5::detail
diff --git a/src/models/qwen3_5/program/native_dflash_features.cpp b/src/models/qwen3_5/program/native_dflash_features.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..0349d276b62f974ce7150dc136ea77665f2e89b9
--- /dev/null
+++ b/src/models/qwen3_5/program/native_dflash_features.cpp
@@ -0,0 +1,144 @@
+#include "models/qwen3_5/program/native_dflash_features.h"
+#include "models/qwen3_5/execution/attention.h"
+#include "kvmem/query_projection_tape.hpp"
+#include "ninfer/ops/scalar.h"
+#include "ninfer/ops/position.h"
+#include <algorithm>
+#include <cstring>
+#include <limits>
+#include <stdexcept>
+
+namespace ninfer::models::qwen3_5::detail {
+using execution::dimension;
+namespace {
+std::uint64_t checked_product(std::uint64_t a,std::uint64_t b) {
+    if (b && a>UINT64_MAX/b) throw std::length_error("DFlash feature extent overflows");return a*b;
+}
+std::uint64_t checked_sum(std::uint64_t a,std::uint64_t b) {
+    if (a>UINT64_MAX-b) throw std::length_error("DFlash feature extent overflows");return a+b;
+}
+}
+std::uint64_t native_dflash_feature_staging_bytes(const TextConfig& c,std::uint32_t chunk) {
+    return checked_product(chunk,checked_sum(checked_product(c.hidden_size,2),4));
+}
+struct NativeLayerwiseDFlashFeatures::Impl {
+    const DraftConfig& draft;
+    kvmem::LayerwiseQueryIdentity identity;
+    const std::uint32_t hidden,chunk;
+    std::uint64_t appended;
+    bool failed=false;
+    kvmem::QueryProjectionLayout layout;
+    std::unique_ptr<kvmem::HostKvStorage> ram,metadata;
+    std::unique_ptr<kvmem::HostKvReservation> controls;
+    std::unique_ptr<kvmem::SpillFile> disk;
+    std::unique_ptr<PinnedHostBuffer> staging;
+    std::vector<std::unique_ptr<kvmem::QueryProjectionTape>> tapes;
+    Impl(const TextConfig& target,const DraftConfig& config,kvmem::LayerwiseQueryIdentity id,
+        std::uint32_t capacity,NativeQueryActivationLimits& limits)
+        :draft(config),identity(std::move(id)),hidden(target.hidden_size),chunk(capacity),appended(identity.evaluation.begin),
+         layout{"ninfer.dflash2.native-bf16-post-block-residual",1,{{0,checked_product(hidden,2)}}} {
+        if (!config.dflash2 || !hidden || !chunk || !kvmem::valid_layerwise_query_identity(identity) ||
+            identity.evaluation.end>INT32_MAX || config.target_layer_ids.empty() || config.target_layer_ids.size()>32)
+            throw std::invalid_argument("DFlash feature tape requires exact native target taps and logical positions");
+        for (std::size_t i=0;i<config.target_layer_ids.size();++i)
+            if (config.target_layer_ids[i]>=target.layer_types.size() ||
+                std::find(config.target_layer_ids.begin(),config.target_layer_ids.begin()+i,config.target_layer_ids[i])!=config.target_layer_ids.begin()+i)
+                throw std::invalid_argument("DFlash feature taps are repeated or outside the target model");
+        const auto rows=identity.evaluation.end-identity.evaluation.begin;
+        const auto chunks=(rows+chunk-1)/chunk;
+        const auto payload=checked_product(checked_product(rows,hidden*2ull),config.target_layer_ids.size());
+        const auto pin=native_dflash_feature_staging_bytes(target,chunk);
+        const auto control=checked_sum(sizeof(Impl)+sizeof(kvmem::HostKvStorage)*2+sizeof(kvmem::SpillFile)+512,
+            checked_sum(checked_product(config.target_layer_ids.size(),sizeof(std::unique_ptr<kvmem::QueryProjectionTape>)),
+                checked_product(limits.disk_directory.native().capacity(),sizeof(std::filesystem::path::value_type))));
+        const auto meta=checked_sum(control,checked_product(config.target_layer_ids.size(),
+            kvmem::QueryProjectionTape::metadata_bound(layout,chunks)));
+        const auto runner_pin=native_query_staging_bytes(target,chunk);
+        if (pin>limits.staging_host_bytes || pin>limits.host_bytes || runner_pin>limits.host_bytes-pin ||
+            !limits.metadata_host_bytes || meta>limits.metadata_host_bytes)
+            throw std::length_error("DFlash whole-Query features exceed finite staging/metadata resources");
+        const bool use_ram=payload<=limits.host_bytes-pin-runner_pin;
+        if (!use_ram && (payload>limits.disk_bytes || limits.disk_directory.empty()))
+            throw std::length_error("DFlash whole-Query feature payload exceeds finite RAM/SSD resources");
+        // Subtract this owner's complete peak before the main Query runner's
+        // independent admission. Canonical KV storage cannot pay these bytes.
+        limits.host_bytes-=pin+(use_ram?payload:0);limits.staging_host_bytes-=pin;limits.metadata_host_bytes-=meta;
+        if (!use_ram) limits.disk_bytes-=payload;
+        metadata=std::make_unique<kvmem::HostKvStorage>(meta);
+        controls=std::make_unique<kvmem::HostKvReservation>(metadata->reserve(control));
+        if (use_ram) ram=std::make_unique<kvmem::HostKvStorage>(payload);
+        else disk=std::make_unique<kvmem::SpillFile>(limits.disk_directory,payload);
+        staging=std::make_unique<PinnedHostBuffer>(static_cast<std::size_t>(pin));
+        tapes.reserve(config.target_layer_ids.size());
+        if (tapes.capacity()>config.target_layer_ids.size()) throw std::length_error("DFlash tape controls exceeded exact admission");
+        for (auto layer:config.target_layer_ids) {
+            if (use_ram) tapes.push_back(std::make_unique<kvmem::QueryProjectionTape>(*ram,*metadata,chunks,identity,layer,layout));
+            else tapes.push_back(std::make_unique<kvmem::QueryProjectionTape>(*disk,*metadata,chunks,identity,layer,layout));
+        }
+    }
+};
+NativeLayerwiseDFlashFeatures::NativeLayerwiseDFlashFeatures(const TextConfig& c,const DraftConfig& d,
+    kvmem::LayerwiseQueryIdentity id,std::uint32_t chunk,NativeQueryActivationLimits& limits)
+    :impl_(std::make_unique<Impl>(c,d,std::move(id),chunk,limits)) {}
+NativeLayerwiseDFlashFeatures::~NativeLayerwiseDFlashFeatures()=default;
+void NativeLayerwiseDFlashFeatures::capture(std::uint32_t layer,std::uint64_t begin,const Tensor& value,cudaStream_t stream) {
+    auto& p=*impl_;const auto found=std::find(p.draft.target_layer_ids.begin(),p.draft.target_layer_ids.end(),layer);
+    if (found==p.draft.target_layer_ids.end()) return;
+    execution::require_current_layer_query_eager(stream);
+    const auto index=static_cast<std::size_t>(found-p.draft.target_layer_ids.begin());
+    if (p.failed || value.dtype!=DType::BF16 || value.ne[0]!=p.hidden || value.ne[1]<=0 ||
+        value.ne[1]>p.chunk || value.ne[2]!=1 || value.ne[3]!=1 || value.nb[0]!=2)
+        throw std::logic_error("DFlash fresh native tap geometry or owner changed");
+    try {
+        const auto row=std::size_t(p.hidden)*2;
+        const auto rows=static_cast<std::uint32_t>(value.ne[1]);
+        CUDA_CHECK(cudaMemcpy2DAsync(p.staging->data(),row,value.data,value.nb[1],row,rows,cudaMemcpyDeviceToHost,stream));
+        CUDA_CHECK(cudaStreamSynchronize(stream));
+        p.tapes[index]->append(p.identity,layer,begin,rows,{{0,p.staging->data(),row*rows}});
+        if (p.tapes[index]->covered_end()==p.identity.evaluation.end) p.tapes[index]->finish(p.identity,layer);
+    } catch (...) {p.failed=true;(void)cudaStreamSynchronize(stream);throw;}
+}
+void NativeLayerwiseDFlashFeatures::restore(std::uint64_t begin,std::uint32_t rows,const Tensor& features,
+    const Tensor& position_capacity,cudaStream_t stream) {
+    auto& p=*impl_;
+    execution::require_current_layer_query_eager(stream);
+    if (p.failed || begin<p.identity.evaluation.begin || begin>p.identity.evaluation.end || !rows || rows>p.chunk || rows>p.identity.evaluation.end-begin ||
+        std::any_of(p.tapes.begin(),p.tapes.end(),[](const auto& t){return !t->complete();}))
+        throw std::logic_error("DFlash context cannot consume incomplete or reordered native target taps");
+    if (features.dtype!=DType::BF16 || features.ne[0]!=p.hidden*p.tapes.size() || features.nb[0]!=2 ||
+        features.ne[1]<rows || features.ne[2]!=1 || features.ne[3]!=1 ||
+        position_capacity.dtype!=DType::I32 || position_capacity.ne[0]<rows || position_capacity.nb[0]!=4)
+        throw std::logic_error("DFlash lost its startup-planned feature storage");
+    try {
+        const auto row=std::size_t(p.hidden)*2;
+        for (std::size_t i=0;i<p.tapes.size();++i) {
+            p.tapes[i]->read_rows(p.identity,p.draft.target_layer_ids[i],0,begin,rows,p.staging->data(),row*rows);
+            auto* destination=static_cast<std::byte*>(features.data)+i*row;
+            CUDA_CHECK(cudaMemcpy2DAsync(destination,features.nb[1],p.staging->data(),row,row,rows,cudaMemcpyHostToDevice,stream));
+            CUDA_CHECK(cudaStreamSynchronize(stream));
+        }
+        // The independent native ring addresses logical token positions. It is
+        // unrelated to the target layer's selected/compacted physical stripe.
+        auto positions=position_capacity.slice(0,0,dimension(rows));
+        ops::fill_i32_positions(positions,static_cast<std::int32_t>(begin),stream);
+        CUDA_CHECK(cudaStreamSynchronize(stream));
+    } catch (...) {p.failed=true;(void)cudaStreamSynchronize(stream);throw;}
+}
+void NativeLayerwiseDFlashFeatures::append(execution::PrefillContext& context,std::uint64_t begin,std::uint32_t rows) {
+    auto& p=*impl_;auto& core=context.execution;const auto stream=core.device.stream;
+    if (p.failed || begin!=p.appended || !context.dflash || !core.io.dflash_decode || !context.drafter)
+        throw std::logic_error("DFlash native append lost its chronological owning context");
+    auto& state=*context.dflash;auto& frame=*core.io.dflash_decode;
+    try {
+        restore(begin,rows,state.prefill_features,state.prefill_positions,stream);
+        auto positions=state.prefill_positions.slice(0,0,dimension(rows));
+        auto counts=frame.append_counts.slice(0,0,1),lanes=frame.state_destination_slots.slice(0,0,1),tables=frame.dflash_kv_table_rows.slice(0,0,1);
+        ops::set_i32_scalar(counts,dimension(rows),stream);
+        ops::set_i32_scalar(lanes,context.state_destination_slot,stream);
+        ops::set_i32_scalar(tables,context.dflash_kv_table_row,stream);
+        execution::dflash_append_context(context,state.prefill_features.slice(1,0,dimension(rows)),positions,counts,lanes,tables,{rows,rows});
+        CUDA_CHECK(cudaStreamSynchronize(stream));p.appended+=rows;
+    } catch (...) {p.failed=true;(void)cudaStreamSynchronize(stream);throw;}
+}
+bool NativeLayerwiseDFlashFeatures::complete() const noexcept {return !impl_->failed && impl_->appended==impl_->identity.evaluation.end;}
+}
diff --git a/src/models/qwen3_5/program/native_dflash_features.h b/src/models/qwen3_5/program/native_dflash_features.h
new file mode 100644
