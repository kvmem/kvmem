+        const auto* policy=prompt.layerwise_policy.get();
+        const auto raw=layerwise_original_query(prompt);
+        const auto effective=layerwise_effective_query(prompt);
+        const auto evaluation=window.query_evaluation();
+        const auto mode=layerwise_reselect(prompt);
+        const char* name=mode==KvmemReselect::Force?"force":mode==KvmemReselect::Off?"off":"auto";
+        std::fprintf(stderr,"KVMEM_LAYERWISE_QUERY_POLICY raw=%u raw_begin=%llu raw_end=%llu effective=%u effective_begin=%llu effective_end=%llu eval_begin=%llu eval_end=%llu source_h=%llu source_l=%llu actual_h=%u actual_l=%u reselect=%s prefill=%s exact_native=%u previous_span_match=%u auto_skip=%u\n",
+            unsigned(bool(raw)),(unsigned long long)(raw?raw->begin:0),(unsigned long long)(raw?raw->end:0),
+            unsigned(bool(effective)),(unsigned long long)(effective?effective->begin:0),(unsigned long long)(effective?effective->end:0),
+            (unsigned long long)(evaluation?evaluation->begin:0),(unsigned long long)(evaluation?evaluation->end:0),
+            (unsigned long long)(policy?policy->source_history:0),(unsigned long long)(policy?policy->source_visible:0),
+            unsigned(sequence.text_kv_valid),unsigned(sequence.kv?text_kv_addresses->committed_frontier(sequence.kv->text):0),
+            name,policy && policy->keep_selected?"keep-selected":"pressure",unsigned(policy && policy->exact_source),
+            unsigned(policy && policy->previous_query_match),unsigned(mode==KvmemReselect::Auto && raw && !effective));
+    }
+    if (speculative_backend==SpeculativeBackend::Mtp && sequence.text_kv_valid &&
+        sequence.text_kv_valid<prompt.token_ids.size()) {
+        const bool query_boundary=native.query_due() && native.query_refresh_required();
+        if (!query_boundary) {
+            const auto selectors=state_selectors(sequence);
+            execution::PrefillContext bridge{
+                {device,parameters,work,state_images->linear(0),replay_records?&*replay_records:nullptr,
+                 io,prefill_hidden,prefill_chunk,proposal_head,stage_runtime.get(),rope_yarn,
