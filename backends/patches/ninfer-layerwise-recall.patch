+std::vector<GraphExecutionProfile> layerwise_ordinary_graph_profiles(std::uint32_t capacity,
+    std::uint32_t batch,std::span<const ops::AttentionHeadGeometry> targets,KvCacheStorage storage) {
+    if (!capacity || capacity>ops::kCausalAttentionMaximumVisibleKeys || !batch || batch>kMaximumConcurrency || targets.empty())
+        throw std::invalid_argument("layerwise ordinary graph geometry is incomplete");
+    std::vector<GraphExecutionProfile> result;std::vector<std::vector<int>> classes;
+    std::vector<int> current,previous;current.reserve(targets.size());previous.reserve(targets.size());
+    const auto signature=[&](std::uint32_t frontier) {
+        current.clear();for (const auto a:targets) current.push_back(launch_shape(a,storage,1,frontier+1,batch));
+    };
+    const auto emit=[&](std::uint32_t begin,std::uint32_t end) {
+        const auto found=std::find(classes.begin(),classes.end(),previous);
+        const auto topology=static_cast<std::uint32_t>(found-classes.begin());
+        if (found==classes.end()) classes.push_back(previous);result.push_back({begin,end,topology});
+    };
+    constexpr std::array preferred_ends{127U,511U,2047U,4095U,8197U,16389U,32767U};
+    std::uint32_t begin=0;signature(0);previous=current;
+    for (std::uint32_t frontier=1;frontier<capacity;++frontier) {
+        signature(frontier);
+        const bool preferred=std::binary_search(preferred_ends.begin(),preferred_ends.end(),frontier-1);
+        if (current!=previous || preferred) {emit(begin,frontier-1);begin=frontier;previous=current;}
+    }
+    emit(begin,capacity-1);return result;
+}
+std::vector<GraphExecutionProfile> layerwise_mtp_graph_profiles(MtpGraphCapacities cap,
+    std::uint32_t verify,std::uint32_t drafts,std::span<const ops::AttentionHeadGeometry> targets,
+    ops::AttentionHeadGeometry own,KvCacheStorage storage,std::uint32_t batch) {
+    if (!cap.main || cap.own<cap.main || cap.own>ops::kCausalAttentionMaximumVisibleKeys ||
+        !verify || verify>63 || !drafts || drafts>15 || targets.empty() || !batch || batch>kMaximumConcurrency)
+        throw std::invalid_argument("layerwise MTP graph geometry is incomplete");
+    const auto visible=[](std::uint64_t n,std::uint32_t capacity) {
+        return static_cast<std::uint32_t>(std::min<std::uint64_t>(n,capacity));
+    };
+    // Ask the actual Native Op for each legal compact frontier. This avoids
+    // assuming B1 cutoffs or a single monotone route transition for B>1/TP.
+    // Only the current/signature-class vectors live; no C-sized table exists.
+    std::vector<GraphExecutionProfile> result;
+    std::vector<std::vector<int>> classes;
+    std::vector<int> current,previous;
+    current.reserve(targets.size()+drafts+1U);previous.reserve(targets.size()+drafts+1U);
+    const auto signature=[&](std::uint32_t frontier) {
