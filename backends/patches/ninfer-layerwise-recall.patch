+                    input->positions.at(std::size_t(axis)*input->token_ids.size()+begin+i):
+                    static_cast<std::int32_t>(begin+i)+sequence.rope_delta;
+        }
+        CUDA_CHECK(cudaMemcpyAsync(positions.data,cache_host.data(),std::size_t(n)*4,cudaMemcpyHostToDevice,p.device.stream));
+        CUDA_CHECK(cudaMemcpyAsync(rope.data,rope_host.data(),std::size_t(n)*4*rope_axes,cudaMemcpyHostToDevice,p.device.stream));
+        execution::TextContext card(p.device,p.parameters,p.work,context.text_kv,context.execution.linear_attention,
+            p.io,p.prefill_hidden,p.prefill_chunk,static_cast<std::uint32_t>(begin),context.mtp_kv,&context.text_cache,context.mtp_cache);
+        card.set_expert_runtime(p.experts.get());card.set_rope_yarn(p.rope_yarn);card.set_mtp_attention_window(p.mtp_attention_window);
+        execution::configure_text_card(card,context.execution,context.sampling,context.state_source_slot,
+            context.state_destination_slot,input_owner->initial_mtp_extent);
+        card.set_stage_runtime(context.execution.stages);
+        Tensor composed;const Tensor* embedding=nullptr;
+        if (visual_query) {
+            composed=auxiliary_embeddings.slice(1,0,dimension(n));
+            // Embed actual shifted IDs first, including the final generated
+            // token. Every prompt column is overwritten with its exact original
+            // native composed embedding; visual placeholder IDs never stand in
+            // for an image embedding.
+            card.query_embed(ids,composed);
+            if (prompt_columns) runner->copy_composed_embeddings(begin+1,prompt_columns,
+                composed.slice(1,0,dimension(prompt_columns)));
