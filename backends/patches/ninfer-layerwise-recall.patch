+            runner->copy_composed_embeddings(begin,1,composed);embedding=&composed;
+        }
+        card.query_mtp_prefill(ids,sequence.tail_hidden,positions,rope,{auxiliary_tokens+64,auxiliary_tokens+64},false,
+            nullptr,nullptr,nullptr,embedding);
+        pool.copy_to_host_records(scratch,outputs,{},layout,p.compute_streams);p.device.synchronize();
+        auxiliary_boundary_record.write(offset,p.memory_kv_staging->data(),layout.page_stride);
+        auxiliary_boundary_record.seal();
+        const auto id=begin/64-1;archive.records.at(id)=auxiliary_boundary_record.source();
+        const auto selected=std::lower_bound(pending_maps.auxiliary_pages.begin(),pending_maps.auxiliary_pages.end(),id);
+        if (selected!=pending_maps.auxiliary_pages.end() && *selected==id) {
+            const auto slot=static_cast<std::uint32_t>(selected-pending_maps.auxiliary_pages.begin());
+            pool.copy_page(scratch.front(),p.backend_kv_addresses->physical_page(*sequence.kv->backend,slot),p.compute_streams);
+            p.device.synchronize();
+        }
+        auxiliary_boundary_ready=true;
+    }
+    void final_hidden(std::uint64_t begin,const Tensor& hidden,const Tensor* logits) {
+        if (!active_context) throw std::logic_error("native Query final hidden escaped its finite context");
+        auto& context=*active_context;auto& p=program;const auto n=static_cast<std::uint32_t>(hidden.ne[1]);
