+                throw std::logic_error("native MTP cannot consume hidden rows before its explicit history selection");
+            auto current=archive.canonical;current.resident.assign(pending_maps.auxiliary_pages.begin(),pending_maps.auxiliary_pages.end());
+            current.stamp.view_version=pending_maps.auxiliary_view_version;
+            const auto offset=plan_host_kv_page_layout(p.text_kv_pages->physical_pool().geometry()).page_stride;
+            const auto view=restore_native_layer_stripe(archive,current,*auxiliary_plan,p.backend_kv_pages->physical_pool(),
+                *p.backend_kv_addresses,*sequence.kv->backend,p.device,p.compute_streams,*p.memory_kv_staging,offset,p.kvmem_options.verify_transfers);
+            pending_maps.auxiliary_pages.clear();for (const auto& item:view.blocks) pending_maps.auxiliary_pages.push_back(static_cast<std::uint32_t>(item.block.id));
