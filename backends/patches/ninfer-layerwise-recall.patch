+}
+}
+int main(int argc,char** argv) {
+    if (argc==1) {std::cout<<"SKIP public Engine: supply a qualified artifact and explicit native strategy\n";return 77;}
+    try {
+        check(argc==3 || (argc==4 && (std::string_view(argv[3])=="pipeline" || std::string_view(argv[3])=="multi-gpu" || std::string_view(argv[3])=="tensor")),
+            "usage: test_layerwise_engine_query artifact ordinary|first-layer|upstream-global|dflash2 [pipeline|multi-gpu|tensor]");
+        const bool pipeline=argc==4;
+        const bool tensor=pipeline && std::string_view(argv[3])=="tensor";
+        const bool multi_gpu=pipeline && (std::string_view(argv[3])=="multi-gpu" || tensor);
+        const bool dflash2=std::string_view(argv[2])=="dflash2";
+        const bool ordinary=std::string_view(argv[2])=="ordinary";
+        std::vector<std::vector<std::int32_t>> control;
+        for (unsigned pass=0;pass<(pipeline?2u:1u);++pass) {
+        ninfer::EngineOptions options;options.artifact_path=argv[1];options.max_context=2048;
+        if (pass) options.devices={0,multi_gpu?1:0};
+        options.tensor_parallel=pass && tensor;
+        options.kv_capacity=ninfer::KvCapacityPolicy::explicit_capacity(768);
+        options.max_concurrency=1;options.max_pending_requests=1;options.prefill_chunk=128;
+        options.use_cuda_graph=false;options.context_cache.enabled=false;options.device_profile="off";
+        options.speculative.backend=ordinary?ninfer::SpeculativeBackend::None:
+            (dflash2?ninfer::SpeculativeBackend::DFlash2:ninfer::SpeculativeBackend::Mtp);
+        options.speculative.draft_tokens=ordinary?0:1;
+        options.kvmem.recall_strategy=kvmem::RecallStrategy::Layerwise;
+        if (!dflash2 && !ordinary) options.kvmem.layerwise_mtp_history=kvmem::parse_layerwise_mtp_history(argv[2]);
+        options.kvmem.selected_tokens=576;options.kvmem.reserve_tokens=192;
+        options.kvmem.layerwise_sink_tokens=0;options.kvmem.layerwise_recent_tokens=0;
+        options.kvmem.host_bytes=512ull<<20;options.kvmem.layerwise.metadata_bytes=512ull<<20;
+        ninfer::Engine engine(std::move(options));
+        auto memory=engine.memory_summary();check(memory.kvmem.enabled && memory.kvmem.selected_tokens==576,
+            "public Engine did not activate the explicit independent KVMem strategy");
+        ninfer::PromptInput dialog;std::string document="Keep this reference for my next request. Reply only OK.\n";
+        for (unsigned i=0;i<125;++i) document+=" The marker is quartz.";
+        dialog.messages.push_back(message(ninfer::ChatRole::User,std::move(document)));
+        for (unsigned turn=0;turn<3;++turn) {
+            ninfer::RequestOptions request;request.execution.requested_output_tokens=turn==1?16:1;
+            request.execution.sampling.temperature=0.0f;request.execution.sampling.top_k=1;
+            request.execution.allow_prefix_reuse=true;request.stop.include_model_defaults=false;
+            request.tool_choice.mode=ninfer::ToolChoiceMode::None;request.output.raw=true;
+            auto result=engine.generate(engine.prepare(dialog),std::move(request));
+            if (!pass) control.push_back(result.generated_token_ids);
+            else check(result.generated_token_ids==control.at(turn),
+                "pipeline public accepted tokens differ from the same-width native single-rank control");
+            check(result.generated_token_ids.size()==(turn==1?16u:1u),"public Engine did not complete its actual output budget");
+            if (turn) check(result.reused_prompt_tokens>0,"public Engine lost verified native prefix reuse");
+            memory=engine.memory_summary();check(memory.kvmem.active_sessions==0,
+                "public Engine retained a finished active KVMem request owner");
+            std::cout<<"PASS public Engine "<<argv[2]<<" ranks="<<(pass?2:1)<<" turn"<<turn<<" prompt="<<result.prompt.prompt_tokens
+                <<" reused="<<result.reused_prompt_tokens<<" computed="<<result.computed_prompt_tokens
+                <<" outputs="<<result.generated_token_ids.size()<<" history_hits="<<memory.kvmem.history_hits<<'\n';
+            if (turn==0) {
+                dialog.messages.push_back(message(ninfer::ChatRole::Assistant,"OK"));
+                dialog.messages.push_back(message(ninfer::ChatRole::User,"Which marker was recorded?"));
+            } else if (turn==1) {
+                auto assistant=message(ninfer::ChatRole::Assistant,"running tool");assistant.tool_calls.push_back({"call_1","lookup","{}"});
+                dialog.messages.push_back(std::move(assistant));auto tool=message(ninfer::ChatRole::Tool,"the marker lookup completed");
+                tool.tool_call_id="call_1";dialog.messages.push_back(std::move(tool));
+            }
+        }
+        }
+        return 0;
+    } catch (const std::exception& error) {std::cerr<<"FAIL public layerwise Engine: "<<error.what()<<'\n';return 1;}
+}
