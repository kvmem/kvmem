+    for (const std::uint32_t end:{128U,160U,256U,512U,1029U,2048U,2054U,4096U,8198U,16390U,32768U}) {
+        if (end>=verify+1U) preferred_ends.push_back(end-verify-1U);
+        for (std::uint32_t step=0;step+1U<drafts;++step)
+            if (end>=verify+step+2U) preferred_ends.push_back(end-verify-step-2U);
+    }
+    std::sort(preferred_ends.begin(),preferred_ends.end());
+    std::uint32_t begin=0;signature(0);previous=current;
+    for (std::uint32_t frontier=1;frontier<cap.main;++frontier) {
+        signature(frontier);
+        if (current!=previous || std::binary_search(preferred_ends.begin(),preferred_ends.end(),frontier-1)) {
+            emit(begin,frontier-1);begin=frontier;previous=current;}
+    }
+    emit(begin,cap.main-1);return result;
+}
