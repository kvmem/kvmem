@@ -0,0 +1,33 @@
+#pragma once
+
+#include "core/tensor.h"
+#include <cstdint>
+#include <span>
+
+namespace ninfer::models::qwen3_5::execution { struct PrefillContext; }
+namespace ninfer::models::qwen3_5::detail {
+class ProgramImpl;
+struct SequenceState;
+
+// NInfer row i pairs accepted target hidden_i with token_i+1. A new
+// request therefore rebuilds row H-1 even though its target prefix [0,H)
+// matches an immutable checkpoint. This is native auxiliary state ownership,
+// not a recall picker or a target-forward operation.
+class NativeLayerwiseMtpBoundary {
+public:
+    // Caller holds a complete accepted source checkpoint and the Program's
+    // eager execution boundary. Original native RoPE axes are explicit. If
+    // the last logical block is not resident (literal recent=0 is legal),
+    // only its canonical own-KV record changes; resident selections stay put.
+    // All COW/staging admission precedes native writes. Old CP leases remain
+    // immutable. A native failure invalidates the private destination.
+    static void rebuild(ProgramImpl&,SequenceState&,execution::PrefillContext&,
+        std::int32_t next_token,std::span<const std::int32_t> original_rope,
+        bool build_proposal=false);
+    static void rebuild(ProgramImpl&,SequenceState&,execution::PrefillContext&,
+        std::int32_t next_token,std::span<const std::int32_t> original_rope,
+        bool build_proposal,const Tensor* next_embedding);
