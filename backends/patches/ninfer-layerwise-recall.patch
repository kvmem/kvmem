+        const auto& candidates=*p.memory_candidate_statistics;
+        for (const auto& shard:candidates.ranks) {
+            if (!shard.key_sums.data) continue;
+            if (shard.block_tokens!=1 || shard.key_sums.ne[1]!=candidates.columns ||
+                !shard.ranges.data || shard.ranges.dtype!=DType::I32 || shard.ranges.numel()!=4 ||
+                !shard.candidate_origin.data || shard.candidate_origin.dtype!=DType::I32 ||
+                shard.candidate_origin.numel()!=1)
+                throw std::logic_error("native Output statistics controls differ from their candidate columns");
+        }
+        // Query and ordinary statistics deliberately borrow the same device
+        // ranges. Output uses flattened candidate columns, not logical token
+        // positions. Cover the allocated W*batch domain, including physical
+        // verifier rows beyond its valid prefix; only Rawresolve accepts rows.
+        // Program const backing never changes, including during per-owner
+        // preparation in one cohort. A repeated equal-value CPU write would
+        // still race another rank's pending H2D; this source has no such write.
+        if (p.memory_candidate_ranges!=native_output_candidate_ranges(candidates.columns))
+            throw std::logic_error("Output controls differ from their immutable Program source");
+        for (std::size_t rank=0;rank<candidates.ranks.size();++rank) {
+            const auto& shard=candidates.ranks[rank];
+            if (!shard.key_sums.data) continue;
