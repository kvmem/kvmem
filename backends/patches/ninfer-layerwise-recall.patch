+        const auto* first=static_cast<const std::byte*>(read.data());
+        return std::vector<std::byte>(first,first+read.size());
+    };
+    const std::array input{static_cast<const std::byte*>(write.data())};
+    const std::array original{addresses.physical_page(*source,0)};
+    const auto original_logical=addresses.logical_page(*source,0);
+    const auto table_index=[&] {
+        device.synchronize();
+        const auto row=tables.matrix().slice(1,0,1).view({4});
+        std::int32_t value=-1;
+        CUDA_CHECK(cudaMemcpy(&value,row.data,sizeof(value),cudaMemcpyDeviceToHost));
+        return value;
+    };
+    const auto original_index=table_index();
+    pool.copy_from_host_records(input,{},original,host,device.stream);
+    device.synchronize();
+    const auto epoch=addresses.content_epoch(*source,0);
+    check(store::KVLayerStripeWrite::copy_pages_required(addresses,*source,0,1)==0,
+          "private native page asked for redundant COW");
+    {
+        store::KVLayerStripeWrite lease(addresses,*source,0,1,device,RankStreams::compute(device));
+        lease.copy_native_pages();lease.commit();
+    }
+    check(table_index()==original_index && addresses.logical_page(*source,0)==original_logical && addresses.content_epoch(*source,0)!=epoch &&
+          read_page(original[0])==expected,"private stripe lease changed native planes or failed to version content");
+    const auto destination=addresses.create_inactive();
+    check(bool(destination),"stripe fixture checkpoint slot admission failed");
+    auto snapshot=addresses.prepare_active_snapshot(*source,*destination,64);
+    check(!snapshot.needs_tail_copy(),"aligned stripe fixture unexpectedly copied a tail");
+    addresses.commit_active_snapshot(std::move(snapshot),device.stream);
+    device.synchronize();
+    check(store::KVLayerStripeWrite::copy_pages_required(addresses,*destination,0,1)==1,
+          "shared immutable native page was not scheduled for COW");
+    const auto allocated=pool.allocated_pages(),reserved=pool.reserved_pages();
+    {
+        store::KVLayerStripeWrite cancelled(addresses,*destination,0,1,device,RankStreams::compute(device));
+        check(cancelled.copied_pages()==1,"stripe COW did not reserve exactly one destination");
+        cancelled.copy_native_pages();
+        check(cancelled.abort(),"stripe abort could not drain native producer copies");
+    }
+    check(pool.allocated_pages()==allocated && pool.reserved_pages()==reserved &&
+          table_index()==original_index && addresses.logical_page(*destination,0)==original_logical && read_page(original[0])==expected,
+          "aborted stripe COW changed ownership or native source bytes");
+    {
+        auto pressure=pool.reserve(pool.available_pages());
+        check(bool(pressure),"stripe fixture physical pressure reservation failed");
+        bool rejected=false;
+        try { store::KVLayerStripeWrite refused(addresses,*destination,0,1,device,RankStreams::compute(device)); }
+        catch (const std::exception&) { rejected=true; }
+        check(rejected && table_index()==original_index && addresses.logical_page(*destination,0)==original_logical &&
+              pool.allocated_pages()==allocated && read_page(original[0])==expected,
+              "COW admission failure changed the prior native view");
+    }
+    {
+        store::KVLayerStripeWrite lease(addresses,*destination,0,1,device,RankStreams::compute(device));
+        lease.copy_native_pages();lease.commit();
+    }
+    const auto active=addresses.physical_page(*destination,0);
+    check(table_index()!=original_index && addresses.logical_page(*source,0)==original_logical &&
+          read_page(active)==expected && read_page(original[0])==expected,
+          "whole native page COW did not preserve every model layer/scale plane");
+    auto changed=expected;
+    for (size_t i=4;i<8;++i) {
+        const auto& plane=host.planes[i];
+        for (size_t d=0;d<plane.page_payload_bytes;++d) changed[plane.offset+d]^=std::byte{0x5a};
+    }
+    std::memcpy(write.data(),changed.data(),changed.size());
+    const std::array targets{active};
+    pool.copy_from_host_records(input,{},targets,host,4,8,RankStreams::compute(device));
+    device.synchronize();
+    check(read_page(active)==changed && read_page(original[0])==expected,
+          "target stripe restore changed another layer or the shared checkpoint");
+    {
+        store::KVLayerStripeWrite incomplete(addresses,*destination,0,0,device,RankStreams::compute(device));
+        incomplete.copy_native_pages();bool rejected=false;
+        try { incomplete.commit_unpublished_destination(); } catch (const std::logic_error&) { rejected=true; }
+        check(rejected && addresses.committed_frontier(*destination)==64,
+              "partial write lease revoked an entire accepted native address");
+    }
+    {
+        store::KVLayerStripeWrite private_destination(addresses,*destination,0,1,device,RankStreams::compute(device));
+        private_destination.copy_native_pages();private_destination.commit_unpublished_destination();
+    }
+    check(addresses.committed_frontier(*destination)==0 &&
+          pages.committed_columns(addresses.logical_page(*destination,0))==0 &&
+          read_page(active)==changed && read_page(original[0])==expected,
+          "private rewrite coverage reset changed native bytes or its source checkpoint");
+    addresses.commit_frontier(*destination,64);
+    const auto exclusive_destination=addresses.create_inactive();
+    check(bool(exclusive_destination),"native exclusive writer fixture slot admission failed");
+    auto exclusive_snapshot=addresses.prepare_active_snapshot(*destination,*exclusive_destination,64);
+    addresses.commit_active_snapshot(std::move(exclusive_snapshot),device.stream);
+    check(addresses.release(*destination),"native exclusive writer fixture checkpoint release failed");
+    check(store::KVLayerStripeWrite::copy_pages_required(addresses,*exclusive_destination,0,1)==0,
+          "unprotected exclusive read-only native page asked for redundant COW");
+    {
+        store::KVLayerStripeWrite exclusive(addresses,*exclusive_destination,0,1,device,RankStreams::compute(device));
+        exclusive.copy_native_pages();exclusive.commit();
+    }
+    check(pages.writer_references(addresses.logical_page(*exclusive_destination,0))==1 && read_page(active)==changed,
+          "native stripe lease did not claim an exclusive unprotected writer");
+    check(addresses.release_after_deactivate(*exclusive_destination) && addresses.release(*source) &&
+          pool.allocated_pages()==0 && pool.reserved_pages()==0,
+          "stripe transaction failed to close native physical ownership");
+    std::cout<<"native whole-page COW order="<<int(order)<<" K/V/scales exact, source retained, abort/admission closed\n";
+}
+}
+int main() {
+    try {
+        int count=0;
+        const auto status=cudaGetDeviceCount(&count);
+        if (ninfer::test::cuda_unavailable(status) || (status==cudaSuccess && !count)) return 77;
+        CUDA_CHECK(status);
+        DeviceContext device(0);
+        qualify(device,PagedKVPlaneOrder::PageMajor);
+        qualify(device,PagedKVPlaneOrder::HeadMajor);
+        return 0;
+    } catch (const std::exception& error) { std::cerr<<error.what()<<'\n';return 1; }
+}
