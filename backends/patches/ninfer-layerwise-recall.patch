+}
+TokenSpan ProgramImpl::memory_query_span(const PreparedPromptData& prompt) const {
+    if (kvmem_options.recall_strategy==kvmem::RecallStrategy::Layerwise)
+        return layerwise_token_span(layerwise_effective_query(prompt));
+    return bounded_memory_query(prompt,kvmem_options.query_max_tokens);
+}
+
+LayerwisePromptPolicy ProgramImpl::layerwise_policy_at_source(const PreparedPromptData& prompt,
+    std::uint32_t output_tokens,const KvmemPrefixCheckpoint* checkpoint) const {
+    std::uint64_t history=0,visible=0;std::optional<KvmemQuerySpan> previous;
+    if (checkpoint) {
+        history=checkpoint->prefix.size();
+        if (!history || history>=prompt.token_ids.size() || !checkpoint->identity.stamp.valid ||
+            checkpoint->identity.stamp.frontier!=history || checkpoint->state_bytes()!=state_images->host_layout().image_bytes ||
+            !std::equal(checkpoint->prefix.begin(),checkpoint->prefix.end(),prompt.token_ids.begin()) ||
+            !checkpoint->prefix_identity.matches(prompt,history))
+            throw std::logic_error("layerwise request lacks its exact sealed native checkpoint prefix");
+        if (!checkpoint->layer_views.active() ||
+            checkpoint->layer_views.provenance_digest()!=checkpoint->layer_view_digest)
+            throw std::logic_error("layerwise checkpoint has no complete immutable layer-view provenance");
+        visible=checkpoint->layer_views.validate(static_cast<std::uint32_t>(history));
+        if (checkpoint->layer_views.feedback) previous=checkpoint->layer_views.feedback->original_query;
+    }
+    return finalize_layerwise_query_source(prompt,previous,history,visible,checkpoint!=nullptr,
+        kvmem_window_tokens,64,output_tokens);
+}
+
+kvmem::LayerwiseRequestEnvelope ProgramImpl::layerwise_envelope(const PreparedPromptData& prompt,
+    std::uint32_t output_tokens) const {
+    const bool keep=prompt.layerwise_policy && prompt.layerwise_policy->bound && prompt.layerwise_policy->keep_selected;
+    return layerwise_envelope(prompt,output_tokens,memory_query_span(prompt),keep);
+}
+
+kvmem::LayerwiseRequestEnvelope ProgramImpl::layerwise_envelope(const PreparedPromptData& prompt,
+    std::uint32_t output_tokens,TokenSpan query,bool keep_selected) const {
+    kvmem::LayerwiseRequestEnvelope result;
+    result.prompt_end=prompt.token_ids.size();result.block_tokens=64;
+    result.generation_tokens=kvmem_options.reserve_tokens;result.output_tokens=output_tokens;
+    if (keep_selected) result.prefill_window=kvmem::LayerwiseWindowPolicy::KeepSelected;
+    if (query.count) {
+        if (query.begin>result.prompt_end || query.count>result.prompt_end-query.begin)
+            throw std::invalid_argument("layerwise Query span is outside its complete native prompt");
+        if (query.count>result.generation_tokens)
+            throw RequestError(RequestErrorKind::ContextLengthExceeded,
+                "complete explicit layerwise Query exceeds generation reserve");
+        result.query=kvmem::QueryRange{query.begin,query.begin+query.count};
+        validate_layerwise_media(prompt);
+        result.replay=kvmem::QueryRange{layerwise_media_replay_begin(prompt,query.begin,64),result.prompt_end};
+        result.reserve_query_output=true;
+    }
+    try {
+        const kvmem::LayerwiseWindowPlan validate(result,kvmem_window_tokens);
+        if (const auto evaluation=validate.query_evaluation()) {
+            const auto budget=validate.selection_budget(evaluation->begin);
+            if (evaluation->begin>=budget)
+                kvmem::validate_layerwise_selection_bands(layerwise_keep_bands,64,budget);
+        }
+    } catch (const kvmem::MemoryError& error) {
+        if (error.code()!=kvmem::MemoryErrorCode::BudgetExceeded &&
+            error.code()!=kvmem::MemoryErrorCode::InvalidPlan) throw;
+        throw RequestError(RequestErrorKind::ContextLengthExceeded,error.what());
+    }
+    return result;
+}
+
+void ProgramImpl::bind_layerwise_request_source(PreparedPromptData& prompt,std::uint32_t output_tokens,
+    const KvmemPrefixCheckpoint* checkpoint) const {
+    auto policy=layerwise_policy_at_source(prompt,output_tokens,checkpoint);
+    (void)layerwise_envelope(prompt,output_tokens,layerwise_token_span(policy.effective_query),policy.keep_selected);
+    bind_layerwise_query_source(prompt,std::move(policy));
+}
+
+void ProgramImpl::activate_layerwise_request(SequenceState& sequence,RequestControl& request,
+    std::uint32_t output_tokens) {
+    if (kvmem_options.recall_strategy!=kvmem::RecallStrategy::Layerwise) return;
+    if (!request.prefill || request.lifecycle!=Lifecycle::Prefilling || !layerwise_query_storage)
+        throw std::logic_error("native layerwise activation lacks its immutable input/startup storage");
+    const auto& prompt=request.prefill->prompt;
+    auto envelope=layerwise_envelope(prompt,output_tokens);
+    const kvmem::LayerwiseWindowPlan window(envelope,kvmem_window_tokens);
+    if (prompt.layerwise_policy && prompt.layerwise_policy->bound && prompt.layerwise_policy->exact_source &&
+        (prompt.layerwise_policy->source_history!=sequence.text_kv_valid || !sequence.kv ||
+         prompt.layerwise_policy->source_visible!=text_kv_addresses->committed_frontier(sequence.kv->text)))
+        throw std::logic_error("native activation differs from its finalized actual checkpoint extent");
+    if (const auto evaluation=window.query_evaluation();evaluation && sequence.text_kv_valid>evaluation->begin)
+        throw std::logic_error("native Query admission retained history beyond its aligned source ceiling");
+    const auto& limits=kvmem_options.layerwise;kvmem::validate_layerwise_options(limits);
+    NativeLayerwiseRequestOptions options;
+    options.prefill={64,kvmem_options.selected_tokens,kvmem_options.reserve_tokens};
+    options.sink_blocks=layerwise_keep_bands.sink_blocks;options.recent_blocks=layerwise_keep_bands.recent_blocks;
+    // The finite retained metadata envelope is partitioned explicitly: source
+    // versions keep3/4, feedback/private reducers1/8, frozen request index1/8.
+    // Canonical native records retain their original shared H/D charge.
+    const auto transient=limits.metadata_bytes/8;
+    if (!transient) throw std::length_error("native layerwise metadata budget is too small");
+    options.feedback_host_bytes=transient;options.query.frozen_index_host_bytes=transient;
+    options.query.source_versions_host_bytes=limits.metadata_bytes-2*transient;
+    options.query.envelope=envelope;options.query.selected_tokens=kvmem_options.selected_tokens;
+    options.query.sink_blocks=options.sink_blocks;options.query.recent_blocks=options.recent_blocks;
+    options.query.borrow_program_buffers=true;
+    options.query.activation.host_bytes=limits.activation_ram_bytes;
+    options.query.activation.disk_bytes=limits.activation_disk_bytes;
+    options.query.activation.disk_directory=kvmem_options.disk_path;
+    options.query.activation.metadata_host_bytes=limits.activation_metadata_bytes;
+    auto projection_staging=std::uint64_t(0);
+    if (const auto evaluation=window.query_evaluation()) {
+        const auto chunk=static_cast<std::uint32_t>(std::min<std::uint64_t>(prefill_chunk,evaluation->end-evaluation->begin));
+        projection_staging=parameters.text.tensor_parallel()
+            ?native_query_tensor_staging_bytes(parameters.model.config().text,chunk,static_cast<std::uint32_t>(device.size()),prompt.has_media()?3u:1u)
+            :native_query_staging_bytes(parameters.model.config().text,chunk,prompt.has_media()?3u:1u);
+    }
+    if (const auto evaluation=window.query_evaluation();evaluation && speculative_backend==SpeculativeBackend::DFlash2) {
+        const auto extra=native_dflash_feature_staging_bytes(parameters.model.config().text,
+            static_cast<std::uint32_t>(std::min<std::uint64_t>(prefill_chunk,evaluation->end-evaluation->begin)));
+        if (extra>UINT64_MAX-projection_staging) throw std::length_error("native DFlash feature staging overflows");
+        projection_staging+=extra;
+    }
+    const auto graph_staging=layerwise_graph_feedback?layerwise_graph_feedback->staging_bytes():0;
+    if (graph_staging>=limits.staging_bytes)
+        throw std::length_error("native graph control staging exhausts explicit transfer resources");
+    const auto transfer_budget=limits.staging_bytes-graph_staging;
+    if (projection_staging>=transfer_budget)
+        throw std::length_error("native Query projection leaves no admitted KV/state staging space");
+    options.query.activation.staging_host_bytes=projection_staging;
+    options.query.transfer_staging_host_bytes=transfer_budget-projection_staging;
+    const auto query=memory_query_span(prompt);
+    prepare_memory_statistics(sequence,static_cast<std::uint32_t>(query.begin),
