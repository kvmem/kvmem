+            (tensor && (!stages || !stages->tensor_parallel || !parameters->text.tensor_parallel() ||
+                parameters->text.rank_count!=device.size() || stages->tensor_parallel->shares.size()!=device.size() ||
+                stages->tensor_parallel->shards.size()!=device.size() || !stages->tensor_parallel->exchange)) ||
+            device.active_rank() != 0 || c.execution.work.active_rank() != 0 ||
+            c.state_source_slot != source_slot || c.state_destination_slot != destination_slot ||
+            c.execution.prefill_chunk < chunk)
+            throw std::logic_error("native Query execution owner/rank or state binding changed");
+        if (tensor && !tensor_projection.empty()) {
+            const auto& tp=*stages->tensor_parallel;
+            const auto group=config.attention->num_attention_heads/config.attention->num_key_value_heads;
+            for (std::size_t rank=0;rank<tensor_projection.size();++rank) {
