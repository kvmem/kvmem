+// Immutable descriptors and all backing addresses belong to Program. They outlive
+// every cached graph definition/executable, independently of request retirement.
+struct LayerwiseGraphAttentionSlot {
+    std::uint32_t model_layer=0,attention_layer=0;
+    std::size_t rank=0;
+    std::uint32_t first_query_head=0,query_heads=0,global_query_heads=0;
+    Tensor query,positions,table_rows,completed_epoch,ingress_epoch;
+};
+struct LayerwiseGraphCaptureView {
+    std::span<const LayerwiseGraphAttentionSlot> slots;
+    std::uint32_t max_physical_rows=0,max_batch_size=0;
+    // Allocation-free descriptor validation; call before capture or native work.
+    void validate() const;
+};
+// Issued only by the Program's stable storage. Startup capture/warmup carries
+// no request identity; replay requires an already armed whole-cohort epoch.
+// A non-null observer cannot grant this execution contract.
+class LayerwiseGraphExecutionPermit {
+public:
+    LayerwiseGraphExecutionPermit(const LayerwiseGraphExecutionPermit&)=default;
+    void validate(const LayerwiseGraphCaptureView* view,std::uint32_t physical,std::uint32_t batch) const {
+        if (!view || view!=view_ || physical!=physical_ || batch!=batch_ ||
+            !physical || physical>view->max_physical_rows || !batch || batch>view->max_batch_size ||
+            (replay_ && !epoch_) || (!replay_ && epoch_))
+            throw std::logic_error("native graph copy has no exact Program/cohort execution permit");
+    }
+private:
+    friend class ::ninfer::models::qwen3_5::detail::NativeLayerwiseGraphFeedbackStorage;
+    LayerwiseGraphExecutionPermit(const LayerwiseGraphCaptureView* view,std::uint32_t physical,
+        std::uint32_t batch,std::uint64_t epoch,bool replay):view_(view),physical_(physical),batch_(batch),epoch_(epoch),replay_(replay) {}
+    const LayerwiseGraphCaptureView* view_;
+    std::uint32_t physical_,batch_;
+    std::uint64_t epoch_;
+    bool replay_;
+};
