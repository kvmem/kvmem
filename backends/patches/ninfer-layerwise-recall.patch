+std::uint64_t NativeLayerwiseMtpBoundary::next_source_epoch() {
+    return next_canonical_epoch.fetch_add(1);
+}
+
+kvmem::LayerwiseMemoryCatalog ProgramImpl::layerwise_catalog(SequenceState& sequence) {
+    if (!sequence.kv || sequence.window.layerwise_rewrite_pending)
+        throw std::logic_error("native layerwise catalog requires accepted complete coverage");
+    WindowMemoryBackend backend(*this,sequence,sequence.text_kv_valid);
+    auto& maps=sequence.window.layer_views;
+    if (!maps.active()) {
+        std::vector<std::uint32_t> models,resident;
+        const auto& types=parameters.model.config().text.layer_types;
+        for (std::uint32_t model=0;model<types.size();++model) if (types[model]==MixerKind::FullAttention) models.push_back(model);
+        for (auto id:backend.snapshot().resident) resident.push_back(static_cast<std::uint32_t>(id));
+        maps.initialize(models,resident,sequence.window.stamp.view_version,sequence.text_kv_valid,bool(backend_kv_pages));
+    }
+    const auto extent=maps.validate(sequence.text_kv_valid);
+    if (maps.feedback) {
+        std::vector<std::uint32_t> models;for (const auto& layer:maps.target) models.push_back(layer.model_layer);
+        maps.feedback->validate(sequence.window.stamp.session,sequence.text_kv_valid,models);
+    }
+    if (extent!=text_kv_addresses->committed_frontier(sequence.kv->text))
+        throw std::logic_error("native layerwise catalog differs from physical accepted coverage");
+    std::vector<kvmem::LayerMemorySnapshot> layers;
+    for (const auto& map:maps.target) {
+        auto snapshot=backend.snapshot();snapshot.stamp.view_version=map.view_version;
+        snapshot.resident.assign(map.pages.begin(),map.pages.end());layers.push_back({map.model_layer,std::move(snapshot)});
+    }
+    return {backend.descriptor(),std::move(layers)};
+}
