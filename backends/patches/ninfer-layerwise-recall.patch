+// Public Engine entry regression. This uses only the shipped public API;
+// native Program/FP64/state-byte oracles live in the separate ownership fixture.
+#include "ninfer/engine.h"
+#include <iostream>
+#include <stdexcept>
+#include <string>
+#include <vector>
+
+namespace {
+void check(bool value,const char* text) {if (!value) throw std::runtime_error(text);}
+ninfer::ChatMessage message(ninfer::ChatRole role,std::string body) {
