+std::vector<ops::AttentionHeadGeometry>
+layerwise_graph_target_geometries(const execution::Parameters& parameters) {
+    const auto& config=parameters.model.config().text;
+    if (!config.attention) throw std::logic_error("graph target has no native attention geometry");
+    std::vector<ops::AttentionHeadGeometry> result;
+    const auto add=[&](const TextConfig& c) {
+        const auto& a=*c.attention;
+        result.push_back({static_cast<std::int32_t>(a.head_dim),static_cast<std::int32_t>(a.num_attention_heads),
+            static_cast<std::int32_t>(a.num_key_value_heads)});
+    };
+    if (!parameters.text.tensor_parallel()) add(config);
+    else for (const auto& share:parameters.text.tensor_shares) {
+        if (share.kv_head_end>share.kv_head_begin) add(qwen3_5::tensor_parallel_share(config,share));
+    }
+    if (result.empty()) throw std::logic_error("graph target omitted every native attention rank");
+    return result;
