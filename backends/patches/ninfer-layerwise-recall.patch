+    execution::LayerwiseGraphExecutionPermit capture_permit(std::uint32_t physical,std::uint32_t batch) const;
+    execution::LayerwiseGraphExecutionPermit replay_permit(std::uint64_t epoch,const NativeGraphOutputIdentity&) const;
+    void release(std::uint64_t epoch);
+    void abort(std::uint64_t epoch) noexcept;
