+void TextContext::project_query_attention(const Tensor& residual, const Tensor& cache_positions,
+    const Tensor& rope_positions, PreparedLayerQuery& prepared) {
+    if (prepared.state_ != PreparedLayerQuery::State::Empty || active_sequence_batch_ != 0 ||
+        !active_segments_.empty() || attention_partial_ != nullptr)
+        throw std::logic_error("prepared Query projection requires a new single-owner layer bundle");
+    require_current_layer_query_eager(ctx_.stream);
+    if (current_layer_query_boundary_ != nullptr)
+        require_current_layer_query_eager(*current_layer_query_boundary_, ctx_.stream);
+    const auto& w = query_attention_parameters(prepared.identity_);
+    const auto& config = layer_config();
+    const auto T = residual.ne[1];
+    require_tensor_shape(residual, DType::BF16, {dimension(config.hidden_size), T}, "Query projection input");
+    require_tensor_shape(cache_positions, DType::I32, {T}, "Query projection cache positions");
+    require_tensor_shape(rope_positions, DType::I32, {T, rope_positions.ne[1]}, "Query projection RoPE positions");
+    auto& storage = prepared.storage_;
+    validate_query_storage(storage, config, T, rope_positions.ne[1], work_);
+    validate_query_source(residual, storage.residual, storage);
+    validate_query_source(cache_positions, storage.cache_positions, storage);
+    validate_query_source(rope_positions, storage.rope_positions, storage);
+    validate_query_partial(storage);
+    prepared.state_ = PreparedLayerQuery::State::Projecting;
+    prepared.stream_ = ctx_.stream;
+    try {
+        if (prepared.identity_.model_layer < layer_ready_.size())
+            CUDA_CHECK(cudaStreamWaitEvent(ctx_.stream,layer_ready_[prepared.identity_.model_layer],0));
+        auto scope = work_.scope();
+        copy_query_tensor(residual, storage.residual, ctx_.stream);
+        copy_query_tensor(cache_positions, storage.cache_positions, ctx_.stream);
+        copy_query_tensor(rope_positions, storage.rope_positions, ctx_.stream);
+        Tensor q = workspace::matrix(work_, DType::BF16, dimension(config.attention->query_width()), T)
+            .view({dimension(config.attention->head_dim), dimension(config.attention->num_attention_heads), T});
+        Tensor k = workspace::matrix(work_, DType::BF16, dimension(config.attention->key_width()), T)
+            .view({dimension(config.attention->head_dim), dimension(config.attention->num_key_value_heads), T});
+        attn_project(w, residual, q, storage.gate, k, storage.value);
+        const auto& p = std::get<AttentionParameters>(w.mixer);
+        MemoryStatisticsShard local;
+        std::int32_t statistics_layer;
+        const auto* statistics = memory_statistics_for_layer(prepared.identity_.attention_layer, local, statistics_layer);
+        text_qk_norm(*config.attention, config_.rms_norm_eps, p.query_norm, p.key_norm, q, k,
+                     storage.query, storage.key, ctx_.stream, statistics, statistics_layer);
+        if (current_layer_query_boundary_ != nullptr && current_layer_query_boundary_->projected != nullptr) {
+            require_current_layer_query_eager(*current_layer_query_boundary_, ctx_.stream);
+            current_layer_query_boundary_->projected(current_layer_query_boundary_->owner,
+                {prepared.identity_, storage.query, storage.key, storage.rope_positions, ctx_.stream});
+        }
+        prepared.state_ = PreparedLayerQuery::State::Projected;
+    } catch (...) {
+        prepared.state_ = PreparedLayerQuery::State::Failed;
+        throw;
+    }
+}
