+#include <stdexcept>
+#include <cstdint>
+#include <span>
+
+namespace ninfer::models::qwen3_5::detail {
+class ProgramImpl;class NativeLayerwiseRequest;class NativeLayerwiseGraphFeedbackStorage;struct DecodeGraphProfile;
+struct NativeLayerwiseBatchRow {
+    std::uint32_t lane=0,logical_begin=0,local_begin=0,valid_rows=0;
+    std::uint64_t lane_epoch=0,request_id=0;
+    kvmem::MemoryStamp source;
+    std::int32_t table_row=-1;
+    NativeLayerwiseRequest* owner=nullptr;
+};
+struct NativeOutputRowRange {std::uint32_t begin=0,count=0;};
+inline NativeOutputRowRange native_output_row_range(std::uint32_t width,std::uint32_t batch,std::uint32_t row) {
+    if (!width || width>64 || !batch || batch>kMaximumConcurrency || row>=batch)
+        throw std::logic_error("native Output row is outside its physical cohort");
+    return {row*width,width};
+}
+inline bool native_output_binding_matches(const NativeLayerwiseBatchRow& a,const NativeLayerwiseBatchRow& b) {
+    return a.owner==b.owner && a.lane==b.lane && a.lane_epoch==b.lane_epoch && a.request_id==b.request_id &&
+        a.source==b.source && a.logical_begin==b.logical_begin && a.local_begin==b.local_begin &&
+        a.valid_rows==b.valid_rows && a.table_row==b.table_row;
+}
+// Only new owners participate. The unsubmitted path may undo Host preparation
+// and async address-table work; once target submission begins Native all-row
+// drain/failure/Rawresolve remains authoritative.
+class NativeLayerwiseDecodePreparation {
+public:
+    NativeLayerwiseDecodePreparation(ProgramImpl&,std::span<const std::uint32_t> lanes);
+    ~NativeLayerwiseDecodePreparation();
+    NativeLayerwiseDecodePreparation(const NativeLayerwiseDecodePreparation&)=delete;
+    void submitted() noexcept {submitted_=true;}
+    bool withdraw_if_unsubmitted();
+private:
+    struct Saved {std::uint32_t lane=0;std::uint64_t epoch=0,source=0;std::uint32_t offset=0;std::size_t ledger=0;NativeLayerwiseRequest* owner=nullptr;};
+    ProgramImpl& p_;
+    std::array<Saved,kMaximumConcurrency> saved_{};
+    std::uint32_t size_=0;
+    bool enabled_=false,submitted_=false,withdrawn_=false;
+};
+class NativeLayerwiseOutputCohort {
+public:
+    NativeLayerwiseOutputCohort(ProgramImpl&,std::span<const std::uint32_t> lanes,std::uint32_t physical_rows);
+    ~NativeLayerwiseOutputCohort();
+    NativeLayerwiseOutputCohort(const NativeLayerwiseOutputCohort&)=delete;
+    const execution::LayerwiseOutputBatchObserver& observer() const noexcept {return observer_;}
+    void arm_graph(const DecodeGraphProfile&);
+    void collect_graph();
+    execution::LayerwiseGraphExecutionPermit graph_permit() const;
+private:
+    void attended(const execution::CurrentLayerAttentionFrame&);
+    ProgramImpl& p_;
+    std::uint32_t width_;
+    std::array<NativeLayerwiseBatchRow,kMaximumConcurrency> rows_{};
+    std::uint32_t size_=0;
+    execution::LayerwiseOutputBatchObserver observer_;
+    NativeGraphOutputIdentity graph_identity_;
+    NativeLayerwiseGraphFeedbackStorage* graph_storage_=nullptr;
+    std::uint64_t graph_epoch_=0;
+};
+// One stack cohort/preparation exists at a time in the Program worker. Protect
+// their complete descriptor extent before any Active child entitlement; do not
+// try to allocate it from the already fully entitled parent during a round.
+inline constexpr std::uint64_t native_output_fixed_metadata_bytes=
+    sizeof(std::array<std::int32_t,4>)+sizeof(NativeLayerwiseDecodePreparation)+sizeof(NativeLayerwiseOutputCohort)+64U;
+} // namespace ninfer::models::qwen3_5::detail
