+NativeLayerwiseQueryExecution::NativeLayerwiseQueryExecution(execution::PrefillContext& c,
+    kvmem::LayerwiseQueryRequest& r,NativeQueryActivationLimits l,NativeQueryRunnerBindings b,std::int32_t delta)
+    :NativeLayerwiseQueryExecution(c,r,std::move(l),std::move(b),delta,{}) {}
+NativeLayerwiseQueryExecution::NativeLayerwiseQueryExecution(execution::PrefillContext& c,
+    kvmem::LayerwiseQueryRequest& r,NativeQueryActivationLimits l,NativeQueryRunnerBindings b,std::int32_t delta,NativeQueryPromptInput source)
+    : impl_(std::make_unique<Impl>(c,r,std::move(l),std::move(b),delta,source)) {}
+NativeLayerwiseQueryExecution::~NativeLayerwiseQueryExecution() { if (!complete()) abort(); }
+NativeQueryRunnerStep NativeLayerwiseQueryExecution::advance(execution::PrefillContext& c,
+                                                            std::span<const TokenId> public_input) {
+    auto& p=*impl_;
+    if (p.stage==NativeQueryRunnerStage::Complete || p.stage==NativeQueryRunnerStage::Aborted)
+        throw std::logic_error("native Query execution is already closed");
+    p.validate_context(c);
+    p.tensor_table_valid=false;
+    DeviceBinding binding(p.device.device);
+    try {
+        if (!p.took_landing_events) {
+            // Consume borrowed landing events immediately; a cache poll may
+            // release their host container after this finite advance returns.
+            if (c.take_layer_ready) for (auto event:c.take_layer_ready())
+                CUDA_CHECK(cudaStreamWaitEvent(p.device.stream,event,0));
+            p.took_landing_events=true;
+        }
+        const auto prior=p.stage;
+        const auto prior_layer=p.layer;
+        if (prior==NativeQueryRunnerStage::BeginLayer) {
+            p.output=p.tape(p.layer+1,p.residual_layout);
+            if (p.config.layer_types[p.layer]==MixerKind::FullAttention) {
+                p.attention=p.config.compact_layer_indices[p.layer];
+                if (p.tensor) {
+                    for (std::size_t rank=0;rank<p.attention_ranks;++rank)
+                        p.tensor_projection[rank].tape=p.tape(p.layer,p.tensor_projection[rank].layout);
+                } else p.projection=p.tape(p.layer,p.projected_layout);
+                p.request.begin_layer(p.identity,p.layer);
+                p.stage=NativeQueryRunnerStage::Projection;
+            } else p.stage=NativeQueryRunnerStage::Gdn;
+            return {prior,p.layer,p.cursor,0};
+        }
+        if (p.tensor && (prior==NativeQueryRunnerStage::Projection || prior==NativeQueryRunnerStage::Consumption ||
+            prior==NativeQueryRunnerStage::Gdn)) {
+            const auto n=p.rows();const auto begin=p.cursor;
+            if (prior==NativeQueryRunnerStage::Projection) p.tensor_project(c,public_input,n);
+            else p.tensor_chunk(c,public_input,n,prior==NativeQueryRunnerStage::Consumption);
+            p.cursor+=n;
+            if (p.cursor==p.identity.evaluation.end) {
+                if (prior==NativeQueryRunnerStage::Projection) {
+                    for (std::size_t rank=0;rank<p.attention_ranks;++rank)
+                        p.tensor_projection[rank].tape->finish(p.identity,p.layer);
+                    // FFN-only ranks still need the canonical input when the
+                    // complete head projection has finished. Its coexistence
+                    // with all projections and the output was admitted above.
+                    p.stage=NativeQueryRunnerStage::Restore;
+                } else {
+                    if (prior==NativeQueryRunnerStage::Consumption) p.request.complete_layer(p.identity);
+                    p.finish_layer();
+                }
+            }
+            return {prior,prior_layer,begin,n};
+        }
+        if (prior==NativeQueryRunnerStage::Restore) {
+            const auto& plan=p.request.prepare_restore(p.identity);
+            auto view=p.bindings.restore(p.layer,plan);
+            if (view.visible_tokens!=p.bindings.historical_tokens)
+                throw std::logic_error("native Query layer restore changed admitted physical history extent");
+            p.request.restored(p.identity,view);
+            p.cursor=p.identity.evaluation.begin;p.stage=NativeQueryRunnerStage::Consumption;
+            return {prior,p.layer,p.cursor,0};
+        }
+        const auto rank=(prior==NativeQueryRunnerStage::Embedding || prior==NativeQueryRunnerStage::FinalNorm)
+            ? std::size_t(0):p.parameters->text.layers.at(p.layer).rank;
+        ScopedDeviceRank rank_guard(p.device,rank);
+        ScopedArenaRank arena_guard(c.execution.work,rank);
+        auto& storage=p.ranks.at(rank);
+        execution::TextContext card(c.execution.device,c.execution.parameters,c.execution.work,
+            c.text_kv,c.execution.linear_attention,c.execution.io,c.execution.prefill_hidden,
+            c.execution.prefill_chunk,static_cast<std::uint32_t>(p.identity.evaluation.begin),{},&c.text_cache,nullptr);
+        card.set_stage_runtime(c.execution.stages);
+        const auto n=p.rows();
+        const auto begin=p.cursor;
+        p.bind(c,card,public_input,n,prior==NativeQueryRunnerStage::Gdn && begin!=p.identity.evaluation.begin);
+        if (prior==NativeQueryRunnerStage::Embedding) {
+            auto residual=p.with_rows(storage.capacity.residual,n),ids=p.with_rows(storage.ids,n,0);
+            if (p.prompt_input.vision)
+                card.query_embed_multimodal(ids,residual,*p.prompt_input.prompt,*p.prompt_input.vision,static_cast<std::uint32_t>(begin));
+            else card.query_embed(ids,residual);
+            p.append_residual(*p.input,n);
+        } else if (prior==NativeQueryRunnerStage::Projection) p.project(c,card,n);
+        else if (prior==NativeQueryRunnerStage::Consumption) p.consume(c,card,n);
+        else if (prior==NativeQueryRunnerStage::Gdn) {
+            p.read_residual(n);auto residual=p.with_rows(storage.capacity.residual,n);
+            card.query_gdn_mixer(p.layer,residual);card.query_post_mixer(p.layer,residual);
+            if (p.bindings.layer_output) p.bindings.layer_output(p.layer,p.cursor,residual,p.device.stream);
+            p.append_residual(*p.output,n);
+        } else if (prior==NativeQueryRunnerStage::FinalNorm) {
+            p.read_residual(n);auto residual=p.with_rows(storage.capacity.residual,n),hidden=p.with_rows(storage.hidden,n);
+            card.query_final_norm(residual,hidden);
+            if (begin+n==p.identity.evaluation.end) {
+                p.tail=Tensor(static_cast<std::byte*>(hidden.data)+
+                    std::size_t(p.config.hidden_size)*2*(n-1),DType::BF16,{dim(p.config.hidden_size),1});
+                card.query_head(p.tail,storage.logits);
+            }
+            CUDA_CHECK(cudaStreamSynchronize(p.device.stream));
+            if (p.bindings.final_hidden) {
+                const auto* logits=begin+n==p.identity.evaluation.end ? &storage.logits : nullptr;
+                p.bindings.final_hidden(begin,hidden,logits);
+                CUDA_CHECK(cudaStreamSynchronize(p.device.stream));
+            }
+        }
+        p.cursor+=n;
+        if (p.cursor==p.identity.evaluation.end) {
+            if (prior==NativeQueryRunnerStage::Embedding) {
+                p.input->finish(p.identity,p.input->model_layer());
+                if (p.prompt_input.prompt) p.original_input=p.input;
+                p.cursor=p.identity.evaluation.begin;
+                p.stage=NativeQueryRunnerStage::BeginLayer;
+            } else if (prior==NativeQueryRunnerStage::Projection) {
+                p.projection->finish(p.identity,p.layer);p.input.reset();
+                if (!p.prompt_input.retain_for_mtp) p.original_input.reset();
+                p.stage=NativeQueryRunnerStage::Restore;
+            } else if (prior==NativeQueryRunnerStage::Consumption) {
+                p.request.complete_layer(p.identity);p.finish_layer();
+            } else if (prior==NativeQueryRunnerStage::Gdn) p.finish_layer();
+            else if (prior==NativeQueryRunnerStage::FinalNorm) {
+                p.input.reset();p.original_input.reset();p.stage=NativeQueryRunnerStage::Complete;
+            }
+        }
+        return {prior,prior_layer,begin,n};
+    } catch (...) { abort(); throw; }
+}
+NativeQueryRunnerStage NativeLayerwiseQueryExecution::stage() const noexcept { return impl_->stage; }
+bool NativeLayerwiseQueryExecution::complete() const noexcept { return stage()==NativeQueryRunnerStage::Complete; }
+bool NativeLayerwiseQueryExecution::input_ready() const noexcept {
+    const auto& p=*impl_;return p.original_input && p.original_input->complete();
+}
+bool NativeLayerwiseQueryExecution::has_composed_input() const noexcept {return bool(impl_->prompt_input.prompt);}
+bool NativeLayerwiseQueryExecution::composed_input_matches(const kvmem::LayerwiseQueryIdentity& value,
+    const PreparedPromptData& prompt) const noexcept {
+    const auto& p=*impl_;const auto& own=p.identity;
+    return p.prompt_input.prompt==&prompt && own.history==value.history && own.request==value.request &&
+        own.evaluation.begin==value.evaluation.begin && own.evaluation.end==value.evaluation.end &&
+        own.query.begin==value.query.begin && own.query.end==value.query.end;
+}
+std::uint32_t NativeLayerwiseQueryExecution::input_tile_rows(std::uint64_t begin) const {
+    return impl_->tiles.at(impl_->ordinal(begin)).count;
+}
+void NativeLayerwiseQueryExecution::copy_composed_embeddings(std::uint64_t begin,std::uint32_t rows,Tensor destination) const {
+    impl_->copy_composed(begin,rows,destination);
+}
+Tensor NativeLayerwiseQueryExecution::composed_probe_embeddings(std::uint64_t begin,std::uint32_t rows) const {
+    auto& p=*impl_;
+    if (!input_ready() || p.stage!=NativeQueryRunnerStage::BeginLayer || p.layer!=0 ||
+        rows!=input_tile_rows(begin) || p.device.active_rank()!=0)
+        throw std::logic_error("private composed probe is outside the frozen input-only phase");
+    auto result=p.with_rows(p.ranks.front().capacity.residual,rows);
+    p.copy_composed(begin,rows,result);return result;
+}
+Tensor NativeLayerwiseQueryExecution::tail_hidden() const {
+    if (!complete()) throw std::logic_error("native Query final hidden is not complete");
+    return impl_->tail;
+}
+Tensor NativeLayerwiseQueryExecution::logits() const {
+    if (!complete()) throw std::logic_error("native Query target head is not complete");
+    return impl_->ranks.front().logits;
+}
+std::uint64_t NativeLayerwiseQueryExecution::activation_tape_peak_bytes() const noexcept { return impl_->tape_peak; }
+std::uint64_t NativeLayerwiseQueryExecution::staging_bytes() const noexcept { return impl_->pin_bytes; }
+std::uint64_t NativeLayerwiseQueryExecution::device_bytes() const noexcept { return impl_->gpu_bytes; }
+bool NativeLayerwiseQueryExecution::disk_tapes() const noexcept { return impl_->use_disk; }
+Tensor NativeLayerwiseQueryExecution::tensor_probe_query() const {
+    const auto& p=*impl_;
+    if (!p.tensor || !((p.stage==NativeQueryRunnerStage::Embedding && p.cursor==p.identity.evaluation.begin) ||
+        (p.stage==NativeQueryRunnerStage::BeginLayer && p.layer==0 && p.cursor==p.identity.evaluation.begin)))
+        throw std::logic_error("native tensor probe storage is unavailable after Query execution begins");
+    return p.ranks.front().capacity.query;
+}
+std::span<std::byte> NativeLayerwiseQueryExecution::tensor_probe_staging() const {
+    (void)tensor_probe_query();
+    auto& p=*impl_;
+    return {static_cast<std::byte*>(p.staging->data())+p.tensor_staging_offset,
+        addressable(p.pin_bytes-p.tensor_staging_offset)};
+}
+void NativeLayerwiseQueryExecution::abort() noexcept {
+    auto& p=*impl_;
+    if (p.stage==NativeQueryRunnerStage::Complete || p.stage==NativeQueryRunnerStage::Aborted) return;
+    try { p.device.synchronize(); } catch (...) {}
+    p.request.abort();p.input.reset();p.output.reset();p.original_input.reset();p.projection.reset();p.prepared.clear();
+    for (auto& rank:p.tensor_projection) {rank.tape.reset();rank.prepared.clear();}
+    p.stage=NativeQueryRunnerStage::Aborted;
+}
