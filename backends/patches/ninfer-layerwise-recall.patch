+        kvmem_options.layerwise_mtp_history==kvmem::LayerwiseMtpHistory::UpstreamGlobal);
+    const auto source_partition=kvmem_options.layerwise.metadata_bytes-2*(kvmem_options.layerwise.metadata_bytes/8);
