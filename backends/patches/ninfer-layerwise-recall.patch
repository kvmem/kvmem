+std::uint64_t admission_add(std::uint64_t a,std::uint64_t b) {
+    if (b>UINT64_MAX-a) throw std::length_error("native Waiting metadata sum overflows");
+    return a+b;
+}
+std::uint64_t admission_mul(std::uint64_t a,std::uint64_t b) {
+    if (b && a>UINT64_MAX/b) throw std::length_error("native Waiting metadata product overflows");
+    return a*b;
+}
+// Copy only public immutable graph state. This pricing snapshot intentionally
+// has no GraphStatisticsBudget lease and cannot publish into an execution lane.
+kvmem::GraphSnapshot admission_graph(const KvmemPrefixCheckpoint* source,
+    const PreparedPromptData& prompt,std::uint32_t capacity) {
+    kvmem::GraphSnapshot graph;
+    if (source) {
+        const auto& from=source->graph;
+        graph.accepted_through=from.accepted_through;graph.completed_through=from.completed_through;
+        graph.revision=from.revision;graph.epoch=from.epoch;graph.block_tokens=from.block_tokens;
+        graph.chunks=from.chunks;graph.partial=from.partial;
+    }
+    std::vector<kvmem::GraphMessageSpan> messages;
+    for (const auto& span:prompt.memory_messages) messages.push_back({span.begin,span.begin+span.count,true});
+    if (prompt.memory_input_end) messages.push_back({prompt.memory_input_end,capacity,false});
+    graph.set_messages(messages);
+    return graph;
+}
