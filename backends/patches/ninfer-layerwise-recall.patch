+            visible(std::uint64_t(frontier)+verify+1,cap.main),batch));
+        current.push_back(launch_shape(own,storage,verify+1,
+            visible(std::uint64_t(frontier)+verify+1,cap.own),batch));
+        for (std::uint32_t step=0;step+1<drafts;++step) current.push_back(launch_shape(own,storage,1,
+            visible(std::uint64_t(frontier)+verify+step+2,cap.own),batch));
+    };
+    const auto emit=[&](std::uint32_t begin,std::uint32_t end) {
+        const auto found=std::find(classes.begin(),classes.end(),previous);
+        const auto topology=static_cast<std::uint32_t>(found-classes.begin());
+        if (found==classes.end()) classes.push_back(previous);
+        result.push_back({begin,end,topology});
+    };
