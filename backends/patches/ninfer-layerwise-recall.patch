+void prepare_native_layerwise_fresh_statistics_admission(
+    NativeLayerwiseAdmission& admission,const KvmemWindowState* prospective,
+    std::uint32_t logical_capacity,std::uint32_t compact_capacity,
+    std::uint32_t attention_layers,std::uint32_t key_width) {
+    const auto& account=admission.account();
+    if (!account || !attention_layers || !key_width)
+        throw std::logic_error("native fresh statistics admission lacks its Program account/geometry");
+    if (prospective && prospective->statistics_metadata.account()) {
+        // Its first activation already paid the complete mutable ceiling. A
+        // restored map directory may be larger than the original empty one;
+        // do not recalculate a different ceiling and charge the history twice.
+        if (prospective->statistics_metadata.account()!=account ||
+            (prospective->source_versions && prospective->source_versions!=account) ||
+            admission.fresh_statistics_metadata.account() || admission.fresh_statistics_bound)
+            throw std::logic_error("native existing statistics admission changed account or retained a duplicate ticket");
+        return;
+    }
+    const auto maps=prospective?prospective->layer_views.target.size():0;
+    if (maps>UINT32_MAX)
+        throw std::logic_error("native fresh statistics has an invalid target map count");
+    std::uint64_t bytes=0;
+    const auto bound=[&](const kvmem::RawKvStore& statistics) {
+        if (statistics.config().n_embd_k!=key_width)
+            throw std::logic_error("native fresh statistics key width differs from its Program");
+        return native_layerwise_mutable_metadata_bound(logical_capacity,compact_capacity,
+            statistics,attention_layers,static_cast<std::uint32_t>(maps));
+    };
+    if (prospective && prospective->statistics) bytes=bound(*prospective->statistics);
+    else {
+        // Same exact mean-only config as prepare_memory_statistics; constructor
+        // creates no blocks, canonical payload or Native/GPU allocation.
+        kvmem::RawKvStore empty(kvmem::RawKvStoreConfig{
+            .n_layer=attention_layers,.n_embd_k=key_width,.block_tokens=64});
+        bytes=bound(empty);
+    }
+    if (admission.fresh_statistics_metadata.account()) {
+        if (admission.fresh_statistics_metadata.account()!=account ||
+            admission.fresh_statistics_metadata.bytes()!=bytes || admission.fresh_statistics_bound!=bytes)
+            throw std::logic_error("native fresh statistics Waiting ticket changed before publication");
+        return;
+    }
+    if (admission.fresh_statistics_bound)
+        throw std::logic_error("native fresh statistics Waiting ticket was already consumed");
+    NativeSourceVersionCharge reserved;
+    // Only the known finite-account refusal becomes an Overloaded admission.
+    // Invalid geometry/bounds above remain invariant errors, never cold misses.
+    try {reserved=account->reserve(bytes);}
+    catch (const std::length_error&) {
+        throw ContextCacheExhausted("native layerwise source metadata cannot admit its complete mutable history ceiling");
+    }
+    admission.fresh_statistics_metadata=std::move(reserved);
+    admission.fresh_statistics_bound=bytes;
+}
