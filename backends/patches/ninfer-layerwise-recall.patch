+    NativeSourceVersionCharge metadata_;
+    std::vector<execution::LayerwiseGraphAttentionSlot> slots_;
+    execution::LayerwiseGraphCaptureView view_;
+    std::unique_ptr<PinnedHostBuffer> staging_;
+    NativeGraphOutputFrame frame_;
+    std::vector<CudaCompletionEvent> epoch_ready_;
+    const DecodeGraphProfile* profile_=nullptr;
+    std::uint32_t profile_min_=0,profile_max_=0,profile_class_=0;
+};
