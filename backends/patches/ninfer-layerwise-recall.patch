+using namespace ninfer;
+using namespace ninfer::models::qwen3_5::detail;
+namespace {
+void check(bool ok,const char* message) {if (!ok) throw std::runtime_error(message);}
+template<class F> void rejected(F f) {bool did=false;try {f();}catch (const std::exception&) {did=true;}check(did,"invalid engineering resource/owner was accepted");}
+std::vector<std::uint8_t> identity(const NativeLayerwiseFeedbackSnapshot& s) {
+    std::vector<std::uint8_t> bytes;s.append_identity(bytes);return bytes;
+}
+void entitlements_and_snapshots() {
+    kvmem::LayerwiseRequestEnvelope envelope;
+    envelope.prompt_end=1024;envelope.output_tokens=128;envelope.block_tokens=64;
+    envelope.generation_tokens=128;
+    kvmem::LayerwisePrefillOptions pf;
+    pf.block_tokens=64;pf.select_tokens=256;pf.reserve_tokens=128;pf.stride=1;
+    const auto plan=plan_native_feedback_workspace(envelope,2048,8,2,64,pf,1024);
+    check(plan.workspace_bytes && plan.snapshot_bytes && plan.query_extra_bytes,"full-envelope entitlement was empty");
+    const auto control_bytes=native_output_fixed_metadata_bytes;
+    auto parent=std::make_shared<NativeSourceVersionAccount>(8*plan.workspace_bytes+plan.query_extra_bytes+control_bytes);
+    auto query_pool=parent->reserve(plan.query_extra_bytes+control_bytes);
+    std::array<std::shared_ptr<NativeSourceVersionAccount>,kMaximumConcurrency> active;
+    for (auto& account:active) account=reserve_native_feedback_workspace(parent,plan.workspace_bytes,
+        plan.workspace_bytes+plan.query_extra_bytes);
+    check(parent->charged_bytes()==parent->limit(),"active entitlements did not protect the fixed shared quota");
+    rejected([&] {reserve_native_feedback_workspace(parent,1);});
+    const auto before=parent->charged_bytes();
+    rejected([&] {reserve_native_feedback_workspace(parent,100,99);});
+    check(parent->charged_bytes()==before,"rejected admission changed existing entitlements");
+    auto live=std::make_shared<NativeLayerwiseFeedbackSnapshot>();
+    live->options=pf;live->prefill.session={7,3};
+    live->prefill.layers={{2,{{0,7.25,9},{64,.125,3}},128,17,4},{7,{{64,1,2}},128,17,4}};
+    live->output.emplace();live->output->session={7,3};live->output->request=81;
+    live->output->accepted_end=128;live->output->active=true;live->output->parser={true,true,29};
+    live->output->layers={{2,{{0,3.25}},{{64,.75}},5,9},{7,{{64,2}},{{0,.25}},5,9}};
+    live->markers={11,12,13,14,15};live->original_query=KvmemQuerySpan{64,128};
+    live->metadata=active[0]->reserve(live->allocated_bytes());
+    const auto bytes=identity(*live);
+    auto source=std::make_shared<NativeSourceVersionAccount>(4*plan.snapshot_bytes);
+    auto cp=live->funded_copy(source->reserve(plan.snapshot_bytes));
+    check(identity(*cp)==bytes && cp->metadata.account()==source,"CP funding changed accepted S/M/N/parser/Query values");
+    active[0].reset();
+    check(parent->charged_bytes()==before,"an exported active snapshot lost its parent funding");
+    live.reset();
+    check(parent->charged_bytes()==before-plan.workspace_bytes,"CP pinned the reusable active entitlement");
+    check(identity(*cp)==bytes,"active-owner deletion changed immutable accepted feedback");
+    const auto source_before=source->charged_bytes();
+    bool budget=false;
+    try {(void)reserve_native_source_feedback(source,source->limit());}
+    catch (const kvmem::MemoryError& error) {budget=error.code()==kvmem::MemoryErrorCode::BudgetExceeded;}
+    check(budget && source->charged_bytes()==source_before,"CP quota refusal lost its typed status or changed accepted funding");
+    rejected([&] {cp->funded_copy(source->reserve(1));});
+    check(source->charged_bytes()==source_before && identity(*cp)==bytes,"failed CP publication damaged an old CP");
+    auto fork=cp->fork({9,1});
+    check(fork->prefill.session==kvmem::SessionIdentity{9,1} && fork->output->session==kvmem::SessionIdentity{9,1} &&
+        fork->output->layers[0].samples==5 && fork->output->parser.tokens==29,"fork lost its own accepted clocks/parser");
+    cp.reset();fork.reset();check(source->charged_bytes()==0,"immutable feedback sources leaked their independent funding");
+    for (auto& account:active) account.reset();
+    check(parent->charged_bytes()==plan.query_extra_bytes+control_bytes,"retired owners retained active feedback credits");
+    query_pool={};check(parent->charged_bytes()==0,"Program Query pool did not release");
+    rejected([&] {auto e=envelope;e.prompt_end=UINT64_MAX;(void)plan_native_feedback_workspace(e,2048,8,2,64,pf,1024);});
+    rejected([&] {(void)feedback_mul(UINT64_MAX,2);});
+}
+void row_routing_and_lease() {
+    const auto output_ranges=native_output_candidate_ranges(512);
+    static_assert(sizeof(output_ranges)==16);
+    // Deferred readers borrow the actual same const object while independent
+    // PF controls change between producers. No equal-value rewrite is used.
+    std::array<const std::int32_t*,8> pending{};
+    std::array<std::int32_t,4> mutable_prefill{};
+    for (std::uint32_t owner=0;owner<pending.size();++owner) {
+        pending[owner]=output_ranges.data();mutable_prefill={0,static_cast<std::int32_t>(64+owner),128,192};
+    }
+    for (const auto* source:pending)
+        check(source[0]==0 && source[1]==512 && source[2]==0 && source[3]==0,
+            "Output upload source borrowed another phase's mutable controls");
+    check(mutable_prefill[1]==71,"control isolation fixture did not modify the other phase");
+    rejected([] {(void)native_output_candidate_ranges(0);});
+    rejected([] {(void)native_output_candidate_ranges(std::uint64_t(INT32_MAX)+1);});
+
+    NativeLayerwiseQueryWorkSlot slot;
+    rejected([&] {slot.acquire({0,0,1});});
+    rejected([&] {slot.acquire({kMaximumConcurrency,1,1});});
+    const NativeQueryWorkIdentity a{5,8,100},b{2,4,200},recycled{5,9,100};
+    check(slot.acquire(a) && !slot.acquire(b) && slot.owns(a),"two owners acquired one full Query resource slot");
+    rejected([&] {slot.release(recycled);});check(slot.owns(a),"stale generation released live Query resources");
+    slot.release(a);check(slot.acquire(b),"completed Query did not admit a waiting owner");slot.release(b);
+    std::array<NativeLayerwiseBatchRow,3> rows{};
+    for (std::uint32_t r=0;r<rows.size();++r) {
+        rows[r].lane=std::array<std::uint32_t,3>{5,1,7}[r];rows[r].lane_epoch=10+r;
+        rows[r].request_id=100+r;rows[r].logical_begin=128+r;rows[r].local_begin=64+r;
+        rows[r].valid_rows=r+1;rows[r].table_row=4+r;rows[r].source.session={7+r,1};
+    }
+    for (const auto width:{1U,2U,16U,64U}) for (std::uint32_t batch=1;batch<=kMaximumConcurrency;++batch) {
+        std::vector<std::uint32_t> flattened(width*batch);
+        for (std::uint32_t row=0;row<batch;++row) for (std::uint32_t i=0;i<width;++i) flattened[row*width+i]=1000*row+i;
+        for (std::uint32_t row=0;row<batch;++row) {
+            const auto range=native_output_row_range(width,batch,row);
+            for (std::uint32_t i=0;i<range.count;++i)
+                check(flattened.at(range.begin+i)==1000*row+i,"native physical row was routed to a different lane");
+        }
+    }
+    check(native_output_binding_matches(rows[0],rows[0]) && !native_output_binding_matches(rows[0],rows[1]),"distinct source identities aliased");
+    auto changed=rows[0];++changed.valid_rows;check(!native_output_binding_matches(rows[0],changed),"wrong accepted prefix was retained");
+    changed=rows[0];++changed.source.history_revision;check(!native_output_binding_matches(rows[0],changed),"stale source revision was retained");
+    changed=rows[0];++changed.lane_epoch;check(!native_output_binding_matches(rows[0],changed),"recycled lane was retained");
+    rejected([] {(void)native_output_row_range(16,2,2);});
+}
+void copy_packing_and_control() {
+    for (std::uint32_t neural=1;neural<=15;++neural) for (std::uint32_t copy=1;copy<=63;++copy)
+    for (const auto batch:{1U,2U,8U}) {
+        if (batch>1 && copy>15) {rejected([&] {(void)plan_native_dflash_copy(neural,copy,batch,8,16);});continue;}
+        const auto p=plan_native_dflash_copy(neural,copy,batch,8,16);
+        check(p.noise_drafts==(batch==1?0U:std::max(neural,copy)),"copy altered Native physical noise width");
+        check(p.target_drafts==copy && p.pack_leading_prefix==(batch>1 && neural>copy),"copy target width or packing mode changed");
+        if (!p.pack_leading_prefix) continue;
+        for (const std::uint32_t slots:{1U,16U}) {
+            std::vector<std::uint32_t> src(neural*batch*slots),dst(copy*batch*slots,UINT32_MAX);
+            for (std::uint32_t row=0;row<batch;++row) for (std::uint32_t i=0;i<neural;++i) for (std::uint32_t s=0;s<slots;++s)
+                src[(row*neural+i)*slots+s]=row*100000+i*100+s;
+            const auto sp=slots==1?p.source_pitch:p.sparse_source_pitch,tp=slots==1?p.target_pitch:p.sparse_target_pitch;
+            for (std::uint32_t row=0;row<batch;++row)
+                std::memcpy(reinterpret_cast<std::byte*>(dst.data())+row*tp,
+                    reinterpret_cast<const std::byte*>(src.data())+row*sp,tp);
+            for (std::uint32_t row=0;row<batch;++row) for (std::uint32_t i=0;i<copy;++i) for (std::uint32_t s=0;s<slots;++s)
+                check(dst[(row*copy+i)*slots+s]==row*100000+i*100+s,"DF2 leading sparse law crossed a row or candidate boundary");
+        }
+    }
+    for (auto backend:{SpeculativeBackend::None,SpeculativeBackend::Mtp,SpeculativeBackend::DFlash2}) {
+        const auto p=plan_native_output_control(256,255,255,1,backend);
+        check(p.main_end==256 && !p.noise_rows && (backend!=SpeculativeBackend::Mtp || p.auxiliary_end==256),
+            "forced control ran neural AR/noise or consumed padded target rows");
+    }
+    rejected([] {(void)plan_native_output_control(256,255,255,2,SpeculativeBackend::Mtp);});
+}
+}
+int main() {try {entitlements_and_snapshots();row_routing_and_lease();copy_packing_and_control();
+    std::cout<<"multiowner engineering resources/routing/copy/control CPU reference passed\n";return 0;
+}catch(const std::exception& e){std::cerr<<e.what()<<'\n';return 1;}}
