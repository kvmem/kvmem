+bool same_options(const kvmem::LayerwisePrefillOptions& a,const kvmem::LayerwisePrefillOptions& b) {
+    return a.block_tokens==b.block_tokens && a.select_tokens==b.select_tokens &&
+        a.reserve_tokens==b.reserve_tokens && a.interval==b.interval && a.stride==b.stride && a.half_life==b.half_life;
