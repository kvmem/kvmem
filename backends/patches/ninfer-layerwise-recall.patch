+std::uint64_t native_layerwise_mutable_metadata_bound(
+    std::uint32_t logical_capacity,std::uint32_t compact_capacity,
+    const kvmem::RawKvStore& statistics,std::uint32_t attention_layers,
+    std::uint32_t existing_target_maps) {
+    const auto& cfg=statistics.config();
+    if (!logical_capacity || !compact_capacity || compact_capacity>logical_capacity ||
+        !attention_layers || cfg.n_layer!=attention_layers || !cfg.n_embd_k ||
+        cfg.block_tokens!=64 || existing_target_maps>attention_layers)
+        throw std::logic_error("native mutable statistics admission has inconsistent geometry");
+    const auto blocks=(std::uint64_t(logical_capacity)+63)/64;
+    const auto compact_blocks=(std::uint64_t(compact_capacity)+63)/64;
+    const auto directories=checked_product(2*blocks,sizeof(kvmem::HostKvRecord)+
+        sizeof(std::uint64_t)+sizeof(kvmem::KvMemBlock)+2*sizeof(std::uint64_t));
+    const auto maps=checked_product(checked_sum(existing_target_maps,attention_layers),
+        checked_sum(64,checked_product(2*compact_blocks,sizeof(std::uint32_t))));
+    return checked_sum(checked_sum(sizeof(KvmemWindowState),statistics.capacity_bytes(logical_capacity)),
+        checked_sum(directories,maps));
