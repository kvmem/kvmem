+
+void TextContext::require_stable_query_tensor(const Tensor& tensor, const char* name) const {
+    if (tensor.data == nullptr || !tensor.is_contiguous() ||
+        query_storage_overlaps(tensor.data,tensor.bytes(),work_.base(),work_.capacity()))
+        throw std::invalid_argument(std::string(name)+" requires stable storage outside execution workspace");
+}
+
+void TextContext::query_embed(const Tensor& ids, Tensor& residual) {
+    require_layer_major_query(true);
+    const auto tokens=ids.ne[0];
+    if (tokens<=0) throw std::invalid_argument("Query embedding requires nonempty rows");
+    require_tensor_shape(ids,DType::I32,{tokens},"Query token IDs");
+    require_tensor_shape(residual,DType::BF16,{dimension(config_.hidden_size),tokens},"Query residual");
+    require_stable_query_tensor(ids,"Query token IDs");
+    require_stable_query_tensor(residual,"Query residual");
+    if (query_storage_overlaps(ids.data,ids.bytes(),residual.data,residual.bytes()))
+        throw std::invalid_argument("Query embedding aliases token IDs");
+    auto scope=work_.scope();
+    embed_tokens(ids,*embed_,parameters_.text.token_embedding_signs,residual,ctx_.stream);
+}
+
+void TextContext::query_embed_multimodal(const Tensor& ids,Tensor& residual,
+    const qwen3_5::PreparedPromptData& prompt,VisionPrefillSession& vision,std::uint32_t begin) {
+    const auto n=static_cast<std::uint32_t>(ids.ne[0]);
+    if (begin>prompt.token_ids.size() || n>prompt.token_ids.size()-begin ||
+        vision.planned_chunk_length(begin,n)!=n)
+        throw std::invalid_argument("Query composed input differs from the native Vision tile plan");
+    const auto visual=vision.prepare_chunk(begin,n);
+    if (visual.length!=ids.ne[0]) throw std::logic_error("Vision changed an admitted Query tile");
+    query_embed(ids,residual);
+    if (!visual.control) return;
+    const auto& scatter=visual.control->scatter_indices;
+    const auto first=std::lower_bound(scatter.begin(),scatter.end(),static_cast<std::int32_t>(begin));
+    const auto last=std::lower_bound(first,scatter.end(),static_cast<std::int32_t>(begin+n));
+    const auto count=static_cast<std::int32_t>(last-first);
+    if (!count) return;
+    auto scope=work_.scope();
+    std::vector<std::int32_t> local(static_cast<std::size_t>(count));
+    for (std::int32_t i=0;i<count;++i) local[i]=first[i]-static_cast<std::int32_t>(begin);
+    auto indices=work_.alloc(DType::I32,{count});copy_i32(local.data(),indices,ctx_.stream);
+    const auto column=static_cast<std::int32_t>(first-scatter.begin());
+    Tensor embeddings;
+    if (!visual.host_embeddings.empty()) {
+        embeddings=work_.alloc(DType::BF16,{dimension(config_.hidden_size),count});
+        const auto offset=std::size_t(column)*std::size_t(config_.hidden_size)*2;
+        if (offset>visual.host_embeddings.size() || embeddings.bytes()>visual.host_embeddings.size()-offset)
+            throw std::logic_error("Query visual columns exceed the native host handoff");
+        CUDA_CHECK(cudaMemcpyAsync(embeddings.data,visual.host_embeddings.data()+offset,
+            embeddings.bytes(),cudaMemcpyHostToDevice,ctx_.stream));
+    } else embeddings=visual.embeddings.slice(1,column,count);
+    ops::scatter(embeddings,indices,residual,ctx_.stream);
+    CUDA_CHECK(cudaStreamSynchronize(ctx_.stream));
+}
+
+void TextContext::query_statistics(const Tensor& ids, std::uint32_t logical_begin) {
+    require_layer_major_query();
+    if (ctx_.active_rank()!=0)
+        throw std::logic_error("a later Query stage requires an explicit rank-local statistics origin");
+    if (statistics_ != nullptr) {
+        query_statistics(ids,logical_begin,statistics_->ranks.front().prefill_origin);
+        return;
+    }
+    const auto tokens=ids.ne[0];
+    if (tokens<=0 || logical_begin>std::uint32_t(INT32_MAX)-std::uint32_t(tokens))
+        throw std::invalid_argument("Query statistics logical row range exceeds int32");
+    require_tensor_shape(ids,DType::I32,{tokens},"Query statistics token IDs");
+    require_stable_query_tensor(ids,"Query statistics token IDs");
+}
+
+void TextContext::query_statistics(const Tensor& ids, std::uint32_t logical_begin,
+    const Tensor& rank_origin) {
+    require_layer_major_query();
+    const auto tokens=ids.ne[0];
+    if (tokens<=0 || logical_begin>std::uint32_t(INT32_MAX)-std::uint32_t(tokens))
+        throw std::invalid_argument("Query statistics logical row range exceeds int32");
+    require_tensor_shape(ids,DType::I32,{tokens},"Query statistics token IDs");
+    require_stable_query_tensor(ids,"Query statistics token IDs");
+    require_tensor_shape(rank_origin,DType::I32,{1},"Query rank-local statistics origin");
+    require_stable_query_tensor(rank_origin,"Query rank-local statistics origin");
+    // Consumed-token storage and parser ownership stay on the head rank.
+    if (ctx_.active_rank()==0) capture_attention_tokens(ids);
+    if (statistics_ != nullptr) {
+        active_memory_prefill_origin_=&rank_origin;
+        auto origin=rank_origin;
+        ops::set_i32_scalar(origin,static_cast<std::int32_t>(logical_begin),ctx_.stream);
+    }
+}
+
+void TextContext::query_gdn_mixer(std::uint32_t layer, Tensor& residual) {
+    require_query_layer_owner(layer);
+    if (layer>=config_.layer_types.size() || config_.layer_types[layer]!=MixerKind::LinearAttention)
+        throw std::invalid_argument("Query GDN mixer layer is not a native GDN layer");
+    const auto tokens=residual.ne[1];
+    if (tokens<=0) throw std::invalid_argument("Query GDN mixer requires nonempty rows");
+    require_tensor_shape(residual,DType::BF16,{dimension(config_.hidden_size),tokens},"Query GDN residual");
+    require_stable_query_tensor(residual,"Query GDN residual");
+    validate_query_partial(residual);
+    if (layer<layer_ready_.size()) CUDA_CHECK(cudaStreamWaitEvent(ctx_.stream,layer_ready_[layer],0));
+    auto scope=work_.scope();
+    gdn_mix(query_block(layer),residual,dimension(config_.compact_layer_indices[layer]),Phase::Prefill);
+}
+
+void TextContext::query_post_mixer(std::uint32_t layer, Tensor& residual) {
+    require_query_layer_owner(layer);
+    if (layer>=config_.layer_types.size()) throw std::invalid_argument("Query post-mixer layer is outside the model");
+    const auto tokens=residual.ne[1];
+    if (tokens<=0) throw std::invalid_argument("Query post-mixer requires nonempty rows");
+    require_tensor_shape(residual,DType::BF16,{dimension(config_.hidden_size),tokens},"Query post-mixer residual");
+    require_stable_query_tensor(residual,"Query post-mixer residual");
+    validate_query_partial(residual);
+    auto scope=work_.scope();
+    // The next operation is another chunk of this layer, not necessarily the
+    // next layer's projection. No cross-layer prefetch hint is appropriate.
+    mlp_tail(query_block(layer),residual,Phase::Prefill,ops::SparseMoeHints{});
+}
+
+void TextContext::query_final_norm(const Tensor& residual, Tensor& hidden) {
+    require_layer_major_query(true);
+    const auto tokens=residual.ne[1];
+    if (tokens<=0) throw std::invalid_argument("Query final norm requires nonempty rows");
+    require_tensor_shape(residual,DType::BF16,{dimension(config_.hidden_size),tokens},"Query final residual");
+    require_tensor_shape(hidden,DType::BF16,{dimension(config_.hidden_size),tokens},"Query final hidden");
+    require_stable_query_tensor(residual,"Query final residual");
+    require_stable_query_tensor(hidden,"Query final hidden");
+    if (query_storage_overlaps(residual.data,residual.bytes(),hidden.data,hidden.bytes()))
+        throw std::invalid_argument("Query final norm needs a distinct output plane");
+    ops::rmsnorm(residual,*final_norm_,config_.rms_norm_eps,true,hidden,ctx_.stream);
+}
+
+void TextContext::query_head(const Tensor& hidden, Tensor& logits) {
+    require_layer_major_query(true);
+    const auto tokens=hidden.ne[1];
+    if (tokens<=0) throw std::invalid_argument("Query head requires nonempty rows");
+    require_tensor_shape(hidden,DType::BF16,{dimension(config_.hidden_size),tokens},"Query head hidden");
+    require_tensor_shape(logits,target_logits_dtype(*lm_head_),{dimension(config_.vocab_size),tokens},"Query logits");
+    require_stable_query_tensor(hidden,"Query head hidden");
