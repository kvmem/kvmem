+#pragma once
+
+#include "ninfer/layerwise_request.h"
+#include "models/qwen3_5/frontend/prepared_prompt.h"
+#include <memory>
+
+namespace ninfer::models::qwen3_5::detail {
+
+// Owned by PreparedPromptData. Binding occurs before materialization, while
+// the accepted source and its exact prefix proof are still immutable.
+struct LayerwisePromptPolicy {
+    KvmemRequestPolicy request;
+    std::optional<KvmemQuerySpan> original_query;
+    std::optional<KvmemQuerySpan> effective_query;
+    bool bound = false;
+    bool keep_selected = false;
+    bool exact_source = false;
+    bool previous_query_match = false;
+    std::uint64_t source_history = 0, source_visible = 0;
+};
+
+inline KvmemReselect layerwise_reselect(const PreparedPromptData& prompt) noexcept {
+    return prompt.layerwise_policy ? prompt.layerwise_policy->request.reselect : KvmemReselect::Auto;
+}
+
+inline std::optional<KvmemQuerySpan> layerwise_original_query(const PreparedPromptData& prompt) {
+    const auto* policy = prompt.layerwise_policy.get();
+    if (policy && policy->bound) return policy->original_query;
+    const auto mode = layerwise_reselect(prompt);
+    if (mode != KvmemReselect::Auto && mode != KvmemReselect::Force && mode != KvmemReselect::Off)
+        throw std::invalid_argument("invalid typed kvmem.reselect policy");
+    if (mode == KvmemReselect::Off) {
+        if (policy && policy->request.query)
+            throw std::invalid_argument("kvmem.reselect=off forbids an explicit Query span");
+        return {};
+    }
+    std::optional<KvmemQuerySpan> query;
+    if (policy && policy->request.query) query = policy->request.query;
+    else if (prompt.memory_query && prompt.memory_query->count &&
+             (mode == KvmemReselect::Force || !prompt.memory_query_inferred || prompt.memory_query_has_history))
+        query = KvmemQuerySpan{prompt.memory_query->begin, prompt.memory_query->begin + prompt.memory_query->count};
+    if (query && (query->begin >= query->end || query->end > prompt.token_ids.size()))
+        throw std::invalid_argument("complete layerwise Query is outside its native prompt");
+    if (mode == KvmemReselect::Force && !query)
+        throw std::invalid_argument("kvmem.reselect=force requires a current trusted Query span");
+    return query;
+}
+
+inline std::optional<KvmemQuerySpan> layerwise_effective_query(const PreparedPromptData& prompt) {
+    if (prompt.layerwise_policy && prompt.layerwise_policy->bound)
+        return prompt.layerwise_policy->effective_query;
+    return layerwise_original_query(prompt);
+}
+
+inline std::optional<KvmemQuerySpan> layerwise_query_at_source(const PreparedPromptData& prompt,
+    std::optional<KvmemQuerySpan> previous_query, std::uint64_t history, bool exact_native_prefix) {
+    const auto query = layerwise_original_query(prompt);
+    if (layerwise_reselect(prompt) == KvmemReselect::Auto && query && previous_query == query &&
+        query->end <= history && exact_native_prefix) return {};
+    return query;
+}
+
+// Directory filtering only. A possible match still needs complete native
+// coverage and the full token/media/position prefix check before binding.
+inline bool layerwise_query_may_continue(const PreparedPromptData& prompt,
+    std::optional<KvmemQuerySpan> previous_query, std::uint64_t history) {
+    const auto query = layerwise_original_query(prompt);
+    return layerwise_reselect(prompt) == KvmemReselect::Auto && query &&
+        previous_query == query && query->end <= history;
+}
+
+inline LayerwisePromptPolicy finalize_layerwise_query_source(const PreparedPromptData& prompt,
+    std::optional<KvmemQuerySpan> previous_query, std::uint64_t history, std::uint64_t visible,
+    bool exact_native_prefix, std::uint64_t capacity, std::uint64_t block_tokens, std::uint64_t output_tokens) {
+    const auto original = layerwise_original_query(prompt);
+    const auto effective = layerwise_query_at_source(prompt, previous_query, history, exact_native_prefix);
+    if (!block_tokens || capacity < block_tokens || history > prompt.token_ids.size() || visible > history)
+        throw std::logic_error("invalid actual layerwise continuation prefix");
+    const auto remaining = prompt.token_ids.size() - history;
+    const auto limit = capacity - block_tokens;
+    const bool fits = visible <= limit && remaining <= limit - visible &&
+        output_tokens <= limit - visible - remaining;
+    const bool keep = exact_native_prefix && history && !effective && fits;
+    LayerwisePromptPolicy policy;
+    if (prompt.layerwise_policy) policy.request = prompt.layerwise_policy->request;
+    policy.original_query = original;policy.effective_query = effective;policy.bound = true;
+    policy.keep_selected = keep;policy.exact_source = exact_native_prefix;
+    policy.previous_query_match = original && previous_query == original;
+    policy.source_history = history;policy.source_visible = visible;
+    return policy;
+}
+
+inline void bind_layerwise_query_source(PreparedPromptData& prompt, LayerwisePromptPolicy policy) {
+    if (!policy.bound || policy.original_query != layerwise_original_query(prompt))
+        throw std::logic_error("native source policy differs from the original Query identity");
+    prompt.layerwise_policy = std::make_shared<const LayerwisePromptPolicy>(std::move(policy));
+}
+
+inline TokenSpan layerwise_token_span(std::optional<KvmemQuerySpan> query) {
+    if (!query) return {};
+    return {query->begin, query->end - query->begin};
+}
+
+} // namespace ninfer::models::qwen3_5::detail
