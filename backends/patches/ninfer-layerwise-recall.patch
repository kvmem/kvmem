+
+enum class NativeQueryRunnerStage {
+    Embedding, BeginLayer, Projection, Restore, Consumption, Gdn, FinalNorm, Complete, Aborted
+};
+struct NativeQueryRunnerStep {
+    NativeQueryRunnerStage stage;
+    std::uint32_t model_layer;
+    std::uint64_t begin;
+    std::uint32_t rows;
+};
+
+// Finite native Qwen3.5 execution, owned by Program. This initial execution
+// owner uses original native positions (scalar text or complete three-axis
+// prepared input) and an exactly restored, media-safe aligned prefix. It is not an advertised backend capability. The owning Program must
+// supply complete immutable canonical history, a frozen Mean-K prefix and an
+// exact native rollback checkpoint before constructing it.
+//
+// Each advance completes at most one native chunk (or one restore boundary),
+// so no execution-workspace pointer survives a yield. The request transaction
+// is not accepted here: the owner still completes auxiliary models, final
+// Pressure and native publication, or drains and restores/invalidates on error.
+// public_input must come from the same immutable owning PreparedPromptData for
+// every advance; the Program validates that prompt/request identity. A matching
+// extent alone does not prove token content or authorize a different prompt.
+class NativeLayerwiseQueryExecution {
+public:
+    NativeLayerwiseQueryExecution(execution::PrefillContext&, kvmem::LayerwiseQueryRequest&,
+        NativeQueryActivationLimits, NativeQueryRunnerBindings, std::int32_t rope_delta = 0);
+    NativeLayerwiseQueryExecution(execution::PrefillContext&, kvmem::LayerwiseQueryRequest&,
+        NativeQueryActivationLimits, NativeQueryRunnerBindings, std::int32_t rope_delta,
+        NativeQueryPromptInput);
+    ~NativeLayerwiseQueryExecution();
+    NativeLayerwiseQueryExecution(const NativeLayerwiseQueryExecution&) = delete;
+    NativeLayerwiseQueryExecution& operator=(const NativeLayerwiseQueryExecution&) = delete;
+    NativeQueryRunnerStep advance(execution::PrefillContext&, std::span<const TokenId> public_input);
+    NativeQueryRunnerStage stage() const noexcept;
+    bool complete() const noexcept;
+    bool input_ready() const noexcept;
+    bool has_composed_input() const noexcept;
+    bool composed_input_matches(const kvmem::LayerwiseQueryIdentity&,const PreparedPromptData&) const noexcept;
+    std::uint32_t input_tile_rows(std::uint64_t begin) const;
+    // Copies a bounded range from the sealed original composed embedding
+    // source into stable rank-0 storage and fences that source consumption.
+    // No original source is retained by the text-only execution.
+    void copy_composed_embeddings(std::uint64_t begin,std::uint32_t rows,Tensor destination) const;
+    Tensor composed_probe_embeddings(std::uint64_t begin,std::uint32_t rows) const;
+    Tensor tail_hidden() const;
+    Tensor logits() const;
+    std::uint64_t activation_tape_peak_bytes() const noexcept;
+    std::uint64_t staging_bytes() const noexcept;
+    std::uint64_t device_bytes() const noexcept;
+    bool disk_tapes() const noexcept;
+    // Exclusive pre-forward scratch for the private target-only TP probe.
+    // The Program must finish/rollback it before any target layer executes.
+    // MM first seals its input-only Embedding phase; text can borrow directly.
+    // These borrow already admitted rank-0 device/pinned storage; no second
+    // transfer buffer or activation-account reservation is allocated.
+    Tensor tensor_probe_query() const;
+    std::span<std::byte> tensor_probe_staging() const;
+    void abort() noexcept;
+private:
+    struct Impl;
+    std::unique_ptr<Impl> impl_;
+};
