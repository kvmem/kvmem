+const BlockParameters& TextContext::query_attention_parameters(const CurrentLayerQueryIdentity& identity) const {
+    if (identity.rank != ctx_.active_rank() || identity.model_layer >= config_.layer_types.size() ||
+        config_.layer_types[identity.model_layer] != MixerKind::FullAttention ||
+        config_.compact_layer_indices[identity.model_layer] != identity.attention_layer)
+        throw std::invalid_argument("prepared Query model layer, attention ordinal or rank differs");
+    const bool tp = stage_runtime_ != nullptr && stage_runtime_->tensor_parallel.has_value();
+    if (tp && tensor_rank_ != identity.rank)
+        throw std::invalid_argument("prepared Query tensor rank is not bound to its native shard");
+    if (!tp && (identity.rank >= parameters_.text.stage_begin.size() ||
+        identity.model_layer < parameters_.text.stage_begin[identity.rank] ||
+        identity.model_layer >= parameters_.text.stage_end(identity.rank)))
+        throw std::invalid_argument("prepared Query model layer is owned by another pipeline stage");
+    return tp && identity.rank != 0
+        ? parameters_.text.rank_layers.at(identity.rank - 1).at(identity.model_layer)
+        : parameters_.text.layers.at(identity.model_layer);
