new file mode 100644
index 0000000000000000000000000000000000000000..942043f4f071d04baf415eed053a1b45e67193d2
--- /dev/null
+++ b/src/models/qwen3_5/program/native_output_physical.h
@@ -0,0 +1,73 @@
+#pragma once
+
+#include "core/paged_kv_cache.h"
+#include "ninfer/model_enums.h"
+
+#include <cstdint>
+#include <limits>
+#include <stdexcept>
+
+namespace ninfer::models::qwen3_5::detail {
+
+// Temporary proposal storage is not an accepted history/selection budget.
+// Main stores only valid verifier columns. MTP's future AR rows have their
+// own fixed scratch block; DF2's full noise block uses its native round arena
+// and independent sliding ring instead of consuming Main window credit.
+struct NativeOutputPhysicalPlan {
+    std::uint32_t valid_rows = 0;
+    std::uint32_t physical_target_rows = 0;
+    std::uint32_t main_begin = 0, main_end = 0;
+    std::uint32_t auxiliary_begin = 0, auxiliary_end = 0;
+    std::uint32_t noise_rows = 0;
+};
+
+inline NativeOutputPhysicalPlan plan_native_output_control(std::uint32_t capacity,
+    std::uint32_t main,std::uint32_t auxiliary,std::uint32_t rows,SpeculativeBackend backend) {
+    const auto block=static_cast<std::uint32_t>(kPagedKVPageSize);
+    if (!capacity || capacity%block || main>capacity || !rows || rows>block || rows>capacity-main)
+        throw std::length_error("forced control exceeds its literal accepted Main credit");
+    NativeOutputPhysicalPlan out{rows,rows,main,main+rows};
+    if (backend==SpeculativeBackend::Mtp) {
+        if (auxiliary>capacity || rows>capacity-auxiliary)
+            throw std::length_error("forced control exceeds its teacher-forced MTP prefix");
+        out.auxiliary_begin=auxiliary;out.auxiliary_end=auxiliary+rows;
+    } else if (backend!=SpeculativeBackend::None && backend!=SpeculativeBackend::DFlash2)
+        throw std::invalid_argument("forced control has no native auxiliary contract");
+    // No neural proposal/noise is executed in the original control Prefill.
+    return out;
+}
+
+inline NativeOutputPhysicalPlan plan_native_output_physical(
+    std::uint32_t main_capacity, std::uint32_t main_visible,
+    std::uint32_t auxiliary_visible, std::uint32_t valid_rows,
+    std::uint32_t physical_target_rows, SpeculativeBackend backend,
+    std::uint32_t draft_rows) {
+    constexpr auto block = static_cast<std::uint32_t>(kPagedKVPageSize);
+    if (!main_capacity || main_capacity % block || main_visible > main_capacity ||
+        !valid_rows || valid_rows > block || physical_target_rows < valid_rows ||
+        physical_target_rows > block || valid_rows > main_capacity - main_visible) {
+        throw std::length_error("native verifier valid rows exceed their accepted Main window credit");
+    }
+    NativeOutputPhysicalPlan out{valid_rows, physical_target_rows,
+        main_visible, main_visible + valid_rows};
+    if (backend == SpeculativeBackend::Mtp) {
+        if (!draft_rows || draft_rows > 15 || auxiliary_visible > main_capacity ||
+            main_capacity > std::numeric_limits<std::uint32_t>::max() - block) {
+            throw std::invalid_argument("native MTP auxiliary scratch geometry is invalid");
+        }
+        const auto rows = valid_rows + draft_rows - 1;
+        if (rows > main_capacity + block - auxiliary_visible)
+            throw std::length_error("native MTP writes exceed its independent auxiliary scratch block");
+        out.auxiliary_begin = auxiliary_visible;
+        out.auxiliary_end = auxiliary_visible + rows;
+    } else if (backend == SpeculativeBackend::DFlash2) {
+        if (!draft_rows || draft_rows > 15)
+            throw std::invalid_argument("native DFlash2 noise geometry is invalid");
+        out.noise_rows = draft_rows + 1;
+    } else if (backend != SpeculativeBackend::None || draft_rows || physical_target_rows != 1 || valid_rows != 1) {
+        throw std::invalid_argument("native ordinary output has speculative physical storage");
+    }
+    return out;
+}
+
+} // namespace ninfer::models::qwen3_5::detail
