+        auto saved=std::make_shared<NativeLayerwiseFeedbackSnapshot>();saved->options=options.prefill;
+        saved->prefill=next.snapshot();saved->output_options=options.output;saved->markers=options.markers;saved->original_query=original_query;
+        if (next_output) saved->output=next_output->snapshot();
+        if (head_geometry_bytes>runtime_metadata.bytes() || saved->allocated_bytes()>runtime_metadata.bytes()-head_geometry_bytes)
+            throw std::length_error("native accepted feedback exceeds its explicit host account");
+        saved->metadata=runtime_metadata.split(saved->allocated_bytes());
+        auto graph=kvmem::prepare_graph_accept(sequence.window.graph,sequence.window.graph.accepted_through,stamp.frontier,{},32u<<20);
+        // Native Rawresolve has now established the accepted frontiers. Drain
+        // future proposal rows before publishing any checkpointable feedback.
+        close_physical_grant();
+        *prefill=std::move(next);output=std::move(next_output);sequence.window.layer_views.feedback=std::move(saved);
+        if (capture->output) output_work.accepted_consumed_tokens+=accepted;
+        sequence.window.graph=std::move(graph);
+        capture.reset();credit.reset();credit_count=0;native_started=false;
+    }
+};
