+std::vector<double> normalized(std::vector<double> values, int width) {
+    for (size_t begin = 0; begin < values.size(); begin += width) {
+        double sum = 0;
+        for (int d = 0; d < width; ++d) sum += values[begin + d] * values[begin + d];
+        const double scale = 1 / std::sqrt(sum / width + Epsilon);
+        for (int d = 0; d < width; ++d) values[begin + d] = bf16(values[begin + d] * scale);
+    }
+    return values;
