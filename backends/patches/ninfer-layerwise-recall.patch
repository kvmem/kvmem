+#include "models/qwen3_5/program/native_output_physical.h"
+#include "models/qwen3_5/state/decoder_state.h"
+
+#include <array>
+#include <iostream>
+#include <limits>
+#include <stdexcept>
+
+using namespace ninfer;
+namespace qwen = ninfer::models::qwen3_5;
+using namespace qwen::detail;
+
+namespace {
+void check(bool condition, const char* message) {
+    if (!condition) throw std::runtime_error(message);
+}
+template<class F> void rejected(F&& f) {
+    bool did_reject = false;
+    try { f(); } catch (const std::exception&) { did_reject = true; }
+    check(did_reject, "unfunded physical write range was admitted");
+}
+
+void verifier_ranges() {
+    for (const auto capacity : {256U, 512U}) {
+        // Literal Window admits only row C-1 before the next accepted block
+        // action. Keeping all 16 native columns must not reserve 16 Main rows.
+        const auto mtp = plan_native_output_physical(capacity, capacity - 1,
+            capacity - 1, 1, 16, SpeculativeBackend::Mtp, 15);
+        check(mtp.main_begin == capacity - 1 && mtp.main_end == capacity &&
+              mtp.valid_rows == 1 && mtp.physical_target_rows == 16 &&
+              mtp.auxiliary_begin == capacity - 1 && mtp.auxiliary_end == capacity + 14,
+              "MTP padded verifier width consumed accepted Main capacity");
+        const auto df = plan_native_output_physical(capacity, capacity - 1, 0,
+            1, 16, SpeculativeBackend::DFlash2, 15);
+        check(df.main_end == capacity && df.noise_rows == 16 &&
+              df.auxiliary_begin == 0 && df.auxiliary_end == 0,
+              "DFlash noise was charged as target or paged auxiliary history");
+        const auto ordinary = plan_native_output_physical(capacity, capacity - 1,
+            0, 1, 1, SpeculativeBackend::None, 0);
+        check(ordinary.main_end == capacity && ordinary.noise_rows == 0,
+              "ordinary rolling requires speculative capacity");
+        rejected([&] { (void)plan_native_output_physical(capacity,capacity-1,
+            capacity-1,2,16,SpeculativeBackend::Mtp,15); });
+        rejected([&] { (void)plan_native_output_physical(capacity,capacity,
+            capacity,1,16,SpeculativeBackend::Mtp,15); });
+    }
+    const auto all = plan_native_output_physical(512, 448, 448, 64, 64,
+        SpeculativeBackend::Mtp, 15);
+    check(all.main_end == 512 && all.auxiliary_end == 526,
+          "complete valid frame has the wrong independent scratch range");
+    rejected([] { (void)plan_native_output_physical(256,255,257,1,16,SpeculativeBackend::Mtp,15); });
+    rejected([] { (void)plan_native_output_physical(256,240,240,2,1,SpeculativeBackend::Mtp,3); });
+    rejected([] { (void)plan_native_output_physical(256,240,240,1,16,SpeculativeBackend::Mtp,0); });
+    rejected([] { (void)plan_native_output_physical(256,240,0,1,16,SpeculativeBackend::DFlash2,16); });
+    rejected([] { (void)plan_native_output_physical(256,240,0,1,2,SpeculativeBackend::None,0); });
+}
+
+void native_layout_and_estimate() {
+    // One Main layer and one auxiliary layer, each with four BF16 KV heads.
+    // The unexpanded native planner remains a legal control and keeps C.
+    for (const auto capacity : {256U, 512U}) for (const auto rows : {1, 3, 8}) {
+        qwen::DecoderStateSpec spec{
+            .full_attention_layers = 1, .mtp_layers = 1, .capacity = capacity,
+            .kv_heads = 4, .attention_head_dim = 256,
+            .kv_storage = KvCacheStorage::BFloat16, .enable_mtp = true,
+            .kv_table_rows = rows,
+            .text_physical_page_groups = capacity / 64 * rows,
+            .mtp_physical_page_groups = capacity / 64 * rows};
+        LayoutBuilder old_builder, new_builder;
+        LayoutBuilder* old_builders[]{&old_builder};
+        LayoutBuilder* new_builders[]{&new_builder};
+        const auto old = qwen::plan_decoder_state(old_builders, spec);
+        spec.mtp_physical_page_groups += rows;
+        const auto expanded = qwen::plan_decoder_state_with_auxiliary_capacity(
+            new_builders, spec, qwen::layerwise_mtp_auxiliary_capacity(capacity));
+        const auto old_bytes = old_builder.finish(256), new_bytes = new_builder.finish(256);
+        check(old.text_kv.max_context == capacity && old.mtp_kv->max_context == capacity &&
+              expanded.text_kv.max_context == capacity && expanded.mtp_kv->max_context == capacity + 64 &&
+              expanded.text_kv.pages.spec.page_group_count == capacity / 64 * rows &&
+              expanded.mtp_kv->pages.spec.page_group_count == (capacity / 64 + 1) * rows &&
+              expanded.text_kv.execution_tables.front().spec.logical_page_capacity == capacity / 64 &&
+              expanded.mtp_kv->execution_tables.front().spec.logical_page_capacity == capacity / 64 + 1,
+              "native accepted pool/table and independent auxiliary capacities diverged");
+        // Independent BF16 plane calculation: one K and one V page per lane.
+        // Tables consume another alignment unit only when their actual I32
+        // bytes cross 256 (the C512/eight-lane case exercises that boundary).
+        const auto align256=[](std::size_t bytes) { return (bytes+255)/256*256; };
+        const std::size_t old_table=std::size_t(capacity/64)*rows*4;
+        const std::size_t oracle = std::size_t(rows) * 2 * 64 * 4 * 256 * 2 +
