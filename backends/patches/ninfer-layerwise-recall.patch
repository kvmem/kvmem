--- /dev/null
+++ b/src/models/qwen3_5/program/storage/layerwise_kv_state.h
@@ -0,0 +1,156 @@
+#pragma once
+
+#include "models/qwen3_5/frontend/digest.h"
+#include "models/qwen3_5/program/storage/layerwise_feedback.h"
+#include "kvmem/memory_contract.hpp"
+#include <algorithm>
+#include <limits>
+#include <vector>
+
+namespace ninfer::models::qwen3_5::detail {
+
+struct KvmemLayerResidentView {
+    std::uint32_t model_layer=0;
+    std::uint64_t view_version=0;
+    std::vector<std::uint32_t> pages; // compact physical slots -> canonical logical pages
+    friend bool operator==(const KvmemLayerResidentView&,const KvmemLayerResidentView&)=default;
+};
+
+// Native physical tables are shared by layers; logical identities are not.
+// This exact metadata travels with the accepted window, checkpoints and session
+// images. A draft/auxiliary pool keeps its own mapping and compact shift.
+struct KvmemLayerViews {
+    std::vector<KvmemLayerResidentView> target;
+    std::vector<std::uint32_t> auxiliary_pages;
+    std::uint64_t auxiliary_view_version=0;
+    std::uint32_t auxiliary_removed_tokens=0;
+    bool has_auxiliary=false;
+    std::shared_ptr<const NativeLayerwiseFeedbackSnapshot> feedback;
+    std::uint64_t source_epoch=0;
+    bool active() const noexcept { return !target.empty(); }
+    std::uint64_t allocated_bytes() const noexcept {
+        std::uint64_t bytes=target.capacity()*sizeof(KvmemLayerResidentView)+
+            auxiliary_pages.capacity()*sizeof(std::uint32_t);
+        for (const auto& layer:target) bytes+=layer.pages.capacity()*sizeof(std::uint32_t);
+        if (feedback) bytes+=feedback->allocated_bytes();
+        return bytes;
+    }
+    KvmemLayerResidentView& layer(std::uint32_t model_layer) {
+        const auto found=std::find_if(target.begin(),target.end(),[&](const auto& v){return v.model_layer==model_layer;});
+        if (found==target.end()) throw std::logic_error("native layer has no accepted resident map");
+        return *found;
+    }
+    const KvmemLayerResidentView& layer(std::uint32_t model_layer) const {
+        return const_cast<KvmemLayerViews*>(this)->layer(model_layer);
+    }
+    static std::uint64_t visible_tokens(const std::vector<std::uint32_t>& pages,std::uint32_t frontier) {
+        std::uint64_t total=0;
+        std::uint32_t previous=0;bool first=true;
+        for (auto id:pages) {
+            const auto begin=std::uint64_t(id)*64;
+            if ((!first && id<=previous) || begin>=frontier)
+                throw std::logic_error("native layer map is not a chronological accepted view");
+            total+=std::min<std::uint64_t>(64,frontier-begin);previous=id;first=false;
+        }
+        return total;
+    }
+    std::uint64_t validate(std::uint32_t frontier) const {
+        if (!active()) {
+            if (has_auxiliary || !auxiliary_pages.empty() || auxiliary_removed_tokens || auxiliary_view_version || feedback || source_epoch)
+                throw std::logic_error("auxiliary layer map has no target owner");
+            return 0;
+        }
+        const auto extent=visible_tokens(target.front().pages,frontier);
+        if (feedback) {
+            std::vector<std::uint32_t> models;for (const auto& v:target) models.push_back(v.model_layer);
+            feedback->validate(feedback->prefill.session,frontier,models);
+        }
+        std::uint32_t previous=0;bool first=true;
+        for (const auto& v:target) {
+            if ((!first && v.model_layer<=previous) || visible_tokens(v.pages,frontier)!=extent)
+                throw std::logic_error("native model layers differ in historical token geometry");
+            previous=v.model_layer;first=false;
+        }
+        if (has_auxiliary) {
+            if (visible_tokens(auxiliary_pages,frontier)+auxiliary_removed_tokens!=frontier)
+                throw std::logic_error("native auxiliary compact shift differs from its own logical map");
+        } else if (!auxiliary_pages.empty() || auxiliary_removed_tokens)
+            throw std::logic_error("native layer view has an unowned auxiliary map");
+        return extent;
+    }
+    void initialize(std::span<const std::uint32_t> model_layers,const std::vector<std::uint32_t>& legacy,
+        std::uint64_t version,std::uint32_t frontier,bool auxiliary) {
+        if (active() || model_layers.empty()) throw std::logic_error("native layer maps were already initialized");
+        KvmemLayerViews next;
+        for (auto id:model_layers) next.target.push_back({id,version,legacy});
+        next.has_auxiliary=auxiliary;
+        if (auxiliary) {
+            next.auxiliary_pages=legacy;next.auxiliary_view_version=version;
+            next.auxiliary_removed_tokens=frontier-static_cast<std::uint32_t>(visible_tokens(legacy,frontier));
+        }
+        next.validate(frontier);*this=std::move(next);
+    }
+    // Called only after the actual stripe transfer and producing-stream fence.
+    void restored(std::uint32_t model_layer,const kvmem::ExecutionView& view) {
+        if (!view.stamp.valid || view.stamp.frontier>UINT32_MAX)
+            throw std::logic_error("native layer view has invalid accepted identity");
+        auto& destination=layer(model_layer);
+        std::vector<std::uint32_t> pages;pages.reserve(view.blocks.size());
+        for (const auto& item:view.blocks) {
+            if (item.block.id>UINT32_MAX || item.block.original_start!=item.block.id*64)
+                throw std::logic_error("native layer view does not name canonical page ordinals");
+            pages.push_back(static_cast<std::uint32_t>(item.block.id));
+        }
+        if (visible_tokens(pages,static_cast<std::uint32_t>(view.stamp.frontier))!=view.visible_tokens)
+            throw std::logic_error("native layer map and restored native extent differ");
+        destination.pages=std::move(pages);destination.view_version=view.stamp.view_version;
+    }
+    // A canonical append is published once all layers contain the same suffix.
+    // This method does no native execution and cannot authorize an early commit.
+    void accepted_target_append(std::uint32_t begin,std::uint32_t end) {
+        if (!active() || end<begin) throw std::logic_error("invalid native layer append publication");
+        auto next=*this;
+        for (auto& v:next.target) append(v.pages,begin,end);
+        target=std::move(next.target);
+    }
+    void accepted_auxiliary_append(std::uint32_t begin,std::uint32_t end) {
+        if (!has_auxiliary || end<begin) throw std::logic_error("invalid auxiliary append publication");
+        auto next=auxiliary_pages;append(next,begin,end);
+        const auto removed=end-static_cast<std::uint32_t>(visible_tokens(next,end));
+        auxiliary_pages=std::move(next);auxiliary_removed_tokens=removed;
+    }
+    bool same_logical_views(const KvmemLayerViews& other) const noexcept {
+        if (target.size()!=other.target.size() || has_auxiliary!=other.has_auxiliary ||
+            auxiliary_pages!=other.auxiliary_pages || auxiliary_removed_tokens!=other.auxiliary_removed_tokens) return false;
+        for (std::size_t i=0;i<target.size();++i)
+            if (target[i].model_layer!=other.target[i].model_layer || target[i].pages!=other.target[i].pages) return false;
+        return true;
+    }
+    // Combine this digest with the native backend/model/accepted-content
+    // identity. It binds every target layer and the independent auxiliary view.
+    // Exact metadata comparison remains authoritative for checkpoint reuse.
+    frontend::Sha256Digest provenance_digest() const {
+        std::vector<std::uint8_t> bytes;
+        const auto word=[&](std::uint64_t value) {
+            for (int b=0;b<8;++b) bytes.push_back(static_cast<std::uint8_t>(value>>(8*b)));
+        };
+        word(0x6b762d6c61796572ULL);word(3);word(source_epoch);word(target.size());
+        for (const auto& v:target) {
+            word(v.model_layer);word(v.pages.size());for (auto page:v.pages) word(page);
+        }
+        word(has_auxiliary);word(auxiliary_removed_tokens);word(auxiliary_pages.size());
+        for (auto page:auxiliary_pages) word(page);
+        word(bool(feedback));if (feedback) feedback->append_identity(bytes);
+        return frontend::sha256(bytes);
+    }
+    friend bool operator==(const KvmemLayerViews&,const KvmemLayerViews&)=default;
+private:
+    static void append(std::vector<std::uint32_t>& pages,std::uint32_t begin,std::uint32_t end) {
+        (void)visible_tokens(pages,begin);
+        if (begin%64 && (pages.empty() || pages.back()!=begin/64))
+            throw std::logic_error("native append lost its current partial logical page");
+        for (auto id=begin/64;std::uint64_t(id)*64<end;++id)
+            if (pages.empty() || pages.back()!=id) pages.push_back(id);
+    }
+};
+} // namespace ninfer::models::qwen3_5::detail
