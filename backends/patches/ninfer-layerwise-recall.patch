+            const auto stream=p.device.stream_for_rank(rank);
+            CUDA_CHECK(cudaMemcpyAsync(shard.ranges.data,p.memory_candidate_ranges.data(),
+                sizeof(p.memory_candidate_ranges),cudaMemcpyHostToDevice,stream));
+            CUDA_CHECK(cudaMemsetAsync(shard.candidate_origin.data,0,sizeof(std::int32_t),stream));
+        }
+    }
+    void begin_query_workspace(bool no_refresh) {
+        if (query_extra_active) throw std::logic_error("Query feedback workspace is already active");
+        const NativeQueryWorkIdentity lease{sequence.lane,p.lane_epochs.at(sequence.lane),request_id};
+        if (no_refresh && query_extra_bytes) {
+            if (!p.layerwise_query_work.acquire(lease))
+                throw kvmem::MemoryError(kvmem::MemoryErrorCode::Pending,"another owner holds Query feedback resources");
+            no_refresh_work=true;no_refresh_identity=lease;
+        }
+        if (query_extra_bytes && (!p.layerwise_query_work.owns(lease) ||
+            p.layerwise_query_feedback_pool.bytes()<checked_sum(query_extra_bytes,native_output_fixed_metadata_bytes)))
+            throw std::logic_error("Query feedback has no complete Program work lease");
+        runtime_budget=checked_sum(runtime_budget,query_extra_bytes);query_extra_active=true;reclaim_metadata();
+    }
+    void end_query_workspace() {
+        if (!query_extra_active) return;
+        if (!capture) reclaim_metadata();
+        if (capture || runtime_metadata.bytes()<query_extra_bytes)
+            throw std::logic_error("Query feedback release preceded private matrix retirement");
+        runtime_metadata.shrink(runtime_metadata.bytes()-query_extra_bytes);
+        runtime_budget-=query_extra_bytes;query_extra_active=false;
+        if (no_refresh_work) {
+            p.layerwise_query_work.release(no_refresh_identity);no_refresh_work=false;no_refresh_identity={};
+        }
+    }
+    void close_physical_grant() {
