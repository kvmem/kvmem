+        const auto count=padded_output?c.count:physical_count;
+        if (!count || count>c.count-seen || frame.query.ne[0]!=256 ||
+            frame.query.ne[1]!=(head?head->count:p.parameters.model.config().text.attention->num_attention_heads) ||
+            frame.cache_positions.dtype!=DType::I32 || frame.cache_positions.ne[0]!=physical_count || frame.table_rows.dtype!=DType::I32 || frame.table_rows.numel()!=1)
