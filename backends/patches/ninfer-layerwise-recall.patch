+            sequence.text_kv_valid-grant.logical_begin>grant.plan.valid_rows)
+            throw std::logic_error("native physical grant ended at an unrelated accepted history");
+        // No cached proposal refers to these temporary K/V rows once native
+        // Rawresolve has committed its real prefix and copied next draft IDs.
+        // A new Query/checkpoint may see only accepted coverage and mappings.
+        p.device.synchronize();
+        const auto main_end=sequence.text_kv_valid-sequence.window.removed_tokens;
+        if (p.text_kv_addresses->committed_frontier(sequence.kv->text)!=main_end)
+            throw std::logic_error("native physical grant ended before Main raw resolution");
+        p.text_kv_addresses->destructive_truncate(sequence.kv->text,main_end);
+        if (p.speculative_backend==SpeculativeBackend::Mtp) {
+            const auto removed=sequence.window.layer_views.has_auxiliary
+                ?sequence.window.layer_views.auxiliary_removed_tokens:sequence.window.removed_tokens;
+            if (!sequence.kv->backend || sequence.mtp_kv_valid<removed)
+                throw std::logic_error("native physical grant lost its accepted auxiliary coverage");
+            const auto end=sequence.mtp_kv_valid-removed;
+            if (p.backend_kv_addresses->committed_frontier(*sequence.kv->backend)!=end)
+                throw std::logic_error("native physical grant ended before auxiliary raw resolution");
+            p.backend_kv_addresses->destructive_truncate(*sequence.kv->backend,end);
+        }
+        physical_grant.reset();
+    }
+    void publish() {
+        reclaim_metadata();
+        auto next=std::make_shared<NativeLayerwiseFeedbackSnapshot>();
+        next->options=options.prefill;next->prefill=prefill->snapshot();next->output_options=options.output;next->markers=options.markers;next->original_query=original_query;
+        if (output) next->output=output->snapshot();
+        if (head_geometry_bytes>runtime_metadata.bytes() || next->allocated_bytes()>runtime_metadata.bytes()-head_geometry_bytes)
+            throw std::length_error("native accepted feedback exceeds its explicit host account");
+        next->metadata=runtime_metadata.split(next->allocated_bytes());
+        sequence.window.layer_views.feedback=std::move(next);
+    }
+    void prepare(std::uint32_t begin,std::uint32_t count,std::uint32_t local,bool query,const std::vector<std::uint32_t>* output_tokens=nullptr,bool deferred_output=false) {
+        owner();if (capture || !count || begin!=sequence.text_kv_valid ||
+            (!output_tokens && !deferred_output && (!input_owner || begin>input_owner->prompt_tokens || count>input_owner->prompt_tokens-begin)))
