+        if (tensor) {
+            if (target_heads.size()!=next.layers.size()) throw std::logic_error("native tensor feedback target directory changed");
+            for (std::size_t i=0;i<next.layers.size();++i)
+                if (target_heads[i].front().model!=next.layers[i].model_layer)
+                    throw std::logic_error("native tensor feedback target model order changed");
+            next.head_tiles.resize(next.layers.size());
+        }
+        capture=std::move(next);if (prepared_output) output=std::move(prepared_output);
+    }
+    void restored(std::uint32_t model,const kvmem::ExecutionView& view) {
+        if (!capture || !capture->query || view.visible_tokens!=capture->local_begin || view.stamp.frontier!=capture->begin)
+            throw std::logic_error("native Query feedback restored a different historical extent");
+        auto found=std::find_if(capture->layers.begin(),capture->layers.end(),[&](const auto& l){return l.model_layer==model;});
+        if (found==capture->layers.end() || !found->history.empty()) throw std::logic_error("native Query feedback restored a foreign or repeated layer");
+        for (const auto& item:view.blocks) found->history.push_back(item.block.original_start);
+        for (auto id=capture->begin/64;std::uint64_t(id)*64<std::uint64_t(capture->begin)+capture->count;++id)
+            found->history.push_back(std::uint64_t(id)*64);
+        if (found->history.size()!=found->starts.size()) throw std::logic_error("native Query feedback lost restored layer identity");
+    }
+    void attended(const execution::CurrentLayerAttentionFrame& frame) {
+        owner();const bool tensor=!target_heads.empty();
+        if (!capture || frame.identity.model_layer>=p.parameters.text.layers.size() ||
+            (!tensor && frame.identity.rank!=p.parameters.text.layers[frame.identity.model_layer].rank))
+            throw std::logic_error("native feedback has no current owning-rank whole-model capture");
+        native_started=true;
+        auto& c=*capture;
+        const auto found=std::find_if(c.layers.begin(),c.layers.end(),[&](const auto& l){return l.model_layer==frame.identity.model_layer;});
+        if (found==c.layers.end() || found->history.size()!=found->starts.size() ||
+            p.parameters.model.config().text.compact_layer_indices.at(frame.identity.model_layer)!=frame.identity.attention_layer)
+            throw std::logic_error("native feedback layer map or full-attention ordinal is not restored");
