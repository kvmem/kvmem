+void ProgramImpl::prepare_layerwise_admission(MaterializationTransaction& transaction,
+    const KvmemPrefixCheckpoint* checkpoint,const KvmemWindowState* prospective) {
+    auto& staged=*requests[transaction.destination.value].prefill;
+    const auto envelope=layerwise_envelope(staged.prompt,transaction.plan->impl_->summary.effective_output_tokens);
+    const kvmem::LayerwiseWindowPlan window(envelope,kvmem_window_tokens);
+    const auto source_h=checkpoint?static_cast<std::uint32_t>(checkpoint->prefix.size()):0U;
+    const auto source_l=checkpoint?checkpoint->layer_views.validate(source_h):0U;
+    const auto phases=plan_native_query_admission(window,{source_h,source_l},prefill_chunk,
