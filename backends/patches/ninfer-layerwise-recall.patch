+
+namespace ninfer::models::qwen3_5::detail {
+namespace {
+enum Plane : std::uint32_t { Query, Key, Value, Gate, Residual, CachePosition, RopePosition, KeySum,
+                            RopePosition1, RopePosition2 };
+std::uint32_t rope_plane(std::uint32_t axis) {
+    if (axis>2) throw std::logic_error("invalid native Query RoPE axis");
+    return axis?RopePosition1+axis-1:RopePosition;
+}
+void validate_axes(std::uint32_t axes) {
+    if (axes!=1 && axes!=3) throw std::invalid_argument("native Query requires one or three native RoPE axes");
+}
+std::uint64_t add(std::uint64_t a, std::uint64_t b) {
+    if (b > UINT64_MAX - a) throw std::length_error("native Query activation extent overflow");
+    return a + b;
+}
+std::uint64_t multiply(std::uint64_t a, std::uint64_t b) {
+    if (b && a > UINT64_MAX / b) throw std::length_error("native Query activation extent overflow");
+    return a * b;
+}
+std::size_t addressable(std::uint64_t bytes) {
+    if (bytes > SIZE_MAX) throw std::length_error("native Query activation exceeds host addressing");
+    return static_cast<std::size_t>(bytes);
+}
+std::int32_t dim(std::uint64_t n) {
+    if (!n || n > INT32_MAX) throw std::invalid_argument("native Query tensor dimension exceeds int32");
+    return static_cast<std::int32_t>(n);
+}
+std::uint64_t row_bytes(const kvmem::QueryProjectionLayout& layout) {
+    std::uint64_t bytes = 0;
+    for (const auto& plane : layout.planes) bytes = add(bytes, plane.row_stride);
+    return bytes;
+}
+} // namespace
+
+std::uint64_t native_query_device_bound(const TextConfig& config,std::uint32_t chunk) {
+    return native_query_device_bound(config,chunk,1);
+}
+std::uint64_t native_query_staging_bytes(const TextConfig& config,std::uint32_t chunk) {
+    return native_query_staging_bytes(config,chunk,1);
+}
+std::uint64_t native_query_tensor_staging_bytes(const TextConfig& config,std::uint32_t chunk,std::uint32_t ranks) {
+    return native_query_tensor_staging_bytes(config,chunk,ranks,1);
+}
+std::uint64_t native_query_mtp_device_bound(const TextConfig& config,std::uint32_t chunk) {
+    return native_query_mtp_device_bound(config,chunk,1);
+}
+
+std::uint64_t native_query_device_bound(const TextConfig& config,std::uint32_t chunk,std::uint32_t axes) {
+    validate_axes(axes);
+    if (!config.attention || !chunk) throw std::invalid_argument("native Query storage requires attention geometry");
+    const auto row=add(add(multiply(4,config.attention->query_width()),multiply(4,config.attention->key_width())),
+        add(multiply(4,config.hidden_size),8+4*axes));
+    // Stable native planes plus rank-local table/origin controls. Each rank
+    // has its own allocation; no rank follows a pointer into another device.
+    return add(add(multiply(row,chunk),multiply(4,config.vocab_size)),13*256);
+}
+std::uint64_t native_query_staging_bytes(const TextConfig& config,std::uint32_t chunk,std::uint32_t axes) {
+    validate_axes(axes);
+    if (!config.attention || !chunk) throw std::invalid_argument("native Query staging requires attention geometry");
+    return multiply(chunk,add(add(multiply(4,config.attention->query_width()),multiply(8,config.attention->key_width())),
+        add(multiply(2,config.hidden_size),4+4*axes)));
+}
+std::uint64_t native_query_tensor_staging_bytes(const TextConfig& config,std::uint32_t chunk,std::uint32_t ranks,std::uint32_t axes) {
+    validate_axes(axes);
+    if (!config.attention || !chunk || !ranks) throw std::invalid_argument("native tensor Query staging requires attention geometry");
+    // One local native projection frame plus an exact full-head Query/sum
+    // tile. No floating conversion or rank-average score is stored here.
+    return add(add(native_query_staging_bytes(config,chunk,axes),multiply(multiply(chunk,ranks-1),
+        add(multiply(2,config.hidden_size),4+4*axes))),multiply(chunk,
+        std::max(multiply(2,config.attention->query_width()),multiply(4,config.attention->key_width()))));
+}
+std::uint64_t native_query_mtp_device_bound(const TextConfig& config,std::uint32_t chunk,std::uint32_t axes) {
+    validate_axes(axes);
+    const auto base=native_query_device_bound(config,chunk,axes);
+    LayoutBuilder controls;
+    controls.add_tensor(DType::I32,{dim(chunk)},256,"MTP stable IDs");
+    controls.add_tensor(DType::I32,{dim(chunk)},256,"MTP stable cache positions");
+    controls.add_tensor(DType::I32,{dim(chunk),dim(axes)},256,"MTP stable RoPE positions");
+    if (axes==3) controls.add_tensor(DType::BF16,{dim(config.hidden_size),dim(chunk)},256,"MTP shifted composed input");
+    return add(add(base,255)/256*256,controls.finish(256));
+}
