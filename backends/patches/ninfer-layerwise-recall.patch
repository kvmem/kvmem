+        throw std::logic_error("native Waiting has no owning finite Program source account/pool");
+    memory_checkpoint_pool->configure_metadata(layerwise_source_account);
+    if (transaction.memory_history && transaction.memory_history->work &&
+        transaction.memory_history->work->layerwise_admission) {
+        const auto& old=*transaction.memory_history->work->layerwise_admission;
+        if (old.input_owner!=&staged.prompt || old.prompt_end!=staged.prompt_tokens ||
+            old.source_frontier!=source_h || old.account()!=layerwise_source_account ||
+            old.source.get()!=(checkpoint?checkpoint->canonical_source.get():nullptr) ||
+            old.source_epoch!=(checkpoint && checkpoint->canonical_source?checkpoint->canonical_source->epoch:0))
+            throw std::logic_error("native Waiting retry changed its exact input/source reservation");
+        return;
+    }
+    auto log=[&](const char* action,std::uint32_t count) {
+        if (!kvmem_options.verify_transfers) return;
+        const auto allocated=memory_checkpoint_pool->allocated_bytes(),idle=memory_checkpoint_pool->idle_bytes();
+        std::fprintf(stderr,"KVMEM_LAYERWISE_ADMISSION action=%s phase=waiting source_h=%u source_l=%llu source_epoch=%llu source_used=%llu source_limit=%llu pool_allocated=%zu pool_idle=%zu pool_active=%zu checkpoint_credits=%u history_moved=0 model_forward_rows=0\n",
+            action,source_h,(unsigned long long)source_l,
+            (unsigned long long)(checkpoint && checkpoint->canonical_source?checkpoint->canonical_source->epoch:0),
+            (unsigned long long)layerwise_source_account->charged_bytes(),(unsigned long long)source_partition,
+            allocated,idle,allocated-idle,count);
+    };
+    log("begin",phases.checkpoint_count);
