@@ -0,0 +1,37 @@
+#pragma once
+
+#include "core/host_kv_arena.h"
+#include "models/qwen3_5/program/storage/layerwise_kv_write.h"
+#include "kvmem/host_kv_storage.hpp"
+#include "kvmem/layerwise_memory.hpp"
+
+namespace ninfer::models::qwen3_5::detail {
+
+// The Program owner freezes the complete, sealed canonical archive before any
+// stripe mutation. Sources retain immutable native bytes and the storage quota;
+// this descriptor does not duplicate the records or promote cold records.
+// Native block IDs are original 64-token page ordinals, never compact slots.
+struct NativeFrozenLayerArchive {
+    kvmem::MemoryDescriptor descriptor;
+    kvmem::MemorySnapshot canonical;
+    std::vector<kvmem::HostKvSource> records;
+};
+
+// Restore every selected page of one model layer, including retained pages whose
+// compact slot may have changed. Other layer/rank stripes are untouched. The
+// caller has already reserved COW overlap, frozen an exact State checkpoint and
+// established the explicit unpublished destination over the complete address.
+//
+// staging is pinned caller-owned transfer memory, separately admitted from the
+// canonical KV storage. Only the packed layer record must fit (or the full pool
+// record when diagnostic_readback is requested). The call drains native copies
+// before reusing staging or returning a receipt. A failed transfer can leave the
+// unpublished destination partially written; its owner must restore/invalidate
+// the whole execution, never publish only old metadata.
+kvmem::ExecutionView restore_native_layer_stripe(
+    const NativeFrozenLayerArchive&, const kvmem::MemorySnapshot& current_layer,
+    const kvmem::LayerWorkingSetPlan&, DeviceKVPagePool&, KVAddressSpaceStore&,
+    KVAddressSpaceHandle, DeviceContext&, RankStreams, PinnedHostBuffer& staging,
+    std::uint64_t canonical_pool_offset=0, bool diagnostic_readback=false);
+
+} // namespace ninfer::models::qwen3_5::detail
diff --git a/src/models/qwen3_5/program/storage/layerwise_kv_write.h b/src/models/qwen3_5/program/storage/layerwise_kv_write.h
new file mode 100644
index 0000000000000000000000000000000000000000..8e84b189f056e25d6fc30f408765546730f4b891
--- /dev/null
+++ b/src/models/qwen3_5/program/storage/layerwise_kv_write.h
@@ -0,0 +1,243 @@
+#pragma once
+
+#include "core/device.h"
+#include "models/qwen3_5/program/storage/kv_store.h"
+
+namespace ninfer::models::qwen3_5::detail {
+
+// A Program-owned safe-boundary write lease over existing compact page slots.
+// It copies a whole native page before detaching any immutable/shared/Host
+// version, even though the caller subsequently changes only one layer stripe.
+// Every page retains the existing pool/layout/table ABI. This is not a second
+// allocation policy: its physical reservation comes from that pool and must be
+// admitted by Program's ordinary pressure/resource transaction.
+class KVLayerStripeWrite {
+public:
+    // A new append page can be used as bounded transfer scratch without
+    // revoking or pretending to re-commit any accepted historical page.
+    static void require_unpublished_suffix_destination(KVAddressSpaceStore& owner,
+        KVAddressSpaceHandle address,const DeviceKVPagePool& pool,
+        std::uint32_t first,std::uint32_t count) {
+        const auto& a=owner.require_active(address);
+        if (&owner.pages_->physical_pool()!=&pool || !a.row || first>a.page_count || count>a.page_count-first ||
+            std::uint64_t(first)*kPagedKVPageSize<a.committed_frontier ||
+            std::uint64_t(first)*kPagedKVPageSize<a.checkpoint_frontier)
+            throw std::logic_error("native transfer scratch overlaps accepted/checkpoint coverage");
+        for (std::uint32_t i=0;i<count;++i) {
+            const auto& page=owner.pages_->require(owner.membership(a,first+i));
+            if (!in_place(page) || page.writer_references!=1 || page.committed_columns)
+                throw std::logic_error("native transfer scratch is not an exclusive unpublished suffix");
+        }
+    }
+
+    // A stripe write cannot borrow the public committed-coverage API to make
+    // accepted pages mutable. Only the explicit complete-address transition
+    // below establishes this Program-private destination; newly mapped suffix
+    // pages have the same exclusive, unpublished ownership.
+    static void require_unpublished_destination(KVAddressSpaceStore& owner,
+        KVAddressSpaceHandle address, const DeviceKVPagePool& pool, std::uint32_t count) {
+        const auto& a=owner.require_active(address);
+        if (&owner.pages_->physical_pool()!=&pool || !a.row || a.committed_frontier ||
+            a.checkpoint_frontier || count>a.page_count)
+            throw std::logic_error("native stripe destination is not an unpublished address");
+        for (std::uint32_t i=0;i<a.page_count;++i) {
+            const auto& page=owner.pages_->require(owner.membership(a,i));
+            if (!in_place(page) || page.writer_references!=1 || page.committed_columns)
+                throw std::logic_error("native stripe destination is not exclusively unpublished");
+        }
+    }
+
+    static std::uint32_t copy_pages_required(KVAddressSpaceStore& owner,
+        KVAddressSpaceHandle address, std::uint32_t first, std::uint32_t count) {
+        const auto& a=owner.require_active(address);
+        if (!a.row || first>a.page_count || count>a.page_count-first)
+            throw std::invalid_argument("native layer stripe range is outside its address space");
+        std::uint32_t copies=0;
+        for (std::uint32_t i=0;i<count;++i) {
+            const auto handle=owner.membership(a,first+i);
+            const auto& page=owner.pages_->require(handle);
+            if (!page.device_replica || page.pending_device_replica || page.destination_pinned ||
+                page.source_pins || !page.active_references || !page.references || page.writer_references>1 ||
+                (page.writer_references && page.references!=1))
+                throw std::logic_error("native stripe source is pending or not a stable committed page");
+            if (!in_place(page) && !page.committed_columns)
+                throw std::logic_error("an uncommitted shared native page cannot establish a COW source");
+            copies+=!in_place(page);
+        }
+        return copies;
+    }
+
+    KVLayerStripeWrite(KVAddressSpaceStore& owner, KVAddressSpaceHandle address,
+        std::uint32_t first, std::uint32_t count, DeviceContext& device, RankStreams streams)
+        : owner_(&owner), address_(address), device_(&device), streams_(streams),
+          reservation_(owner.pages_->physical_pool().make_empty_reservation()) {
+        if (streams_.size()!=device.size())
+            throw std::invalid_argument("native stripe write must name every producing rank stream");
+        for (std::size_t rank=0;rank<device.size();++rank) {
+            DeviceBinding binding(device.rank(rank).device);
+            cudaStreamCaptureStatus status=cudaStreamCaptureStatusNone;
+            CUDA_CHECK(cudaStreamIsCapturing(streams_[rank],&status));
+            if (status!=cudaStreamCaptureStatusNone)
+                throw std::logic_error("native layer stripe mutation requires an eager Program boundary");
+        }
+        const auto required=copy_pages_required(owner,address,first,count);
+        entries_.reserve(count);
+        auto& a=owner.require_active(address);
+        for (std::uint32_t i=0;i<count;++i) {
+            const auto source=owner.membership(a,first+i);
+            const auto& page=owner.pages_->require(source);
+            entries_.push_back({first+i,source,{},page.content_epoch,page.committed_columns,
+                                page.writer_references!=0,!in_place(page),false});
+        }
+        // Quota admission and every metadata allocation precede source pins and
+        // the first native copy. A failure preserves the previous native view.
+        owner.pages_->physical_pool().resize_reservation(reservation_,required);
+        try {
+            for (auto& entry:entries_) {
+                owner.pages_->pin_source(entry.source);entry.pinned=true;
+                if (entry.copy)
+                    entry.destination=owner.pages_->materialize_transfer_destination(reservation_,entry.columns);
+            }
+        } catch (...) { (void)abort();throw; }
+    }
+    ~KVLayerStripeWrite() { (void)abort(); }
+    KVLayerStripeWrite(const KVLayerStripeWrite&)=delete;
+    KVLayerStripeWrite& operator=(const KVLayerStripeWrite&)=delete;
+
+    std::uint32_t copied_pages() const noexcept {
+        return static_cast<std::uint32_t>(std::count_if(entries_.begin(),entries_.end(),
+            [](const auto& entry){return entry.copy;}));
+    }
+
+    void copy_native_pages() {
+        require_open();
+        if (copies_started_) throw std::logic_error("native stripe COW copies were already issued");
+        validate_sources();
+        copies_started_=true;
+        for (const auto& entry:entries_) if (entry.copy)
+            owner_->pages_->physical_pool().copy_page(owner_->pages_->physical(entry.source),
+                owner_->pages_->physical(entry.destination),streams_);
+    }
+
+    // Completes the producer streams itself. No metadata claim can substitute
+    // for copying the other layer/rank planes and preserving their represented
+    // bytes before publication of the replacement physical table entries.
+    void commit() { commit_impl(false); }
+
+    // Explicit Program-private materialization destination. The caller already
+    // holds sealed canonical history and an exact rollback State checkpoint,
+    // and excludes this owner from capture/Pressure/session offers. Preserve
+    // every mapped byte/table slot but revoke whole-page accepted coverage while
+    // different model stripes are being restored. The accepted Sequence/window
+    // frontier is not changed here. Only after all target/GDN/auxiliary work may
+    // Program use the ordinary final commit_frontier on this destination.
+    void commit_unpublished_destination() { commit_impl(true); }
+
+private:
+    void commit_impl(bool unpublished) {
+        require_open();
+        if (!copies_started_) throw std::logic_error("native stripe COW has not completed its copy stage");
+        device_->synchronize();
+        validate_sources();
+        auto& a=owner_->require_active(address_);
+        if (unpublished && (entries_.size()!=a.page_count ||
+            (!entries_.empty() && (entries_.front().slot!=0 || entries_.back().slot+1!=a.page_count))))
+            throw std::logic_error("private layerwise destination must revoke the complete native address coverage");
+        auto& pages=*owner_->pages_;
+        // All remaining operations below use already reserved native metadata.
+        // A table upload failure leaves coherent new ownership for the caller
+        // to invalidate/restore; it never restores only old metadata.
+        for (auto& entry:entries_) {
+            pages.unpin_source(entry.source);entry.pinned=false;
+            if (entry.copy) {
+                pages.publish_transfer_destination(entry.destination,true);
+                pages.retain_active_reference(entry.destination);
+                owner_->membership(a,entry.slot)=entry.destination;
+                pages.release_active_reference(entry.source);
+                if (!pages.release_reference(entry.source,entry.writer)) std::terminate();
+                entry.destination={};
+            } else {
+                auto& page=pages.require(entry.source);
+                if (!in_place(page)) std::terminate();
+                if (!page.writer_references) pages.set_writer(entry.source,true);
+                page.content_epoch=LogicalKVPageStore::next_epoch(page.content_epoch);
+            }
+            if (unpublished) {
+                auto& destination=pages.require(owner_->membership(a,entry.slot));
+                destination.committed_columns=0;
+            }
+        }
+        if (unpublished) { a.committed_frontier=0;a.checkpoint_frontier=0; }
+        // Disarm before the fallible CUDA table upload. Every destination is
+        // already owned by this active address; abort cannot free it as staging.
+        auto* owner=std::exchange(owner_,nullptr);
+        owner->publish_membership(a,streams_);
+    }
+
+public:
+
+    // False means a device failure prevented a proved drain. Pending native
+    // destinations/sources stay quarantined in the original stores, rather than
+    // becoming reusable while a copy might still access them. Program must then
+    // invalidate its native continuation; the immutable canonical archive lives
+    // independently of this lease.
+    bool abort() noexcept {
+        if (!owner_) return true;
+        if (copies_started_) {
+            try { device_->synchronize(); }
+            catch (...) { owner_=nullptr;return false; }
+        }
+        auto& pages=*owner_->pages_;
+        for (auto& entry:entries_) {
+            if (entry.destination.valid()) pages.abort_transfer_destination(entry.destination,reservation_);
+            entry.destination={};
+            if (entry.pinned) {
+                try { pages.unpin_source(entry.source); }
+                catch (...) { std::terminate(); }
+                entry.pinned=false;
+            }
+        }
+        owner_=nullptr;
+        return true;
+    }
+private:
+    struct Entry {
+        std::uint32_t slot;
+        LogicalKVPageHandle source,destination;
+        std::uint64_t epoch;
+        std::uint32_t columns;
+        bool writer,copy,pinned;
+    };
+    template<class Page> static bool exclusive_page(const Page& page) noexcept {
+        return page.references==1 && page.active_references==1 && page.writer_references<=1 &&
+            !page.protected_columns && !page.destination_pinned &&
+            !page.host_replica && !page.pending_device_replica && page.device_replica.has_value();
+    }
+    template<class Page> static bool in_place(const Page& page) noexcept {
+        return exclusive_page(page) && !page.source_pins;
+    }
+    void require_open() const {
+        if (!owner_) throw std::logic_error("native stripe write lease is closed");
+    }
+    void validate_sources() const {
+        const auto& a=owner_->require_active(address_);
+        for (const auto& entry:entries_) {
+            if (!(owner_->membership(a,entry.slot)==entry.source))
+                throw std::logic_error("native stripe compact membership changed before COW commit");
+            const auto& page=owner_->pages_->require(entry.source);
+            if (page.content_epoch!=entry.epoch || page.committed_columns!=entry.columns ||
+                page.writer_references!=std::uint8_t(entry.writer) || page.source_pins!=1 ||
+                !entry.pinned || !page.active_references || page.destination_pinned ||
+                (!entry.copy && !exclusive_page(page)))
+                throw std::logic_error("native stripe source changed before COW commit");
+        }
+    }
+    KVAddressSpaceStore* owner_;
+    KVAddressSpaceHandle address_;
+    DeviceContext* device_;
+    RankStreams streams_;
+    DeviceKVPageReservation reservation_;
+    std::vector<Entry> entries_;
+    bool copies_started_=false;
+};
+} // namespace ninfer::models::qwen3_5::detail
