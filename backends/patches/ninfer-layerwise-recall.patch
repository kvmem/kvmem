+
+// A layerwise checkpoint also owns exact pre-RoPE Mean-K and per-layer source
+// provenance. Its immutable canonical version is the payload owner; a second
+// manifest/tail capture would duplicate ownership outside its Waiting credits.
+// Directory lookup, eviction and restoration must use either immutable owner,
+// never the active window's mutable archive as a substitute.
+template<class Checkpoint>
+size_t kvmem_checkpoint_payload_pages(const Checkpoint& cp) {
+    return cp.canonical_source ? cp.canonical_source->records.size() :
+        cp.kv_snapshot ? cp.kv_snapshot->blocks().size() : 0;
+}
+
+template<class Checkpoint>
+bool kvmem_checkpoint_payload_covers(const Checkpoint& cp,size_t pages,size_t stride) {
+    if (!cp.canonical_source) return kvmem_snapshot_covers(cp.kv_snapshot,pages,stride);
+    if (!pages || !stride || pages>SIZE_MAX/stride) return false;
+    try {
+        const auto& source=*cp.canonical_source;
+        source.validate();
+        return source.records.size()==pages && source.frontier==cp.prefix.size() &&
+            source.descriptor.identity==cp.identity.backend && source.descriptor.layout==cp.identity.layout &&
+            source.descriptor.layout.record_bytes==stride &&
+            (!cp.layer_views.active() || cp.layer_views.source_epoch==source.epoch);
+    } catch (const std::exception&) {return false;}
+}
+
+template<class Checkpoint>
+kvmem::HostKvRecord kvmem_checkpoint_payload_record(const Checkpoint& cp,size_t page) {
+    if (page>=kvmem_checkpoint_payload_pages(cp)) return {};
+    return cp.canonical_source ? cp.canonical_source->records[page].fork() :
+        cp.kv_snapshot->blocks()[page]->record();
+}
+
+template<class Checkpoint>
+size_t kvmem_checkpoint_payload_bytes(const Checkpoint& cp) {
+    if (!cp.canonical_source) return cp.kv_snapshot ? cp.kv_snapshot->size() : 0;
+    const auto pages=cp.canonical_source->records.size(),stride=cp.canonical_source->descriptor.layout.record_bytes;
+    if (stride && pages>SIZE_MAX/stride) throw std::overflow_error("checkpoint payload byte count overflow");
+    return pages*stride;
+}
+
+template<class Checkpoint>
+std::vector<kvmem::HostKvRecord> fork_kvmem_checkpoint_payload(const Checkpoint& cp) {
+    if (!cp.canonical_source) {
+        if (!cp.kv_snapshot) throw std::logic_error("checkpoint has no immutable native payload");
+        return fork_kvmem_snapshot(*cp.kv_snapshot);
+    }
+    std::vector<kvmem::HostKvRecord> records;
+    records.reserve(cp.canonical_source->records.size());
+    for (const auto& record:cp.canonical_source->records) records.push_back(record.fork());
+    return records;
+}
+
+template<class Checkpoint,class Visitor>
+void account_kvmem_checkpoint_payload(const Checkpoint& cp,Visitor&& visitor) {
+    if (cp.canonical_source) {
+        for (const auto& record:cp.canonical_source->records)
+            visitor(record.storage_identity(),record.size());
+    } else if (cp.kv_snapshot) cp.kv_snapshot->account(std::forward<Visitor>(visitor));
+}
+
+template<class Checkpoint>
+bool same_kvmem_checkpoint_payload(const Checkpoint& left,const Checkpoint& right) {
+    if (left.canonical_source || right.canonical_source)
+        return left.canonical_source && left.canonical_source==right.canonical_source;
+    return left.kv_snapshot && left.kv_snapshot==right.kv_snapshot;
+}
