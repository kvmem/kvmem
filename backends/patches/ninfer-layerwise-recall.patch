+void check_near(const char* label, const std::vector<double>& got, const std::vector<double>& expected,
+           int ulps = 3, double absolute = 1e-5) {
+    check(got.size() == expected.size(), "oracle extent mismatch");
+    double worst = 0;
+    for (size_t i = 0; i < got.size(); ++i) {
+        const double value = expected[i];
+        const double step = value ? std::ldexp(1., std::ilogb(std::abs(value)) - 7) : 0.;
+        const double error = std::abs(got[i] - value);
+        worst = std::max(worst, error);
+        if (!std::isfinite(got[i]) || error > ulps * step + absolute)
+            throw std::runtime_error(std::string(label) + " exceeds represented BF16 oracle at " + std::to_string(i) +
+                ": got=" + std::to_string(got[i]) + " expected=" + std::to_string(value));
+    }
+    std::cout << label << " max_abs=" << worst << " bf16_ulps=" << ulps << '\n';
