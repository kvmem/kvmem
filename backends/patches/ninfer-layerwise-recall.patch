+#pragma once
+
+#include "models/qwen3_5/program/context.h"
+#include "kvmem/layerwise_probe_selection.hpp"
+
+namespace ninfer::models::qwen3_5::detail {
+
+class NativeLayerwiseQueryExecution;
+
+struct NativeLayerwiseProbeWork {
+    std::uint64_t evaluated_rows = 0;
+    std::uint64_t projected_target_rows = 0;
+    std::uint64_t scored_query_rows = 0;
+};
+
+// Private TARGET-only chunk-major forward for explicit upstream-global MTP.
+// The owner admits the original per-layer resident view plus the complete
+// evaluation, retains its exact native checkpoint, and supplies rollback.
+// This function neither selects a preliminary B scaffold nor publishes any
+// native accepted state. Draft/feature capture, sampling, feedback and mutable
+// Mean-K publication are disabled. The shared picker runs only AFTER rollback
+// has restored/fenced every native state owned by the caller.
+kvmem::LayerwiseProbeHistorySelection native_layerwise_probe(
+    execution::PrefillContext, std::span<const TokenId> public_input,
+    const kvmem::LayerwiseQueryIdentity&, std::uint32_t physical_history_tokens,
+    const kvmem::KvMemStore&, const kvmem::RawKvStore& frozen_keys,
+    const std::vector<kvmem::LayerwiseQueryGeometry>& targets,
+    kvmem::LayerwiseProbeSelection::SourceRevision,
+    kvmem::HostKvStorage& finite_metadata,
+    const kvmem::LayerwiseQuerySelection::NativeScorer&,
+    const std::function<void()>& prepare_native,
+    const std::function<void()>& restore_and_fence,
+    NativeLayerwiseProbeWork&,
+    const std::vector<std::uint32_t>& mandatory = {},
+    // Heads-TP only: exact full-head BF16 assembly borrows the owning Query's
+    // startup plane and pre-admitted pinned staging before its first advance.
+    const Tensor* tensor_query_storage = nullptr,
+    std::span<std::byte> tensor_host_staging = {});
+
+kvmem::LayerwiseProbeHistorySelection native_layerwise_probe(
+    execution::PrefillContext, std::span<const TokenId> public_input,
+    const kvmem::LayerwiseQueryIdentity&, std::uint32_t physical_history_tokens,
+    const kvmem::KvMemStore&, const kvmem::RawKvStore& frozen_keys,
+    const std::vector<kvmem::LayerwiseQueryGeometry>& targets,
+    kvmem::LayerwiseProbeSelection::SourceRevision,
