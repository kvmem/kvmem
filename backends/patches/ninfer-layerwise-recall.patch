+bool query_storage_overlaps(const void* a, std::size_t a_bytes, const void* b, std::size_t b_bytes) {
+    if (!a_bytes || !b_bytes) return false;
+    const auto first = reinterpret_cast<std::uintptr_t>(a);
+    const auto second = reinterpret_cast<std::uintptr_t>(b);
+    return first >= second ? first - second < b_bytes : second - first < a_bytes;
+}
+void validate_query_storage(const PreparedLayerQueryStorage& storage, const TextConfig& config,
+                            std::int32_t tokens, std::int32_t axes, const WorkspaceArena& work) {
+    if (tokens <= 0 || (axes != 1 && axes != 3))
+        throw std::invalid_argument("prepared Query has invalid row or RoPE axes");
+    const auto dim = dimension(config.attention->head_dim);
+    const auto qh = dimension(config.attention->num_attention_heads);
+    const auto kh = dimension(config.attention->num_key_value_heads);
+    require_tensor_shape(storage.query, DType::BF16, {dim, qh, tokens}, "prepared Query Q");
+    require_tensor_shape(storage.key, DType::BF16, {dim, kh, tokens}, "prepared Query K");
+    require_tensor_shape(storage.value, DType::BF16, {dim, kh, tokens}, "prepared Query V");
+    require_tensor_shape(storage.gate, DType::BF16, {dim, qh, tokens}, "prepared Query gate");
+    require_tensor_shape(storage.residual, DType::BF16, {dimension(config.hidden_size), tokens}, "prepared Query residual");
+    require_tensor_shape(storage.cache_positions, DType::I32, {tokens}, "prepared Query cache positions");
+    require_tensor_shape(storage.rope_positions, DType::I32, {tokens, axes}, "prepared Query RoPE positions");
+    const Tensor* planes[]{&storage.query, &storage.key, &storage.value, &storage.gate,
+                           &storage.residual, &storage.cache_positions, &storage.rope_positions};
+    for (std::size_t i = 0; i < std::size(planes); ++i) {
+        if (planes[i]->data == nullptr || !planes[i]->is_contiguous() ||
+            query_storage_overlaps(planes[i]->data, planes[i]->bytes(), work.base(), work.capacity()))
+            throw std::invalid_argument("prepared Query planes need stable storage outside execution workspace");
+        for (std::size_t j = 0; j < i; ++j)
+            if (query_storage_overlaps(planes[i]->data, planes[i]->bytes(), planes[j]->data, planes[j]->bytes()))
+                throw std::invalid_argument("prepared Query planes overlap");
+    }
+}
+void validate_query_source(const Tensor& source, const Tensor& corresponding,
+                            const PreparedLayerQueryStorage& storage) {
+    const Tensor* planes[]{&storage.query, &storage.key, &storage.value, &storage.gate,
+                           &storage.residual, &storage.cache_positions, &storage.rope_positions};
+    for (const auto* plane : planes) {
+        if (plane == &corresponding && source.data == plane->data && source.bytes() == plane->bytes()) continue;
+        if (query_storage_overlaps(source.data, source.bytes(), plane->data, plane->bytes()))
+            throw std::invalid_argument("prepared Query source aliases a different plane");
+    }
