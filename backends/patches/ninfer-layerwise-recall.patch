diff --git a/src/models/qwen3_5/program/native_layerwise_media.h b/src/models/qwen3_5/program/native_layerwise_media.h
new file mode 100644
index 0000000000000000000000000000000000000000..10f9fb42b4f2a2caeba4f1761d68603a008af2f7
--- /dev/null
+++ b/src/models/qwen3_5/program/native_layerwise_media.h
@@ -0,0 +1,40 @@
+#pragma once
+#include "models/qwen3_5/frontend/prepared_prompt.h"
+#include <algorithm>
+#include <stdexcept>
+
+namespace ninfer::models::qwen3_5::detail {
+inline void validate_layerwise_media(const PreparedPromptData& prompt) {
+    if (prompt.positions.size()!=3*prompt.token_ids.size() || prompt.token_types.size()!=prompt.token_ids.size())
+        throw std::invalid_argument("layerwise native prompt requires complete three-axis input metadata");
+    for (const auto& item:prompt.vision_items) {
+        if (item.token_spans.empty()) throw std::invalid_argument("native media item has no token consumers");
+        std::size_t end=0;
+        for (const auto span:item.token_spans) {
+            if (!span.count || span.begin<end || span.begin>prompt.token_ids.size() ||
+                span.count>prompt.token_ids.size()-span.begin)
+                throw std::invalid_argument("native media token consumers are invalid");
+            end=span.begin+span.count;
+        }
+    }
+}
+inline std::uint64_t layerwise_media_replay_begin(const PreparedPromptData& prompt,
+                                                 std::uint64_t limit,std::uint64_t block) {
+    if (!block || limit>prompt.token_ids.size()) throw std::invalid_argument("invalid native replay source ceiling");
+    validate_layerwise_media(prompt);
+    auto begin=limit/block*block;
+    // Alignment itself can step back into an earlier media item. Iterate to a
+    // fixed point; every change strictly decreases the candidate.
+    bool moved;
+    do {
+        moved=false;
+        for (const auto& item:prompt.vision_items) {
+            if (item.token_spans.empty()) continue;
+            const auto first=item.token_spans.front().begin;
+            const auto& last=item.token_spans.back();const auto end=last.begin+last.count;
+            if (first<begin && begin<end) {begin=first/block*block;moved=true;}
+        }
+    } while (moved);
+    return begin;
+}
+} // namespace ninfer::models::qwen3_5::detail
diff --git a/src/models/qwen3_5/program/native_layerwise_probe.cpp b/src/models/qwen3_5/program/native_layerwise_probe.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..53ae54728702fecbe55c19a9a4e96135f8122c19
--- /dev/null
+++ b/src/models/qwen3_5/program/native_layerwise_probe.cpp
@@ -0,0 +1,227 @@
+#include "models/qwen3_5/program/native_query_runner.h"
+#include "models/qwen3_5/program/native_layerwise_probe.h"
+#include "models/qwen3_5/execution/attention.h"
+#include "models/qwen3_5/execution/stage_runtime.h"
+#include <algorithm>
+#include <exception>
+#include <limits>
+
+namespace ninfer::models::qwen3_5::detail {
+namespace {
+struct ProbeBoundary {
+    kvmem::LayerwiseProbeSelection& selection;
+    const kvmem::LayerwiseQueryIdentity& identity;
+    const kvmem::LayerwiseQuerySelection::NativeScorer& score;
+    const std::vector<kvmem::LayerwiseQueryGeometry>& targets;
+    const execution::Parameters& parameters;
+    NativeLayerwiseProbeWork& work;
+    std::uint64_t begin = 0;
+    std::uint32_t rows = 0;
+    DeviceContext* device=nullptr;
+    const execution::StageRuntime::TensorParallel* tensor=nullptr;
+    const Tensor* full_query=nullptr;
+    std::span<std::byte> host_query;
+    std::size_t attention_ranks=0,target_index=0,head_rank=0;
+
+    void tensor_storage(execution::PrefillContext& context,const Tensor* storage,
+                        std::span<std::byte> host) {
+        if (!parameters.text.tensor_parallel()) {
+            if (storage || !host.empty()) throw std::invalid_argument("single-owner probe received tensor storage");
+            return;
+        }
+        device=&context.execution.device;
+        if (!context.execution.stages || !context.execution.stages->tensor_parallel || !storage || targets.empty())
+            throw std::invalid_argument("native tensor probe lacks its startup-owned complete Q plane");
+        tensor=&*context.execution.stages->tensor_parallel;
+        const auto& config=parameters.model.config().text;
+        const auto capacity=std::min<std::uint64_t>(context.execution.prefill_chunk,
+            identity.evaluation.end-identity.evaluation.begin);
+        const auto width=std::uint64_t(config.attention->query_width());
+        if (device->active_rank()!=0 || tensor->shares.size()!=device->size() ||
+            tensor->shards.size()!=device->size() || !storage->data || storage->dtype!=DType::BF16 ||
+            !storage->is_contiguous() || storage->ne[0]!=config.attention->head_dim ||
+            storage->ne[1]!=config.attention->num_attention_heads || storage->ne[2]<capacity ||
+            storage->ne[3]!=1 || host.size()<width*2*capacity)
+            throw std::invalid_argument("native tensor probe's borrowed plane/staging cannot hold a complete tile");
+        cudaPointerAttributes attributes{};
+        CUDA_CHECK(cudaPointerGetAttributes(&attributes,storage->data));
+        if (attributes.type!=cudaMemoryTypeDevice || attributes.device!=device->rank(0).device)
+            throw std::invalid_argument("native tensor probe Q is not on its rank-0 scoring device");
+        CUDA_CHECK(cudaPointerGetAttributes(&attributes,host.data()));
+        if (attributes.type!=cudaMemoryTypeHost)
+            throw std::invalid_argument("native tensor probe transfer staging is not pinned host memory");
+        std::uint32_t query_next=0,key_next=0;
+        const auto group=config.attention->num_attention_heads/config.attention->num_key_value_heads;
+        for (std::size_t rank=0;rank<device->size();++rank) {
+            const auto& share=tensor->shares[rank];const auto& local=tensor->shards[rank];
+            if (share.attention_positions || share.kv_head_end<share.kv_head_begin)
+                throw std::invalid_argument("native tensor probe requires exact head sharding");
+            const auto k=share.kv_head_end-share.kv_head_begin,q=k*group;
+            if (!k) {
+                if (q) throw std::logic_error("native tensor probe has query heads without a KV owner");
+                continue;
+            }
+            if (rank!=attention_ranks || share.kv_head_begin*group!=query_next || share.kv_head_begin!=key_next ||
+                !local.attention || local.attention->num_attention_heads!=q ||
+                local.attention->num_key_value_heads!=k || local.attention->head_dim!=config.attention->head_dim)
+                throw std::logic_error("native tensor probe head directory overlaps or omits native heads");
+            ++attention_ranks;query_next+=q;key_next+=k;
+        }
+        if (!attention_ranks || query_next!=config.attention->num_attention_heads ||
+            key_next!=config.attention->num_key_value_heads)
+            throw std::logic_error("native tensor probe does not cover the full scoring geometry");
+        full_query=storage;host_query=host;
+    }
+
+    void projected_tensor(const execution::CurrentLayerQueryFrame& frame) {
+        if (target_index>=targets.size() || head_rank>=attention_ranks ||
+            frame.identity.rank!=head_rank || device->active_rank()!=head_rank ||
+            frame.identity.model_layer>=parameters.model.config().text.compact_layer_indices.size() ||
+            parameters.model.config().text.compact_layer_indices[frame.identity.model_layer]!=frame.identity.attention_layer ||
+            frame.identity.attention_layer!=targets[target_index].layer)
+            throw std::logic_error("native tensor probe changed its tile/layer/head-rank order");
+        const auto& share=tensor->shares[head_rank];const auto& geometry=targets[target_index];
+        const auto group=geometry.query_heads/geometry.kv_heads;
+        const auto keys=share.kv_head_end-share.kv_head_begin,heads=keys*group;
+        if (frame.query.dtype!=DType::BF16 || frame.query.ne[0]!=geometry.head_dim ||
+            frame.query.ne[1]!=heads || frame.query.ne[2]!=rows || frame.query.ne[3]!=1 ||
+            frame.query.nb[0]!=2 || frame.query.nb[1]!=std::int64_t(geometry.head_dim)*2 ||
+            frame.key.ne[0]!=geometry.head_dim || frame.key.ne[1]!=keys)
+            throw std::logic_error("native tensor probe projected a different represented head geometry");
+        const auto first=std::max(begin,identity.query.begin),end=std::min(begin+rows,identity.query.end);
+        const auto count=end>first?static_cast<std::uint32_t>(end-first):0;
+        if (count) {
+            const auto q=frame.query.slice(2,static_cast<std::int32_t>(first-begin),static_cast<std::int32_t>(count));
+            const auto pitch=std::size_t(geometry.query_heads)*geometry.head_dim*2;
+            auto* destination=host_query.data()+std::size_t(share.kv_head_begin)*group*geometry.head_dim*2;
+            // A native arena Q is about to be overwritten by this layer's
+            // RoPE. Finish the exact local-head copy before returning. Do not
+            // nest the live residual TensorParallelExchange inside this hook.
+            CUDA_CHECK(cudaMemcpy2DAsync(destination,pitch,q.data,q.nb[2],
+                std::size_t(heads)*geometry.head_dim*2,count,cudaMemcpyDeviceToHost,frame.producer_stream));
+            CUDA_CHECK(cudaStreamSynchronize(frame.producer_stream));
+        }
+        if (++head_rank!=attention_ranks) return;
+        head_rank=0;++target_index;work.projected_target_rows+=rows;
+        if (!count) return;
+        ScopedDeviceRank root(*device,0);
+        const auto q=full_query->slice(2,0,static_cast<std::int32_t>(count));
+        CUDA_CHECK(cudaMemcpyAsync(q.data,host_query.data(),q.bytes(),cudaMemcpyHostToDevice,device->stream));
+        kvmem::NativeCurrentLayerQuery query{q.data,q.bytes(),geometry.layer,count,geometry.query_heads,
+            geometry.kv_heads,geometry.head_dim,geometry.attention_scale,kvmem::NativeQueryScalar::BFloat16,
+            static_cast<std::size_t>(q.nb[2]),static_cast<std::size_t>(q.nb[1]),static_cast<std::size_t>(q.nb[0])};
+        selection.append_native(identity,first,query,score);
+        CUDA_CHECK(cudaStreamSynchronize(device->stream));
+        work.scored_query_rows+=count;
+    }
+    static void projected(void* owner,const execution::CurrentLayerQueryFrame& frame) {
+        auto& p=*static_cast<ProbeBoundary*>(owner);
+        if (p.tensor) {p.projected_tensor(frame);return;}
+        if (frame.identity.model_layer>=p.parameters.text.layers.size() ||
+            frame.identity.rank!=p.parameters.text.layers[frame.identity.model_layer].rank || frame.query.dtype!=DType::BF16 ||
+            frame.query.ne[2]!=p.rows || frame.query.ne[3]!=1 ||
+            frame.query.ne[0]<=0 || frame.query.ne[1]<=0 || frame.key.ne[1]<=0)
+            throw std::logic_error("private native probe projected an unexpected target/rank geometry");
+        p.work.projected_target_rows+=p.rows;
+        const auto begin=std::max(p.begin,p.identity.query.begin);
+        const auto end=std::min(p.begin+p.rows,p.identity.query.end);
+        if (end<=begin) return;
+        const auto offset=static_cast<std::int32_t>(begin-p.begin);
+        const auto count=static_cast<std::int32_t>(end-begin);
+        const auto geometry=std::find_if(p.targets.begin(),p.targets.end(),[&](const auto& target) {
+            return target.layer==frame.identity.attention_layer;
+        });
+        if (geometry==p.targets.end()) throw std::logic_error("private native probe projected a non-target layer");
+        auto q=frame.query.slice(2,offset,count);
+        kvmem::NativeCurrentLayerQuery query{q.data,q.bytes(),frame.identity.attention_layer,
+            static_cast<std::uint32_t>(count),static_cast<std::uint32_t>(q.ne[1]),
+            static_cast<std::uint32_t>(frame.key.ne[1]),static_cast<std::uint32_t>(q.ne[0]),
+            geometry->attention_scale,kvmem::NativeQueryScalar::BFloat16,static_cast<std::size_t>(q.nb[2]),
+            static_cast<std::size_t>(q.nb[1]),static_cast<std::size_t>(q.nb[0])};
+        p.selection.append_native(p.identity,begin,query,p.score);
+        p.work.scored_query_rows+=end-begin;
+    }
+};
+}
+
+kvmem::LayerwiseProbeHistorySelection native_layerwise_probe(
+    execution::PrefillContext context,std::span<const TokenId> input,
+    const kvmem::LayerwiseQueryIdentity& identity,std::uint32_t historical_tokens,
+    const kvmem::KvMemStore& policy,const kvmem::RawKvStore& keys,
+    const std::vector<kvmem::LayerwiseQueryGeometry>& targets,
+    kvmem::LayerwiseProbeSelection::SourceRevision revision,
+    kvmem::HostKvStorage& metadata,const kvmem::LayerwiseQuerySelection::NativeScorer& score,
+    const std::function<void()>& prepare,const std::function<void()>& restore,NativeLayerwiseProbeWork& work,
+    const std::vector<std::uint32_t>& mandatory,const Tensor* tensor_query_storage,
+    std::span<std::byte> tensor_host_staging) {
+    return native_layerwise_probe(context,input,identity,historical_tokens,policy,keys,targets,std::move(revision),
+        metadata,score,prepare,restore,work,mandatory,tensor_query_storage,tensor_host_staging,nullptr,nullptr);
+}
+
+kvmem::LayerwiseProbeHistorySelection native_layerwise_probe(
+    execution::PrefillContext context,std::span<const TokenId> input,
+    const kvmem::LayerwiseQueryIdentity& identity,std::uint32_t historical_tokens,
+    const kvmem::KvMemStore& policy,const kvmem::RawKvStore& keys,
+    const std::vector<kvmem::LayerwiseQueryGeometry>& targets,
+    kvmem::LayerwiseProbeSelection::SourceRevision revision,
+    kvmem::HostKvStorage& metadata,const kvmem::LayerwiseQuerySelection::NativeScorer& score,
+    const std::function<void()>& prepare,const std::function<void()>& restore,NativeLayerwiseProbeWork& work,
+    const std::vector<std::uint32_t>& mandatory,const Tensor* tensor_query_storage,
+    std::span<std::byte> tensor_host_staging,NativeLayerwiseQueryExecution* composed_input,const PreparedPromptData* composed_prompt) {
+    if (!prepare || !restore || !score || !kvmem::valid_layerwise_query_identity(identity) ||
+        identity.evaluation.begin%64 || identity.evaluation.end>input.size() ||
+        identity.evaluation.end>INT32_MAX || historical_tokens>identity.evaluation.begin ||
+        !context.execution.prefill_chunk ||
+        (context.execution.device.size()>1 && !context.execution.stages) ||
+        context.state_source_slot!=context.state_destination_slot)
+        throw std::invalid_argument("private native probe lacks an admitted exact resident source/rollback owner");
+    if (bool(composed_input)!=bool(composed_prompt) ||
+        (composed_input && (!composed_input->input_ready() ||
+            !composed_input->has_composed_input() ||
+            !composed_input->composed_input_matches(identity,*composed_prompt) ||
+            composed_prompt->token_ids.data()!=input.data() || composed_prompt->token_ids.size()!=input.size() ||
+            composed_prompt->positions.size()!=3*input.size())))
+        throw std::invalid_argument("private probe lost its sealed native composed input source");
+    execution::require_current_layer_query_eager(context.execution.device.stream);
+    kvmem::LayerwiseProbeSelection selection(policy,keys,identity,targets,std::move(revision),metadata,mandatory);
+    ProbeBoundary capture{selection,identity,score,targets,context.execution.parameters,work};
+    capture.tensor_storage(context,tensor_query_storage,tensor_host_staging);
+    execution::CurrentLayerQueryBoundary boundary;
+    boundary.owner=&capture;boundary.projected=&ProbeBoundary::projected;
+    // These are private copies of bindings, never mutations of the real
+    // request's capture/parser/auxiliary owner or accepted statistics index.
+    context.execution.memory_statistics=nullptr;
+    context.sampling=nullptr;context.drafter=false;context.mtp_proposal_extent=0;
+    context.readout_count=0;context.first_token={};context.rewrite_checkpoint_hidden=nullptr;
+    context.cache_position_shift=static_cast<std::uint32_t>(identity.evaluation.begin)-historical_tokens;
+    try {
+        // The picker and its retained-result lease were admitted first.
+        prepare();
+        for (auto begin=identity.evaluation.begin;begin<identity.evaluation.end;) {
+            const auto rows=composed_input?composed_input->input_tile_rows(begin):
+                static_cast<std::uint32_t>(std::min<std::uint64_t>(context.execution.prefill_chunk,identity.evaluation.end-begin));
+            capture.begin=begin;capture.rows=rows;capture.target_index=0;capture.head_rank=0;
+            context.text_kv_base=static_cast<std::uint32_t>(begin);
+            const auto result=[&] {
+                if (!composed_input) return execution::prefill_text_chunk(context,input,rows,{},false,&boundary);
+                const auto embeddings=composed_input->composed_probe_embeddings(begin,rows);
+                return execution::prefill_composed_chunk(context,input,static_cast<std::uint32_t>(begin),embeddings,
+                    composed_prompt->positions,composed_prompt->rope_delta,&boundary);
+            }();
+            if (result.processed_tokens!=rows || result.finalized)
+                throw std::logic_error("private native probe changed its complete non-publishing evaluation");
+            if (capture.tensor && (capture.target_index!=targets.size() || capture.head_rank))
+                throw std::logic_error("native tensor probe omitted a target layer or local head share");
+            work.evaluated_rows+=rows;begin+=rows;
+        }
+        context.execution.device.synchronize();
+    } catch (...) {
+        const auto original=std::current_exception();selection.abort();
+        // A restore failure is reported as such by the owner, which must
+        // invalidate its private destination. It cannot publish this attempt.
+        restore();std::rethrow_exception(original);
+    }
+    restore();
+    return selection.finish(identity);
+}
+} // namespace ninfer::models::qwen3_5::detail
