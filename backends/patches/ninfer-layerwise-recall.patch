+std::uint32_t layerwise_mtp_auxiliary_capacity(std::uint32_t main_capacity) {
+    constexpr auto block = static_cast<std::uint32_t>(kPagedKVPageSize);
+    if (!main_capacity || main_capacity % block ||
+        main_capacity > static_cast<std::uint32_t>(std::numeric_limits<std::int32_t>::max()) - block) {
