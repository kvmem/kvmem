+    Tensor with_rows(Tensor t, std::uint32_t n, int axis = 1) const {
+        auto shape = std::array{t.ne[0], t.ne[1], t.ne[2], t.ne[3]}; shape[axis] = dim(n);
+        return Tensor(t.data, t.dtype, {shape[0], shape[1], shape[2], shape[3]});
+    }
+    execution::PreparedLayerQueryStorage storage(std::uint32_t n) const {
+        const auto& capacity=ranks.at(device.active_rank()).capacity;
+        return {with_rows(capacity.query,n,2), with_rows(capacity.key,n,2), with_rows(capacity.value,n,2),
+                with_rows(capacity.gate,n,2), with_rows(capacity.residual,n),
+                with_rows(capacity.cache_positions,n,0), with_rows(capacity.rope_positions,n,0)};
+    }
+    execution::PreparedLayerQueryStorage tensor_storage(std::size_t rank,std::uint32_t n) const {
+        const auto& p=tensor_projection.at(rank);const auto& capacity=ranks.at(rank).capacity;
+        const auto d=dim(config.attention->head_dim);
+        return {Tensor(capacity.query.data,DType::BF16,{d,dim(p.query_heads),dim(n)}),
+            Tensor(capacity.key.data,DType::BF16,{d,dim(p.key_heads),dim(n)}),
+            Tensor(capacity.value.data,DType::BF16,{d,dim(p.key_heads),dim(n)}),
+            Tensor(capacity.gate.data,DType::BF16,{d,dim(p.query_heads),dim(n)}),
+            with_rows(capacity.residual,n),with_rows(capacity.cache_positions,n,0),
+            with_rows(capacity.rope_positions,n,0)};
+    }
+    std::size_t offset(std::uint32_t id, std::uint32_t n) const {
+        std::uint64_t at = 0;
+        for (const auto& p : projected_layout.planes) {
+            if (p.id == id) return addressable(at);
+            at = add(at, multiply(p.row_stride,n));
+        }
+        throw std::logic_error("unknown native Query plane");
+    }
+    std::byte* host(std::uint32_t id, std::uint32_t n) const {
+        return static_cast<std::byte*>(staging->data()) + offset(id,n);
+    }
+    std::byte* tensor_host(std::size_t rank,std::uint32_t id,std::uint32_t n) const {
+        std::uint64_t at=0;
+        for (const auto& plane:tensor_projection.at(rank).layout.planes) {
+            if (plane.id==id) return static_cast<std::byte*>(staging->data())+
+                addressable(add(tensor_projection[rank].staging_offset,at));
+            at=add(at,multiply(plane.row_stride,n));
+        }
+        throw std::logic_error("unknown native tensor Query plane");
+    }
+    std::byte* tensor_extension() const {
+        return static_cast<std::byte*>(staging->data())+addressable(tensor_staging_offset);
+    }
+    void transfer_planes(execution::PreparedLayerQueryStorage& storage,std::uint32_t n,
+                         bool download,std::size_t rank=SIZE_MAX) const {
+        Tensor* fixed[]{&storage.query,&storage.key,&storage.value,&storage.gate,&storage.residual,&storage.cache_positions};
+        auto transfer=[&](std::uint32_t id,void* device_pointer,std::size_t bytes) {
+            auto* cpu=rank==SIZE_MAX?host(id,n):tensor_host(rank,id,n);
+            CUDA_CHECK(cudaMemcpyAsync(download?static_cast<void*>(cpu):device_pointer,
+                download?device_pointer:static_cast<void*>(cpu),bytes,
+                download?cudaMemcpyDeviceToHost:cudaMemcpyHostToDevice,device.stream));
+        };
+        for (std::uint32_t id=0;id<6;++id) transfer(id,fixed[id]->data,fixed[id]->bytes());
+        // A native [n,3] tensor is axis-major, while tape reads are by logical
+        // token. Store each axis independently with its true stride4.
+        for (std::uint32_t axis=0;axis<rope_axes;++axis)
+            transfer(rope_plane(axis),static_cast<std::byte*>(storage.rope_positions.data)+std::size_t(axis)*n*4,std::size_t(n)*4);
+    }
+    void upload_positions(execution::PreparedLayerQueryStorage& storage,std::uint32_t n,std::size_t rank=SIZE_MAX) const {
+        auto address=[&](std::uint32_t id){return rank==SIZE_MAX?host(id,n):tensor_host(rank,id,n);};
+        auto* cache=reinterpret_cast<std::int32_t*>(address(CachePosition));
+        for (std::uint32_t i=0;i<n;++i)
+            cache[i]=static_cast<std::int32_t>(bindings.historical_tokens+cursor-identity.evaluation.begin+i);
+        CUDA_CHECK(cudaMemcpyAsync(storage.cache_positions.data,cache,std::size_t(n)*4,cudaMemcpyHostToDevice,device.stream));
+        for (std::uint32_t axis=0;axis<rope_axes;++axis) {
+            auto* rope=reinterpret_cast<std::int32_t*>(address(rope_plane(axis)));
+            original_rope(rope,cursor,n,axis);
+            CUDA_CHECK(cudaMemcpyAsync(static_cast<std::byte*>(storage.rope_positions.data)+std::size_t(axis)*n*4,
+                rope,std::size_t(n)*4,cudaMemcpyHostToDevice,device.stream));
+        }
+    }
+    void bind(execution::PrefillContext& c, execution::TextContext& card, std::span<const TokenId> public_input,
+              std::uint32_t n, bool continuing_gdn = false) {
+        if (identity.evaluation.end > public_input.size()) throw std::invalid_argument("native Query public input changed extent");
+        auto& rank=ranks.at(device.active_rank());
+        auto ids = with_rows(rank.ids,n,0);
+        CUDA_CHECK(cudaMemcpyAsync(ids.data,public_input.data()+cursor,ids.bytes(),cudaMemcpyHostToDevice,device.stream));
+        card.set_memory_statistics(c.execution.memory_statistics);
+        card.set_current_layer_query_boundary(bindings.attention_boundary);
+        card.set_linear_state_slots(continuing_gdn ? destination_slot : source_slot,destination_slot);
+        card.set_gdn_state_action(execution::GdnStateAction::UpdateInPlace,nullptr);
+        card.set_expert_runtime(c.execution.experts);
+        card.set_rope_yarn(c.execution.rope_yarn);
+        card.set_fast_prefill_kernel(c.execution.fast_prefill_kernel);
+        if (c.execution.memory_statistics) {
+            auto& statistics = *c.execution.memory_statistics;
+            const auto& shard=statistics.ranks.at(device.active_rank());
+            if (statistics.ranks.size()!=device.size() || (!tensor && shard.key_offset) ||
+                statistics.key_width!=config.attention->key_width() || statistics.layers!=config.full_attention_layers)
+                throw std::logic_error("native Query statistics are not owned by the pipeline stage");
+            if (tensor) {
+                const auto& own=tensor_projection.at(device.active_rank());
+                const auto d=config.attention->head_dim;
+                if (shard.key_offset!=own.key_begin*d || shard.query_offset!=own.query_begin*d ||
+                    (own.key_heads && (!shard.key_sums.data || shard.key_sums.ne[0]!=own.key_heads*d ||
+                        shard.first_layer!=0 || shard.key_sums.ne[2]!=config.full_attention_layers)) ||
+                    (!own.key_heads && shard.key_sums.data))
+                    throw std::logic_error("native tensor Query statistics changed its actual head ownership");
+            }
+            if (shard.ranges.data)
+                CUDA_CHECK(cudaMemcpyAsync(shard.ranges.data,ranges.data(),sizeof(ranges),cudaMemcpyHostToDevice,device.stream));
+        }
+        card.query_statistics(ids,static_cast<std::uint32_t>(cursor),rank.origin);
+        // Only the scalar row index crosses ranks. The native table matrix is
+        // already a distinct device copy on each attention-bearing stage.
+        std::int32_t row=tensor_table_row;
+        if (!tensor || !tensor_table_valid) {
+            DeviceBinding head(device.rank(0).device);
+            CUDA_CHECK(cudaMemcpyAsync(&row,c.execution.io.text_kv_table_row.data,4,cudaMemcpyDeviceToHost,device.stream_for_rank(0)));
+            CUDA_CHECK(cudaStreamSynchronize(device.stream_for_rank(0)));
+            if (tensor) {tensor_table_row=row;tensor_table_valid=true;}
+        }
+        { DeviceBinding destination(device.device);
+          // Kernel launch captures this scalar by value. A borrowed pinned
+          // cache-position staging word would be overwritten by project/read
+          // before an asynchronous H2D control copy necessarily consumed it.
+          ops::set_i32_scalar(rank.table_row,row,device.stream); }
+    }
+    void read_residual(std::uint32_t n) {
+        auto residual = with_rows(ranks.at(device.active_rank()).capacity.residual,n);
+        auto* host=tensor?tensor_host(device.active_rank(),Residual,n):static_cast<std::byte*>(staging->data());
+        input->read_rows(identity,input->model_layer(),Residual,cursor,n,host,residual.bytes());
+        CUDA_CHECK(cudaMemcpyAsync(residual.data,host,residual.bytes(),cudaMemcpyHostToDevice,device.stream));
+    }
+    void append_residual(kvmem::QueryProjectionTape& target,std::uint32_t n) {
+        auto residual = with_rows(ranks.at(device.active_rank()).capacity.residual,n);
+        CUDA_CHECK(cudaMemcpyAsync(staging->data(),residual.data,residual.bytes(),cudaMemcpyDeviceToHost,device.stream));
+        CUDA_CHECK(cudaStreamSynchronize(device.stream));
+        target.append(identity,target.model_layer(),cursor,n,{{Residual,staging->data(),residual.bytes()}});
+    }
+    void finish_layer() {
+        output->finish(identity,output->model_layer());
+        input = std::move(output);
+        if (!prompt_input.retain_for_mtp) original_input.reset();
+        projection.reset(); prepared.clear();
+        for (auto& rank:tensor_projection) {rank.tape.reset();rank.prepared.clear();}
+        ++layer; cursor=identity.evaluation.begin;
+        stage=layer==config.layer_types.size()?NativeQueryRunnerStage::FinalNorm:NativeQueryRunnerStage::BeginLayer;
+    }
+    template<class Function>
+    void on_tensor_rank(execution::PrefillContext& c,std::span<const TokenId> public_input,
+        std::uint32_t n,std::size_t rank,Tensor* partial,Function&& function,bool continuing_gdn=false) {
+        ScopedDeviceRank device_rank(device,rank);ScopedArenaRank arena_rank(c.execution.work,rank);
+        execution::TextContext card(c.execution.device,c.execution.parameters,c.execution.work,
+            c.text_kv,c.execution.linear_attention,c.execution.io,c.execution.prefill_hidden,
+            c.execution.prefill_chunk,static_cast<std::uint32_t>(identity.evaluation.begin),{},&c.text_cache,nullptr);
+        card.set_stage_runtime(stages);
+        auto tensor_rank=card.query_tensor_scope(static_cast<std::uint32_t>(rank),partial);
+        bind(c,card,public_input,n,continuing_gdn);
+        function(card);
+    }
+    void tensor_project(execution::PrefillContext& c,std::span<const TokenId> public_input,std::uint32_t n) {
+        const auto global_width=config.attention->query_width();
+        auto* complete_query=tensor_extension();
+        std::memset(complete_query,0,addressable(multiply(multiply(global_width,2),n)));
+        for (std::size_t rank=0;rank<attention_ranks;++rank) {
+            on_tensor_rank(c,public_input,n,rank,nullptr,[&](execution::TextContext& card) {
+                read_residual(n);auto storage=tensor_storage(rank,n);
+                upload_positions(storage,n,rank);
+                auto saved=std::make_unique<execution::PreparedLayerQuery>(
+                    execution::CurrentLayerQueryIdentity{layer,attention,static_cast<std::uint32_t>(rank)},storage);
+                card.project_query_attention(storage.residual,storage.cache_positions,storage.rope_positions,*saved);
+                transfer_planes(storage,n,true,rank);
+                const auto buckets=static_cast<std::uint32_t>((cursor%64+n+63)/64);
+                const auto& layout=tensor_projection[rank].layout;
+                std::memset(tensor_host(rank,KeySum,n),0,addressable(multiply(layout.planes.back().row_stride,n)));
+                if (c.execution.memory_statistics) {
+                    const auto& local=c.execution.memory_statistics->ranks.at(rank);
+                    if (buckets>std::uint32_t(local.key_sums.ne[1]) || attention>=std::uint32_t(local.key_sums.ne[2]))
+                        throw std::length_error("native tensor Query exact sum buckets exceed their admitted shard");
+                    auto sums=local.key_sums.slice(2,dim(attention+1)-1,1).slice(1,0,dim(buckets));
+                    CUDA_CHECK(cudaMemcpyAsync(tensor_host(rank,KeySum,n),sums.data,sums.bytes(),cudaMemcpyDeviceToHost,device.stream));
+                }
+                tensor_projection[rank].prepared.push_back(std::move(saved));
+            });
+        }
+        // Every rank has its own admitted pinned region. All native projections
+        // can run before Host readback drains them, without reusing an in-flight
+        // H2D/D2H source belonging to another device.
+        for (std::size_t rank=0;rank<attention_ranks;++rank) {
+            ScopedDeviceRank device_rank(device,rank);CUDA_CHECK(cudaStreamSynchronize(device.stream));
+            const auto& layout=tensor_projection[rank].layout;
+            std::vector<kvmem::QueryProjectionPlaneBytes> bytes;
+            for (const auto& plane:layout.planes)
+                bytes.push_back({plane.id,tensor_host(rank,plane.id,n),addressable(multiply(plane.row_stride,n))});
+            tensor_projection[rank].tape->append(identity,layer,cursor,n,bytes);
+            // These exact represented Q bytes were already copied for the
+            // required native activation tape. Stitch head ranges without
+            // float conversion, a rank average, or another projection.
+            const auto local_width=std::uint64_t(tensor_projection[rank].query_heads)*config.attention->head_dim;
+            const auto first=std::uint64_t(tensor_projection[rank].query_begin)*config.attention->head_dim;
+            for (std::uint32_t row=0;row<n;++row)
+                std::memcpy(complete_query+addressable(multiply(add(multiply(row,global_width),first),2)),
+                    tensor_host(rank,Query,n)+addressable(multiply(multiply(row,local_width),2)),addressable(multiply(local_width,2)));
+        }
+        // The gate plane is stable and distinct from every local Q plane. Its
+        // original native bytes are on the rank0 tape and are reloaded before
+        // consumption, exactly as between ordinary projection chunks.
+        auto query=with_rows(ranks.front().capacity.gate,n,2);
+        CUDA_CHECK(cudaMemcpyAsync(query.data,complete_query,query.bytes(),cudaMemcpyHostToDevice,device.stream));
+        kvmem::NativeCurrentLayerQuery full{query.data,query.bytes(),attention,n,
+            config.attention->num_attention_heads,config.attention->num_key_value_heads,config.attention->head_dim,
+            bindings.attention_scale,kvmem::NativeQueryScalar::BFloat16,
+            std::size_t(global_width)*2,std::size_t(config.attention->head_dim)*2,2};
+        request.projected_native(identity,cursor,full,bindings.score);
+        CUDA_CHECK(cudaStreamSynchronize(device.stream));
+    }
+    template<class Share>
+    void tensor_exchange(execution::PrefillContext& c,std::span<const TokenId> public_input,
+        std::uint32_t n,std::size_t contributors,Share&& share,bool continuing_gdn=false) {
+        auto& exchange=*stages->tensor_parallel->exchange;
+        const auto slot=exchange_slot;exchange_slot^=1U;
+        const auto values=multiply(config.hidden_size,n),bytes=multiply(values,sizeof(float));
+        if (!contributors || contributors>device.size() || bytes>exchange.slot_bytes())
+            throw std::length_error("native tensor Query mixer exceeds its admitted exchange");
+        // Preserve run_tensor_parallel's exact publish/reduce/complete order.
+        for (std::size_t rank=0;rank<device.size();++rank) {
+            Tensor partial(exchange.partial(rank,slot),DType::FP32,{dim(config.hidden_size),dim(n)});
+            on_tensor_rank(c,public_input,n,rank,rank<contributors?&partial:nullptr,
+                [&](execution::TextContext& card) {
+                    share(rank,card,rank<contributors);
+                    auto residual=with_rows(ranks.at(rank).capacity.residual,n);
+                    exchange.publish(rank,slot,rank<contributors?addressable(bytes):0,residual.data,
+                        device.stream,TensorParallelSum::AddBf16,{},stages->tensor_parallel->prompt_partials);
+                },continuing_gdn);
+        }
+        for (std::size_t rank=0;rank<device.size();++rank) {
+            ScopedDeviceRank device_rank(device,rank);
+            auto residual=with_rows(ranks.at(rank).capacity.residual,n);
+            exchange.reduce(rank,slot,residual.data,static_cast<std::int64_t>(values),contributors,
+                device.stream,TensorParallelSum::AddBf16,{},stages->tensor_parallel->prompt_partials);
+        }
+        for (std::size_t rank=0;rank<device.size();++rank) {
+            ScopedDeviceRank device_rank(device,rank);
+            auto residual=with_rows(ranks.at(rank).capacity.residual,n);
+            exchange.complete(rank,slot,residual.data,static_cast<std::int64_t>(values),device.stream,
+                TensorParallelSum::AddBf16,{},stages->tensor_parallel->prompt_partials);
+        }
+    }
+    void tensor_chunk(execution::PrefillContext& c,std::span<const TokenId> public_input,
+        std::uint32_t n,bool full) {
+        const auto buckets=static_cast<std::uint32_t>((cursor%64+n+63)/64);
+        auto* complete_sums=tensor_extension();
+        if (full) std::memset(complete_sums,0,addressable(multiply(multiply(buckets,config.attention->key_width()),4)));
+        tensor_exchange(c,public_input,n,full?attention_ranks:device.size(),
+            [&](std::size_t rank,execution::TextContext& card,bool contributes) {
+                if (!full || !contributes) {
+                    read_residual(n);
+                    if (!full) {auto residual=with_rows(ranks.at(rank).capacity.residual,n);card.query_gdn_mixer(layer,residual);}
+                    return;
+                }
+                auto storage=tensor_storage(rank,n);auto& projection=tensor_projection.at(rank);
+                for (const auto& plane:projection.layout.planes)
+                    projection.tape->read_rows(identity,layer,plane.id,cursor,n,tensor_host(rank,plane.id,n),addressable(multiply(plane.row_stride,n)));
+                transfer_planes(storage,n,false,rank);
+                const auto width=std::uint64_t(projection.key_heads)*config.attention->head_dim;
+                const auto first=std::uint64_t(projection.key_begin)*config.attention->head_dim;
+                for (std::uint32_t bucket=0;bucket<buckets;++bucket)
+                    std::memcpy(complete_sums+addressable(multiply(add(multiply(bucket,config.attention->key_width()),first),4)),
+                        tensor_host(rank,KeySum,n)+addressable(multiply(multiply(bucket,width),4)),addressable(multiply(width,4)));
+                auto& saved=*projection.prepared.at(ordinal(cursor));
+                const auto live=static_cast<std::uint32_t>(bindings.historical_tokens+cursor-identity.evaluation.begin+n);
+                card.consume_query_attention(saved,ranks.at(rank).table_row,{live,live,c.execution.fast_prefill_kernel,false,true});
+            },!full && cursor!=identity.evaluation.begin);
+        tensor_exchange(c,public_input,n,device.size(),[&](std::size_t rank,execution::TextContext& card,bool) {
+            auto residual=with_rows(ranks.at(rank).capacity.residual,n);card.query_post_mixer(layer,residual);
+        });
+        device.synchronize();
+        auto residual=with_rows(ranks.front().capacity.residual,n);
+        if (bindings.layer_output) bindings.layer_output(layer,cursor,residual,device.stream);
+        append_residual(*output,n);
+        if (full) {
+            if (bindings.commit_mean) bindings.commit_mean(attention,cursor,n,
+                {reinterpret_cast<const float*>(complete_sums),addressable(multiply(buckets,config.attention->key_width()))});
+            request.attended(identity,cursor,n);
+        }
+    }
+    void project(execution::PrefillContext& c, execution::TextContext& card, std::uint32_t n) {
+        read_residual(n);
+        auto s=storage(n);
+        upload_positions(s,n);
+        auto saved=std::make_unique<execution::PreparedLayerQuery>(execution::CurrentLayerQueryIdentity{layer,attention,
+            static_cast<std::uint32_t>(device.active_rank())},s);
+        card.project_query_attention(s.residual,s.cache_positions,s.rope_positions,*saved);
+        kvmem::NativeCurrentLayerQuery q{s.query.data,s.query.bytes(),attention,n,
+            config.attention->num_attention_heads,config.attention->num_key_value_heads,config.attention->head_dim,
+            bindings.attention_scale,kvmem::NativeQueryScalar::BFloat16,
+            std::size_t(config.attention->query_width())*2,std::size_t(config.attention->head_dim)*2,2};
+        request.projected_native(identity,cursor,q,bindings.score);
+        transfer_planes(s,n,true);
+        const auto buckets=static_cast<std::uint32_t>((cursor%64+n+63)/64);
+        std::memset(host(KeySum,n),0,addressable(multiply(projected_layout.planes.back().row_stride,n)));
+        if (c.execution.memory_statistics) {
+            const auto& shard=c.execution.memory_statistics->ranks.at(device.active_rank());
+            if (buckets>std::uint32_t(shard.key_sums.ne[1])) throw std::length_error("native Query key sums exceed planned buckets");
+            if (attention<shard.first_layer || attention-shard.first_layer>=std::uint32_t(shard.key_sums.ne[2]))
+                throw std::logic_error("native Query exact key sums are owned by another stage");
+            auto sums=shard.key_sums.slice(2,dim(attention-shard.first_layer+1)-1,1).slice(1,0,dim(buckets));
+            CUDA_CHECK(cudaMemcpyAsync(host(KeySum,n),sums.data,sums.bytes(),cudaMemcpyDeviceToHost,device.stream));
+        }
+        CUDA_CHECK(cudaStreamSynchronize(device.stream));
+        std::vector<kvmem::QueryProjectionPlaneBytes> values;
+        for (const auto& p:projected_layout.planes)
+            values.push_back({p.id,host(p.id,n),addressable(multiply(p.row_stride,n))});
+        projection->append(identity,layer,cursor,n,values);
+        prepared.push_back(std::move(saved));
+    }
+    void consume(execution::PrefillContext& c, execution::TextContext& card, std::uint32_t n) {
+        auto s=storage(n);
+        for (const auto& p:projected_layout.planes)
+            projection->read_rows(identity,layer,p.id,cursor,n,host(p.id,n),addressable(multiply(p.row_stride,n)));
+        transfer_planes(s,n,false);
+        auto& saved=*prepared.at(ordinal(cursor));
+        const auto live=static_cast<std::uint32_t>(bindings.historical_tokens+cursor-identity.evaluation.begin+n);
+        card.consume_query_attention(saved,ranks.at(device.active_rank()).table_row,{live,live,c.execution.fast_prefill_kernel,false,true});
+        card.query_post_mixer(layer,s.residual);
+        if (bindings.layer_output) bindings.layer_output(layer,cursor,s.residual,device.stream);
+        // Preserve statistics while append_residual reuses the beginning of the
+        // staging buffer; the native sum plane follows every residual byte.
+        append_residual(*output,n);
+        if (bindings.commit_mean) {
+            const auto buckets=static_cast<std::uint32_t>((cursor%64+n+63)/64);
+            bindings.commit_mean(attention,cursor,n,{reinterpret_cast<const float*>(host(KeySum,n)),
+                addressable(multiply(buckets,config.attention->key_width()))});
+        }
+        request.attended(identity,cursor,n);
+    }
+};
