+            credit.image_bytes=state_images->host_layout().image_bytes;
+            credit.index_bound=index;credit.checkpoint_bound=metadata;credit.pool=memory_checkpoint_pool;
+            credit.feedback_bound=owner->feedback_snapshot_bytes;
+            credit.metadata=layerwise_source_account->reserve(admission_add(index,admission_add(metadata,credit.feedback_bound)));
+            credit.image=memory_checkpoint_pool->acquire(credit.image_bytes);
+            owner->checkpoints.push_back(std::move(credit));
+        };
+        for (std::uint32_t i=0;i<phases.checkpoint_count;++i) reserve_phase(phases.checkpoints[i]);
+        // Ordinary PromptTail is required unless a structural input checkpoint
+        // suppresses it. Media cannot be divided. A saved nearby surrogate may
+        // still make this credit unnecessary; detach releases that unused lease.
+        if (!envelope.query) if (const auto point=window.prefill_checkpoint();point && *point>source_h &&
+            !memory_input_reuse_frontier(staged.prompt) &&
+            *point==layerwise_media_replay_begin(staged.prompt,*point,64))
+            reserve_phase({NativeLayerwiseCheckpointRole::PrefillBoundary,static_cast<std::uint32_t>(*point),true});
+        const auto& policy=prospective?prospective->coverage.policy():
+            continuation_states.at(transaction.destination.value).window.coverage.policy();
+        if (policy.enabled) {
+            // Images are already in the real pool. Count the unpublished CP
+            // metadata exactly once, alongside all peers' future CP credits.
+            auto used=native_checkpoint_policy_bytes();
+            for (const auto& credit:owner->checkpoints) used=admission_add(used,credit.checkpoint_bound);
+            if (kvmem_options.disk_bytes) used=admission_add(used,state_images->host_layout().image_bytes);
