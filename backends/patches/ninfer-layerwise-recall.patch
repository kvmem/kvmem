+bool plane(const Tensor& t,DType dtype,std::uint64_t count) {
+    if (!t.data || t.dtype!=dtype) return false;
+    std::uint64_t size=1;
+    for (auto extent:t.ne) {
+        if (extent<=0 || size>std::uint64_t(INT64_MAX)/static_cast<std::uint32_t>(extent)) return false;
+        size*=static_cast<std::uint32_t>(extent);
+    }
+    return size==count && t.is_contiguous();
+}
