+++ b/src/models/qwen3_5/program/storage/layerwise_feedback.h
@@ -0,0 +1,94 @@
+#pragma once
+#include "ninfer/layerwise_request.h"
+
+#include "kvmem/layerwise_pressure.hpp"
+#include "models/qwen3_5/program/storage/layerwise_source.h"
+#include <bit>
+#include <memory>
+#include <optional>
+#include <span>
+#include <stdexcept>
+
+namespace ninfer::models::qwen3_5::detail {
+
+// Immutable accepted policy state travels with its exact native layer maps.
+// Runtime capture buffers and unaccepted candidate mass never enter a snapshot.
+// Checkpoints share this value; the next accepted update publishes a new value.
+struct NativeLayerwiseFeedbackSnapshot {
+    kvmem::LayerwisePrefillOptions options;
+    kvmem::LayerwisePrefillSnapshot prefill;
+    std::optional<kvmem::LayerwiseOutputSnapshot> output;
+    kvmem::LayerwiseOutputOptions output_options;
+    std::array<std::int32_t,5> markers{};
+    // Accepted snapshots retain their Program account through CP aliases.
+    NativeSourceVersionCharge metadata;
+    std::optional<KvmemQuerySpan> original_query;
+
+    void validate(kvmem::SessionIdentity session,std::uint32_t frontier,std::span<const std::uint32_t> models) const {
+        if (!metadata.account() || metadata.bytes()<allocated_bytes())
+            throw std::logic_error("native accepted feedback has no complete retained metadata lease");
+        if (prefill.session!=session || prefill.layers.size()!=models.size() ||
+            (output && (output->session!=session || output->layers.size()!=models.size() || output->accepted_end>frontier)))
+            throw std::logic_error("native feedback snapshot belongs to another accepted owner");
+        for (std::size_t i=0;i<models.size();++i) {
+            if (prefill.layers[i].model_layer!=models[i] || prefill.layers[i].end>frontier ||
+                (output && output->layers[i].model_layer!=models[i]))
+                throw std::logic_error("native feedback snapshot differs from accepted layer/frontier");
+        }
+    }
+
+    std::uint64_t allocated_bytes() const noexcept {
+        std::uint64_t bytes=sizeof(*this)+64+prefill.layers.capacity()*sizeof(kvmem::LayerwisePrefillState);
+        for (const auto& layer:prefill.layers) bytes+=layer.values.capacity()*sizeof(kvmem::LayerwisePrefillValue);
+        if (output) {
+            bytes+=output->layers.capacity()*sizeof(kvmem::LayerwiseOutputState);
+            for (const auto& layer:output->layers)
+                bytes+=(layer.scores.capacity()+layer.pending.capacity())*sizeof(std::pair<std::uint64_t,double>);
+        }
+        return bytes;
+    }
+    void append_identity(std::vector<std::uint8_t>& bytes) const {
+        const auto word=[&](std::uint64_t v) {for (int b=0;b<8;++b) bytes.push_back(std::uint8_t(v>>(b*8)));};
+        const auto scalar=[&](double v) {word(std::bit_cast<std::uint64_t>(v));};
+        word(bool(original_query));if (original_query) {word(original_query->begin);word(original_query->end);}
+        word(options.block_tokens);word(options.select_tokens);word(options.reserve_tokens);
+        word(options.interval);word(options.stride);scalar(options.half_life);
+        word(prefill.session.id);word(prefill.session.incarnation);word(prefill.layers.size());
+        for (const auto& layer:prefill.layers) {
+            word(layer.model_layer);word(layer.end);word(layer.samples);word(layer.chunks);word(layer.values.size());
+            for (const auto& value:layer.values) {word(value.original_start);scalar(value.mass);scalar(value.exposure);}
+        }
+        word(bool(output));
+        if (output) {
+            word(std::uint64_t(output_options.scope));word(output_options.interval);scalar(output_options.decay);word(output_options.commit_max_bytes);
+            for (auto id:markers) word(std::uint32_t(id));
+            word(output->session.id);word(output->session.incarnation);word(output->request);word(output->accepted_end);word(output->active);
+            word(output->parser.thinking);word(output->parser.action);word(output->parser.tokens);word(output->layers.size());
+            for (const auto& layer:output->layers) {
+                word(layer.model_layer);word(layer.samples);word(layer.rounds);
+                word(layer.scores.size());for (const auto& v:layer.scores) {word(v.first);scalar(v.second);}
+                word(layer.pending.size());for (const auto& v:layer.pending) {word(v.first);scalar(v.second);}
+            }
+        }
+    }
+    std::shared_ptr<const NativeLayerwiseFeedbackSnapshot> funded_copy(NativeSourceVersionCharge charge) const {
+        if (!charge.account() || charge.bytes()<allocated_bytes())
+            throw std::logic_error("immutable feedback copy has no complete independent funding");
+        auto next=std::make_shared<NativeLayerwiseFeedbackSnapshot>();
+        next->options=options;next->prefill=prefill;next->output=output;
+        next->output_options=output_options;next->markers=markers;next->original_query=original_query;
+        if (next->allocated_bytes()>charge.bytes())
+            throw std::length_error("immutable feedback copy exceeded its preadmitted capacity");
+        charge.shrink(next->allocated_bytes());next->metadata=std::move(charge);return next;
+    }
+    std::shared_ptr<const NativeLayerwiseFeedbackSnapshot> fork(kvmem::SessionIdentity session) const {
+        if (!metadata.account()) throw std::logic_error("native feedback fork has no retained metadata account");
+        auto charge=metadata.account()->reserve(allocated_bytes());
+        auto next=std::make_shared<NativeLayerwiseFeedbackSnapshot>();
+        next->options=options;next->prefill=prefill;next->output=output;next->original_query=original_query;
+        next->output_options=output_options;next->markers=markers;
+        charge.shrink(next->allocated_bytes());next->metadata=std::move(charge);
+        next->prefill.session=session;if (next->output) next->output->session=session;return next;
+    }
+};
+} // namespace ninfer::models::qwen3_5::detail
diff --git a/src/models/qwen3_5/program/storage/layerwise_kv_state.h b/src/models/qwen3_5/program/storage/layerwise_kv_state.h
