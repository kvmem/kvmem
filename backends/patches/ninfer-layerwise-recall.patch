+            controls>available-reducers-2*matrices)
+            throw std::length_error("native pending full-layer feedback exceeds its explicit host account");
+        for (const auto& map:maps.target) {
+            kvmem::LayerwisePrefillMass mass;mass.model_layer=map.model_layer;
+            if (!query) {
+                for (auto id:map.pages) mass.history.push_back(std::uint64_t(id)*64);
+                for (auto id=begin/64;std::uint64_t(id)*64<std::uint64_t(begin)+count;++id)
+                    if (mass.history.empty() || mass.history.back()!=std::uint64_t(id)*64) mass.history.push_back(std::uint64_t(id)*64);
+                if (mass.history.size()!=columns) throw std::logic_error("native prefill physical extent differs from its layer map");
+            }
+            for (std::uint64_t i=0;i<columns;++i) mass.starts.push_back(i*64);
+            mass.masses.resize(std::size_t(next.rows.size())*columns);
