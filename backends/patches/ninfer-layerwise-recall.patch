diff --git a/src/models/qwen3_5/program/native_graph_frame.h b/src/models/qwen3_5/program/native_graph_frame.h
new file mode 100644
index 0000000000000000000000000000000000000000..f0722b8f1fda83ef6d56d0e1039ffbeeebd919fc
--- /dev/null
+++ b/src/models/qwen3_5/program/native_graph_frame.h
@@ -0,0 +1,70 @@
+#pragma once
+#include "kvmem/memory_contract.hpp"
+#include "ninfer/base.h"
+#include <array>
+#include <cstdint>
+#include <stdexcept>
+
+namespace ninfer::models::qwen3_5::detail {
+struct NativeGraphOutputRowIdentity {
+    std::uint64_t request=0,lane_epoch=0;
+    kvmem::MemoryStamp source;
+    std::uint32_t lane=0,begin=0,local=0,valid=0;
+    std::int32_t table=-1;
+    bool operator==(const NativeGraphOutputRowIdentity&) const = default;
+};
+struct NativeGraphOutputIdentity {
+    std::uint32_t physical=0,batch=0;
+    std::array<NativeGraphOutputRowIdentity,kMaximumConcurrency> rows{};
+    bool operator==(const NativeGraphOutputIdentity&) const = default;
+    void validate() const {
+        if (!physical || physical>64 || !batch || batch>rows.size())
+            throw std::logic_error("graph Output has invalid native cohort dimensions");
+        for (std::uint32_t i=0;i<batch;++i) {
+            const auto& r=rows[i];
+            if (!r.request || !r.lane_epoch || r.lane>=kMaximumConcurrency || r.table<0 ||
+                !r.source.valid || !r.source.session.id || r.source.frontier!=r.begin ||
+                !r.valid || r.valid>physical || r.local>r.begin)
+                throw std::logic_error("graph Output has an invalid row owner/physical identity");
+            for (std::uint32_t j=0;j<i;++j)
+                if (rows[j].lane==r.lane || rows[j].request==r.request || rows[j].table==r.table)
+                    throw std::logic_error("graph Output has duplicate cohort ownership");
+        }
+        for (std::uint32_t i=batch;i<rows.size();++i)
+            if (rows[i]!=NativeGraphOutputRowIdentity{})
+                throw std::logic_error("graph Output has hidden rows outside its actual batch");
+    }
+};
+// Host-only identity/epoch state used by the actual Program storage. GPU fences
+// stay in that storage; reaching Fenced here requires complete epoch readback.
+class NativeGraphOutputFrame {
+public:
+    explicit NativeGraphOutputFrame(std::uint64_t previous_epoch=0):next_(previous_epoch) {}
+    std::uint64_t arm(const NativeGraphOutputIdentity& identity) {
+        identity.validate();
+        if (epoch_ || next_==UINT64_MAX) throw std::logic_error("graph Output is pending or exhausted its epoch domain");
+        identity_=identity;epoch_=++next_;fenced_=false;return epoch_;
+    }
+    void verify(std::uint64_t epoch,const NativeGraphOutputIdentity& identity) const {
+        if (!epoch || epoch!=epoch_ || identity!=identity_)
+            throw std::logic_error("graph Output belongs to a different request/source/physical epoch");
+    }
+    void mark_fenced(std::uint64_t epoch) {
+        if (!epoch || epoch!=epoch_ || fenced_) throw std::logic_error("graph Output fenced a foreign or completed epoch");
+        fenced_=true;
+    }
+    void release(std::uint64_t epoch) {
+        if (!epoch || epoch!=epoch_ || !fenced_) throw std::logic_error("graph Output cannot release before its full native fence");
+        epoch_=0;fenced_=false;
+    }
+    // Caller must drain actual native streams before discarding an active frame.
+    void discard_after_drain(std::uint64_t epoch) noexcept {
+        if (epoch && epoch==epoch_) {epoch_=0;fenced_=false;}
+    }
+    std::uint64_t epoch() const noexcept {return epoch_;}
+private:
+    NativeGraphOutputIdentity identity_;
+    std::uint64_t next_=0,epoch_=0;
+    bool fenced_=false;
+};
+} // namespace ninfer::models::qwen3_5::detail
