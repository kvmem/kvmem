+std::shared_ptr<const NativeCanonicalHistoryVersion> ProgramImpl::freeze_canonical_source(SequenceState& sequence) {
+    return freeze_canonical_source(sequence,nullptr);
+}
+std::shared_ptr<const NativeCanonicalHistoryVersion> ProgramImpl::freeze_canonical_source(
+    SequenceState& sequence,NativeSourceVersionCharge* admitted) {
+    auto& window=sequence.window;const auto frontier=sequence.text_kv_valid;
+    if (!frontier || window.layerwise_rewrite_pending || !window.source_versions ||
+        frontier!=window.statistics_frontier || !window.statistics)
+        throw std::logic_error("immutable native source requires an admitted complete accepted prefix");
+    if (window.canonical_source && window.canonical_source->frontier==frontier) {
+        window.canonical_source->validate();return window.canonical_source;
+    }
+    WindowMemoryBackend backend(*this,sequence,frontier);
+    auto descriptor=backend.descriptor();const auto pages=kv_pages_for_tokens(frontier);
+    const auto estimate=sizeof(NativeCanonicalHistoryVersion)+64+NativeCanonicalHistoryVersion::descriptor_bytes(descriptor)+
+        std::uint64_t(pages)*(sizeof(kvmem::HostKvRecord)+sizeof(std::uint32_t))+window.statistics->allocated_bytes();
+    if (admitted && admitted->account()!=window.source_versions)
+        throw std::logic_error("native canonical source credit belongs to another Program account");
+    auto charge=admitted?admitted->split(estimate):window.source_versions->reserve(estimate);
+    archive_memory_window(sequence);
+    auto version=std::make_shared<NativeCanonicalHistoryVersion>();version->descriptor=std::move(descriptor);
+    version->accepted=window.stamp;version->frontier=frontier;
+    version->epoch=window.layer_views.active() && window.layer_views.source_epoch?
+        window.layer_views.source_epoch:next_canonical_epoch.fetch_add(1);
+    version->records.reserve(pages);version->valid_tokens.reserve(pages);
+    for (std::uint32_t id=0;id<pages;++id) {
+        const auto valid=valid_columns(id,frontier);
+        if (!window.archive[id] || window.host_versions[id]!=valid)
+            throw std::logic_error("immutable native source lacks complete sealed canonical bytes");
+        // The spill path leaves the accepted partial page writable for ordinary
+        // appends. This version freezes its complete accepted image; fork() makes
+        // subsequent writes detach before changing any checkpoint-owned bytes.
+        window.archive[id].seal();
+        version->records.push_back(window.archive[id].fork());version->valid_tokens.push_back(valid);
+    }
+    version->mean_index=window.statistics->fork_mean_prefix(frontier);
+    charge.shrink(version->metadata_bytes());version->charge=std::move(charge);version->validate();
+    window.canonical_source=version;if (window.layer_views.active()) window.layer_views.source_epoch=version->epoch;
+    return version;
+}
+
+void ProgramImpl::begin_layerwise_request(SequenceState& sequence,RequestControl& request,std::uint64_t id,
+    kvmem::LayerwiseRequestEnvelope envelope,NativeLayerwiseRequestOptions options) {
+    if (sequence.window.layerwise_request || sequence.window.layerwise_rewrite_pending)
+        throw std::logic_error("native layerwise request is already active");
+    // A fresh history has not passed through a transfer/checkpoint bridge yet.
+    // Establish its accepted native identity before the request validates its
+    // owner. This only initializes an absent session; an invalidated existing
+    // session still fails and cannot be revived by a resource-admission retry.
+    WindowMemoryBackend accepted(*this,sequence,sequence.text_kv_valid);
+    std::shared_ptr<NativeLayerwiseAdmission> admitted;
+    if (auto* transaction=std::get_if<MaterializationTransaction>(&context_transaction_);
+        transaction && transaction->destination.value==sequence.lane && transaction->memory_history &&
+        transaction->memory_history->work) {
+        admitted=transaction->memory_history->work->layerwise_admission;
+        if (!admitted) throw std::logic_error("public native input has no complete Waiting resource owner");
+    }
+    sequence.window.layerwise_request=std::make_unique<NativeLayerwiseRequest>(*this,sequence,request,id,
+        std::move(envelope),std::move(options),std::move(admitted));
+}
+
