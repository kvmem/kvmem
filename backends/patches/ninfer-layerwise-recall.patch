+namespace ninfer::models::qwen3_5::detail {
+void NativeLayerwiseMtpBoundary::rebuild(ProgramImpl& p,SequenceState& sequence,
+    execution::PrefillContext& context,std::int32_t next_token,
+    std::span<const std::int32_t> rope,bool proposal) {
+    rebuild(p,sequence,context,next_token,rope,proposal,nullptr);
+}
+void NativeLayerwiseMtpBoundary::rebuild(ProgramImpl& p,SequenceState& sequence,
+    execution::PrefillContext& context,std::int32_t next_token,
+    std::span<const std::int32_t> original_rope,bool build_proposal,const Tensor* next_embedding) {
+    auto& window=sequence.window;const auto frontier=sequence.text_kv_valid;
+    if (p.kvmem_options.recall_strategy!=kvmem::RecallStrategy::Layerwise ||
+        p.speculative_backend!=SpeculativeBackend::Mtp ||
+        &context.execution.device!=&p.device || &context.execution.parameters!=&p.parameters ||
+        !frontier || frontier>INT32_MAX || !sequence.kv || !sequence.kv->backend ||
+        !p.backend_kv_pages || !p.backend_kv_addresses || !p.io.mtp || !context.mtp_kv.valid() ||
+        window.layerwise_rewrite_pending || !window.stamp.valid || !window.layer_views.active() ||
+        !window.layer_views.has_auxiliary || !window.source_versions ||
+        !sequence.tail_hidden_valid || original_rope.size()!=3 || next_token<0 ||
+        std::uint32_t(next_token)>=p.parameters.model.resources().public_token_count)
+        throw std::logic_error("native layerwise MTP boundary lacks its complete accepted text/own-KV source");
+    if (next_embedding && (!next_embedding->data || next_embedding->dtype!=DType::BF16 ||
+        next_embedding->ne[0]!=p.parameters.model.config().text.hidden_size ||
+        next_embedding->ne[1]!=1 || !next_embedding->is_contiguous()))
+        throw std::invalid_argument("native MTP boundary requires its actual one-column composed embedding");
+    execution::require_current_layer_query_eager(p.device.stream);
+    DeviceBinding binding(p.device.rank(0).device);
+    const auto local=p.backend_kv_addresses->committed_frontier(*sequence.kv->backend);
+    const auto expected=frontier-window.layer_views.auxiliary_removed_tokens;
+    if (local!=expected || expected>p.kvmem_window_tokens ||
+        (sequence.mtp_kv_valid!=frontier && sequence.mtp_kv_valid!=frontier-1))
+        throw std::logic_error("native MTP boundary differs from its accepted auxiliary extent");
+    const auto id=(frontier-1)/64,valid=(frontier-1)%64+1;
+    if (id>=window.archive.size() || id>=window.host_versions.size() ||
+        !window.archive[id] || window.host_versions[id]!=valid)
+        throw std::logic_error("native MTP boundary has no complete canonical accepted record");
+    const auto found=std::lower_bound(window.layer_views.auxiliary_pages.begin(),
+        window.layer_views.auxiliary_pages.end(),id);
+    const bool resident=found!=window.layer_views.auxiliary_pages.end() && *found==id;
+    const auto slot=resident?std::uint32_t(found-window.layer_views.auxiliary_pages.begin()):local/64;
+    if ((!resident && (frontier%64 || local%64 || local>p.kvmem_window_tokens-64 || frontier>INT32_MAX-63)) ||
+        (resident && slot*64+valid!=local))
+        throw std::logic_error("native MTP boundary has no admitted suffix scratch or actual last-row coordinate");
+    if (build_proposal && (!context.mtp_proposal_extent || context.mtp_proposal_extent>p.draft_window ||
+        !context.mtp_cache || context.mtp_cache!=p.decoder->mtp_cache() ||
+        context.mtp_cache->max_context()!=p.kvmem_window_tokens+64U ||
+        std::uint64_t(local)+context.mtp_proposal_extent-1>context.mtp_cache->max_context()))
+        throw std::length_error("native MTP boundary proposal exceeds its admitted physical draft extent");
+    const auto lead=build_proposal?context.mtp_proposal_extent-1:0;
+    auto& pool=p.backend_kv_pages->physical_pool();const auto layout=plan_host_kv_page_layout(pool.geometry());
+    const auto offset=p.text_host_kv_page_stride;
+    if (window.archive[id].size()!=offset+layout.page_stride)
+        throw std::logic_error("native MTP boundary canonical record geometry changed");
+    const auto limit=window.layerwise_request?window.layerwise_request->options().query.transfer_staging_host_bytes:
+        p.kvmem_options.layerwise.staging_bytes;
+    if (layout.page_stride>limit)
+        throw std::length_error("native MTP boundary exceeds finite transfer staging");
+    // Detach the full native record before touching any Device byte. Target
+    // planes, scales and every other own-KV row retain their exact source bits.
+    auto replacement=window.archive[id].fork();std::byte first;
+    replacement.read(0,&first,1);replacement.write(0,&first,1);
+    std::unique_ptr<PinnedHostBuffer> staging;
+    if (!p.memory_kv_staging || p.memory_kv_staging->size()<layout.page_stride || p.memory_kv_staging->size()>limit)
+        staging=std::make_unique<PinnedHostBuffer>(layout.page_stride);
+    const auto native_streams=RankStreams::compute(p.device);
+    std::unique_ptr<KVLayerStripeWrite> writer;
+    if (resident) {
+        p.backend_kv_addresses->ensure_mapped_to_tokens(*sequence.kv->backend,local+lead,native_streams);
+        writer=std::make_unique<KVLayerStripeWrite>(*p.backend_kv_addresses,*sequence.kv->backend,
+            slot,1,p.device,native_streams);
+    }
+    else {
+        // Prior AR guesses are not accepted history of the new request. The
+        // scratch page stays inside C and never joins the logical resident set.
+        p.backend_kv_addresses->destructive_truncate(*sequence.kv->backend,local);
+        p.backend_kv_addresses->ensure_mapped_to_tokens(*sequence.kv->backend,local+64,native_streams);
+        KVLayerStripeWrite::require_unpublished_suffix_destination(*p.backend_kv_addresses,
+            *sequence.kv->backend,pool,slot,1);
+    }
