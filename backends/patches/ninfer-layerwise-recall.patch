+// Source-only integration reference: native token copier + actual physical
+// planner. This is not a Native model/acceptance/stream qualification.
+#include "models/qwen3_5/program/ngram_proposer.h"
+#include "models/qwen3_5/program/native_output_physical.h"
+#include <algorithm>
+#include <iostream>
+#include <numeric>
+#include <stdexcept>
+#include <vector>
+
+using namespace ninfer;
+using namespace ninfer::models::qwen3_5::detail;
+static void require(bool value,const char* what) {if (!value) throw std::runtime_error(what);}
+template<class F> static void rejects(F&& f) {
+    bool failed=false;try {f();} catch (const std::exception&) {failed=true;}
+    require(failed,"expected physical admission refusal");
+}
+int main() {
+    constexpr std::uint32_t C=256,BT=64;
+    std::vector<std::int32_t> source(256);std::iota(source.begin(),source.end(),1000);
+    NgramProposer copier(512,2048);copier.ingest(source);
+    const auto history=std::span<const std::int32_t>(source).first(64);
+    std::uint64_t cases=0;
+    for (std::uint32_t copy=1;copy<=63;++copy) for (std::uint32_t neural=1;neural<=15;++neural) {
+        const auto match=copier.propose_for_round(history,copy,neural,12);
+        require(match.tokens.size()==copy && std::equal(match.tokens.begin(),match.tokens.end(),source.begin()+64),
+            "native copier changed or shortened a complete exact source");
+        const auto physical=copy+1;
+        for (std::uint32_t valid=1;valid<=physical;++valid) {
+            const auto L=C-valid;
+            const auto mtp=plan_native_output_physical(C,L,L,valid,physical,SpeculativeBackend::Mtp,neural);
+            require(mtp.physical_target_rows==physical && mtp.valid_rows==valid,
+                "accepted-valid count changed full physical copy compute");
+            require(mtp.main_begin==L && mtp.main_end==C,"padded verifier rows became Main history");
+            require(mtp.auxiliary_begin==L && mtp.auxiliary_end==C+neural-1 && mtp.auxiliary_end<=C+BT,
+                "original licensed alignment/AR cannot fit one own scratch block");
+            const auto df=plan_native_output_physical(C,L,0,valid,physical,SpeculativeBackend::DFlash2,neural);
+            require(df.main_end==C && df.physical_target_rows==physical && df.noise_rows==neural+1,
+                "copy verifier changed the independent configured neural noise geometry");
+            ++cases;
+        }
+    }
+    const auto edge=plan_native_output_physical(C,C-1,C-1,1,64,SpeculativeBackend::Mtp,15);
+    require(edge.main_end==C && edge.auxiliary_end==C+14 && edge.physical_target_rows==64,
+        "valid1 shortened physical64 or expanded accepted Main capacity");
+    // The native token copier legitimately has N<D when a full source follows.
+    // The source-only candidate's explicit copy entry must not run neural noise
+    // or inherit an unused D<=N constraint; actual Native regression is pending.
+    require(copier.propose_for_round(history,1,3,12).tokens.size()==1,"narrow complete copy is not reachable");
+    rejects([&]{plan_native_output_physical(C,C,0,1,64,SpeculativeBackend::DFlash2,3);});
+    rejects([&]{plan_native_output_physical(C,C-1,C-1,2,64,SpeculativeBackend::Mtp,3);});
+    rejects([&]{plan_native_output_physical(C,0,0,1,65,SpeculativeBackend::Mtp,3);});
+    rejects([&]{plan_native_output_physical(C,0,0,1,64,SpeculativeBackend::None,0);});
+    rejects([&]{plan_native_output_physical(C,0,0,1,64,SpeculativeBackend::Mtp,16);});
+    std::cout<<"layerwise native copy/physical reference cases="<<cases<<" passed\n";
+}
