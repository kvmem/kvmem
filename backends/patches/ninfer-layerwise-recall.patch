+                checkpoint?checkpoint->history.scores->capacity():0);
+            metadata=admission_add(metadata,admission_add(admission_mul(compact_pages,sizeof(std::uint64_t)),
+                admission_mul(score_capacity,sizeof(double))));
+            metadata=admission_add(metadata,admission_add(graph.bytes(),admission_add(feedback,maps)));
