+                     storage.cache_positions, kv_table_row, envelope);
+        if (current_layer_query_boundary_ != nullptr && current_layer_query_boundary_->attended != nullptr)
+            current_layer_query_boundary_->attended(current_layer_query_boundary_->owner,
+                {prepared.identity_,storage.query,storage.cache_positions,kv_table_row,ctx_.stream});
