+        window.selector=std::move(q.policy);window.statistics_frontier=end;window.graph=std::move(graph);
+        window.query_capture=false;window.query_replayed=false;window.query_replay_active=false;
+        window.query_tokens=0;window.query_sums.clear();for (auto& rows:window.query_rows) rows.clear();
+        s.text_kv_valid=end;if (p.backend_kv_pages) {s.mtp_kv_valid=end;s.mtp_draft_count=q.input_owner->initial_mtp_extent;}
+        if (q.dflash_features) {s.dflash_context_frontier=end;s.dflash_context_floor=0;}
+        p.settle_state_fork(s);window.layerwise_rewrite_pending=false;
+        if (window.layerwise_request) window.layerwise_request->accept_query(stamp);
+        q.transaction->accepted(q.identity,std::move(accepted));
+        q.request.prefill->cursor=end;q.accepted=true;
+    } catch (...) { q.abort();throw; }
+}
+void NativeLayerwiseProgramQuery::abort() noexcept { if (impl_) impl_->abort(); }
+void ProgramImpl::begin_layerwise_query(SequenceState& sequence,RequestControl& request,
+    execution::PrefillContext& context,std::uint64_t id,std::shared_ptr<KvmemPrefixCheckpoint> checkpoint,
+    NativeLayerwiseQueryResources resources) {
+    if (!request.prefill || request.prefill->layerwise_query || sequence.window.layerwise_rewrite_pending)
+        throw std::logic_error("native Program Query owner is already active");
+    const NativeQueryWorkIdentity lease{sequence.lane,lane_epochs.at(sequence.lane),id};
+    if (!layerwise_query_work.acquire(lease))
+        throw kvmem::MemoryError(kvmem::MemoryErrorCode::Pending,"another request owns the Program Query work slot");
+    try {
+        request.prefill->layerwise_query=std::make_unique<NativeLayerwiseProgramQuery>(*this,sequence,request,context,
+            id,std::move(checkpoint),std::move(resources));
+    } catch (...) {layerwise_query_work.release(lease);throw;}
+}
