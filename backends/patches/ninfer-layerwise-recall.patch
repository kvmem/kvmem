+std::size_t layerwise_mtp_scratch_device_bytes(
+    std::uint32_t main_capacity, std::int32_t kv_heads, std::int32_t head_dim,
+    KvCacheStorage storage, std::int32_t table_rows) {
+    const auto auxiliary_capacity = layerwise_mtp_auxiliary_capacity(main_capacity);
+    if (table_rows <= 0) throw std::invalid_argument("auxiliary scratch requires positive native table rows");
+    const auto groups = std::uint64_t(page_count(main_capacity)) * static_cast<std::uint32_t>(table_rows);
+    const auto extra = static_cast<std::uint32_t>(table_rows);
+    if (groups > std::numeric_limits<std::uint32_t>::max() - extra)
+        throw std::overflow_error("auxiliary scratch physical page count overflows");
+    LayoutBuilder nominal, expanded;
+    LayoutBuilder* nominal_builders[] = {&nominal};
+    LayoutBuilder* expanded_builders[] = {&expanded};
+    (void)plan_cache(nominal_builders, {}, {}, 0, 1, main_capacity, kv_heads, head_dim,
+        storage, table_rows, static_cast<std::uint32_t>(groups), false);
+    (void)plan_cache(expanded_builders, {}, {}, 0, 1, auxiliary_capacity, kv_heads, head_dim,
+        storage, table_rows, static_cast<std::uint32_t>(groups) + extra, false);
+    const auto before = nominal.finish(256), after = expanded.finish(256);
+    if (after < before) throw std::logic_error("auxiliary scratch shrank its native allocation");
+    return after - before;
+}
