+NativeLayerwiseRequest::NativeLayerwiseRequest(ProgramImpl& p,SequenceState& s,RequestControl& r,std::uint64_t id,
+    kvmem::LayerwiseRequestEnvelope e,NativeLayerwiseRequestOptions o)
+    :NativeLayerwiseRequest(p,s,r,id,std::move(e),std::move(o),{}) {}
+NativeLayerwiseRequest::NativeLayerwiseRequest(ProgramImpl& p,SequenceState& s,RequestControl& r,std::uint64_t id,
+    kvmem::LayerwiseRequestEnvelope e,NativeLayerwiseRequestOptions o,std::shared_ptr<NativeLayerwiseAdmission> admitted)
+    :impl_(std::make_unique<Impl>(p,s,r,id,std::move(e),std::move(o),std::move(admitted))) {}
+std::uint64_t NativeLayerwiseRequest::checkpoint_metadata_reserved() const noexcept {
+    if (!impl_->admission) return 0;
+    std::uint64_t result=0;
+    for (const auto& credit:impl_->admission->checkpoints) if (!credit.consumed) result+=credit.checkpoint_bound;
+    return result;
+}
+std::unique_ptr<NativeLayerwiseCheckpointCredit> NativeLayerwiseRequest::take_checkpoint_admission(
+    NativeLayerwiseCheckpointRole role,std::uint32_t frontier,std::uint64_t bytes) {
+    auto& q=*impl_;q.owner();
+    if (!q.admission) return {}; // Existing direct Native fixture interface.
+    if (role==NativeLayerwiseCheckpointRole::General) {
+        // Purpose names remain native/legacy metadata. The first required
+        // aligned source snapshot can serve PromptTail/InputFallback aliases.
+        if (q.admission->has(NativeLayerwiseCheckpointRole::QueryBoundary,frontier) && query_due())
+            role=NativeLayerwiseCheckpointRole::QueryBoundary;
+        else if (q.admission->has(NativeLayerwiseCheckpointRole::PrefillBoundary,frontier))
+            role=NativeLayerwiseCheckpointRole::PrefillBoundary;
+        else return {};
+    }
+    return std::make_unique<NativeLayerwiseCheckpointCredit>(q.admission->take(role,frontier,bytes));
+}
+void NativeLayerwiseRequest::prepare_feedback_admission(ProgramImpl& p,NativeLayerwiseAdmission& admission,
+    const kvmem::LayerwiseRequestEnvelope& envelope,const kvmem::LayerwisePrefillOptions& pf) {
+    const auto parent_limit=p.kvmem_options.layerwise.metadata_bytes/8;
+    if (!parent_limit || admission.account()!=p.layerwise_source_account)
+        throw std::logic_error("native Waiting feedback has no fixed Program metadata partitions");
+    if (!p.layerwise_feedback_account)
+        p.layerwise_feedback_account=std::make_shared<NativeSourceVersionAccount>(parent_limit);
+    if (p.layerwise_feedback_account->limit()!=parent_limit || admission.feedback_runtime_account ||
+        admission.retained_feedback_credit.account() || admission.query_feedback_growth.account())
+        throw std::logic_error("native Waiting feedback duplicated or changed its Program account");
+    const auto entitlement=plan_native_feedback_workspace(envelope,p.capacity,
+        p.parameters.model.config().text.full_attention_layers,static_cast<std::uint32_t>(p.device.size()),
+        64U,pf,sizeof(Impl));
+    admission.feedback_workspace_bytes=entitlement.workspace_bytes;
+    admission.feedback_query_extra_bytes=entitlement.query_extra_bytes;
+    admission.feedback_snapshot_bytes=entitlement.snapshot_bytes;
+    admission.query_feedback_required=feedback_add(entitlement.query_extra_bytes,native_output_fixed_metadata_bytes);
+    const auto existing=p.layerwise_query_feedback_pool.bytes();
+    const auto missing=admission.query_feedback_required>existing?admission.query_feedback_required-existing:0;
+    // Keep the growth private until successful physical publication. Peer
+    // Waiting owners may reserve overlapping deltas; commit consumes only the
+    // still missing bytes and releases the remainder, never shrinking oldpool.
+    admission.query_feedback_growth=p.layerwise_feedback_account->reserve(missing);
+    admission.feedback_runtime_account=reserve_native_feedback_workspace(p.layerwise_feedback_account,
+        entitlement.workspace_bytes,feedback_add(entitlement.workspace_bytes,entitlement.query_extra_bytes));
+    admission.retained_feedback_credit=p.layerwise_source_account->reserve(entitlement.snapshot_bytes);
+}
+
+NativeLayerwiseRequest::~NativeLayerwiseRequest() {abort();}
+std::uint32_t NativeLayerwiseRequest::admit_prefill(std::uint32_t desired) {
+    auto& q=*impl_;q.owner();if (q.credit) throw std::logic_error("native tile already owns a credit");
+    if (q.capture) {
+        auto& c=*q.capture;
+        if ((!c.no_refresh && !c.split_prefill) || q.sequence.text_kv_valid!=std::uint64_t(c.begin)+c.accepted_chunks)
+            throw std::logic_error("native tile already owns a capture");
+        const auto n=std::min(desired,c.count-c.accepted_chunks);
+        if (n) {q.credit=q.sequence.window.stamp;q.credit_count=n;}return n;
+    }
+    auto state=q.state();const auto action=q.window.action(state);
+    if (action==kvmem::LayerwiseWindowAction::Query) return 0;
+    if (action==kvmem::LayerwiseWindowAction::Pressure) {
+        const auto catalog=q.p.layerwise_catalog(q.sequence);std::vector<std::uint64_t> mandatory;
+        // Literal resident-only Pressure uses no recent band. Query's separate
+        // sink/recent policy never becomes a set of Pressure hard pins.
+        const auto budget=q.window.selection_budget(state.history);
+        kvmem::validate_layerwise_selection_bands({q.options.sink_blocks,q.options.recent_blocks},64,budget,true);
+        const auto choices=q.output?q.output->select(catalog,*q.prefill,mandatory,budget,q.options.sink_blocks):
+            q.prefill->select(catalog,mandatory,budget,q.options.sink_blocks);
+        q.p.compact_layerwise_pressure(q.sequence,choices);state=q.state();
+    } else if (action==kvmem::LayerwiseWindowAction::Chunk || action==kvmem::LayerwiseWindowAction::Exhausted)
+        throw std::length_error("native layerwise request cannot admit this semantic/exhausted boundary");
+    const auto n=q.window.admit(state,desired);if (n>UINT32_MAX) throw std::length_error("native tile exceeds native coordinates");
+    if (n) {q.credit=q.sequence.window.stamp;q.credit_count=static_cast<std::uint32_t>(n);}return static_cast<std::uint32_t>(n);
+}
+void NativeLayerwiseRequest::prepare_prefill(std::uint32_t begin,std::uint32_t count) {
+    prepare_prefill(begin,count,count);
+}
+void NativeLayerwiseRequest::prepare_prefill(std::uint32_t begin,std::uint32_t count,std::uint32_t native_rows) {
+    auto& q=*impl_;q.owner();
+    if (!q.credit || *q.credit!=q.sequence.window.stamp || count!=q.credit_count || begin!=q.credit->frontier)
+        throw std::logic_error("native prefill does not match its untouched exact tile credit");
+    if (!native_rows) native_rows=count;
+    if (!native_rows || native_rows>count) throw std::logic_error("native prefill tile exceeds its semantic credit");
+    if (q.capture && (q.capture->no_refresh || q.capture->split_prefill)) {
+        if (begin!=std::uint64_t(q.capture->begin)+q.capture->accepted_chunks ||
+            count>q.capture->count-q.capture->accepted_chunks)
+            throw std::logic_error("native split prefill tile lost its whole-span reservation");
+        q.credit_count=native_rows;return;
+    }
+    q.prepare(begin,count,static_cast<std::uint32_t>(q.state().visible_tokens),false);
+    q.capture->split_prefill=native_rows<count;q.credit_count=native_rows;
+}
+const execution::CurrentLayerQueryBoundary& NativeLayerwiseRequest::boundary() const {return impl_->boundary;}
+void NativeLayerwiseRequest::accept_prefill(std::uint32_t begin,std::uint32_t end) {
+    auto& q=*impl_;
+    if (q.capture && (q.capture->no_refresh || q.capture->split_prefill)) {
+        auto& c=*q.capture;q.owner();
+        if (!q.credit || begin!=q.credit->frontier || begin!=std::uint64_t(c.begin)+c.accepted_chunks ||
+            end!=std::uint64_t(begin)+q.credit_count || end!=q.sequence.window.stamp.frontier ||
+            std::any_of(c.seen.begin(),c.seen.end(),[&](auto n){return n!=end-c.begin;}))
+            throw std::logic_error("native no-refresh Query tile has not completed every target layer");
+        if (q.output) q.output->accept_prefill(q.sequence.window.stamp,q.request_id,begin);
+        c.accepted_chunks=end-c.begin;q.credit.reset();q.credit_count=0;
+        if (c.accepted_chunks==c.count) {q.accept(q.sequence.window.stamp);q.end_query_workspace();}
+        else q.publish();
+        return;
+    }
+    if (!q.capture || q.capture->query || q.capture->begin!=begin || end!=std::uint64_t(begin)+q.capture->count)
+        throw std::logic_error("native accepted prefill differs from its captured tile");q.accept(q.sequence.window.stamp);
+}
+void NativeLayerwiseRequest::prepare_query(std::uint32_t begin,std::uint32_t count,std::uint32_t local) {
+    impl_->begin_query_workspace(false);
+    try {impl_->prepare(begin,count,local,true);}
+    catch (...) {impl_->capture.reset();impl_->end_query_workspace();throw;}
+}
+void NativeLayerwiseRequest::restored_query_view(std::uint32_t model,const kvmem::ExecutionView& view) {impl_->restored(model,view);}
+void NativeLayerwiseRequest::accept_query(const kvmem::MemoryStamp& accepted) {
+    if (!impl_->capture || !impl_->capture->query) throw std::logic_error("native Query has no pending accepted matrix");impl_->accept(accepted);impl_->end_query_workspace();
+}
+bool NativeLayerwiseRequest::query_refresh_required() const {
+    const auto& q=*impl_;q.owner();const auto state=q.state();
+    if (q.window.action(state)!=kvmem::LayerwiseWindowAction::Query)
+        throw std::logic_error("native Query refresh gate requires the exact aligned evaluation boundary");
+    return state.history>=q.window.selection_budget(state.history);
+}
+bool NativeLayerwiseRequest::prepare_mtp_probe_window() {
+    auto& q=*impl_;q.owner();const auto state=q.state();
+    if (q.capture || q.credit || !query_refresh_required() ||
+        q.p.speculative_backend!=SpeculativeBackend::Mtp ||
+        q.p.kvmem_options.layerwise_mtp_history!=kvmem::LayerwiseMtpHistory::UpstreamGlobal)
+        throw std::logic_error("native private probe preparation lacks its untouched explicit Query boundary");
+    const auto evaluation=q.window.query_evaluation();
+    if (!evaluation || evaluation->begin!=state.history)
+        throw std::logic_error("native private probe has not reconstructed its aligned accepted source");
+    const auto rows=evaluation->end-evaluation->begin;
+    if (state.visible_tokens+rows<=q.window.capacity()-64) return false;
+    const auto budget=std::min<std::uint64_t>(state.history,q.options.prefill.select_tokens);
+    const auto catalog=q.p.layerwise_catalog(q.sequence);std::vector<std::uint64_t> mandatory;
+    kvmem::validate_layerwise_selection_bands({q.options.sink_blocks,q.options.recent_blocks},64,budget,true);
+    const auto choices=q.output?q.output->select(catalog,*q.prefill,mandatory,budget,q.options.sink_blocks):
+        q.prefill->select(catalog,mandatory,budget,q.options.sink_blocks);
+    q.p.compact_layerwise_pressure(q.sequence,choices);
+    if (q.state().visible_tokens+rows>q.window.capacity()-64)
+        throw std::length_error("native startup-K resident Pressure did not admit the complete private probe");
+    q.publish();return true;
+}
+bool NativeLayerwiseRequest::prepare_import_start() {
+    auto& q=*impl_;q.owner();
+    if (q.capture || q.credit) throw std::logic_error("native import Pressure requires its untouched accepted source");
+    const auto start=kvmem::plan_layerwise_import(q.window,q.state());
+    if (!start.pressure()) return false;
+    const auto catalog=q.p.layerwise_catalog(q.sequence);std::vector<std::uint64_t> mandatory;
+    // The public import keeps its accepted partial append tail. This is the
+    // reference preserve_tail geometry, separate from configured sink bands.
+    if (q.sequence.text_kv_valid%64) mandatory.push_back(q.sequence.text_kv_valid/64);
+    kvmem::validate_layerwise_selection_bands({q.options.sink_blocks,q.options.recent_blocks},64,start.selection_budget,true);
+    // begin() already reset the new request's N while preserving old S.
+    // Never re-decay a closed old scope or infer scores from recency.
+    const auto choices=q.output?q.output->select(catalog,*q.prefill,mandatory,start.selection_budget,q.options.sink_blocks):
+        q.prefill->select(catalog,mandatory,start.selection_budget,q.options.sink_blocks);
+    q.p.compact_layerwise_pressure(q.sequence,choices);
+    if (q.state().visible_tokens!=start.restore_tokens)
+        throw std::logic_error("native import Pressure differs from exact partial-tail restore extent");
+    q.publish();return true;
+}
+void NativeLayerwiseRequest::prepare_no_refresh_query() {
+    auto& q=*impl_;q.owner();const auto state=q.state();
+    if (q.capture || q.credit || query_refresh_required())
+        throw std::logic_error("native no-refresh Query is not an unstarted below-budget evaluation");
+    const auto evaluation=q.window.query_evaluation();
+    if (!evaluation || evaluation->begin!=state.history || evaluation->end-evaluation->begin>UINT32_MAX)
+        throw std::logic_error("native no-refresh Query has not restored its aligned source");
+    const auto count=static_cast<std::uint32_t>(evaluation->end-evaluation->begin);
+    if (q.window.admit(state,count)!=count)
+        throw std::length_error("native no-refresh Query has no complete physical reservation");
+    // Existing native maps are the attention domain. No source freeze, current-Q
+    // scorer, projection tape or canonical stripe restore belongs on this path.
+    q.begin_query_workspace(true);
+    try {
+        q.prepare(static_cast<std::uint32_t>(state.history),count,static_cast<std::uint32_t>(state.visible_tokens),false);
+        q.capture->query=true;q.capture->no_refresh=true;
+        if (!q.p.prepare_window(q.sequence,static_cast<std::uint32_t>(evaluation->begin),
+                static_cast<std::uint32_t>(evaluation->end),false,false))
+            throw std::logic_error("native atomic no-refresh Query preparation did not finish");
+    } catch (...) {q.capture.reset();q.end_query_workspace();throw;}
+}
+void NativeLayerwiseRequest::detach_prefill() {
+    auto& q=*impl_;q.owner();if (q.capture || q.credit) throw std::logic_error("native input cannot retire pending capture/credit");
+    if (q.admission) {q.admission->finish_input();q.admission.reset();}
+    q.input_owner=nullptr;q.input=nullptr;
+}
+std::uint32_t NativeLayerwiseRequest::admit_output(std::uint32_t desired) {
+    if (impl_->input_owner || !desired || desired>64) throw std::logic_error("native Output requires a retired prefill and bounded candidate extent");
+    if (impl_->credit) {
+        impl_->owner();
+        if (impl_->capture || impl_->native_started || *impl_->credit!=impl_->sequence.window.stamp)
+            throw std::logic_error("Output preflight credit changed before cohort preparation");
+        return std::min(desired,impl_->credit_count);
+    }
+    // Inspect the literal action at every accepted block boundary. Keeping a
+    // native physical draft width does not authorize skipping H%BT==0 when a
+    // variable accepted prefix crosses that boundary.
+    desired=std::min(desired,64u-static_cast<std::uint32_t>(impl_->state().history%64));
+    return admit_prefill(desired);
+}
+NativeOutputPhysicalPlan NativeLayerwiseRequest::prepare_output_physical(
+    std::uint32_t valid_rows,std::uint32_t physical_target_rows) {
+    auto& q=*impl_;q.owner();
+    if (q.physical_grant) {
+        if (q.physical_grant->control || q.input_owner || q.capture || q.native_started || !q.credit || *q.credit!=q.sequence.window.stamp ||
+            !valid_rows || valid_rows>q.physical_grant->plan.valid_rows ||
+            physical_target_rows<valid_rows || physical_target_rows>q.physical_grant->plan.physical_target_rows)
+            throw std::logic_error("cohort cannot widen its preadmitted physical Output grant");
+        auto& grant=q.physical_grant->plan;
+        const auto next=plan_native_output_physical(q.p.kvmem_window_tokens,grant.main_begin,
+            grant.auxiliary_begin,valid_rows,physical_target_rows,q.p.speculative_backend,q.p.draft_window);
+        // Keep the already admitted private mapping until Native Rawresolve.
+        // destructive_truncate cannot extend committed coverage to an
+        // unconsumed future AR end; close_physical_grant releases the surplus.
+        grant=next;return grant;
+    }
+    if (q.input_owner || q.capture || !q.credit ||
+        *q.credit!=q.sequence.window.stamp || !valid_rows || valid_rows>q.credit_count ||
+        physical_target_rows>q.p.widest_verify_window()+1U)
+        throw std::logic_error("native physical Output differs from its untouched exact credit");
+    const auto state=q.state();
+    const auto removed=q.sequence.window.layer_views.has_auxiliary
+        ?q.sequence.window.layer_views.auxiliary_removed_tokens:q.sequence.window.removed_tokens;
+    if (state.visible_tokens>UINT32_MAX ||
+        (q.p.speculative_backend==SpeculativeBackend::Mtp && q.sequence.mtp_kv_valid<removed))
+        throw std::logic_error("native physical Output has invalid accepted coverage");
+    const auto auxiliary=q.p.speculative_backend==SpeculativeBackend::Mtp
+        ?q.sequence.mtp_kv_valid-removed:0U;
+    const auto plan=plan_native_output_physical(q.p.kvmem_window_tokens,
+        static_cast<std::uint32_t>(state.visible_tokens),auxiliary,valid_rows,
+        physical_target_rows,q.p.speculative_backend,q.p.draft_window);
+    if (q.p.speculative_backend==SpeculativeBackend::Mtp) {
+        if (!q.sequence.kv->backend || !q.p.backend_kv_cache() ||
+            q.p.backend_kv_cache()->max_context()!=q.p.kvmem_window_tokens+64U ||
+            q.p.backend_kv_addresses->entitlement(*q.sequence.kv->backend)<q.p.kvmem_window_tokens/64U+1U ||
+            q.p.backend_kv_addresses->committed_frontier(*q.sequence.kv->backend)!=auxiliary ||
+            auxiliary!=state.visible_tokens)
+            throw std::logic_error("native MTP physical Output lacks its fixed independent scratch block");
+    }
+    q.reclaim_metadata();
+    auto metadata=q.runtime_metadata.split(sizeof(Impl::PhysicalGrant)+64);
+    // Only true verifier columns create canonical history slots. The extra
+    // native MTP AR rows are private device mappings, never published records.
+    try {
+        if (!q.p.prepare_window(q.sequence,q.sequence.text_kv_valid,
+                q.sequence.text_kv_valid+valid_rows,false,false,kvmem::SelectionReason::DecodePressure))
+            throw std::logic_error("native physical Output did not finish accepted-row preparation");
+        if (q.p.speculative_backend==SpeculativeBackend::Mtp)
+            q.p.backend_kv_addresses->ensure_mapped_to_tokens(*q.sequence.kv->backend,
+                plan.auxiliary_end,q.p.compute_streams);
+        q.physical_grant.emplace(Impl::PhysicalGrant{plan,q.sequence.text_kv_valid,std::move(metadata)});
+    } catch (...) {
+        // No native model work was submitted. Preserve only original accepted
+        // coverage; allocation failure cannot leave a future scratch mapping.
+        q.p.device.synchronize();
+        q.p.text_kv_addresses->destructive_truncate(q.sequence.kv->text,plan.main_begin);
+        if (q.p.speculative_backend==SpeculativeBackend::Mtp)
+            q.p.backend_kv_addresses->destructive_truncate(*q.sequence.kv->backend,auxiliary);
+        throw;
+    }
+    return plan;
+}
+NativeOutputPhysicalPlan NativeLayerwiseRequest::prepare_dflash_output_physical(
+    std::uint32_t valid_rows,std::uint32_t target_rows,std::uint32_t noise_rows) {
+    auto& q=*impl_;q.owner();
+    if (q.p.speculative_backend!=SpeculativeBackend::DFlash2 ||
+        noise_rows>std::max(q.p.draft_window,q.p.ngram_draft_window)+1U || noise_rows==1)
+        throw std::logic_error("DF2 physical noise differs from its explicit native round domain");
+    (void)prepare_output_physical(valid_rows,target_rows);
+    q.physical_grant->plan.noise_rows=noise_rows;return q.physical_grant->plan;
+}
+void NativeLayerwiseRequest::prepare_output_control(std::uint32_t rows) {
+    auto& q=*impl_;q.owner();
+    if (q.input_owner || q.capture || q.native_started || !q.credit || *q.credit!=q.sequence.window.stamp ||
+        !rows || rows>q.credit_count) throw std::logic_error("forced control lost its exact untouched Output credit");
+    const auto state=q.state();
+    const auto removed=q.sequence.window.layer_views.has_auxiliary
+        ?q.sequence.window.layer_views.auxiliary_removed_tokens:q.sequence.window.removed_tokens;
+    if (state.visible_tokens>UINT32_MAX || (q.p.speculative_backend==SpeculativeBackend::Mtp && q.sequence.mtp_kv_valid<removed))
+        throw std::logic_error("forced control has invalid accepted auxiliary coverage");
+    const auto auxiliary=q.p.speculative_backend==SpeculativeBackend::Mtp?q.sequence.mtp_kv_valid-removed:0U;
+    if (q.p.speculative_backend==SpeculativeBackend::Mtp &&
+        (!q.sequence.kv->backend || !q.p.backend_kv_cache() ||
+         q.p.backend_kv_cache()->max_context()!=q.p.kvmem_window_tokens+64U ||
+         q.p.backend_kv_addresses->committed_frontier(*q.sequence.kv->backend)!=auxiliary ||
+         auxiliary!=state.visible_tokens))
+        throw std::logic_error("forced control lost its exact accepted MTP teacher-forced prefix");
+    const auto plan=plan_native_output_control(q.p.kvmem_window_tokens,
+        static_cast<std::uint32_t>(state.visible_tokens),auxiliary,rows,q.p.speculative_backend);
+    if (q.physical_grant) {
+        if (!q.physical_grant->control || rows>q.physical_grant->plan.valid_rows)
+            throw std::logic_error("forced control cannot replace a neural verifier grant");
+        q.physical_grant->plan=plan;return;
+    }
+    q.reclaim_metadata();auto metadata=q.runtime_metadata.split(sizeof(Impl::PhysicalGrant)+64);
+    try {
+        if (!q.p.prepare_window(q.sequence,q.sequence.text_kv_valid,q.sequence.text_kv_valid+rows,false,false,
+                kvmem::SelectionReason::DecodePressure))
+            throw std::logic_error("forced control did not finish exact accepted-row preparation");
+        q.physical_grant.emplace(Impl::PhysicalGrant{plan,q.sequence.text_kv_valid,std::move(metadata),true});
+    } catch (...) {
+        q.p.device.synchronize();q.p.text_kv_addresses->destructive_truncate(q.sequence.kv->text,plan.main_begin);
+        if (q.p.speculative_backend==SpeculativeBackend::Mtp)
+            q.p.backend_kv_addresses->destructive_truncate(*q.sequence.kv->backend,auxiliary);
+        throw;
+    }
+}
+void NativeLayerwiseRequest::prepare_output(std::uint32_t begin,std::span<const TokenId> consumed) {
+    auto& q=*impl_;q.owner();
+    if (q.input_owner || !q.credit || *q.credit!=q.sequence.window.stamp || consumed.empty() ||
+        consumed.size()>q.credit_count || begin!=q.credit->frontier ||
+        (q.physical_grant && consumed.size()!=q.physical_grant->plan.valid_rows))
+        throw std::logic_error("native consumed Output differs from its untouched exact tile credit");
+    if (std::any_of(consumed.begin(),consumed.end(),[](auto id){return id<0;})) throw std::logic_error("native Output token domain is invalid");
+    const std::vector<std::uint32_t> tokens(consumed.begin(),consumed.end());
+    q.prepare(begin,static_cast<std::uint32_t>(tokens.size()),static_cast<std::uint32_t>(q.state().visible_tokens),false,&tokens);
+    q.bind_output_statistics_controls();
+    // Fixed native speculative profiles can carry fewer valid candidates than
+    // their admitted maximum. Only this exact supplied prefix is forwarded.
+    q.credit_count=static_cast<std::uint32_t>(tokens.size());
+}
+void NativeLayerwiseRequest::accept_output(const kvmem::MemoryStamp& stamp,std::uint32_t accepted) {
+    if (!impl_->capture || !impl_->capture->output || impl_->capture->deferred_output) throw std::logic_error("native Output has no token-bound candidate matrix");impl_->accept(stamp,accepted);
+}
+void NativeLayerwiseRequest::prepare_output_candidates(std::uint32_t begin,std::uint32_t count) {
+    auto& q=*impl_;q.owner();
+    if (q.input_owner || !q.credit || *q.credit!=q.sequence.window.stamp || !count || count>q.credit_count || begin!=q.credit->frontier ||
+        (q.physical_grant && count!=q.physical_grant->plan.valid_rows))
+        throw std::logic_error("native candidate Output differs from its exact untouched credit");
+    q.prepare(begin,count,static_cast<std::uint32_t>(q.state().visible_tokens),false,nullptr,true);
+    q.bind_output_statistics_controls();q.credit_count=count;
+}
+void NativeLayerwiseRequest::accept_output_tokens(const kvmem::MemoryStamp& stamp,std::span<const TokenId> consumed) {
+    if (!impl_->capture || !impl_->capture->deferred_output || consumed.empty())
+        throw std::logic_error("native deferred Output has no resolved consumed prefix");
+    impl_->accept(stamp,static_cast<std::uint32_t>(consumed.size()),consumed);
+}
+void NativeLayerwiseRequest::discard_output() {
+    auto& q=*impl_;q.owner();
+    if (q.graph_epoch || !q.capture || !q.capture->output || !q.credit || *q.credit!=q.sequence.window.stamp ||
+        !q.sequence.window.layer_views.feedback || !q.sequence.window.layer_views.feedback->output)
+        throw std::logic_error("native speculative discard differs from its untouched accepted source");
+    const auto& saved=*q.sequence.window.layer_views.feedback;
+    std::vector<std::uint32_t> models;
+    for (const auto& layer:saved.prefill.layers) models.push_back(layer.model_layer);
+    auto restored=std::make_unique<kvmem::LayerwiseOutputPressure>(q.sequence.window.stamp.session,models,
+        q.options.prefill,q.options.markers,q.options.output);
+    restored->restore(*saved.output,q.sequence.text_kv_valid);
+    q.output_work.discarded_candidate_tokens+=q.capture->count;
+    q.close_physical_grant();
+    q.output=std::move(restored);q.capture.reset();q.credit.reset();q.credit_count=0;q.native_started=false;
+}
+bool NativeLayerwiseRequest::query_workspace_needed() const noexcept {return impl_->query_extra_bytes!=0;}
+std::uint64_t NativeLayerwiseRequest::request_identity() const noexcept {return impl_->request_id;}
+NativeLayerwiseBatchRow NativeLayerwiseRequest::output_row() const {
+    auto& q=*impl_;q.owner();
+    if (!q.capture || !q.capture->output || !q.physical_grant || !q.credit || *q.credit!=q.sequence.window.stamp)
+        throw std::logic_error("Output cohort row has no exact prepared native owner");
+    return {q.sequence.lane,q.capture->begin,q.capture->local_begin,q.capture->count,
+        q.p.lane_epochs.at(q.sequence.lane),q.request_id,*q.credit,
+        q.p.text_kv_addresses->bound_row(q.sequence.kv->text),const_cast<NativeLayerwiseRequest*>(this)};
+}
+void NativeLayerwiseRequest::observe_output_row(const NativeLayerwiseBatchRow& row,
+    const execution::CurrentLayerAttentionFrame& frame) {
+    const auto actual=output_row();
+    if (!native_output_binding_matches(row,actual))
+        throw std::logic_error("Output callback belongs to another lane/request/source generation");
+    impl_->attended(frame);
+}
+void NativeLayerwiseRequest::withdraw_output_before_submit() {
+    auto& q=*impl_;q.owner();
+    if (q.native_started) throw std::logic_error("submitted Output requires Native Rawresolve before withdrawal");
+    if (q.capture) {
+        if (!q.capture->output) throw std::logic_error("cannot withdraw a Prefill/Query capture as Output");
+        discard_output();return;
+    }
+    q.close_physical_grant();q.credit.reset();q.credit_count=0;
+}
+void NativeLayerwiseRequest::prepare_graph_output(std::uint64_t epoch,std::uint32_t physical) {
+    auto& q=*impl_;q.owner();
+    if (!epoch || q.graph_epoch || !q.capture || !q.capture->output || !q.credit ||
+        *q.credit!=q.sequence.window.stamp || !q.physical_grant ||
+        physical!=q.physical_grant->plan.physical_target_rows ||
+        q.capture->count!=q.physical_grant->plan.valid_rows ||
+        std::any_of(q.capture->seen.begin(),q.capture->seen.end(),[](auto n){return n!=0;}))
+        throw std::logic_error("native graph row lacks its untouched exact physical grant");
+    q.graph_epoch=epoch;q.native_started=true;
+}
+void NativeLayerwiseRequest::validate_graph_output_complete(std::uint64_t epoch) const {
+    auto& q=*impl_;q.owner();
+    if (!epoch || q.graph_epoch!=epoch || !q.capture || !q.capture->output ||
+        !q.credit || *q.credit!=q.sequence.window.stamp || !q.physical_grant ||
+        std::any_of(q.capture->seen.begin(),q.capture->seen.end(),[&](auto n){return n!=q.capture->count;}))
+        throw std::logic_error("native graph row omitted a current-layer/head/accepted sample frame");
+}
+void NativeLayerwiseRequest::complete_graph_output(std::uint64_t epoch) noexcept {
+    if (impl_->graph_epoch==epoch) impl_->graph_epoch=0;
+}
+void NativeLayerwiseRequest::abort_graph_output(std::uint64_t epoch) noexcept {
+    auto& q=*impl_;if (q.graph_epoch!=epoch) return;
+    q.graph_epoch=0;q.failed=true;q.sequence.window.stamp.valid=false;
+}
+NativeLayerwiseOutputWork NativeLayerwiseRequest::output_work() const noexcept {return impl_->output_work;}
+bool NativeLayerwiseRequest::query_due() const {return impl_->window.action(impl_->state())==kvmem::LayerwiseWindowAction::Query;}
+bool NativeLayerwiseRequest::pending_native() const noexcept {return impl_->capture.has_value() || impl_->credit.has_value() || impl_->physical_grant.has_value();}
+const kvmem::LayerwiseWindowPlan& NativeLayerwiseRequest::plan() const {return impl_->window;}
+const NativeLayerwiseRequestOptions& NativeLayerwiseRequest::options() const {return impl_->options;}
+void NativeLayerwiseRequest::retire() {
+    auto& q=*impl_;if (q.capture || q.credit || q.physical_grant) throw std::logic_error("native layerwise request cannot retire pending native work");
+    if (q.output) {q.output->finish(q.request_id,q.p.layerwise_catalog(q.sequence));q.publish();}
+    if (q.sequence.window.layer_views.feedback) {
+        auto retained=q.sequence.window.layer_views.feedback->funded_copy(std::move(q.retained_feedback_credit));
+        q.sequence.window.layer_views.feedback=std::move(retained);
+    }
+    q.retired=true;
+}
+void NativeLayerwiseRequest::abort() noexcept {if (impl_ && !impl_->retired) {
+    // Whole-cohort RAII owns the shared storage fence/release.
+    impl_->graph_epoch=0;
+    // A grant can have submitted GDN work before the first attention observer
+    // sets native_started. Failed ownership must not publish that state even
+    // when no attention callback was reached.
+    if (impl_->native_started || impl_->physical_grant) impl_->sequence.window.stamp.valid=false;
+    try {
+        if (impl_->physical_grant) {
+            if (impl_->sequence.kv) impl_->close_physical_grant();
+            else {
+                // Defensive final destruction after a resource owner has
+                // already released KV must never dereference the old handle.
+                impl_->p.device.synchronize();impl_->sequence.window.stamp.valid=false;
+            }
+        }
+    } catch (...) {impl_->sequence.window.stamp.valid=false;}
+    impl_->physical_grant.reset();
+    impl_->capture.reset();impl_->credit.reset();
+    try {impl_->end_query_workspace();} catch (...) {}
+    impl_->native_started=false;impl_->failed=true;
+    impl_->admission.reset();
+}}
+} // namespace ninfer::models::qwen3_5::detail
