+                text_kv_view(sequence),mtp_kv_view(sequence),decoder->text_kv,decoder->mtp_cache(),
+                nullptr,sequence.text_kv_valid,nullptr,nullptr,selectors.source,selectors.destination};
+            const auto last=sequence.text_kv_valid-1;const auto rows=prompt.token_ids.size();
+            const std::array<std::int32_t,3> rope{prompt.positions.at(last),prompt.positions.at(rows+last),prompt.positions.at(2*rows+last)};
+            mark_workspace_usage(workspace_plan.mtp_prefill);
+            Tensor visual;const Tensor* next_embedding=nullptr;
+            if (prompt.token_types.at(sequence.text_kv_valid)!=0) {
+                if (!request.prefill->vision) throw std::logic_error("visual MTP boundary has no native Vision session");
+                const auto chunk=request.prefill->vision->prepare_chunk(sequence.text_kv_valid,1);
+                if (!chunk.control) throw std::logic_error("visual MTP boundary lost its native media control");
+                const auto& indices=chunk.control->scatter_indices;
+                const auto found=std::lower_bound(indices.begin(),indices.end(),static_cast<std::int32_t>(sequence.text_kv_valid));
+                if (found==indices.end() || *found!=static_cast<std::int32_t>(sequence.text_kv_valid))
+                    throw std::logic_error("visual MTP boundary has no matching native embedding column");
+                visual=request.prefill->vision->bridge_column(chunk,static_cast<std::int32_t>(found-indices.begin()));
+                next_embedding=&visual;
+            }
+            NativeLayerwiseMtpBoundary::rebuild(*this,sequence,bridge,prompt.token_ids[sequence.text_kv_valid],rope,false,next_embedding);
+        }
+        // Refresh owns its private COW boundary after whole-Query admission;
+        // ordinary/no-refresh has just completed the original native bridge.
+        request.prefill->mtp_bridge=MtpBridgeMode::None;
+    }
+}
