+                    checked_sum(sizeof(kvmem::AcceptedAttentionRow)+64,checked_product(columns,sizeof(kvmem::GraphEdge)))));
+                head_work=checked_sum(head_work,checked_sum(512,checked_product(2*columns,sizeof(std::uint32_t))));
+                head_work=checked_sum(head_work,checked_product(count,2*sizeof(std::int32_t)));
+                head_work=checked_sum(head_work,checked_product(2*next.rows.size(),4*sizeof(std::uint64_t)));
+            }
+        }
