+    require(layerwise_media_replay_begin(prompt,0,64)==0,"cold prefix changed");
+    rejects([&]{layerwise_media_replay_begin(prompt,301,64);});
+    rejects([&]{layerwise_media_replay_begin(prompt,155,0);});
