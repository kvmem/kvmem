+            if (context.readout_count>0) ops::readout_logprobs(*logits,p.io.readout_ids,context.readout_count,
+                dimension(p.parameters.model.resources().public_token_count),p.io.readout_values,p.device.stream);
+            ops::set_i32_scalar(p.io.pos,dimension(identity.evaluation.end),p.device.stream);
+            ops::set_i32_scalar(p.io.rope_pos,static_cast<std::int32_t>(identity.evaluation.end)+sequence.rope_delta,p.device.stream);
+            if (context.sampling) ops::sample(*logits,p.io.token,dimension(p.parameters.model.resources().public_token_count),
+                context.sampling,p.io.pos,ops::kSamplePurposePrefill,p.work,p.device.stream);
+            else ops::argmax(*logits,p.io.token,dimension(p.parameters.model.resources().public_token_count),p.device.stream);
+        }
+        if (dflash_features) dflash_features->append(context,begin,n);
+        if (!p.backend_kv_pages) return;
+        if (!auxiliary_restored) {
