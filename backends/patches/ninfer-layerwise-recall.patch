+            for (int key = 0; key <= t; ++key)
+                for (int d = 0; d < D; ++d)
+                    logits[key] += rotated_q[t * D * Q + d] * rotated_k[key * D * K + d] / std::sqrt(double(D));
+            const auto maximum = *std::max_element(logits.begin(), logits.end());
+            double denominator = 0;
+            for (auto& x : logits) denominator += x = std::exp(x - maximum);
+            for (int d = 0; d < H; ++d) {
+                double attention = 0;
+                for (int key = 0; key <= t; ++key) attention += logits[key] / denominator * v[key * D * K + d];
+                output[t * H + d] = bf16(output[t * H + d] + bf16(.5 * attention));
+            }
+        }
+    }
+    static std::vector<double> rotate(std::vector<double> values, int heads) {
+        for (int t = 0; t < T; ++t) for (int h = 0; h < heads; ++h)
+            for (int pair = 0; pair < 32; ++pair) {
+                const double angle = (Position + t) * std::pow(1e7, -2. * pair / 64);
+                const size_t a = size_t(t * heads + h) * D + pair, b = a + 32;
+                const auto x = values[a], y = values[b];
+                values[a] = bf16(x * std::cos(angle) - y * std::sin(angle));
+                values[b] = bf16(x * std::sin(angle) + y * std::cos(angle));
+            }
+        return values;
+    }
+};
+
+struct BundleStorage {
+    DeviceArena arena{size_t(256) << 10};
+    execution::PreparedLayerQueryStorage storage;
+    explicit BundleStorage(int rows) {
+        storage.query = arena.alloc(DType::BF16, {D, Q, rows});
+        storage.key = arena.alloc(DType::BF16, {D, K, rows});
+        storage.value = arena.alloc(DType::BF16, {D, K, rows});
+        storage.gate = arena.alloc(DType::BF16, {D, Q, rows});
+        storage.residual = arena.alloc(DType::BF16, {H, rows});
+        storage.cache_positions = arena.alloc(DType::I32, {rows});
+        storage.rope_positions = arena.alloc(DType::I32, {rows});
+    }
+};
+struct Counters {
+    unsigned projections = 0, projected_rows = 0, completions = 0;
+    bool fail = false;
+    static void projected(void* owner, const execution::CurrentLayerQueryFrame& frame) {
+        auto& c = *static_cast<Counters*>(owner);
+        check(frame.identity.model_layer == 0 && frame.identity.attention_layer == 0 && frame.identity.rank == 0,
+              "projection hook reported a foreign native layer");
+        ++c.projections; c.projected_rows += frame.query.ne[2];
+        if (c.fail) throw std::runtime_error("injected projection-owner failure");
+    }
+    static void completed(void* owner, const execution::CurrentLayerQueryCompletion& frame) {
+        auto& c = *static_cast<Counters*>(owner);
+        check(frame.identity.model_layer == 0 && frame.evaluated_rows == T, "native completion missed full layer rows");
+        ++c.completions;
+    }
+};
