+        if (backend_kv_pages) auxiliary=plan_host_kv_page_layout(backend_kv_pages->physical_pool().geometry());
+        const auto descriptor=native_window_descriptor(*this,layout,auxiliary,
+            layout.page_stride+(auxiliary?auxiliary->page_stride:0),backend_kv_cache());
+        const kvmem::CheckpointIdentity identity{descriptor.identity,descriptor.layout,{}};
+        kvmem::RawKvStoreConfig config;
