+        }
+    }
+    void accept(const kvmem::MemoryStamp& stamp,std::optional<std::uint32_t> accepted_rows=std::nullopt,
+                std::span<const TokenId> consumed={}) {
+        owner();if (graph_epoch) throw std::logic_error("native graph feedback must collect before accepted publication");
+        const auto accepted=accepted_rows.value_or(capture?capture->count:0);
+        if (!capture || accepted>capture->count || stamp.frontier!=std::uint64_t(capture->begin)+accepted ||
+            std::any_of(capture->seen.begin(),capture->seen.end(),[&](auto n){return n!=capture->count;}))
+            throw std::logic_error("native feedback cannot publish before every target layer completes");
+        reclaim_metadata();
+        auto next=*prefill;auto next_output=output?std::make_unique<kvmem::LayerwiseOutputPressure>(*output):nullptr;
+        if (capture->output) {
+            auto rows=capture->rows;
+            if (capture->deferred_output) {
+                if (consumed.size()!=accepted || std::any_of(consumed.begin(),consumed.end(),[](auto id){return id<0;}))
+                    throw std::logic_error("deferred native Output lacks the exact accepted consumed token prefix");
+                const std::vector<std::uint32_t> tokens(consumed.begin(),consumed.end());
+                const auto mask=next_output->prepare(request_id,capture->begin,tokens);
+                rows.clear();for (std::uint32_t i=0;i<accepted;++i) if (mask&(std::uint64_t(1)<<i)) rows.push_back(i);
+            } else if (!consumed.empty()) throw std::logic_error("native Output supplied deferred IDs to an already bound token frame");
+            std::vector<kvmem::LayerwiseOutputMass> layers;
+            for (const auto& layer:capture->layers) {
+                if (!capture->deferred_output) layers.push_back({layer.model_layer,layer.history,layer.masses});
+                else {
+                    kvmem::LayerwiseOutputMass mass{layer.model_layer,layer.history,{}};
+                    const auto values=rows.size()*layer.history.size();mass.masses.reserve(values);
+                    if (mass.masses.capacity()>values) throw std::length_error("native deferred Output packet exceeded its admitted matrix");
+                    for (auto row:rows) {
+                        const auto first=std::size_t(row)*layer.history.size();
+                        mass.masses.insert(mass.masses.end(),layer.masses.begin()+first,layer.masses.begin()+first+layer.history.size());
+                    }
+                    layers.push_back(std::move(mass));
+                }
+            }
+            next_output->accept({stamp,request_id,accepted,rows,std::move(layers)});
+        } else {
+            next.accept({stamp,capture->count,capture->count,capture->local_begin,capture->rows,capture->layers});
+            if (next_output && !capture->no_refresh && !capture->split_prefill) next_output->accept_prefill(stamp,request_id,capture->begin);
