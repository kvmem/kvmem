+void StateImageDevicePool::copy_to_host_range(std::int32_t source, std::size_t image_offset,
+                                              std::span<std::byte> destination,
+                                              RankStreams streams) const {
+    validate_slot(source, slot_count(), "StateImage range D2H source is out of range");
+    if (image_offset > host_layout_.image_bytes ||
+        destination.size() > host_layout_.image_bytes - image_offset ||
+        (!destination.empty() && destination.data() == nullptr)) {
+        throw std::invalid_argument("StateImage range D2H is outside the packed image");
+    }
+    if (destination.empty()) return;
+    std::memset(destination.data(), 0, destination.size());
+    const auto end = image_offset + destination.size();
+    for_each_host_component(
+        source, [&](std::size_t rank, void* device, std::size_t offset, std::size_t bytes) {
+            const auto first = std::max(image_offset, offset);
+            const auto last = std::min(end, offset + bytes);
+            if (first >= last) return;
+            const HoldingDeviceBinding bind(rank_devices_[rank]);
+            CUDA_CHECK(cudaMemcpyAsync(destination.data() + first - image_offset,
+                                       static_cast<const std::byte*>(device) + first - offset,
+                                       last - first, cudaMemcpyDeviceToHost, streams[rank]));
+        });
+}
