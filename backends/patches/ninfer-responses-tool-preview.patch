diff --git a/tests/test_responses_tool_preview.cpp b/tests/test_responses_tool_preview.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..d7c27cd9021aabe3627f016af32e26b61f409b47
--- /dev/null
+++ b/tests/test_responses_tool_preview.cpp
@@ -0,0 +1,154 @@
+#include "models/qwen3_5/frontend/tool_call_parser.h"
+#include "serve/generation_service.h"
+#include "serve/openai_responses.h"
+
+#include <iostream>
+#include <stdexcept>
+#include <string_view>
+
+namespace {
+using namespace ninfer;
+using namespace ninfer::serve;
+namespace frontend = ninfer::models::qwen3_5::frontend;
+
+void check(bool ok, const char* message) {
+    if (!ok) throw std::runtime_error(message);
+}
+
+std::string join(const std::vector<std::string>& frames) {
+    std::string out;
+    for (const auto& frame : frames) out += frame;
+    return out;
+}
+
+void test_responses_preview_repair(bool dump) {
+    const std::vector<std::string> declarations = {
+        R"({"type":"function","function":{"name":"capture","parameters":{"type":"object","properties":{"payload":{"type":"string"},"count":{"type":"integer"}}}}})"};
+    const auto contract = frontend::select_tool_call_contract(
+        frontend::build_tool_call_output_contract(declarations, true), {});
+    check(!contract->constrained, "fixture must use ordinary auto");
+    frontend::ToolCallOutputDecoder decoder(contract, 64);
+    OpenAIResponsesCreateRequest request;
+    request.prompt.model = "test";
+    OpenAIResponsesEventStream stream("resp_preview", 1, std::move(request), {});
+    const auto start = join(stream.start());
+    const auto feed = [&](std::string_view bytes) {
+        check(decoder.feed(bytes).empty(), "tool markup escaped into content");
+        std::string frames;
+        for (const auto& event : decoder.take_preview_events()) frames += join(stream.tool_delta(event));
+        return frames;
+    };
+    const auto first = feed("<tool_call>\n<function=capture>\n<parameter=payload>\nfirst preview");
+    check(first.find("response.output_item.added") != std::string::npos &&
+              first.find("first preview") != std::string::npos,
+          "Responses did not publish the parameter before it closed");
+    const auto second = feed(" continues\n</par");
+    check(second.find(" continues") != std::string::npos,
+          "Responses did not publish the second committed fragment");
+    const auto third = feed("ameter>\n<parameter=count>\n\n</parameter>\n"
+               "<parameter=payload>\nfinal replacement\n</parameter>\n</function>\n</tool_call>");
+    auto terminal = decoder.finish();
+    check(terminal.tool_calls.size() == 1 && terminal.diagnostics.duplicate_parameters_repaired == 1 &&
+              terminal.diagnostics.empty_arguments_omitted == 1 &&
+              terminal.tool_calls[0].arguments_json == R"({"payload":"final replacement"})",
+          "legacy repair or normalization was lost");
+    GenerationOutcome outcome;
+    outcome.finish_reason = FinishReason::StopToken;
+    outcome.tool_calls = std::move(terminal.tool_calls);
+    const auto result = stream.finish(outcome);
+    const auto frames = join(result.events_before_terminal);
+    check(result.events_before_terminal.size() == 2 &&
+              frames.find("response.function_call_arguments.done") != std::string::npos &&
+              frames.find("response.output_item.done") != std::string::npos &&
+              frames.find("final replacement") != std::string::npos &&
+              frames.find("first preview") == std::string::npos &&
+              result.response.body.at("output").at(0).at("arguments") == outcome.tool_calls[0].arguments_json,
+          "Responses did not close the preview with authoritative repaired arguments");
+    if (dump) std::cout << start << first << second << third << frames << stream.terminal(result.response);
+}
+
+void test_responses_preview_multiple_parameters() {
+    const std::vector<std::string> declarations = {
+        R"({"function":{"name":"capture","parameters":{"type":"object","properties":{"description":{"type":"string"},"flag":{"type":"boolean"},"command":{"type":"string"},"options":{"type":"object"}}}}})"};
+    const auto contract = frontend::select_tool_call_contract(
+        frontend::build_tool_call_output_contract(declarations, true), {});
+    frontend::ToolCallOutputDecoder decoder(contract, 64);
+    std::string preview;
+    std::size_t starts = 0;
+    const auto feed = [&](std::string_view bytes) {
+        check(decoder.feed(bytes).empty(), "markup escaped the tool region");
+        std::string fragment;
+        for (const auto& event : decoder.take_preview_events()) {
+            if (event.kind == ToolStreamEvent::Kind::Start) {
+                check(event.index == 0 && event.text == "capture", "wrong Responses item identity");
+                ++starts;
+            } else if (event.kind == ToolStreamEvent::Kind::Arguments) fragment += event.text;
+        }
+        preview += fragment;
+        return fragment;
+    };
+    (void)feed("<tool_call>\n<function=capture>\n<parameter=description>short</parameter>\n<para");
+    check(feed("meter=flag>TRUE</parameter>\n<parameter=command>\r").find("\"flag\":\"TRUE") != std::string::npos,
+          "non-string value did not use provisional string form");
+    check(feed("\nfirst command fragment").find("first command fragment") != std::string::npos,
+          "third parameter did not stream while incomplete");
+    check(feed(" </parameter> literal </param").find("literal") != std::string::npos,
+          "literal closing tag broke the third parameter");
+    check(feed("eter>\n<param name='options'>\n{\"a\": ").find("options") != std::string::npos,
+          "later parameter did not start after a literal and a split closer");
+    check(feed("[1,2]").find("[1,2]") != std::string::npos, "object body waited until terminal");
+    (void)feed("}\n</param><parameter=unknown>19</parameter></function></tool_call>");
+    check(starts == 1, "did not preserve one provisional item");
+    const auto parsed_preview = nlohmann::json::parse(preview);
+    check(parsed_preview.at("flag") == "TRUE" && parsed_preview.at("options") == R"({"a": [1,2]})" &&
+              parsed_preview.at("command") == "first command fragment </parameter> literal " &&
+              parsed_preview.at("unknown") == "19",
+          "preview did not preserve escaped raw strings in all fields");
+    const auto terminal = decoder.finish();
+    check(terminal.tool_calls.size() == 1, "multi-parameter terminal call was lost");
+    const auto exact = nlohmann::json::parse(terminal.tool_calls[0].arguments_json);
+    check(exact.at("flag") == true && exact.at("options").at("a") == nlohmann::json::array({1, 2}) &&
+              exact.at("unknown") == 19 && exact.at("command") == parsed_preview.at("command"),
+          "original terminal typing/repair changed");
+}
+void test_preview_request_and_unmatched_item() {
+    const RequestJson base = {{"model", "test"}, {"input", "hello"}, {"stream", true}};
+    check(parse_openai_responses_create_request(base, {}).tool_preview, "preview did not default on");
+    auto request = base;
+    request["kvmem_tool_preview"] = false;
+    check(!parse_openai_responses_create_request(request, {}).tool_preview, "opt-out ignored");
+    request["kvmem_tool_preview"] = "false";
+    bool invalid = false;
+    try { (void)parse_openai_responses_create_request(request, {}); }
+    catch (const std::exception&) { invalid = true; }
+    check(invalid, "non-boolean option accepted");
+
+    for (const auto reason : {FinishReason::OutputLimit, FinishReason::StopToken}) {
+        OpenAIResponsesCreateRequest parsed;
+        parsed.prompt.model = "test";
+        OpenAIResponsesEventStream encoder("resp_unmatched", 1, std::move(parsed), {});
+        (void)encoder.start();
+        (void)encoder.tool_delta({ToolStreamEvent::Kind::Start, 0, "capture"});
+        (void)encoder.tool_delta({ToolStreamEvent::Kind::Arguments, 0, R"({"command":"partial)"});
+        GenerationOutcome outcome;
+        outcome.finish_reason = reason;
+        if (reason == FinishReason::StopToken) outcome.tool_calls.push_back({"different_tool", "{}"});
+        bool rejected = false;
+        try { (void)encoder.finish(outcome); }
+        catch (const std::logic_error&) { rejected = true; }
+        check(rejected, "unmatched preview could be published as executable");
+    }
+}
+} // namespace
+
+int main() {
+    try {
+        test_preview_request_and_unmatched_item();
+        test_responses_preview_multiple_parameters();
+        test_responses_preview_repair(false);
+        return 0;
+    } catch (const std::exception& error) {
+        std::cerr << error.what() << '\n';
+        return 1;
+    }
+}
