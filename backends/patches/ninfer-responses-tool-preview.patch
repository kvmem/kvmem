+// Responses has an authoritative terminal item. This scanner publishes provisional JSON
+// string values, without changing the held region, schema policy, or the terminal parser.
+std::vector<ToolStreamEvent> ToolCallOutputDecoder::take_preview_events() {
+    using Kind = ToolStreamEvent::Kind;
+    if (!contract_ || contract_->constrained || !saw_tool_marker_ || finished_) return {};
+    const std::string_view region = tool_region_;
+    std::vector<ToolStreamEvent> events;
+    const auto disable = [&] { preview_phase_ = PreviewPhase::Disabled; };
+    const auto emit = [&](std::string text) {
+        if (!events.empty() && events.back().kind == Kind::Arguments) events.back().text += text;
+        else events.push_back({Kind::Arguments, 0, std::move(text)});
+    };
+    const auto pending_opener = [](std::string_view rest, const auto& forms) {
+        return std::any_of(std::begin(forms), std::end(forms),
+                           [&](const auto& tag) { return tag.open.starts_with(rest); });
+    };
+    // Do not commit a delimiter when it might be literal content or split across token batches.
+    enum class Boundary { No, Wait, Yes };
+    const auto following_boundary = [&](std::size_t pos) {
+        skip_format_whitespace(region, pos);
+        auto rest = region.substr(pos);
+        if (tag_form_at(region, pos, kParameterForms)) return Boundary::Yes;
+        if (pending_opener(rest, kParameterForms)) return Boundary::Wait;
+        if (rest.starts_with(preview_function_close_)) {
+            pos += preview_function_close_.size();
+            skip_format_whitespace(region, pos);
+            rest = region.substr(pos);
+        } else if (preview_function_close_.starts_with(rest)) {
+            return Boundary::Wait;
+        }
+        for (const auto tag : {kToolClose, kFunctionCallsClose, kToolOpen, kThinkOpen, kThinkClose}) {
+            if (rest.starts_with(tag)) return Boundary::Yes;
+            if (tag.starts_with(rest)) return Boundary::Wait;
+        }
+        if (tag_form_at(region, pos, kFunctionForms)) return Boundary::Yes;
+        return pending_opener(rest, kFunctionForms) ? Boundary::Wait : Boundary::No;
+    };
+    while (preview_phase_ != PreviewPhase::Disabled) {
+        if (preview_phase_ == PreviewPhase::Header) {
+            std::size_t pos = 0;
+            skip_format_whitespace(region, pos);
+            auto rest = region.substr(pos);
+            if (rest.starts_with(kToolOpen)) pos += kToolOpen.size();
+            else if (rest.starts_with(kFunctionCallsOpen)) pos += kFunctionCallsOpen.size();
+            else if (kToolOpen.starts_with(rest) || kFunctionCallsOpen.starts_with(rest)) break;
+            skip_format_whitespace(region, pos);
+            rest = region.substr(pos);
+            const auto* form = tag_form_at(region, pos, kFunctionForms);
+            if (!form) {
+                if (!pending_opener(rest, kFunctionForms)) disable();
+                break;
+            }
+            std::size_t end;
+            const auto name = tag_name(tag_header(region, pos, *form, end));
+            if (end == std::string_view::npos) {
+                if (rest.size() > 1024) disable();
+                break;
+            }
+            const auto* tool = find_tool_contract(*contract_, name);
+            if (!valid_function_name(name, max_tool_name_length_) || !tool || tool->strict ||
+                !tool->unambiguous) { disable(); break; }
+            preview_name_ = name;
+            preview_function_close_ = form->close;
+            preview_cursor_ = end + 1;
+            preview_phase_ = PreviewPhase::Parameter;
+        } else if (preview_phase_ == PreviewPhase::Parameter) {
+            skip_format_whitespace(region, preview_cursor_);
+            const auto rest = region.substr(preview_cursor_);
+            if (rest.starts_with(preview_function_close_)) {
+                if (preview_started_) emit("}");
+                disable();
+                break;
+            }
+            const auto* form = tag_form_at(region, preview_cursor_, kParameterForms);
+            if (!form) {
+                if (!pending_opener(rest, kParameterForms) && !preview_function_close_.starts_with(rest)) disable();
+                break;
+            }
+            std::size_t end;
+            const auto key = tag_name(tag_header(region, preview_cursor_, *form, end));
+            if (end == std::string_view::npos) {
+                if (rest.size() > 1024) disable();
+                break;
+            }
+            if (key.empty()) { disable(); break; }
+            auto start = end + 1;
+            const auto suffix = region.substr(start);
+            if (suffix.empty() || suffix == "\r") break;
+            if (suffix.starts_with("\r\n")) start += 2;
+            else if (suffix.starts_with('\n')) ++start;
+            if (!preview_started_) events.push_back({Kind::Start, 0, preview_name_});
+            // Repeated names in the preview are intentional; only done is authoritative.
+            emit((preview_started_ ? "," : "{") + encode_json_string(key) + ":\"");
+            preview_started_ = true;
+            preview_parameter_open_ = form->open;
+            preview_parameter_close_ = form->close;
+            preview_depth_ = 1;
+            preview_cursor_ = start;
+            preview_phase_ = PreviewPhase::Value;
+        } else {
+            const auto begin = preview_cursor_;
+            std::size_t after_close = std::string_view::npos;
+            const TagForm form{preview_parameter_open_, preview_parameter_close_};
+            while (preview_cursor_ < region.size()) {
+                const auto rest = region.substr(preview_cursor_);
+                const std::size_t newline = rest.starts_with("\r\n") ? 2 : rest.starts_with('\n') ? 1 : 0;
+                const auto possible_close = rest.substr(newline);
+                if (possible_close.starts_with(form.close) && preview_depth_ == 1) {
+                    const auto end = preview_cursor_ + newline + form.close.size();
+                    const auto boundary = following_boundary(end);
+                    if (boundary == Boundary::Wait) break;
+                    if (boundary == Boundary::Yes) { after_close = end; break; }
+                }
+                if ((possible_close.size() < form.close.size() &&
+                     form.close.starts_with(possible_close)) || rest == "\r") break;
+                if (rest.starts_with(form.close) && preview_depth_ > 1) {
+                    --preview_depth_;
+                    preview_cursor_ += form.close.size();
+                    continue;
+                }
+                if (opens_tag(region, preview_cursor_, form)) {
+                    std::size_t end;
+                    const auto nested_key = tag_name(tag_header(region, preview_cursor_, form, end));
+                    if (end == std::string_view::npos && rest.size() <= 1024) break;
+                    if (!nested_key.empty() && end != std::string_view::npos) {
+                        ++preview_depth_;
+                        preview_cursor_ = end + 1;
+                        continue;
+                    }
+                } else if (form.open.starts_with(rest)) break;
+                ++preview_cursor_;
+            }
+            if (preview_cursor_ > begin) {
+                auto encoded = encode_json_string(region.substr(begin, preview_cursor_ - begin));
+                emit(encoded.substr(1, encoded.size() - 2));
+            }
+            if (after_close == std::string_view::npos) break;
+            emit("\"");
+            preview_cursor_ = after_close;
+            preview_phase_ = PreviewPhase::Parameter;
+        }
+    }
+    return events;
+}
