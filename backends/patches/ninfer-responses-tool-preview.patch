+std::vector<std::string> OpenAIResponsesEventStream::tool_delta(const ninfer::ToolStreamEvent& delta) {
+    using Kind = ninfer::ToolStreamEvent::Kind;
+    if (!impl_->started || impl_->finish_built || delta.index != 0) {
+        throw std::logic_error("invalid Responses tool preview event state");
+    }
+    if (delta.kind == Kind::Start) {
+        if (impl_->preview_output_index >= 0) throw std::logic_error("duplicate Responses tool preview");
+        auto events = impl_->close_reasoning(impl_->reasoning_text);
+        impl_->preview_name = delta.text;
+        impl_->preview_output_index = impl_->next_output_index++;
+        impl_->ids.function_calls.push_back(new_openai_response_item_id("fc"));
+        impl_->ids.call_ids.push_back(new_openai_response_item_id("call"));
+        Json item = {{"id", impl_->ids.function_calls.front()}, {"type", "function_call"},
+                     {"status", "in_progress"}, {"call_id", impl_->ids.call_ids.front()}, {"arguments", ""}};
+        add_wire_function_identity(item, impl_->request, impl_->preview_name);
+        events.push_back(sse(impl_->event("response.output_item.added",
+            Json{{"output_index", impl_->preview_output_index}, {"item", item}})));
+        return events;
+    }
+    if (delta.kind != Kind::Arguments || delta.text.empty()) return {};
+    if (impl_->preview_output_index < 0) throw std::logic_error("Responses preview has no item");
+    return {sse(impl_->event("response.function_call_arguments.delta",
+        Json{{"item_id", impl_->ids.function_calls.front()}, {"output_index", impl_->preview_output_index},
+             {"delta", delta.text}}))};
+}
