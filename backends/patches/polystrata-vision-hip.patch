diff --git a/tools/vision/CMakeLists.txt b/tools/vision/CMakeLists.txt
index d6518c71daf05076f919701148970b827d42d0af..0aee6fe1d8725dd4f6b4985524dc9c669281db11 100644
--- a/tools/vision/CMakeLists.txt
+++ b/tools/vision/CMakeLists.txt
@@ -14,6 +14,14 @@ project(strata_vision C CXX)
 
 set(LLAMA_DIR "${CMAKE_CURRENT_SOURCE_DIR}/../../third_party/llama.cpp" CACHE PATH "llama.cpp checkout")
 option(STRATA_VISION_CUDA "run the vision encoder on the GPU (builds ggml-cuda)" OFF)
+option(STRATA_VISION_HIP "run the vision encoder on an AMD GPU (builds ggml-hip)" OFF)
+set(STRATA_VISION_HIP_ARCHS "" CACHE STRING "the gfx architectures the HIP vision encoder is compiled for (';'-separated)")
+if(STRATA_VISION_HIP AND STRATA_VISION_CUDA)
+  message(FATAL_ERROR "strata-vision: STRATA_VISION_CUDA and STRATA_VISION_HIP are two different builds")
+endif()
+if(STRATA_VISION_HIP AND NOT STRATA_VISION_HIP_ARCHS)
+  message(FATAL_ERROR "strata-vision: STRATA_VISION_HIP needs STRATA_VISION_HIP_ARCHS, for example \"gfx1100\"")
+endif()
 option(STRATA_PORTABLE "build for other PCs: AVX2 baseline, static MSVC runtime" ON)
 if(STRATA_PORTABLE AND MSVC)
   set(CMAKE_MSVC_RUNTIME_LIBRARY "MultiThreaded")
@@ -52,6 +60,15 @@ else()
 endif()
 set(GGML_BACKEND_DL OFF CACHE BOOL "" FORCE)
 set(GGML_CUDA ${STRATA_VISION_CUDA} CACHE BOOL "" FORCE)
+set(GGML_HIP ${STRATA_VISION_HIP} CACHE BOOL "" FORCE)
+if(STRATA_VISION_HIP)
+  # the engine's HIP build says the same; ggml-hip reads AMDGPU_TARGETS / CMAKE_HIP_ARCHITECTURES
+  set(AMDGPU_TARGETS "${STRATA_VISION_HIP_ARCHS}" CACHE STRING "" FORCE)
+  set(GPU_TARGETS "${STRATA_VISION_HIP_ARCHS}" CACHE STRING "" FORCE)
+  set(CMAKE_HIP_ARCHITECTURES "${STRATA_VISION_HIP_ARCHS}" CACHE STRING "" FORCE)
+  # a Linux toolchain links a PIE; ggml-hip's objects must be position independent
+  set(CMAKE_POSITION_INDEPENDENT_CODE ON)
+endif()
 
 add_subdirectory(${LLAMA_DIR} llama EXCLUDE_FROM_ALL)
 
diff --git a/tools/vision/strata_vision.cpp b/tools/vision/strata_vision.cpp
index 36b451c8462269c5a1406c8066da690ed423395b..7a334e1eb3a5249043c26cb1c1e2b4a3ed350efe 100644
--- a/tools/vision/strata_vision.cpp
+++ b/tools/vision/strata_vision.cpp
@@ -90,13 +90,15 @@ int main(int argc, char** argv) {
                              "[--max-tokens N] [--min-tokens N] [--flash-attn on|off|auto]\n");
         return 2;
     }
-    // On the CPU the GPU stays unseen: a CUDA build otherwise opens a context there (measured: 0.4-0.7 GB of VRAM,
-    // 150-260 expert slots less for the engine beside it).  Before anything reaches the CUDA runtime.
+    // On the CPU the GPU stays unseen: a CUDA or HIP build otherwise opens a context there (measured: 0.4-0.7 GB of
+    // VRAM, 150-260 expert slots less for the engine beside it).  Before anything reaches the GPU runtime.
     if (!gpu) {
 #ifdef _WIN32
         _putenv_s("CUDA_VISIBLE_DEVICES", "-1");
+        _putenv_s("HIP_VISIBLE_DEVICES", "-1");
 #else
         setenv("CUDA_VISIBLE_DEVICES", "-1", 1);
+        setenv("HIP_VISIBLE_DEVICES", "-1", 1);
 #endif
     }
     llama_log_set(quiet_log, nullptr);
