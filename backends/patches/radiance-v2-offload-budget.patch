+TEST(layer_offload_preserves_the_kv_floor_when_weights_round_up) {
+    const int64_t MiB = 1024 * 1024;
+    VramFacts f{};
+    f.capacity = 12LL << 30;
+    f.free = f.capacity - 1234;  /* the resulting weight floor is not MiB-aligned */
+    f.arena = 200 * MiB;
+    f.statics = 20LL << 30;
+    f.kv_ceiling = 4LL << 30;
+    f.kv_one = 227 * MiB;
+    Config c = derive_config();
+    c.placement = "layer_offload";
+    VramBudget b;
+    CHECK_OK(vram_budget_resolve(c, { f }, &b));
+    CHECK_EQ(b.kv, f.kv_one);
+    CHECK_EQ(c.vram_kv_mib * MiB, f.kv_one);
+    CHECK(f.capacity - (f.capacity - f.free) - f.arena -
+          (c.vram_weights_mib + c.vram_kv_mib) * MiB >= 16 * MiB);
 }
 
