+    for(int j=0;j<8;++j) {
+        unsigned short lo,hi;
+        asm("cvt.rn.satfinite.e4m3x2.f32 %0, %1, %2;":"=h"(lo):"f"(v[4*j+1]*inv),"f"(v[4*j]*inv));
+        asm("cvt.rn.satfinite.e4m3x2.f32 %0, %1, %2;":"=h"(hi):"f"(v[4*j+3]*inv),"f"(v[4*j+2]*inv));
