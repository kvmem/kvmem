+void large_slab(const Format& f) {
+    // Cross the former 1536-row / 8 MiB boundary at K=5120. Independently decode
+    // every packed value, then evaluate FP64 dots at both sides of that boundary
+    // and the actual/padded row and column tile tails.
+    constexpr int n=1665,k=5120,t=1024;
+    const auto b=gguf_block_shape(f.q);const auto rb=std::int64_t(k/b.elements)*b.bytes;
+    std::mt19937 rng(8826);std::vector<unsigned char> raw(n*rb+256);
+    for(std::size_t i=0;i<std::size_t(n)*rb;++i)raw[i]=static_cast<unsigned char>(rng()%256);
+    const auto h=__float2half(.0125f);unsigned short hs;std::memcpy(&hs,&h,2);
+    for(std::size_t i=0;i<std::size_t(n)*rb;i+=b.bytes)for(int off:f.scales)std::memcpy(raw.data()+i+off,&hs,2);
+    std::vector<float> qw(n*k);gguf_cpu_decode(int(ops::detail::gguf_type(f.q)),raw.data(),qw.data(),n*k);
+    quantize_reference(qw,n,k);
+    std::vector<__nv_bfloat16>x(k*t);for(auto&v:x)v=__float2bfloat16(float(int(rng()%131)-65)*.015625f);
+    std::vector<float> qx(x.size());for(std::size_t i=0;i<x.size();++i)qx[i]=__bfloat162float(x[i]);quantize_reference(qx,t,k);
+    DeviceBuffer dw(raw.size()),dx(x.size()*2),dy(std::size_t(n)*t*4+32);dy.fill(0x42);
+    dw.copy_from_host(raw.data(),raw.size());dx.copy_from_host(x.data(),x.size()*2);
+    auto* result=static_cast<float*>(dy.p)+4;Tensor tx(dx.p,DType::BF16,{k,t}),ty(result,DType::FP32,{n,t});
+    Weight w;w.qtype=f.q;w.layout=QuantLayout::GgufBlocks;w.scale_dtype=DType::FP16;w.n=n;w.k=k;w.qdata=dw.p;
+    WorkspaceArena work(ops::linear_workspace_capacity_bytes(f.q,n,k,ops::LinearPolicy::A16Only,1,t));
+    ops::linear(tx,w,ty,ops::LinearPolicy::A16Only,work,nullptr);checked(cudaDeviceSynchronize());
+    cudaStream_t stream;checked(cudaStreamCreateWithFlags(&stream,cudaStreamNonBlocking));checked(cudaStreamBeginCapture(stream,cudaStreamCaptureModeGlobal));
+    ops::linear(tx,w,ty,ops::LinearPolicy::A16Only,work,stream);
+    cudaGraph_t graph;checked(cudaStreamEndCapture(stream,&graph));cudaGraphExec_t exe;checked(cudaGraphInstantiate(&exe,graph,nullptr,nullptr,0));checked(cudaGraphLaunch(exe,stream));checked(cudaStreamSynchronize(stream));
+    std::vector<float> all(n*t);checked(cudaMemcpy(all.data(),result,all.size()*4,cudaMemcpyDeviceToHost));
+    std::vector<float> got;std::vector<double> ref;
+    for(int c:{0,1,127,128,1023})for(int r:{0,127,128,1535,1536,1664}) {
+        double sum=0;for(int j=0;j<k;++j)sum+=double(qw[r*k+j])*qx[c*k+j];
+        ref.push_back(sum);got.push_back(all[c*n+r]);
+    }
+    error(got,ref,1e-4,3e-5,"MXFP8 larger slab FP64 boundary samples");
+    std::vector<unsigned char> guards(dy.bytes);dy.copy_to_host(guards.data(),guards.size());
+    for(int i=0;i<16;++i)if(guards[i]!=0x42 || guards[guards.size()-1-i]!=0x42)throw std::runtime_error("large slab output guard");
+    if(work.peak_used()>work.capacity())throw std::runtime_error("large slab workspace bound");
+    checked(cudaGraphExecDestroy(exe));checked(cudaGraphDestroy(graph));checked(cudaStreamDestroy(stream));
+}
