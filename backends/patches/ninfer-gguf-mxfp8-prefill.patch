+        const std::uint8_t* wrow = p.weight + std::int64_t(row) * p.row_bytes;
+        const auto issue_raw     = [&](int b) {
+            if constexpr (FP8 && kRowCopies<type>) {
+                constexpr int kLanes = L::kUnits <= 16 ? 16 : 32; // per row
+                static_assert(L::kUnits <= 32);
