+int main(int argc,char** argv){try{
+    if(!mx::enabled())throw std::runtime_error("test requires NINFER_GGUF_PREFILL_MXFP8=1");
+    if(!mx::supported(ops::gguf::GgmlType::IQ3_S,256)){std::cout<<"SKIP MXFP8 requires sm120\n";return 77;}
+    activation_codec();
+    std::vector<Format> formats={{QType::GGUF_IQ3_XXS,"iq3_xxs",{0}},{QType::GGUF_IQ3_S,"iq3_s",{0}},{QType::GGUF_IQ2_XXS,"iq2_xxs",{0}},{QType::GGUF_IQ2_XS,"iq2_xs",{0}},{QType::GGUF_IQ2_S,"iq2_s",{0}},{QType::GGUF_IQ4_XS,"iq4_xs",{0}},{QType::GGUF_Q2_K,"q2_k",{80,82}},{QType::GGUF_Q4_K,"q4_k",{0,2}}};
+    if(argc==2 && std::string_view(argv[1])=="--two-device") {
+        int count=0;checked(cudaGetDeviceCount(&count));if(count<2)return 77;
+        for(int device=0;device<2;++device) {
+            checked(cudaSetDevice(device));activation_codec();
+            for(const auto& f:formats)run(f,17,256,257,true);
+            std::cout<<"MXFP8 device "<<device<<" independent qualification passed\n";
+        }
+        return 0;
+    }
+    if(argc==2 && std::string_view(argv[1])=="--bench") {
+        for(int i=0;i<5;++i)bench(formats[i],5120,5120,256);
+        bench(formats[1],17408,5120,256);bench(formats[1],5120,17408,256);
+        bench(formats[1],8192,5120,256);return 0;
+    }
+    for(const auto& f:formats)run(f,17,256,257,true);
+    run(formats[1],128,5120,256,false);run(formats[2],33,6144,1024,false);run(formats[5],17,17408,256,false);
+    run(formats[7],129,512,1023,true);
+    for(const auto& f:formats)for(int scale_case=1;scale_case<=3;++scale_case)run(f,3,256,257,false,scale_case);
+    large_slab(formats[1]);
+    std::cout<<"MXFP8 independent codec/FP64/public-Op qualification passed\n";return 0;
+}catch(const std::exception&e){std::cerr<<e.what()<<"\n";return 1;}}
