+__device__ __forceinline__ unsigned selectors(unsigned w,int shift) {
+    return ((w>>shift)&7u)|(((w>>(8+shift))&7u)<<4)|
+           (((w>>(16+shift))&7u)<<8)|(((w>>(24+shift))&7u)<<12);
+}
+__device__ __forceinline__ unsigned selector_max(unsigned s) {
+    return max(max(s&7u,(s>>4)&7u),max((s>>8)&7u,(s>>12)&7u));
+}
+template <ggml_type type>
+__device__ __forceinline__ unsigned table_word(const std::uint32_t* grid,int i) {
+    if constexpr(type==GGML_TYPE_IQ3_S || type==GGML_TYPE_IQ3_XXS) {
+        const unsigned s=selectors(grid[i],type==GGML_TYPE_IQ3_S?1:3);
+        return s|(selector_max(s)<<16);
+    } else {
+        const unsigned a=selectors(grid[2*i],4),b=selectors(grid[2*i+1],4);
+        return a|(b<<16)|(max(selector_max(a),selector_max(b))<<30);
