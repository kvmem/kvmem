+void bench(const Format& f,int n,int k,int t) {
+    const auto b=gguf_block_shape(f.q);const auto rb=std::int64_t(k/b.elements)*b.bytes;
+    std::mt19937 rng(5526);std::vector<unsigned char> raw(n*rb+256);for(auto&v:raw)v=static_cast<unsigned char>(rng()%256);
+    const auto h=__float2half(.0125f);unsigned short hs;std::memcpy(&hs,&h,2);
+    for(std::size_t at=0;at<std::size_t(n)*rb;at+=b.bytes)for(int off:f.scales)std::memcpy(raw.data()+at+off,&hs,2);
+    std::vector<__nv_bfloat16>x(k*t);for(std::size_t i=0;i<x.size();++i)x[i]=__float2bfloat16(float(int(i%131)-65)*.015625f);
+    DeviceBuffer dw(raw.size()),dx(x.size()*2),dy(std::size_t(n)*t*4);
+    dw.copy_from_host(raw.data(),raw.size());dx.copy_from_host(x.data(),x.size()*2);
+    Weight w;w.qtype=f.q;w.layout=QuantLayout::GgufBlocks;w.scale_dtype=DType::FP16;w.n=n;w.k=k;w.qdata=dw.p;
+    Tensor tx(dx.p,DType::BF16,{k,t}),ty(dy.p,DType::FP32,{n,t});
+    DeviceBuffer activation(mx::tile_activation_bytes(k,t));
+    mx::quantize_tile(static_cast<const __nv_bfloat16*>(dx.p),k,t,nullptr,activation.p,nullptr);checked(cudaDeviceSynchronize());
+    ops::gguf::VectorOutput out;out.f32=static_cast<float*>(dy.p);out.column_stride=n;
+    for(int trial=0;trial<4;++trial) {
+    cudaStream_t stream;checked(cudaStreamCreateWithFlags(&stream,cudaStreamNonBlocking));
+    for(int i=0;i<3;++i)mx::tile_product(ops::detail::gguf_type(f.q),dw.p,rb,n,k,activation.p,t,out,stream);
+    checked(cudaStreamSynchronize(stream));
+    constexpr int batch=16,repeats=32;
+    checked(cudaStreamBeginCapture(stream,cudaStreamCaptureModeGlobal));
+    for(int i=0;i<batch;++i)mx::tile_product(ops::detail::gguf_type(f.q),dw.p,rb,n,k,activation.p,t,out,stream);
+    cudaGraph_t graph;checked(cudaStreamEndCapture(stream,&graph));cudaGraphExec_t exe;
