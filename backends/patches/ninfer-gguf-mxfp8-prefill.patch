+// Byte offset of half h (16 bytes) of weight row r in a 32-value plane, swizzled for ldmatrix.
+__device__ __forceinline__ int a_offset(int r, int h) { return r * 32 + ((h ^ ((r >> 2) & 1)) << 4); }
