+// Match the existing cuBLASLt path: decode stored blocks in FP32, actual per-32 amax,
+// round directly to E4M3 under a power-of-two scale; no FP16 intermediate or range bound.
+template <ggml_type type>
+__device__ __forceinline__ unsigned fp8_decode(const std::uint8_t* b, int u,
+                                               const std::uint32_t* tab, int (&out)[8]) {
+    if constexpr(kRawLookup<type>)return raw_lookup::decode<type>(b,u,tab,out);
+    vec::Slice sl;
+    vec::Decoder<type>::decode(b,u,tab,sl);
+    float v[32]; float amax=0.0f;
+#pragma unroll
+    for(int j=0;j<32;++j) {
+        const unsigned byte=(unsigned(sl.w[j/4])>>(8*(j%4)))&255u;
+        if constexpr(type==GGML_TYPE_Q2_K) {
+            v[j]=j<16? sl.f[0]*float(byte)-sl.f[2] : sl.f[1]*float(byte)-sl.f[3];
+        } else if constexpr(type==GGML_TYPE_Q4_K) {
+            v[j]=sl.f[0]*float(byte)-sl.f[1];
+        } else {
+            const float c=float(static_cast<signed char>(byte));
+            if constexpr(type==GGML_TYPE_IQ2_XS || type==GGML_TYPE_IQ2_S) {
