+#pragma once
+
+#include "ggml_bridge.h"
+
+// Experimental GGUF prefill: per-32 E4M3 operands / E8M0 power-of-two scales,
+// native block-scaled GEMM with FP32 accumulation/output. All storage is caller-owned.
+// The environment switch is read once at process start and must precede workspace planning.
+namespace ninfer::ops::gguf::mxfp8 {
+inline constexpr int kMinColumns = 256; // above every supported decode/verify batch (<=128)
+[[nodiscard]] bool enabled();
+[[nodiscard]] bool supported(GgmlType type, int k);
+[[nodiscard]] bool takes_tile(GgmlType type, int k, int columns);
+[[nodiscard]] std::size_t tile_activation_bytes(int k, int columns);
+void quantize_tile(const __nv_bfloat16* x, int k, int columns,
+                   const std::int32_t* input_columns, void* activation, cudaStream_t stream);
+void tile_product(GgmlType type, const void* weight, std::int64_t row_bytes, int rows, int k,
+                  const void* activation, int columns, const VectorOutput& out,
+                  cudaStream_t stream);
+[[nodiscard]] std::size_t activation_bytes(int k, int columns);
+[[nodiscard]] std::size_t scratch_bytes(int k, int rows, int columns);
+void quantize(const __nv_bfloat16* x, int k, int columns,
+              const std::int32_t* input_columns, void* activation, cudaStream_t stream);
+void product(GgmlType type, const void* weight, std::int64_t row_bytes, int rows, int k,
+             const void* activation, int columns, float* out, std::int64_t stride,
+             void* scratch, std::size_t scratch_size, cudaStream_t stream);
+} // namespace ninfer::ops::gguf::mxfp8
diff --git a/src/ops/linear/gguf/gguf_mxfp8_tile.cuh b/src/ops/linear/gguf/gguf_mxfp8_tile.cuh
new file mode 100644
index 0000000000000000000000000000000000000000..a48b0fd6f58bcdb8f9f566f95da202010499ec48
--- /dev/null
+++ b/src/ops/linear/gguf/gguf_mxfp8_tile.cuh
@@ -0,0 +1,732 @@
+#pragma once
+// Pipeline adapted from 2-com-org/ninfer-5060-qwen at 08c4fb70bec11063cae42eafe1c1b0dc3a7f993e.
+// FP8-only private implementation. The local decoder, exact amax and direct FP32 -> E4M3
+// conversion preserve this branch's numerical boundaries. No q8_1 route changes.
+#include "ggml_bridge_vec.cuh"
+#include <mutex>
+#include <set>
+namespace ninfer::ops::gguf::detail::mxfp8_tile {
+struct TileArgs {
+    const std::uint8_t* weight;
+    std::int64_t row_bytes;
+    int rows;
+    int k;
+    int columns;
+    int columns_pad;       // columns rounded up to the 128-column tile
+    const std::int8_t* qs; // [columns][k]: int8, or e4m3 bytes in the MXFP8 form
+    const float* d;        // [k/32][columns_pad]: carrier bits = UE8M0 exponent << 23
+    VecStore out;
+    bool mxfp8; // the MXFP8 form (a 120a build): e4m3 weights and activations, UE8M0 scales
+};
+enum Epi : int {
+    kEpiF32      = 0, // FP32 Store
+    kEpiBf16     = 1, // BF16 Store
+    kEpiBf16Add  = 2, // BF16 Accumulate
+    kEpiBf16Silu = 3, // BF16 GateProduct with SiLU
+    kEpiGeneric  = 4, // vec_store
+};
+
+// What the epilogue reads at (row, column): the gate of a gated product, the output it accumulates
+// into, nothing for a store.
+template <int EPI>
+__device__ __forceinline__ float epi_operand(const VecStore& out, int row, int column) {
+    const std::int64_t at = std::int64_t(column) * out.column_stride + row;
+    if constexpr (EPI == kEpiBf16Add) {
+        return __bfloat162float(out.bf16[at]);
+    } else if constexpr (EPI == kEpiBf16Silu) {
+        return out.gate[std::int64_t(column) * out.gate_column_stride + row];
+    } else if constexpr (EPI == kEpiGeneric) {
+        if (out.epilogue == Epilogue::GateProduct) {
+            return out.gate[std::int64_t(column) * out.gate_column_stride + row];
+        }
+        if (out.epilogue == Epilogue::Accumulate) {
+            return out.f32 != nullptr ? out.f32[at] : __bfloat162float(out.bf16[at]);
+        }
+        return 0.0f;
+    } else {
+        return 0.0f;
