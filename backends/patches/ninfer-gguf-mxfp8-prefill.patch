+// Decode grid indices directly to E4M3. The table carries the actual maximum
+// selector of each entry, so this retains actual amax rather than a grid bound.
+template <ggml_type type>
+inline constexpr bool kRawLookup=type==GGML_TYPE_IQ3_XXS || type==GGML_TYPE_IQ3_S ||
+    type==GGML_TYPE_IQ2_XXS || type==GGML_TYPE_IQ2_XS || type==GGML_TYPE_IQ2_S;
