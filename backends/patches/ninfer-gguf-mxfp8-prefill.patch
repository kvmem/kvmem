diff --git a/src/ops/linear/gguf/gguf_mxfp8.cu b/src/ops/linear/gguf/gguf_mxfp8.cu
new file mode 100644
index 0000000000000000000000000000000000000000..2e48ec2d85697ffdfdffce12ad3684c58f892a6c
--- /dev/null
+++ b/src/ops/linear/gguf/gguf_mxfp8.cu
@@ -0,0 +1,447 @@
+// Adapted from 2-com-org/ninfer-5060-qwen (7f189ba2; source blobs recorded in provenance).
+// MXFP8 only: actual per-32 amax on decoded FP32 weights, FP32 GEMM output, caller-owned slabs.
+// No FP16 weight intermediate, NVFP4 route, or change to the existing q8_1 decoder/mainloop.
+#include "gguf_mxfp8.h"
+#include "ggml_bridge_vec.cuh"
+#include "gguf_mxfp8_tile.cuh"
+#include "../../common/device_tier.h"
+#include <cublasLt.h>
+#include <algorithm>
+#include <array>
+#include <cstdio>
+#include <map>
+#include <mutex>
+#include <stdexcept>
+
+namespace ninfer::ops::gguf::mxfp8 {
+namespace {
+namespace vec = ninfer::ops::gguf::detail::vec;
+using ninfer::ops::gguf::detail::check;
+using ninfer::ops::gguf::detail::device_facts;
+constexpr int kImageThreads = 256;
+constexpr int kTileQuantizeThreads = 128;
+// A bounded 64 MiB image amortizes cuBLASLt dispatch on the dense prefill shapes.
+constexpr std::size_t kImageBytes = 64ULL << 20;
+std::size_t round256(std::size_t n) { return (n + 255) / 256 * 256; }
+int pad128(int n) { return (n + 127) / 128 * 128; }
+__host__ __device__ constexpr std::size_t lt_scale_offset(int row,int group,int groups) {
+    return (std::size_t(row/128)*std::size_t((groups+3)/4)+std::size_t(group/4))*512 +
+           std::size_t(row%32)*16 + std::size_t(row%128/32)*4 + std::size_t(group%4);
+}
+std::size_t scale_bytes(int rows,int k) { return std::size_t(pad128(rows)) * ((k/32+3)/4)*4; }
+int max_pass(int k,int rows) { return std::min(pad128(rows),std::max(128,int(kImageBytes/k)/128*128)); }
+// ceil(log2(amax/448)), clamped to E8M0's finite scale range. frexp avoids underflow
+// of amax/448 for tiny finite BF16 values. All-zero blocks use scale one.
+__device__ __forceinline__ unsigned exponent(float amax) {
+    if (amax == 0.0f) return 127;
+    int e=0;const float f=frexpf(amax,&e);
+    e-=9;if(f>0.875f)++e;
+    return unsigned(max(-127,min(127,e))+127);
+}
+struct ImageArgs {
+    const std::uint8_t* weight; std::int64_t row_bytes; int rows;int k;
+    std::uint8_t* image;std::uint8_t* scales;int padded_rows;
+};
+template <ggml_type type>
+__device__ __forceinline__ void slice_values(const vec::Slice& s, float (&v)[32]) {
+#pragma unroll
+    for (int i = 0; i < 32; ++i) {
+        const unsigned byte = (unsigned(s.w[i / 4]) >> (8 * (i % 4))) & 0xFFu;
+        if constexpr (type == GGML_TYPE_Q2_K) {
+            v[i] = i < 16 ? s.f[0] * float(byte) - s.f[2] : s.f[1] * float(byte) - s.f[3];
+        } else if constexpr (type == GGML_TYPE_IQ1_S) {
+            v[i] = s.f[0] * (float(byte) + s.f[1]);
+        } else if constexpr (type == GGML_TYPE_IQ1_M) {
+            v[i] = (i < 16 ? s.f[0] : s.f[1]) * (float(byte) + s.f[2 + i / 8]);
+        } else if constexpr (type == GGML_TYPE_Q4_K) {
+            v[i] = s.f[0] * float(byte) - s.f[1];
+        } else {
+            const float c = float(static_cast<signed char>(byte));
+            if constexpr (type == GGML_TYPE_IQ2_XS || type == GGML_TYPE_IQ2_S ||
+                          type == GGML_TYPE_Q6_K) {
+                v[i] = (i < 16 ? s.f[0] : s.f[1]) * c;
+            } else {
+                v[i] = s.f[0] * c;
+            }
+        }
+    }
+}
+
+// Slice `at` of a [rows][k] GGUF matrix (row-major over the rows' 32-value slices) as 32 floats,
+// its row and its first value's column; false past the last row.
+template <ggml_type type>
+__device__ __forceinline__ bool decode_slice(const std::uint8_t* weight, std::int64_t row_bytes,
+                                             int rows, int k, std::int64_t at,
+                                             const std::uint32_t* table, int& row,
+                                             std::int64_t& first, float (&v)[32]) {
+    using D                      = vec::Decoder<type>;
+    constexpr int kSlices        = D::kBlockElems / 32;
+    const int blocks             = k / D::kBlockElems;
+    const int u                  = int(at % kSlices);
+    const std::int64_t row_block = at / kSlices;
+    const int b                  = int(row_block % blocks);
+    row                          = int(row_block / blocks);
+    first                        = std::int64_t(b) * D::kBlockElems + 32 * u;
+    if (row >= rows) { return false; }
+    vec::Slice s;
+    D::decode(weight + std::int64_t(row) * row_bytes + std::int64_t(b) * D::kBlockBytes, u, table,
+              s);
+    slice_values<type>(s, v);
+    return true;
+}
+
+// The decoder's grid table in shared memory (every thread of the block calls this first).
+template <ggml_type type>
+__device__ __forceinline__ const std::uint32_t* stage_table() {
+    using D = vec::Decoder<type>;
+    __shared__ std::uint32_t table[D::kTableWords > 0 ? D::kTableWords : 1];
+    if constexpr (D::kTableWords > 0) {
+        for (int i = threadIdx.x; i < D::kTableWords; i += blockDim.x) { table[i] = D::table()[i]; }
+        __syncthreads();
+    }
+    return table;
+}
+
+template <bool kLt>
+__global__ void quantize_fp8_kernel(const __nv_bfloat16* __restrict__ x,
+                                    const std::int32_t* __restrict__ input_columns,
+                                    std::uint8_t* __restrict__ qs, void* __restrict__ scales, int k,
+                                    int columns, int columns_pad) {
+
+#if defined(NINFER_SM120_FP8) && __CUDA_ARCH__ >= 1200
+    const int i0     = (blockDim.x * blockIdx.y + threadIdx.x) * 4;
+    const int column = blockIdx.x;
+    if (i0 >= k) { return; }
+    const auto put = [&](unsigned e) {
+        if constexpr (kLt) {
+            static_cast<std::uint8_t*>(scales)[lt_scale_offset(column, i0 / 32, k / 32)] =
+                static_cast<std::uint8_t>(e);
+        } else {
+            static_cast<float*>(scales)[std::int64_t(i0 / 32) * columns_pad + column] =
+                __uint_as_float(e << 23);
+        }
+    };
+    if (column >= columns) {
+        *reinterpret_cast<unsigned*>(qs + std::int64_t(column) * k + i0) = 0;
+        if (i0 % 32 == 0) { put(127u); }
+        return;
+    }
+    const __nv_bfloat16* source = x + std::int64_t(column) * k;
+    float4 xi;
+    if (input_columns != nullptr) {
+        xi = make_float4(__bfloat162float(source[input_columns[i0 + 0]]),
+                         __bfloat162float(source[input_columns[i0 + 1]]),
+                         __bfloat162float(source[input_columns[i0 + 2]]),
+                         __bfloat162float(source[input_columns[i0 + 3]]));
+    } else {
+        const uint2 words = *reinterpret_cast<const uint2*>(source + i0);
+        const float2 lo   = __bfloat1622float2(*reinterpret_cast<const __nv_bfloat162*>(&words.x));
+        const float2 hi   = __bfloat1622float2(*reinterpret_cast<const __nv_bfloat162*>(&words.y));
+        xi                = make_float4(lo.x, lo.y, hi.x, hi.y);
+    }
+    float amax = fabsf(xi.x);
+    amax       = fmaxf(amax, fabsf(xi.y));
+    amax       = fmaxf(amax, fabsf(xi.z));
+    amax       = fmaxf(amax, fabsf(xi.w));
+#pragma unroll
+    for (int offset = 4; offset > 0; offset >>= 1) {
+        amax = fmaxf(amax, __shfl_xor_sync(0xFFFFFFFF, amax, offset, WARP_SIZE));
+    }
+    // Scale 2^E with amax * 2^-E in (224, 448]: no value saturates.
+    const unsigned e = exponent(amax);
+    const float unscale = ldexpf(1.0f, 127 - int(e));
+    unsigned short lo, hi;
+    asm("cvt.rn.satfinite.e4m3x2.f32 %0, %1, %2;"
+        : "=h"(lo)
+        : "f"(xi.y * unscale), "f"(xi.x * unscale));
+    asm("cvt.rn.satfinite.e4m3x2.f32 %0, %1, %2;"
+        : "=h"(hi)
+        : "f"(xi.w * unscale), "f"(xi.z * unscale));
+    *reinterpret_cast<unsigned*>(qs + std::int64_t(column) * k + i0) =
+        unsigned(lo) | (unsigned(hi) << 16);
+    if (i0 % 32 == 0) { put(e); }
+#else
+    __trap();
+#endif
+}
+
+template <ggml_type type>
+__launch_bounds__(kImageThreads) __global__ void image_kernel(ImageArgs p) {
+#if defined(NINFER_SM120_FP8) && __CUDA_ARCH__ >= 1200
+    const std::uint32_t* table=stage_table<type>();
+    const std::int64_t at=std::int64_t(blockIdx.x)*blockDim.x+threadIdx.x;
+    int row=0;std::int64_t first=0;float v[32]{};
+    const bool valid=decode_slice<type>(p.weight,p.row_bytes,p.rows,p.k,at,table,row,first,v);
+    float amax=0;
+#pragma unroll
+    for(int i=0;i<32;++i)amax=fmaxf(amax,fabsf(v[i]));
+    const unsigned e=exponent(amax);const float inv=ldexpf(1.0f,127-int(e));
+    const unsigned e1=__shfl_down_sync(0xffffffff,e,1),e2=__shfl_down_sync(0xffffffff,e,2),e3=__shfl_down_sync(0xffffffff,e,3);
+    if(row>=p.padded_rows)return;
+    auto* dst=reinterpret_cast<unsigned*>(p.image+std::int64_t(row)*p.k+first);
+#pragma unroll
+    for(int i=0;i<8;++i){
+        unsigned short a,b;
+        asm("cvt.rn.satfinite.e4m3x2.f32 %0, %1, %2;":"=h"(a):"f"(v[4*i+1]*inv),"f"(v[4*i]*inv));
+        asm("cvt.rn.satfinite.e4m3x2.f32 %0, %1, %2;":"=h"(b):"f"(v[4*i+3]*inv),"f"(v[4*i+2]*inv));
+        dst[i]=unsigned(a)|(unsigned(b)<<16);
+    }
+    const int group=int(first/32);
+    if(group%4==0)*reinterpret_cast<unsigned*>(p.scales+lt_scale_offset(row,group,p.k/32))=e|(e1<<8)|(e2<<16)|(e3<<24);
+#else
+    __trap();
+#endif
+}
+template<ggml_type Type> void image_launch(const ImageArgs& p,cudaStream_t s){
+    image_kernel<Type><<<unsigned(std::int64_t(p.padded_rows)*(p.k/32)/kImageThreads),kImageThreads,0,s>>>(p);
+    check(cudaGetLastError(),"MXFP8 weight image");
+}
+void image(GgmlType type,const ImageArgs& p,cudaStream_t s){
+    switch(type){
+#define IMAGE(T) case GgmlType::T:return image_launch<GGML_TYPE_##T>(p,s)
+    IMAGE(IQ3_XXS);IMAGE(IQ3_S);IMAGE(IQ2_XXS);IMAGE(IQ2_XS);IMAGE(IQ2_S);IMAGE(IQ4_XS);IMAGE(Q2_K);IMAGE(Q4_K);
+#undef IMAGE
+    default:throw std::invalid_argument("unsupported MXFP8 weight type");
+    }
+}
+__global__ void crop(const float* in,int padded,int rows,int columns,float* out,std::int64_t ld){
+    const std::int64_t i=std::int64_t(blockIdx.x)*blockDim.x+threadIdx.x;
+    if(i<std::int64_t(rows)*columns)out[(i/rows)*ld+i%rows]=in[(i/rows)*padded+i%rows];
+}
+int lt_wave_pass(int rows, int columns, int k, int most, bool stacked) {
+    const std::int64_t sms          = std::max(1, device_facts().sm_count);
+    const std::int64_t column_tiles = (columns + 127) / 128;
+    const auto waves                = [&](int count) {
+        const std::int64_t row_tiles = (count + 127) / 128 * (stacked ? 2 : 1);
+        return (row_tiles * column_tiles + sms - 1) / sms;
+    };
+    const double pass_cost = 1024.0 / double(std::max(k, 1024));
+    int best               = most;
+    double best_cost       = 0.0;
+    for (int pass = most; pass >= 128; pass -= 128) {
+        const int full = rows / pass, rest = rows % pass;
+        const int passes = full + (rest != 0 ? 1 : 0);
+        const double cost =
+            double(full * waves(pass) + (rest != 0 ? waves(rest) : 0)) + pass_cost * passes;
+        if (pass == most || cost < best_cost - 1e-9) {
+            best      = pass;
+            best_cost = cost;
+        }
+    }
+    return best;
+}
+
+void check_lt(cublasStatus_t status, const char* what) {
+    if (status != CUBLAS_STATUS_SUCCESS) {
+        throw std::runtime_error(std::string("gguf cuBLASLt ") + what + ": status " +
+                                 std::to_string(int(status)));
+    }
+}
+
+cublasLtHandle_t lt_handle() {
+    static std::array<cublasLtHandle_t, 16> handles{};
+    static std::array<std::once_flag, 16> once;
+    int device = 0;
+    check(cudaGetDevice(&device), "device");
+    if (device < 0 || device >= int(handles.size())) {
+        throw std::invalid_argument("gguf: device ordinal out of range");
+    }
+    // As blas_handle: the first use may be inside a CUDA graph capture.
+    std::call_once(once[device], [&] {
+        cudaStreamCaptureMode mode = cudaStreamCaptureModeRelaxed;
+        check(cudaThreadExchangeStreamCaptureMode(&mode), "capture mode");
+        const cublasStatus_t created = cublasLtCreate(&handles[device]);
+        check(cudaThreadExchangeStreamCaptureMode(&mode), "capture mode");
+        check_lt(created, "create");
+    });
+    return handles[device];
+}
+
+// D[m, n] (FP32, column-major, columns ld apart) = image[m, k] x activation[n, k]^T,
+// plus D when accumulating. E4M3 operands under VEC32_UE8M0 scales, FP32 accumulation,
+// no cuBLASLt workspace; operand and output buffers belong to the caller.
+struct LtKey {
+    int device;
+    int m;
+    int n;
+    int k;
+    std::int64_t ld;
+    bool accumulate;
+    auto operator<=>(const LtKey&) const = default;
+};
+
+struct LtPlan {
+    cublasLtMatmulDesc_t op  = nullptr;
+    cublasLtMatrixLayout_t a = nullptr;
+    cublasLtMatrixLayout_t b = nullptr;
+    cublasLtMatrixLayout_t d = nullptr;
+    cublasLtMatmulAlgo_t algo{};
+};
+
+void lt_gemm(int m, int n, int k, const std::uint8_t* image, const std::uint8_t* image_scales,
+             const std::uint8_t* x, const std::uint8_t* x_scales, float* out,
+             std::int64_t ld, bool accumulate, cudaStream_t stream) {
+    static std::mutex mutex;
+    static std::map<LtKey, LtPlan> plans;
+    int device = 0;
+    check(cudaGetDevice(&device), "device");
+    const cublasLtHandle_t handle = lt_handle();
+    const std::lock_guard lock(mutex);
+    const auto set_scales = [&](cublasLtMatmulDesc_t op) {
+        check_lt(cublasLtMatmulDescSetAttribute(op, CUBLASLT_MATMUL_DESC_A_SCALE_POINTER,
+                                                &image_scales, sizeof image_scales),
+                 "image scales");
+        check_lt(cublasLtMatmulDescSetAttribute(op, CUBLASLT_MATMUL_DESC_B_SCALE_POINTER,
+                                                &x_scales, sizeof x_scales),
+                 "activation scales");
+    };
+    auto [found, inserted] = plans.try_emplace(LtKey{device, m, n, k, ld, accumulate});
+    LtPlan& plan           = found->second;
+    if (inserted) {
+        try {
+            check_lt(cublasLtMatmulDescCreate(&plan.op, CUBLAS_COMPUTE_32F, CUDA_R_32F), "desc");
+            const cublasOperation_t ta = CUBLAS_OP_T, tb = CUBLAS_OP_N;
+            check_lt(cublasLtMatmulDescSetAttribute(plan.op, CUBLASLT_MATMUL_DESC_TRANSA, &ta,
+                                                    sizeof ta),
+                     "transa");
+            check_lt(cublasLtMatmulDescSetAttribute(plan.op, CUBLASLT_MATMUL_DESC_TRANSB, &tb,
+                                                    sizeof tb),
+                     "transb");
+            const cublasLtMatmulMatrixScale_t mode = CUBLASLT_MATMUL_MATRIX_SCALE_VEC32_UE8M0;
+            check_lt(cublasLtMatmulDescSetAttribute(plan.op, CUBLASLT_MATMUL_DESC_A_SCALE_MODE,
+                                                    &mode, sizeof mode),
+                     "image scale mode");
+            check_lt(cublasLtMatmulDescSetAttribute(plan.op, CUBLASLT_MATMUL_DESC_B_SCALE_MODE,
+                                                    &mode, sizeof mode),
+                     "activation scale mode");
+            // The heuristic requires the scale pointers set (it finds no algorithm without them).
+            set_scales(plan.op);
+            const cudaDataType_t in_type = CUDA_R_8F_E4M3;
+            check_lt(cublasLtMatrixLayoutCreate(&plan.a, in_type, k, m, k), "image layout");
+            check_lt(cublasLtMatrixLayoutCreate(&plan.b, in_type, k, n, k), "x layout");
+            check_lt(cublasLtMatrixLayoutCreate(&plan.d, CUDA_R_32F, m, n, ld), "out layout");
+            cublasLtMatmulPreference_t preference = nullptr;
+            check_lt(cublasLtMatmulPreferenceCreate(&preference), "preference");
+            const std::size_t workspace = 0;
+            const cublasStatus_t set   = cublasLtMatmulPreferenceSetAttribute(
+                preference, CUBLASLT_MATMUL_PREF_MAX_WORKSPACE_BYTES, &workspace, sizeof workspace);
+            cublasLtMatmulHeuristicResult_t results[8]{};
+            int count                  = 0;
+            const cublasStatus_t heuristic =
+                set == CUBLAS_STATUS_SUCCESS
+                    ? cublasLtMatmulAlgoGetHeuristic(handle, plan.op, plan.a, plan.b, plan.d,
+                                                     plan.d, preference, 8, results, &count)
+                    : set;
+            cublasLtMatmulPreferenceDestroy(preference);
+            check_lt(heuristic, "heuristic");
+            if (count == 0) {
+                throw std::runtime_error("gguf cuBLASLt: no block-scaled algorithm for m=" +
+                                         std::to_string(m) + " n=" + std::to_string(n) +
+                                         " k=" + std::to_string(k));
+            }
+            // Prefer an unsplit candidate, as in the ported host planner. This is a
+            // scheduling heuristic, not an assertion about MXFP8 speed on every geometry.
+            plan.algo = results[0].algo;
+            for (int c = 0; c < count; ++c) {
+                std::uint32_t splits = 0;
+                std::size_t written  = 0;
+                if (cublasLtMatmulAlgoConfigGetAttribute(&results[c].algo,
+                                                         CUBLASLT_ALGO_CONFIG_SPLITK_NUM, &splits,
+                                                         sizeof splits, &written) ==
+                        CUBLAS_STATUS_SUCCESS &&
+                    written == sizeof splits && splits == 1) {
+                    plan.algo = results[c].algo;
+                    break;
+                }
+            }
+        } catch (...) {
+            if (plan.d != nullptr) { cublasLtMatrixLayoutDestroy(plan.d); }
+            if (plan.b != nullptr) { cublasLtMatrixLayoutDestroy(plan.b); }
+            if (plan.a != nullptr) { cublasLtMatrixLayoutDestroy(plan.a); }
+            if (plan.op != nullptr) { cublasLtMatmulDescDestroy(plan.op); }
+            plans.erase(found);
+            throw;
+        }
+    } else {
+        set_scales(plan.op);
+    }
+    const float alpha = 1.0f;
+    const float beta  = accumulate ? 1.0f : 0.0f;
+    const float* alpha_pointer = &alpha;
+    const float* beta_pointer  = &beta;
+    check_lt(cublasLtMatmul(handle, plan.op, alpha_pointer, image, plan.a, x, plan.b, beta_pointer,
+                            out, plan.d, out, plan.d, &plan.algo, nullptr, 0, stream),
+             "matmul");
+}
+
+
+} // namespace
+bool supported(GgmlType type,int k){
+#if defined(NINFER_SM120_FP8)
+    if(!current_device_blackwell() || k<=0 || k%256 || device_facts().cc<1200 || device_facts().cc>=1300 || cublasLtGetVersion()<120800)return false;
+    switch(type){case GgmlType::IQ3_XXS:case GgmlType::IQ3_S:case GgmlType::IQ2_XXS:case GgmlType::IQ2_XS:case GgmlType::IQ2_S:case GgmlType::IQ4_XS:case GgmlType::Q2_K:case GgmlType::Q4_K:return true;default:return false;}
+#else
+    return false;
+#endif
+}
+std::size_t activation_bytes(int k,int t){return round256(std::size_t(k)*pad128(t))+round256(scale_bytes(pad128(t),k));}
+bool takes_tile(GgmlType type,int k,int columns) {
+    return columns>=kMinColumns && columns<1024 && supported(type,k);
+}
+std::size_t tile_activation_bytes(int k,int columns) {
+    return round256(std::size_t(k)*pad128(columns)) + round256(std::size_t(k/32)*pad128(columns)*sizeof(float));
+}
+void quantize_tile(const __nv_bfloat16* x,int k,int columns,const std::int32_t* gather,void* activation,cudaStream_t stream) {
+    auto* data=static_cast<std::uint8_t*>(activation);
+    const int padded=pad128(columns);
+    quantize_fp8_kernel<false><<<dim3(padded,(k+511)/512),kTileQuantizeThreads,0,stream>>>(
+        x,gather,data,data+round256(std::size_t(k)*padded),k,columns,padded);
+    check(cudaGetLastError(),"MXFP8 tile activation");
+}
+void tile_product(GgmlType type,const void* weight,std::int64_t rb,int rows,int k,
+                  const void* activation,int columns,const VectorOutput& out,cudaStream_t stream) {
+    if(!supported(type,k)||rows<=0||columns<=0||rb<std::int64_t(k/256)*block_shape(type).bytes||
+       weight==nullptr||activation==nullptr||out.column_stride<rows||
+       ((out.bf16==nullptr)==(out.f32==nullptr))||
+       (out.epilogue==Epilogue::GateProduct && (out.gate==nullptr||out.gate_column_stride<rows))) {
+        throw std::invalid_argument("invalid MXFP8 tile product");
+    }
+    namespace tile=detail::mxfp8_tile;
+    const auto* data=static_cast<const std::uint8_t*>(activation);
+    const tile::TileArgs args{static_cast<const std::uint8_t*>(weight),rb,rows,k,columns,pad128(columns),
+        reinterpret_cast<const std::int8_t*>(data),
+        reinterpret_cast<const float*>(data+round256(std::size_t(k)*pad128(columns))),
+        detail::VecStore{out.bf16,out.f32,out.column_stride,out.epilogue,out.gate,out.gate_column_stride,int(out.activation)},true};
+    switch(type) {
+#define TILE(T) case GgmlType::T:return tile::launch<GGML_TYPE_##T>(args,stream)
+    TILE(IQ3_XXS);TILE(IQ3_S);TILE(IQ2_XXS);TILE(IQ2_XS);TILE(IQ2_S);TILE(IQ4_XS);TILE(Q2_K);TILE(Q4_K);
+#undef TILE
+    default:throw std::invalid_argument("unsupported MXFP8 tile weight type");
+    }
+}
+std::size_t scratch_bytes(int k,int rows,int t){const int p=max_pass(k,rows);return round256(std::size_t(k)*p)+round256(scale_bytes(p,k))+round256(std::size_t(p)*pad128(t)*sizeof(float));}
+void quantize(const __nv_bfloat16* x,int k,int t,const std::int32_t* gather,void* activation,cudaStream_t s){
+    const int padded=pad128(t);auto* data=static_cast<std::uint8_t*>(activation);
+    auto* scales=data+round256(std::size_t(k)*padded);
+    quantize_fp8_kernel<true><<<dim3(padded,(k+511)/512),kTileQuantizeThreads,0,s>>>(x,gather,data,scales,k,t,padded);
+    check(cudaGetLastError(),"MXFP8 activation");
+}
+void product(GgmlType type,const void* weight,std::int64_t rb,int rows,int k,const void* activation,int columns,float* out,std::int64_t stride,void* scratch,std::size_t bytes,cudaStream_t s){
+    if(!supported(type,k)||rows<=0||columns<=0||stride<rows||bytes<scratch_bytes(k,rows,columns))throw std::invalid_argument("invalid MXFP8 product/workspace");
+    static std::once_flag announced;
+    std::call_once(announced,[&]{std::fprintf(stderr,"GGUF_MXFP8 first product type=%d rows=%d k=%d columns=%d FP32 accumulation\n",int(type),rows,k,columns);});
+    const int pass=lt_wave_pass(rows,columns,k,max_pass(k,rows),false),np=pad128(columns);
+    auto* codes=static_cast<std::uint8_t*>(scratch);
+    auto* scales=codes+round256(std::size_t(pass)*k);
+    auto* plane=reinterpret_cast<float*>(scales+round256(scale_bytes(pass,k)));
+    const auto* x=static_cast<const std::uint8_t*>(activation);
+    const auto* xs=x+round256(std::size_t(k)*np);
+    for(int first=0;first<rows;first+=pass){
+        const int count=std::min(pass,rows-first),mp=pad128(count);
+        image(type,{static_cast<const std::uint8_t*>(weight)+std::int64_t(first)*rb,rb,count,k,codes,scales,mp},s);
+        const bool direct=count==mp&&columns==np&&stride%4==0&&reinterpret_cast<std::uintptr_t>(out+first)%16==0;
+        lt_gemm(mp,np,k,codes,scales,x,xs,direct?out+first:plane,direct?stride:mp,false,s);
+        if(!direct){const auto total=std::int64_t(count)*columns;crop<<<unsigned((total+255)/256),256,0,s>>>(plane,mp,count,columns,out+first,stride);check(cudaGetLastError(),"MXFP8 output crop");}
+    }
+}
+} // namespace ninfer::ops::gguf::mxfp8
