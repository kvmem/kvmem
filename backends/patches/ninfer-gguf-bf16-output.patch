+std::size_t bf16_scratch_bytes(int k,int rows) {
+    const int p=max_pass(k,rows);
+    return round256(std::size_t(k)*p)+round256(scale_bytes(p,k));
+}
+void bf16_product(GgmlType type,const void* weight,std::int64_t rb,int rows,int k,
+                  const void* activation,int columns,const VectorOutput& out,
+                  void* scratch,std::size_t bytes,cudaStream_t stream) {
+    if (!supported(type,k) || rows<=0 || columns<=0 || !takes_bf16_output(out) ||
+        out.column_stride<rows || bytes<bf16_scratch_bytes(k,rows))
+        throw std::invalid_argument("invalid MXFP8 BF16 product/workspace");
+    const int pass=lt_wave_pass(rows,columns,k,max_pass(k,rows),false);
+    auto* codes=static_cast<std::uint8_t*>(scratch);
+    auto* scales=codes+round256(std::size_t(pass)*k);
+    const auto* x=static_cast<const std::uint8_t*>(activation);
+    const auto* xs=x+round256(std::size_t(k)*pad128(columns));
+    for(int first=0;first<rows;first+=pass) {
+        const int count=std::min(pass,rows-first),mp=pad128(count);
+        image(type,{static_cast<const std::uint8_t*>(weight)+std::int64_t(first)*rb,
+                    rb,count,k,codes,scales,mp},stream);
+        lt_gemm(count,columns,k,codes,scales,x,xs,out.bf16+first,out.column_stride,
+                out.epilogue==Epilogue::Accumulate,true,stream);
+    }
+}
