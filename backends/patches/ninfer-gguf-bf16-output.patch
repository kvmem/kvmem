+bool takes_bf16_output(const VectorOutput& out) {
+    return out.bf16!=nullptr && out.f32==nullptr &&
+           (out.epilogue==Epilogue::Store || out.epilogue==Epilogue::Accumulate) &&
+           reinterpret_cast<std::uintptr_t>(out.bf16)%16==0 && out.column_stride%8==0;
