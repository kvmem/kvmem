+                checked(cudaStreamBeginCapture(stream,cudaStreamCaptureModeGlobal));
+                ops::detail::gguf_project(tx,std::span(products.data(),count),work,stream);
+                cudaGraph_t graph;checked(cudaStreamEndCapture(stream,&graph));cudaGraphExec_t exe;
+                checked(cudaGraphInstantiate(&exe,graph,nullptr,nullptr,0));checked(cudaGraphLaunch(exe,stream));checked(cudaStreamSynchronize(stream));
+                std::vector<__nv_bfloat16>bits(n*t);mixed_output.copy_to_host(bits.data(),bits.size()*2);
+                std::vector<float>mixed(n*t);for(int i=0;i<n*t;++i)mixed[i]=__bfloat162float(bits[i]);
