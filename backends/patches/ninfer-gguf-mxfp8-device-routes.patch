+    weight.n=n;weight.k=k;weight.qdata=dw.p;
+    const ops::detail::GgufShape shapes[]={{f.q,n,k},{f.q,n,k}};
+    WorkspaceArena work(ops::detail::gguf_project_workspace_bytes(shapes,1,t));
+    DeviceBuffer mixed_output(std::size_t(n)*t*2);
+    const Tensor tx(dx.p,DType::BF16,{k,t});
+    std::vector<int> rows,columns;
+    if(sampled){rows={0,1,127,128,n/2,n-129,n-128,n-1};columns={0,1,127,128,255};}
+    else{rows.resize(n);columns.resize(t);std::iota(rows.begin(),rows.end(),0);std::iota(columns.begin(),columns.end(),0);}
+    for(bool permute:{false,true}) {
+        weight.input_columns=permute?static_cast<int*>(dg.p):nullptr;
+        std::vector<double>ref(n*t);
+        for(int c:columns)for(int r:rows){double sum=0;for(int j=0;j<k;++j)sum+=double(w[r*k+j])*__bfloat162float(x[c*k+(permute?gather[j]:j)]);ref[c*n+r]=sum;}
+        for(const auto epi:mx::kPrefillEpilogues) {
+            const bool fp32=epi==mx::PrefillEpilogue::F32;
+            const ops::DeviceRouteForce force(mx::prefill_route_key(ops::detail::gguf_type(f.q),n,k,epi),"q8");
+            dy.fill(0x42);auto* result=static_cast<unsigned char*>(dy.p)+16;
+            Tensor y(result,fp32?DType::FP32:DType::BF16,{n,t});
+            ops::detail::GgufProduct product{&weight,&y};
+            auto expected=ref;
+            if(fp32){product.f32=reinterpret_cast<float*>(result);product.f32_rows=n;}
+            if(epi==mx::PrefillEpilogue::Add){
+                product.epilogue=ops::detail::GgufEpilogue::Accumulate;
+                std::vector<__nv_bfloat16>initial(n*t,__float2bfloat16(.25f));checked(cudaMemcpy(result,initial.data(),n*t*2,cudaMemcpyHostToDevice));
+                for(auto&v:expected)v+=.25;
+            } else if(epi==mx::PrefillEpilogue::Silu){
+                product.epilogue=ops::detail::GgufEpilogue::GateProduct;product.gate=static_cast<const float*>(gate.p);
+                for(std::size_t i=0;i<expected.size();++i)expected[i]*=double(g[i])/(1+std::exp(-double(g[i])));
+            }
+            Tensor mixed_y(mixed_output.p,DType::BF16,{n,t});
+            const std::array products{product,ops::detail::GgufProduct{&weight,&mixed_y}};
+            const auto count=fp32&&!sampled?2u:1u;
+            ops::detail::gguf_project(tx,std::span(products.data(),count),work,nullptr);checked(cudaDeviceSynchronize());
+            if(count==2) {
