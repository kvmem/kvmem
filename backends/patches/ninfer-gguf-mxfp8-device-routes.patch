+// One strictly additive catalog transition. Tests recompute both digests and
+// verify that removing only this new namespace reproduces the old catalog.
+// A future change to an existing key/candidate must not inherit this exception.
+inline constexpr std::string_view kBeforeMxfp8Catalog = "29b2a2a7f55b5a61";
+inline constexpr std::string_view kWithMxfp8Catalog = "ce71cc3cfb807c21";
