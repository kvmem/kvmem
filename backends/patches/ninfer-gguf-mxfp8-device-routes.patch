+            else{std::vector<__nv_bfloat16>bits(n*t);checked(cudaMemcpy(bits.data(),result,n*t*2,cudaMemcpyDeviceToHost));for(int i=0;i<n*t;++i)got[i]=__bfloat162float(bits[i]);}
+            std::vector<float>selected;std::vector<double>reference;
