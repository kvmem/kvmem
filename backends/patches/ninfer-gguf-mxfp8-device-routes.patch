+void routed_oracle(const Format& f,int n=128,int k=256,bool sampled=false) {
+    // Q8 is checked against independently decoded original weights and FP64
+    // dots, not against the numerically different FP8 encoded-product oracle.
+    constexpr int t=256;
+    const auto b=gguf_block_shape(f.q);const auto rb=k/b.elements*b.bytes;
+    std::mt19937 rng(7712);std::vector<unsigned char> raw(n*rb+256);
+    for(auto&v:raw)v=static_cast<unsigned char>(rng()%256);
+    const auto h=__float2half(.0125f);unsigned short hs;std::memcpy(&hs,&h,2);
+    for(int at=0;at<n*rb;at+=b.bytes)for(int off:f.scales)std::memcpy(raw.data()+at+off,&hs,2);
+    std::vector<float>w(n*k);gguf_cpu_decode(int(ops::detail::gguf_type(f.q)),raw.data(),w.data(),n*k);
+    std::normal_distribution<float>normal(0,1);std::vector<__nv_bfloat16>x(k*t);
+    for(auto&v:x)v=__float2bfloat16(normal(rng));
+    std::vector<int>gather(k);std::iota(gather.begin(),gather.end(),0);std::shuffle(gather.begin(),gather.end(),rng);
