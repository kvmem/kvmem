+    dw.copy_from_host(raw.data(),raw.size());dx.copy_from_host(x.data(),x.size()*2);dg.copy_from_host(gather.data(),k*4);
+    std::vector<float>g(n*t);for(std::size_t i=0;i<g.size();++i)g[i]=float(int(i%17)-8)*.25f;gate.copy_from_host(g.data(),g.size()*4);
