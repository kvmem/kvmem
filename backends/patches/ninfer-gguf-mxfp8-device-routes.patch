+std::string prefill_route_key(GgmlType type, std::int32_t n, std::int32_t k,
+                              PrefillEpilogue epilogue) {
+    std::string_view format;
+    for (const auto& f : kPrefillFormats) { if (f.type == type) { format = f.name; break; } }
+    std::string_view suffix;
+    switch (epilogue) {
+    case PrefillEpilogue::F32: suffix = "f32"; break;
+    case PrefillEpilogue::BF16: suffix = "bf16"; break;
+    case PrefillEpilogue::Add: suffix = "bf16-add"; break;
+    case PrefillEpilogue::Silu: suffix = "bf16-silu"; break;
+    default: return {};
+    }
+    if (format.empty()) { return {}; }
+    return std::string(kPrefillRoutePrefix) + std::string(format) + '/' +
+           std::to_string(n) + 'x' + std::to_string(k) + '/' + std::string(suffix);
+}
+
+PrefillRoute prefill_route(GgmlType type, std::int32_t n, std::int32_t k,
+                           std::int32_t tokens, PrefillEpilogue epilogue) {
+    if (!enabled() || tokens < kMinColumns || !supported(type, k)) { return PrefillRoute::Q8; }
+    if (!takes_tile(type, k, tokens)) { return PrefillRoute::Lt; }
+    // The alternate integer matrix route requires whole output-row tiles. Never
+    // let a profile extend a candidate's mathematical or implementation domain.
+    if (n > 0 && n % 128 == 0 && has_matrix_kernel(type)) {
+        const std::string key = prefill_route_key(type, n, k, epilogue);
+        if (!key.empty() && device_route_schedule(key, tokens) == "q8") {
+            return PrefillRoute::Q8;
+        }
+    }
+    return PrefillRoute::Tile;
+}
+
+std::string prefill_profile_signature(std::span<const int> devices) {
+    if (!enabled()) { return {}; }
+    std::string result = "mxfp8-e4m3-e8m0-f32-profile-v2\n";
+    for (std::size_t rank = 0; rank < devices.size(); ++rank) {
+        const DeviceBinding binding(devices[rank]);
+        result += "rank=" + std::to_string(rank) + '\n';
+        const auto profile = installed_device_route_profile();
+        if (!profile) { continue; }
+        for (const auto& [key, bands] : profile->routes) {
+            if (!key.starts_with(kPrefillRoutePrefix)) { continue; }
+            result += std::to_string(key.size()) + ':' + key + '=';
+            for (const auto& band : bands) {
+                result += std::to_string(band.last) + ':' +
+                          std::to_string(band.schedule.size()) + ':' + band.schedule + ';';
+            }
+            result += '\n';
+        }
+    }
+    return result;
+}
