+void calibrate_gguf_mxfp8(ops::DeviceRouteProfile& profile, Timer& timer,
+                          const CalibrationOptions& options) {
+    namespace mx = ops::gguf::mxfp8;
+    if (!mx::enabled() || !mx::supported(ops::gguf::GgmlType::IQ3_S, 256)) { return; }
+    // Initially measure one width. A 256-only entry must not extrapolate a
+    // winner through the wave-fill discontinuities at 384, 512, ... .
+    constexpr int tokens = 256;
+    for (const auto& format : mx::kPrefillFormats) for (const auto shape : mx::kPrefillShapes) {
+        bool selected = options.only.empty();
+        for (const auto epilogue : mx::kPrefillEpilogues) {
+            const auto key = mx::prefill_route_key(format.type, shape.n, shape.k, epilogue);
+            selected |= key.starts_with(options.only);
+        }
+        if (!selected) { continue; }
+        auto weight = gguf_vector_weight(format.qtype, shape.n, shape.k, 5526, true);
+        auto input = bf16_buffer(std::size_t(shape.k)*tokens);
+        DeviceBuffer output(std::size_t(shape.n)*tokens*sizeof(float));
+        DeviceBuffer gate(std::size_t(shape.n)*tokens*sizeof(float));
+        fill_f32_kernel<<<fill_grid(std::size_t(shape.n)*tokens),256>>>(
+            static_cast<float*>(gate.p), std::size_t(shape.n)*tokens, 0.5f);
+        CUDA_CHECK(cudaGetLastError());
+        const ops::detail::GgufShape ws_shape{format.qtype,shape.n,shape.k};
+        WorkspaceArena workspace(ops::detail::gguf_project_workspace_bytes({&ws_shape,1},tokens,tokens));
+        const Tensor x(input.p,DType::BF16,{shape.k,tokens});
+        for (const auto epilogue : mx::kPrefillEpilogues) {
+            const auto key = mx::prefill_route_key(format.type,shape.n,shape.k,epilogue);
+            if (!options.only.empty() && !key.starts_with(options.only)) { continue; }
+            const bool f32 = epilogue == mx::PrefillEpilogue::F32;
+            Tensor y(output.p,f32?DType::FP32:DType::BF16,{shape.n,tokens});
+            ops::detail::GgufProduct product{&weight.weight,&y};
+            if (f32) { product.f32=static_cast<float*>(output.p);product.f32_rows=shape.n; }
+            if (epilogue == mx::PrefillEpilogue::Add) {
+                product.epilogue=ops::detail::GgufEpilogue::Accumulate;
+            } else if (epilogue == mx::PrefillEpilogue::Silu) {
+                product.epilogue=ops::detail::GgufEpilogue::GateProduct;
+                product.gate=static_cast<const float*>(gate.p);
+            }
+            const Family family{key,{tokens},
+                [&](int, cudaStream_t stream) {
+                    ops::detail::gguf_project(x,{&product,1},workspace,stream);
+                },
+                [&](int) { return std::pair<const void*,std::size_t>{output.p,std::size_t(shape.n)*tokens}; },
+                [&] { output.fill(0); }, f32?DType::FP32:DType::BF16};
+            profile.routes[key]=sweep(family,timer,options);
+        }
+    }
+}
