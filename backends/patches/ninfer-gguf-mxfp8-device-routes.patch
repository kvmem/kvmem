+void test_additive_mxfp8_catalog() {
+    namespace compat = ninfer::runtime::detail;
+    using ninfer::ops::DeviceTier;
+    for (auto tier : {DeviceTier::Ampere,DeviceTier::Blackwell}) {
+        std::uint64_t hash=0xcbf29ce484222325ULL;
+        const auto feed=[&](std::string_view s,char end) {
+            for(char c:s){hash^=static_cast<unsigned char>(c);hash*=0x100000001b3ULL;}
+            hash^=static_cast<unsigned char>(end);hash*=0x100000001b3ULL;
+        };
+        for(const auto& item:ninfer::calibration::calibration_route_catalog(tier)) {
+            if(item.key.starts_with(compat::kMxfp8ProfilePrefix))continue;
+            feed(item.key,'\n');for(const auto& name:item.candidates)feed(name,'\0');
+        }
+        char digest[17];std::snprintf(digest,sizeof(digest),"%016llx",static_cast<unsigned long long>(hash));
+        expect(digest==compat::kBeforeMxfp8Catalog,
+               "catalog migration changes only the new MXFP8 namespace");
+        expect(ninfer::calibration::calibration_route_catalog_digest(tier)==compat::kWithMxfp8Catalog,
+               "catalog compatibility must be re-audited after any further key/candidate change");
+    }
+    expect(ninfer::calibration::calibration_route_catalog_digest(DeviceTier::Turing)=="f6b3f6b11c7a36c2",
+           "the unsupported Turing catalog remains unchanged");
+    const auto path=temporary_profile_path("mxfp8-additive");
+    auto legacy=sample_entry(compat::kBeforeMxfp8Catalog);
+    const std::string unmeasured="gguf_prefill_mxfp8/iq3_s/5120x5120/bf16";
+    legacy.profile.routes[unmeasured]={{256,"q8"}};
+    (void)ninfer::runtime::upsert_device_route_profile_atomic(path,legacy);
+    auto found=ninfer::runtime::find_device_route_profile("test-gpu-sm86",82,path,compat::kWithMxfp8Catalog);
+    expect(found && found->routes.count("attn_pv_f16")==1 && found->routes.count(unmeasured)==0,
+           "old calibrated routes survive but cannot authorize new FP8 keys");
+    auto current=sample_entry(compat::kWithMxfp8Catalog);current.profile.routes.clear();
+    const std::string measured="gguf_prefill_mxfp8/iq3_s/5120x5120/f32";
+    current.profile.routes[measured]={{256,"q8"}};
+    (void)ninfer::runtime::upsert_device_route_profile_atomic(path,current);
+    found=ninfer::runtime::find_device_route_profile("test-gpu-sm86",82,path,compat::kWithMxfp8Catalog);
+    expect(found && found->routes.count("attn_pv_f16")==1 && found->routes.count(measured)==1 &&
+               found->routes.count(unmeasured)==0,
+           "partial FP8 calibration retains old valid measurements without blessing new stale keys");
+    expect(!compat::additive_mxfp8_catalog(kCatalog,compat::kBeforeMxfp8Catalog) &&
+               !compat::additive_mxfp8_catalog(compat::kWithMxfp8Catalog,kCatalog),
+           "arbitrary catalog mismatches remain rejected");
+    std::filesystem::remove(path);
+}
