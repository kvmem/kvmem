+            const auto end=16+std::size_t(n)*t*(fp32?4:2);
+            for(int i=0;i<16;++i)if(guards[i]!=0x42||guards[end+i]!=0x42)throw std::runtime_error("routed output guard");
+        }
+    }
+    if(work.peak_used()>work.capacity())throw std::runtime_error("routed workspace capacity");
+}
