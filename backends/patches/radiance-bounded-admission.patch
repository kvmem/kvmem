+
+/* A bounded controller retires old pages after each committed chunk. Admission must use the
+ * logical context rather than require the whole prompt in the physical pool. Original positions
+ * still advance, while each compact execution view stays within the same 320-token pool. */
+TEST(a_bounded_controller_can_prefill_beyond_the_physical_pool) {
+    struct BoundedKV : FakeKV {
+        std::unordered_map<uint64_t, int64_t> offsets;
+        int64_t offset(uint64_t id) const {
+            const auto it = offsets.find(id);
+            return it == offsets.end() ? 0 : it->second;
+        }
+        int ensure_from(uint64_t id, int64_t n, int64_t) override {
+            return FakeKV::ensure(id, n - offset(id));
+        }
+        bool can_ever_fit_for(uint64_t id, int64_t n) const override {
+            return FakeKV::can_ever_fit(n - offset(id));
+        }
+        int64_t execution_offset(uint64_t id, int32_t g) const override {
+            return geom.g[(size_t)g].paged ? offset(id) : 0;
+        }
+        bool canonical(uint64_t id) const override { return offset(id) == 0; }
+        void retire_prefix(uint64_t id, int64_t frontier) {
+            CHECK_OK(FakeKV::rollback(id, 64));
+            offsets[id] = frontier - 64;
+        }
+    } kv;
+    Fixture f;
+    f.build(/*blocks=*/20, /*states=*/64, /*max_tok=*/256, /*max_ctx=*/1024,
+            /*windowed=*/false, /*linear=*/false);
+    f.cfg.prefix_cache = false;
+    kv.setup(f.prog.kv_groups, f.cfg.max_ctx, 20, 64);
+    f.pc.kv = &kv;
+    std::vector<BatchBuilder::RankIO> ranks{{0, nullptr, &f.prog}};
+    CHECK_OK(f.sch.init(f.prog, f.cfg, &kv, &f.pc, ranks));
+    f.sch.set_bounded_residency(true);
+    f.sch.set_serial_prefill(true);
+    server::Sink sink;
+    CHECK(!kv.can_ever_fit(700));
+    const uint64_t id = f.submit_to(&sink, 700, 1);
+    REQUIRE(id != 0);
+    int64_t frontier = 0;
+    int chunks = 0;
+    while (!sink.done() && chunks < 8) {
+        const RadBatch* batch = f.sch.step();
+        REQUIRE(batch != nullptr);
+        REQUIRE_EQ(f.sch.plan().e.size(), (size_t)1);
+        const auto& e = f.sch.plan().e[0];
+        CHECK_EQ(e.ctx_len, frontier);
+        CHECK_EQ(batch->positions_h[0], frontier);
+        CHECK(e.ctx_len + e.n_tokens - kv.offset(id) <= 320);
+        frontier += e.n_tokens;
+        ++chunks;
+        f.commit_plain();
+        if (!sink.done()) kv.retire_prefix(id, frontier);
+    }
+    CHECK_EQ(frontier, (int64_t)700);
+    CHECK_EQ(chunks, 3);
+    CHECK(sink.done());
+    CHECK_EQ((int)sink.finish_reason(), (int)server::Finish::Length);
+    CHECK_EQ(sink.n_produced(), (int64_t)1);
+}
+
+/* The bounded contract changes only whole-prompt physical admission. It cannot extend the
+ * logical context, and a controller that fails to make room still fails at the actual step. */
+TEST(bounded_admission_preserves_logical_and_step_capacity_checks) {
+    {
+        Fixture f;
+        f.build(/*blocks=*/10, /*states=*/64, /*max_tok=*/256, /*max_ctx=*/1024,
+                /*windowed=*/false, /*linear=*/false);
+        CHECK_OK(f.start());
+        f.sch.set_bounded_residency(true);
+        auto request = f.request(200, 1);
+        request->embed = true; // One indivisible pass cannot retire pages between chunks.
+        CHECK_EQ(f.sch.add(std::move(request)), (int)RAD_E_FULL);
+    }
+    for (int prompt : {600, 1024, 1025}) {
+        Fixture f;
+        f.build(/*blocks=*/20, /*states=*/64, /*max_tok=*/256, /*max_ctx=*/1024,
+                /*windowed=*/false, /*linear=*/false);
+        f.cfg.prefix_cache = false;
+        CHECK_OK(f.start());
+        f.sch.set_bounded_residency(true);
+        server::Sink sink;
+        const uint64_t id = f.submit_to(&sink, prompt, 1);
+        REQUIRE(id != 0);
+        if (prompt < 1024) {
+            REQUIRE(f.sch.step() != nullptr);
+            f.commit_plain();
+        }
+        CHECK(f.sch.step() == nullptr);
+        CHECK(sink.done());
+        CHECK_EQ((int)sink.finish_reason(), (int)server::Finish::Error);
+        CHECK_EQ(sink.status(), (int)RAD_E_FULL);
+        CHECK_EQ((int)f.sch.find(id)->state, (int)ReqState::Failed);
+    }
 }
 
