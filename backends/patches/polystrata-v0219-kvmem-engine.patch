diff --git a/engine/src/poly/kvmem_history.hpp b/engine/src/poly/kvmem_history.hpp
new file mode 100644
index 0000000..d3b8601
--- /dev/null
+++ b/engine/src/poly/kvmem_history.hpp
@@ -0,0 +1,268 @@
+// A managed conversation's evaluated tokens and bounded native state marks.
+// Planning is model-free. KV stays in KvmemMemory's existing bounded archive;
+// this class never copies a full attention cache or owns GPU memory.
+#pragma once
+#include "kvmem.hpp"
+#include "kvmem/prefix_checkpoint.hpp"
+#include "kvmem/checkpoint_policy.hpp"
+
+#include <algorithm>
+#include <memory>
+#include <stdexcept>
+#include <vector>
+#include <cstdio>
+
+namespace strata::poly {
+struct KvmemCanonicalImage {
+    uint64_t at=0, rows=0, width=0, hash=0;
+    bool operator==(const KvmemCanonicalImage& other) const {
+        return at==other.at && rows==other.rows && width==other.width && hash==other.hash;
+    }
+};
+struct KvmemCanonicalInput {
+    // Reservation is destroyed last, after the metadata allocations it covers.
+    std::shared_ptr<kvmem::HostKvReservation> charge;
+    std::vector<int32_t> tokens;
+    std::vector<KvmemCanonicalImage> images;
+    uint64_t bytes() const {return sizeof(*this)+128+tokens.capacity()*sizeof(int32_t)+images.capacity()*sizeof(KvmemCanonicalImage);}
+    static bool media_prefix(const std::vector<KvmemCanonicalImage>& a,const std::vector<KvmemCanonicalImage>& b,size_t end) {
+        size_t i=0,j=0;
+        while(i<a.size() && a[i].at<end) {
+            if(a[i].at+a[i].rows>end || j>=b.size() || !(a[i]==b[j]))return false;
+            ++i;++j;
+        }
+        return j>=b.size() || b[j].at>=end;
+    }
+    bool prefix_of(const std::vector<int32_t>& ids,const std::vector<KvmemCanonicalImage>& media) const {
+        return !tokens.empty() && ids.size()>=tokens.size() && std::equal(tokens.begin(),tokens.end(),ids.begin()) && media_prefix(images,media,tokens.size());
+    }
+    bool comparable(const KvmemCanonicalInput& other) const {
+        const auto n=std::min(tokens.size(),other.tokens.size());
+        return n && std::equal(tokens.begin(),tokens.begin()+n,other.tokens.begin()) && media_prefix(images,other.images,n) && media_prefix(other.images,images,n);
+    }
+};
+template<class Reserve>
+std::shared_ptr<const KvmemCanonicalInput> capture_canonical_input(const std::vector<int32_t>& ids,
+        int64_t end,const std::vector<KvmemCanonicalImage>& images,Reserve reserve) {
+    if(end<=0 || uint64_t(end)>ids.size())return {};
+    size_t count=0;
+    for(const auto& image:images)if(image.at<uint64_t(end)) {
+        if(image.at+image.rows>uint64_t(end))return {}; ++count;
+    }
+    try {
+        const auto bytes=sizeof(KvmemCanonicalInput)+128+uint64_t(end)*sizeof(int32_t)+count*sizeof(KvmemCanonicalImage);
+        auto reservation=reserve(bytes); // CPU storage only; preflight before allocations.
+        auto input=std::make_shared<KvmemCanonicalInput>();input->charge=std::move(reservation);
+        input->tokens.assign(ids.begin(),ids.begin()+end);input->images.assign(images.begin(),images.begin()+count);
+        if(input->bytes()>input->charge->remaining())throw std::logic_error("canonical metadata preflight underestimated capacity");
+        return input;
+    } catch(const kvmem::MemoryError& error) {
+        std::fprintf(stderr,"KVMEM_CANONICAL_SKIP reason=optional_storage code=%d error=%s\n",int(error.code()),error.what());
+    } catch(const std::bad_alloc&) {std::fprintf(stderr,"KVMEM_CANONICAL_SKIP reason=allocation\n");}
+    return {}; // No native restore/capture/GPU call is inside this optional boundary.
+}
+// Restore proof is independent of optional canonical fairness metadata.
+// Unknown image proof declines reuse across negative native image tokens.
+struct KvmemMediaInput {
+    std::shared_ptr<kvmem::HostKvReservation> charge; // Release after images.
+    std::vector<KvmemCanonicalImage> images;
+};
+template<class Reserve>
+std::shared_ptr<const KvmemMediaInput> capture_media_input(
+        const std::vector<KvmemCanonicalImage>& images,Reserve reserve) {
+    if(images.empty())return {};
+    try {
+        const auto bytes=sizeof(KvmemMediaInput)+128+images.size()*sizeof(KvmemCanonicalImage);
+        auto charge=reserve(bytes);
+        auto proof=std::make_shared<KvmemMediaInput>();proof->charge=std::move(charge);proof->images=images;
+        if(sizeof(KvmemMediaInput)+128+proof->images.capacity()*sizeof(KvmemCanonicalImage)>proof->charge->remaining())
+            throw std::logic_error("media proof exceeds preflight capacity");
+        return proof;
+    } catch(const kvmem::MemoryError& error) {
+        std::fprintf(stderr,"KVMEM_MEDIA_PROOF_SKIP code=%d error=%s\n",int(error.code()),error.what());
+    } catch(const std::bad_alloc&) {std::fprintf(stderr,"KVMEM_MEDIA_PROOF_SKIP reason=allocation\n");}
+    return {};
+}
+class KvmemHistory {
+    struct Mark {
+        kvmem::CheckpointPurpose purposes = kvmem::CheckpointPurpose::Endpoint;
+        std::shared_ptr<const KvmemCheckpoint> data;
+        kvmem::CheckpointInfo checkpoint_info() const {
+            return {data->identity.stamp.frontier, purposes, data.get(),
+                    data->state_size() + data->mean_tail.size() * sizeof(float) +
+                    data->resident.capacity()*sizeof(uint64_t) + data->graph.bytes() + data->feedback.bytes()};
+        }
+    };
+public:
+    struct Resume {
+        int64_t at = 0;
+        std::shared_ptr<const KvmemCheckpoint> checkpoint;
+    };
+    void clear() { tokens_.clear(); marks_.clear(); session_ = {}; owner.clear(); cache_group=0; input_frontier=0; canonical_.reset(); media_.reset(); canonical_accepted_=false; }
+    // Reclaim oldest unshared images only when that can satisfy the allocation.
+    // Removing a mark held by an in-flight Query would free no RAM and would
+    // unnecessarily discard the next request's prefix restore point.
+    bool reclaim_state(uint64_t bytes, kvmem::CheckpointPurpose purpose = kvmem::CheckpointPurpose::None, bool resident_only = false) {
+        const auto state_owner = [](const Mark& mark) {
+            return mark.data->shared_state ? mark.data->shared_state.get() : mark.data.get();
+        };
+        const auto eligible = [&](const Mark& mark) {
+            if (mark.data.use_count() != 1 || (!state_owner(mark)->state_reservation && !state_owner(mark)->state_record)) return false;
+            // A private fork can become the last owner after its directory root
+            // is retired. Reclaim it only when no published/in-flight reader
+            // still owns that immutable state root.
+            if (mark.data->shared_state && mark.data->shared_state.use_count()!=1) return false;
+            if (purpose == kvmem::CheckpointPurpose::None) return true;
+            // Use the shared retention policy: an optional Endpoint must not
+            // displace the more useful assistant/image reuse anchor.
+            const auto keep = kvmem::retain_checkpoints({mark.checkpoint_info(),
+                {uint64_t(tokens_.size()), purpose, this, 0}}, kvmem::CheckpointLimits{1});
+            return !keep.empty() && keep.front() == 1;
+        };
+        const auto releasable = [&](const Mark& mark) {
+            const auto* root = state_owner(mark);
+            return root->state_record && resident_only ? root->state_record.resident_bytes() : uint64_t(root->state_size());
+        };
+        uint64_t available = 0;
+        for (const auto& mark : marks_)
+            if (eligible(mark))
+                available += releasable(mark);
+        if (available < bytes) return false;
+        kvmem::CheckpointCatalog<Mark> keep{kvmem::CheckpointLimits{3}};
+        for (auto& mark : marks_) {
+            if (bytes && eligible(mark) && releasable(mark)) {
+                bytes -= std::min<uint64_t>(bytes, releasable(mark));
+                mark.data.reset();
+            } else keep.remember(std::move(mark));
+        }
+        marks_.swap(keep);
+        return true;
+    }
+    std::string owner;
+    uint64_t input_frontier=0; // Last native request input boundary, before generated output.
+    uint64_t cache_group=0; // Internal resource fairness only; never restore proof.
+    KvmemHistory fork(const kvmem::MemoryStamp& stamp) const {
+        if (!stamp.valid || stamp.frontier != tokens_.size()) throw std::logic_error("invalid history fork frontier");
+        KvmemHistory result;
+        result.session_ = stamp.session;
+        result.cache_group=cache_group;
+        result.input_frontier=input_frontier;
+        result.canonical_=canonical_;result.canonical_accepted_=canonical_accepted_;result.media_=media_;
+        result.tokens_ = tokens_;
+        for (const auto& mark : marks_) {
+            const auto& old = *mark.data;
+            auto cp = std::make_shared<KvmemCheckpoint>();
+            cp->identity = old.identity;
+            cp->kv = old.kv; cp->kv_versions = old.kv_versions;
+            cp->metadata_reservation = old.metadata_reservation;
+            cp->shared_state = old.shared_state ? old.shared_state : mark.data;
+            cp->mean_tail = old.mean_tail; cp->retrieval = old.retrieval; cp->resident = old.resident;
+            cp->transfers = old.transfers; cp->graph = old.graph; cp->feedback = old.feedback; cp->output_samples = old.output_samples;
+            cp->identity.stamp.session = stamp.session;
+            result.marks_.remember({mark.purposes, std::move(cp)});
+        }
+        return result;
+    }
+    void bind(const kvmem::MemoryStamp& stamp) { session_ = stamp.session; }
+    size_t size() const noexcept { return tokens_.size(); }
+    const std::vector<int32_t>& tokens() const noexcept { return tokens_; }
+    size_t marks() const noexcept { return marks_.size(); }
+    void state_records(std::vector<const KvmemCheckpoint*>& records) const {
+        for (const auto& mark : marks_) {
+            const auto root = mark.data->shared_state ? mark.data->shared_state.get() : mark.data.get();
+            if (root->state_size()) records.push_back(root);
+        }
+    }
+    std::shared_ptr<const KvmemCheckpoint> latest() const { return marks_.empty() ? nullptr : marks_.back().data; }
+    // First byte/token boundary whose image identity is not fully proven.
+    size_t media_prefix_limit(size_t end,const std::vector<KvmemCanonicalImage>& images) const {
+        end=std::min(end,tokens_.size());
+        if(!media_) {
+            const auto first=std::find_if(tokens_.begin(),tokens_.begin()+end,[](int32_t token){return token<0;});
+            end=std::min(end,size_t(first-tokens_.begin()));
+            if(!images.empty())end=std::min<uint64_t>(end,images.front().at);
+            return end;
+        }
+        size_t i=0;
+        while(i<media_->images.size() || i<images.size()) {
+            const auto* a=i<media_->images.size()?&media_->images[i]:nullptr;
+            const auto* b=i<images.size()?&images[i]:nullptr;
+            if((!a || a->at>=end) && (!b || b->at>=end))break;
+            const auto first=std::min(a?a->at:UINT64_MAX,b?b->at:UINT64_MAX);
+            if(!a || !b || !(*a==*b) || !a->rows || a->rows>end-first)return size_t(first);
+            ++i;
+        }
+        return end;
+    }
+    void media_input(std::shared_ptr<const KvmemMediaInput> proof) {media_=std::move(proof);}
+    size_t observed_prefix(const std::vector<int32_t>& ids,const std::vector<KvmemCanonicalImage>& images = {}) const {
+        size_t common = 0;
+        while (common < std::min(ids.size(), tokens_.size()) && ids[common] == tokens_[common]) ++common;
+        return media_prefix_limit(common,images);
+    }
+    // Native candidate classification only: a dropped/re-templated answer
+    // may continue the previous input. Exact native checkpoint proof remains
+    // mandatory; this hint NEVER authorizes old-Query cold-history recall.
+    bool continues_input(const std::vector<int32_t>& ids,const std::vector<KvmemCanonicalImage>& images = {}) const {
+        return input_frontier>0 && !tokens_.empty() &&
+            kvmem::checkpoint_anonymous_continuation(observed_prefix(ids,images),input_frontier,tokens_.size());
+    }
+    void canonical_input(std::shared_ptr<const KvmemCanonicalInput> input) {
+        canonical_=std::move(input);
+        canonical_accepted_=canonical_ && canonical_->prefix_of(tokens_,canonical_->images);
+    }
+    std::shared_ptr<const KvmemCanonicalInput> canonical_input() const {return canonical_accepted_ ? canonical_ : nullptr;}
+    bool continues_group_input(const std::vector<int32_t>& ids,const std::vector<KvmemCanonicalImage>& media) const {
+        const auto input=canonical_input();return input && input->prefix_of(ids,media);
+    }
+    // Only an append to the complete, still-live native prefix can bypass a
+    // repeated Query. A matching old prompt alone also admits edited answers,
+    // which can restore a checkpoint from before that Query was evaluated.
+    bool extends_live_prefix(const std::vector<int32_t>& ids, const kvmem::MemoryStamp& stamp,
+                             size_t completed_prompt,const std::vector<KvmemCanonicalImage>& images = {}) const {
+        return completed_prompt > 0 && tokens_.size() >= completed_prompt && ids.size() > tokens_.size()
+            && stamp.valid && stamp.session == session_ && stamp.frontier == tokens_.size()
+            && observed_prefix(ids,images) == tokens_.size();
+    }
+    void append(const int32_t* ids, size_t count) {
+        tokens_.insert(tokens_.end(), ids, ids + count);
+        if(!canonical_accepted_ && canonical_)canonical_accepted_=canonical_->prefix_of(tokens_,canonical_->images);
+    }
+    void truncate(int64_t at) {
+        if (at < 0 || uint64_t(at) > tokens_.size()) throw std::logic_error("KVMem history truncation exceeds its prefix");
+        tokens_.resize(size_t(at));
+        marks_.truncate(uint64_t(at));
+    }
+    Resume choose(const std::vector<int32_t>& ids, int64_t query_begin, const kvmem::MemoryStamp& stamp,const std::vector<KvmemCanonicalImage>& images = {}, bool checkpoint_only = false) const {
+        if (!stamp.valid || !(stamp.session == session_) || stamp.frontier != tokens_.size() || ids.empty()) return {};
+        const auto common = observed_prefix(ids,images);
+        // Query Q must be recaptured, even for an identical request or an
+        // explicitly enlarged query span. Always leave the last token for logits.
+        const int64_t limit = std::min<int64_t>(query_begin,
+            kvmem::prefix_restore_limit(common, tokens_.size(), ids.size(), true));
+        if (!checkpoint_only && limit > 0 && common == tokens_.size() && int64_t(common) <= limit)
+            return {int64_t(common), nullptr};
+        if (limit < 0) return {};
+        const auto best = marks_.select(uint64_t(limit), [&](const auto& mark) {
+            const auto& saved = mark.data->identity.stamp;
+            return saved.valid && saved.session == session_ && media_prefix_limit(size_t(saved.frontier),images)==saved.frontier;
+        });
+        return best ? Resume{int64_t(best->data->identity.stamp.frontier), best->data} : Resume{};
+    }
+    void remember(std::shared_ptr<const KvmemCheckpoint> cp,
+                  kvmem::CheckpointPurpose purpose = kvmem::CheckpointPurpose::Endpoint) {
+        const auto& saved = cp->identity.stamp;
+        if (!saved.valid || !(saved.session == session_) || saved.frontier != tokens_.size())
+            throw std::logic_error("KVMem history mark is not its evaluated prefix");
+        if (!saved.frontier) return;
+        marks_.remember({purpose, std::move(cp)});
+    }
+private:
+    kvmem::SessionIdentity session_{};
+    std::vector<int32_t> tokens_;
+    std::shared_ptr<const KvmemCanonicalInput> canonical_;
+    std::shared_ptr<const KvmemMediaInput> media_;
+    bool canonical_accepted_=false; // Historical accepted input, independent of a later checkpoint rewind.
+    kvmem::CheckpointCatalog<Mark> marks_{kvmem::CheckpointLimits{3}};
+};
+} // namespace strata::poly
