+    uint64_t publication_group(const Entry& incoming) {
+        const auto fresh=[&]{if(next_group_==UINT64_MAX)throw std::overflow_error("cache group identity exhausted");return next_group_++;};
+        const auto input=incoming.history.canonical_input();if(!input)return fresh();
