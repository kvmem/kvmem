+        }
+        e.trim_kv(64);report("first_short_request");
+        e.trim_kv(64);report("second_short_request");
+        for(int i=0;i<512;++i)e.elastic_tick();verify(e);report("refilled");
+    }
+    static void workspace(Engine& e, bool full) { e.elastic_workspace(full); }
+    static void freeze(Engine& e, bool frozen) { e.freeze_experts_ = frozen; }
