+namespace strata::poly {
+struct KvmemTestAccess {
+    static std::vector<uint8_t> kv(KvmemMemory& m) {
+        std::vector<uint8_t> result(m.visible_ * (m.descriptor_.layout.record_bytes / m.block_tokens));
+        m.save_view(result.data());
+        return result;
+    }
+    static std::vector<float> means(KvmemMemory& m) {
+        std::vector<float> result(m.versions_.size() * m.planes_.size() * m.key_width_);
+        for (uint32_t b=0; b<m.versions_.size(); ++b)
+            for (uint32_t il=0; il<m.planes_.size(); ++il)
+                m.statistics_->mean_k(b, il, result.data() + (b*m.planes_.size()+il)*m.key_width_);
+        return result;
+    }
+};
+struct ElasticTestAccess {
+    static void headroom_test(Engine& e) {
+        const int32_t token=1000;std::vector<int32_t> prompt(128,token);
+        e.eval(prompt.data(),128,false);
+        for(int i=0;i<512;++i)e.eval(&token,1,true);
+        check(!e.elastic_headroom_blocked_,"headroom telemetry unavailable or unexpectedly blocked");
+        check(e.elastic_extra_>0,"no relaxed cache growth exercised");
+        e.elastic_info();
+        const auto backoffs=e.elastic_oom_backoffs_;
+        for(int i=0;i<512;++i)e.elastic_tick();
+        check(e.elastic_oom_backoffs_==backoffs,"learned allocation ceiling was retried");
+        const auto cp=e.memory().checkpoint();const auto kv=KvmemTestAccess::kv(e.memory());
+        const auto means=KvmemTestAccess::means(e.memory());
+        const auto intact=[&]{verify(e);check(e.memory().checkpoint().state==cp.state,"budget transition changed state");
+            check(KvmemTestAccess::kv(e.memory())==kv,"budget transition changed KV");
+            check(KvmemTestAccess::means(e.memory())==means,"budget transition changed statistics");};
+        const size_t expanded=e.arena_.mapped;
+        e.elastic_workspace(true);intact();
+        check(e.vram_free_mib()>=256,"prefill did not repay borrowed budget");
+        check(e.arena_.mapped<expanded,"prefill did not reclaim experts");
+        e.elastic_workspace(false);for(int i=0;i<512;++i)e.elastic_tick();
+        e.cover(e.cache_capacity());intact();
+        check(e.vram_free_mib()>=256,"KV expansion did not repay borrowed budget");
+        e.trim_kv(e.memory().visible_tokens());
+        for(int fault:{4,3,1,2}) {
+            e.elastic_budget_fault_=0;e.elastic_headroom_blocked_=false;
+            for(int i=0;i<512;++i)e.elastic_tick();
+            if(fault==3){e.shrink_cache(256ULL<<20);e.held_is_budget();}
+            const size_t before=e.arena_.mapped;
+            const auto prior_backoffs=e.elastic_oom_backoffs_;
+            const auto prior_limit=e.elastic_headroom_limit_mib_;
+            e.elastic_budget_fault_=fault;e.elastic_ticks_=256;e.elastic_tick();
+            if(fault==4)check(e.arena_.mapped<before,"physical pressure did not reclaim experts");
+            else if(fault==3) {
+                check(e.elastic_oom_backoffs_==prior_backoffs+1,"allocation fault did not record one backoff");
+                check(e.arena_.mapped<before,"allocation failure did not reclaim experts");
+                if(e.elastic_headroom_blocked_)
+                    check(e.vram_free_mib()>=256,"disabled borrowing failed to restore conservative budget");
+                else {
+                    check(e.elastic_headroom_limit_mib_>=0 && e.elastic_headroom_limit_mib_<prior_limit,
+                          "allocation failure did not lower the borrowing ceiling");
+                    const auto learned=e.elastic_headroom_limit_mib_;
+                    e.elastic_budget_fault_=0;
+                    for(int i=0;i<512;++i)e.elastic_tick();
+                    check(e.elastic_oom_backoffs_==prior_backoffs+1 && e.elastic_headroom_limit_mib_==learned,
+                          "injected failed allocation ceiling was retried");
+                    check(e.arena_.mapped<before,"decode regrew the failed allocation extent");
+                }
+                std::cout<<"PASS allocation_fault_backoff blocked="<<e.elastic_headroom_blocked_
+                         <<" learned_mib="<<e.elastic_headroom_limit_mib_<<'\n';
+            }
+            else check(e.elastic_headroom_blocked_ && e.vram_free_mib()>=256,"fault failed to restore conservative budget");
+            intact();
+        }
+        e.elastic_budget_fault_=0;e.eval(prompt.data(),128,false);e.eval(&token,1,true);verify(e);
+        std::cout<<"PASS headroom_growth prefill_repayment KV_repayment physical_pressure allocation_failure telemetry_loss shared_growth accepted_state\n";
+    }
+    static void reclaim_test(Engine& e) {
+        std::vector<int32_t> prompt(128,1000);
+        for(int i=0;i<36;++i)e.eval(prompt.data(),128,false);
+        const auto cp=e.memory().checkpoint();
+        const auto kv=KvmemTestAccess::kv(e.memory());
+        const auto means=KvmemTestAccess::means(e.memory());
