+#include "kvmem_sessions.hpp"
+#include "engine.hpp"
+#include <cstdio>
+#include <cstdlib>
+#include <set>
+
+namespace strata::poly {
+void KvmemSessions::complete(KvmemMemory& memory,KvmemHistory& history) {
+    // The legacy serial path saves at prompt-1. Only materialize another
+    // optional point when accepted output/input has newly crossed the gate.
+    if(!minimum_tokens_)return;
+    const auto stamp=memory.stamp();
+    if(!stamp.valid || !admit_history(std::min<uint64_t>(stamp.frontier,history.size())))return;
+    const auto prior=history.latest();
+    if(prior && prior->identity.stamp.frontier>=minimum_tokens_)return;
+    if(auto cp=checkpoint(memory,history,stamp.frontier,false))history.remember(std::move(cp));
+}
+bool KvmemSessions::make_state_room(const KvmemMemory& memory, KvmemHistory& history, uint64_t total_tokens,
+                                   kvmem::CheckpointPurpose purpose) {
+    if (!memory.checkpoint_charge()) return true;
+    memory.admit(total_tokens);
+    const auto required = memory.request_payload(total_tokens);
+    const auto own = memory.active_host_bytes();
+    const auto extra = required > own ? required - own : memory.checkpoint_charge();
+    const auto fits = [&] { return extra <= memory.payload_limit() &&
+        memory.payload_bytes() <= memory.payload_limit() - extra; };
+    if(!fits() && std::getenv("KVMEM_POLY_SESSION_METRICS"))
+        std::fprintf(stderr,"KVMEM_CONTENT_PRESSURE stage=checkpoint used=%llu reserve=%llu limit=%llu idle_records=%zu\n",
+            (unsigned long long)memory.payload_bytes(),(unsigned long long)extra,(unsigned long long)memory.payload_limit(),entries_.size());
+    while (!fits() && evict_one()) {}
+    if (!fits() && extra <= memory.payload_limit())
+        history.reclaim_state(memory.payload_bytes() - (memory.payload_limit() - extra), purpose);
+    return fits();
+}
+std::shared_ptr<KvmemCheckpoint> KvmemSessions::checkpoint(KvmemMemory& memory, KvmemHistory& history,
+                                                          uint64_t total_tokens, bool required, kvmem::CheckpointPurpose purpose) {
+    // Intermediate input/replay points remain available if later accepted
+    // output crosses the threshold. Gate the whole completed history instead.
+    if (!memory.checkpoint_charge()) return std::make_shared<KvmemCheckpoint>(memory.checkpoint());
+    const auto exhausted = [] { return kvmem::MemoryError(kvmem::MemoryErrorCode::BudgetExceeded,
+        "KVMem required checkpoint exceeds remaining Host state capacity"); };
+    if (required) purpose = kvmem::CheckpointPurpose::None;
+    if (make_state_room(memory, history, total_tokens, purpose)) {
+        // With SSD enabled, aggregate space alone does not guarantee RAM for
+        // the next capture and its exchange margin. Retry after reclaiming optional marks.
+        for (int attempt = 0; attempt != 2; ++attempt) {
+            try { return std::make_shared<KvmemCheckpoint>(memory.checkpoint()); }
+            catch (const kvmem::MemoryError& error) {
+                if (error.code() != kvmem::MemoryErrorCode::BudgetExceeded) throw;
+                if (attempt) break;
+                if(std::getenv("KVMEM_POLY_SESSION_METRICS"))
+                    std::fprintf(stderr,"KVMEM_CONTENT_PRESSURE stage=checkpoint_ram used=%llu state_bytes=%llu limit=%llu idle_records=%zu\n",
+                        (unsigned long long)memory.host_bytes(),(unsigned long long)memory.checkpoint_charge(),(unsigned long long)memory.host_limit(),entries_.size());
+                while (evict_one()) {}
+                const auto free = memory.host_limit() - memory.host_bytes();
+                if (free < memory.checkpoint_ram_required()) history.reclaim_state(memory.checkpoint_ram_required() - free, purpose, true);
+            }
+        }
+    }
+    if (required) throw exhausted();
+    std::fprintf(stderr, "KVMEM_CHECKPOINT optional capture skipped: Host state capacity\n");
+    return {};
+}
+bool KvmemSessions::make_archive_room(const KvmemMemory& memory) {
+    const auto needed = memory.archive_pending_bytes();
+    if (needed > memory.host_limit()) return false;
+    while (needed > memory.payload_limit()-memory.payload_bytes())
+        if (!evict_one()) return false;
+    return true;
+}
+void KvmemSessions::admit_active(const KvmemMemory& memory, uint64_t total_tokens) {
+    memory.admit(total_tokens); // rejects impossible requests before eviction
+    const auto records = (total_tokens+memory.block_tokens-1)/memory.block_tokens+1;
+    const auto required = records*memory.descriptor().layout.record_bytes;
+    const auto own = memory.active_host_bytes();
+    const auto extra = required > own ? required-own : 0;
+    while (memory.payload_bytes() > memory.payload_limit()-extra)
+        if (!evict_one()) throw std::logic_error("KVMem active admission did not fit after clearing idle histories");
+}
+int64_t KvmemSessions::resume(Engine& engine, KvmemHistory& current, const std::vector<int32_t>& ids,
+                              int64_t query_begin, uint64_t total_tokens, const std::string& owner, bool shared,
+                              const std::vector<KvmemCanonicalImage>& images) {
+    auto& memory = engine.memory();
+    last_reuse = {};
+    configure(engine.memory_options().sessions-1,engine.memory_options().cache_min_tokens);
+    memory.admit(total_tokens);
+    auto live = current.choose(ids, query_begin, memory.stamp(),images);
+    const bool live_continuation=current.size()>0 && ids.size()>current.size() && current.observed_prefix(ids,images)==current.size();
+    if (!live.checkpoint && live.at > 0 && !live_continuation) {
+        live = current.choose(ids, query_begin, memory.stamp(),images,true);
+    }
+    const bool live_owner=live_continuation;
+    const auto idle = choose(ids, query_begin, owner, shared,images);
+    const bool selected_live = prefer_live(live, live_owner || current.continues_input(ids,images), idle, shared);
+    if (live_owner && selected_live) {
+        last_reuse.planned = live.at;
+        admit_active(memory, total_tokens);
+        if (!live.checkpoint || make_archive_room(memory)) {
+            if (live.checkpoint) memory.restore_prefix(*live.checkpoint);
+            current.truncate(live.at);
+            last_reuse.actual = live.at; last_reuse.source = "own";
+            return live.at;
+        }
+        ++skipped_;
+    }
+    // A selected source is held outside the LRU until the branch is published.
+    const bool from_live = !live_owner && selected_live;
+    last_reuse.planned = from_live ? live.at : idle.resume.at;
+    auto source = !from_live && idle.slot != SIZE_MAX ? lease(idle.slot) : nullptr;
+    uint64_t source_group=source ? published_group(source) : 0;
+    try {
+        const auto cp = current.latest();
+        // A live fork may need a temporary source even below the retention
+        // threshold. save() independently declines its directory publication.
+        if (cp && memory.stamp().valid && cp->identity.stamp.session == memory.stamp().session &&
+            (from_live || admit_history(cp->identity.stamp.frontier)) && make_archive_room(memory)) {
+            auto leaving = std::make_unique<Entry>();
+            leaving->memory = memory.park(*cp);
+            current.truncate(int64_t(cp->identity.stamp.frontier));
+            leaving->history = std::move(current);
+            if (from_live) {source=std::shared_ptr<const Entry>(std::move(leaving));save(source);source_group=published_group(source);}
+            else save(std::move(leaving));
+        } else {
+            if (cp) ++skipped_;
+            current.clear(); engine.reset();
+        }
+        if (source) {
+            const auto at = from_live ? live.at : idle.resume.at;
+            const bool branch = true; // Every immutable snapshot restore preserves its source.
+            if (branch) {
+                auto forked = memory.fork(source->memory);
+                auto history = source->history.fork(forked.identity.stamp);
+                const bool continuation=source->history.continues_group_input(ids,images);
+                history.cache_group=continuation ? source_group : 0; // Reclassified against every ready group at publication.
+                auto checkpoint = history.choose(ids, query_begin, forked.identity.stamp,images,true);
+                if (!checkpoint.checkpoint || checkpoint.at != at ||
+                    checkpoint.checkpoint->identity.stamp.frontier != uint64_t(at))
+                    throw std::logic_error("KVMem fork lost its native checkpoint");
+                memory.enter(std::move(forked), *checkpoint.checkpoint);
+                current = std::move(history);
+                save(source);
+                ++forks_;
+            }
+            current.truncate(at); current.owner = owner;
+            admit_active(memory, total_tokens);
+            ++restores_;
+            last_reuse.actual = at; last_reuse.source = branch ? "shared" : "own";
+            std::fprintf(stderr,"KVMEM_HISTORY source=%s restored_tokens=%lld forks=%llu physical_bytes=%llu logical_idle_bytes=%llu\n",
+                branch?"shared":"own", (long long)at, (unsigned long long)forks_,
+                (unsigned long long)memory.payload_bytes(), (unsigned long long)payload_bytes());
+            return at;
+        }
+    } catch (...) {
+        if (source && source->memory.statistics) save(source);
+        throw;
+    }
+    engine.reset(); current.clear(); current.bind(memory.stamp()); current.owner = owner;
+    admit_active(memory, total_tokens);
+    return 0;
+}
+void KvmemSessions::metrics(const KvmemMemory& memory, const KvmemHistory* active,
+                          const std::vector<const KvmemHistory*>& others, uint64_t logical_active) const {
+    if (!std::getenv("KVMEM_POLY_SESSION_METRICS")) return;
+    std::fprintf(stderr,"KVMEM_CACHE_ADMISSION cache_min_tokens=%u cache_candidate_tokens=%llu cache_below_minimum=%llu history_retention_evictions=%llu history_capacity_evictions=%llu\n",
+        minimum_tokens_,(unsigned long long)candidate_tokens_,(unsigned long long)below_minimum_,
+        (unsigned long long)retention_evictions_,(unsigned long long)(evictions_-retention_evictions_));
+    std::fprintf(stderr, "KVMEM_SESSIONS parked=%zu parked_groups=%zu evictions=%zu restores=%zu skipped=%zu host_bytes=%llu host_limit=%llu session=%llu incarnation=%llu\n",
+        parked(), groups(), evictions(), restores(), skipped(), (unsigned long long)memory.host_bytes(),
+        (unsigned long long)memory.host_limit(), (unsigned long long)memory.stamp().session.id,
+        (unsigned long long)memory.stamp().session.incarnation);
+    std::vector<const KvmemCheckpoint*> states;
+    for (const auto& entry : entries_) entry.value->history.state_records(states);
+    if (active) active->state_records(states);
+    for(const auto* history:others)if(history)history->state_records(states);
+    std::set<const void*> unique;
+    uint64_t logical_state=0, physical_state=0, resident_state=0;
+    for (const auto& state : states) {
+        logical_state += state->state_size();
+        if (unique.insert(state).second) {
+            physical_state += state->state_size();
+            resident_state += state->state_record ? state->state_record.resident_bytes() : state->state.size();
+        }
+    }
+    std::fprintf(stderr,"KVMEM_SHARED scope_version=2 logical_state_bytes=%llu physical_state_bytes=%llu state_sharing_credit_bytes=%llu state_references=%zu state_resident_bytes=%llu state_cold_bytes=%llu\n",
+        (unsigned long long)logical_state,(unsigned long long)physical_state,
+        (unsigned long long)(logical_state-physical_state),states.size(),
+        (unsigned long long)resident_state,(unsigned long long)(physical_state-resident_state));
+    const auto logical = payload_bytes()+(logical_active==UINT64_MAX ? memory.active_host_bytes() : logical_active), physical = memory.payload_bytes();
+    std::fprintf(stderr,"KVMEM_SHARED logical_payload_bytes=%llu physical_payload_bytes=%llu sharing_credit_bytes=%llu shared_forks=%llu\n",
+        (unsigned long long)logical, (unsigned long long)physical,
+        (unsigned long long)(logical>physical?logical-physical:0), (unsigned long long)forks_);
+}
+} // namespace strata::poly
