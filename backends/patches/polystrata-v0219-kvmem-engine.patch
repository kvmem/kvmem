+void KvmemOptions::normalize(int & batch) {
+    require(block_tokens == 32 || block_tokens == 64, "KVMem block tokens must be 32 or 64");
+    if (!budget) return;
+    require(batch > 0, "Prefill must be positive");
+    kvmem::normalize_memory_tokens(budget, reserve, sink, recent, block_tokens, false, true);
+    batch = int(kvmem::normalize_prefill(uint32_t(batch), reserve, 1));
