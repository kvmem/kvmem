+// Idle histories share KvmemMemory's RAM account. Only resume() knows Engine;
+// prefix choice, slot limits, ownership and LRU eviction are model-free.
+#pragma once
+#include "kvmem_history.hpp"
+#include "kvmem/content_cache.hpp"
+#include <limits>
+#include <map>
+
+namespace strata::poly {
+class KvmemSessions {
+public:
+    struct Entry {
+        KvmemHistory history;
+        KvmemParked memory;
+        uint64_t used = 0;
+    };
+    struct Choice {
+        size_t slot = SIZE_MAX;
+        KvmemHistory::Resume resume;
+        bool fork = false;
+    };
+    struct ReuseObservation {
+        int64_t planned = 0, actual = 0;
+        const char* source = "miss";
+    };
+    static bool prefer_live(const KvmemHistory::Resume& live, bool continuation,
+                            const Choice& idle, bool new_user_query) {
+        return live.at>0 && (new_user_query || continuation) && live.at>=idle.resume.at;
+    }
+    ReuseObservation last_reuse;
+    void configure(size_t idle_slots, uint32_t minimum_tokens = 0) {
