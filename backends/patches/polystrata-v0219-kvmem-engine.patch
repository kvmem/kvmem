@@ -0,0 +1,109 @@
+#include "../src/poly/kvmem_history.hpp"
+#include <iostream>
+#include <numeric>
+#include <stdexcept>
+
+using namespace strata::poly;
+void check(bool value, const char* message) { if (!value) throw std::runtime_error(message); }
+std::shared_ptr<KvmemCheckpoint> mark(kvmem::MemoryStamp stamp, uint64_t frontier) {
+    auto cp = std::make_shared<KvmemCheckpoint>();
+    cp->identity.stamp = stamp;
+    cp->identity.stamp.frontier = frontier;
+    return cp;
+}
+int main() {
+    try {
+        KvmemHistory history;
+        kvmem::MemoryStamp stamp{true, {77, 1}, 1, 0, 0, 1};
+        history.bind(stamp);
+        std::vector<int32_t> ids(512);
+        std::iota(ids.begin(), ids.end(), 100);
+        history.append(ids.data(), 256);
+        history.remember(mark(stamp, 256));
+        history.append(ids.data()+256, 255);
+        history.remember(mark(stamp, 511));
+        history.append(ids.data()+511, 1);
+        stamp.frontier = 512;
+        auto next = ids;
+        next.push_back(999);
+        auto live = history.choose(next, 512, stamp);
+        check(live.at == 512 && !live.checkpoint, "evaluated live prefix was not reused");
+        check(history.extends_live_prefix(next, stamp, 350), "thinking wrap lost the complete live prefix");
+        check(!history.extends_live_prefix(ids, stamp, 350), "identical prompt bypassed Query recapture");
+        auto edited_answer = next;
+        edited_answer[400] = 42;
+        // The old follow-up predicate matched the 350-token original prompt,
+        // then choose() restored frontier 256, before Query [300,350).
+        check(history.observed_prefix(edited_answer) >= 350 &&
+              history.choose(edited_answer, int64_t(edited_answer.size()), stamp).at == 256,
+              "edited-answer regression fixture no longer restores the pre-Query checkpoint");
+        check(!history.extends_live_prefix(edited_answer, stamp, 350),
+              "edited answer skipped Query after restoring a pre-Query checkpoint");
+        auto shortened = ids; shortened.resize(450);
+        check(!history.extends_live_prefix(shortened, stamp, 350), "shortened answer reused the live suffix");
+        check(!history.extends_live_prefix(next, stamp, 513), "incomplete prompt was eligible for continuation");
+        check(!history.extends_live_prefix(next, stamp, 0), "request without a completed Query was eligible");
+        auto stale_frontier = stamp; --stale_frontier.frontier;
+        check(!history.extends_live_prefix(next, stale_frontier, 350), "stale native frontier was reused");
+        check(history.choose(ids, 512, stamp).at == 511, "last token's logits must be recomputed");
+        check(history.choose(ids, 300, stamp).at == 256, "query capture was skipped by reuse");
+        check(history.choose(ids, 0, stamp).at == 0, "whole-input query must be recaptured");
+        auto fork = ids;
+        fork[100] = 999;
+        check(history.choose(fork, 300, stamp).at == 0, "changed document used a stale mark");
+        fork = ids;
+        fork[400] = 999;
+        check(history.choose(fork, 450, stamp).at == 256, "fork did not choose a safe earlier mark");
+        auto invalid = stamp;
+        invalid.valid = false;
+        check(!history.extends_live_prefix(next, invalid, 350), "invalid continuation state was reused");
+        check(history.choose(next, 512, invalid).at == 0, "invalid native state was reused");
+        invalid = stamp;
+        ++invalid.session.incarnation;
+        check(!history.extends_live_prefix(next, invalid, 350), "continuation crossed a session incarnation");
+        check(history.choose(next, 512, invalid).at == 0, "different incarnation was reused");
+        history.truncate(256);
+        check(history.marks() == 1, "fork retained a suffix checkpoint");
+        fork[300] = 999;
+        history.append(fork.data()+256, 144);
+        stamp.frontier = 400;
+        check(history.choose(ids, 512, stamp).at == 256, "discarded suffix mark became reusable");
+        history.remember(mark(stamp, 400));
+        history.append(ids.data()+400, 50);
+        history.remember(mark(stamp, 450));
+        check(history.marks() == 3, "checkpoint count was not bounded");
+        history.truncate(256);
+        history.remember(mark(stamp, 256), kvmem::CheckpointPurpose::ReuseAnchor);
+        for (uint64_t end = 257; end <= 264; ++end) {
+            history.append(ids.data() + end - 1, 1);
+            history.remember(mark(stamp, end));
+        }
+        stamp.frontier = history.size();
+        auto changed = ids;
+        changed[256] = 42;
+        check(history.choose(changed, 400, stamp).at == 256,
+              "endpoint churn evicted the stable prefix anchor");
+        bool refused = false;
+        try { history.remember(mark(stamp, 263)); } catch (const std::logic_error&) { refused = true; }
+        check(refused, "incomplete checkpoint was admitted");
+        {
+            kvmem::HostKvStorage quota(64);
+            KvmemHistory parent;
+            kvmem::MemoryStamp at{true,{900,1},1,1,32,1};
+            parent.bind(at);std::vector<int32_t> ids(32,7);parent.append(ids.data(),ids.size());
+            auto cp=mark(at,32);cp->state_reservation=std::make_shared<kvmem::HostKvReservation>(quota.reserve(16));
+            cp->state.assign(16,7);parent.remember(cp);cp.reset();
+            auto fork_stamp=at;fork_stamp.session={901,1};auto child=parent.fork(fork_stamp);
+            check(!child.reclaim_state(16),"reclamation consumed a published parent's state");
+            parent.clear();
+            check(child.reclaim_state(16),"private fork state could not be reclaimed after parent eviction");
+            check(quota.charged_bytes()==0,"private fork state reservation leaked");
+        }
+        history.clear();
+        check(history.size() == 0 && history.marks() == 0, "failed request retained history");
+        std::cout << "KVMem history planner PASS\n";
+    } catch (const std::exception& e) {
+        std::cerr << e.what() << '\n';
+        return 1;
+    }
+}
