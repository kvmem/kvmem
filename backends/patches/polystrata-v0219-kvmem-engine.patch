+
+void Engine::elastic_admit(size_t need) {
+    if (!elastic_enabled_ || !opt_.elastic_experts_headroom) return;
+    const size_t guard=size_t(std::max(reserve_mib_,256))<<20;
+    // CUDA free saturates at zero above WDDM's budget. Repay the signed DXGI debt too.
+    // If telemetry disappears, repay every byte grown under the relaxed policy before retrying.
+    for(int attempt=0;attempt<4;++attempt){
+        size_t free_b=0,total_b=0;ck(cudaMemGetInfo(&free_b,&total_b),"elastic admission budget");
+        const auto b=windows_vram(device_);
+        const size_t debt=b.valid?size_t(std::max<int64_t>(0,b.local-b.budget)):elastic_extra_;
+        if(free_b>=need+guard && debt==0){elastic_extra_=0;held_is_budget();return;}
+        const size_t cut=need+guard+debt>free_b?need+guard+debt-free_b:0;
+        if(!cut)break;
+        const size_t before=arena_.mapped;shrink_cache(cut);held_is_budget();
+        if(arena_.mapped==before)break;
+        if(!b.valid)elastic_extra_=0;
+    }
+    size_t free_b=0,total_b=0;ck(cudaMemGetInfo(&free_b,&total_b),"elastic admission result");
+    if(free_b<need+guard)throw std::runtime_error("insufficient VRAM after elastic headroom repayment");
+    elastic_extra_=0;
+}
