+    static void fail_after(Engine& e, int count) { e.elastic_fail_after_ = count; }
+    static size_t mapped(Engine& e) {
+        size_t total=0; for(const auto& w:e.elastic_workspaces_)total+=w.mapped; return total;
+    }
+    static void verify(Engine& e) {
+        check(e.elastic_enabled_, "elastic feature did not activate");
+        check(!e.elastic_workspaces_.empty(), "no elastic workspace");
+        size_t cache=0; for(const auto& p:e.arena_.pieces)cache+=p.second;
+        check(cache==e.arena_.mapped, "cache allocation ledger mismatch");
+        int count=0;
+        for(const auto& layer:e.layers_)for(const auto* slot:layer.slot)if(slot) {
+            ++count;
+            check(slot>=e.exp_ && size_t(slot-e.exp_)+layer.slot_bytes<=e.arena_.mapped,
+                  "expert references unmapped cache pages");
+        }
+        check(count==e.cached_, "published expert count mismatch");
+        for(const auto& w:e.elastic_workspaces_) {
+            size_t physical=0;for(const auto& p:w.pieces)physical+=p.second;
+            check(physical==w.mapped,"workspace allocation ledger mismatch");
+            check(w.mapped==(e.elastic_full_?w.full:w.keep), "workspace lease incomplete");
+        }
+    }
+};
+}
+
+int main(int argc, char** argv) {
+    try {
+        check(argc>=2,"usage: poly_elastic_test MODEL [--no-graphs]");
+        Options o;
+        o.model=argv[1];o.max_context=4096;o.prompt_batch=128;o.window=1;o.draft=false;
+        o.elastic_experts=true;o.vram_reserve_mib=256;o.expert_swaps=0;
+        o.memory.budget=512;o.memory.reserve=128;o.memory.host_mib=1024;
+        o.memory.sink=64;o.memory.recent=64;o.memory.verify=true;
+        o.kv_format=KvFmt::kQ8_0;
+        o.graphs=!(argc>2 && std::string(argv[2])=="--no-graphs");
+        const bool audit=argc>2 && std::string(argv[2])=="--memory-audit";
+        const bool reclaim=argc>2 && std::string(argv[2])=="--kv-reclaim-test";
+        const bool aggressive=argc>2 && std::string(argv[2])=="--aggressive-test";
+        const bool headroom=aggressive || (argc>2 && std::string(argv[2])=="--headroom-test");
+        if(aggressive){o.elastic_headroom_mib=512;o.elastic_physical_reserve_mib=256;}
+        if(audit||reclaim||headroom){o.max_context=262144;o.prompt_batch=512;o.memory.budget=32768;o.memory.reserve=2048;}
+        o.elastic_experts_headroom=headroom;
+        for(int i=2;i+1<argc;++i)if(std::string(argv[i])=="--block-tokens")o.memory.block_tokens=std::stoul(argv[++i]);
+        auto e=Engine::open(o);
+        ElasticTestAccess::verify(*e);
+        if(audit){ElasticTestAccess::audit(*e);return 0;}
+        if(reclaim){ElasticTestAccess::reclaim_test(*e);return 0;}
+        if(headroom){ElasticTestAccess::headroom_test(*e);return 0;}
+        std::vector<int32_t> prompt(128);for(size_t i=0;i<prompt.size();++i)prompt[i]=100+int(i%32);
+        e->eval(prompt.data(),64,false);
+        const auto cp=e->memory().checkpoint();
+        const auto kv=KvmemTestAccess::kv(e->memory());
+        const auto means=KvmemTestAccess::means(e->memory());
+        const size_t full=ElasticTestAccess::mapped(*e);
+        for(int cycle=0;cycle<16;++cycle) {
+            ElasticTestAccess::workspace(*e,false);
+            check(ElasticTestAccess::mapped(*e)<full,"decode released no workspace");
+            ElasticTestAccess::verify(*e);
+            ElasticTestAccess::workspace(*e,true);
+            ElasticTestAccess::verify(*e);
+        }
+        check(e->memory().checkpoint().state==cp.state,"workspace cycling changed recurrent state");
+        check(KvmemTestAccess::kv(e->memory())==kv,"workspace cycling changed native KV");
+        check(KvmemTestAccess::means(e->memory())==means,"workspace cycling changed persistent statistics");
+        std::cout<<"PASS 16_workspace_cycles native_KV recurrent_state statistics byte_identical\n";
+
+        // Independent oracle for workspace lifetime: same live engine/cache and accepted checkpoint,
+        // full mappings versus narrow mappings. Hold expert placement still only for this comparison.
+        const int32_t token=1000;
+        ElasticTestAccess::freeze(*e,true);
+        ElasticTestAccess::enabled(*e,false);
+        e->eval(&token,1,true);
+        std::vector<float> logits(e->logits(),e->logits()+e->n_vocab());
+        const auto expected=e->memory().checkpoint();
+        const auto expected_kv=KvmemTestAccess::kv(e->memory());
+        e->memory().restore_prefix(cp);
+        ElasticTestAccess::enabled(*e,true);
+        e->eval(&token,1,true);
+        check(std::memcmp(logits.data(),e->logits(),logits.size()*sizeof(float))==0,"narrow workspace changed logits");
+        check(e->memory().checkpoint().state==expected.state,"narrow workspace changed accepted state");
+        check(KvmemTestAccess::kv(e->memory())==expected_kv,"narrow workspace changed accepted native KV");
+        ElasticTestAccess::freeze(*e,false);
+        std::cout<<"PASS full_vs_narrow logits accepted_state native_KV byte_identical graphs="<<o.graphs<<'\n';
+
+        const auto before_failure=e->memory().checkpoint();
+        ElasticTestAccess::fail_after(*e,1);
+        bool failed=false;
+        try { ElasticTestAccess::workspace(*e,true); }
+        catch(const std::exception& error) { failed=std::string(error.what()).find("injected")!=std::string::npos; }
+        check(failed,"partial admission failure did not fire");
+        ElasticTestAccess::verify(*e);
+        check(e->memory().checkpoint().state==before_failure.state,"failed admission changed accepted state");
+        ElasticTestAccess::fail_after(*e,-1);
+        ElasticTestAccess::workspace(*e,true);
+        ElasticTestAccess::verify(*e);
+        std::cout<<"PASS partial_admission_rollback_and_retry\n";
+
+        // Real cache growth and reclaim, then Pressure and bounded Query/replay through ordinary eval.
+        for(int cycle=0;cycle<6;++cycle) {
+            e->eval(prompt.data(),128,false);
+            for(int i=0;i<64;++i)e->eval(&token,1,true);
+            ElasticTestAccess::verify(*e);
+            check(e->memory().stamp().frontier==uint64_t(e->pos()),"accepted frontier drifted");
+            check(e->memory().visible_tokens()<=o.memory.budget+o.memory.reserve,"physical KV budget exceeded");
+        }
+        const auto first=e->pos();
+        e->memory().begin_query(first,first+16);
+        const auto query_cp=e->memory().checkpoint();
+        e->eval(prompt.data(),16,false);
+        const bool replay=e->memory().freeze_and_rewind(query_cp,first+16);
+        check(replay,"sparse query did not exercise replay");
+        e->eval(prompt.data(),16,false);
+        e->memory().finish_query();
+        check(e->memory().stamp().frontier==uint64_t(first+16),"replay changed accepted frontier");
+        e->eval(&token,1,true);
+        ElasticTestAccess::verify(*e);
+        std::cout<<"PASS cache_growth_reclaim Pressure Query_replay\n";
+        e->reset();
+        e->eval(prompt.data(),64,false);
+        check(e->memory().stamp().frontier==64,"reset retained old accepted tokens");
+        std::cout<<"PASS reset_after_elastic_decode\n";
+    } catch(const std::exception& error) {std::cerr<<error.what()<<'\n';return 1;}
+}
