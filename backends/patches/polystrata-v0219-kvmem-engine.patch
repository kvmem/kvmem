+#include "kvmem_capture.hpp"
+#include <cuda_fp16.h>
+#include <cuda_runtime.h>
+#include <math_constants.h>
+#include <cmath>
+#include <algorithm>
+#include <stdexcept>
+
+namespace strata::poly {
+namespace {
+struct CaptureConfig { int64_t values[7]; };
+__global__ void pack_key_sums(const float* source,float* packed,int width,int groups,int layers,int source_groups) {
+    const size_t at=size_t(blockIdx.x)*blockDim.x+threadIdx.x;
+    const size_t stride=size_t(groups)*width;
+    if(at<size_t(layers)*stride)
+        packed[at]=source[(at/stride)*size_t(source_groups)*width+at%stride];
+}
+__global__ void set_config(int64_t* device,CaptureConfig config) {
+    for(int i=0;i<7;++i)device[i]=config.values[i];
+}
+__device__ float sum_warp(float value) {
+    for(int offset=16;offset;offset>>=1)value+=__shfl_down_sync(0xffffffff,value,offset);
+    return __shfl_sync(0xffffffff,value,0);
+}
+__device__ float max_warp(float value) {
+    for(int offset=16;offset;offset>>=1)value=fmaxf(value,__shfl_down_sync(0xffffffff,value,offset));
+    return __shfl_sync(0xffffffff,value,0);
+}
+template<int BlockTokens>
+__global__ void page_mass(const float* q,const uint16_t* keys,Kvq8 quant,int dim,int heads,int kv_heads,
+    const int64_t* cfg,const int32_t* map,float* mass,int stride,int layers,float scale) {
+    const int head=int(blockIdx.x),lane=int(threadIdx.x)&31,warp=int(threadIdx.x)>>5;
+    if(int64_t(blockIdx.y)>=cfg[6])return;
+    const int sample=int(cfg[5])+int(blockIdx.y);
+    const int64_t relative=map[sample];
+    const int row=int(relative-(cfg[0]-cfg[2]));
+    if(relative<0 || relative>=cfg[3] || row<0)return;
+    const int end=int(cfg[1])+row+1,pages=int(cfg[4]),kv=head/(heads/kv_heads);
+    extern __shared__ float shared[];
+    float* query=shared;
+    float* page=shared+dim;
+    __shared__ float reduce[8];
+    __shared__ float maximum,denominator;
+    for(int d=int(threadIdx.x);d<dim;d+=256)query[d]=q[(size_t(row)*heads+head)*dim+d];
+    for(int p=int(threadIdx.x);p<pages;p+=256)page[p]=0;
+    __syncthreads();
+    float biggest=-CUDART_INF_F;
+    for(int key=warp;key<end;key+=8) {
+        float dot=0;
+        const size_t base=(size_t(key)*kv_heads+kv)*dim;
+        for(int d=lane;d<dim;d+=32) {
+            const size_t at=base+d;
+            const float k=quant.codes ? float(quant.codes[at])*__half2float(reinterpret_cast<const __half*>(quant.scales)[at/32])
+                                      : __half2float(reinterpret_cast<const __half*>(keys)[at]);
+            dot+=query[d]*k;
+        }
+        biggest=fmaxf(biggest,sum_warp(dot)*scale);
+    }
+    if(lane==0)reduce[warp]=biggest;
+    __syncthreads();
+    if(warp==0) {
+        const float value=lane<8?reduce[lane]:-CUDART_INF_F;
+        const float top=max_warp(value);
+        if(lane==0)maximum=top;
+    }
+    __syncthreads();
+    float total=0;
+    for(int key=warp;key<end;key+=8) {
+        float dot=0;
+        const size_t base=(size_t(key)*kv_heads+kv)*dim;
+        for(int d=lane;d<dim;d+=32) {
+            const size_t at=base+d;
+            const float k=quant.codes ? float(quant.codes[at])*__half2float(reinterpret_cast<const __half*>(quant.scales)[at/32])
+                                      : __half2float(reinterpret_cast<const __half*>(keys)[at]);
+            dot+=query[d]*k;
+        }
+        const float weight=expf(sum_warp(dot)*scale-maximum);
+        if(lane==0) {atomicAdd(page+key/BlockTokens,weight);total+=weight;}
+    }
+    if(lane==0)reduce[warp]=total;
+    __syncthreads();
+    if(threadIdx.x==0) {
+        float sum=0;for(int i=0;i<8;++i)sum+=reduce[i];
+        denominator=sum*float(heads*layers);
+    }
+    __syncthreads();
+    for(int p=int(threadIdx.x);p<pages;p+=256)
+        if(denominator>0)atomicAdd(mass+size_t(sample)*stride+p,page[p]/denominator);
+}
+
+// Split the sampled QK reduction by physical page. The old one-CTA-per-head
+// path scanned all keys twice and exposed little parallelism for decode.
+// Each page now reads K once and stores its stable (maximum, exp sum). A
+// second reduction normalizes over the complete causal window, not per page.
+template<int BlockTokens,int Dim, bool Quantized, int Group=1>
+__global__ void page_mass_parts(const float* q,const uint16_t* keys,Kvq8 quant,int heads,int kv_heads,
+    const int64_t* cfg,const int32_t* map,float2* parts,int stride,float scale) {
+    const int t=int(threadIdx.x),lane=t&31,warp=t>>5,pages=int(cfg[4]);
+    __shared__ float logits[Group][BlockTokens],reduce[Group][4],maximum[Group];
+    // A bounded persistent grid also makes an unsampled CUDA-graph replay
+    // cheap: it exits a few CTAs rather than thousands of empty page CTAs.
+    for(int part=int(blockIdx.x);part<int(cfg[6])*(heads/Group)*pages;part+=int(gridDim.x)) {
+    const int page=part%pages,head=((part/pages)%(heads/Group))*Group,local=part/(pages*(heads/Group));
+    const int sample=int(cfg[5])+local;
+    const int64_t relative=map[sample];
+    const int row=int(relative-(cfg[0]-cfg[2]));
+    if(relative<0 || relative>=cfg[3] || row<0)continue;
+    const int end=int(cfg[1])+row+1;
+    const size_t out=(size_t(local)*heads+head)*stride+page;
+    if(page>=cfg[4] || page*BlockTokens>=end) {
+        if(t<Group)parts[out+size_t(t)*stride]=make_float2(-CUDART_INF_F,0.f);
+        continue;
+    }
+    // GQA heads share K. Keep their Q lanes in registers and reuse each
+    // dequantized key lane across the group, instead of rereading K per head.
+    float query[Group][Dim/32];
+    #pragma unroll
+    for(int g=0;g<Group;++g) {
+        #pragma unroll
+        for(int d=0;d<Dim/32;++d)query[g][d]=q[(size_t(row)*heads+head+g)*Dim+lane+d*32];
+    }
+    const int kv=head/(heads/kv_heads);
+    for(int i=warp;i<BlockTokens;i+=4) {
+        const int key=page*BlockTokens+i;
+        float dot[Group]={};
+        if(key<end) {
+            const size_t base=(size_t(key)*kv_heads+kv)*Dim;
+            #pragma unroll
+            for(int d=lane;d<Dim;d+=32) {
+                const size_t at=base+d;
+                const float k=Quantized ? float(quant.codes[at])*__half2float(reinterpret_cast<const __half*>(quant.scales)[at/32])
+                                        : __half2float(reinterpret_cast<const __half*>(keys)[at]);
+                #pragma unroll
+                for(int g=0;g<Group;++g)dot[g]+=query[g][d/32]*k;
+            }
+        }
+        #pragma unroll
+        for(int g=0;g<Group;++g) {
+            const float score=sum_warp(dot[g])*scale;
+            if(lane==0)logits[g][i]=key<end?score:-CUDART_INF_F;
+        }
+    }
+    __syncthreads();
+    #pragma unroll
+    for(int g=0;g<Group;++g) {
+        const float top=max_warp(t<BlockTokens?logits[g][t]:-CUDART_INF_F);
+        if(lane==0)reduce[g][warp]=top;
+    }
+    __syncthreads();
+    if(t<Group)maximum[t]=fmaxf(fmaxf(reduce[t][0],reduce[t][1]),fmaxf(reduce[t][2],reduce[t][3]));
+    __syncthreads();
+    #pragma unroll
+    for(int g=0;g<Group;++g) {
+        const float sum=sum_warp(t<BlockTokens?expf(logits[g][t]-maximum[g]):0.f);
+        if(lane==0)reduce[g][warp]=sum;
+    }
+    __syncthreads();
+    if(t<Group) {
+        const float total=reduce[t][0]+reduce[t][1]+reduce[t][2]+reduce[t][3];
+        parts[out+size_t(t)*stride]=make_float2(maximum[t],total);
+    }
+    __syncthreads();
+    }
+}
+
+// A warp owns one page and its GQA group. Independent warps do not wait at
+// CTA barriers between pages, and only lane zero needs the QK dot reduction.
+__device__ float sum_lane0(float value) {
+    for(int offset=16;offset;offset>>=1)value+=__shfl_down_sync(0xffffffff,value,offset);
+    return value;
+}
+struct InklingBias {
+    const float* relative;
+    const float* table;
+    const int64_t* logical_pages;
+    int extent, first_sample, sample_count;
+};
+template<int BlockTokens,int Dim,bool Quantized,int Group,bool Inkling=false>
+__global__ void page_mass_warp_parts(const float* q,const uint16_t* keys,Kvq8 quant,int heads,int kv_heads,
+    const int64_t* cfg,const int32_t* map,float2* parts,int stride,float scale,InklingBias bias = {}) {
+    const int lane=int(threadIdx.x)&31,warp=int(threadIdx.x)>>5,pages=int(cfg[4]);
+    __shared__ float logits[4][Group][BlockTokens];
+    const int offset = Inkling ? bias.first_sample : 0;
+    const int samples = Inkling ? min(int(cfg[6]) - offset, bias.sample_count) : int(cfg[6]);
+    for(int part=int(blockIdx.x)*4+warp;part<samples*(heads/Group)*pages;part+=int(gridDim.x)*4) {
+        const int page=part%pages,head=((part/pages)%(heads/Group))*Group,local=part/(pages*(heads/Group));
+        const int sample=int(cfg[5])+offset+local;
+        const int64_t relative=map[sample];
+        const int row=int(relative-(cfg[0]-cfg[2]));
+        if(relative<0 || relative>=cfg[3] || row<0)continue;
+        const int end=int(cfg[1])+row+1;
+        const size_t out=(size_t(local)*heads+head)*stride+page;
+        if(page*BlockTokens>=end) {
+            if(lane<Group)parts[out+size_t(lane)*stride]=make_float2(-CUDART_INF_F,0.f);
+            continue;
+        }
+        float query[Group][Dim/32];
+        #pragma unroll
+        for(int g=0;g<Group;++g) {
+            #pragma unroll
+            for(int d=0;d<Dim/32;++d)query[g][d]=q[(size_t(row)*heads+head+g)*Dim+lane+d*32];
+        }
+        const int kv=head/(heads/kv_heads);
+        for(int i=0;i<BlockTokens;++i) {
+            const int key=page*BlockTokens+i;
+            float dot[Group]={};
+            if(key<end) {
+                const size_t base=(size_t(key)*kv_heads+kv)*Dim;
+                #pragma unroll
+                for(int d=lane;d<Dim;d+=32) {
+                    const size_t at=base+d;
+                    const float k=Quantized ? float(quant.codes[at])*__half2float(reinterpret_cast<const __half*>(quant.scales)[at/32])
+                                            : __half2float(reinterpret_cast<const __half*>(keys)[at]);
+                    #pragma unroll
+                    for(int g=0;g<Group;++g)dot[g]+=query[g][d/32]*k;
+                }
+            }
+            #pragma unroll
+            for(int g=0;g<Group;++g) {
+                float score=sum_lane0(dot[g])*scale;
+                if constexpr (Inkling) {
+                    if (key < end) {
+                        const int64_t distance = cfg[0] + row - bias.logical_pages[page] - i;
+                        const auto* rel = bias.relative + (size_t(row)*heads + head + g)*16;
+                        const float local_bias = lane < 16 && distance >= 0 && distance < bias.extent
+                            ? rel[lane] * bias.table[distance*16 + lane] : 0.f;
+                        score += sum_lane0(local_bias);
+                    }
+                }
+                if(lane==0)logits[warp][g][i]=key<end?score:-CUDART_INF_F;
+            }
+        }
+        __syncwarp();
+        #pragma unroll
+        for(int g=0;g<Group;++g) {
+            const float a=logits[warp][g][lane],b=BlockTokens==64?logits[warp][g][lane+32]:-CUDART_INF_F;
+            const float top=max_warp(fmaxf(a,b));
+            const float sum=sum_lane0(expf(a-top)+expf(b-top));
+            if(lane==0)parts[out+size_t(g)*stride]=make_float2(top,sum);
+        }
+        __syncwarp();
+    }
+}
+
+__global__ void page_mass_merge(const float2* parts,const int64_t* cfg,const int32_t* map,
+    float* mass,int stride,int heads,int layers,int offset) {
+    const int head=int(blockIdx.x),local=int(blockIdx.y),t=int(threadIdx.x),lane=t&31,warp=t>>5;
+    if(local+offset>=cfg[6])return;
+    const int sample=int(cfg[5])+offset+local;
+    const int64_t relative=map[sample];
+    if(relative<0 || relative>=cfg[3] || relative<cfg[0]-cfg[2])return;
+    const int pages=int(cfg[4]);
+    const float2* in=parts+(size_t(local)*heads+head)*stride;
+    __shared__ float reduce[8],maximum,denominator;
+    float top=-CUDART_INF_F;
+    for(int p=t;p<pages;p+=256)top=fmaxf(top,in[p].x);
+    top=max_warp(top);
+    if(lane==0)reduce[warp]=top;
+    __syncthreads();
+    if(warp==0) {
+        const float all=max_warp(lane<8?reduce[lane]:-CUDART_INF_F);
+        if(lane==0)maximum=all;
+    }
+    __syncthreads();
+    float sum=0;
+    for(int p=t;p<pages;p+=256)sum+=in[p].y*expf(in[p].x-maximum);
+    sum=sum_warp(sum);
+    if(lane==0)reduce[warp]=sum;
+    __syncthreads();
+    if(t==0) {
+        float all=0;for(int i=0;i<8;++i)all+=reduce[i];
+        denominator=all*float(heads*layers);
+    }
+    __syncthreads();
+    for(int p=t;p<pages;p+=256)
+        if(denominator>0)atomicAdd(mass+size_t(sample)*stride+p,in[p].y*expf(in[p].x-maximum)/denominator);
+}
+}
+void kvmem_capture_config(int64_t* device,const int64_t* values,void* stream) {
+    CaptureConfig config{};for(int i=0;i<7;++i)config.values[i]=values[i];
+    set_config<<<1,1,0,static_cast<cudaStream_t>(stream)>>>(device,config);
+}
+void kvmem_pack_key_sums(const float* source,float* packed,int width,int groups,int layers,int source_groups,void* stream) {
+    const size_t count=size_t(width)*groups*layers;
+    pack_key_sums<<<unsigned((count+255)/256),256,0,static_cast<cudaStream_t>(stream)>>>(
+        source,packed,width,groups,layers,source_groups);
+}
+template<int BlockTokens>
+void dispatch_page_mass(const float* query,const uint16_t* keys,Kvq8 q8,int dim,int heads,int kv_heads,
+    int rows,const int64_t* cfg,const int32_t* map,float* mass,int stride,int layers,void* stream,
+    float* scratch,size_t scratch_floats,float scale) {
+    // score_ is dead after attention. Reusing it avoids a persistent allocation
+    // that would displace experts. Keep the small-context / unsupported fallback.
+    if(scratch && scratch_floats>=size_t(rows)*heads*stride*2 && (dim==512 || dim==256 || dim==32)) {
+        auto* parts=reinterpret_cast<float2*>(scratch);
+        const unsigned grid=unsigned(std::min(size_t(256),size_t(stride)*heads*rows));
+        const auto st=static_cast<cudaStream_t>(stream);
+        if(dim==512 && (heads/kv_heads)%8==0) {
+            // Gemma global attention shares one K head across eight Q heads.
+            // Read each page once for that group rather than scanning all K
+            // twice per Q head. Normalize across pages in the existing merge.
+            if(q8.codes)page_mass_warp_parts<BlockTokens,512,true,8><<<grid,128,0,st>>>(query,keys,q8,heads,kv_heads,cfg,map,parts,stride,scale,{});
+            else page_mass_warp_parts<BlockTokens,512,false,8><<<grid,128,0,st>>>(query,keys,q8,heads,kv_heads,cfg,map,parts,stride,scale,{});
+        } else if(dim==512 && (heads/kv_heads)%4==0) {
+            if(q8.codes)page_mass_parts<BlockTokens,512,true,4><<<grid,128,0,st>>>(query,keys,q8,heads,kv_heads,cfg,map,parts,stride,scale);
+            else page_mass_parts<BlockTokens,512,false,4><<<grid,128,0,st>>>(query,keys,q8,heads,kv_heads,cfg,map,parts,stride,scale);
+        } else if(dim==512) {
+            if(q8.codes)page_mass_parts<BlockTokens,512,true><<<grid,128,0,st>>>(query,keys,q8,heads,kv_heads,cfg,map,parts,stride,scale);
+            else page_mass_parts<BlockTokens,512,false><<<grid,128,0,st>>>(query,keys,q8,heads,kv_heads,cfg,map,parts,stride,scale);
+        } else if(dim==256 && (heads/kv_heads)%8==0) {
+            if(q8.codes)page_mass_warp_parts<BlockTokens,256,true,8><<<grid,128,0,st>>>(query,keys,q8,heads,kv_heads,cfg,map,parts,stride,scale,{});
+            else page_mass_warp_parts<BlockTokens,256,false,8><<<grid,128,0,st>>>(query,keys,q8,heads,kv_heads,cfg,map,parts,stride,scale,{});
+        } else if(dim==256 && (heads/kv_heads)%4==0) {
+            if(q8.codes)page_mass_parts<BlockTokens,256,true,4><<<grid,128,0,st>>>(query,keys,q8,heads,kv_heads,cfg,map,parts,stride,scale);
+            else page_mass_parts<BlockTokens,256,false,4><<<grid,128,0,st>>>(query,keys,q8,heads,kv_heads,cfg,map,parts,stride,scale);
+        } else if(dim==256) {
+            if(q8.codes)page_mass_parts<BlockTokens,256,true><<<grid,128,0,st>>>(query,keys,q8,heads,kv_heads,cfg,map,parts,stride,scale);
+            else page_mass_parts<BlockTokens,256,false><<<grid,128,0,st>>>(query,keys,q8,heads,kv_heads,cfg,map,parts,stride,scale);
+        } else {
+            if(q8.codes)page_mass_parts<BlockTokens,32,true><<<grid,128,0,st>>>(query,keys,q8,heads,kv_heads,cfg,map,parts,stride,scale);
+            else page_mass_parts<BlockTokens,32,false><<<grid,128,0,st>>>(query,keys,q8,heads,kv_heads,cfg,map,parts,stride,scale);
+        }
+        page_mass_merge<<<dim3(heads,rows),256,0,st>>>(parts,cfg,map,mass,stride,heads,layers,0);
+        return;
+    }
+    page_mass<BlockTokens><<<dim3(heads,rows),256,size_t(dim+stride)*sizeof(float),static_cast<cudaStream_t>(stream)>>>(
+        query,keys,q8,dim,heads,kv_heads,cfg,map,mass,stride,layers,scale);
+}
+void kvmem_page_mass(const float* query,const uint16_t* keys,Kvq8 q8,int dim,int heads,int kv_heads,
+    int rows,const int64_t* cfg,const int32_t* map,float* mass,int stride,int layers,int block_tokens,void* stream,
+    float* scratch,size_t scratch_floats,float attention_scale) {
+    const float scale=attention_scale>0 ? attention_scale : 1.f/std::sqrt(float(dim));
+    if(block_tokens==32)dispatch_page_mass<32>(query,keys,q8,dim,heads,kv_heads,rows,cfg,map,mass,stride,layers,stream,scratch,scratch_floats,scale);
+    else if(block_tokens==64)dispatch_page_mass<64>(query,keys,q8,dim,heads,kv_heads,rows,cfg,map,mass,stride,layers,stream,scratch,scratch_floats,scale);
+    else throw std::invalid_argument("KVMem block tokens must be 32 or 64");
+}
+
+void kvmem_inkling_page_mass(const float* query,const uint16_t* keys,const float* relative,const float* bias,
+    int extent,const int64_t* logical_pages,int heads,int kv_heads,int rows,const int64_t* cfg,
+    const int32_t* samples,float* mass,int stride,int slots,int block_tokens,void* stream,
+    float* scratch,size_t scratch_floats) {
+    if (rows <= 0) return;
+    const int step = int(std::min<size_t>(rows, scratch_floats / (size_t(heads)*stride*2)));
+    if (!step)
+        throw std::logic_error("Inkling KVMem has no scratch for a sampled attention row");
+    auto* parts = reinterpret_cast<float2*>(scratch);
+    const auto st = static_cast<cudaStream_t>(stream);
+    const float scale = 1.f/std::sqrt(128.f);
+    for (int offset = 0; offset < rows; offset += step) {
+        const int count = std::min(step, rows-offset);
+        const InklingBias extra{relative,bias,logical_pages,extent,offset,count};
+        if (block_tokens == 32)
+            page_mass_warp_parts<32,128,false,3,true><<<256,128,0,st>>>(
+                query,keys,{},heads,kv_heads,cfg,samples,parts,stride,scale,extra);
+        else
+            page_mass_warp_parts<64,128,false,3,true><<<256,128,0,st>>>(
+                query,keys,{},heads,kv_heads,cfg,samples,parts,stride,scale,extra);
+        page_mass_merge<<<dim3(heads,count),256,0,st>>>(parts,cfg,samples,mass,stride,heads,slots,offset);
+    }
+}
+
+}
