         while (common < std::min(ids.size(), tokens_.size()) && ids[common] == tokens_[common]) ++common;
         return common;
     }
+    // Only an append to the complete, still-live native prefix can bypass a
+    // repeated Query. A matching old prompt alone also admits edited answers,
+    // which can restore a checkpoint from before that Query was evaluated.
+    bool extends_live_prefix(const std::vector<int32_t>& ids, const kvmem::MemoryStamp& stamp,
+                             size_t completed_prompt) const {
+        return completed_prompt > 0 && tokens_.size() >= completed_prompt && ids.size() > tokens_.size()
+            && stamp.valid && stamp.session == session_ && stamp.frontier == tokens_.size()
+            && observed_prefix(ids) == tokens_.size();
+    }
     void append(const int32_t* ids, size_t count) { tokens_.insert(tokens_.end(), ids, ids + count); }
     void truncate(int64_t at) {
         if (at < 0 || uint64_t(at) > tokens_.size()) throw std::logic_error("KVMem history truncation exceeds its prefix");
