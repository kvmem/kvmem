+// Oracle uses represented BF16 Q and the FP8 K codes/scales read back AFTER the
+// actual append. It never uses a CUDA dot product or the main attention's logits.
+#include "ninfer/ops/attention_page_mass.h"
+#include "ninfer/ops/prompt_page_lse.h"
+#include "ops/op_tester.h"
+#include <bit>
+#include <numeric>
+using namespace ninfer;
+using namespace ninfer::test;
+
+static double fp8(unsigned b) {
+    const unsigned e=(b>>3)&15, m=b&7;
+    if (e==15 && m==7) throw std::runtime_error("NaN in represented key");
+    return (b&128?-1:1)*(e?std::ldexp(1.+m/8.,int(e)-7):std::ldexp(double(m),-9));
+}
+static double half_scale(unsigned b) {
+    const unsigned e=(b>>10)&31, m=b&1023;
+    if ((b&32768)||e==31) throw std::runtime_error("invalid represented row scale");
+    return e?std::ldexp(1.+m/1024.,int(e)-15):std::ldexp(double(m),-24);
+}
+
+static void qualify(int base,int width,std::vector<int> samples) {
+    constexpr int D=256,H=24,K=4;
+    const int end=base+width, pages=(end+63)/64+2, capacity=pages+3, S=int(samples.size());
+    const size_t nk=size_t(capacity)*K*64, nq=size_t(width)*H*D;
+    std::mt19937 rng(20261113+base);
+    std::uniform_real_distribution<float> uniform(-1.6f,1.6f);
+    std::vector<std::uint16_t> q(nq), k(size_t(width)*K*D), v(k.size());
+    for (auto& x:q) x=f32_to_bf16(uniform(rng));
+    for (auto& x:k) x=f32_to_bf16(uniform(rng));
+    for (auto& x:v) x=f32_to_bf16(uniform(rng)*.7f);
+    std::vector<std::uint8_t> codes(nk*D); std::vector<std::uint16_t> scales(nk);
+    for (size_t i=0;i<nk;++i) {
+        scales[i]=std::uint16_t(0x2400+(i%19)*67);
+        for(int d=0;d<D;++d) codes[i*D+d]=std::uint8_t((rng()%127)|((rng()%2)*128));
+    }
+    // A nonzero table slot and nonmonotone physical addresses exercise logical
+    // page order. More table capacity than feedback pages exercises the bound.
+    std::vector<int> table(capacity*2,-1);
+    for(int i=0;i<capacity;++i) table[capacity+i]=capacity-1-i;
+    std::vector<int> pos(width), limits(S);
+    std::iota(pos.begin(),pos.end(),base);
+    for(int i=0;i<S;++i) limits[i]=pos.at(samples[i]);
+    auto dq=to_device(q), dk=to_device(k), dv=to_device(v), dt=to_device(table);
+    auto pc=to_device(codes), pv=to_device(codes), ps=to_device(scales), vs=to_device(scales);
+    auto dp=to_device(pos), dtr=to_device(std::vector<int>{1}), dr=to_device(samples), de=to_device(limits);
+    DeviceBuffer result(nq*2), other(nq*2), scratch(size_t(pages)*H*S*4), norms(size_t(2)*H*S*4), mass(size_t(pages)*S*4);
+    Tensor qt(dq.p,DType::BF16,{D,H,width}),kt(dk.p,DType::BF16,{D,K,width}),vt(dv.p,DType::BF16,{D,K,width});
+    Tensor ot(result.p,DType::BF16,{D,H,width}),refout(other.p,DType::BF16,{D,H,width});
+    Tensor pt(dp.p,DType::I32,{width}),rt(dtr.p,DType::I32,{1}),rr(dr.p,DType::I32,{S}),ee(de.p,DType::I32,{S});
+    Tensor st(scratch.p,DType::FP32,{pages,H,S}),nt(norms.p,DType::FP32,{2,H,S}),mt(mass.p,DType::FP32,{pages,S});
+    PagedKVBatchLayerView cache;
+    cache.head_dim=D; cache.num_kv_heads=K; cache.storage=KvCacheStorage::Fp8E4M3Row256;
+    cache.k_pages=Tensor(pc.p,DType::FP8_E4M3FN,{D,64,K,capacity}); cache.v_pages=Tensor(pv.p,DType::FP8_E4M3FN,{D,64,K,capacity});
+    cache.k_scale_pages=Tensor(ps.p,DType::FP16,{1,64,K,capacity}); cache.v_scale_pages=Tensor(vs.p,DType::FP16,{1,64,K,capacity});
+    cache.block_tables=Tensor(dt.p,DType::I32,{capacity,2});
+    const ops::AttentionHeadGeometry geo{D,H,K};
+    const ops::CausalAttentionExecutionEnvelope env{unsigned(base+1),unsigned(end)};
+    WorkspaceArena arena(std::max<size_t>(4096,ops::causal_softmax_attention_workspace_capacity_bytes(geo,cache.storage,env,1,width,width)));
+    ops::causal_softmax_attention(qt,kt,vt,pt,{},rt,geo,1.f/16,cache,env,arena,refout,nullptr);
+    ops::attention_page_mass(qt,rr,ee,1,cache,st,nt,mt,nullptr);
+    const auto old=from_device<float>(mass,mt.numel());
+    scratch.fill(0x7f); // unwritten tail must be zero probability, even with dirty scratch
+    ops::PromptPageLse capture;
+    capture.scratch=st;capture.count=S;std::copy(samples.begin(),samples.end(),capture.rows);
+    ops::causal_softmax_attention_with_page_lse(qt,kt,vt,pt,{},rt,geo,1.f/16,cache,env,arena,ot,nullptr,nullptr,nullptr,&capture);
+    if(!capture.captured) throw std::runtime_error("qualified route fell back");
+    ops::attention_page_mass_from_lse(st,nt,mt,nullptr);
+    const auto fused=from_device<float>(mass,mt.numel());
+    if(from_device<std::uint16_t>(result,nq)!=from_device<std::uint16_t>(other,nq))
+        throw std::runtime_error("capture changed main attention output bits");
+    codes=from_device<std::uint8_t>(pc,codes.size());
+    scales=from_device<std::uint16_t>(ps,scales.size());
+    std::vector<double> represented(nk*D);
+    for(size_t i=0;i<nk;++i) for(int d=0;d<D;++d) represented[i*D+d]=half_scale(scales[i])*fp8(codes[i*D+d]);
+    std::vector<double> oracle(size_t(pages)*S);
+    for(int j=0;j<S;++j) for(int h=0;h<H;++h) {
+        const auto* raw=&q[(size_t(samples[j])*H+h)*D];
+        double rotated[D]{};
+        for(int d=0;d<D;++d) for(int e=0;e<D;++e)
+            rotated[d]+=(std::popcount(unsigned(d&e))%2?-1:1)*double(bf16_to_f32(raw[e]))/16.;
+        std::vector<double> logits(limits[j]+1);
+        for(int t=0;t<=limits[j];++t) {
+            const auto idx=(size_t(table[capacity+t/64])*K+h/(H/K))*64+t%64;
+            logits[t]=std::inner_product(rotated,rotated+D,&represented[idx*D],0.)/16.;
+        }
+        const auto peak=*std::max_element(logits.begin(),logits.end());double z=0;
+        for(auto& y:logits){y=std::exp(y-peak);z+=y;}
+        for(size_t t=0;t<logits.size();++t) oracle[size_t(j)*pages+t/64]+=logits[t]/(z*H);
+    }
+    double worst=0,old_err=0,old_delta=0,max_l1=0,sum_err=0;
+    for(int j=0;j<S;++j){
+        double l1=0,sum=0;
+        for(int p=0;p<pages;++p){
+            const size_t i=size_t(j)*pages+p;const double err=std::abs(fused[i]-oracle[i]);
+            if(!std::isfinite(fused[i]) || fused[i]<0 || (p*64>limits[j] && fused[i]!=0))
+                throw std::runtime_error("invalid or unmasked page");
+            l1+=err;sum+=fused[i];worst=std::max(worst,err);
+            old_err=std::max(old_err,std::abs(old[i]-oracle[i]));
+            old_delta=std::max(old_delta,std::abs(double(old[i])-fused[i]));
+        }
+        max_l1=std::max(max_l1,l1);sum_err=std::max(sum_err,std::abs(sum-1));
+    }
+    std::cout<<"base="<<base<<" width="<<width<<" samples="<<S<<" main_bits_equal=1 max_abs="<<worst
+             <<" row_l1="<<max_l1<<" old_oracle="<<old_err<<" fused_old="<<old_delta<<" sum_err="<<sum_err<<std::endl;
+    if(old_err>2e-5 || worst>0.002 || max_l1>0.005 || sum_err>2e-6)
+        throw std::runtime_error("outside page probability tolerance");
+    // A stale or invalid requested capture must not be mistaken for materialized stats.
+    capture.rows[0]=-1;
+    ops::causal_softmax_attention_with_page_lse(qt,kt,vt,pt,{},rt,geo,1.f/16,cache,env,arena,ot,nullptr,nullptr,nullptr,&capture);
+    if(capture.captured || from_device<std::uint16_t>(result,nq)!=from_device<std::uint16_t>(other,nq))
+        throw std::runtime_error("invalid capture did not fall back to regular attention");
+}
+int main() {
+    try {
+        if(cuda_unavailable() || ops::current_device_tier()!=ops::DeviceTier::Ampere) return 77;
+        qualify(0,99,{0,31,32,62,63,64,94,98});
+        std::vector<int> many(64); for(int i=0;i<64;++i) many[i]=2*i;
+        qualify(47,137,many);
+        qualify(1003,1024,{5,20,63,85,196,511,751,1023});
+        qualify(36*1024,1024,{0,31,511,1023});
+        return 0;
+    } catch(const std::exception& e){std::cerr<<e.what()<<'\n';return 1;}
+}
