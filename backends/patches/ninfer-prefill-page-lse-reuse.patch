+bool try_prompt_fp8_page_lse(const Tensor& q, const Tensor& k, const Tensor& v,
+    const Tensor& positions, const Tensor& table_rows, float scale, PagedKVBatchLayerView cache,
+    std::uint32_t max_visible, Tensor& out, cudaStream_t stream, PromptPageLse& capture) {
+    // This implementation was qualified on the Ada wide-BF16-MMA FP8 route.
+    if (current_device_tier() != DeviceTier::Ampere) return false;
+    const auto& scratch = capture.scratch;
+    const int n=capture.count;
+    if (n<=0 || n>PromptPageLse::max_samples || scratch.dtype!=DType::FP32 ||
+        !scratch.data || !scratch.is_contiguous() || scratch.ne[0]<=0 || scratch.ne[0]>cache.block_tables.ne[0] ||
+        std::uint64_t(scratch.ne[0])*64<max_visible ||
+        scratch.ne[1]!=q.ne[1] || scratch.ne[2]!=n || scratch.ne[3]!=1 ||
+        scratch.numel()>INT_MAX) return false;
+    for (int i=0;i<n;++i)
+        if (capture.rows[i]<0 || capture.rows[i]>=q.ne[2] || (i && capture.rows[i]<=capture.rows[i-1]))
+            return false;
+    using Shape=CausalPromptFp8Shape<false>;
+    using Metadata=PagedKVBatchMetadata<false>;
+    const Metadata meta{.tables=static_cast<const int*>(cache.block_tables.data),
+        .valid_columns=nullptr, .table_rows=static_cast<const int*>(table_rows.data),
+        .table_stride=cache.block_tables.ne[0]};
+    PromptPageLseTile tile{static_cast<float*>(scratch.data),int(scratch.ne[0]),n,{}};
+    std::copy_n(capture.rows,n,tile.rows);
+    kv_cache_append_batch_launch(k,v,positions,Tensor{},table_rows,cache,stream);
+    // The CTA only traverses its visible prefix. Clear non-visible capacity,
+    // including stale values from the previous layer, to zero probability.
+    clear_prompt_page_lse<<<(int(scratch.numel())+255)/256,256,0,stream>>>(tile.values,int(scratch.numel()));
+    const auto kernel=causal_attention_prompt_fp8_kernel<CausalD256H24Kv4,Metadata,false,PromptPageLseTile>;
+    raise_dynamic_shared_memory(kernel,Shape::SmemBytes);
+    const dim3 grid(unsigned(div_up(int(q.ne[2]),Shape::Br)),unsigned(q.ne[1]),1);
+    kernel<<<grid,kCausalPromptFp8Threads,Shape::SmemBytes,stream>>>(
+        static_cast<const __nv_bfloat16*>(q.data),static_cast<const std::uint8_t*>(cache.k_pages.data),
+        static_cast<const std::uint8_t*>(cache.v_pages.data),static_cast<const __half*>(cache.k_scale_pages.data),
