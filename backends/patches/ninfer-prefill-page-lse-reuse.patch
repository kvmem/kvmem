+++ b/include/ninfer/ops/prompt_page_lse.h
@@ -0,0 +1,27 @@
+#pragma once
+
+#include "ninfer/ops/softmax_attention.h"
+
+namespace ninfer::ops {
+// Eager single-sequence prompt feedback. Row IDs are relative to this physical
+// call, strictly increasing; CUDA copies them as launch parameters. scratch is
+// caller-owned contiguous FP32 [page,head,sample] and lives through reduction.
+// Unsupported attention routes leave captured=false and perform normal attention.
+struct PromptPageLse {
+    static constexpr int max_samples = 64;
+    Tensor scratch;
+    std::int32_t rows[max_samples]{};
+    std::int32_t count = 0;
+    bool captured = false;
+};
+void causal_softmax_attention_with_page_lse(const Tensor& q, const Tensor& k, const Tensor& v,
+    const Tensor& positions, const Tensor& valid_columns, const Tensor& kv_table_rows,
+    AttentionHeadGeometry geometry, float scale, PagedKVBatchLayerView cache,
+    CausalAttentionExecutionEnvelope envelope, WorkspaceArena& workspace, Tensor& out,
+    cudaStream_t stream, const Tensor* gate, Tensor* partial, PromptPageLse* capture);
+
+// Normalize the captured natural-log page sums over all visible pages per head,
+// then average heads, exactly as in the independent attention_page_mass path.
+void attention_page_mass_from_lse(const Tensor& scratch, Tensor& norms, Tensor& output,
+    cudaStream_t stream);
+} // namespace ninfer::ops
