+    HipError::new(
+        0,
+        &format!(
+            "{family}: MQ4G256V2Lloyd has no batched LUT route on {} \
+             (supported: gfx1100/gfx1151 MMQ-LUT, gfx1201 FP8-LUT)",
+            gpu.arch
+        ),
+    )
