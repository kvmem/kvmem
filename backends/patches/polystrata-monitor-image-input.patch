+@contextmanager
+def media_preparation(service, has_media):
+    """Expose slow image preparation without changing native execution or timing."""
+    service.embeddings.kvmem_monitor_id = None
+    if not has_media or not getattr(service, 'kvmem_monitor_gpu_uuid', None):
+        yield
+        return
+    key = uuid.uuid4().hex[:12]
+    service.embeddings.kvmem_monitor_id = key
+    row = {'kvmem_monitor_id': key, 'started': time.time(), 'has_media': True, 'preparing_media': True}
+    with service.status_lock:
+        if not hasattr(service, 'kvmem_media_preparing'):
+            service.kvmem_media_preparing = {}
+        service.kvmem_media_preparing[key] = row
+    try:
+        yield
+    finally:
+        with service.status_lock:
+            service.kvmem_media_preparing.pop(key, None)
 
 
