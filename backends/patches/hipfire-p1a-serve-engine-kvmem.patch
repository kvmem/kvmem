-                &rig.gpu, rig.model.mtp_states[slot].as_ref().ok_or("kvmem: missing MTP history at snapshot")?, frontier,
-            )?),
-            SpecKind::Dflash => {
-                // A checkpoint/image is taken at a prefill boundary, never in
