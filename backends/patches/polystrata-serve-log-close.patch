--- a/serve/images.py
+++ b/serve/images.py
@@ -203,6 +203,14 @@ class ImageGen:
             except (OSError, ValueError):
                 pass
 
+    def close(self) -> None:
+        """The server ends: release the shared log's handle (the config's "log" is opened for this object's life).
+        Without it the handle outlives the server and Windows refuses to remove the log's temporary directory."""
+        log, self.log = self.log, None
+        if log is not None:
+            with contextlib.suppress(OSError):
+                log.close()
+
     def _prune(self) -> None:
         """Keep the newest keep_files PNGs of response_format url (the oldest go)."""
         files = sorted((p for p in self.dir.glob("*.png") if FILE_NAME.match(p.name)), key=lambda p: p.stat().st_mtime)
