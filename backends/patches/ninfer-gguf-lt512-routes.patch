diff --git a/docs/gguf-mxfp8-prefill.md b/docs/gguf-mxfp8-prefill.md
index 953b9f0ff3cd132e9bb4414862893d594f2fed92..832b87425ee1b25b45490a95e92946f6d1afba01 100644
--- a/docs/gguf-mxfp8-prefill.md
+++ b/docs/gguf-mxfp8-prefill.md
@@ -32,6 +32,22 @@ require whole 128-row tiles; unsupported formats, partial row tiles and other
 epilogues keep their existing route. A Q8 choice bypasses both FP8 kernels and
 the two-stage Lt path. T >= 1024 retains Lt irrespective of these profile keys.
 
+At exactly T=512 a measured `lt` entry may select the same bounded cuBLASLt
+implementation used at T>=1024. Workspace queries include its slab only when a
+matching entry can be reached in the requested extent interval. The FP32 weight
+decode, actual group amax, E4M3/E8M0 representation and FP32 accumulation are
+retained; GEMM reduction order may differ from the tile implementation.
+
+The 36-SM RTX 5060 Ti table has 78 T=512 entries for IQ3_S/IQ4_XS across ten
+registered shapes and four epilogues. Two mirrored five-trial median public-Op
+sweeps confirmed each retained improvement above 3%. IQ3_S 1024x5120 BF16 Store
+and Add retain tile because Lt regressed. Existing T=256 choices are preserved;
+the entries stop at 512, with tile retained through 511. Other cards and
+unmeasured shapes retain their current routing and workspace requirements.
+The automatic calibration tool currently measures this namespace at T=256;
+it does not yet generate the Lt512 entries. These built-ins came from the
+separately qualified native public-Op sweep.
+
 The first built-in set has 25 entries for the 36-SM RTX 5060 Ti, at exactly
 T=256. Two independent native calibrations measured 8 formats, 10 actual-model
 shapes and 4 epilogues; only Q8 winners confirmed in both runs were retained.
diff --git a/src/ops/linear/gguf/gguf_linear.cpp b/src/ops/linear/gguf/gguf_linear.cpp
index 681e649122705ded9b8441f5280a06178de1a1ed..2a9b05eb7949ef0fdb449138c6255f5ccbbd38d9 100644
--- a/src/ops/linear/gguf/gguf_linear.cpp
+++ b/src/ops/linear/gguf/gguf_linear.cpp
@@ -47,6 +47,14 @@ PrefillRoute prefill_route(GgmlType type, std::int32_t n, std::int32_t k,
                            std::int32_t tokens, PrefillEpilogue epilogue) {
     if (!enabled() || tokens < kMinColumns || !supported(type, k)) { return PrefillRoute::Q8; }
     if (!takes_tile(type, k, tokens)) { return PrefillRoute::Lt; }
+    // Lt entries are measured exact-width choices; other devices and widths
+    // retain their existing tile/Q8 routes.
+    if (tokens == 512 && n > 0) {
+        const auto key = prefill_route_key(type, n, k, epilogue);
+        if (!key.empty() && device_route_schedule(key, tokens) == "lt") {
+            return PrefillRoute::Lt;
+        }
+    }
     // The alternate integer matrix route requires whole output-row tiles. Never
     // let a profile extend a candidate's mathematical or implementation domain.
     if (n > 0 && n % 128 == 0 && has_matrix_kernel(type)) {
@@ -339,7 +347,14 @@ std::size_t gguf_project_workspace_bytes(std::span<const GgufShape> shapes,
         for(const auto& shape:shapes) {
             if(gguf::mxfp8::supported(gguf_type(shape.qtype),shape.k)) {
                 ++count;
-                if(max_tokens>=1024)scratch=std::max(scratch,gguf::mxfp8::scratch_bytes(k,shape.rows,max_tokens));
+                bool lt512 = false;
+                if (min_tokens <= 512 && max_tokens >= 512) {
+                    for (auto epi : gguf::mxfp8::kPrefillEpilogues) {
+                        lt512 |= gguf::mxfp8::prefill_route(gguf_type(shape.qtype),
+                            shape.rows, shape.k, 512, epi) == gguf::mxfp8::PrefillRoute::Lt;
+                    }
+                }
+                if(max_tokens>=1024 || lt512)scratch=std::max(scratch,gguf::mxfp8::scratch_bytes(k,shape.rows,max_tokens));
             }
         }
         std::size_t activation=gguf::mxfp8::activation_bytes(k,max_tokens);
