+    }
+
+    void* allocate(std::size_t bytes) {
+        require_device();
+        if (bytes == 0) { return nullptr; }
+        if (bytes > std::numeric_limits<std::size_t>::max() - snapshot.device_allocated_bytes) {
+            throw std::overflow_error("strict: device allocation size overflow");
+        }
