+                    cuda_check(cudaMemcpy(host, warm, bytes, cudaMemcpyDeviceToHost),
+                               "warm full host pool DtoH");
+                }
+                cuda_check(cudaDeviceSynchronize(), "complete full host pool DMA warmup");
