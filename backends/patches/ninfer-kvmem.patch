+#include "ninfer/engine.h"
+#include "kvmem_test_options.h"
+#include <fstream>
+#include <iostream>
+#include <stdexcept>
+#include <string>
+
+int main(int argc, char** argv) {
+    try {
+        if (argc != 5) throw std::invalid_argument("artifact bf16|int8|nvfp4|k8v4|rk8v4 eager|graph output");
+        ninfer::EngineOptions o;
+        o.artifact_path = argv[1];
+        o.max_context = 16384;
+        o.device = 0;
+        o.max_concurrency = 1;
+        o.prefill_chunk = 128;
+        o.kvmem.selected_tokens = 384;
+        o.kvmem.reserve_tokens = 128;
+        o.kvmem.host_bytes = 2ULL << 30;
+        o.kvmem.verify_transfers = true;
+        o.kv_capacity = ninfer::KvCapacityPolicy::explicit_capacity(512);
+        o.kv_cache = ninfer::test::kvmem_test_storage(argv[2]);
+        o.context_cache.enabled = false;
+        o.use_cuda_graph = ninfer::test::kvmem_test_graph(argv[3]);
+        o.device_profile = "off";
+        ninfer::Engine engine(o);
+        std::ofstream output(argv[4]);
+        for (int turn = 0; turn < 3; ++turn) {
+            ninfer::PromptInput prompt;
+            const auto add = [&](ninfer::ChatRole role, const std::string& text) {
+                ninfer::ChatMessage message;
+                message.role = role;
+                message.parts.push_back({.kind = ninfer::MessagePartKind::Text, .text = text});
+                prompt.messages.push_back(std::move(message));
+            };
+            add(ninfer::ChatRole::System, "Use the archive to answer the final question.");
+            for (int record = 0; record < 24; ++record) {
+                std::string paragraph = "Archive entry " + std::to_string(record) + ". ";
+                for (int repeat = 0; repeat < 8; ++repeat) {
+                    paragraph += record < 4
+                        ? "The violet observatory studies pulsars, cosmic rays and distant galaxies. "
+                        : "The coastal office files invoices, transport schedules and warehouse inventories. ";
+                }
+                add(ninfer::ChatRole::User, paragraph);
+                add(ninfer::ChatRole::Assistant, "The archive entry is recorded.");
+            }
+            const std::string query = turn == 1
+                ? "Explain coastal warehouse inventories and transport schedules."
+                : "Explain the violet observatory, its pulsars, cosmic rays and distant galaxies.";
+            add(ninfer::ChatRole::User, query);
+            ninfer::RequestOptions request;
+            request.execution.requested_output_tokens = 130;
+            request.execution.sampling.temperature = 0;
+            request.execution.sampling.seed = 42;
+            request.execution.allow_prefix_reuse = false;
+            request.stop.include_model_defaults = false;
+            const auto result = engine.submit(engine.prepare(std::move(prompt)), request).wait();
+            if (result.generated_token_ids.size() != 130 || !engine.is_available())
+                throw std::runtime_error("retrieval request did not complete");
+            output << turn;
+            for (auto token : result.generated_token_ids) output << ' ' << token;
+            output << '\n';
+            std::cout << "P4_RETRIEVAL turn=" << turn << " output=" << result.generated_token_ids.size() << '\n';
+        }
+        std::cout << "P4_RETRIEVAL PASS\n";
+    } catch (const std::exception& e) { std::cerr << e.what() << '\n'; return 1; }
+}
diff --git a/tests/experimental/ssd_failure.cpp b/tests/experimental/ssd_failure.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..b33dd013f374d155f4df4dfddbf874fade6897fc
--- /dev/null
+++ b/tests/experimental/ssd_failure.cpp
@@ -0,0 +1,264 @@
+#include "ninfer/engine.h"
+#include "kvmem_test_options.h"
+#include "kvmem/host_kv_storage.hpp"
+#include "kvmem/spill_io.hpp"
+#include "kvmem/memory_contract.hpp"
+#include <atomic>
+#include <chrono>
+#include <condition_variable>
+#include <cstring>
+#include <filesystem>
+#include <future>
+#include <iostream>
+#include <mutex>
+#include <stdexcept>
+#include <string>
+#include <thread>
+#include <type_traits>
+
+#ifdef _WIN32
+#include <windows.h>
+
+namespace {
+void require(bool value, const char* message) {
+    if (!value) throw std::runtime_error(message);
+}
+
+// Replace only this test executable's ReadFile/WriteFile import. No production hook,
+// environment variable, filesystem modification or other process is involved.
+// One KV write receives the same error as a full Windows volume would return.
+template<bool Reading = false> class FileFailure {
+    using Pointer = std::conditional_t<Reading, LPVOID, LPCVOID>;
+    using Write = BOOL(WINAPI*)(HANDLE, Pointer, DWORD, LPDWORD, LPOVERLAPPED);
+    inline static Write original = nullptr;
+    inline static std::atomic<bool> armed{false};
+    inline static std::atomic<unsigned> failures{0};
+    inline static std::mutex gate_mutex;
+    inline static std::condition_variable gate_changed;
+    inline static bool hold = false, entered = false, released = false;
+    ULONG_PTR* slot = nullptr;
+    static BOOL WINAPI write(HANDLE file, Pointer data, DWORD size, LPDWORD done, LPOVERLAPPED op) {
+        if (armed.load()) {
+            wchar_t path[2048]{};
+            const auto count = GetFinalPathNameByHandleW(file, path, 2048, FILE_NAME_NORMALIZED);
+            if (count && count < 2048 && std::wcsstr(path, L"kvmem-spill-") && armed.exchange(false)) {
+                std::unique_lock<std::mutex> lock(gate_mutex);
+                if (hold) {
+                    entered = true;
+                    gate_changed.notify_all();
+                    gate_changed.wait(lock, [] { return released; });
+                    lock.unlock();
+                    return original(file, data, size, done, op);
+                }
+                ++failures;
+                SetLastError(Reading ? ERROR_READ_FAULT : ERROR_DISK_FULL);
+                return FALSE;
+            }
+        }
+        return original(file, data, size, done, op);
+    }
+    void replace(ULONG_PTR value) {
+        DWORD previous = 0;
+        require(VirtualProtect(slot, sizeof(*slot), PAGE_READWRITE, &previous) != 0, "cannot change test import");
+        *slot = value;
+        DWORD ignored = 0;
+        require(VirtualProtect(slot, sizeof(*slot), previous, &ignored) != 0, "cannot restore test import protection");
+    }
+public:
+    FileFailure() {
+        auto* base = reinterpret_cast<unsigned char*>(GetModuleHandleW(nullptr));
+        auto* dos = reinterpret_cast<IMAGE_DOS_HEADER*>(base);
+        auto* nt = reinterpret_cast<IMAGE_NT_HEADERS*>(base + dos->e_lfanew);
+        auto* imports = reinterpret_cast<IMAGE_IMPORT_DESCRIPTOR*>(base +
+            nt->OptionalHeader.DataDirectory[IMAGE_DIRECTORY_ENTRY_IMPORT].VirtualAddress);
+        for (; imports->Name && !slot; ++imports) {
+            if (!imports->OriginalFirstThunk) continue;
+            auto* names = reinterpret_cast<IMAGE_THUNK_DATA*>(base + imports->OriginalFirstThunk);
+            auto* addresses = reinterpret_cast<IMAGE_THUNK_DATA*>(base + imports->FirstThunk);
+            for (; names->u1.AddressOfData; ++names, ++addresses) {
+                if (IMAGE_SNAP_BY_ORDINAL(names->u1.Ordinal)) continue;
+                auto* name = reinterpret_cast<IMAGE_IMPORT_BY_NAME*>(base + names->u1.AddressOfData);
+                if (std::strcmp(reinterpret_cast<const char*>(name->Name), Reading ? "ReadFile" : "WriteFile") == 0) {
+                    slot = &addresses->u1.Function;
+                    original = reinterpret_cast<Write>(*slot);
+                    break;
+                }
+            }
+        }
+        require(slot, "test executable does not import required file operation");
+        replace(reinterpret_cast<ULONG_PTR>(&write));
+    }
+    ~FileFailure() { armed = false; release(); if (slot) replace(reinterpret_cast<ULONG_PTR>(original)); }
+    void arm(bool block = false) {
+        std::lock_guard<std::mutex> lock(gate_mutex);
+        hold = block; entered = released = false; armed = true;
+    }
+    bool wait_entered() {
+        std::unique_lock<std::mutex> lock(gate_mutex);
+        return gate_changed.wait_for(lock, std::chrono::seconds(30), [] { return entered; });
+    }
+    void release() {
+        std::lock_guard<std::mutex> lock(gate_mutex);
+        released = true; gate_changed.notify_all();
+    }
+    unsigned count() const { return failures.load(); }
+};
+using WriteFailure = FileFailure<false>;
+
+void cold_rewrite_peer_progress() {
+    kvmem::HostKvStorage storage(32, std::make_shared<kvmem::SpillFile>(
+        std::filesystem::current_path() / "promotion-spill", 128));
+    const unsigned char expected[8] = {1,2,3,4,5,6,7,8};
+    auto cold = storage.allocate(8, expected);
+    cold.seal(); storage.trim(0);
+    FileFailure<true> gate;
+    gate.arm(true);
+    auto rewrite = std::async(std::launch::async, [&] { cold.writable_data()[0] = 9; });
+    const bool entered = gate.wait_entered();
+    auto peer = std::async(std::launch::async, [&] { return storage.allocate(8); });
+    const bool progressed = peer.wait_for(std::chrono::seconds(2)) == std::future_status::ready;
+    gate.release(); // Release before assertions/future destruction even on failure.
+    rewrite.get(); auto resident = peer.get();
+    require(entered && progressed, "cold rewrite blocked an independent RAM reservation");
+    cold.seal(); storage.trim(0);
+    gate.arm();
+    bool failed = false;
+    try { (void)cold.writable_data(); }
+    catch (const kvmem::MemoryError& error) { failed = error.code() == kvmem::MemoryErrorCode::TransferFailed; }
+    require(failed && cold.resident_bytes() == 0 && storage.charged_bytes() == 8,
+            "failed promotion discarded disk or leaked reserved RAM");
+    unsigned char restored[8]{};
+    cold.read(0, restored, sizeof(restored));
+    require(restored[0] == 9 && std::memcmp(restored+1, expected+1, 7) == 0,
+            "failed promotion corrupted the only valid copy");
+    std::cout << "COLD_REWRITE peer progress and failed-read rollback PASS" << std::endl;
+}
+struct Sink final : ninfer::OutputSink {
+    std::promise<void> first;
+    bool notified = false;
+    std::atomic<unsigned> generated{0};
+    void start(ninfer::GenerationStart) override {}
+    void progress(ninfer::PromptProgress) override {}
+    void publish(ninfer::OutputDelta) override {}
+    void timing(ninfer::GenerationTimingObservation value) override {
+        generated = value.generated_tokens;
+        if (value.generated_tokens && !notified) { notified = true; first.set_value(); }
+    }
+};
+ninfer::PromptInput prompt(bool cold) {
+    ninfer::PromptInput input;
+    input.options.enable_thinking = false;
+    input.context_cache.session_key = cold ? "cold-failure" : "hot-peer";
+    ninfer::ChatMessage message;
+    message.role = ninfer::ChatRole::User;
+    std::string text;
+    if (cold) for (int i = 0; i < 160; ++i)
+        text += "The observatory archives pulsars, cosmic rays and distant galaxies. ";
+    text += "List 100 numbered facts about astronomy.";
+    message.parts.push_back({.kind = ninfer::MessagePartKind::Text, .text = std::move(text)});
+    input.messages.push_back(std::move(message));
+    return input;
+}
+ninfer::RequestOptions request(unsigned output) {
+    ninfer::RequestOptions value;
+    value.execution.requested_output_tokens = output;
+    value.execution.sampling.temperature = 0;
+    value.stop.include_model_defaults = false;
+    return value;
+}
+}
+int main(int argc, char** argv) {
+    try {
+        require(argc == 2, "artifact");
+        cold_rewrite_peer_progress();
+        const auto promotion_path = std::filesystem::current_path() / "promotion-spill";
+        require(std::filesystem::is_empty(promotion_path), "promotion leaked its spill file");
+        std::filesystem::remove(promotion_path);
+        ninfer::EngineOptions options;
+        ninfer::test::kvmem_test_devices(options);
+        options.artifact_path = argv[1];
+        options.device_profile = "off";
+        options.max_context = 8192;
+        options.max_concurrency = 2;
+        options.prefill_chunk = 128;
+        options.kv_cache = ninfer::KvCacheStorage::Int8Group64;
+        options.kv_capacity = ninfer::KvCapacityPolicy::explicit_capacity(1024);
+        options.kvmem = {.selected_tokens = 384, .reserve_tokens = 128,
+            .host_bytes = 512ULL << 20, .retained_sessions = 2, .verify_transfers = true};
+        options.context_cache.enabled = false;
+        std::vector<std::int32_t> reference;
+        {
+            ninfer::Engine engine(options);
+            const auto result = engine.submit(engine.prepare(prompt(false)), request(256)).wait();
+            reference.assign(result.generated_token_ids.begin(), result.generated_token_ids.end());
+        }
+        options.kvmem.host_bytes = 48ULL << 20;
+        options.kvmem.disk_bytes = 1024ULL << 20;
+        options.kvmem.disk_path = std::filesystem::temp_directory_path() /
+            ("ninfer-ssd-failure-" + std::to_string(std::chrono::steady_clock::now().time_since_epoch().count()));
+        WriteFailure failure;
+        {
+            ninfer::Engine engine(options);
+            Sink sink;
+            auto first = sink.first.get_future();
+            auto hot = engine.submit(engine.prepare(prompt(false)), request(256),
+                ninfer::OutputConsumerMode::Streaming, {.live_timings = true});
+            auto peer = std::async(std::launch::async, [hot = std::move(hot), &sink]() mutable { return hot.wait(&sink); });
+            require(first.wait_for(std::chrono::seconds(60)) == std::future_status::ready, "hot peer never started");
+            failure.arm();
+            bool failed = false;
+            try { (void)engine.submit(engine.prepare(prompt(true)), request(32)).wait(); }
+            catch (const std::exception& error) {
+                failed = true;
+                std::cout << "EXPECTED_STORAGE_FAILURE " << error.what() << std::endl;
+            }
+            require(failed && failure.count() == 1, "cold lane did not receive the injected write failure");
+            const auto survived = peer.get();
+            require(std::vector<std::int32_t>(survived.generated_token_ids.begin(), survived.generated_token_ids.end()) == reference,
+                    "storage failure changed the hot peer output");
+            require(engine.is_available(), "one storage failure disabled the Engine");
+            const auto recovered = engine.submit(engine.prepare(prompt(true)), request(32)).wait();
+            require(recovered.generated_token_ids.size() == 32 && engine.is_available(), "retry after storage failure did not complete");
+            const auto memory = engine.memory_summary().kvmem;
+            require(memory.disk_errors == 1 && memory.disk_written_bytes && memory.host_payload_bytes <= options.kvmem.host_bytes &&
+                    memory.disk_payload_bytes <= options.kvmem.disk_bytes && memory.resident_pages == 0,
+                    "failure recovery leaked quota/pages or lost I/O accounting");
+            std::cout << "SSD_FAILURE errors=" << memory.disk_errors << " peer_exact=1 retry=1" << std::endl;
+        }
+        {
+            ninfer::Engine engine(options);
+            Sink sink;
+            auto first = sink.first.get_future();
+            auto hot = engine.submit(engine.prepare(prompt(false)), request(512),
+                ninfer::OutputConsumerMode::Streaming, {.live_timings = true});
+            auto peer = std::async(std::launch::async, [hot = std::move(hot), &sink]() mutable { return hot.wait(&sink); });
+            require(first.wait_for(std::chrono::seconds(60)) == std::future_status::ready, "cancellation peer never started");
+            failure.arm(true);
+            std::atomic<bool> cancel{false};
+            auto cold = engine.submit(engine.prepare(prompt(true)), request(32));
+            auto cancelled = std::async(std::launch::async, [cold = std::move(cold), &cancel]() mutable {
+                return cold.wait(nullptr, ninfer::CancellationView([&] { return cancel.load(); }));
+            });
+            const bool blocked = failure.wait_entered();
+            const auto before = sink.generated.load();
+            cancel = true;
+            const auto deadline = std::chrono::steady_clock::now() + std::chrono::seconds(3);
+            while (sink.generated.load() < before + 8 && std::chrono::steady_clock::now() < deadline)
+                std::this_thread::sleep_for(std::chrono::milliseconds(5));
+            const auto advanced = sink.generated.load() - before;
+            failure.release(); // always unblock the worker before any assertion/cleanup
+            require(blocked && advanced >= 8, "cancelled slow storage job blocked the hot peer");
+            require(cancelled.get().finish_reason == ninfer::FinishReason::Cancelled,
+                    "cancelled storage lane did not settle as cancelled");
+            require(peer.get().generated_token_ids.size() == 512 && engine.is_available(),
+                    "storage cancellation damaged the peer or Engine");
+            std::cout << "SSD_CANCEL peer_tokens_while_io_blocked=" << advanced << " PASS" << std::endl;
+        }
+        require(std::filesystem::is_empty(options.kvmem.disk_path), "failure path leaked its spill file");
+        std::filesystem::remove(options.kvmem.disk_path);
+        std::cout << "SSD_FAILURE PASS" << std::endl;
+    } catch (const std::exception& error) { std::cerr << error.what() << '\n'; return 1; }
+}
+#else
+int main() { std::cout << "Windows import fault injection requires Windows; Linux OS failure coverage is in spill_io_test\n"; return 77; }
+#endif
diff --git a/tests/experimental/token_sums.cpp b/tests/experimental/token_sums.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..dd5f61073c604a3a2c0ea2b968be070cdcde4893
--- /dev/null
+++ b/tests/experimental/token_sums.cpp
@@ -0,0 +1,114 @@
+#include "ninfer/ops/token_sums.h"
+#include "ops/op_tester.h"
+#include <algorithm>
+#include <cmath>
+#include <iostream>
+#include <limits>
+#include <random>
+#include <vector>
+
+using namespace ninfer;
+using namespace ninfer::test;
+
+void check_case(int channels, int tokens, int first, int block, bool clipped, bool graph) {
+    std::mt19937 rng(913U + channels + tokens);
+    std::uniform_real_distribution<float> random(-4.0F, 4.0F);
+    std::vector<std::uint16_t> represented(static_cast<std::size_t>(channels) * tokens);
+    for (auto& value : represented) { value = f32_to_bf16(random(rng)); }
+    const auto buckets = block ? (tokens + 2 * block - 2) / block : 1;
+    auto x = to_device(represented);
+    auto origin_buffer = to_device(std::vector<int>{first});
+    auto range_buffer = to_device(std::vector<int>{0, 1000000});
+    DeviceBuffer result_buffer(static_cast<std::size_t>(channels) * buckets * sizeof(float));
+    Tensor input(x.p, DType::BF16, {channels, tokens});
+    Tensor origin(origin_buffer.p, DType::I32, {1});
+    Tensor range(range_buffer.p, DType::I32, {2});
+    Tensor output(result_buffer.p, DType::FP32, {channels, buckets});
+    cudaStream_t stream = nullptr;
+    cuda_check(cudaStreamCreate(&stream), "stream");
+    cudaGraph_t captured = nullptr;
+    cudaGraphExec_t executable = nullptr;
+    if (graph) {
+        cuda_check(cudaStreamBeginCapture(stream, cudaStreamCaptureModeGlobal), "capture begin");
+        ops::token_sums(input, origin, range, block, output, stream);
+        cuda_check(cudaStreamEndCapture(stream, &captured), "capture end");
+        cuda_check(cudaGraphInstantiate(&executable, captured, nullptr, nullptr, 0), "instantiate");
+    }
+    for (int replay = 0; replay < (graph ? 3 : 1); ++replay) {
+        // The original position changes across page boundaries without recapture.
+        const int start = first + replay * 37;
+        const int limits[] = {clipped ? start + 7 : start,
+                              clipped ? start + tokens - 13 : start + tokens};
+        origin_buffer.copy_from_host(&start, sizeof(start));
+        range_buffer.copy_from_host(limits, sizeof(limits));
+        if (graph) { cuda_check(cudaGraphLaunch(executable, stream), "graph launch"); }
+        else { ops::token_sums(input, origin, range, block, output, stream); }
+        cuda_check(cudaStreamSynchronize(stream), "sum completion");
+        const auto actual = from_device<float>(result_buffer, output.numel());
+        std::vector<double> expected(actual.size(), 0), absolute(actual.size(), 0);
+        // Independent oracle bins each represented input row by original position.
+        for (int row = tokens - 1; row >= 0; --row) {
+            const int position = start + row;
+            if (position < limits[0] || position >= limits[1]) { continue; }
+            const int bucket = block ? position / block - start / block : 0;
+            for (int channel = 0; channel < channels; ++channel) {
+                const double value = bf16_to_f32(represented[static_cast<std::size_t>(row) * channels + channel]);
+                const auto index = static_cast<std::size_t>(bucket) * channels + channel;
+                expected[index] += value;
+                absolute[index] += std::abs(value);
+            }
+        }
+        for (std::size_t i = 0; i < actual.size(); ++i) {
+            // FP32 summation forward-error bound from the represented BF16 inputs.
+            const double bound = 2.0 * tokens * std::numeric_limits<float>::epsilon() * absolute[i];
+            if (!std::isfinite(actual[i]) || std::abs(actual[i] - expected[i]) > std::max(1e-6, bound)) {
+                throw std::runtime_error("token_sums differs from the FP64 oracle");
+            }
+        }
+    }
+    if (executable) { cuda_check(cudaGraphExecDestroy(executable), "destroy graph executable"); }
+    if (captured) { cuda_check(cudaGraphDestroy(captured), "destroy graph"); }
+    cuda_check(cudaStreamDestroy(stream), "destroy stream");
+}
+
+int main(int argc, char** argv) {
+    try {
+        if (cuda_unavailable()) { return 77; }
+        int cases = 0;
+        if (argc == 2 && std::string(argv[1]) == "candidates") {
+            for (int channels : {512, 1024}) {
+                for (int tokens : {2, 4, 8, 12, 16, 32, 64}) {
+                    for (bool graph : {false, true}) {
+                        check_case(channels, tokens, 0, 1, false, graph);
+                        ++cases;
+                    }
+                }
+            }
+            std::cout << "TOKEN_SUMS_CANDIDATES PASS cases=" << cases << '\n';
+            return 0;
+        }
+        for (int channels : {512, 1024, 4096, 6144}) {
+            for (int tokens : {1, 63, 64, 65, 128, 511, 512, 513}) {
+                for (int first : {0, 63, 262000}) {
+                    for (int block : {0, 1, 64}) {
+                        for (bool clipped : {false, true}) {
+                            check_case(channels, tokens, first, block, clipped, false);
+                            ++cases;
+                        }
+                    }
+                }
+            }
+            check_case(channels, 65, 262000, 64, false, true);
+            check_case(channels, 65, 262000, 0, true, true);
+            for (int tokens : {1, 2, 3, 4}) {
+                check_case(channels, tokens, 63, 1, false, true);
+            }
+            cases += 6;
+        }
+        std::cout << "TOKEN_SUMS PASS cases=" << cases << '\n';
+        return 0;
+    } catch (const std::exception& error) {
+        std::cerr << "TOKEN_SUMS FAIL " << error.what() << '\n';
+        return 1;
+    }
+}
diff --git a/tests/host/test_checkpoint_residency.cpp b/tests/host/test_checkpoint_residency.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..3e658b4051d6380ad214c8b2909797f67ec75998
--- /dev/null
+++ b/tests/host/test_checkpoint_residency.cpp
@@ -0,0 +1,228 @@
+#include "models/qwen3_5/program/storage/checkpoint_buffer_cache.h"
+#include "models/qwen3_5/program/storage/checkpoint_residency.h"
+
+#include <algorithm>
+#include <atomic>
+#include <barrier>
+#include <cstdio>
+#include <cstring>
+#include <exception>
+#include <limits>
+#include <thread>
+#include <vector>
+
+#define CHECK(value) do { if (!(value)) throw std::runtime_error(#value); } while (false)
+
+namespace {
+using namespace ninfer::models::qwen3_5::detail;
+
+struct Image {
+    static inline std::atomic<unsigned> allocations = 0;
+    static inline std::atomic<unsigned> releases = 0;
+    static inline std::atomic<int> fail_after = -1;
+    explicit Image(std::size_t bytes) : bytes(bytes) {
+        const int remaining = fail_after.load();
+        if (remaining == 0) throw std::bad_alloc();
+        if (remaining > 0) --fail_after;
+        ++allocations;
+    }
+    ~Image() { ++releases; }
+    std::size_t size() const { return bytes.size(); }
+    void* data() { return bytes.data(); }
+    std::vector<std::byte> bytes;
+};
+using Pool = BoundedCheckpointBufferPool<Image>;
+using Cache = CheckpointBufferCache<Image>;
+
+template <class Exception, class Function>
+void expect_throw(Function&& function) {
+    bool threw = false;
+    try { function(); } catch (const Exception&) { threw = true; }
+    CHECK(threw);
+}
+
+void zero(Image& image) { std::memset(image.data(), 0, image.size()); }
+
+void configuration_and_capacity() {
+    CHECK(!checkpoint_resident_enabled(nullptr));
+    CHECK(!checkpoint_resident_enabled("0"));
+    CHECK(checkpoint_resident_enabled("1"));
+    for (const char* value : {"", "2", "01", "true", " 1", "1 "})
+        expect_throw<std::invalid_argument>([&] { (void)checkpoint_resident_enabled(value); });
+    CHECK(checkpoint_resident_capacity(1, 0, 5, 0) == 7);
+    CHECK(checkpoint_resident_capacity(1, 0, 5, 1) == 8);
+    CHECK(checkpoint_resident_capacity(3, 1, 5, 0) == 22);
+    CHECK(checkpoint_resident_capacity(3, 1, 5, 1) == 23);
+    CHECK(checkpoint_resident_capacity(8, 16, 5, 1) == 123);
+    expect_throw<std::invalid_argument>([] { (void)checkpoint_resident_capacity(0, 1, 5, 1); });
+    expect_throw<std::invalid_argument>([] { (void)checkpoint_resident_capacity(1, 1, 0, 1); });
+    constexpr auto max = std::numeric_limits<std::size_t>::max();
+    expect_throw<std::overflow_error>([&] { (void)checkpoint_resident_capacity(1, max, 5, 1); });
+    expect_throw<std::overflow_error>([&] { (void)checkpoint_resident_capacity(1, 0, 5, max); });
+    expect_throw<std::overflow_error>([&] { (void)checkpoint_resident_capacity(max, 0, 5, 0); });
+    expect_throw<std::invalid_argument>([] { (void)std::make_shared<Pool>(2, 0); });
+    expect_throw<std::invalid_argument>([&] { (void)std::make_shared<Pool>(2, max); });
+}
+
+void default_off() {
+    const auto allocations = Image::allocations.load();
+    auto cache = std::make_shared<Cache>();
+    CHECK(!cache->resident() && cache->idle_bytes() == 0);
+    CHECK(Image::allocations == allocations); // Disabled mode does not preallocate.
+    auto first = cache->acquire(4096);
+    auto second = cache->acquire(4096);
+    CHECK(first->data() != second->data());
+    auto alias = first;
+    const auto address = first->data();
+    first.reset();
+    CHECK(cache->idle_bytes() == 0);
+    alias.reset();
+    CHECK(cache->idle_bytes() == 4096);
+    first = cache->acquire(4096);
+    CHECK(first->data() == address);
+    std::memset(second->data(), 23, second->size());
+    std::memset(first->data(), 29, first->size());
+    CHECK(std::all_of(second->bytes.begin(), second->bytes.end(),
+                      [](auto value) { return value == std::byte{23}; }));
+    first.reset(); second.reset();
+    CHECK(cache->idle_bytes() == 8192);
+    auto different_layout = cache->acquire(8192);
+    different_layout.reset();
+    CHECK(cache->idle_bytes() == 8192); // Third release still retires at capacity two.
+    cache->close_resident();
+    CHECK(cache->idle_bytes() == 8192); // Closing resident mode does not change OFF.
+    auto held = cache->acquire(4096);
+    std::weak_ptr<Cache> lifetime = cache;
+    cache.reset();
+    CHECK(!lifetime.expired());
+    std::memset(held->data(), 31, held->size());
+    held.reset();
+    CHECK(lifetime.expired());
+}
+
+void working_set_reuse_and_fallback() {
+    auto cache = std::make_shared<Cache>();
+    const auto allocations = Image::allocations.load();
+    const auto releases = Image::releases.load();
+    cache->prepare_resident(23, 4096, zero);
+    CHECK(cache->resident() && cache->idle_bytes() == 23 * 4096);
+    CHECK(Image::allocations == allocations + 23);
+    for (unsigned round = 0; round < 100; ++round) {
+        std::vector<std::shared_ptr<Image>> held;
+        for (unsigned i = 0; i < 23; ++i) {
+            auto image = cache->acquire(4096);
+            std::memset(image->data(), i, image->size());
+            held.push_back(std::move(image));
+        }
+        for (unsigned i = 0; i < 23; ++i)
+            CHECK(std::all_of(held[i]->bytes.begin(), held[i]->bytes.end(),
+                              [i](auto value) { return value == std::byte(i); }));
+        auto alias = held.front();
+        held.clear();
+        CHECK(cache->idle_bytes() == 22 * 4096);
+        CHECK(alias->bytes.front() == std::byte{0});
+    }
+    CHECK(Image::allocations == allocations + 23 && Image::releases == releases);
+    std::vector<std::shared_ptr<Image>> held;
+    for (unsigned i = 0; i < 24; ++i) held.push_back(cache->acquire(4096));
+    CHECK(Image::allocations == allocations + 24); // Overflow allocates; no live lease is stolen.
+    for (unsigned i = 0; i < held.size(); ++i)
+        for (unsigned j = i + 1; j < held.size(); ++j) CHECK(held[i]->data() != held[j]->data());
+    held.clear();
+    CHECK(cache->idle_bytes() == 23 * 4096);
+    CHECK(Image::releases == releases + 1);
+    expect_throw<std::invalid_argument>([&] { (void)cache->acquire(8192); });
+    auto last = cache->acquire(4096);
+    cache->close_resident();
+    cache->close_resident(); // Idempotent shutdown, independent of final lease lifetime.
+    CHECK(cache->idle_bytes() == 0 && last->size() == 4096);
+    CHECK(Image::releases == releases + 23);
+    cache.reset();
+    std::memset(last->data(), 17, last->size());
+    last.reset();
+    CHECK(Image::releases == releases + 24);
+}
+
+void prewarm_failure_and_bounds() {
+    auto pool = std::make_shared<Pool>(4, 4096);
+    expect_throw<std::invalid_argument>([&] { pool->prewarm(5, zero); });
+    CHECK(pool->statistics().misses == 0);
+    unsigned touched = 0;
+    expect_throw<std::runtime_error>([&] {
+        pool->prewarm(4, [&](Image&) {
+            if (++touched == 3) throw std::runtime_error("injected touch failure");
+        });
+    });
+    CHECK(pool->statistics().cached == 3);
+    pool->close();
+
+    auto cache = std::make_shared<Cache>();
+    touched = 0;
+    const auto live = Image::allocations.load() - Image::releases.load();
+    expect_throw<std::runtime_error>([&] {
+        cache->prepare_resident(4, 4096, [&](Image&) {
+            if (++touched == 3) throw std::runtime_error("injected touch failure");
+        });
+    });
+    CHECK(!cache->resident() && cache->idle_bytes() == 0);
+    CHECK(Image::allocations.load() - Image::releases.load() == live);
+    Image::fail_after = 2;
+    expect_throw<std::bad_alloc>([&] { cache->prepare_resident(4, 4096, zero); });
+    Image::fail_after = -1;
+    CHECK(!cache->resident() && Image::allocations.load() - Image::releases.load() == live);
+    expect_throw<std::invalid_argument>([&] { cache->prepare_resident(0, 4096, zero); });
+    cache->prepare_resident(4, 4096, zero); // Failed preparation leaves no half-published pool.
+    expect_throw<std::logic_error>([&] { cache->prepare_resident(4, 4096, zero); });
+}
+
+void concurrent_return_and_shutdown() {
+    auto cache = std::make_shared<Cache>();
+    cache->prepare_resident(23, 4096, zero);
+    const auto allocations = Image::allocations.load();
+    std::atomic<unsigned> failures = 0;
+    std::barrier start(8);
+    std::vector<std::thread> threads;
+    for (unsigned worker = 0; worker < 8; ++worker) {
+        threads.emplace_back([&, worker] {
+            start.arrive_and_wait();
+            for (unsigned round = 0; round < 500; ++round) {
+                try {
+                    auto image = cache->acquire(4096);
+                    auto alias = image;
+                    image.reset();
+                    std::memset(alias->data(), worker, alias->size());
+                    if (!std::all_of(alias->bytes.begin(), alias->bytes.end(),
+                                     [worker](auto value) { return value == std::byte(worker); }))
+                        ++failures;
+                } catch (...) { ++failures; }
+            }
+        });
+    }
+    for (auto& thread : threads) thread.join();
+    CHECK(failures == 0 && Image::allocations == allocations);
+    CHECK(cache->idle_bytes() == 23 * 4096);
+    threads.clear();
+    std::barrier finishing(9);
+    for (unsigned worker = 0; worker < 8; ++worker) {
+        auto lease = cache->acquire(4096);
+        threads.emplace_back([&, lease = std::move(lease)] {
+            finishing.arrive_and_wait();
+            std::memset(lease->data(), 17, lease->size());
+        });
+    }
+    finishing.arrive_and_wait();
+    cache->close_resident(); // Races returns, never accesses their live storage.
+    for (auto& thread : threads) thread.join();
+    CHECK(cache->idle_bytes() == 0);
+}
+} // namespace
+
+int main() {
+    configuration_and_capacity();
+    default_off();
+    working_set_reuse_and_fallback();
+    prewarm_failure_and_bounds();
+    concurrent_return_and_shutdown();
+    CHECK(Image::allocations == Image::releases);
+    std::puts("PASS: checkpoint residency configuration, disabled path, independent leases, bounded fallback, prewarm cleanup, concurrent return and shutdown");
+}
diff --git a/tests/host/test_prefill_service_work.cpp b/tests/host/test_prefill_service_work.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..9a1eb9dc784330f343c780a33fd5789b7b47ef72
--- /dev/null
+++ b/tests/host/test_prefill_service_work.cpp
@@ -0,0 +1,79 @@
+#include "models/qwen3_5/program/planning/prefill_service_work.h"
+
+#include <algorithm>
+#include <cstdint>
+#include <iostream>
+#include <stdexcept>
+
+using ninfer::models::qwen3_5::detail::initial_mtp_prefill_extent;
+using ninfer::models::qwen3_5::detail::prefill_service_units;
+
+namespace {
+void require(bool value, const char* message) {
+    if (!value) throw std::runtime_error(message);
+}
+
+// Independent step-by-step execution model: stop at the next grid boundary,
+// leave proposal space at the prompt end, and yield at an offered capture.
+std::uint64_t executed(std::uint32_t cursor, std::uint32_t end, std::uint32_t chunk,
+                       std::uint32_t reserve, std::uint32_t extent, std::uint32_t capture) {
+    std::uint64_t units = 0;
+    while (cursor < end) {
+        auto count = reserve ? chunk - cursor % chunk : chunk;
+        if (reserve && end - cursor <= count)
+            count = std::min(count, reserve - (extent ? extent - 1U : 0U));
+        count = std::min(count, end - cursor);
+        if (capture > cursor) count = std::min(count, capture - cursor);
+        require(count != 0, "prefill made no progress");
+        cursor += count;
+        ++units;
+    }
+    return units;
+}
+}
+
+int main() {
+    try {
+        require(initial_mtp_prefill_extent(4, 129, 4096, 1919) == 4, "MTP extent");
+        require(initial_mtp_prefill_extent(4, 2, 4096, 1919) == 0, "short output extent");
+        require(initial_mtp_prefill_extent(15, 129, 4096, 4095) == 0, "context edge extent");
+        require(initial_mtp_prefill_extent(15, 129, 4096, 4092) == 3, "context clipping");
+        require(prefill_service_units(0, 1919, 128, 128, 4) == 16,
+                "1919-token prompt needs 16 service units, not 15");
+        require(prefill_service_units(0, 125, 128, 128, 4) == 1 &&
+                prefill_service_units(0, 126, 128, 128, 4) == 2 &&
+                prefill_service_units(0, 128, 128, 128, 4) == 2,
+                "MTP tail split boundary");
+        require(prefill_service_units(0, 1919, 128, 256, 4) == 15,
+                "roomy reserve should not split the tail");
+        require(prefill_service_units(63, 129, 128, 128) == 2,
+                "reused/query suffix must retain canonical boundaries");
+        for (std::uint32_t chunk : {128U, 256U}) {
+            for (std::uint32_t reserve : {0U, chunk, chunk + 64U}) {
+                for (std::uint32_t extent : {0U, 1U, 4U, 15U}) {
+                    for (std::uint32_t end = 1; end <= 3 * chunk; ++end) {
+                        for (std::uint32_t begin : {0U, end / 2, end - 1U}) {
+                            const auto projected = prefill_service_units(begin, end, chunk, reserve, extent);
+                            require(projected == executed(begin, end, chunk, reserve, extent, 0),
+                                    "projection disagrees with worker-visible steps");
+                            for (std::uint32_t capture : {begin + 1U, (begin + end) / 2, end - 1U}) {
+                                if (capture <= begin || capture >= end) continue;
+                                const auto with_capture =
+                                    prefill_service_units(begin, capture, chunk, reserve) +
+                                    prefill_service_units(capture, end, chunk, reserve) + projected -
+                                    prefill_service_units(begin, end, chunk, reserve);
+                                require(with_capture >= executed(begin, end, chunk, reserve, extent, capture),
+                                        "capture before prompt end exhausted the service budget");
+                            }
+                        }
+                    }
+                }
+            }
+        }
+        std::cout << "PREFILL_SERVICE_WORK PASS\n";
+        return 0;
+    } catch (const std::exception& error) {
+        std::cerr << error.what() << '\n';
+        return 1;
+    }
+}
diff --git a/tests/models/qwen3_5/test_checkpoint_buffer_pool.cpp b/tests/models/qwen3_5/test_checkpoint_buffer_pool.cpp
