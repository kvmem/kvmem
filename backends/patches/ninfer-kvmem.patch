index 0000000000000000000000000000000000000000..8c2df7dbbffd7ded3b86a92b1117b5562d3335de
--- /dev/null
+++ b/src/models/qwen3_5/program/storage/bounded_checkpoint_buffer_pool.h
@@ -0,0 +1,117 @@
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <limits>
+#include <memory>
+#include <mutex>
+#include <stdexcept>
+#include <utility>
+#include <vector>
+
+namespace ninfer::models::qwen3_5::detail {
+
+// A free-list bound, not a limit on live checkpoints. A lease must remain alive
+// until every CPU/GPU transfer using it completes; the pool invents no fence.
+// Only the last shared reference returns a buffer, and every buffer has exactly
+// the fixed image size of its owning Program. Prewarming is explicit and runs
+// before the Program is exposed to requests.
+template <class Buffer>
+class BoundedCheckpointBufferPool final
+    : public std::enable_shared_from_this<BoundedCheckpointBufferPool<Buffer>> {
+public:
+    struct Statistics {
+        std::uint64_t hits = 0, misses = 0, returns = 0, retired = 0;
+        std::size_t cached = 0, cached_bytes = 0, high_water_cached_bytes = 0;
+        bool closed = false;
+    };
+
+    BoundedCheckpointBufferPool(std::size_t capacity, std::size_t image_bytes)
+        : capacity_(capacity), image_bytes_(image_bytes) {
+        if (image_bytes == 0 || (capacity && image_bytes > std::numeric_limits<std::size_t>::max()/capacity))
+            throw std::invalid_argument("checkpoint free-list capacity overflow or empty image");
+        free_.reserve(capacity);
+    }
+
+    std::shared_ptr<Buffer> acquire(std::size_t bytes) {
+        if (bytes != image_bytes_) throw std::invalid_argument("checkpoint free-list image layout changed");
+        auto owner = this->shared_from_this();
+        std::unique_ptr<Buffer> value;
+        {
+            std::lock_guard lock(mutex_);
+            if (!free_.empty()) {
+                value = std::move(free_.back());
+                free_.pop_back();
+                ++statistics_.hits;
+            } else {
+                ++statistics_.misses;
+            }
+        }
+        if (!value) value = std::make_unique<Buffer>(image_bytes_);
+        // If shared_ptr's control-block allocation throws, it invokes this
+        // deleter; the buffer is still returned or retired without a leak.
+        return std::shared_ptr<Buffer>(value.release(), [owner = std::move(owner)](Buffer* pointer) noexcept {
+            owner->release(std::unique_ptr<Buffer>(pointer));
+        });
+    }
+
+    // All leases are held together so no prewarmed image can be reacquired
+    // during preparation. Touch is explicit because allocation alone need not
+    // fault every page in. Call only before the Program is exposed to requests.
+    template <class Touch>
+    void prewarm(std::size_t count, Touch&& touch) {
+        if (count > capacity_) throw std::invalid_argument("checkpoint prewarm exceeds cache capacity");
+        std::vector<std::shared_ptr<Buffer>> held;
+        held.reserve(count);
+        for (std::size_t i=0;i<count;++i) {
+            held.push_back(acquire(image_bytes_));
+            touch(*held.back());
+        }
+    }
+
+    void close() noexcept {
+        std::vector<std::unique_ptr<Buffer>> retired;
+        {
+            std::lock_guard lock(mutex_);
+            statistics_.closed = true;
+            statistics_.retired += free_.size();
+            retired.swap(free_);
+        }
+        // Potentially expensive pin destruction occurs outside the mutex.
+        // Leases still held by callers remain valid; later returns cannot cache.
+    }
+
+    Statistics statistics() const {
+        std::lock_guard lock(mutex_);
+        auto result = statistics_;
+        result.cached = free_.size();
+        result.cached_bytes = free_.size()*image_bytes_;
+        return result;
+    }
+
+private:
+    void release(std::unique_ptr<Buffer> value) noexcept {
+        try {
+            std::lock_guard lock(mutex_);
+            ++statistics_.returns;
+            if (!statistics_.closed && free_.size() < capacity_) {
+                free_.push_back(std::move(value)); // capacity reserved before any lease is issued.
+                const auto bytes = free_.size()*image_bytes_;
+                if (bytes > statistics_.high_water_cached_bytes)
+                    statistics_.high_water_cached_bytes = bytes;
+                return;
+            }
+            ++statistics_.retired;
+        } catch (...) {
+            // A deleter cannot throw into checkpoint/history destruction. The
+            // still-owned buffer is retired normally outside the lock instead.
+        }
+    }
+
+    const std::size_t capacity_, image_bytes_;
+    mutable std::mutex mutex_;
+    std::vector<std::unique_ptr<Buffer>> free_;
+    Statistics statistics_;
+};
+
+} // namespace ninfer::models::qwen3_5::detail
diff --git a/src/models/qwen3_5/program/storage/checkpoint_buffer_cache.h b/src/models/qwen3_5/program/storage/checkpoint_buffer_cache.h
new file mode 100644
index 0000000000000000000000000000000000000000..50fcd44cbdd5cb5e512627785fd0175dcfd35bdd
--- /dev/null
+++ b/src/models/qwen3_5/program/storage/checkpoint_buffer_cache.h
@@ -0,0 +1,68 @@
+#pragma once
+
+#include "models/qwen3_5/program/storage/bounded_checkpoint_buffer_pool.h"
+
+#include <array>
+#include <memory>
+#include <mutex>
+
+namespace ninfer::models::qwen3_5::detail {
+
+// The default branch intentionally retains the original two-entry cache,
+// including size-matched reuse. Resident mode is prepared before publication.
+template <class Buffer>
+class CheckpointBufferCache : public std::enable_shared_from_this<CheckpointBufferCache<Buffer>> {
+public:
+    template <class Touch>
+    void prepare_resident(std::size_t capacity, std::size_t image_bytes, Touch&& touch) {
+        if (!capacity) throw std::invalid_argument("empty checkpoint resident capacity");
+        if (resident_ || idle_[0] || idle_[1])
+            throw std::logic_error("checkpoint residency must be prepared before use");
+        auto resident = std::make_shared<BoundedCheckpointBufferPool<Buffer>>(capacity, image_bytes);
+        resident->prewarm(capacity, std::forward<Touch>(touch));
+        resident_ = std::move(resident); // Publish only a completely prepared pool.
+    }
+
+    bool resident() const noexcept { return bool(resident_); }
+
+    std::shared_ptr<Buffer> acquire(std::size_t bytes) {
+        if (resident_) return resident_->acquire(bytes);
+        auto pool = this->shared_from_this();
+        std::unique_ptr<Buffer> buffer;
+        {
+            std::lock_guard lock(mutex_);
+            for (auto& idle : idle_) if (idle && idle->size() == bytes) {
+                buffer = std::move(idle); break;
+            }
+        }
+        if (!buffer) buffer = std::make_unique<Buffer>(bytes);
+        return {buffer.release(), [pool = std::move(pool)](Buffer* value) noexcept {
+            std::unique_ptr<Buffer> released(value);
+            try {
+                std::lock_guard lock(pool->mutex_);
+                for (auto& idle : pool->idle_) if (!idle) {
+                    idle = std::move(released); break;
+                }
+            } catch (...) {} // Releasing a checkpoint must remain noexcept.
+        }};
+    }
+
+    std::size_t idle_bytes() const {
+        if (resident_) return resident_->statistics().cached_bytes;
+        std::lock_guard lock(mutex_);
+        std::size_t bytes = 0;
+        for (const auto& idle : idle_) if (idle) bytes += idle->size();
+        return bytes;
+    }
+
+    // Called only after the Program has synchronized its streams. Outstanding
+    // worker/transfer leases remain valid and retire when their last owner exits.
+    void close_resident() noexcept { if (resident_) resident_->close(); }
+
+private:
+    mutable std::mutex mutex_;
+    std::array<std::unique_ptr<Buffer>, 2> idle_;
+    std::shared_ptr<BoundedCheckpointBufferPool<Buffer>> resident_;
+};
+
+} // namespace ninfer::models::qwen3_5::detail
