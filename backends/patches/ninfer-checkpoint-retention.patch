+std::optional<std::uint64_t> ProgramImpl::oldest_retained_checkpoint(std::optional<std::uint32_t> hot_limit) const {
+    struct Point { std::uint64_t used = 0; bool pinned = false; };
+    std::unordered_map<std::uint64_t, Point> points;
+    for (std::size_t i = 0; i < memory_histories.size(); ++i) {
+        if (!memory_histories[i]) continue;
+        const bool pinned = retained_history_pinned(i);
+        visit_memory_checkpoints(*memory_histories[i], [&](const auto& cp) {
+            // Byte pressure can reclaim an old cold manifest before a newer hot
+            // point. An explicit count limit applies only to hot native images.
+            if (!cp.state && (hot_limit || !cp.cold_state)) return;
+            auto& point = points[cp.immutable_origin];
+            point.used = std::max(point.used, cp.last_used);
+            point.pinned |= pinned;
+        });
+    }
+    if (points.size() <= hot_limit.value_or(0)) return {};
+    auto oldest = points.end();
+    for (auto it = points.begin(); it != points.end(); ++it)
+        if (!it->second.pinned && (oldest == points.end() ||
+            std::tie(it->second.used, it->first) < std::tie(oldest->second.used, oldest->first))) oldest = it;
+    if (oldest == points.end()) return {};
+    return oldest->first;
+}
