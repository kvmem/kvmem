+        ++s->window_epoch;
+        s->window_floor = frontier;
+    }
+    s->full_offset = offset;
+    s->sparse_anchor = frontier;
+    s->n_tokens = frontier;
+    s->canonical = !restoring && s->canonical && offset == 0;
+    return RAD_OK;
+}
