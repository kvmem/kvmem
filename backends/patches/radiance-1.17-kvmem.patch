+int KVManager::mirror_adapter_metadata(const KVManager& leader) {
+    if (&leader == this) return RAD_OK;
+    if (!configured_ || !leader.configured_ || plans_.size() != leader.plans_.size() ||
+        max_seqs_ != leader.max_seqs_ || max_ctx_ != leader.max_ctx_ ||
+        loan_ != leader.loan_ || live_ != leader.live_ ||
+        bucket_blocks_ != leader.bucket_blocks_ || chunk_blocks_ != leader.chunk_blocks_)
+        return RAD_E_INVAL;
+    for (size_t i = 0; i < plans_.size(); ++i) {
+        const auto& a = plans_[i]; const auto& b = leader.plans_[i];
+        if (a.index != b.index || a.kind != b.kind || a.zero != b.zero ||
+            a.n_layers != b.n_layers || a.block_size != b.block_size || a.n_blocks != b.n_blocks ||
+            a.n_states != b.n_states || a.state_copies != b.state_copies ||
+            a.window_blocks != b.window_blocks || a.bytes_per_block != b.bytes_per_block ||
+            a.bytes_per_state != b.bytes_per_state) return RAD_E_INVAL;
+    }
+    try {
+        auto blocks = leader.free_blocks_;
+        auto refs = leader.refcount_;
+        auto cached = leader.cached_;
+        auto cache_only = leader.cache_only_;
+        auto states = leader.free_states_;
+        auto sequences = leader.seqs_;
+        auto peak = leader.short_peak_;
+        auto usable = leader.free_usable_;
+        auto held = leader.held_hist_;
+        // Every potentially throwing copy finished before publication. The
+        // destination's native pools and recurrent/KV bytes remain untouched.
+        free_blocks_.swap(blocks); refcount_.swap(refs); cached_.swap(cached);
+        cache_only_.swap(cache_only); free_states_.swap(states); seqs_.swap(sequences);
+        short_peak_.swap(peak); free_usable_.swap(usable); held_hist_.swap(held);
+        seq_frees_ = leader.seq_frees_;
+        pending_.clear(); clears_.clear();
+        return RAD_OK;
+    } catch (const std::bad_alloc&) { return RAD_E_NOMEM; }
+}
