+      dim3(1,heads,1), dim3(RU_V*2), 0, stream, nullptr, nullptr, nullptr, nullptr, nullptr, 0, \
+      nullptr, nullptr, (ru_state<SDT>::T*)state, ss, sh, nullptr, nullptr, nullptr, 0, 0, \
+      meta, meta+2, 6, meta+8, nullptr, 0, nullptr, 0.0f, 0, heads, heads, 1.0f, 20.0f, RuConv{})
+    if (fp16) { MATERIALIZE(1); } else { MATERIALIZE(0); }
+#undef MATERIALIZE
+    if (hipGetLastError() != hipSuccess) status = -5;
