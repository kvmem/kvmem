+namespace rad {
+extern "C" int rad_diag_clock_stamp(void*,int,void*);
+#include "hip_pass_span.h"
+#include "hip_small_d2h.h"
+struct OpClockProbe {
+    static constexpr int capacity = 4096;
+    unsigned long long* ticks = nullptr;
+    int khz = 0, count = 0;
+    bool active = false, used = false;
+    struct Entry { unsigned op; std::string name, kernel; int64_t m, n, k; };
+    std::vector<Entry> entries;
+    ~OpClockProbe() { if(ticks) hipFree(ticks); }
+};
+static thread_local OpClockProbe op_clock;
+// Diagnostic only: one main pass, completed host wall clocks, no marker kernels
+// or extra device allocation. Synchronization changes overlap, so this is not
+// uninstrumented serving throughput. Keep the failed marker method separate.
+struct OpWallProbe {
+    bool active=false, used=false;
+    std::chrono::steady_clock::time_point start;
+    struct Entry { unsigned op; std::string name, kernel; double us; };
+    std::vector<Entry> entries;
+};
+static thread_local OpWallProbe op_wall;
+static int hip_op_wall_pass(bool begin,int step,int64_t tokens,int draft,RadStream stream) {
+    static const bool enabled=[] {const char* p=std::getenv("RADIANCE_HIP_OP_WALL");return p&&p[0]=='1';}();
+    if(!enabled)return RAD_OK;
+    auto& w=op_wall;
+    if(begin){
+        w.active=false;
+        if(w.used||step!=20||tokens!=4||draft!=0)return RAD_OK;
+        if(std::getenv("RADIANCE_HIP_OP_CLOCK"))return RAD_E_INVAL;
+        if(hipStreamSynchronize(reinterpret_cast<hipStream_t>(stream))!=hipSuccess)return RAD_E_DEVICE;
+        w.entries.reserve(4096);w.used=true;w.active=true;
+    }else if(w.active){
+        w.active=false;
+        fprintf(stderr,"HIP_OP_WALL_BEGIN step=%d entries=%zu\n",step,w.entries.size());
+        for(const auto& e:w.entries)fprintf(stderr,"HIP_OP_WALL op=%u name=%s kernel=%s completed_us=%.3f\n",e.op,e.name.c_str(),e.kernel.c_str(),e.us);
+        fprintf(stderr,"HIP_OP_WALL_END step=%d\n",step);
+    }
+    return RAD_OK;
+}
+int hip_op_clock_issue(bool begin,unsigned op,const char* name,const char* kernel,
+                       const RadArgs* args,RadStream stream) {
+    if(op_wall.active){
+        auto& w=op_wall;
+        if(begin){
+            if(w.entries.size()>=4096)return RAD_E_FULL;
+            if(hipStreamSynchronize(reinterpret_cast<hipStream_t>(stream))!=hipSuccess)return RAD_E_DEVICE;
+            w.entries.push_back({op,name?name:"?",kernel?kernel:"?",0});
+            w.start=std::chrono::steady_clock::now();
+        }else{
+            if(w.entries.empty())return RAD_E_STATE;
+            if(hipStreamSynchronize(reinterpret_cast<hipStream_t>(stream))!=hipSuccess)return RAD_E_DEVICE;
+            w.entries.back().us=std::chrono::duration<double,std::micro>(std::chrono::steady_clock::now()-w.start).count();
+        }
+        return RAD_OK;
+    }
+    auto& c=op_clock;
+    if(!c.active)return RAD_OK;
+    if(begin) {
+        if(c.count>=OpClockProbe::capacity)return RAD_E_FULL;
+        int64_t m=0,n=0,k=0;
+        if(args&&args->n_t>0&&args->t[0].rank==2){m=args->t[0].shape[0];k=args->t[0].shape[1];}
+        if(args&&args->n_t>4&&args->t[4].rank==2)n=args->t[4].shape[1];
+        c.entries.push_back({op,name?name:"?",kernel?kernel:"?",m,n,k});
+    }
+    const int rc=rad_diag_clock_stamp(c.ticks,2+c.count*2+(begin?0:1),stream);
+    if(!begin)++c.count;
+    return rc;
+}
+static int hip_op_clock_pass(bool begin,int step,int64_t tokens,int draft,RadStream stream) {
+    static const bool enabled=[] {const char* p=std::getenv("RADIANCE_HIP_OP_CLOCK");return p&&p[0]=='1';}();
+    if(!enabled)return RAD_OK;
+    auto& c=op_clock;
+    if(begin) {
+        c.active=false;
+        if(c.used||step!=20||tokens!=4||draft!=0)return RAD_OK;
+        if(hipDeviceGetAttribute(&c.khz,hipDeviceAttributeWallClockRate,0)!=hipSuccess||c.khz<=0)return RAD_E_DEVICE;
+        if(hipMalloc(&c.ticks,(2+2*OpClockProbe::capacity)*sizeof(unsigned long long))!=hipSuccess)return RAD_E_NOMEM;
+        c.entries.reserve(OpClockProbe::capacity);c.count=0;c.used=true;c.active=true;
+        if(rad_diag_clock_stamp(c.ticks,0,stream)<0||rad_diag_clock_stamp(c.ticks,1,stream)<0)return RAD_E_DEVICE;
+        return RAD_OK;
+    }
+    if(!c.active)return RAD_OK;
+    c.active=false;
+    if(hipStreamSynchronize(reinterpret_cast<hipStream_t>(stream))!=hipSuccess)return RAD_E_DEVICE;
+    std::vector<unsigned long long> t(2+c.count*2);
+    if(hipMemcpy(t.data(),c.ticks,t.size()*sizeof(t[0]),hipMemcpyDeviceToHost)!=hipSuccess)return RAD_E_DEVICE;
+    if(t[1]<t[0])return RAD_E_STATE;
+    std::fprintf(stderr,"HIP_OP_CLOCK_BEGIN step=%d entries=%d khz=%d blank_us=%.3f\n",step,c.count,c.khz,double(t[1]-t[0])*1000/c.khz);
+    for(int i=0;i<c.count;i++) {
+        if(t[3+i*2]<t[2+i*2])return RAD_E_STATE;
+        auto& e=c.entries[i];
+        std::fprintf(stderr,"HIP_OP_CLOCK op=%u name=%s kernel=%s m=%lld n=%lld k=%lld steady_us=%.3f\n",e.op,e.name.c_str(),e.kernel.c_str(),(long long)e.m,(long long)e.n,(long long)e.k,double(t[3+i*2]-t[2+i*2])*1000/c.khz);
+    }
+    std::fprintf(stderr,"HIP_OP_CLOCK_END step=%d\n",step);
+    return RAD_OK;
+}
+// Bounded, opt-in pass timing. Two events per forward pass, no extra wait,
+// no per-op events, no changed ordering. GPU spans include any supply gaps;
+// they are NOT the sum of kernel execution times. Sample decode-sized passes.
+int hip_pass_timing(bool begin, int step, int64_t tokens, int draft, RadStream stream) {
+    const int span_rc=hip_pass_span(begin,step,tokens,draft,stream);
+    if(span_rc<0)return span_rc;
+    const int wall_rc=hip_op_wall_pass(begin,step,tokens,draft,stream);
+    if(wall_rc<0)return wall_rc;
+    const int clock_rc=hip_op_clock_pass(begin,step,tokens,draft,stream);
+    if(clock_rc<0)return clock_rc;
+    static const bool wall=[] {const char* p=std::getenv("RADIANCE_HIP_PASS_WALL");return p&&p[0]=='1';}();
+    if(wall&&tokens>=1&&tokens<=4){
+        // Diagnostic ONLY: synchronized wall clock bypasses unreliable PAL event
+        // timestamps. This deliberately removes overlap, not a serving change.
+        static thread_local std::chrono::steady_clock::time_point start;
+        static thread_local double drain_us=0;
+        auto s=reinterpret_cast<hipStream_t>(stream);
+        if(begin){auto t=std::chrono::steady_clock::now();if(hipStreamSynchronize(s)!=hipSuccess)return RAD_E_DEVICE;start=std::chrono::steady_clock::now();drain_us=std::chrono::duration<double,std::micro>(start-t).count();}
+        else {if(hipStreamSynchronize(s)!=hipSuccess)return RAD_E_DEVICE;double ms=std::chrono::duration<double,std::milli>(std::chrono::steady_clock::now()-start).count();
+            std::fprintf(stderr,"HIP_PASS_WALL step=%d tokens=%lld draft=%d forward_ms=%.6f preceding_drain_us=%.3f\n",step,(long long)tokens,draft,ms,drain_us);}
+        return RAD_OK;
+    }
+    static const bool enabled=[] {const char* p=std::getenv("RADIANCE_HIP_PASS_TIMING");return p&&p[0]=='1';}();
+    if(!enabled||tokens<1||tokens>4)return RAD_OK;
+    struct Slot {hipEvent_t a=nullptr,b=nullptr;bool pending=false;int step=0,draft=0;int64_t tokens=0;double cpu_us=0;std::chrono::steady_clock::time_point start;};
+    struct Ring {Slot slots[32];int next=0,active=-1;bool initialized=false;
+        ~Ring(){for(auto& s:slots){if(s.a)hipEventDestroy(s.a);if(s.b)hipEventDestroy(s.b);}}};
+    static thread_local Ring ring;
+    auto s=reinterpret_cast<hipStream_t>(stream);
+    if(begin){
+        if(!ring.initialized){for(auto& q:ring.slots)if(hipEventCreate(&q.a)!=hipSuccess||hipEventCreate(&q.b)!=hipSuccess)return RAD_E_DEVICE;ring.initialized=true;}
+        for(auto& q:ring.slots)if(q.pending){
+            auto rc=hipEventQuery(q.b);if(rc==hipErrorNotReady)continue;if(rc!=hipSuccess)return RAD_E_DEVICE;
+            float ms=0;if(hipEventElapsedTime(&ms,q.a,q.b)!=hipSuccess)return RAD_E_DEVICE;
+            std::fprintf(stderr,"HIP_PASS_TIMING step=%d tokens=%lld draft=%d gpu_ms=%.6f submit_us=%.3f\n",q.step,(long long)q.tokens,q.draft,(double)ms,q.cpu_us);q.pending=false;
+        }
+        auto& q=ring.slots[ring.next];ring.active=-1;
+        if(q.pending){std::fprintf(stderr,"HIP_PASS_TIMING skipped_full_ring\n");return RAD_OK;}
+        q.step=step;q.tokens=tokens;q.draft=draft;
+        if(hipEventRecord(q.a,s)!=hipSuccess)return RAD_E_DEVICE;
+        q.start=std::chrono::steady_clock::now();ring.active=ring.next;ring.next=(ring.next+1)%32;
+    }else if(ring.active>=0){
+        auto& q=ring.slots[ring.active];q.cpu_us=std::chrono::duration<double,std::micro>(std::chrono::steady_clock::now()-q.start).count();
