+// Diagnostic: two clock stamps per sampled pass, asynchronous readback, no
+// per-operation marker or extra wait. GPU interval includes any supply gaps.
+static int hip_pass_span(bool begin,int step,int64_t tokens,int draft,RadStream stream) {
+    static const bool enabled=std::getenv("RADIANCE_HIP_PASS_SPAN")!=nullptr;
+    if(!enabled)return RAD_OK;
+    struct Slot { hipEvent_t ready=nullptr; int step=0,draft=0; int64_t tokens=0; bool pending=false; double submit_us=0; };
+    struct Probe {
+        unsigned long long *device=nullptr,*host=nullptr;
+        Slot slots[32]; int count=0,active=-1,khz=0;
+        std::chrono::steady_clock::time_point submitted;
+        ~Probe(){ for(auto& s:slots)if(s.ready)hipEventDestroy(s.ready); if(device)hipFree(device); if(host)hipHostFree(host); }
+    };
+    static thread_local Probe p;
+    auto s=reinterpret_cast<hipStream_t>(stream);
+    if(begin) {
+        p.active=-1;
+        for(int i=0;i<p.count;i++)if(p.slots[i].pending) {
+            auto rc=hipEventQuery(p.slots[i].ready);
+            if(rc==hipErrorNotReady)continue;
+            if(rc!=hipSuccess)return RAD_E_DEVICE;
+            auto& q=p.slots[i];
+            if(p.host[2*i+1]<p.host[2*i])return RAD_E_STATE;
+            fprintf(stderr,"HIP_PASS_SPAN step=%d tokens=%lld draft=%d span_ms=%.6f submit_us=%.3f begin_tick=%llu end_tick=%llu clock_khz=%d\n",q.step,(long long)q.tokens,q.draft,double(p.host[2*i+1]-p.host[2*i])/p.khz,q.submit_us,p.host[2*i],p.host[2*i+1],p.khz);
+            q.pending=false;
+        }
+        if(step<20||step>24||tokens<1||tokens>4||p.count==32)return RAD_OK;
+        if(!p.device) {
+            if(hipDeviceGetAttribute(&p.khz,hipDeviceAttributeWallClockRate,0)!=hipSuccess||p.khz<=0)return RAD_E_DEVICE;
+            if(hipMalloc((void**)&p.device,64*sizeof(unsigned long long))!=hipSuccess ||
+               hipHostMalloc((void**)&p.host,64*sizeof(unsigned long long))!=hipSuccess)return RAD_E_NOMEM;
+            for(auto& q:p.slots)if(hipEventCreateWithFlags(&q.ready,hipEventDisableTiming)!=hipSuccess)return RAD_E_DEVICE;
+        }
+        const int i=p.count++;
+        auto& q=p.slots[i];q.step=step;q.tokens=tokens;q.draft=draft;
+        if(rad_diag_clock_stamp(p.device,2*i,stream)<0)return RAD_E_DEVICE;
+        p.submitted=std::chrono::steady_clock::now();p.active=i;
+    } else if(p.active>=0) {
+        const int i=p.active;p.active=-1;auto& q=p.slots[i];
+        q.submit_us=std::chrono::duration<double,std::micro>(std::chrono::steady_clock::now()-p.submitted).count();
+        if(rad_diag_clock_stamp(p.device,2*i+1,stream)<0 ||
+           hipMemcpyAsync(p.host+2*i,p.device+2*i,2*sizeof(unsigned long long),hipMemcpyDeviceToHost,s)!=hipSuccess ||
+           hipEventRecord(q.ready,s)!=hipSuccess)return RAD_E_DEVICE;
+        q.pending=true;
+    }
+    return RAD_OK;
+}
