+}
+// Read-only per-process WDDM telemetry. A separate helper's CurrentUsage is not ours.
+static void trace_residency_budget(const char* phase) {
+#ifdef _WIN32
+    if (!std::getenv("RADIANCE_HIP_DXGI_TRACE")) return;
+    static HMODULE dll=LoadLibraryW(L"dxgi.dll");
+    using Create=HRESULT(WINAPI*)(REFIID,void**);
+    auto create=dll?reinterpret_cast<Create>(GetProcAddress(dll,"CreateDXGIFactory1")):nullptr;
+    IDXGIFactory1* factory=nullptr;
+    if(!create||FAILED(create(__uuidof(IDXGIFactory1),(void**)&factory)))return;
+    for(UINT i=0;;++i){
+        IDXGIAdapter1* adapter=nullptr;
+        if(factory->EnumAdapters1(i,&adapter)==DXGI_ERROR_NOT_FOUND)break;
+        if(!adapter)break;
+        DXGI_ADAPTER_DESC1 desc{};adapter->GetDesc1(&desc);
+        IDXGIAdapter3* query=nullptr;
+        if(desc.VendorId==0x1002&&SUCCEEDED(adapter->QueryInterface(__uuidof(IDXGIAdapter3),(void**)&query))){
+            for(int segment=0;segment<2;++segment){
+                DXGI_QUERY_VIDEO_MEMORY_INFO info{};
+                HRESULT hr=query->QueryVideoMemoryInfo(0,static_cast<DXGI_MEMORY_SEGMENT_GROUP>(segment),&info);
+                fprintf(stderr,"DXGI_PROCESS phase=%s luid=%08x:%08x segment=%d hr=%08x budget=%llu usage=%llu reservation=%llu\n",phase,unsigned(desc.AdapterLuid.HighPart),unsigned(desc.AdapterLuid.LowPart),segment,unsigned(hr),(unsigned long long)info.Budget,(unsigned long long)info.CurrentUsage,(unsigned long long)info.CurrentReservation);
+            }query->Release();
+        }adapter->Release();
+    }factory->Release();fflush(stderr);
+#endif
+}
+// Opt-in diagnostic only: replay one read-only attention op against an exact
+// temporary copy of its KV layer. Not a production placement policy.
+namespace {
+std::mutex allocation_probe_mutex;
+std::map<void*,size_t> allocation_probe_ranges;
+void record_probe_allocation(void* p,size_t bytes) {
+    if(!p||bytes<64ull*1024*1024||!std::getenv("RADIANCE_HIP_ALLOCATION_SCAN"))return;
+    std::lock_guard<std::mutex> lock(allocation_probe_mutex);
+    allocation_probe_ranges[p]=bytes;
+}
+int scan_probe_allocations(RadStream stream) {
+    if(!std::getenv("RADIANCE_HIP_ALLOCATION_SCAN"))return RAD_OK;
+    auto s=reinterpret_cast<hipStream_t>(stream);
+    if(hipStreamSynchronize(s)!=hipSuccess)return RAD_E_DEVICE;
+    std::vector<std::pair<void*,size_t>> ranges;
+    {std::lock_guard<std::mutex> lock(allocation_probe_mutex);
+     for(auto r:allocation_probe_ranges)ranges.push_back(r);}
+    constexpr size_t sample=8ull*1024*1024;
+    size_t available=0,total=0;
+    if(hipMemGetInfo(&available,&total)!=hipSuccess||available<sample+128ull*1024*1024)return RAD_E_NOMEM;
+    void* scratch=nullptr;
+    if(hipMalloc(&scratch,sample)!=hipSuccess)return RAD_E_NOMEM;
+    int status=RAD_OK;
+    // Completed wall time, not PAL event timestamps. Read-only samples; this
+    // intentionally perturbs residency and must never be a throughput baseline.
+    for(auto r:ranges) {
+        const size_t stride=r.second>3ull*1024*1024*1024?256ull*1024*1024:32ull*1024*1024;
+        // Always include the physical tail: a smaller mapping can leave less
+        // than one sampling stride on the slow path.
+        for(size_t off=0;;off=(std::min)(off+stride,r.second-sample)) {
+            auto begin=std::chrono::steady_clock::now();
+            for(int repeat=0;repeat<2;repeat++) {
+                if(hipMemcpyAsync(scratch,static_cast<char*>(r.first)+off,sample,hipMemcpyDeviceToDevice,s)!=hipSuccess){status=RAD_E_DEVICE;break;}
+            }
+            if(hipStreamSynchronize(s)!=hipSuccess)status=RAD_E_DEVICE;
+            double us=std::chrono::duration<double,std::micro>(std::chrono::steady_clock::now()-begin).count()/2;
+            fprintf(stderr,"ALLOCATION_SCAN base=%p bytes=%zu offset=%zu sample=%zu wall_us=%.3f\n",r.first,r.second,off,sample,us);
+            if(status<0||off==r.second-sample)break;
+        }
+        if(status<0)break;
+    }
+    fflush(stderr);
+    if(hipFree(scratch)!=hipSuccess)status=RAD_E_DEVICE;
+    return status;
+}
+}
+int hip_attention_copy_probe(unsigned op, RadLaunchFn launch, const RadArgs* a, RadStream stream) {
+    static thread_local bool budget_seen=false;
+    if(!budget_seen){trace_residency_budget("first-attention");budget_seen=true;int rc=scan_probe_allocations(stream);if(rc<0)return rc;}
+    static const bool enabled=std::getenv("RADIANCE_HIP_ATTN_COPY_PROBE")!=nullptr;
+    static thread_local unsigned selected=0;
+    static thread_local bool short_done=false,long_done=false;
+    if(!enabled||!a||a->n_t<8||a->t[0].shape[0]>4||a->t[1].dtype!=RAD_F8E4M3)return RAD_OK;
+    if(!selected)selected=op;
+    if(op!=selected||long_done)return RAD_OK;
+    auto s=reinterpret_cast<hipStream_t>(stream);
+    int ctx=0;
+    if(hipMemcpyAsync(&ctx,a->t[3].data,4,hipMemcpyDeviceToHost,s)!=hipSuccess||hipStreamSynchronize(s)!=hipSuccess)return RAD_E_DEVICE;
+    if((ctx<8000&&short_done)||ctx<1)return RAD_OK;
+    const auto& kv=a->t[1];size_t bytes=1;
+    for(unsigned i=0;i<kv.rank;i++)bytes+=size_t(kv.shape[i]-1)*size_t(kv.stride[i]);
+    size_t free=0,total=0;
+    if(bytes>128ull*1024*1024||hipMemGetInfo(&free,&total)!=hipSuccess||free<bytes+128ull*1024*1024)return RAD_E_NOMEM;
+    size_t outbytes=2;for(unsigned i=0;i<a->t[7].rank;i++)outbytes*=size_t(a->t[7].shape[i]);
+    std::vector<unsigned char> expected(outbytes),actual(outbytes);
+    if(hipMemcpy(expected.data(),a->t[7].data,outbytes,hipMemcpyDeviceToHost)!=hipSuccess)return RAD_E_DEVICE;
+    void* copy=nullptr;hipEvent_t begin=nullptr,end=nullptr;
+    int status=RAD_OK;
+    auto run=[&]()->int {
+        if(hipMalloc(&copy,bytes)!=hipSuccess||hipEventCreate(&begin)!=hipSuccess||hipEventCreate(&end)!=hipSuccess)return RAD_E_DEVICE;
+        hipEventRecord(begin,s);
+        if(hipMemcpyAsync(copy,kv.data,bytes,hipMemcpyDeviceToDevice,s)!=hipSuccess)return RAD_E_DEVICE;
+        hipEventRecord(end,s);if(hipEventSynchronize(end)!=hipSuccess)return RAD_E_DEVICE;
+        float copy_ms=0;hipEventElapsedTime(&copy_ms,begin,end);
+        std::vector<RadTensor> ts(a->t,a->t+a->n_t);RadArgs args=*a;args.t=ts.data();
+        for(int pass=0;pass<4;pass++) {
+            int path=(pass==0||pass==3)?1:0;
+            ts[1].data=path?copy:kv.data;
