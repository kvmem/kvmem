+        s->blocks[(size_t)t.group].swap(t.blocks);
+        for (auto b : t.blocks) drop_block(t.group, b);
+        s->dirty_from[(size_t)t.group] = 0;
+    }
+    if (reset_windows) for (const auto& p : plans_) if (p.kind == RAD_KV_WINDOW) {
+        for (auto b : s->blocks[(size_t)p.index]) drop_block(p.index, b);
+        s->blocks[(size_t)p.index].clear();
+        s->first_block_pos[(size_t)p.index] = frontier / p.block_size * p.block_size;
+        s->dirty_from[(size_t)p.index] = 0;
+    }
