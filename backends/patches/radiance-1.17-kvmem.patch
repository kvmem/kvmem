+bool KVManager::can_ever_fit_for(uint64_t id, int64_t n_tokens) const {
+    const Seq* s = find(id);
+    if (!s || s->canonical) return can_ever_fit(n_tokens);
+    if (n_tokens < 0 || (!s->canonical && n_tokens < s->sparse_anchor)) return false;
+    for (const auto& p : plans_) {
+        if (p.paged()) {
+            const int64_t n = n_tokens - (p.kind == RAD_KV_FULL ? s->full_offset : 0);
+            if (n < 0 || blocks_for(p.index, n) > p.n_blocks) return false;
+        } else if (p.stateful() && p.n_states < 1) return false;
+    }
+    return true;
+}
+
+bool KVManager::canonical(uint64_t id) const {
+    const Seq* s = find(id);
+    return s && s->canonical;
+}
