+// A Query replay invalidates the block drafter's window after its passes have
+// already been issued. Their proposals must be discarded and drafting must
+// wait until newly evaluated context covers the whole window again.
+TEST(a_block_drafter_refills_its_window_after_an_observer_rewind) {
+    struct EpochKV : FakeKV {
+        uint64_t epoch = 0;
+        int64_t floor = 0;
+        uint64_t window_epoch(uint64_t) const override { return epoch; }
+        int64_t window_floor(uint64_t) const override { return floor; }
+    } kv;
+    Fixture f;
+    f.build(4096, 64, 512, 8192);
+    f.cfg.prefix_cache = false;
+    f.cfg.n_spec = 7;
+    f.prog.drafter.kind = RAD_DRAFT_BLOCK;
+    f.prog.drafter.window = 64;
+    KVGroupInfo window;
+    window.name = "draft";
+    window.decl.kind = RAD_KV_WINDOW;
+    window.decl.window = 64;
+    window.block_size = 16;
+    f.prog.kv_groups.push_back(window);
+    kv.setup(f.prog.kv_groups, f.cfg.max_ctx, 4096, 64);
+    f.pc.kv = &kv;
+    std::vector<BatchBuilder::RankIO> ranks{{0, nullptr, &f.prog}};
+    CHECK_OK(f.sch.init(f.prog, f.cfg, &kv, &f.pc, ranks));
+    const uint64_t id = f.submit(96, 1024);
+    REQUIRE(f.sch.step() != nullptr);
+    f.commit_plain(11);
+    Scheduler::BlockRow rows[4];
+    CHECK_EQ(f.sch.block_begin(8, 7, 64, 99, rows, 4), 1);
+    kv.floor = f.sch.find(id)->n_computed;
+    ++kv.epoch;
+    f.sch.block_end();
+    const int32_t proposal[7] = {1, 2, 3, 4, 5, 6, 7};
+    CHECK_EQ(f.sch.set_draft(id, proposal, 7), RAD_E_STATE);
+    int offered = 0;
+    for (int step = 0; step < 64; ++step) {
+        REQUIRE(f.sch.step() != nullptr);
+        CHECK_EQ(f.sch.plan().e[0].n_spec, 0);
+        // Unique output tokens keep ordinary prompt-lookup fallback inactive.
+        f.commit_plain(20000 + step);
+        offered = f.sch.block_begin(8, 7, 64, 99, rows, 4);
+        f.sch.block_end();
+        if (f.sch.find(id)->n_computed < kv.floor + 63) CHECK_EQ(offered, 0);
+        if (offered) break;
+    }
+    CHECK_EQ(offered, 1);
+    CHECK_OK(f.sch.set_draft(id, proposal, 7));
+}
