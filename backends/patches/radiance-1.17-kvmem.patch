+int64_t KVManager::execution_offset(uint64_t id, int32_t g) const {
+    const Seq* s = find(id);
+    const KVGroupPlan* p = plan(g);
+    if (!s || !p) return 0;
+    return p->kind == RAD_KV_FULL ? s->full_offset : first_block_pos(id, g);
+}
