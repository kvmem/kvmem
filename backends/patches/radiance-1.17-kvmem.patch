+namespace rad {
+class KVManager;
+struct RankResources {
+    std::shared_ptr<void> lifetime;
+    KVManager* kv = nullptr;
+    Ctx* ctx = nullptr;
+};
+// Optional integration seam. The engine owns dispatch/lifetimes; an observer
+// owns its statistics and receives only declared tensors and accepted steps.
+// Installing one serializes steps and bypasses tapes whose captured destinations
+// would otherwise outlive a frame. A null observer preserves ordinary execution.
+// No KVMem policy, host archive, or vendor-specific type belongs in this interface.
+class StepObserver {
+public:
+    virtual ~StepObserver() = default;
+    // Statistics alone must not add a prefix-retention checkpoint.
+    virtual bool retain_history_boundary() const noexcept { return false; }
+    // An integration with per-request Query replay may isolate prefill steps
+    // while keeping ordinary decode batched. The scheduler alternates fairly.
+    virtual bool serial_prefill() const noexcept { return false; }
+    // Expected capacity refusals are per request. The engine drains this list
+    // outside the scheduler lock before commit, preserving other batch entries.
+    virtual uint64_t take_capacity_refusal() noexcept { return 0; }
+    // Engine-thread polling only. Pending host I/O owns the sequence until it
+    // publishes or aborts; HTTP cancellation must not free its pages or slot.
+    virtual int poll_pending() noexcept { return RAD_OK; }
+    virtual bool holds_sequence(uint64_t) const noexcept { return false; }
+    // Isolated host-storage/capacity failures; device faults still stop the engine.
+    virtual uint64_t take_request_refusal(int* status) noexcept {
+        *status=RAD_E_FULL;return take_capacity_refusal();
+    }
+    // Metadata only, under the scheduler lock; may run on an HTTP thread.
+    // No device work, retained Request pointers or prompt/output text copies.
+    virtual void request_metadata(const Request&, int64_t age_us, int64_t first_us) noexcept {}
+    // HTTP readers must use an independently synchronized metadata snapshot.
+    virtual std::string monitor_snapshot() const { return {}; }
+
+    // Optional bounded-residency contract, after declare and before allocation.
+    // Zero preserves ordinary full-context sizing. A positive value promises
+    // that the controller retires pages before this physical limit is reached;
+    // it never changes the logical context or original token positions.
+    virtual int pool_token_limit(const Config&, const Program&, int64_t* tokens) noexcept {
+        *tokens = 0; return RAD_OK;
+    }
+    // Before Ctx::init, once per rank. May install CtxDesc's Q/K callback.
+    virtual int configure(const Config&, CtxDesc&) noexcept = 0;
+    virtual int bind_rank(RankResources) noexcept { return RAD_OK; }
+    // Before any kernels for a fresh request, after new state slots are cleared.
+    // A controller may restore an exact retained prefix and return its frontier;
+    // the engine then retires this UNISSUED plan and rebuilds it. A refusal ends
+    // only this request. A zero frontier plus holds_sequence means its CPU
+    // prefix read is pending: discard this unissued plan, then retry resume
+    // when the hold clears. Ordinary observers leave both outputs unchanged.
+    virtual int resume(const StepPlan&, int64_t* frontier, std::string* refusal) noexcept {
+        *frontier = -1; refusal->clear(); return RAD_OK;
+    }
+    // Scheduler thread, before issuing any kernel for this plan.
+    virtual int begin(const StepPlan&) noexcept = 0;
+    // Optional model/sampler barrier for retrieval probes. after_forward must
+    // drain model writes. A nonnegative replay_from retires this UNSAMPLED
+    // prefill step, with native KV/state already restored by the integration.
+    // A null/default observer preserves the ordinary fused model+sampler path.
+    virtual bool split_sampling(const StepPlan&) const noexcept { return false; }
+    // HTTP admission, concurrent callers; inspect immutable limits only. Empty
+    // means accepted. Refuse unsupported input before it reaches the GPU loop.
+    virtual std::string validate_request(const Request&) const { return {}; }
+    virtual int after_forward(const StepPlan&, int64_t* replay_from) noexcept {
+        *replay_from = -1; return RAD_OK;
+    }
+    // After issue/collection, before Scheduler::commit can free terminal KV.
+    // Borrowed plan/result are valid only during this call; no queued next step.
+    virtual int collect(const StepPlan&, const Scheduler::StepResult&) noexcept = 0;
+    // Successful terminal commit, after output is bounded and before native
+    // pages/state are freed. The stream is drained; no next plan may be issued.
+    // Cancellation/failure never publishes a reusable conversation snapshot.
+    virtual int finish(const StepEntry&, const Request&) noexcept { return RAD_OK; }
+    virtual void retire(uint64_t) noexcept {}
+    // Called while streams and pools still exist, also after partial startup.
+    virtual void shutdown() noexcept = 0;
+};
+} // namespace rad
