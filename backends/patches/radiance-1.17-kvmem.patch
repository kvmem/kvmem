diff --git a/core/mm/vision_cache.h b/core/mm/vision_cache.h
new file mode 100644
--- /dev/null
+++ b/core/mm/vision_cache.h
@@ -0,0 +1,67 @@
+#pragma once
+#include "mm/processor.h"
+#include <list>
+#include <iterator>
+#include <charconv>
+#include <cstdlib>
+#include <cstring>
+#include <stdexcept>
+namespace rad::mm {
+inline size_t vision_cache_bytes() {
+    const char* value=std::getenv("KVMEM_RAD_VISION_CACHE_MIB");
+    if(!value)return size_t(256)*1024*1024;
+    unsigned mib=0;const char* end=value+std::strlen(value);
+    const auto result=std::from_chars(value,end,mib);
+    if(result.ec!=std::errc{} || result.ptr!=end || value==end || mib>65536)
+        throw std::invalid_argument("KVMEM_RAD_VISION_CACHE_MIB must be 0..65536");
+    return size_t(mib)*1024*1024;
+}
+
+// Engine-local: model, encoder implementation and weights cannot change during its lifetime.
+// Exact patches guard even a content-key collision; their bytes count against the LRU quota.
+class VisionCache {
+    struct Entry { Item identity; std::vector<uint16_t> output; size_t bytes; };
+    std::list<Entry> entries_;
+    size_t limit_, bytes_=0;
+    static bool same(const Item& a,const Item& b) {
+        return a.kind==b.kind && a.key_hi==b.key_hi && a.key_lo==b.key_lo &&
+            a.grid_t==b.grid_t && a.grid_h==b.grid_h && a.grid_w==b.grid_w &&
+            a.patch_dim==b.patch_dim && a.n_seg==b.n_seg && a.seg_rows==b.seg_rows &&
+            a.rows_h==b.rows_h && a.rows_w==b.rows_w && a.pixels==b.pixels;
+    }
+public:
+    explicit VisionCache(size_t limit):limit_(limit) {}
+    size_t bytes() const { return bytes_; }
+    bool get(Item& item) noexcept {
+        try {
+        if (!limit_) return false;
+        for(auto it=entries_.begin();it!=entries_.end();++it) if(same(it->identity,item)) {
+            item.embd=it->output;item.encoded=true;item.stats->cache_hits=1;item.stats->phase=4;
+            entries_.splice(entries_.begin(),entries_,it);return true;
+        }
+        return false;
+        } catch (...) { return false; } // Optional hit: allocation failure falls back to encoding.
+    }
+    bool put(const Item& item) noexcept {
+        try {
+        if(!limit_ || !item.encoded || item.kind!=Kind::Image || item.embd.empty())return false;
+        const size_t max_elements=limit_/sizeof(uint16_t);
+        if(item.pixels.size()>max_elements || item.embd.size()>max_elements-item.pixels.size())return false;
+        const size_t bytes=(item.pixels.size()+item.embd.size())*sizeof(uint16_t);
+        // Allocate the complete replacement before changing the LRU or its accounting.
+        Entry e; e.identity=item;
+        std::vector<uint16_t>().swap(e.identity.embd);
+        std::vector<int32_t>().swap(e.identity.expand);
+        std::vector<int32_t>().swap(e.identity.seg_at);
+        e.output=item.embd;e.bytes=bytes;
+        entries_.push_front(std::move(e));bytes_+=bytes;
+        for(auto it=std::next(entries_.begin());it!=entries_.end();) {
+            if(same(it->identity,item)){bytes_-=it->bytes;it=entries_.erase(it);}else ++it;
+        }
+        while(bytes_>limit_){bytes_-=entries_.back().bytes;entries_.pop_back();}
+        return true;
+        } catch (...) { return false; } // Cache insertion is optional; preserve live inference.
+
+    }
+};
+}
