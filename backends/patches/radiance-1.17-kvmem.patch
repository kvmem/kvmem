+// state = two contiguous [heads,128,128] slots, first anchor then factors.
+// Caller has fenced its producer and owns the clone exclusively. Synchronous;
+// leaves the live sequence and the process's anchor-mode setting untouched.
+extern "C" int rad_gdn_materialize_v1(void* state, int heads, int fp16, int accepted) {
+  if (!state || heads <= 0 || heads > 65535 || (fp16 != 0 && fp16 != 1) ||
+      accepted < 0 || accepted > RU_TMAX || (int64_t)accepted * RU_FSTR > RU_MARK_OFF)
+    return -1;
+  hipStream_t stream = nullptr;
+  int* meta = nullptr;
+  int status = 0;
+  const int host[9] = {0, 0, 0, 0, 0, 1, 1, 1, accepted};
+  if (hipStreamCreateWithFlags(&stream, hipStreamNonBlocking) != hipSuccess) return -2;
+  if (hipMalloc((void**)&meta, sizeof(host)) != hipSuccess) status = -3;
+  if (!status && hipMemcpyAsync(meta, host, sizeof(host), hipMemcpyHostToDevice, stream) != hipSuccess)
+    status = -4;
+  if (!status) {
+    const int64_t sh = RU_K * RU_V, ss = (int64_t)heads * sh;
