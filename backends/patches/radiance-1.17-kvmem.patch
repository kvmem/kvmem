+
+int KVManager::restore_full_tables(uint64_t id, int64_t expected, int64_t frontier,
+                                   int64_t visible, const std::vector<FullTable>& tables) {
+    const Seq* s = find(id);
+    if (!s || !s->canonical || expected < 0 || expected > 1 || frontier <= expected) return RAD_E_STATE;
+    return replace_full_tables(id, expected, frontier, visible, tables, true);
+}
+
+int KVManager::replace_full_tables(uint64_t id, int64_t expected, int64_t frontier,
+                                   int64_t visible, const std::vector<FullTable>& tables, bool restoring) {
+    Seq* s = find(id);
+    if (!s) return RAD_E_NOTFOUND;
