new file mode 100644
--- /dev/null
+++ b/core/device/hip_small_d2h.h
@@ -0,0 +1,52 @@
+// Isolated, default-off candidate for small pitched device-to-host captures.
+// Reuse the original Radiance copy2d kernel on the same producer stream.
+// Host-to-device uploads and all unknown/large ranges keep their original path.
+static bool small_d2h_enabled() {
+    static const bool on=[] {const char* v=std::getenv("RADIANCE_HIP_SMALL_D2H");return v&&std::strcmp(v,"1")==0;}();
+    return on;
+}
+struct SmallD2hRange {size_t bytes;uintptr_t alias;int kind,device;};
+static std::mutex small_d2h_mutex;
+static std::map<uintptr_t,SmallD2hRange> small_d2h_ranges;
+static int small_d2h_register(void* p,int64_t bytes,int kind) {
+    if(!p||!small_d2h_enabled())return RAD_OK;
+    if(kind!=RAD_MEM_DEVICE&&kind!=RAD_MEM_HOST_PINNED&&kind!=RAD_MEM_HOST_MAPPED)return RAD_OK;
+    int device=0;if(hipGetDevice(&device)!=hipSuccess)return RAD_E_DEVICE;
+    void* alias=p;
+    if(kind!=RAD_MEM_DEVICE&&hipHostGetDevicePointer(&alias,p,0)!=hipSuccess)return RAD_E_DEVICE;
+    std::lock_guard<std::mutex> lock(small_d2h_mutex);
+    small_d2h_ranges.emplace((uintptr_t)p,SmallD2hRange{(size_t)bytes,(uintptr_t)alias,kind,device});
+    return RAD_OK;
+}
+static void small_d2h_forget(void* p) {
+    if(!small_d2h_enabled())return;
+    std::lock_guard<std::mutex> lock(small_d2h_mutex);small_d2h_ranges.erase((uintptr_t)p);
+}
+static bool small_d2h_lookup(const void* p,size_t bytes,SmallD2hRange& range,uintptr_t& alias) {
+    const auto address=(uintptr_t)p;auto it=small_d2h_ranges.upper_bound(address);
+    if(it==small_d2h_ranges.begin())return false;
+    --it;const auto offset=address-it->first;
+    if(offset>it->second.bytes||bytes>it->second.bytes-offset)return false;
+    range=it->second;alias=range.alias+offset;return true;
+}
+static int small_d2h_try(void* dst,int64_t dp,const void* src,int64_t sp,int64_t width,int64_t height,RadStream stream,bool& handled) {
+    handled=false;
+    if(!small_d2h_enabled()||width<=0||height<=0||width>65536||height>65536/width)return RAD_OK;
+    if(dp<width||sp<width)return RAD_E_INVAL;
+    // Validate pitched spans before multiplication; do not overflow metadata.
+    if(height>1&&(dp>(INT64_MAX-width)/(height-1)||sp>(INT64_MAX-width)/(height-1)))return RAD_OK;
+    SmallD2hRange dr{},sr{};uintptr_t da=0,sa=0;
+    {
+        std::lock_guard<std::mutex> lock(small_d2h_mutex);
+        if(!small_d2h_lookup(dst,(size_t)((height-1)*dp+width),dr,da)||
+           !small_d2h_lookup(src,(size_t)((height-1)*sp+width),sr,sa))return RAD_OK;
+    }
+    if(dr.kind==RAD_MEM_DEVICE||sr.kind!=RAD_MEM_DEVICE||dr.device!=sr.device)return RAD_OK;
+    int device=0;if(hipGetDevice(&device)!=hipSuccess)return RAD_E_DEVICE;
+    if(device!=dr.device)return RAD_OK;
+    handled=true;
+    if(rad_aql_blit_copy2d((void*)da,(uint64_t)dp,(const void*)sa,(uint64_t)sp,(uint64_t)width,(uint64_t)height,stream)!=0)return RAD_E_DEVICE;
+    static std::atomic<unsigned long long> count{0};const auto n=count.fetch_add(1,std::memory_order_relaxed)+1;
+    if(n==1||n%2048==0)fprintf(stderr,"HIP_SMALL_D2H count=%llu width=%lld rows=%lld\n",n,(long long)width,(long long)height);
+    return RAD_OK;
+}
