+/* Qwen's declared vision tower is one contiguous run. Move its entire run, including
+ * weightless RoPE and attention, before layouts and buffer arenas are finalized.
+ * Refuse a different graph contract rather than silently placing part of it on CPU. */
+int Builder::place_vision_on_cpu() {
+    auto vision = [](const std::string& name) { return name.rfind("v.", 0) == 0; };
+    if (!ref_ && (prog_.encoder_name != "vision" || !prog_.encoder.out ||
+                  !vision(prog_.buffers[prog_.encoder.out].name))) {
+        err(RAD_E_UNSUPPORTED, "CPU vision requires the native Qwen vision tower");
+        return RAD_E_UNSUPPORTED;
+    }
+    size_t first = prog_.ops.size(), last = 0;
+    for (size_t i = 1; i < prog_.ops.size(); ++i)
+        for (rad_weight w : prog_.ops[i].weights)
+            if (w && vision(prog_.weights[w].name)) {
+                first = std::min(first, i); last = std::max(last, i);
+            }
+    if (first > last) {
+        err(RAD_E_UNSUPPORTED, "CPU vision found no complete native vision op run");
+        return RAD_E_UNSUPPORTED;
+    }
+    for (size_t i = first; i <= last; ++i) {
+        const OpInfo& o = prog_.ops[i];
+        for (rad_weight w : o.weights)
+            if (w && !vision(prog_.weights[w].name)) {
+                err(RAD_E_UNSUPPORTED, "CPU vision run mixes language-model weights");
+                return RAD_E_UNSUPPORTED;
+            }
+        if (!ref_) for (const Band& band : o.bands) {
+            const Resolved& host = band.dom[RAD_DOMAIN_HOST];
+            if (!host || host.scratch_bytes > 0) {
+                err(RAD_E_UNSUPPORTED, "CPU vision op '%s' needs a host kernel with no device scratch", o.op.c_str());
+                return RAD_E_UNSUPPORTED;
+            }
+        }
+    }
+    for (size_t i = first; i <= last; ++i) {
+        OpInfo& o = prog_.ops[i]; o.host_forced = true;
+        for (Band& band : o.bands) band.dom[RAD_DOMAIN_DEVICE] = Resolved{};
+    }
+    for (BufferInfo& b : prog_.buffers) if (vision(b.name)) b.decl.domain = RAD_DOMAIN_HOST;
+    if (!ref_) RAD_INFO("vision: CPU execution, ops %zu..%zu; weights mapped from container, activations on host", first, last);
+    return RAD_OK;
+}
