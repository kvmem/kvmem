diff --git a/core/server/query_span.h b/core/server/query_span.h
new file mode 100644
--- /dev/null
+++ b/core/server/query_span.h
@@ -0,0 +1,78 @@
+#pragma once
+#include <algorithm>
+#include <cstdint>
+#include <limits>
+#include <string>
+#include <utility>
+#include <vector>
+
+namespace rad::server {
+// Encode a rendered prefix using the already prepared image expansions.
+// This must mirror tokenize_with_media's segment boundaries; raw text-token
+// counts are wrong after the first image. No decoder/encoder work is repeated.
+template<class Encode, class Expansion>
+std::vector<int32_t> encode_media_prefix(const std::string& text,
+    const std::string& marker, size_t count, Encode encode, Expansion expansion) {
+    if (marker.empty()) return {};
+    std::vector<int32_t> out;
+    size_t pos=0, image=0;
+    for (;;) {
+        const auto at=text.find(marker,pos);
+        const auto segment=text.substr(pos,at==std::string::npos?std::string::npos:at-pos);
+        if (!segment.empty()) {
+            const auto ids=encode(segment);out.insert(out.end(),ids.begin(),ids.end());
+        }
+        if (at==std::string::npos) return out;
+        if (image>=count) return {};
+        const auto& ids=expansion(image++);
+        out.insert(out.end(),ids.begin(),ids.end());pos=at+marker.size();
+    }
+}
+
+// The history-only rendering must be an exact text AND token prefix. Unknown
+// templates and boundary merges opt out; no guessed token counts/model names.
+template<class Encode>
+int32_t prove_history_end(const std::string& original, const std::string& history,
+                         const std::vector<int32_t>& tokens, Encode encode) {
+    if (history.empty() || history.size() >= original.size() ||
+        original.compare(0, history.size(), history) != 0) return -1;
+    const auto prefix = encode(history);
+    if (prefix.empty() || prefix.size() >= tokens.size() ||
+        prefix.size() > size_t(std::numeric_limits<int32_t>::max()) ||
+        !std::equal(prefix.begin(), prefix.end(), tokens.begin())) return -1;
+    return int32_t(prefix.size());
+}
+// Prove a direct text-content span by rendering one marked message. Accept
+// only an exact reconstruction and exact token-prefix boundaries. Templates
+// that transform/duplicate content, or BPE merges crossing a boundary, return
+// unknown rather than silently treating headers/tools as the user's query.
+template<class Encode>
+std::pair<int32_t, int32_t> prove_query_span(
+    const std::string& original, const std::string& marked,
+    const std::string& marker, const std::string& content,
+    const std::vector<int32_t>& tokens, Encode encode) {
+    const std::pair<int32_t, int32_t> unknown{-1, -1};
+    if (marker.empty() || content.empty()) return unknown;
+    const auto at = marked.find(marker);
+    if (at == std::string::npos || marked.find(marker, at + marker.size()) != std::string::npos)
+        return unknown;
+    const auto prefix = marked.substr(0, at);
+    const auto suffix = marked.substr(at + marker.size());
+    std::string rendered_content = content;
+    if (prefix + rendered_content + suffix != original) {
+        // Jinja chat templates commonly trim surrounding whitespace. Prove
+        // exactly that transform, not arbitrary substring matching in history.
+        const auto first = content.find_first_not_of(" \t\r\n\f\v");
+        const auto last = content.find_last_not_of(" \t\r\n\f\v");
+        if (first == std::string::npos) return unknown;
+        rendered_content = content.substr(first, last - first + 1);
+        if (prefix + rendered_content + suffix != original) return unknown;
+    }
+    const auto before = encode(prefix), through = encode(prefix + rendered_content);
+    if (before.size() >= through.size() || through.size() > tokens.size() ||
+        through.size() > size_t(std::numeric_limits<int32_t>::max()) ||
+        !std::equal(before.begin(), before.end(), tokens.begin()) ||
+        !std::equal(through.begin(), through.end(), tokens.begin())) return unknown;
+    return {int32_t(before.size()), int32_t(through.size())};
+}
+} // namespace rad::server
