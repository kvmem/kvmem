diff --git a/arch/common/rad_mtp_head_policy.h b/arch/common/rad_mtp_head_policy.h
new file mode 100644
--- /dev/null
+++ b/arch/common/rad_mtp_head_policy.h
@@ -0,0 +1,13 @@
+// Experimental deployment choice; default preserves Radiance's native U2 draft.
+// The shared route reuses its existing full-head/greedy-sampler path. No change
+// to target sampling, acceptance rules, KV selection, or speculative depth.
+#pragma once
+#include <cstring>
+namespace rad { namespace arch {
+// 1: dedicated U2; 0: shared target head; -1: invalid policy.
+inline int mtp_head_choice(const char* policy, bool has_u2) {
+    if (!policy || !*policy || std::strcmp(policy, "auto") == 0) return has_u2 ? 1 : 0;
+    if (std::strcmp(policy, "shared") == 0) return 0;
+    return -1;
+}
+}}
diff --git a/arch/common/rad_mxfp4_logits.h b/arch/common/rad_mxfp4_logits.h
new file mode 100644
--- /dev/null
+++ b/arch/common/rad_mxfp4_logits.h
@@ -0,0 +1,47 @@
+// Experimental KVMem integration: compose existing Radiance quant/GEMM/cast rows.
+// No new device kernels. Target logits change precision: this is NOT draft-only
+// quantization or a distribution-preserving transform. Keep the default path intact.
+#pragma once
+#include "rad_fp8.h"
+
+namespace rad { namespace arch {
+struct Mxfp4Logits {
+    DenseFP8 head{};
+    rad_buf x = 0, y = 0, q = 0, scale = 0, tmp = 0;
+    rad_op quant = 0, gemm = 0, cast = 0;
+    bool enabled = false;
+
+    int declare(RadBuilder* b, Names& nm, const Geom& g, const char* prefix,
+                const DenseFP8& weights, rad_buf input, rad_buf output) {
+        if (!weights.mx || !weights.w || !weights.s || !weights.ref || !input || !output ||
+            g.act_dtype != RAD_BF16 || g.n_embd % RAD_FP8_BLOCK || g.n_vocab % 16 ||
+            g.max_logit_rows <= 0) return RAD_E_INVAL;
+        head = weights; x = input; y = output;
+        q = decl_b(b, nm.f("%s.q", prefix), RAD_F8E4M3, {g.max_logit_rows, g.n_embd});
+        scale = decl_b(b, nm.f("%s.scale", prefix), RAD_F32,
+                       {g.max_logit_rows, fp8_blocks(g.n_embd)});
+        tmp = decl_b(b, nm.f("%s.bf16", prefix), RAD_BF16, {g.max_logit_rows, g.n_vocab});
+        if (!q || !scale || !tmp) return RAD_E_INVAL;
+        quant = rw(b, RAD_OP(b, "quant_act_fp8",
+                       RAD_PARAMS(RAD_RANGE("M", 1, g.max_logit_rows),
+                                  RAD_INT("n", g.n_embd), RAD_INT("group", RAD_FP8_BLOCK),
+                                  RAD_STR("dtype", "bf16")), RAD_NOWEIGHTS),
+                   {x}, {q, scale});
+        gemm = head.gemm(b, g.max_logit_rows, g.n_vocab, g.n_embd, {q, scale}, {tmp});
+        cast = rw(b, RAD_OP(b, "cast",
+                      RAD_PARAMS(RAD_RANGE("M", 1, g.max_logit_rows), RAD_INT("n", g.n_vocab),
+                                 RAD_STR("from", "bf16"), RAD_STR("to", "f32")),
+                      RAD_NOWEIGHTS), {tmp}, {y});
+        if (!quant || !gemm || !cast) return RAD_E_INVAL;
+        enabled = true;
+        return RAD_OK;
+    }
+
+    void step(RadCtx* c, int64_t rows) const {
+        RAD_ISSUE_N(c, quant, rows, brows(x, rows), brows(q, rows), brows(scale, rows));
+        RAD_ISSUE_N(c, gemm, rows, brows(q, rows), brows(scale, rows),
+                    RAD_W(head.w), RAD_W(head.s), brows(tmp, rows), RAD_NONE, head.bref());
+        RAD_ISSUE_N(c, cast, rows, brows(tmp, rows), brows(y, rows));
+    }
+};
+}} // namespace rad::arch
