+        return RAD_E_STATE;
+    for (const auto& w : s->win) if (w.set) return RAD_E_UNSUPPORTED;
+    // Copy and validate before changing any reference count or sequence table.
+    // The offset only maps the new contiguous tail; the adapter owns historical
+    // positions and must prove partial-tail identity before asking to publish.
+    auto next = tables;
+    std::vector<bool> seen(plans_.size(), false);
+    const int64_t offset = frontier - visible;
+    for (const auto& t : next) {
+        const KVGroupPlan* p = plan(t.group);
+        if (!p || p->kind != RAD_KV_FULL || seen[(size_t)t.group] ||
+            p->block_size <= 0 || offset % p->block_size ||
+            (int64_t)t.blocks.size() != ceil_div(visible, p->block_size)) return RAD_E_INVAL;
