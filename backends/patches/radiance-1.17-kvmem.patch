+        }
+    }
+    bool any = false;
+    for (const auto& p : plans_) {
+        if (p.kind == RAD_KV_FULL) {
+            if (!seen[(size_t)p.index]) return RAD_E_INVAL;
+            any = true;
+        }
+    }
+    if (!any) return RAD_E_UNSUPPORTED;
+    // reserve_specific_block leaves stale heap entries behind. The free heap can
+    // therefore exceed n_blocks when old pages are released: reserve its actual
+    // worst-case growth BEFORE changing tables, so bad_alloc cannot half-publish.
+    for (const auto& t : next) {
+        auto& free = free_blocks_[(size_t)t.group];
+        free.reserve(free.size() + s->blocks[(size_t)t.group].size());
+    }
+    // Rolling windows are never in the sparse full-attention view. At the
+    // same frontier they stay untouched. A rewind/resume invalidates their
+    // old timeline; the native drafter refills from the resumed frontier and
+    // its coverage gate declines proposals until its own window is available.
+    const bool reset_windows = restoring || frontier != expected;
+    const bool has_windows = std::any_of(plans_.begin(), plans_.end(), [](const auto& p) { return p.kind == RAD_KV_WINDOW; });
