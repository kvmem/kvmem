+// Model kernels, KVMem policy and tensor layouts are unchanged. Optional tape
+// and elastic-VA entries are absent until independently qualified on this path.
+#include "device.h"
+#include "cpu_span.h"
+#include "hip_allocation_priority.h"
+#if defined(RAD_HAVE_HIP) && RAD_HAVE_HIP && defined(RAD_USE_HIP_RUNTIME)
+#include "aql.h" // existing, ordinary HIP blit kernel launchers
+#include <hip/hip_runtime.h>
+#include <atomic>
+#include <cstdlib>
+#include <mutex>
+#include <new>
+#include <vector>
+#include <cstdio>
+#include <cstring>
