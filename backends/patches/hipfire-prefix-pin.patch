+pub fn prefix_restore_limit(lcp: u64, live: u64, eval_end: u64, needs_logits: bool) -> u64 {
+    unsafe { ffi::hk_prefix_restore_limit(lcp, live, eval_end, c_int::from(needs_logits)) }
