+struct KvmemCanonicalInput {
+    // Reservation is destroyed last, after the metadata allocations it covers.
+    std::shared_ptr<kvmem::HostKvReservation> charge;
+    std::vector<int32_t> tokens;
+    std::vector<KvmemCanonicalImage> images;
+    uint64_t bytes() const {return sizeof(*this)+128+tokens.capacity()*sizeof(int32_t)+images.capacity()*sizeof(KvmemCanonicalImage);}
+    static bool media_prefix(const std::vector<KvmemCanonicalImage>& a,const std::vector<KvmemCanonicalImage>& b,size_t end) {
+        size_t i=0,j=0;
+        while(i<a.size() && a[i].at<end) {
+            if(a[i].at+a[i].rows>end || j>=b.size() || !(a[i]==b[j]))return false;
+            ++i;++j;
+        }
+        return j>=b.size() || b[j].at>=end;
+    }
+    bool prefix_of(const std::vector<int32_t>& ids,const std::vector<KvmemCanonicalImage>& media) const {
+        return !tokens.empty() && ids.size()>=tokens.size() && std::equal(tokens.begin(),tokens.end(),ids.begin()) && media_prefix(images,media,tokens.size());
+    }
+    bool comparable(const KvmemCanonicalInput& other) const {
+        const auto n=std::min(tokens.size(),other.tokens.size());
+        return n && std::equal(tokens.begin(),tokens.begin()+n,other.tokens.begin()) && media_prefix(images,other.images,n) && media_prefix(other.images,images,n);
+    }
+};
+template<class Reserve>
+std::shared_ptr<const KvmemCanonicalInput> capture_canonical_input(const std::vector<int32_t>& ids,
+        int64_t end,const std::vector<KvmemCanonicalImage>& images,Reserve reserve) {
+    if(end<=0 || uint64_t(end)>ids.size())return {};
+    size_t count=0;
+    for(const auto& image:images)if(image.at<uint64_t(end)) {
+        if(image.at+image.rows>uint64_t(end))return {}; ++count;
+    }
+    try {
+        const auto bytes=sizeof(KvmemCanonicalInput)+128+uint64_t(end)*sizeof(int32_t)+count*sizeof(KvmemCanonicalImage);
+        auto reservation=reserve(bytes); // CPU storage only; preflight before allocations.
+        auto input=std::make_shared<KvmemCanonicalInput>();input->charge=std::move(reservation);
+        input->tokens.assign(ids.begin(),ids.begin()+end);input->images.assign(images.begin(),images.begin()+count);
+        if(input->bytes()>input->charge->remaining())throw std::logic_error("canonical metadata preflight underestimated capacity");
+        return input;
+    } catch(const kvmem::MemoryError& error) {
+        std::fprintf(stderr,"KVMEM_CANONICAL_SKIP reason=optional_storage code=%d error=%s\n",int(error.code()),error.what());
