+struct KvmemCanonicalImage {
+    uint64_t at=0, rows=0, width=0, hash=0;
+    bool operator==(const KvmemCanonicalImage& other) const {
+        return at==other.at && rows==other.rows && width==other.width && hash==other.hash;
+    }
