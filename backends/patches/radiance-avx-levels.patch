 extern "C" const AvxKernelTable* avx_table_for(int level) {
     switch (level) {
+#if RAD_AVX_LEVEL_MASK & 8
         case AVX_LEVEL_AVX512: return &avx_table_v3;
+#endif
+#if RAD_AVX_LEVEL_MASK & 4
         case AVX_LEVEL_AVX2:   return &avx_table_v2;
+#endif
+#if RAD_AVX_LEVEL_MASK & 2
         case AVX_LEVEL_AVX:    return &avx_table_v1;
-        default:               return &avx_table_sc;
-    }
+#endif
+#if RAD_AVX_LEVEL_MASK & 1
+        case AVX_LEVEL_SCALAR: return &avx_table_sc;
+        default: return level < 0 || level >= AVX_N_LEVELS ? &avx_table_sc : nullptr;
+#else
+        default: return nullptr;
+#endif
+    }
+}
+
+static int compiled_level_at_most(int level) {
+    for (int candidate = level; candidate >= AVX_LEVEL_SCALAR; --candidate)
+        if (avx_table_for(candidate)) return candidate;
+    return -1;
 }
 
