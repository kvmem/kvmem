@@ -78,7 +79,23 @@
 
 find_package(OpenMP QUIET)
 
-foreach(lvl RANGE 0 3)
+set(RAD_AVX_LEVELS "0;1;2;3" CACHE STRING "Compiled libavx ISA levels (0 scalar, 1 AVX, 2 AVX2, 3 AVX512)")
+if(NOT RAD_AVX_LEVELS)
+  message(FATAL_ERROR "RAD_AVX_LEVELS must contain at least one ISA level")
+endif()
+set(_avx_levels ${RAD_AVX_LEVELS})
+set(_avx_level_mask 0)
+foreach(lvl IN LISTS _avx_levels)
+  if(NOT lvl MATCHES "^[0-3]$")
+    message(FATAL_ERROR "Invalid RAD_AVX_LEVELS entry '${lvl}'; expected 0, 1, 2 or 3")
+  endif()
+  math(EXPR _avx_level_mask "${_avx_level_mask} | (1 << ${lvl})")
+endforeach()
+list(REMOVE_DUPLICATES _avx_levels)
+list(SORT _avx_levels COMPARE NATURAL)
+message(STATUS "libavx: compiled ISA levels ${_avx_levels}")
+
+foreach(lvl IN LISTS _avx_levels)
   add_library(avx_lvl${lvl} OBJECT ${AVX_KERNEL_SRC})
   target_compile_definitions(avx_lvl${lvl} PRIVATE AVX_LEVEL=${lvl})
   target_link_libraries(avx_lvl${lvl} PRIVATE radiance::abi)
