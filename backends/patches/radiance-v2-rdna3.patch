+static const RadTunable tGemmQ[] = {
+    { "sk", kSk, NELEM(kSk), 0, "split-K slices; 0 is the widest legal for this K" },
+    { "nt", kNt, NELEM(kNt), 1, "non-temporal weight streaming" },
