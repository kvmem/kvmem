+                                     r3da_attn_qcvt<D, FOLDQ, F16>(u0.z, mul),
+                                     r3da_attn_qcvt<D, FOLDQ, F16>(u0.w, mul),
+                                     r3da_attn_qcvt<D, FOLDQ, F16>(u1.x, mul),
+                                     r3da_attn_qcvt<D, FOLDQ, F16>(u1.y, mul),
+                                     r3da_attn_qcvt<D, FOLDQ, F16>(u1.z, mul),
