+#else
+        const uint32_t x = __builtin_amdgcn_perm(w, w, 0x03010200u);
+#endif
+        q.u[d * 2 + 0] = ((x << 8) & 0x80008000u) | ((x << 4) & 0x07F007F0u);
+        q.u[d * 2 + 1] = (x & 0x80008000u) | ((x >> 4) & 0x07F007F0u);
+#endif
+    }
+    return q.f;
