+// Standalone qualification runner: link only the migrated attention unit and HIP runtime.
+// Run explicitly with --run-gpu on gfx1100/1101/1102. This is not a performance benchmark.
+#include "r3d_plugin.h"
+#include <hip/hip_runtime.h>
+#include <algorithm>
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <stdexcept>
+#include <vector>
+#ifdef R3D_TEST_DLL
+#include <windows.h>
+static RadLaunchFn p_bf16_decode, p_bf16_prefill, p_fp8_decode, p_fp8_prefill;
+static RadScratchFn p_decode_scratch, p_prefill_scratch;
+#define r3d_rad_attn_h256_bf16_decode p_bf16_decode
+#define r3d_rad_attn_h256_bf16_prefill p_bf16_prefill
+#define r3d_rad_attn_h256_fp8_decode p_fp8_decode
+#define r3d_rad_attn_h256_fp8_prefill p_fp8_prefill
+#define r3d_attn_h256_decode_scratch p_decode_scratch
+#define r3d_attn_h256_prefill_scratch p_prefill_scratch
+#endif
+
+static void hipcheck(hipError_t e) {
+    if(e!=hipSuccess)throw std::runtime_error(hipGetErrorString(e));
+}
+static uint16_t bf16(float f) {
+    uint32_t u; std::memcpy(&u,&f,4); return (uint16_t)((u+0x7fff+((u>>16)&1))>>16);
+}
+static float widen(uint16_t h) {
+    uint32_t u=(uint32_t)h<<16;float f;std::memcpy(&f,&u,4);return f;
+}
+static float e4m3(uint8_t u) {
+    const int ex=(u>>3)&15, m=u&7;
+    float f=ex?std::ldexp(1.0f+m/8.0f,ex-7):std::ldexp((float)m,-9);
+    return u&128?-f:f;
+}
+struct DeviceBuffers {
+    std::vector<void*> owned;
+    // Cleanup cannot throw while another HIP failure is already being reported.
+    ~DeviceBuffers(){for(auto p:owned)(void)hipFree(p);}
+    void* alloc(size_t bytes,const void* src=nullptr) {
+        void* p=nullptr;hipcheck(hipMalloc(&p,bytes));owned.push_back(p);
+        if(src)hipcheck(hipMemcpy(p,src,bytes,hipMemcpyHostToDevice));
+        else hipcheck(hipMemset(p,0,bytes));return p;
+    }
+};
+static void tensor(RadTensor& t,void* data,uint32_t dtype,std::initializer_list<int64_t> dims) {
+    t={};t.data=data;t.dtype=dtype;
+    for(auto d:dims)t.shape[t.rank++]=d;
+    rad_tensor_pack(&t);
+}
+static uint32_t rng=0x19640521;
+static unsigned random32(){rng^=rng<<13;rng^=rng>>17;rng^=rng<<5;return rng;}
+
+static void run_case(int n,bool fp8,bool ragged,bool causal,bool scratch,int splits,int declared_ctx=0) {
+    constexpr int ns=2,kh=2,qh=12,hd=256,bs=16;
+    int qlens[ns]={n,ragged?std::max(1,n-3):n};
+    int lengths[ns]={n+65,qlens[1]+33};
+    int cu[3]={0,qlens[0],qlens[0]+qlens[1]};
+    const int rows=cu[2],width=(lengths[0]+15)/16,blocks=ns*width;
+    std::vector<int> bt(blocks);
+    for(int i=0;i<blocks;++i)bt[i]=blocks-i-1; // non-identity paging
+    std::vector<uint16_t> q((size_t)rows*qh*hd),kv16((size_t)blocks*kh*bs*2*hd);
+    std::vector<uint8_t> kv8(kv16.size());
+    for(auto& x:q)x=bf16(((int)(random32()%33)-16)/32.0f);
+    constexpr uint8_t palette[]={0x00,0x28,0x30,0x38,0xa8,0xb0,0xb8};
+    for(size_t i=0;i<kv16.size();++i){
+        kv16[i]=bf16(((int)(random32()%65)-32)/32.0f);
+        kv8[i]=palette[random32()%7];
+    }
+    float kd[4]={0.5f,1.0f,1.0f,0.5f},vd[4]={1.0f,0.5f,0.5f,1.0f};
+    auto kv=[&](int s,int h,int pos,int d,bool v)->double {
+        size_t index=(((size_t)bt[s*width+pos/16]*kh+h)*16+pos%16)*512+(v?256:0)+d;
+        return fp8?e4m3(kv8[index])*(v?vd:kd)[s*kh+h]:widen(kv16[index]);
+    };
+    std::vector<double> ref(q.size());
+    for(int s=0;s<ns;++s)for(int qi=0;qi<qlens[s];++qi)for(int h=0;h<qh;++h){
+        int end=causal?lengths[s]-qlens[s]+qi+1:lengths[s];
+        std::vector<double> score(end);double mx=-1e300,sum=0;
+        const size_t base=((size_t)(cu[s]+qi)*qh+h)*hd;
+        for(int k=0;k<end;++k){
+            double dot=0;for(int d=0;d<hd;++d)dot+=widen(q[base+d])*kv(s,h/6,k,d,false);
+            score[k]=dot/16;mx=std::max(mx,score[k]);
+        }
+        for(auto& x:score){x=std::exp(x-mx);sum+=x;}
+        for(int d=0;d<hd;++d){double val=0;
+            for(int k=0;k<end;++k)val+=score[k]*kv(s,h/6,k,d,true);
+            ref[base+d]=val/sum;
+        }
+    }
+    DeviceBuffers dev;RadTensor t[8]{};
+    tensor(t[0],dev.alloc(q.size()*2,q.data()),RAD_BF16,{rows,qh,hd});
+    tensor(t[1],fp8?dev.alloc(kv8.size(),kv8.data()):dev.alloc(kv16.size()*2,kv16.data()),
+           fp8?RAD_F8E4M3:RAD_BF16,{blocks,kh,bs,512});
+    tensor(t[2],dev.alloc(bt.size()*4,bt.data()),RAD_I32,{ns,width});
+    tensor(t[3],dev.alloc(sizeof(lengths),lengths),RAD_I32,{ns});
+    if(fp8){tensor(t[4],dev.alloc(sizeof(kd),kd),RAD_F32,{ns,kh});
+             tensor(t[5],dev.alloc(sizeof(vd),vd),RAD_F32,{ns,kh});}
+    if(ragged)tensor(t[6],dev.alloc(sizeof(cu),cu),RAD_I32,{ns+1});
+    std::vector<uint16_t> out(q.size()+128,0x7fc1);
+    tensor(t[7],dev.alloc(out.size()*2,out.data()),RAD_BF16,{rows,qh,hd});
+    RadParam p[]={RAD_INT("head_dim",hd),RAD_INT("gqa",6),RAD_INT("block_size",16),
+        RAD_INT("q_len",n),RAD_INT("n_head",qh),RAD_INT("max_seqs",ns),
+        RAD_INT("max_ctx",declared_ctx?declared_ctx:width*16),RAD_INT("window",0),RAD_INT("causal",causal),
+        RAD_INT("splits",splits),RAD_F64("scale",1.0/16.0)};
+    RadArgs a{};a.t=t;a.n_t=8;a.p=p;a.n_p=(int)(sizeof(p)/sizeof(p[0]));
+    auto sizefn=n<=10?r3d_attn_h256_decode_scratch:r3d_attn_h256_prefill_scratch;
+    auto launch=n<=10?(fp8?r3d_rad_attn_h256_fp8_decode:r3d_rad_attn_h256_bf16_decode)
+                     :(fp8?r3d_rad_attn_h256_fp8_prefill:r3d_rad_attn_h256_bf16_prefill);
+    RadArgs declaration=a;declaration.t=nullptr;declaration.n_t=0;
+    int64_t need=sizefn(&declaration);if(need<0)throw std::runtime_error("scratch declaration failed");
+    if(n<=10 && launch(&a,nullptr)!=RAD_E_SCRATCH)throw std::runtime_error("missing scratch accepted");
+    if(need>0 && (scratch || n<=10)) {a.scratch=dev.alloc((size_t)need);a.scratch_bytes=need;}
+    if(n<=10){RadArgs shortbuf=a;shortbuf.scratch_bytes=0;
+        if(launch(&shortbuf,nullptr)!=RAD_E_SCRATCH)throw std::runtime_error("short scratch accepted");}
+    int rc=launch(&a,nullptr);
+    if(rc!=RAD_OK){std::fprintf(stderr,"launch failed: %d\n",rc);throw std::runtime_error("launch");}
+    hipcheck(hipDeviceSynchronize());
+    hipcheck(hipMemcpy(out.data(),t[7].data,out.size()*2,hipMemcpyDeviceToHost));
+    double maxabs=0,sse=0;size_t failures=0;
+    for(size_t i=0;i<q.size();++i){double val=widen(out[i]),err=std::abs(val-ref[i]);
+        if(!std::isfinite(val)||err>0.003+0.02*std::abs(ref[i]))++failures;
+        maxabs=std::max(maxabs,err);sse+=err*err;
+    }
+    for(size_t i=q.size();i<out.size();++i)if(out[i]!=0x7fc1)throw std::runtime_error("output guard overwritten");
+    std::printf("q=%d kv=%s ragged=%d causal=%d scratch=%lld splits=%d declared_ctx=%d table_ctx=%d max_abs=%.8g rmse=%.8g failures=%zu\n",
+        n,fp8?"fp8":"bf16",ragged,causal,(long long)a.scratch_bytes,splits,declared_ctx,width*16,maxabs,std::sqrt(sse/q.size()),failures);
+    if(failures)throw std::runtime_error("FP64 oracle mismatch");
+}
+int main(int argc,char** argv) {
+    if(argc<2||std::strcmp(argv[1],"--run-gpu")){
+        std::puts("Not run. Use --run-gpu on an idle RX7000 (gfx1100/1101/1102). No model downloads.");return 77;
+    }
+    try {
+#ifdef R3D_TEST_DLL
+        if(argc!=3)throw std::runtime_error("pass --run-gpu and libr3d DLL path");
+        HMODULE dll=LoadLibraryA(argv[2]);if(!dll)throw std::runtime_error("LoadLibrary libr3d failed");
+#define LOAD(p,name,type) p=reinterpret_cast<type>(GetProcAddress(dll,name));if(!p)throw std::runtime_error(name)
+        LOAD(p_bf16_decode,"r3d_rad_attn_h256_bf16_decode",RadLaunchFn);
+        LOAD(p_bf16_prefill,"r3d_rad_attn_h256_bf16_prefill",RadLaunchFn);
+        LOAD(p_fp8_decode,"r3d_rad_attn_h256_fp8_decode",RadLaunchFn);
+        LOAD(p_fp8_prefill,"r3d_rad_attn_h256_fp8_prefill",RadLaunchFn);
+        LOAD(p_decode_scratch,"r3d_attn_h256_decode_scratch",RadScratchFn);
+        LOAD(p_prefill_scratch,"r3d_attn_h256_prefill_scratch",RadScratchFn);
+#undef LOAD
+#endif
+        int device=0;hipcheck(hipGetDevice(&device));hipDeviceProp_t p{};hipcheck(hipGetDeviceProperties(&p,device));
+        bool supported=false;for(auto arch:{"gfx1100","gfx1101","gfx1102"})
+            if(!std::strncmp(p.gcnArchName,arch,7)&&(p.gcnArchName[7]=='\0'||p.gcnArchName[7]==':'))supported=true;
+        if(!supported){std::fprintf(stderr,"Refusing qualification on %s (%s)\n",p.name,p.gcnArchName);return 77;}
+        hipUUID uuid{};hipcheck(hipDeviceGetUuid(&uuid,device));
+        std::printf("device=%s arch=%s uuid=",p.name,p.gcnArchName);
+        for(unsigned char c:uuid.bytes)std::printf("%02x",c);std::puts("");
+        size_t free=0,total=0;hipcheck(hipMemGetInfo(&free,&total));
+        if(free<total-total/10)throw std::runtime_error("GPU is not idle");
+        for(bool fp8:{false,true}) {
+            for(int n:{1,2,10,11,63,64,65,256})run_case(n,fp8,true,true,true,0);
+            run_case(1,fp8,false,true,true,1);
+            run_case(11,fp8,false,true,false,0);
+            run_case(65,fp8,false,true,false,0);
+            for(int n:{1,25,256})run_case(n,fp8,true,true,true,0,2048);
+        }
+        std::puts("PASS: 28 cases against an independent FP64 attention oracle");return 0;
+    }catch(const std::exception& e){std::fprintf(stderr,"FAIL: %s\n",e.what());return 1;}
+}
diff --git a/libr3d/tests/w2a8_planes.cpp b/libr3d/tests/w2a8_planes.cpp
