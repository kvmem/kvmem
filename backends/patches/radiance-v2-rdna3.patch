+++ b/libr3d/r3d_attn_paged_h256_gqa6.hip
@@ -0,0 +1,53 @@
+/* gfx110x port of Radiance v2.0.0 libhalo h256/gqa6. See attn_h256/PORT-PROVENANCE.json.
+ * Only ordinary launches, block 16, full attention and BF16/FP8 KV are registered.
+ * Device memory stays device memory: this path never dereferences operands on the host.
+ * GPU execution and performance qualification on gfx110x are still required. */
+#include "r3d_attn_h256_contract.h"
+#include "attn_h256/r3da_attn_args.h"
+#include "attn_h256/r3da_attn_prefill_h256_gqa6.hip"
+#include "attn_h256/r3da_attn_decode_h256_gqa6.hip"
+
+extern "C" void r3da_attn_dims(int* hd, int* gqa, int* bs, int* rows) {
+    if (hd) *hd = 256; if (gqa) *gqa = 6; if (bs) *bs = 16; if (rows) *rows = 64;
+}
+extern "C" void r3da_cfg_split(const RadArgs* a, R3daSplitCfg* out) {
+    out->splits = (int)r3d_geti_or(a, "splits", 0);
+}
+
+namespace {
+constexpr int kPrefillWarps = 24, kPrefillTile = 48, kPrefillOpt = 3954187;
+
+template<bool Decode, int KVP>
+int launch(const RadArgs* a, RadStream stream) {
+    const int valid = r3d_attn_h256_validate(a, Decode, KVP ? RAD_BF16 : RAD_F8E4M3);
+    if (valid != RAD_OK) return valid;
+    R3daArgs r;
+    int rc;
+    if constexpr (Decode) {
+        rc = decode_common<256, 6, 16, R3DA_D_OPT>(a, &r);
+        if (rc != RAD_OK) return rc;
+        return decode_launch<256, 6, 16, R3DA_D_OPT, KVP>(&r, (hipStream_t)stream);
+    } else {
+        rc = fill_paged(a, &r, 256);
+        if (rc != RAD_OK) return rc;
+        r3da_prefill_split_setup<kPrefillWarps, kPrefillTile, 256, 6>(a, &r);
+        return r3da_prefill_launch<kPrefillWarps, kPrefillTile, 256, 6, 16, KVP, kPrefillOpt>(
+            &r, (hipStream_t)stream);
+    }
+}
+}
+
+extern "C" int r3d_rad_attn_h256_bf16_decode(const RadArgs* a, RadStream s) { return launch<true, 1>(a, s); }
+extern "C" int r3d_rad_attn_h256_bf16_prefill(const RadArgs* a, RadStream s) { return launch<false, 1>(a, s); }
+extern "C" int r3d_rad_attn_h256_fp8_decode(const RadArgs* a, RadStream s) { return launch<true, 0>(a, s); }
+extern "C" int r3d_rad_attn_h256_fp8_prefill(const RadArgs* a, RadStream s) { return launch<false, 0>(a, s); }
+extern "C" int64_t r3d_attn_h256_decode_scratch(const RadArgs* a) {
+    const int rc = r3d_attn_h256_scratch_contract(a, true);
+    if (rc != RAD_OK) return rc;
+    return decode_scratch<256, 6, 16, R3DA_D_OPT>(a);
+}
+extern "C" int64_t r3d_attn_h256_prefill_scratch(const RadArgs* a) {
+    const int rc = r3d_attn_h256_scratch_contract(a, false);
+    if (rc != RAD_OK) return rc;
+    return r3da_prefill_scratch<kPrefillWarps, kPrefillTile, 256, 6>(a);
+}
