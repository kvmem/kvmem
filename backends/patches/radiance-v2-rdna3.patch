+    if (!live) return;
+    l_i += swap16(l_i);
+    if (nsplit > 1 && ne == 1 && h == 0) pML[1] = -1.0f;     // stored below, merge skips it
+    if (ne > 1) {
+        // The partial: O times the V descale, unnormalised; m_ref is the reference both O and l
+        // are exponentiated against (each carries the same 2^PSHIFT, which the merge cancels).
+        #pragma unroll
+        for (int dt = 0; dt < NKS; ++dt)
+            #pragma unroll
+            for (int e = 0; e < 8; ++e)
+                pO[dt * 16 + 2 * e + h] = acc[dt][e] * vdesc;
+        if (h == 0) { pML[0] = m_ref; pML[1] = l_i; }
+        return;
+    }
+    const float inv = (l_i > 0.0f) ? (vdesc / l_i) : 0.0f;
+    uint16_t* op = (uint16_t*)a.out
+                 + ((size_t)(qoff + qpos) * a.q_heads + qhead) * HEAD_DIM;
+    // gfx1151: accumulator element e is head dim 2*e + (lane >> 4), one value a lane, so the store
+    // is a scatter of eight 16-bit values rather than one 16-byte write.
+    #pragma unroll
+    for (int dt = 0; dt < NKS; ++dt)
+        #pragma unroll
+        for (int e = 0; e < 8; ++e)
+            op[dt * 16 + 2 * e + h] = f32_to_bf16(acc[dt][e] * inv);
+}
+
+// ================================================================== split-KV prefill
+//
+// The query-tiled grid is q tiles x KV heads x sequences. A short chunk over a long context -- a
+// q_len of 11 at 16K tokens, four KV heads -- is four workgroups, each walking the whole context
+// alone on one of the 20 WGPs (one 768-thread workgroup fills a WGP), so it ran at the speed of a
+// q_len-64 chunk: 6.4 ms where reading the cache once is ~0.2. Splitting the tile range across
+// workgroups (flash-decoding) fills the part; r3da_attn_prefill_merge combines the partials. The
+// partial buffer is the row's scratch, sized by its hook; without it (or with too little) the
+// launch runs unsplit, the kernel as before.
+
+// The count a launch of these args takes, before the scratch check.
+template <int BQ, int TILE>
+static inline int r3da_prefill_splits_for(const R3daArgs& a) {
+    const int qtiles = (a.q_len + BQ - 1) / BQ;
+    const int units  = qtiles * a.kv_heads * a.num_seqs;
+    const int tiles  = (a.max_ctx + TILE - 1) / TILE;
+    return r3da_prefill_splits(units, tiles,
+                               r3da_prefill_split_bytes(r3da_q_total(a), a.q_heads, a.head_dim));
+}
+
+// Picks r->splits for a launch: the law's count when the caller's scratch holds its partials,
+// else as many as fit, else 1 (unsplit, no scratch read). Call after fill_paged*.
+template <int NWARPS, int TILE, int HEAD_DIM, int GQA>
+static inline void r3da_prefill_split_setup(const RadArgs* ra, R3daArgs* r) {
+    constexpr int BQ = (NWARPS * 16) / GQA;
+    r->splits = 1;
+    const int s = r3da_prefill_splits_for<BQ, TILE>(*r);
+    if (s <= 1 || !ra->scratch || ra->scratch_bytes <= 0) return;
+    const long long per = r3da_prefill_split_bytes(r3da_q_total(*r), r->q_heads, HEAD_DIM);
+    const long long fit = per > 0 ? ra->scratch_bytes / per : 0;
+    const int n = (int)std::min<long long>(s, fit);
+    if (n > 1) { r->splits = n; r->scratch = ra->scratch; }
+}
+
+// The scratch hook: the largest partial buffer the law asks for over every q_len up to the band's
+// bound and every sequence count up to max_seqs (parameters at declare time); from the tensors
+// when the parameters are absent. 0 when no launch in the band splits.
+template <int NWARPS, int TILE, int HEAD_DIM, int GQA>
+static inline int64_t r3da_prefill_scratch(const RadArgs* a, long long row = 0) {
+    constexpr int BQ = (NWARPS * 16) / GQA;
+    const long long n_head   = r3da_geti_or(a, "n_head", 0);
+    const long long max_seqs = r3da_geti_or(a, "max_seqs", 0);
+    const long long max_ctx  = r3da_geti_or(a, "max_ctx", 0);
+    const long long band     = r3da_geti_or(a, "q_len", 0);
+    if (n_head > 0 && max_seqs > 0 && max_ctx > 0 && band > 0) {
+        const long long gqa = r3da_geti_or(a, "gqa", GQA);
+        const long long kvh = gqa > 0 ? n_head / gqa : n_head;
+        const int tiles = (int)((max_ctx + TILE - 1) / TILE);
+        int64_t worst = 0;
+        for (long long n = 1; n <= max_seqs; ++n)
+            for (long long qt = 1; (qt - 1) * BQ < band; ++qt) {
+                const long long units = qt * kvh * n;
+                if (units >= R3DA_P_UNITS_MAX) break;
+                const long long q = std::min<long long>(qt * BQ, band);
+                const long long per = r3da_prefill_split_bytes(n * q, n_head, HEAD_DIM);
+                const int s = r3da_prefill_splits((int)units, tiles, per);
+                if (s > 1 && s * per > worst) worst = s * per;
+            }
+        return worst;
+    }
+    R3daArgs r;
+    const int rc = fill_paged_row(a, &r, HEAD_DIM, row > 0 ? row : 2LL * HEAD_DIM);
+    if (rc != RAD_OK) return 0;      // no tensors either: the launch runs unsplit
+    const int s = r3da_prefill_splits_for<BQ, TILE>(r);
+    return s > 1 ? (int64_t)s * r3da_prefill_split_bytes(r3da_q_total(r), r.q_heads, HEAD_DIM) : 0;
+}
+
+// Combine the splits' partials into bf16 out: one wave a (token, q head) row, HEAD_DIM / 32 dims a
+// lane. A row whose split 0 says l < 0 belongs to an empty sequence and is left as the plain kernel
+// leaves it.
+template <int HEAD_DIM>
+__global__ __launch_bounds__(256)
+void r3da_attn_prefill_merge(const float* __restrict__ part, uint16_t* __restrict__ out,
+                             int rows, int nsplit)
+{
+    constexpr int DPL = HEAD_DIM / 32;
+    const int row = (int)blockIdx.x * 8 + (int)(threadIdx.x >> 5);
+    const int lane = threadIdx.x & 31;
+    if (row >= rows) return;
+    const float* ml = part + (size_t)nsplit * rows * HEAD_DIM;
+    if (ml[(size_t)row * 2 + 1] < 0.0f) return;
+    float mx = -3.0e38f;
+    for (int s = 0; s < nsplit; ++s) mx = fmaxf(mx, ml[((size_t)s * rows + row) * 2]);
+    float o[DPL];
+    #pragma unroll
+    for (int i = 0; i < DPL; ++i) o[i] = 0.0f;
+    float l = 0.0f;
+    for (int s = 0; s < nsplit; ++s) {
+        const float m_s = ml[((size_t)s * rows + row) * 2];
+        const float l_s = ml[((size_t)s * rows + row) * 2 + 1];
+        if (!(l_s > 0.0f)) continue;           // an empty split: O was never written
+        const float w = exp2f(m_s - mx);
+        l += w * l_s;
+        const float* src = part + ((size_t)s * rows + row) * HEAD_DIM + lane * DPL;
+        #pragma unroll
+        for (int i = 0; i < DPL; ++i) o[i] += w * src[i];
+    }
+    const float inv = (l > 0.0f) ? 1.0f / l : 0.0f;
+    uint16_t* dst = out + (size_t)row * HEAD_DIM + lane * DPL;
+    #pragma unroll
+    for (int i = 0; i < DPL; ++i) dst[i] = f32_to_bf16(o[i] * inv);
+}
+
+// The launch every prefill geometry shares: the attention kernel over q tiles x KV heads x
+// (sequences x splits), then the merge when it split. Returns 0 or -100 - hipError_t.
+template <int NWARPS, int TILE, int HEAD_DIM, int GQA, int BS, int KVP, int OPT, int WIN = 0>
+static int r3da_prefill_launch(const R3daArgs* a, hipStream_t s) {
+    constexpr int BQ = (NWARPS * 16) / GQA;
+    R3daArgs r = *a;
+    if (!(r.splits > 1 && r.scratch)) r.splits = 1;
+    dim3 grid((r.q_len + BQ - 1) / BQ, r.kv_heads, r.num_seqs * r.splits);
+    hipLaunchKernelGGL((r3da_attn_prefill_kernel<NWARPS, TILE, HEAD_DIM, GQA, BS, KVP, OPT, WIN>),
+                       grid, dim3(NWARPS * 32), 0, s, r);
+    hipError_t e = hipGetLastError();
+    if (e != hipSuccess) return -100 - (int)e;
+    if (r.splits > 1) {
+        const int rows = r3da_q_total(r) * r.q_heads;
+        hipLaunchKernelGGL((r3da_attn_prefill_merge<HEAD_DIM>), dim3((rows + 7) / 8), dim3(256),
+                           0, s, (const float*)r.scratch, (uint16_t*)r.out, rows, r.splits);
+        e = hipGetLastError();
+        if (e != hipSuccess) return -100 - (int)e;
+    }
+    return 0;
+}
diff --git a/libr3d/attn_h256/r3da_chain.h b/libr3d/attn_h256/r3da_chain.h
new file mode 100644
--- /dev/null
+++ b/libr3d/attn_h256/r3da_chain.h
@@ -0,0 +1,92 @@
+/* Imported from libhalo/halo_chain.h at Radiance v2.0.0 / ddcb9c69.
+ * Mechanical halo -> r3da identifier rename; arithmetic unchanged.
+ * See PORT-PROVENANCE.json. gfx110x execution is not yet qualified. */
+/* Derived from libr4d/r4d_chain.h by the libr3da rename transform (2026-10-26);
+ * see libr3da/README.md. Op schemas, row names and stored weight layouts are
+ * shared with libr4d by design. Everything else in this file is libr3da's own
+ * and diverges as it is measured on gfx1151. */
+// r3da_chain.h -- a chained launch's wait and completion (RadKernelChainFn, abi/rad_abi.h).
+//
+// Between two dependent kernels on one queue the packet processor waits for the first to finish
+// before it launches the second (the AQL barrier bit): on 4x R9700, ~1.3 ms of a 14 ms DFlash2 step
+// on the 31B. A chained launch drops the bit. The engine writes a record into the
+// kernel's argument slot, and the kernel waits for its queue's completion counter to reach the
+// blocks issued before it, then adds its own blocks as they finish. A kernel's chained form
+// (`CHAIN` true) brackets its body with r3da_chain_wait / r3da_chain_done; the plain form never reads
+// the record, so a launch from outside the engine (r3da_selftest, rad-kbench) is untouched.
+//
+// Every block must reach r3da_chain_done exactly once, so a kernel whose blocks return early keeps
+// its body in a __device__ function called from the chained wrapper.
+#pragma once
+#include <hip/hip_runtime.h>
+#include "rad_abi.h"
+
+#if !defined(__HIP__)
+/* The host SIMT emulator (tests/r3da_emu) compiles some of these sources as C++: no engine record
+ * ever reaches a launch there, so a chained form is its plain form. */
+__device__ __forceinline__ void r3da_chain_wait() {}
+__device__ __forceinline__ void r3da_chain_done() {}
+#else
+
+struct R3daChainRec {
+    unsigned long long  magic, target;
+    unsigned long long* ctr;
+    unsigned long long  check;
+};
+
+// The record, or null where it is not the engine's. Read from the argument segment (scalar loads)
+// at both ends of the kernel, so nothing is held across the body: a register-heavy body (the
+// split-KV decode attention) would otherwise pay for the pointer.
+__device__ __forceinline__ const R3daChainRec* r3da_chain_rec() {
+    const R3daChainRec* r = (const R3daChainRec*)((const char*)__builtin_amdgcn_kernarg_segment_ptr() +
+                                                RAD_CHAIN_KARG_OFF);
+    const unsigned long long magic = r->magic, target = r->target, check = r->check;
+    const unsigned long long* ctr = r->ctr;
+    if (magic != RAD_CHAIN_MAGIC ||
+        check != (magic ^ target ^ (unsigned long long)(uintptr_t)ctr ^ RAD_CHAIN_CHECK))
+        return nullptr;
+    return r;
+}
+
+// Before the first read of an operand: one lane waits for the counter to reach the target.
+// Every resident block polls the same word, so a wide kernel launched behind a long one (a GEMM
+// behind a junction's all-reduce) would put hundreds of loads into one L2 channel every few dozen
+// clocks for as long as the wait lasts, slowing whatever else that channel serves. The first
+// R3DA_CHAIN_FAST polls are ~64 clocks apart, the rest R3DA_CHAIN_SLOW x 64: a long wait ends at most
+// that much late and puts 1/R3DA_CHAIN_SLOW of the load on the channel.
+#ifndef R3DA_CHAIN_FAST
+#define R3DA_CHAIN_FAST 8
+#endif
+#ifndef R3DA_CHAIN_SLOW
+#define R3DA_CHAIN_SLOW 16
+#endif
+__device__ __forceinline__ void r3da_chain_wait() {
+    const R3daChainRec* r = r3da_chain_rec();
+    if (!r) return;
+    if (threadIdx.x == 0 && threadIdx.y == 0 && threadIdx.z == 0) {
+        const unsigned long long target = r->target;
+        unsigned long long* ctr = r->ctr;
+        int n = 0;
+        while (__hip_atomic_load(ctr, __ATOMIC_RELAXED, __HIP_MEMORY_SCOPE_AGENT) < target) {
+            if (n < R3DA_CHAIN_FAST) {
+                __builtin_amdgcn_s_sleep(1);
+                ++n;
+            } else {
+                __builtin_amdgcn_s_sleep(R3DA_CHAIN_SLOW);
+            }
+        }
+    }
+    __syncthreads();
+    __builtin_amdgcn_fence(__ATOMIC_ACQUIRE, "agent");
+}
+
+// After the block's last write: release, then one add a block.
+__device__ __forceinline__ void r3da_chain_done() {
+    const R3daChainRec* r = r3da_chain_rec();
+    if (!r) return;
+    __builtin_amdgcn_fence(__ATOMIC_RELEASE, "agent");
+    __syncthreads();
+    if (threadIdx.x == 0 && threadIdx.y == 0 && threadIdx.z == 0)
+        __hip_atomic_fetch_add(r->ctr, 1ull, __ATOMIC_RELEASE, __HIP_MEMORY_SCOPE_AGENT);
+}
+#endif  /* __HIP__ */
diff --git a/libr3d/attn_h256/r3da_common.h b/libr3d/attn_h256/r3da_common.h
new file mode 100644
--- /dev/null
+++ b/libr3d/attn_h256/r3da_common.h
@@ -0,0 +1,328 @@
+/* Imported from libhalo/halo_common.h at Radiance v2.0.0 / ddcb9c69.
+ * Mechanical halo -> r3da identifier rename; arithmetic unchanged.
+ * See PORT-PROVENANCE.json. gfx110x execution is not yet qualified. */
+/* Derived from libr4d/r4d_common.h by the libr3da rename transform (2026-10-26);
+ * see libr3da/README.md. Op schemas, row names and stored weight layouts are
+ * shared with libr4d by design. Everything else in this file is libr3da's own
+ * and diverges as it is measured on gfx1151. */
+// Shared device-side machinery for R3da. The layout algebra here was verified on hardware with
+// targeted probes; do not "fix" it from a vendor doc.
+#pragma once
+#include <hip/hip_runtime.h>
+#include <cstdint>
+
+// The W4A8 scale group lives here, not in either GEMM, because both read the same packed weight and
+// a disagreement would be silently wrong, not a link error. r3da_gemm_args.h restates it and checks
+// it against the layout constant.
+#define R3DA_GEMM_W4A8_GROUP 128      // K per scale
+
+// ---- ragged query batches ----------------------------------------------------------------------
+// A paged-attention batch may have a different query length per sequence (R3daArgs::cu_q in r3da.h).
+// These are the two lookups every kernel indexing the dense q or out block needs, plus the inverse
+// for the split-KV combine, which walks output rows rather than sequences. With cu_q null they
+// compile to one multiply and no load; the branch is wave-uniform (cu_q is a kernel argument).
+__device__ __forceinline__ int r3da_q_off(const int* cu_q, int seq, int q_len) {
+    return cu_q ? cu_q[seq] : seq * q_len;
+}
+__device__ __forceinline__ int r3da_q_len(const int* cu_q, int seq, int q_len) {
+    return cu_q ? (cu_q[seq + 1] - cu_q[seq]) : q_len;
+}
+// num_seqs is at most a few tens, so the search is a few scalar loads, once per block.
+__device__ __forceinline__ int r3da_q_seq(const int* cu_q, int num_seqs, int q_len, int tok) {
+    if (!cu_q) return tok / q_len;
+    int lo = 0, hi = num_seqs;                       // invariant: cu_q[lo] <= tok < cu_q[hi]
+    while (hi - lo > 1) {
+        const int mid = (lo + hi) >> 1;
+        if (cu_q[mid] <= tok) lo = mid; else hi = mid;
+    }
+    return lo;
+}
+
+// ---- the occupancy a kernel is built for ---------------------------------------------------------
+// R3DA_WAVES(n) fixes the waves per SIMD the compiler schedules a kernel for. Otherwise the
+// scheduler picks that target itself and the choice moves between compiler releases (LLVM 24
+// serialises a GEMM's loads to win one more wave, paying a load round trip per WMMA). A kernel
+// whose speed rests on a register budget states it here. `n` may depend on template arguments.
+#define R3DA_WAVES(n) __attribute__((amdgpu_waves_per_eu((n), (n))))
+
+typedef short    v8s __attribute__((ext_vector_type(8)));
+typedef float    v8f __attribute__((ext_vector_type(8)));
+typedef float    v2f __attribute__((ext_vector_type(2)));   // what cvt_pk_f32_fp8 actually returns
+
+/* A 16-byte staging register as a native vector. HIP's uint4 is a class template wrapping a
+ * union, and an array of them carried across a K loop (the next tile's chunks) is kept in scratch
+ * by LLVM 22 and 24, adding a scratch store and load per chunk; an ext_vector_type array is
+ * promoted to registers. Loaded and stored whole only. r3da_dflash_conv_body.h declares the same
+ * type for a source also compiled without this header. */
+typedef unsigned int r3da_u32x4 __attribute__((ext_vector_type(4)));
+
+// exp2 with the hardware transcendental.
+
+__device__ __forceinline__ float ex2(float x) {
+#if __has_builtin(__builtin_amdgcn_exp2f)
+    return __builtin_amdgcn_exp2f(x);
+#else
+    return exp2f(x);
+#endif
+}
+
+// f32 -> bf16, round-to-nearest-even, in software: gfx1201 has no v_cvt_pk_bf16_f32.
+__device__ __forceinline__ uint16_t f32_to_bf16(float f) {
+    uint32_t u = __builtin_bit_cast(uint32_t, f);
+    return (uint16_t)((u + 0x7fffu + ((u >> 16) & 1u)) >> 16);
+}
+
+// And back: a shift, since every bf16 is exactly a float.
+__device__ __forceinline__ float bf16_to_f32(uint16_t h) {
+    return __builtin_bit_cast(float, (uint32_t)h << 16);
+}
+
+// ---- 16-bit values held in whole registers -------------------------------------------------------
+// LLVM 24 gives gfx12 real 16-bit registers: a 16-bit value lives in one half of a VGPR. Packing
+// two bf16 then costs a shift and a half move per pair instead of one v_perm_b32, widening costs a
+// half move and a shift, and a 16-bit load into a half (global_load_d16_b16) depends on the
+// register's earlier contents, so the waitcnt pass waits for them. The helpers below keep bf16 data
+// in whole 32-bit registers from load to store, which compiles the same under LLVM 22 and 24 and
+// gives the same bits as the 16-bit forms.
+
+// f32 -> bf16 rounded to nearest even, as the high half of a word whose low half is not zero
+// (f32_to_bf16 before its final shift). A NaN can round to infinity, as there.
+__device__ __forceinline__ uint32_t bf16_hi_rne(float f) {
+    const uint32_t u = __float_as_uint(f);
+    return u + 0x7fffu + ((u >> 16) & 1u);
+}
+// Rounds as (__hip_bfloat16)f does (LLVM's expansion): a NaN stays NaN, quieted; everything else
+// rounds to nearest even. Both results are formed before the select so it compiles to one
+// v_cndmask; `nan ? u | 0x400000 : u + ...` makes each element an exec-masked branch.
+__device__ __forceinline__ uint32_t bf16_hi_rne_nan(float f) {
+    const uint32_t u = __float_as_uint(f);
+    const uint32_t r = u + 0x7fffu + ((u >> 16) & 1u), q = u | 0x400000u;
+    return f != f ? q : r;
+}
+// Two such words as one bf16 pair, `lo`'s high half in the low half: one byte permute.
+__device__ __forceinline__ uint32_t bf16_pack_hi(uint32_t lo, uint32_t hi) {
+    return __builtin_amdgcn_perm(hi, lo, 0x07060302u);
+}
+// Two floats as a bf16 pair (`lo` in the low half), rounded as f32_to_bf16 rounds.
+__device__ __forceinline__ uint32_t bf16x2_rne(float lo, float hi) {
+    return bf16_pack_hi(bf16_hi_rne(lo), bf16_hi_rne(hi));
+}
+// Two floats as a bf16 pair, rounded as (__hip_bfloat16) rounds.
+__device__ __forceinline__ uint32_t bf16x2_rne_nan(float lo, float hi) {
+    return bf16_pack_hi(bf16_hi_rne_nan(lo), bf16_hi_rne_nan(hi));
+}
+// A bf16 pair word's two values as floats: a shift and a mask, no conversion.
+__device__ __forceinline__ float bf16w_lo(uint32_t w) { return __uint_as_float(w << 16); }
+__device__ __forceinline__ float bf16w_hi(uint32_t w) { return __uint_as_float(w & 0xffff0000u); }
+
+// One 16-bit element of global memory, zero-extended into a whole register (global_load_u16).
+// Loaded as uint16_t it would go into a register half (global_load_d16_b16 or d16_hi_b16) and wait
+// for the other half; through a generic pointer it would also be a flat load. The pointer must
+// address global memory.
+typedef __attribute__((address_space(1))) const uint16_t* r3da_gu16;
+__device__ __forceinline__ uint32_t ldg_u16(const uint16_t* p) { return *(r3da_gu16)p; }
+
+// `lane ^ N` without the LDS pipe. `__shfl_xor` lowers to `ds_bpermute_b32` plus `s_wait_dscnt`,
+// an LDS round trip that dominates a dependency chain (e.g. a dot product closed in a token loop).
+// gfx10+ DPP16 has ROW_XMASK (0x160 | N), so for N < 16 the partner read is a modifier on the
+// consuming VALU op (`v_add_f32_dpp ... row_xmask:2`). N = 16 crosses the two 16-lane rows of a
+// wave32 and uses v_permlanex16, still one VALU op. Same lane mapping and value as the shuffle,
+// provided all lanes are active, which every caller's whole-wave butterfly guarantees.
+template <int N>
+__device__ __forceinline__ uint32_t r3da_xor_lane_u32(uint32_t v) {
+    static_assert(N >= 1 && N <= 16 && (N & (N - 1)) == 0, "a lane xor within the wave");
+    if constexpr (N < 16)
+        return (uint32_t)__builtin_amdgcn_update_dpp(0, (int)v, 0x160 | N, 0xf, 0xf, true);
+    else
+        return (uint32_t)__builtin_amdgcn_permlanex16((int)v, (int)v, 0x76543210u, 0xFEDCBA98u,
+                                                      false, false);
+}
+
+template <int N>
+__device__ __forceinline__ float r3da_xor_lane(float v) {
+    return __uint_as_float(r3da_xor_lane_u32<N>(__float_as_uint(v)));
+}
+
+// A 64-bit value's partner: the halves exchanged separately, as a 64-bit `__shfl_xor` does.
+template <int N>
+__device__ __forceinline__ unsigned long long r3da_xor_lane_u64(unsigned long long v) {
+    const uint32_t lo = r3da_xor_lane_u32<N>((uint32_t)v);
+    const uint32_t hi = r3da_xor_lane_u32<N>((uint32_t)(v >> 32));
+    return ((unsigned long long)hi << 32) | lo;
+}
+
+// Exchange between lane L and lane L^16 (the two halves a wave32 WMMA fragment splits a row
+// across). v_permlanex16_b32 swaps only with identity selectors (each 4-bit field names the source
+// lane in the other half; sel0 covers lanes 0-7, sel1 lanes 8-15); zero selectors would silently
+// broadcast lane 0.
+__device__ __forceinline__ float swap16(float x) { return r3da_xor_lane<16>(x); }
+
+// A wave32 sum on DPP instead of the LDS crossbar. `__shfl_xor` is a `ds_bpermute_b32` on gfx1201
+// at any offset, queued behind other LDS traffic; where little arithmetic separates reductions, a
+// five-stage shuffle butterfly dominates the run. Offsets 8..1 use row_xmask (dpp_ctrl 0x160 | N)
+// as a modifier on the add; 16 uses v_permlanex16_b32 (see swap16).
+//
+// The lanes exchanged and the order of the adds match the shuffle loop, so this is bit-identical
+// and a kernel can move onto it without its output changing. Row and bank masks are all-ones since
+// every lane participates; `bound_ctrl` is moot because every lane has a partner.
+template <int CTRL>
+__device__ __forceinline__ float r3da_dpp_xor_add(float v) {
+    return v + __builtin_bit_cast(float,
+        __builtin_amdgcn_update_dpp(0, __builtin_bit_cast(int, v), CTRL, 0xF, 0xF, true));
+}
+
+__device__ __forceinline__ float r3da_wave_sum(float v) {
+    v += swap16(v);                        /* xor 16 -- crosses the two rows of sixteen */
+    v = r3da_dpp_xor_add<0x168>(v);         /* xor  8 -- row_xmask from here down */
+    v = r3da_dpp_xor_add<0x164>(v);         /* xor  4 */
+    v = r3da_dpp_xor_add<0x162>(v);         /* xor  2 */
+    v = r3da_dpp_xor_add<0x161>(v);         /* xor  1 */
+    return v;
+}
+
+// The same butterfly over a group of W lanes (W a power of two up to the wave): the exchanges of
+// `for (o = W / 2; o; o >>= 1) v = op(v, __shfl_xor(v, o))`, in its order, so bit-identical to
+// that loop.
+template <int W>
+__device__ __forceinline__ float r3da_xor_sum(float v) {
+    static_assert(W >= 1 && W <= 32 && (W & (W - 1)) == 0, "a power-of-two group within the wave");
+    if constexpr (W >= 32) v += r3da_xor_lane<16>(v);
+    if constexpr (W >= 16) v += r3da_xor_lane<8>(v);
+    if constexpr (W >= 8)  v += r3da_xor_lane<4>(v);
+    if constexpr (W >= 4)  v += r3da_xor_lane<2>(v);
+    if constexpr (W >= 2)  v += r3da_xor_lane<1>(v);
+    return v;
+}
+
+template <int W>
+__device__ __forceinline__ float r3da_xor_max(float v) {
+    static_assert(W >= 1 && W <= 32 && (W & (W - 1)) == 0, "a power-of-two group within the wave");
+    if constexpr (W >= 32) v = fmaxf(v, r3da_xor_lane<16>(v));
+    if constexpr (W >= 16) v = fmaxf(v, r3da_xor_lane<8>(v));
+    if constexpr (W >= 8)  v = fmaxf(v, r3da_xor_lane<4>(v));
+    if constexpr (W >= 4)  v = fmaxf(v, r3da_xor_lane<2>(v));
+    if constexpr (W >= 2)  v = fmaxf(v, r3da_xor_lane<1>(v));
+    return v;
+}
+
+__device__ __forceinline__ float r3da_wave_max(float v) { return r3da_xor_max<32>(v); }
+
+/* A wave's inclusive prefix and suffix sums in registers: row_shr (or row_shl) 1, 2, 4 and 8
+ * within each row of sixteen, then the other row's total from one readlane. Lane L ends with the
+ * sum over lanes 0..L (prefix) or L..31 (suffix). Replaces LDS step-doubling scans (two barriers a
+ * round); integer sums, so combine order does not matter. Every lane must be active. */
+__device__ __forceinline__ uint32_t r3da_wave_prefix_u32(uint32_t x, int lane) {
+    x += (uint32_t)__builtin_amdgcn_update_dpp(0, (int)x, 0x111, 0xF, 0xF, true);   /* row_shr:1 */
+    x += (uint32_t)__builtin_amdgcn_update_dpp(0, (int)x, 0x112, 0xF, 0xF, true);   /* row_shr:2 */
+    x += (uint32_t)__builtin_amdgcn_update_dpp(0, (int)x, 0x114, 0xF, 0xF, true);   /* row_shr:4 */
+    x += (uint32_t)__builtin_amdgcn_update_dpp(0, (int)x, 0x118, 0xF, 0xF, true);   /* row_shr:8 */
+    const uint32_t lo = (uint32_t)__builtin_amdgcn_readlane((int)x, 15);
+    return lane >= 16 ? x + lo : x;
+}
+
+__device__ __forceinline__ uint32_t r3da_wave_suffix_u32(uint32_t x, int lane) {
+    x += (uint32_t)__builtin_amdgcn_update_dpp(0, (int)x, 0x101, 0xF, 0xF, true);   /* row_shl:1 */
+    x += (uint32_t)__builtin_amdgcn_update_dpp(0, (int)x, 0x102, 0xF, 0xF, true);   /* row_shl:2 */
+    x += (uint32_t)__builtin_amdgcn_update_dpp(0, (int)x, 0x104, 0xF, 0xF, true);   /* row_shl:4 */
+    x += (uint32_t)__builtin_amdgcn_update_dpp(0, (int)x, 0x108, 0xF, 0xF, true);   /* row_shl:8 */
+    const uint32_t hi = (uint32_t)__builtin_amdgcn_readlane((int)x, 16);
+    return lane < 16 ? x + hi : x;
+}
+
+// 8x8 transpose of 16-bit elements across each group of 8 lanes. Lane j receives element j from
+// each of the 8 lanes in its group; the 8 addresses may be arbitrarily strided.
+//
+// gfx1151 has no global_load_tr_b128, so this loads each lane's 16 B and transposes in registers:
+// lane (base+i)'s output element j is lane (base+j)'s loaded element i, eight shuffles of the one
+// dword that holds it. Same result, more instructions; a caller on a hot path should say so in
+// its header so the transpose can be folded into its addressing instead.
+__device__ __forceinline__ v8s load_tr_b128(const void* p) {
+    const uint4 v = *(const uint4*)p;
+    const uint32_t w[4] = { v.x, v.y, v.z, v.w };
+    const int lane = (int)(threadIdx.x & 31u);
+    const int base = lane & ~7, i = lane & 7;
+    uint32_t o[4] = { 0, 0, 0, 0 };
+    // A shuffle returns the value the SOURCE lane passed, so a lane cannot ask for "my element i"
+    // in one shuffle: at lane base+j the argument `w[i >> 1]` is evaluated with THAT lane's i (j),
+    // not this one's. Fetch all four of the source lane's dwords and select this lane's element
+    // afterwards -- that is the transpose, and it is 32 shuffles rather than 8.
+#pragma unroll
+    for (int j = 0; j < 8; ++j) {
+        const uint32_t d0 = (uint32_t)__shfl((int)w[0], base + j, 32);
+        const uint32_t d1 = (uint32_t)__shfl((int)w[1], base + j, 32);
+        const uint32_t d2 = (uint32_t)__shfl((int)w[2], base + j, 32);
+        const uint32_t d3 = (uint32_t)__shfl((int)w[3], base + j, 32);
+        const int d = i >> 1;
+        const uint32_t wd = d == 0 ? d0 : d == 1 ? d1 : d == 2 ? d2 : d3;
+        const uint32_t e = (i & 1) ? (wd >> 16) : (wd & 0xffffu);
+        o[j >> 1] |= e << (16 * (j & 1));
+    }
+    v8s r;
+    __builtin_memcpy(&r, o, sizeof(o));
+    return r;
+}
+
+// Gather the low (sel=0) or high (sel=1) byte of each of four 16-bit lanes of {w0,w1} into one
+// dword. Written so the compiler can contract each to a single v_perm_b32.
+__device__ __forceinline__ uint32_t byte_gather(uint32_t w0, uint32_t w1, int sel) {
+    uint32_t s = (uint32_t)sel * 8u;
+    return ((w0 >> s) & 0xffu)
+         | (((w0 >> (16 + s)) & 0xffu) << 8)
+         | (((w1 >> s) & 0xffu) << 16)
+         | (((w1 >> (16 + s)) & 0xffu) << 24);
+}
+
+__device__ __forceinline__ void sched_barrier() { __builtin_amdgcn_sched_barrier(0); }
+
+// __syncthreads() is a workgroup-scope acquire-release fence over all address spaces, so on gfx12
+// it emits `global_inv scope:SCOPE_SE` on both sides, discarding the L0/L1 lines the next tile's
+// KV loads would hit. These barriers only order LDS traffic, so the fence is scoped to the local
+// address space and the invalidate disappears.
+__device__ __forceinline__ void lds_barrier() {
+    __builtin_amdgcn_fence(__ATOMIC_RELEASE, "workgroup", "local");
+    __builtin_amdgcn_s_barrier();
+    __builtin_amdgcn_fence(__ATOMIC_ACQUIRE, "workgroup", "local");
+}
+
+// Two-dword form of swap16.
+__device__ __forceinline__ uint2 swap16_u2p(uint2 v) {
+    return make_uint2(__builtin_bit_cast(uint32_t, swap16(__builtin_bit_cast(float, v.x))),
+                      __builtin_bit_cast(uint32_t, swap16(__builtin_bit_cast(float, v.y))));
+}
+
+// ---------------------------------------------------------------------------------------------
+// Workgroup width for the activation-path kernels
+//
+// had_quant_act_i8, rmsnorm_had_quant_i8, gated_had_quant_i8 and gdn_gated_norm_had_quant_i8 launch
+// one workgroup per row, so at decode batch sizes the grid is a few tens of workgroups on a 64-CU
+// part and they are latency bound. Widening the workgroup is the only knob that adds parallelism,
+// and it is the large win at small M.
+//
+// It reverses once the grid alone fills the machine. At 1024 threads there is a residency cliff
+// just past M=32 where the wider workgroup stops fitting and the cost roughly doubles, so 1024 is
+// used only with clearance below it.
+//
+// Where 512 stops paying depends on K, because the K floats of LDS a row needs cap how many
+// workgroups a CU holds. At K=8704 only one fits at either width, so wider wins out to large M; at
+// K=3072 five fit, the grid fills the part, and past M~72 the narrow width is even. The thresholds
+// below are those crossovers.
+__host__ __device__ __forceinline__ int r3da_act_threads(int M, int K) {
+    if (M <= 32) return 1024;
+    const int lim = K >= 8192 ? (1 << 24) : (K >= 4096 ? 120 : 72);
+    return M <= lim ? 512 : 256;
+}
+
+// libr4d's r4d_cliff_rows pads a grid past the R9700's full-card cliff (a launch in the last 32
+// wavefronts below a multiple of its 2048 wave slots runs ~5x slower). gfx1151 has no such cliff:
+// measured 2026-10-26 with a fixed 200-iteration kernel at 256-thread workgroups, per-launch time
+// rises smoothly through both candidate multiples (253..258 blocks: 10.18 -> 10.46 us, against the
+// R9700's 27.6 vs 5.2), with only the ordinary second-round step at 161 blocks -- 160 blocks x 8
+// waves = 1280 = 40 CUs x 2 SIMDs x 16 wave slots exactly. So the row count to launch is the row
+// count asked for, and this stays a function because every launch site already calls it: if a
+// future part or driver grows a cliff, the pad goes back here and nowhere else.
+__host__ __device__ __forceinline__ uint32_t r3da_cliff_rows(uint32_t rows, uint32_t per_row,
+                                                            uint32_t waves) {
+    (void)per_row;
+    (void)waves;
+    return rows;
+}
diff --git a/libr3d/attn_h256/r3da_dt16.h b/libr3d/attn_h256/r3da_dt16.h
new file mode 100644
--- /dev/null
+++ b/libr3d/attn_h256/r3da_dt16.h
@@ -0,0 +1,186 @@
+/* Imported from libhalo/halo_dt16.h at Radiance v2.0.0 / ddcb9c69.
+ * Mechanical halo -> r3da identifier rename; arithmetic unchanged.
+ * See PORT-PROVENANCE.json. gfx110x execution is not yet qualified. */
+/* Derived from libr4d/r4d_dt16.h by the libr3da rename transform (2026-10-26),
+ * then ported to gfx1151; see libr3da/README.md. */
+// r3da_dt16.h -- 16-bit operand traits for the attention kernels, gfx1151.
+//
+// This is the gfx11 counterpart of libr4d's DT16 layer, and the difference is the
+// whole porting story for attention. The two architectures disagree on what one
+// lane holds (r3da_wmma.h states the layouts and how they were measured):
+//
+//                        a lane's A / B fragment      the k its element e holds
+//   gfx1201 (RDNA4)      8 x 16-bit (4 dwords)       k = 8*(half) + e, half = lane>>4
+//   gfx1151 (RDNA3.5)   16 x 16-bit (8 dwords)       k = e   (lanes 16-31 replicate)
+//
+// libr4d's attention kernels are built around a transposed score matrix
+// S^T = K.Q^T so that the D column -- the query -- stays (lane & 15) on both
+// architectures; r3da_wmma.h notes that this is why those kernels are portable
+// at all. What changes is the ROW: on gfx12 a lane's accumulator element e is
+// key 8*half + e of the 16-key tile, on gfx11 it is key 2*e + (lane>>4). Both
+// spread the tile's sixteen keys over the half-pair, so the kernels' existing
+// swap16 (lane ^ 16) row-max / row-sum reductions keep their meaning; a port
+// changes the key index and the fragment width, not the softmax algebra.
+//
+//   * mk()        takes the lane's EIGHT dwords (16 values) instead of four.
+//   * gather      reads 32 bytes at the un-split k offset (no 8*half term).
+//   * P fragments the softmax's eight values are keys 2e+half; a 16-consecutive
+//                 key fragment is assembled across the half-pair (see p16w).
+//   * store       each lane writes its eight values at head dim 2e+half.
+//
+// Both sources are exact in either 16-bit format (an fp8 e4m3 K/V has 3 mantissa
+// bits, bf16 7, f16 10), so DT16<0> (bf16) and DT16<1> (f16) stay interchangeable
+// for correctness; they differ in range and in convert cost, as r4d_dt16.h says.
+// gfx1151 has no v_cvt_pk_bf16_f32 either, so DT16<0>::pk is the software RTNE
+// r3da_wmma.h already uses, and f16 packs two floats in one instruction.
+#pragma once
+#include <hip/hip_runtime.h>
+#include <cstdint>
+#include "r3da_common.h"
+#include "r3da_wmma.h"       // v16bf / v16hf / v8f, r3da::mma, pk_bf16, pk_f16, f32_to_bf16
+#include "r3da_fp8_wmma.h"   // e4m3_pk: the exact e4m3 unpack (no fp8 convert insts on gfx11)
+
+typedef __fp16 v2hf_dt __attribute__((ext_vector_type(2)));
+
+// GROW = how many octaves the running row max may exceed the reference max before the
+// accumulator must be rescaled, exactly as r4d_dt16.h defines it for each format.
+template <int F16> struct DT16;
+
+template <> struct DT16<0> {                     // bf16: exponent range of f32
+    typedef v16bf frag;
+    static constexpr float SHIFT = 0.0f;
+    static constexpr float GROW  = 60.0f;        // 2^60 * |v| * n stays far under f32 max
+
+    // From the lane's eight dwords, i.e. its full sixteen-value k run in order.
+    __device__ __forceinline__ static frag mk(const uint32_t w[8]) {
+        union { uint32_t u[8]; frag f; } q;
+#pragma unroll
+        for (int i = 0; i < 8; ++i) q.u[i] = w[i];
+        return q.f;
+    }
+    __device__ __forceinline__ static v8f wmma(frag a, frag b, v8f c) { return r3da::mma(a, b, c); }
+    __device__ __forceinline__ static uint32_t pk(float x, float y) { return r3da::pk_bf16(x, y); }
+    // Two f32 to two bf16 in a dword, element order (no lane-half permutation on gfx11).
+    __device__ __forceinline__ static uint32_t pkv(v2f x) {
+        union { v2f f; float e[2]; } s;
+        s.f = x;
+        return r3da::pk_bf16(s.e[0], s.e[1]);
+    }
+    __device__ __forceinline__ static uint32_t from_bf16w(uint32_t w) { return w; }   // identity
+};
+
+template <> struct DT16<1> {                     // f16: 3 more mantissa bits, 1 convert instead of 6
+    typedef v16hf frag;
+    static constexpr float SHIFT = 0.0f;
+    static constexpr float GROW  = 14.0f;        // p <= 2^14 = 16384 < 65504
+
+    __device__ __forceinline__ static frag mk(const uint32_t w[8]) {
+        union { uint32_t u[8]; frag f; } q;
+#pragma unroll
+        for (int i = 0; i < 8; ++i) q.u[i] = w[i];
+        return q.f;
+    }
+    __device__ __forceinline__ static v8f wmma(frag a, frag b, v8f c) { return r3da::mma(a, b, c); }
+    __device__ __forceinline__ static uint32_t pk(float x, float y) { return r3da::pk_f16(x, y); }
+    __device__ __forceinline__ static uint32_t pkv(v2f x) {
+        union { v2f f; float e[2]; } s;
+        s.f = x;
+        return r3da::pk_f16(s.e[0], s.e[1]);
+    }
+    // two bf16 in a dword -> two f16 in a dword (bf16->f32 is a shift, so three VALU).
+    __device__ __forceinline__ static uint32_t from_bf16w(uint32_t w) {
+        return r3da::pk_f16(__builtin_bit_cast(float, w << 16),
+                            __builtin_bit_cast(float, w & 0xffff0000u));
+    }
+};
+
+// Widen sixteen fp8 (four dwords) to the lane's eight 16-bit dwords, in element order.
+// On gfx12 the same widening is eight values with a lane-half permute; on gfx11 every lane
+// holds the whole 16-wide run, so this is the four dwords twice over and no permute.
+template <class D>
+__device__ __forceinline__ void fp8x16_to_16x8w(uint4 raw, uint32_t w8[8]) {
+    const uint32_t d[4] = { raw.x, raw.y, raw.z, raw.w };
+#pragma unroll
+    for (int q = 0; q < 4; ++q) {
+        w8[q * 2 + 0] = D::pkv(r3da_fp8::e4m3_pk<false>(d[q]));
+        w8[q * 2 + 1] = D::pkv(r3da_fp8::e4m3_pk<true>(d[q]));
+    }
+}
+
+// Widen eight fp8 (two dwords) to four 16-bit dwords in element order -- the narrow form,
+// kept for the kernels that stage fewer than sixteen k at a time (r4d's fp8x8_to_16x4w).
+template <class D>
+__device__ __forceinline__ void fp8x8_to_16x4w(uint2 raw, uint32_t w4[4]) {
+#pragma unroll
+    for (int q = 0; q < 2; ++q) {
+        const int wv = (q == 0) ? (int)raw.x : (int)raw.y;
+        w4[q * 2 + 0] = D::pkv(r3da_fp8::e4m3_pk<false>(wv));
+        w4[q * 2 + 1] = D::pkv(r3da_fp8::e4m3_pk<true>(wv));
+    }
+}
+
+/* Eight k6_v4 codes as four f16 dwords, dims (2i, 2i+1) in dword i -- r4d_dt16.h's
+ * k6x8_to_f16x4w, unchanged: the unpack is exact integer/scale arithmetic and touches no
+ * WMMA layout, so it ports as it stands. `half` selects which eight of the sixteen dims a
+ * caller wants; a gfx1151 16-wide fragment asks for both halves into w8[0..7]. */
+__device__ __forceinline__ void k6x8_to_f16x4w(uint32_t lo, uint32_t hb, int half, uint32_t s2,
+                                               uint32_t* w4) {
+    typedef _Float16 h2 __attribute__((ext_vector_type(2)));
+    const uint32_t ev = ((lo & 0x0F0F0F0Fu) | ((half ? hb : hb << 4) & 0x30303030u)) ^ 0x20202020u;
+    const uint32_t od = (((lo >> 4) & 0x0F0F0F0Fu) | ((half ? hb >> 2 : hb << 2) & 0x30303030u))
+                      ^ 0x20202020u;
+    const h2 s = __builtin_bit_cast(h2, s2);
+    const h2 bias = { (_Float16)1056.0f, (_Float16)1056.0f };
+#pragma unroll
+    for (int b = 0; b < 4; ++b) {
+        const uint32_t sel = (uint32_t)b | 0x0c00u | ((uint32_t)(4 + b) << 16) | 0x0c000000u;
+        const uint32_t x = __builtin_amdgcn_perm(od, ev, sel) | 0x64006400u;
+        w4[b] = __builtin_bit_cast(uint32_t, (__builtin_bit_cast(h2, x) - bias) * s);
+    }
+}
+
+/* Build a 16-consecutive-key P fragment from the lane's eight softmax values.
+ *
+ * On gfx1151 a lane's accumulator element e is key 2*e + (lane>>4) of the tile, so a lane holds
+ * the keys of ONE parity and the other eight live in lane ^ 16 -- the same split the kernels
+ * already reduce across for the row max and row sum. The WMMA's A operand wants the sixteen keys
+ * in order, so the halves are interleaved here: four lane-16 exchanges move the partner's four
+ * dwords across, then key k takes element k>>1 from whichever half owns parity k&1. `w` is the
+ * lane's own four dwords (its eight keys in order); `p16` the assembled eight. */
+template <class D>
+__device__ __forceinline__ void p16w(const uint32_t w[4], uint32_t p16[8]) {
+    (void)sizeof(D);
+    const int mine_h = (int)((threadIdx.x >> 4) & 1);   // the parity this lane holds
+    uint32_t o[4];
+#pragma unroll
+    for (int i = 0; i < 4; ++i) o[i] = r3da_xor_lane_u32<16>(w[i]);
+#pragma unroll
+    for (int i = 0; i < 8; ++i) p16[i] = 0u;
+#pragma unroll
+    for (int k = 0; k < 16; ++k) {
+        const int e = k >> 1;                                 // accumulator element index
+        const uint32_t src = (((k & 1) == mine_h) ? w : o)[e >> 1];
+        const uint32_t v16 = (e & 1) ? (src >> 16) : (src & 0xFFFFu);
+        p16[k >> 1] |= v16 << ((k & 1) ? 16 : 0);
+    }
+}
+
+/* The store side of the same mapping: project a 16-consecutive-dim accumulator onto the lane's
+ * eight values. O's row is the head dim and its column the query (lane & 15), so a lane's
+ * element e is head dim 2*e + (lane>>4) -- the values it packs are at even (or odd) dims in
+ * order, and each is written at its own offset. Returned as the lane's eight 16-bit values in
+ * element order; a caller stores element e at dim 2*e + (lane>>4). */
+template <class D>
+__device__ __forceinline__ void o8w(const float acc[8], float inv, uint32_t w4[4]) {
+    uint32_t v[8];
+#pragma unroll
+    for (int e = 0; e < 8; ++e) v[e] = D::pk(acc[e] * inv, 0.0f) & 0xFFFFu;
+#pragma unroll
+    for (int i = 0; i < 4; ++i) w4[i] = v[i * 2] | (v[i * 2 + 1] << 16);
+}
+
+/* Did any lane of the wave take the branch? The row-max test is wave-wide because the
+ * accumulator rescale it guards must be taken by the whole half-pair together. */
+__device__ __forceinline__ int wave_any(bool c) {
+    return (int)__builtin_amdgcn_ballot_w32(c);
+}
diff --git a/libr3d/attn_h256/r3da_fp8_frag.h b/libr3d/attn_h256/r3da_fp8_frag.h
new file mode 100644
--- /dev/null
+++ b/libr3d/attn_h256/r3da_fp8_frag.h
@@ -0,0 +1,44 @@
+/* Imported from libhalo/halo_fp8_frag.h at Radiance v2.0.0 / ddcb9c69.
+ * Mechanical halo -> r3da identifier rename; arithmetic unchanged.
+ * See PORT-PROVENANCE.json. gfx110x execution is not yet qualified. */
+/* Derived from libr4d/r4d_fp8_frag.h by the libr3da rename transform (2026-10-26);
+ * see libr3da/README.md. Op schemas, row names and stored weight layouts are
+ * shared with libr4d by design. Everything else in this file is libr3da's own
+ * and diverges as it is measured on gfx1151. */
+// r3da_fp8_frag.h -- where a byte of a block-scaled FP8 weight lives in WMMA fragment order. Pure
+// C++ (no HIP, no r3da.h) so the host layout hook and the device kernels share one definition.
+//
+// Why permute: the fp8a8 GEMMs read operands through r3da_fp8::frag(), which wants lane `l` to hold
+// row `l & 15` of a 16-row tile at k `(l >> 4) * 8`, eight bytes. From a row-major weight those
+// sixteen rows are `K` bytes apart, so a wave's load is sixteen transactions; the kernels stage
+// through LDS to transpose, at the cost of a barrier, 36 KiB per block and a second pass over the
+// weight. In fragment order the bytes are already in lane order.
+//
+// Why 64 k and not 16: a single fragment (16 rows x 16 k = 256 bytes) gives a wave one 256-byte
+// cacheline per request, which loses even to LDS staging. Four fragments give each lane 32
+// contiguous bytes and the wave a 1 KiB request, which beats both at every N and K in the family.
+//
+// The unit is a (16 row, 64 k) tile of 1024 bytes, laid out as 32 lanes x 32 bytes. Lane `l`'s
+// 32 bytes are its four fragments back to back: bytes `8t` are fragment `t`, covering
+// k `t*16 + (l>>4)*8` of row `l & 15`.
+//
+// K must be a multiple of 64 and N of 16; the 128 scale block already guarantees both.
+#pragma once
+#include <cstdint>
+
+namespace r3da_fp8 {
+
+enum { kFragRows = 16, kFragK = 16, kSuperK = 64, kTileBytes = 1024, kLaneBytes = 32 };
+
+// Bytes one [N][K] weight occupies in fragment order: exactly N*K, since this is a permutation.
+inline int64_t frag_bytes(int64_t N, int64_t K) { return N * K; }
+
+// The source (row, k) of a given (tile, lane, fragment, byte). The single definition of the
+// permutation: the host transform walks it forwards, the device kernels index it backwards.
+inline void frag_src(int64_t rt, int64_t ks, int64_t lane, int64_t t, int64_t j,
+                     int64_t* row, int64_t* k) {
+    *row = rt * (int64_t)kFragRows + (lane & 15);
+    *k   = ks * (int64_t)kSuperK + t * (int64_t)kFragK + (lane >> 4) * 8 + j;
+}
+
+}  // namespace r3da_fp8
diff --git a/libr3d/attn_h256/r3da_fp8_wmma.h b/libr3d/attn_h256/r3da_fp8_wmma.h
new file mode 100644
--- /dev/null
+++ b/libr3d/attn_h256/r3da_fp8_wmma.h
@@ -0,0 +1,123 @@
+/* Imported from libhalo/halo_fp8_wmma.h at Radiance v2.0.0 / ddcb9c69.
+ * Mechanical halo -> r3da identifier rename; arithmetic unchanged.
+ * See PORT-PROVENANCE.json. gfx110x execution is not yet qualified. */
+/* Derived from libr4d/r4d_fp8_wmma.h by the libr3da rename transform (2026-10-26);
+ * see libr3da/README.md. Op schemas, row names and stored weight layouts are
+ * shared with libr4d by design. Everything else in this file is libr3da's own
+ * and diverges as it is measured on gfx1151. */
+// Shared device code for the block-scaled FP8 family: the E4M3 decoders and the bf16 block-scale
+// load. libr4d's version of this header also carries the gfx12 fp8 WMMA fragment map and its LDS
+// staging; gfx1151 has no fp8 matrix instruction, so r3da's fp8 GEMMs dequantise to bf16 in
+// registers and run on r3da_wmma.h's bf16 WMMA instead. That machinery lands with the fp8 GEMM
+// units, in r3da_wmma.h's terms; nothing here pretends otherwise.
+#pragma once
+#include "r3da_common.h"
+#include "r3da_fp8_frag.h"
+
+#include <hip/hip_runtime.h>
+#include <cstdint>
+
+namespace r3da_fp8 {
+
+/* The fp8 matrix machinery (libr4d's mma/mma8, fragment map and staging) is not
+ * carried over: it names gfx12 instructions and a fragment layout this part does
+ * not have. The fp8 GEMM units bring their own, built on r3da_wmma.h. */
+
+// ---- E4M3 -> f32 -------------------------------------------------------------------------------
+//
+// One instruction on gfx1201 (v_cvt_f32_fp8); the software fallback is ~11 VALU ops. They agree on
+// all bytes except 0x7F and 0xFF, E4M3-fn's NaN encodings: hardware returns NaN, the fallback
+// +-480. Both quantisers clamp to +-448 = 0x7E, so real data never holds them.
+//
+// No subnormal-free fast path: a checkpoint weight may hold subnormals, which such a path would
+// decode as 2^-7 * 1.MMM instead of MMM * 2^-9.
+__device__ __forceinline__ float e4m3(uint32_t b) {
+#if __has_builtin(__builtin_amdgcn_cvt_f32_fp8)
+    return __builtin_amdgcn_cvt_f32_fp8(b, 0);
+#else
+    const uint32_t sign = (b & 0x80u) << 24;
+    const uint32_t ex   = (b >> 3) & 0x0Fu;
+    const uint32_t mn   = b & 0x07u;
+    const float nrm = __uint_as_float(((ex + 120u) << 23) | (mn << 20));
+    const float sub = (float)mn * (1.0f / 512.0f);
+    return __uint_as_float(__float_as_uint(ex ? nrm : sub) | sign);
+#endif
+}
+
+// Two E4M3 bytes of a packed dword to two f32 in one instruction (v_cvt_pk_f32_fp8). `HI` selects
+// bytes 2,3 over 0,1 and is a template parameter because the builtin's word select is a constant.
+// Returns r3da_common.h's `v2f`, the builtin's own return type.
+template <bool HI>
+__device__ __forceinline__ v2f e4m3_pk(uint32_t q) {
+#if __has_builtin(__builtin_amdgcn_cvt_pk_f32_fp8)
+    return __builtin_amdgcn_cvt_pk_f32_fp8(q, HI);
+#else
+    constexpr uint32_t s = HI ? 16u : 0u;
+    v2f r;
+    r.x = e4m3((q >> s) & 0xFFu);
+    r.y = e4m3((q >> (s + 8u)) & 0xFFu);
+    return r;
+#endif
+}
+
+// ---- f32 -> E4M3 -------------------------------------------------------------------------------
+//
+// gfx1151 has no v_cvt_pkfp8_f32 (fp8-conversion-insts), so the encode is software. It is a
+// transcription of abi/rad_plugin.h's rad_f32_to_fp8e4m3 -- round-to-nearest-even in both the
+// normal and subnormal branches, saturating at 448, NaN to 0x7f -- because that function is the
+// reference every fp8 store is checked against; a faster form must first be shown to agree with
+// it on every input class (the host probe in the unit's bring-up compared 2^31 values).
+__device__ __forceinline__ uint32_t f32_to_e4m3(float f) {
+    const uint32_t u = __builtin_bit_cast(uint32_t, f);
+    const uint32_t s = (u >> 24) & 0x80u;
+    const uint32_t a = u & 0x7fffffffu;
+    if (a > 0x7f800000u) return s | 0x7fu;                    /* nan */
+    if (a >= 0x43e00000u) return s | 0x7eu;                   /* >= 448: clamp to the largest */
+    const int e = (int)(a >> 23) - 127;
+    uint32_t m = a & 0x7fffffu;
+    if (e < -10) return s;
+    if (e < -6) {                                             /* subnormal fp8 */
+        const int sh = -6 - e + 20;
+        m |= 0x800000u;
+        const uint32_t lo = m & ((1u << sh) - 1u);
+        uint32_t q = m >> sh;
+        const uint32_t half = 1u << (sh - 1);
+        if (lo > half || (lo == half && (q & 1u))) ++q;
+        return s | q;
+    }
+    uint32_t q = m >> 20;
+    const uint32_t lo = m & 0xfffffu;
+    if (lo > 0x80000u || (lo == 0x80000u && (q & 1u))) ++q;
+    int ee = e + 7;
+    if (q == 0x8u) { q = 0; ++ee; }
+    if (ee > 15 || (ee == 15 && q >= 7u)) return s | 0x7eu;
+    return s | ((uint32_t)ee << 3) | q;
+}
+
+/* __builtin_amdgcn_cvt_pk_fp8_f32's shape (two encodes into one half of `old`), so a call site
+ * moves onto it by name alone. Callers still clamp to +-448 first, as they did for the hardware
+ * instruction, whose out-of-range result is NaN rather than saturation; with the clamp the bytes
+ * are the same ones. */
+__device__ __forceinline__ int cvt_pk_fp8_f32(float lo_f, float hi_f, int old, bool word_sel) {
+    const uint32_t pair = f32_to_e4m3(lo_f) | (f32_to_e4m3(hi_f) << 8);
+    const uint32_t o = (uint32_t)old;
+    return (int)(word_sel ? (o & 0x0000ffffu) | (pair << 16) : (o & 0xffff0000u) | pair);
+}
+
+// ---- block scale --------------------------------------------------------------------------------
+//
+// The checkpoint's BF16 `weight_scale_inv` (one per 128x128 tile, row-major) is read natively:
+// decode is one shift and one bitcast. Converting to UE8M0 would round every tile's gain to a
+// power of two and force requantising the E4M3 bytes, for no saving (the scale plane is 21.8 KiB
+// against an 89 MiB weight at gate_proj's shape). Unlike UE8M0, bf16 needs no zero test:
+// `0u << 16` is +0.0f.
+__device__ __forceinline__ float bscale(uint16_t s) {
+    return __uint_as_float((uint32_t)s << 16);
+}
+/* The same scale zero-extended in a full register (see u16_load_w in r3da_moe.hip). The upper
+ * sixteen bits must be zero. */
+__device__ __forceinline__ float bscale(uint32_t s) {
+    return __uint_as_float(s << 16);
+}
+
+}  // namespace r3da_fp8
