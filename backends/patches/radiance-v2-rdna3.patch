diff --git a/libr3d/r3d_w2a8_planes.h b/libr3d/r3d_w2a8_planes.h
new file mode 100644
--- /dev/null
+++ b/libr3d/r3d_w2a8_planes.h
@@ -0,0 +1,43 @@
+// Host-only description of the canonical joined scale/zero operand. Windows
+// cannot dereference device VRAM. Reconstruct offsets with the SAME planner as
+// the loader, after validating the source planes at layout/relayout time; do not
+// read back an immutable header on every decode step or cache device addresses.
+#pragma once
+#include "rad_planes.h"
+#include <climits>
+#include <cstring>
+
+inline int64_t r3d_w2a8_plan(int64_t n, int64_t k, RadPlanesEntry (&e)[2]) {
+    if (n < 1 || n > INT_MAX || k < 128 || k > INT_MAX || k % 128) return -1;
+    RadEncoding enc{};
+    enc.n_planes = 2;
+    rad_enc_copy_str(enc.plane[0].role, "scale");
+    rad_enc_copy_str(enc.plane[1].role, "zero");
+    RadTensor planes[2]{};
+    for (int i = 0; i < 2; ++i) {
+        auto& p = enc.plane[i];
+        p.dtype = i ? RAD_U8 : RAD_F16;
+        p.kind = RAD_PLANE_TILED; p.block[0] = 1; p.block[1] = 128;
+        auto& t = planes[i];
+        t.dtype = p.dtype; t.rank = 2; t.shape[0] = n; t.shape[1] = k / 128;
+    }
+    const int sel[2] = {0, 1};
+    return rad_planes_plan(&enc, sel, planes, 2, e);
+}
+
+inline int r3d_w2a8_validate_planes(const RadEncoding* enc, const int* sel,
+                                   const RadTensor* planes, int count, int64_t n, int64_t k) {
+    RadPlanesEntry expected[2], actual[2];
+    const int64_t bytes = r3d_w2a8_plan(n, k, expected);
+    if (count != 2 || bytes < 0 || !enc || !sel || !planes) return RAD_E_SHAPE;
+    if (rad_planes_plan(enc, sel, planes, count, actual) != bytes) return RAD_E_SHAPE;
+    for (int i = 0; i < 2; ++i) {
+        const auto& a = actual[i]; const auto& b = expected[i];
+        if (std::strncmp(a.role, b.role, RAD_ENC_STR) || a.dtype != b.dtype ||
+            a.kind != b.kind || a.block[0] != b.block[0] || a.block[1] != b.block[1])
+            return RAD_E_DTYPE;
+        if (planes[i].rank != 2 || a.rows != b.rows || a.cols != b.cols ||
+            a.row_bytes != b.row_bytes || a.offset != b.offset) return RAD_E_SHAPE;
+    }
+    return RAD_OK;
+}
diff --git a/libr3d/r3d_windows_device.h b/libr3d/r3d_windows_device.h
new file mode 100644
--- /dev/null
+++ b/libr3d/r3d_windows_device.h
@@ -0,0 +1,22 @@
+#pragma once
+#ifdef _WIN32
+#include <dxgi.h>
+#include <cwchar>
+// Inventory without HIP initialization during DLL loading. Do not restrict a
+// kernel family by product name: build_target and embedded code objects describe
+// the compiled architectures. An AMD adapter here is only an inventory check.
+inline int r3d_windows_device_open() {
+    IDXGIFactory1* factory = nullptr;
+    if (FAILED(CreateDXGIFactory1(__uuidof(IDXGIFactory1), (void**)&factory)))
+        return RAD_E_UNSUPPORTED;
+    bool found = false;
+    IDXGIAdapter1* adapter = nullptr;
+    for (UINT i = 0; factory->EnumAdapters1(i, &adapter) == S_OK; ++i) {
+        DXGI_ADAPTER_DESC1 d{};
+        if (SUCCEEDED(adapter->GetDesc1(&d)) && d.VendorId == 0x1002) found = true;
+        adapter->Release();
+    }
+    factory->Release();
+    return found ? RAD_OK : RAD_E_UNSUPPORTED;
+}
+#endif
