diff --git a/libr3d/r3d_attn_h256_contract.h b/libr3d/r3d_attn_h256_contract.h
new file mode 100644
--- /dev/null
+++ b/libr3d/r3d_attn_h256_contract.h
@@ -0,0 +1,106 @@
+/* Host-readable admission checks for the new, deliberately bounded h256 path. */
+#pragma once
+#include "r3d_args.h"
+#include <climits>
+#include <initializer_list>
+
+// Bound every narrowing in the imported launch helpers, including 32-bit Windows long.
+// Decode partials use at most 256 splits and 520 bytes per query/head row.
+static inline bool r3d_attn_h256_extent(long long tokens, long long heads, bool decode) {
+    const long long limit = decode ? INT_MAX / (256 * 520) : INT_MAX / 256;
+    return tokens > 0 && heads > 0 && heads <= 65535 && tokens <= limit / heads;
+}
+
+static inline int r3d_attn_h256_params(const RadArgs* a, bool decode) {
+    if (!a) return RAD_E_INVAL;
+    if (r3d_geti_or(a, "head_dim", 0) != 256 || r3d_geti_or(a, "gqa", 0) != 6 ||
+        r3d_geti_or(a, "block_size", 16) != 16 || r3d_geti_or(a, "window", 0) != 0)
+        return RAD_E_SHAPE;
+    const auto q = r3d_geti_or(a, "q_len", 0);
+    if (q < 1 || q > INT_MAX / 256 || (decode ? q > 10 : q < 11)) return RAD_E_SHAPE;
+    const auto causal = r3d_geti_or(a, "causal", 1);
+    if (causal != 0 && causal != 1) return RAD_E_INVAL;
+    // Match the imported upstream rows: this path is qualified for causal attention.
+    if (causal != 1) return RAD_E_UNSUPPORTED;
+    // libr3d does not expose a chained launch provider.
+    if (r3d_geti_or(a, "chain", 0) != 0) return RAD_E_UNSUPPORTED;
+    const auto splits = r3d_geti_or(a, "splits", 0);
+    if (splits < 0 || splits > 256) return RAD_E_INVAL;
+    return RAD_OK;
+}
+
+// Scratch hooks are also called at declare time with parameters but no tensors.
+static inline int r3d_attn_h256_declare(const RadArgs* a, bool decode) {
+    const int rc = r3d_attn_h256_params(a, decode);
+    if (rc != RAD_OK) return rc;
+    const auto nh = r3d_geti_or(a, "n_head", 0);
+    const auto ns = r3d_geti_or(a, "max_seqs", 0);
+    const auto ctx = r3d_geti_or(a, "max_ctx", 0);
+    if (nh <= 0 || nh > 65535 || nh % 6 || ns <= 0 || ns > 65535 ||
+        ctx <= 0 || ctx > INT_MAX - 64 ||
+        !r3d_attn_h256_extent(ns * r3d_geti_or(a, "q_len", 0), nh, decode))
+        return RAD_E_SHAPE;
+    return RAD_OK;
+}
+
+static inline int r3d_attn_h256_validate(const RadArgs* a, bool decode, uint32_t kv_dtype) {
+    const int rc = r3d_attn_h256_params(a, decode);
+    if (rc != RAD_OK) return rc;
+    const int required[] = {0, 1, 2, 3, 7};
+    for (int i : required) {
+        const auto* t = r3d_opt(a, i);
+        if (!t || !t->data) return RAD_E_INVAL;
+        if (t->rank < 1 || t->rank > 4) return RAD_E_SHAPE;
+        long long elements = 1;
+        for (uint32_t d = 0; d < t->rank; ++d) {
+            if (t->shape[d] <= 0 || t->shape[d] > INT_MAX || t->stride[d] < 0 ||
+                t->stride[d] > INT_MAX) return RAD_E_SHAPE;
+            if (elements > INT_MAX / t->shape[d]) return RAD_E_SHAPE;
+            elements *= t->shape[d];
+        }
+    }
+    const auto* q = r3d_opt(a, 0); const auto* kv = r3d_opt(a, 1);
+    const auto* bt = r3d_opt(a, 2); const auto* seq = r3d_opt(a, 3); const auto* out = r3d_opt(a, 7);
+    if (q->dtype != RAD_BF16 || out->dtype != RAD_BF16 || kv->dtype != kv_dtype ||
+        bt->dtype != RAD_I32 || seq->dtype != RAD_I32) return RAD_E_DTYPE;
+    if ((q->rank != 2 && q->rank != 3) || kv->rank != 4 || bt->rank != 2 || seq->rank != 1 ||
+        kv->shape[2] != 16 || kv->shape[3] != 512) return RAD_E_SHAPE;
+    const auto heads = kv->shape[1] * 6;
+    if (!r3d_attn_h256_extent(q->shape[0], heads, decode) || bt->shape[0] > 65535)
+        return RAD_E_SHAPE;
+    if ((q->rank == 3 && (q->shape[1] != heads || q->shape[2] != 256)) ||
+        (q->rank == 2 && q->shape[1] != heads * 256)) return RAD_E_SHAPE;
+    if (bt->shape[1] > INT_MAX / 16 || seq->shape[0] != bt->shape[0]) return RAD_E_SHAPE;
+    const auto max_ctx = r3d_geti_or(a, "max_ctx", bt->shape[1] * 16);
+    // max_ctx is a declaration bound used to size splits and scratch. v2's
+    // per-step block table is deliberately narrower for short live contexts;
+    // the kernels walk device seqused lengths, not this declaration bound.
+    if (max_ctx < 0 || max_ctx > INT_MAX - 64)
+        return RAD_E_SHAPE;
+    if (bt->shape[1] * 16 > INT_MAX - 64) return RAD_E_SHAPE;
+    const auto* cu = r3d_opt(a, 6);
+    if (cu && cu->data) {
+        if (cu->dtype != RAD_I32) return RAD_E_DTYPE;
+        if (cu->rank != 1 || cu->shape[0] != bt->shape[0] + 1 || cu->stride[0] != 1)
+            return RAD_E_SHAPE;
+    } else if (q->shape[0] % bt->shape[0] ||
+               q->shape[0] / bt->shape[0] > r3d_geti_or(a, "q_len", 0)) return RAD_E_SHAPE;
+    for (int i : {4, 5}) {
+        const auto* ds = r3d_opt(a, i);
+        if (!ds || !ds->data) continue;
+        if (kv_dtype == RAD_BF16) return RAD_E_DTYPE;
+        if (ds->dtype != RAD_F32) return RAD_E_DTYPE;
+        if (ds->rank != 2 || ds->shape[0] != bt->shape[0] || ds->shape[1] != kv->shape[1] ||
+            ds->stride[1] != 1 || ds->stride[0] != kv->shape[1]) return RAD_E_SHAPE;
+    }
+    return RAD_OK;
+}
+
+static inline int r3d_attn_h256_scratch_contract(const RadArgs* a, bool decode) {
+    if (r3d_geti_or(a, "n_head", 0) > 0 && r3d_geti_or(a, "max_seqs", 0) > 0)
+        return r3d_attn_h256_declare(a, decode);
+    const auto* kv = a ? r3d_opt(a, 1) : nullptr;
+    if (!kv) return RAD_E_INVAL;
+    if (kv->dtype != RAD_BF16 && kv->dtype != RAD_F8E4M3) return RAD_E_DTYPE;
+    return r3d_attn_h256_validate(a, decode, kv->dtype);
+}
