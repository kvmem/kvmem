--- /dev/null
+++ b/libr3d/tests/h256_contract.cpp
@@ -0,0 +1,72 @@
+#include "r3d_attn_h256_contract.h"
+#include <cstdio>
+#include <cstdlib>
+
+static int checks = 0;
+static void expect(int got, int want, const char* label) {
+    ++checks;
+    if (got != want) { std::fprintf(stderr, "%s: %d != %d\n", label, got, want); std::exit(1); }
+}
+struct Fixture {
+    RadTensor t[8]{};
+    RadParam p[9] = {RAD_INT("head_dim",256), RAD_INT("gqa",6), RAD_INT("q_len",1),
+        RAD_INT("max_ctx",256), RAD_INT("n_head",12), RAD_INT("max_seqs",2),
+        RAD_INT("splits",0), RAD_INT("chain",0), RAD_INT("causal",1)};
+    RadArgs a{};
+    Fixture(int qlen=1, uint32_t kv=RAD_BF16) {
+        a.t=t; a.n_t=8; a.p=p; a.n_p=9; p[2].ival=qlen;
+        tensor(0,RAD_BF16,{2*qlen,12,256}); tensor(1,kv,{32,2,16,512});
+        tensor(2,RAD_I32,{2,16}); tensor(3,RAD_I32,{2});
+        tensor(7,RAD_BF16,{2*qlen,12,256});
+    }
+    void tensor(int i,uint32_t dt,std::initializer_list<int64_t> dims) {
+        t[i]={}; t[i].data=(void*)(uintptr_t)(4096*(i+1)); t[i].dtype=dt;
+        for(auto d:dims)t[i].shape[t[i].rank++]=d;
+        rad_tensor_pack(&t[i]);
+    }
+    int valid(bool dec=true,uint32_t dt=RAD_BF16){return r3d_attn_h256_validate(&a,dec,dt);}
+};
+int main() {
+    expect(r3d_attn_h256_params(nullptr,true),RAD_E_INVAL,"null");
+    for(int n:{1,11}) {
+        Fixture f(n); f.p[8].ival=0;
+        expect(f.valid(n<=10),RAD_E_UNSUPPORTED,"noncausal launch refused");
+        expect(r3d_attn_h256_declare(&f.a,n<=10),RAD_E_UNSUPPORTED,"noncausal declaration refused");
+        f.p[8].ival=2; expect(f.valid(n<=10),RAD_E_INVAL,"invalid causal parameter");
+    }
+    for(int n:{1,2,10,11,63,64,65,256}) {
+        Fixture f(n); expect(f.valid(n<=10),RAD_OK,"legal query band");
+        expect(f.valid(n>10),RAD_E_SHAPE,"wrong query band");
+        expect(r3d_attn_h256_declare(&f.a,n<=10),RAD_OK,"declare without reading operands");
+    }
+    {Fixture f; f.p[0].ival=128; expect(f.valid(),RAD_E_SHAPE,"head dim");}
+    {Fixture f; f.p[1].ival=8; expect(f.valid(),RAD_E_SHAPE,"gqa");}
+    {Fixture f; f.p[2].ival=0; expect(f.valid(),RAD_E_SHAPE,"zero query");}
+    {Fixture f; f.t[0].dtype=RAD_F16; expect(f.valid(),RAD_E_DTYPE,"query dtype");}
+    {Fixture f; f.t[1].dtype=RAD_I8; expect(f.valid(),RAD_E_DTYPE,"cache dtype");}
+    {Fixture f; f.t[3].dtype=RAD_I64; expect(f.valid(),RAD_E_DTYPE,"sequence dtype");}
+    {Fixture f; f.t[7].data=nullptr; expect(f.valid(),RAD_E_INVAL,"output absent");}
+    {Fixture f; f.t[1].shape[2]=4; expect(f.valid(),RAD_E_SHAPE,"block size");}
+    {Fixture f; f.t[0].shape[1]=24; expect(f.valid(),RAD_E_SHAPE,"head ratio");}
+    {Fixture f; f.t[3].shape[0]=1; expect(f.valid(),RAD_E_SHAPE,"sequence count");}
+    for(int n:{1,25}) {Fixture f(n); f.p[3].ival=2048; expect(f.valid(n<=10),RAD_OK,"declaration bound above per-step table capacity");}
+    {Fixture f; f.p[3].ival=(int64_t)INT_MAX; expect(f.valid(),RAD_E_SHAPE,"context narrowing bound");}
+    {Fixture f; f.p[3].ival=0; expect(f.valid(),RAD_OK,"implicit context capacity");}
+    {Fixture f; f.tensor(6,RAD_I32,{3}); expect(f.valid(),RAD_OK,"ragged metadata");
+        f.t[6].shape[0]=2; expect(f.valid(),RAD_E_SHAPE,"ragged length");}
+    {Fixture f; f.tensor(4,RAD_F32,{2,2}); expect(f.valid(),RAD_E_DTYPE,"bf16 descale refused");}
+    {Fixture f(1,RAD_F8E4M3); f.tensor(4,RAD_F32,{2,2}); f.tensor(5,RAD_F32,{2,2});
+        expect(f.valid(true,RAD_F8E4M3),RAD_OK,"fp8 descales");
+        f.t[5].stride[0]=3; expect(f.valid(true,RAD_F8E4M3),RAD_E_SHAPE,"descale pitch");}
+    {Fixture f; f.p[6].ival=257; expect(f.valid(),RAD_E_INVAL,"splits overflow");}
+    {Fixture f; f.p[7].ival=1; expect(f.valid(),RAD_E_UNSUPPORTED,"no chain provider");}
+    {Fixture f; f.t[1].stride[0]=(int64_t)INT_MAX+1; expect(f.valid(),RAD_E_SHAPE,"stride narrowing");}
+    {Fixture f; f.t[1].shape[0]=INT_MAX; expect(f.valid(),RAD_E_SHAPE,"element count overflow");}
+    {Fixture f; f.p[4].ival=7; expect(r3d_attn_h256_declare(&f.a,true),RAD_E_SHAPE,"declare head ratio");}
+    {Fixture f; f.p[5].ival=INT_MAX; expect(r3d_attn_h256_declare(&f.a,true),RAD_E_SHAPE,"declare overflow");}
+    {Fixture f; f.p[5].ival=0; expect(r3d_attn_h256_scratch_contract(&f.a,true),RAD_OK,"scratch tensor fallback");}
+    {Fixture f; f.a.t=nullptr; f.a.n_t=0;
+        expect(r3d_attn_h256_scratch_contract(&f.a,true),RAD_OK,"tensorless declaration");
+        f.p[5].ival=0;expect(r3d_attn_h256_scratch_contract(&f.a,true),RAD_E_INVAL,"missing declaration inputs");}
+    std::printf("PASS: %d host admission checks (no GPU execution)\n",checks);
+}
