+extern "C" int rad_kernel_schema_count(void) {
+    return (int)(sizeof(kSchemas) / sizeof(kSchemas[0]));
+}
+extern "C" const RadOpSchema* rad_kernel_schema_at(int i) {
+    if (i < 0 || i >= rad_kernel_schema_count()) return nullptr;
+    return &kSchemas[i];
+}
