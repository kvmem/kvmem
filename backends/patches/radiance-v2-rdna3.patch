@@ -0,0 +1,47 @@
+// CPU-only check of the descriptor-free Windows launch contract.
+#include "r3d_w2a8_planes.h"
+#include <cstdio>
+#include <vector>
+#include <stdexcept>
+static void check(bool ok) { if (!ok) throw std::runtime_error("w2a8 canonical layout mismatch"); }
+int main() {
+    try {
+        for (int n : {1, 63, 64, 124160}) for (int k : {128, 256, 2048, 5120}) {
+            const int g = k / 128;
+            RadEncoding enc{}; enc.n_planes = 3;
+            rad_enc_copy_str(enc.scheme, "affine");
+            const char* names[] = {"codes", "scale", "zero"};
+            uint32_t types[] = {RAD_U2, RAD_F16, RAD_U8};
+            for (int i = 0; i < 3; ++i) {
+                auto& p = enc.plane[i]; rad_enc_copy_str(p.role, names[i]);
+                p.dtype = types[i]; p.kind = RAD_PLANE_TILED;
+                p.block[0] = 1; p.block[1] = i ? 128 : 1;
+            }
+            const int sel[] = {1, 2};
+            std::vector<uint16_t> scales(n * g, 0x3c00);
+            std::vector<uint8_t> zeros(n * g, 3);
+            RadTensor p[2]{};
+            for (int i = 0; i < 2; ++i) {
+                p[i].dtype = types[i + 1]; p[i].rank = 2;
+                p[i].shape[0] = n; p[i].shape[1] = g;
+            }
+            p[0].data = scales.data(); p[1].data = zeros.data();
+            RadPlanesEntry e[2]; const int64_t bytes = r3d_w2a8_plan(n, k, e);
+            check(bytes > 0 && r3d_w2a8_validate_planes(&enc, sel, p, 2, n, k) == RAD_OK);
+            std::vector<uint8_t> joined(bytes);
+            check(rad_planes_relayout(&enc, sel, p, 2, joined.data(), bytes) == RAD_OK);
+            check(rad_planes_find(joined.data(), "scale", nullptr) == joined.data() + e[0].offset);
+            check(rad_planes_find(joined.data(), "zero", nullptr) == joined.data() + e[1].offset);
+            check(!std::memcmp(joined.data()+e[0].offset,scales.data(),scales.size()*2));
+            check(!std::memcmp(joined.data()+e[1].offset,zeros.data(),zeros.size()));
+            --p[1].shape[1]; check(r3d_w2a8_validate_planes(&enc,sel,p,2,n,k) != RAD_OK); ++p[1].shape[1];
+            p[1].dtype = RAD_U2; check(r3d_w2a8_validate_planes(&enc,sel,p,2,n,k) != RAD_OK); p[1].dtype = RAD_U8;
+            rad_enc_copy_str(enc.plane[2].role,"scale");
+            check(r3d_w2a8_validate_planes(&enc,sel,p,2,n,k) != RAD_OK);
+        }
+        RadPlanesEntry e[2];
+        check(r3d_w2a8_plan(INT64_MAX,5120,e) < 0 && r3d_w2a8_plan(64,129,e) < 0);
+        puts("PASS w2a8 canonical layout: 16 shapes, stored bytes, malformed source planes, bounds");
+        return 0;
+    } catch (const std::exception& e) { std::fprintf(stderr,"FAIL %s\n",e.what()); return 1; }
+}
