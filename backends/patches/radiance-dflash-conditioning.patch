+int KVManager::restore_window_tables(uint64_t id, int64_t frontier, int64_t floor,
+                                     const std::vector<WindowTable>& tables) {
+    Seq* sequence = find(id);
+    if (!sequence || sequence->n_tokens != frontier || frontier < 0 || floor < 0 || floor > frontier ||
+        sequence->window_epoch == UINT64_MAX) return RAD_E_STATE;
+    auto next = tables;
+    std::vector<bool> seen(plans_.size(), false);
+    for (const auto& table : next) {
+        const auto* group = plan(table.group);
+        if (!group || group->kind != RAD_KV_WINDOW || !group->drafter || group->zero ||
+            group->runtime_win || sequence->win[(size_t)table.group].set ||
+            seen[(size_t)table.group] || group->block_size <= 0 ||
+            table.first < 0 || table.first > floor || table.first % group->block_size ||
+            int64_t(table.blocks.size()) != ceil_div(frontier - table.first, group->block_size) ||
+            int64_t(table.blocks.size()) > window_seq_cap(*group)) return RAD_E_INVAL;
+        seen[(size_t)table.group] = true;
+        std::set<int32_t> unique;
+        for (auto page : table.blocks) {
+            if (page < 0 || page >= live_blocks(table.group) ||
+                block_refcount(table.group, page) <= 0 || !unique.insert(page).second)
+                return RAD_E_INVAL;
+        }
+    }
+    for (const auto& group : plans_) {
+        if (group.kind == RAD_KV_WINDOW && !group.zero && !seen[(size_t)group.index])
+            return RAD_E_INVAL;
+    }
+    if (next.empty()) return RAD_E_INVAL;
+    for (const auto& table : next) {
+        auto& free = free_blocks_[(size_t)table.group];
+        free.reserve(free.size() + sequence->blocks[(size_t)table.group].size());
+    }
+    // All validation/allocation precedes reference-count and table publication.
+    for (auto& table : next) {
+        for (auto page : table.blocks) add_ref((size_t)table.group, page);
+        sequence->blocks[(size_t)table.group].swap(table.blocks);
+        for (auto page : table.blocks) drop_block(table.group, page);
+        sequence->first_block_pos[(size_t)table.group] = table.first;
+        sequence->dirty_from[(size_t)table.group] = 0;
+    }
+    sequence->window_floor = floor;
+    ++sequence->window_epoch;
+    return RAD_OK;
+}
