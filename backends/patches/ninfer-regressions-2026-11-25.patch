+        require(selected->read()==expected);
+        first.clear(); // Cancelling one request preserves the other and its CP.
+        require(storage.charged_bytes()==prefix_pages*stride);
+        selected.reset();
+        require(storage.charged_bytes()==prefix_pages*stride);
+        second.clear();require(storage.charged_bytes()==0);
+    }
+}
+
+void evicted_source_running_read_keeps_exact_charge() {
+    constexpr size_t stride=16, history_pages=48;
+    auto disk=std::make_shared<SpillFile>(std::filesystem::temp_directory_path(),history_pages*stride);
+    HostKvStorage storage(stride,disk);
+    std::array<uint8_t,stride> expected{};expected.fill(43);
+    std::vector<HostKvRecord> directory_archive;
+    directory_archive.push_back(storage.allocate(stride,expected.data()));directory_archive.back().seal();
+    auto selected=capture_kvmem_snapshot(directory_archive,1,false,storage);
+    for(size_t i=1;i<history_pages;++i) {
+        directory_archive.push_back(storage.allocate(stride));directory_archive.back().seal();
+    }
+    auto branch=fork_kvmem_snapshot(*selected);
+    const auto read_identity=branch[0].storage_identity();
+    auto read_source=branch[0].source();
+    storage.trim(0);
+    require(storage.charged_bytes()==0 && disk->charged_bytes()==history_pages*stride);
+    std::promise<void> started,release;
+    auto gate=release.get_future().share();
+    std::array<uint8_t,stride> actual{};
+    StorageIoQueue queue(2,2*stride,1);
+    OpenGateOnExit release_on_error{release};
+    auto running=queue.submit(stride,[source=read_source,&started,gate,&actual] {
+        auto lease=source.lease();started.set_value();gate.wait();
+        lease.read(0,actual.data(),actual.size());
+    });
+    started.get_future().wait();
+    // The pending copy also owns its source, but cancellation releases it.
+    std::atomic<bool> queued_published{false};
+    auto queued=queue.submit(stride,[source=read_source,&queued_published] { queued_published=true; });
+    require(queued.cancel());
+    require(!running.cancel()); // Started work must drain; it is not freed early.
+    directory_archive.clear();selected.reset();branch.clear();read_source={};
+    require(storage.charged_bytes()==0 && disk->charged_bytes()==stride);
+    require(queue.pinned_bytes()==stride);
+    ninfer::models::qwen3_5::detail::KvmemPayloadBudget cancelled;
+    cancelled.require(read_identity,stride);
+    require(cancelled.used()==disk->charged_bytes());
+    release.set_value();running.wait();
+    try { queued.wait(); } catch(const MemoryError&) {}
+    require(actual==expected && !queued_published);
+    require(storage.charged_bytes()==0 && disk->charged_bytes()==0 && queue.pinned_bytes()==0);
+}
+
+int main() {
+    prepared_payload_budget_counts_real_owners();
+    phase_credit_covers_real_captures();
+    only_storage_budget_becomes_request_overload();
+    evict_long_source_after_fork();
+    evicted_source_running_read_keeps_exact_charge();
+    HostKvStorage storage(4096);
+    {
+        std::array<uint8_t,16> bytes{}; bytes.fill(7);
+        std::vector<HostKvRecord> archive;
+        for (int i=0;i<3;++i) { archive.push_back(storage.allocate(16,bytes.data())); archive.back().seal(); }
+        auto a=capture_kvmem_snapshot(archive,3,true,storage);
+        require(kvmem_snapshot_covers(a,3,16));
+        require(!kvmem_snapshot_covers(a,2,24) && !kvmem_snapshot_covers(a,4,16));
+        require(!kvmem_snapshot_covers({},3,16) && !kvmem_snapshot_covers(a,SIZE_MAX,16));
+        auto old=a->read();
+        auto b=capture_kvmem_snapshot(archive,3,true,storage,a);
+        require(a->blocks()[0]==b->blocks()[0] && a->blocks()[1]==b->blocks()[1]);
+        require(a->blocks()[2]!=b->blocks()[2]);
+        require(storage.charged_bytes()==80);
+        uint8_t changed=99; archive[2].write(3,&changed,1); archive[2].seal();
+        auto c=capture_kvmem_snapshot(archive,3,true,storage,b);
+        require(a->read()==old && b->read()==old && c->read()!=old);
+        require(storage.charged_bytes()==96);
+        // Same logical page index after replay is a new allocation/version.
+        archive[0]=storage.allocate(16,bytes.data()); archive[0].seal();
+        auto replay=capture_kvmem_snapshot(archive,3,true,storage,c);
+        require(replay->blocks()[0]!=c->blocks()[0]);
+        // Independent branches can mutate while their retained source is read.
+        auto left=fork_kvmem_snapshot(*a), right=fork_kvmem_snapshot(*a);
+        std::thread l([&]{uint8_t v=31;left[0].write(0,&v,1);});
+        std::thread r([&]{uint8_t v=32;right[0].write(0,&v,1);});
+        l.join();r.join();require(a->read()==old);
+        require(left[0].data()[0]==31 && right[0].data()[0]==32);
+    }
+    require(storage.charged_bytes()==0);
+    {
+        HostKvStorage tight(16); std::array<uint8_t,16> bytes{};
+        std::vector<HostKvRecord> records; records.push_back(tight.allocate(16,bytes.data()));records[0].seal();
+        bool capture_failed=false;
+        try { capture_kvmem_snapshot(records,1,true,tight); }
+        catch(const MemoryError& e){capture_failed=e.code()==MemoryErrorCode::BudgetExceeded;}
+        require(capture_failed && tight.charged_bytes()==16);
+        auto snapshot=capture_kvmem_snapshot(records,1,false,tight);
+        uint8_t v=1;bool failed=false;
+        try {records[0].write(0,&v,1);} catch(const MemoryError& e){failed=e.code()==MemoryErrorCode::BudgetExceeded;}
+        require(failed && snapshot->read()==std::vector<uint8_t>(16) && tight.charged_bytes()==16);
+    }
+    {
+        auto disk=std::make_shared<SpillFile>(std::filesystem::temp_directory_path(),4096);
+        HostKvStorage cold(32,disk);std::array<uint8_t,16> bytes{};bytes.fill(23);
+        std::vector<HostKvRecord> records;
+        for(int i=0;i<2;++i){records.push_back(cold.allocate(16,bytes.data()));records.back().seal();}
+        auto snapshot=capture_kvmem_snapshot(records,2,false,cold);
+        auto expected=snapshot->read();records.clear();cold.trim(0);
+        require(cold.charged_bytes()==0 && disk->charged_bytes()==32);
+        auto owners=fork_kvmem_snapshot(*snapshot);
+        require(snapshot->read()==expected && cold.charged_bytes()==0);
+        require(disk->stats().read_bytes>=32 && disk->stats().written_bytes==32);
+        owners.clear();snapshot.reset();require(disk->charged_bytes()==0);
+    }
+    {
+        // Cancellation cannot publish queued work or release a running lease.
+        HostKvStorage held(16);std::array<uint8_t,16> bytes{};
+        std::vector<HostKvRecord> records;records.push_back(held.allocate(16,bytes.data()));records[0].seal();
+        auto snapshot=capture_kvmem_snapshot(records,1,false,held);records.clear();
+        StorageIoQueue queue(2,32,1);std::promise<void> started,release;
+        auto gate=release.get_future().share();std::atomic<bool> published{false};
+        auto running=queue.submit(16,[snapshot,&started,gate]{started.set_value();gate.wait();require(snapshot->read().size()==16);});
+        started.get_future().wait();
+        auto queued=queue.submit(16,[snapshot,&published]{published=true;});
+        require(queued.cancel());snapshot.reset();
+        require(held.charged_bytes()==16);
+        release.set_value();running.wait();try{queued.wait();}catch(const std::exception&){}
+        require(!published && held.charged_bytes()==0 && queue.pinned_bytes()==0);
+    }
+    std::cout << "NInfer snapshot host invariants passed (RAM, SSD, cancellation)\n";
+}
diff --git a/tests/test_memory_recovery.cpp b/tests/test_memory_recovery.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..3d68efb1990bca2e1b46288c702cdb4be379d8ad
--- /dev/null
+++ b/tests/test_memory_recovery.cpp
@@ -0,0 +1,95 @@
+#include "runtime/engine/memory_recovery.h"
+#include <nlohmann/json.hpp>
+#include <iostream>
+#include <stdexcept>
+
+void require(bool value) { if (!value) { throw std::runtime_error("memory recovery invariant failed"); } }
+int main() {
+    try {
+        ninfer::EngineOptions options;
+        options.max_context = 262144;
+        options.max_concurrency = 2;
+        options.kvmem.selected_tokens = 65536;
+        options.kvmem.sink_tokens = 12288;
+        options.kvmem.recent_tokens = 1024;
+        options.kv_cache = ninfer::KvCacheStorage::Int8Group64;
+        options.fast_prefill_kernel = true;
+        options.cuda_graph_allowance_bytes = 123;
+        constexpr std::size_t MiB = 1ULL << 20;
+        std::size_t calls = 0;
+        auto cost = [](const ninfer::EngineOptions& c) {
+            // Independent monotone layout with a discrete workspace jump; an
+            // affine subtraction of the old KV payload gives the wrong boundary.
+            const std::size_t stride = c.kv_cache == ninfer::KvCacheStorage::Int8Group64 ? 32768 :
+                c.kv_cache == ninfer::KvCacheStorage::Nvfp4Group16 ? 18432 : 24576;
+            return 400 * MiB + c.kvmem.device_tokens() * c.max_concurrency * stride
+                + (c.kvmem.selected_tokens >= 32768 ? 96 * MiB : 0);
+        };
+        for (const auto reserve : {1024U, 4096U, 8192U}) {
+            options.kvmem.reserve_tokens = reserve;
+            options.prefill_chunk = reserve;
+            auto report = nlohmann::json::parse(ninfer::runtime::memory_recovery_plan(
+                options, 2400 * MiB, 5000 * MiB, [&](const auto& c) {
+                    ++calls;
+                    require(c.cuda_graph_allowance_bytes == 0);
+                    require(c.kv_capacity.explicit_tokens == c.kvmem.device_tokens() * c.max_concurrency);
+                    require(c.kvmem.reserve_tokens == std::min(reserve, 4096U));
+                    require(c.prefill_chunk == std::min(reserve, 4096U));
+                    return cost(c);
+                }));
+            for (const auto& result : report["options"]) {
+                require(result["available"].get<bool>());
+                auto chosen = options;
+                chosen.kvmem.selected_tokens = result["budget"];
+                chosen.kvmem.reserve_tokens = result["reserve"];
+                chosen.kv_cache = result["id"] == "int8" ? ninfer::KvCacheStorage::Int8Group64 :
+                    result["id"] == "nvfp4" ? ninfer::KvCacheStorage::Nvfp4Group16 : ninfer::KvCacheStorage::RotatedInt8KeyInt4ValueGroup64;
+                require(chosen.kvmem.selected_tokens % 64 == 0);
+                require(chosen.kvmem.selected_tokens >= 13312);
+                require(cost(chosen) + report["safety_bytes"].get<std::size_t>() <= 2400 * MiB);
+                require(result["runtime_bytes"].get<std::size_t>() == cost(chosen));
+                chosen.kvmem.selected_tokens += 64;
+                require(chosen.kvmem.selected_tokens > options.kvmem.selected_tokens ||
+                    cost(chosen) + report["safety_bytes"].get<std::size_t>() > 2400 * MiB);
+                require(result["fast_prefill"].get<bool>() == (result["id"] != "nvfp4"));
+            }
+        }
+        require(calls <= 108); // bounded page search, never a model-loading loop
+        auto none = nlohmann::json::parse(ninfer::runtime::memory_recovery_plan(
+            options, 64 * MiB, 5000 * MiB, cost));
+        require(!none["options"][0]["available"].get<bool>());
+        auto failed = nlohmann::json::parse(ninfer::runtime::memory_recovery_plan(
+            options, 2400 * MiB, 5000 * MiB, [](const auto&) -> std::size_t { throw std::runtime_error("unsupported"); }));
+        require(failed["options"][0]["reason"] == "planning_unavailable");
+        require(!failed["options"][1]["available"].get<bool>());
+        // Proactive planning keeps R/KV/prefill fixed and can grow beyond old B.
+        options.kvmem.selected_tokens = 13312;
+        for (auto format : {ninfer::KvCacheStorage::Int8Group64, ninfer::KvCacheStorage::Nvfp4Group16,
+                            ninfer::KvCacheStorage::RotatedInt8KeyInt4ValueGroup64}) {
+            options.kv_cache = format;
+            for (auto reserve : {1024U, 4096U, 8192U}) {
+                options.kvmem.reserve_tokens = reserve;
+                options.prefill_chunk = 256;
+                const auto plan = ninfer::runtime::maximum_memory_budget(options, 2400 * MiB, options.max_context,
+                    [&](const auto& c) {
+                        require(c.kvmem.reserve_tokens == reserve && c.kv_cache == format);
+                        require(c.prefill_chunk == options.prefill_chunk && c.fast_prefill_kernel == options.fast_prefill_kernel);
+                        require(c.cuda_graph_allowance_bytes == options.cuda_graph_allowance_bytes);
+                        return cost(c);
+                    });
+                require(plan.available && plan.budget > options.kvmem.selected_tokens);
+                auto chosen = options; chosen.kvmem.selected_tokens = plan.budget;
+                require(cost(chosen) + plan.safety_bytes <= plan.available_bytes);
+                chosen.kvmem.selected_tokens += 64;
+                require(cost(chosen) + plan.safety_bytes > plan.available_bytes);
+            }
+        }
+        options.max_context = 32768;
+        const auto capped = ninfer::runtime::maximum_memory_budget(options, 100000 * MiB, options.max_context, cost);
+        require(capped.budget == options.max_context - options.kvmem.reserve_tokens);
+        const auto too_small = ninfer::runtime::maximum_memory_budget(options, 64 * MiB, options.max_context, cost);
+        require(!too_small.available && too_small.budget == 0);
+        std::cout << "PASS: recovery and proactive budget bounds, next-page boundary, fixed reserve/format/prefill, context ceiling, failure handling\n";
+        return 0;
+    } catch (const std::exception& error) { std::cerr << error.what() << '\n'; return 1; }
+}
