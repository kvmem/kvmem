+    auto account=std::make_shared<NativeSourceVersionAccount>(1024);
+    auto graph_charge=account->reserve(128);auto owner=account->reserve(896);
+    rejects([&]{account->reserve(1);});owner.shrink(0);require(account->charged_bytes()==128);
+    // Validate all target layers and unequal native head shards, no GPU access.
+    std::vector<std::uint16_t> q0(256*1*64),q1(256*2*64),q2(256*3*64);
+    std::array<std::int32_t,64> positions{};std::int32_t table=7;std::int64_t epoch=0,ingress=0;
+    const auto slot=[&](std::uint32_t model,std::size_t rank,std::uint32_t begin,std::uint32_t heads,void* q) {
+        return execution::LayerwiseGraphAttentionSlot{model,model==2?0U:1U,rank,begin,heads,3,
+            Tensor(q,DType::BF16,{256,static_cast<std::int32_t>(heads),64}),
+            Tensor(positions.data(),DType::I32,{64}),Tensor(&table,DType::I32,{1}),
+            Tensor(&epoch,DType::I64,{1}),Tensor(&ingress,DType::I64,{1})};
+    };
+    std::vector<execution::LayerwiseGraphAttentionSlot> slots{slot(2,0,0,1,q0.data()),slot(2,1,1,2,q1.data()),slot(7,0,0,3,q2.data())};
+    execution::LayerwiseGraphCaptureView view{slots,64,1};view.validate();
+    slots[1].first_query_head=0;rejects([&]{view.validate();});slots[1].first_query_head=1;
+    slots[1].global_query_heads=4;rejects([&]{view.validate();});slots[1].global_query_heads=3;
+    view.max_batch_size=UINT32_MAX;rejects([&]{view.validate();});view.max_batch_size=1;
+    // Dual-capacity and unequal-head routes cover every Main frontier, without
+    // pretending that Own is bounded by Main C at a final AR step.
+    const std::array<ops::AttentionHeadGeometry,2> heads{{{256,4,1},{256,8,2}}};
+    for (auto storage:{KvCacheStorage::BFloat16,KvCacheStorage::Int8Group64}) for (std::uint32_t batch=1;batch<=8;++batch) {
+        const auto ordinary=layerwise_ordinary_graph_profiles(384,batch,heads,storage);
+        require(!ordinary.empty() && ordinary.front().min==0 && ordinary.back().max==383);
+        const auto ordinary_signature=[&](std::uint32_t frontier) {
+            std::vector<int> result;
+            const ops::CausalAttentionExecutionEnvelope envelope{1U,frontier+1U};
+            for (const auto a:heads) {
+                result.push_back(ops::causal_softmax_attention_route_family(a,storage,envelope,static_cast<std::int32_t>(batch),1));
+                result.push_back(ops::causal_softmax_attention_small_t_launches(a,storage,envelope,static_cast<std::int32_t>(batch),1));
+            }
+            return result;
+        };
+        for (std::size_t i=0;i<ordinary.size();++i) {
+            if (i) require(ordinary[i-1].max+1U==ordinary[i].min);
+            const auto expected=ordinary_signature(ordinary[i].max);
+            for (auto pos=ordinary[i].min;pos<=ordinary[i].max;++pos) require(ordinary_signature(pos)==expected);
+            for (std::size_t j=0;j<i;++j) if (ordinary[j].topology_class==ordinary[i].topology_class)
+                require(ordinary_signature(ordinary[j].max)==expected);
+        }
+        const auto profiles=layerwise_mtp_graph_profiles({384,448},63,15,heads,{256,12,3},storage,batch);
+        require(!profiles.empty() && profiles.front().min==0 && profiles.back().max==383);
+        const auto signature=[&](std::uint32_t frontier) {
+            std::vector<int> result;
+            const auto call=[&](ops::AttentionHeadGeometry a,std::uint32_t width,std::uint32_t end) {
+                const ops::CausalAttentionExecutionEnvelope e{1,end,false,width>16};
+                result.push_back(ops::causal_softmax_attention_route_family(a,storage,e,static_cast<std::int32_t>(batch),width));
+                result.push_back(ops::causal_softmax_attention_small_t_launches(a,storage,e,static_cast<std::int32_t>(batch),width));
+            };
+            for (const auto a:heads) call(a,64,std::min(384U,frontier+64));
+            call({256,12,3},64,std::min(448U,frontier+64));
+            for (std::uint32_t step=0;step<14;++step) call({256,12,3},1,std::min(448U,frontier+65+step));
+            return result;
+        };
+        for (std::size_t i=0;i<profiles.size();++i) {
+            require(profiles[i].min<=profiles[i].max);
+            if (i) require(profiles[i-1].max+1==profiles[i].min);
+            const auto expected=signature(profiles[i].max);
+            for (auto pos=profiles[i].min;pos<=profiles[i].max;++pos) require(signature(pos)==expected);
+            for (std::size_t j=0;j<i;++j) if (profiles[j].topology_class==profiles[i].topology_class)
+                require(signature(profiles[j].max)==expected);
+        }
+    }
+    rejects([&]{layerwise_mtp_graph_profiles({384,320},3,3,heads,{256,12,3},KvCacheStorage::BFloat16);});
+    std::cout<<"layerwise graph descriptor/layout/frame plan passed (Host only; no graph execution)\n";
+    return 0;
+} catch (const std::exception& error) {
+    std::cerr<<error.what()<<'\n';return 1;
+}
diff --git a/tests/experimental/layerwise_multimodal_plan.cpp b/tests/experimental/layerwise_multimodal_plan.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..cc462c78fe30eddce23faee0de4ea1ec2d6c2489
--- /dev/null
+++ b/tests/experimental/layerwise_multimodal_plan.cpp
@@ -0,0 +1,65 @@
+// CPU reference cases for the actual native input geometry APIs. Unbuilt MM
+// candidate: this test is not a model/stream/tape/owner qualification claim.
+#include "models/qwen3_5/program/native_layerwise_media.h"
+#include "models/qwen3_5/program/vision_prefill.h"
+#include "kvmem/layerwise_window.hpp"
+#include <array>
+#include <iostream>
+#include <stdexcept>
+#include <vector>
+
+using namespace ninfer::models::qwen3_5;
+using namespace ninfer::models::qwen3_5::detail;
+static void require(bool value,const char* message) {if (!value) throw std::runtime_error(message);}
+template<class F> static void rejects(F&& f) {
+    bool rejected=false;try {f();} catch (const std::exception&) {rejected=true;}
+    require(rejected,"expected invalid native geometry/envelope refusal");
+}
+int main() {
+    PreparedPromptData prompt;prompt.token_ids.resize(300);prompt.token_types.resize(300);
+    prompt.positions.resize(900);
+    for (std::size_t axis=0;axis<3;++axis) for (std::size_t row=0;row<300;++row)
+        prompt.positions[axis*300+row]=static_cast<std::int32_t>(1000*axis+2*row);
+    VisionItem first;first.token_spans.push_back({100,50});
+    VisionItem second;second.token_spans.push_back({170,30});
+    prompt.vision_items={first,second};validate_layerwise_media(prompt);
+    require(layerwise_media_replay_begin(prompt,155,64)==64,"alignment divided first image");
+    require(layerwise_media_replay_begin(prompt,210,64)==64,"alignment did not recheck earlier image");
+    require(layerwise_media_replay_begin(prompt,260,64)==256,"safe aligned text prefix changed");
+    require(layerwise_media_replay_begin(prompt,0,64)==0,"cold prefix changed");
+    rejects([&]{layerwise_media_replay_begin(prompt,301,64);});
+    rejects([&]{layerwise_media_replay_begin(prompt,155,0);});
+    auto malformed=prompt;malformed.vision_items[0].token_spans[0]={299,2};
+    rejects([&]{validate_layerwise_media(malformed);});
+    malformed=prompt;malformed.positions.pop_back();rejects([&]{validate_layerwise_media(malformed);});
+
+    VisionPrefillPlan plan;plan.uses={{100,150,0,0},{170,200,1,1}};
+    require(planned_vision_chunk_length(plan,300,64,128)==106,"native next-item cap changed");
+    require(planned_vision_chunk_length(plan,300,170,128)==128,"native second item cap changed");
+    require(planned_vision_chunk_length(plan,300,298,128)==2,"native terminal cap changed");
+    require(planned_vision_chunk_length(plan,300,140,8)==8,"native image cannot span physical units");
+    rejects([&]{planned_vision_chunk_length(plan,300,300,1);});
+    rejects([&]{planned_vision_chunk_length(plan,300,0,0);});
+
+    // One semantic Window frame can contain an unaligned item cap. It is
+    // admitted as64, then physically run as8+56 with no intermediate action.
+    VisionPrefillPlan adjacent;adjacent.uses={{100,200,0,0},{200,260,1,1}};
+    kvmem::LayerwiseRequestEnvelope ordinary;ordinary.prompt_end=300;
+    ordinary.block_tokens=64;ordinary.generation_tokens=256;
+    kvmem::LayerwiseWindowPlan ordinary_window(ordinary,512);
+    const auto credit=ordinary_window.admit({192,192},64);
+    require(credit==64,"literal semantic credit changed");
+    require(planned_vision_chunk_length(adjacent,300,192,credit)==8,"first physical tile is not8");
+    require(planned_vision_chunk_length(adjacent,300,200,56)==56,"remaining physical tile is not56");
+
+    // Expanded evaluation is charged in full. TrueQ coordinates do not move.
+    kvmem::LayerwiseRequestEnvelope query;query.prompt_end=300;query.block_tokens=64;
+    query.generation_tokens=256;query.query=kvmem::QueryRange{155,170};
+    query.replay=kvmem::QueryRange{layerwise_media_replay_begin(prompt,155,64),300};
+    rejects([&]{kvmem::LayerwiseWindowPlan invalid(query,512);}); // P236+64>G256
+    query.generation_tokens=320;
+    kvmem::LayerwiseWindowPlan valid(query,576);
+    require(valid.query_evaluation()->begin==64 && valid.envelope().query->begin==155,
+        "native-safe expanded evaluation changed trueQ");
+    std::cout<<"native multimodal input geometry reference passed\n";
+}
diff --git a/tests/experimental/layerwise_ngram_physical.cpp b/tests/experimental/layerwise_ngram_physical.cpp
new file mode 100644
