+    RequestLimits defaulted; defaulted.default_tool_constraints = ToolConstraintMode::Basic;
+    Json sd={{"model","test"},{"messages",Json::array({{{"role","user"},{"content","hi"}}})},
+             {"tools",Json::array({Json::parse(declarations[0])})},{"tool_choice","required"}};
+    require(parse_chat_completion_request(sd,limits).generation.tool_choice.constraints==
+            ToolConstraintMode::Automatic, "no server default keeps native auto");
+    require(parse_chat_completion_request(sd,defaulted).generation.tool_choice.constraints==
+            ToolConstraintMode::Basic, "server default upgrades tool-carrying chat requests");
+    sd["tool_constraints"]="auto";
+    require(parse_chat_completion_request(sd,defaulted).generation.tool_choice.constraints==
