+int test_stop_token_inside_reasoning_keeps_the_turn_alive(const Frontend& frontend) {
+    const std::vector<ninfer::TokenId> thought = fixture_tokens("thought");
+    std::vector<ninfer::TokenId> first_round   = thought;
