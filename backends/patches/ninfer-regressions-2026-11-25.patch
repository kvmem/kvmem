+    require(parse_chat_completion_request(sd,defaulted).generation.tool_choice.mode==
+            ToolChoiceMode::None &&
+            parse_chat_completion_request(sd,defaulted).generation.tool_choice.constraints==
+            ToolConstraintMode::Automatic, "tool_choice none is never upgraded");
+    Json sd_resp={{"model","test"},{"input","hi"},
+                  {"tools",Json::array({{{"type","function"},{"name","typed"},{"strict",true},
+                                         {"parameters",Json::parse(strict_def[0])["function"]["parameters"]}}})},
+                  {"tool_choice","required"}};
+    require(parse_openai_responses_create_request(sd_resp,defaulted).prompt.generation.
+            tool_choice.constraints==ToolConstraintMode::Basic,
+            "server default upgrades Responses tool requests");
+    Json sd_anth={{"model","test"},{"max_tokens",128},
+                  {"messages",Json::array({{{"role","user"},{"content","hi"}}})},
+                  {"tools",Json::array({{{"name","alpha"},{"input_schema",Json::object()}}})},
+                  {"tool_choice",{{"type","any"}}}};
+    require(parse_anthropic_messages_request(sd_anth,defaulted).generation.tool_choice.
+            constraints==ToolConstraintMode::Basic,
+            "server default upgrades Anthropic tool requests");
