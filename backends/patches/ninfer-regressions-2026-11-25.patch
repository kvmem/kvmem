+void routed_oracle(const Format& f,int n=128,int k=256,bool sampled=false) {
+    // Q8 is checked against independently decoded original weights and FP64
+    // dots, not against the numerically different FP8 encoded-product oracle.
+    constexpr int t=256;
+    const auto b=gguf_block_shape(f.q);const auto rb=k/b.elements*b.bytes;
+    std::mt19937 rng(7712);std::vector<unsigned char> raw(n*rb+256);
+    for(auto&v:raw)v=static_cast<unsigned char>(rng()%256);
+    const auto h=__float2half(.0125f);unsigned short hs;std::memcpy(&hs,&h,2);
+    for(int at=0;at<n*rb;at+=b.bytes)for(int off:f.scales)std::memcpy(raw.data()+at+off,&hs,2);
+    std::vector<float>w(n*k);gguf_cpu_decode(int(ops::detail::gguf_type(f.q)),raw.data(),w.data(),n*k);
+    std::normal_distribution<float>normal(0,1);std::vector<__nv_bfloat16>x(k*t);
+    for(auto&v:x)v=__float2bfloat16(normal(rng));
+    std::vector<int>gather(k);std::iota(gather.begin(),gather.end(),0);std::shuffle(gather.begin(),gather.end(),rng);
+    DeviceBuffer dw(raw.size()),dx(x.size()*2),dg(k*4),dy(n*t*4+32),gate(n*t*4);
+    dw.copy_from_host(raw.data(),raw.size());dx.copy_from_host(x.data(),x.size()*2);dg.copy_from_host(gather.data(),k*4);
+    std::vector<float>g(n*t);for(std::size_t i=0;i<g.size();++i)g[i]=float(int(i%17)-8)*.25f;gate.copy_from_host(g.data(),g.size()*4);
+    Weight weight;weight.qtype=f.q;weight.layout=QuantLayout::GgufBlocks;weight.scale_dtype=DType::FP16;
+    weight.n=n;weight.k=k;weight.qdata=dw.p;
+    const ops::detail::GgufShape shapes[]={{f.q,n,k},{f.q,n,k}};
+    WorkspaceArena work(ops::detail::gguf_project_workspace_bytes(shapes,1,t));
+    DeviceBuffer mixed_output(std::size_t(n)*t*2);
+    const Tensor tx(dx.p,DType::BF16,{k,t});
+    std::vector<int> rows,columns;
+    if(sampled){rows={0,1,127,128,n/2,n-129,n-128,n-1};columns={0,1,127,128,255};}
+    else{rows.resize(n);columns.resize(t);std::iota(rows.begin(),rows.end(),0);std::iota(columns.begin(),columns.end(),0);}
+    for(bool permute:{false,true}) {
+        weight.input_columns=permute?static_cast<int*>(dg.p):nullptr;
+        std::vector<double>ref(n*t);
+        for(int c:columns)for(int r:rows){double sum=0;for(int j=0;j<k;++j)sum+=double(w[r*k+j])*__bfloat162float(x[c*k+(permute?gather[j]:j)]);ref[c*n+r]=sum;}
+        for(const auto epi:mx::kPrefillEpilogues) {
+            const bool fp32=epi==mx::PrefillEpilogue::F32;
+            const ops::DeviceRouteForce force(mx::prefill_route_key(ops::detail::gguf_type(f.q),n,k,epi),"q8");
+            dy.fill(0x42);auto* result=static_cast<unsigned char*>(dy.p)+16;
+            Tensor y(result,fp32?DType::FP32:DType::BF16,{n,t});
+            ops::detail::GgufProduct product{&weight,&y};
+            auto expected=ref;
+            if(fp32){product.f32=reinterpret_cast<float*>(result);product.f32_rows=n;}
+            if(epi==mx::PrefillEpilogue::Add){
+                product.epilogue=ops::detail::GgufEpilogue::Accumulate;
+                std::vector<__nv_bfloat16>initial(n*t,__float2bfloat16(.25f));checked(cudaMemcpy(result,initial.data(),n*t*2,cudaMemcpyHostToDevice));
+                for(auto&v:expected)v+=.25;
+            } else if(epi==mx::PrefillEpilogue::Silu){
+                product.epilogue=ops::detail::GgufEpilogue::GateProduct;product.gate=static_cast<const float*>(gate.p);
+                for(std::size_t i=0;i<expected.size();++i)expected[i]*=double(g[i])/(1+std::exp(-double(g[i])));
+            }
+            Tensor mixed_y(mixed_output.p,DType::BF16,{n,t});
+            const std::array products{product,ops::detail::GgufProduct{&weight,&mixed_y}};
+            const auto count=fp32&&!sampled?2u:1u;
+            ops::detail::gguf_project(tx,std::span(products.data(),count),work,nullptr);checked(cudaDeviceSynchronize());
+            if(count==2) {
+                // One shared activation is needed in both Q8 and tile layouts.
+                // Capture/replay the actual mixed product boundary and check it
+                // against original-weight FP64, not the other GPU route.
+                cudaStream_t stream;checked(cudaStreamCreateWithFlags(&stream,cudaStreamNonBlocking));
+                checked(cudaStreamBeginCapture(stream,cudaStreamCaptureModeGlobal));
+                ops::detail::gguf_project(tx,std::span(products.data(),count),work,stream);
+                cudaGraph_t graph;checked(cudaStreamEndCapture(stream,&graph));cudaGraphExec_t exe;
+                checked(cudaGraphInstantiate(&exe,graph,nullptr,nullptr,0));checked(cudaGraphLaunch(exe,stream));checked(cudaStreamSynchronize(stream));
+                std::vector<__nv_bfloat16>bits(n*t);mixed_output.copy_to_host(bits.data(),bits.size()*2);
+                std::vector<float>mixed(n*t);for(int i=0;i<n*t;++i)mixed[i]=__bfloat162float(bits[i]);
+                error(mixed,ref,.20,.08,"mixed FP8 original-weight FP64 oracle");
+                checked(cudaGraphExecDestroy(exe));checked(cudaGraphDestroy(graph));checked(cudaStreamDestroy(stream));
+            }
+            std::vector<float>got(n*t);
+            if(fp32)checked(cudaMemcpy(got.data(),result,n*t*4,cudaMemcpyDeviceToHost));
+            else{std::vector<__nv_bfloat16>bits(n*t);checked(cudaMemcpy(bits.data(),result,n*t*2,cudaMemcpyDeviceToHost));for(int i=0;i<n*t;++i)got[i]=__bfloat162float(bits[i]);}
+            std::vector<float>selected;std::vector<double>reference;
+            for(int c:columns)for(int r:rows){selected.push_back(got[c*n+r]);reference.push_back(expected[c*n+r]);}
+            error(selected,reference,.03,.015,"routed Q8 original-weight FP64 oracle");
+            std::vector<unsigned char>guards(dy.bytes);dy.copy_to_host(guards.data(),guards.size());
+            const auto end=16+std::size_t(n)*t*(fp32?4:2);
+            for(int i=0;i<16;++i)if(guards[i]!=0x42||guards[end+i]!=0x42)throw std::runtime_error("routed output guard");
+        }
+    }
+    if(work.peak_used()>work.capacity())throw std::runtime_error("routed workspace capacity");
+}
