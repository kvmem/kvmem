+#include "ninfer/engine.h"
+#include "kvmem_test_options.h"
+#include <fstream>
+#include <iostream>
+#include <stdexcept>
+#include <string>
+
+int main(int argc, char** argv) {
+    try {
+        if (argc != 5) throw std::invalid_argument("artifact bf16|int8|nvfp4|k8v4|rk8v4 eager|graph output");
+        ninfer::EngineOptions o;
+        o.artifact_path = argv[1];
+        o.max_context = 16384;
+        o.device = 0;
+        o.max_concurrency = 1;
+        o.prefill_chunk = 128;
+        o.kvmem.selected_tokens = 384;
+        o.kvmem.reserve_tokens = 128;
+        o.kvmem.host_bytes = 2ULL << 30;
+        o.kvmem.verify_transfers = true;
+        o.kv_capacity = ninfer::KvCapacityPolicy::explicit_capacity(512);
+        o.kv_cache = ninfer::test::kvmem_test_storage(argv[2]);
+        o.context_cache.enabled = false;
+        o.use_cuda_graph = ninfer::test::kvmem_test_graph(argv[3]);
+        o.device_profile = "off";
+        ninfer::Engine engine(o);
+        std::ofstream output(argv[4]);
+        for (int turn = 0; turn < 3; ++turn) {
+            ninfer::PromptInput prompt;
+            const auto add = [&](ninfer::ChatRole role, const std::string& text) {
+                ninfer::ChatMessage message;
+                message.role = role;
+                message.parts.push_back({.kind = ninfer::MessagePartKind::Text, .text = text});
+                prompt.messages.push_back(std::move(message));
+            };
+            add(ninfer::ChatRole::System, "Use the archive to answer the final question.");
+            for (int record = 0; record < 24; ++record) {
+                std::string paragraph = "Archive entry " + std::to_string(record) + ". ";
+                for (int repeat = 0; repeat < 8; ++repeat) {
+                    paragraph += record < 4
+                        ? "The violet observatory studies pulsars, cosmic rays and distant galaxies. "
+                        : "The coastal office files invoices, transport schedules and warehouse inventories. ";
+                }
+                add(ninfer::ChatRole::User, paragraph);
+                add(ninfer::ChatRole::Assistant, "The archive entry is recorded.");
+            }
+            const std::string query = turn == 1
+                ? "Explain coastal warehouse inventories and transport schedules."
+                : "Explain the violet observatory, its pulsars, cosmic rays and distant galaxies.";
+            add(ninfer::ChatRole::User, query);
+            ninfer::RequestOptions request;
+            request.execution.requested_output_tokens = 130;
+            request.execution.sampling.temperature = 0;
+            request.execution.sampling.seed = 42;
+            request.execution.allow_prefix_reuse = false;
+            request.stop.include_model_defaults = false;
+            const auto result = engine.submit(engine.prepare(std::move(prompt)), request).wait();
+            if (result.generated_token_ids.size() != 130 || !engine.is_available())
+                throw std::runtime_error("retrieval request did not complete");
+            output << turn;
+            for (auto token : result.generated_token_ids) output << ' ' << token;
+            output << '\n';
+            std::cout << "P4_RETRIEVAL turn=" << turn << " output=" << result.generated_token_ids.size() << '\n';
+        }
+        std::cout << "P4_RETRIEVAL PASS\n";
+    } catch (const std::exception& e) { std::cerr << e.what() << '\n'; return 1; }
+}
diff --git a/tests/experimental/prompt_page_lse.cpp b/tests/experimental/prompt_page_lse.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..697213ccf5b172d21398bb938c2f948a9d8aff12
--- /dev/null
+++ b/tests/experimental/prompt_page_lse.cpp
@@ -0,0 +1,273 @@
+// Oracle uses represented BF16 Q and the FP8 K codes/scales read back AFTER the
+// actual append. It never uses a CUDA dot product or the main attention's logits.
+#include "ninfer/ops/attention_page_mass.h"
+#include "ninfer/ops/prompt_page_lse.h"
+#include "ops/op_tester.h"
+#include "ops/kv_cache/d256_profile.h"
+#include <array>
+#include <bit>
+#include <numeric>
+#include <utility>
+using namespace ninfer;
+using namespace ninfer::test;
+
+static double fp8(unsigned b) {
+    const unsigned e=(b>>3)&15, m=b&7;
+    if (e==15 && m==7) throw std::runtime_error("NaN in represented key");
+    return (b&128?-1:1)*(e?std::ldexp(1.+m/8.,int(e)-7):std::ldexp(double(m),-9));
+}
+static double half_scale(unsigned b) {
+    const unsigned e=(b>>10)&31, m=b&1023;
+    if ((b&32768)||e==31) throw std::runtime_error("invalid represented row scale");
+    return e?std::ldexp(1.+m/1024.,int(e)-15):std::ldexp(double(m),-24);
+}
+
+static void qualify(int base,int width,std::vector<int> samples) {
+    constexpr int D=256,H=24,K=4;
+    const int end=base+width, pages=(end+63)/64+2, capacity=pages+3, S=int(samples.size());
+    const size_t nk=size_t(capacity)*K*64, nq=size_t(width)*H*D;
+    std::mt19937 rng(20261113+base);
+    std::uniform_real_distribution<float> uniform(-1.6f,1.6f);
+    std::vector<std::uint16_t> q(nq), k(size_t(width)*K*D), v(k.size());
+    for (auto& x:q) x=f32_to_bf16(uniform(rng));
+    for (auto& x:k) x=f32_to_bf16(uniform(rng));
+    for (auto& x:v) x=f32_to_bf16(uniform(rng)*.7f);
+    std::vector<std::uint8_t> codes(nk*D); std::vector<std::uint16_t> scales(nk);
+    for (size_t i=0;i<nk;++i) {
+        scales[i]=std::uint16_t(0x2400+(i%19)*67);
+        for(int d=0;d<D;++d) codes[i*D+d]=std::uint8_t((rng()%127)|((rng()%2)*128));
+    }
+    // A nonzero table slot and nonmonotone physical addresses exercise logical
+    // page order. More table capacity than feedback pages exercises the bound.
+    std::vector<int> table(capacity*2,-1);
+    for(int i=0;i<capacity;++i) table[capacity+i]=capacity-1-i;
+    std::vector<int> pos(width), limits(S);
+    std::iota(pos.begin(),pos.end(),base);
+    for(int i=0;i<S;++i) limits[i]=pos.at(samples[i]);
+    auto dq=to_device(q), dk=to_device(k), dv=to_device(v), dt=to_device(table);
+    auto pc=to_device(codes), pv=to_device(codes), ps=to_device(scales), vs=to_device(scales);
+    auto dp=to_device(pos), dtr=to_device(std::vector<int>{1}), dr=to_device(samples), de=to_device(limits);
+    DeviceBuffer result(nq*2), other(nq*2), scratch(size_t(pages)*H*S*4), norms(size_t(2)*H*S*4), mass(size_t(pages)*S*4);
+    Tensor qt(dq.p,DType::BF16,{D,H,width}),kt(dk.p,DType::BF16,{D,K,width}),vt(dv.p,DType::BF16,{D,K,width});
+    Tensor ot(result.p,DType::BF16,{D,H,width}),refout(other.p,DType::BF16,{D,H,width});
+    Tensor pt(dp.p,DType::I32,{width}),rt(dtr.p,DType::I32,{1}),rr(dr.p,DType::I32,{S}),ee(de.p,DType::I32,{S});
+    Tensor st(scratch.p,DType::FP32,{pages,H,S}),nt(norms.p,DType::FP32,{2,H,S}),mt(mass.p,DType::FP32,{pages,S});
+    PagedKVBatchLayerView cache;
+    cache.head_dim=D; cache.num_kv_heads=K; cache.storage=KvCacheStorage::Fp8E4M3Row256;
+    cache.k_pages=Tensor(pc.p,DType::FP8_E4M3FN,{D,64,K,capacity}); cache.v_pages=Tensor(pv.p,DType::FP8_E4M3FN,{D,64,K,capacity});
+    cache.k_scale_pages=Tensor(ps.p,DType::FP16,{1,64,K,capacity}); cache.v_scale_pages=Tensor(vs.p,DType::FP16,{1,64,K,capacity});
+    cache.block_tables=Tensor(dt.p,DType::I32,{capacity,2});
+    const ops::AttentionHeadGeometry geo{D,H,K};
+    const ops::CausalAttentionExecutionEnvelope env{unsigned(base+1),unsigned(end)};
+    WorkspaceArena arena(std::max<size_t>(4096,ops::causal_softmax_attention_workspace_capacity_bytes(geo,cache.storage,env,1,width,width)));
+    ops::causal_softmax_attention(qt,kt,vt,pt,{},rt,geo,1.f/16,cache,env,arena,refout,nullptr);
+    ops::attention_page_mass(qt,rr,ee,1,cache,st,nt,mt,nullptr);
+    const auto old=from_device<float>(mass,mt.numel());
+    scratch.fill(0x7f); // unwritten tail must be zero probability, even with dirty scratch
+    std::vector<std::uint32_t> capture_rows(samples.begin(),samples.end());
+    ops::PromptPageLse capture{.scratch=st,.device_rows=rr,.rows=capture_rows};
+    ops::causal_softmax_attention_with_page_lse(qt,kt,vt,pt,{},rt,geo,1.f/16,cache,env,arena,ot,nullptr,nullptr,nullptr,&capture);
+    if(!capture.captured) throw std::runtime_error("qualified route fell back");
+    ops::attention_page_mass_from_lse(st,nt,mt,nullptr);
+    const auto fused=from_device<float>(mass,mt.numel());
+    const auto main_output=from_device<std::uint16_t>(result,nq);
+    const bool equal_main=main_output==from_device<std::uint16_t>(other,nq);
+    if (!equal_main)
+        throw std::runtime_error("capture changed main attention output bits");
+    codes=from_device<std::uint8_t>(pc,codes.size());
+    scales=from_device<std::uint16_t>(ps,scales.size());
+    std::vector<double> represented(nk*D);
+    for(size_t i=0;i<nk;++i) for(int d=0;d<D;++d) represented[i*D+d]=half_scale(scales[i])*fp8(codes[i*D+d]);
+    // Read actual, post-append persistent V bytes. The original-coordinate V
+    // of this plain FP8 profile is not Hadamard rotated. Exercise every output
+    // dimension of each head at the sampled rows against decoded FP64 attention.
+    std::vector<double> represented_v(nk*D);
+    {
+        const auto vc=from_device<std::uint8_t>(pv,codes.size());
+        const auto vs_bits=from_device<std::uint16_t>(vs,scales.size());
+        for (size_t row=0;row<nk;++row) {
+            const double scale=half_scale(vs_bits[row]);
+            for (int d=0;d<D;++d) represented_v[row*D+d]=scale*fp8(vc[row*D+d]);
+        }
+    }
+    double main_error2=0,main_norm2=0,main_max=0;
+    std::vector<double> oracle(size_t(pages)*S);
+    for(int j=0;j<S;++j) for(int h=0;h<H;++h) {
+        const auto* raw=&q[(size_t(samples[j])*H+h)*D];
+        double rotated[D]{};
+        for(int d=0;d<D;++d) for(int e=0;e<D;++e)
+            rotated[d]+=(std::popcount(unsigned(d&e))%2?-1:1)*double(bf16_to_f32(raw[e]))/16.;
+        std::vector<double> logits(limits[j]+1);
+        for(int t=0;t<=limits[j];++t) {
+            const auto idx=(size_t(table[capacity+t/64])*K+h/(H/K))*64+t%64;
+            logits[t]=std::inner_product(rotated,rotated+D,&represented[idx*D],0.)/16.;
+        }
+        const auto peak=*std::max_element(logits.begin(),logits.end());double z=0;
+        for(auto& y:logits){y=std::exp(y-peak);z+=y;}
+        double ideal[D]{};
+        for(size_t t=0;t<logits.size();++t) {
+            const double prob=logits[t]/z;
+            oracle[size_t(j)*pages+t/64]+=prob/H;
+            const size_t row=(size_t(table[capacity+t/64])*K+h/(H/K))*64+t%64;
+            for (int d=0;d<D;++d) ideal[d]+=prob*represented_v[row*D+d];
+        }
+        for (int d=0;d<D;++d) {
+            const double actual=bf16_to_f32(main_output[(size_t(samples[j])*H+h)*D+d]);
+            if (!std::isfinite(actual)) throw std::runtime_error("nonfinite attention output");
+            const double error=actual-ideal[d];
+            main_error2+=error*error;
+            main_norm2+=ideal[d]*ideal[d];
+            main_max=std::max(main_max,std::abs(error));
+        }
+    }
+    double worst=0,old_err=0,old_delta=0,max_l1=0,sum_err=0;
+    for(int j=0;j<S;++j){
+        double l1=0,sum=0;
+        for(int p=0;p<pages;++p){
+            const size_t i=size_t(j)*pages+p;const double err=std::abs(fused[i]-oracle[i]);
+            if(!std::isfinite(fused[i]) || fused[i]<0 || (p*64>limits[j] && fused[i]!=0))
+                throw std::runtime_error("invalid or unmasked page");
+            l1+=err;sum+=fused[i];worst=std::max(worst,err);
+            old_err=std::max(old_err,std::abs(old[i]-oracle[i]));
+            old_delta=std::max(old_delta,std::abs(double(old[i])-fused[i]));
+        }
+        max_l1=std::max(max_l1,l1);sum_err=std::max(sum_err,std::abs(sum-1));
+    }
+    const double main_rel=std::sqrt(main_error2/main_norm2);
+    std::cout<<"base="<<base<<" width="<<width<<" samples="<<S<<" main_bits_equal="<<equal_main<<" main_fp64_rel_l2="<<main_rel<<" main_fp64_max_abs="<<main_max<<" max_abs="<<worst
+             <<" row_l1="<<max_l1<<" old_oracle="<<old_err<<" fused_old="<<old_delta<<" sum_err="<<sum_err<<std::endl;
+    if(main_rel>0.02 || old_err>2e-5 || worst>0.002 || max_l1>0.005 || sum_err>2e-6)
+        throw std::runtime_error("outside page probability tolerance");
+    // A stale or invalid requested capture must not be mistaken for materialized stats.
+    capture_rows[0]=width;
+    ops::causal_softmax_attention_with_page_lse(qt,kt,vt,pt,{},rt,geo,1.f/16,cache,env,arena,ot,nullptr,nullptr,nullptr,&capture);
+    if(capture.captured || from_device<std::uint16_t>(result,nq)!=from_device<std::uint16_t>(other,nq))
+        throw std::runtime_error("invalid capture did not fall back to regular attention");
+}
+static void qualify_dense(const char* name, KvCacheStorage storage, int q_heads, int kv_heads,
+                          int width, bool fast, bool random_q, int stride = 32) {
+    constexpr int D = 256;
+    const int base = 47;
+    const int end = base + width;
+    const int pages = (end + 63) / 64 + 2;
+    std::vector<int> samples;
+    if (width == 4096) {
+        for (int row = stride - 1; row < width; row += stride) samples.push_back(row);
+    } else {
+        samples = {0, 16, 17, 63, 64, width - 1};
+    }
+    const int count = int(samples.size());
+    const auto profile = ops::d256_kv_cache_profile(storage);
+    const int keys = profile.key_leading_extent;
+    const int values = profile.value_leading_extent;
+    const int k_scales = profile.scale_leading_extent;
+    const int v_scales = profile.value_scale_leading_extent;
+    const size_t cache_rows = size_t(pages) * kv_heads * 64;
+    DeviceBuffer key_cache(cache_rows * keys * dtype_size(profile.key_code_dtype));
+    DeviceBuffer value_cache(cache_rows * values * dtype_size(profile.value_code_dtype));
+    DeviceBuffer key_scales(std::max<size_t>(1, cache_rows * k_scales * dtype_size(profile.key_scale_dtype)));
+    DeviceBuffer value_scales(std::max<size_t>(1, cache_rows * v_scales * dtype_size(profile.value_scale_dtype)));
+    key_cache.fill(0); value_cache.fill(0); key_scales.fill(0); value_scales.fill(0);
+    std::mt19937 rng(8291);
+    std::uniform_real_distribution<float> uniform(-0.7f, 0.7f);
+    std::vector<std::uint16_t> q(size_t(width)*q_heads*D), k(size_t(width)*kv_heads*D), v(k.size());
+    if (random_q) for (auto& x : q) x = f32_to_bf16(uniform(rng));
+    for (auto& x : k) x = f32_to_bf16(uniform(rng));
+    for (auto& x : v) x = f32_to_bf16(uniform(rng));
+    std::vector<int> order(pages), positions(width), limits;
+    std::iota(order.rbegin(), order.rend(), 0);
+    std::iota(positions.begin(), positions.end(), base);
+    for (int row : samples) limits.push_back(positions[row]);
+    auto dq = to_device(q), dk = to_device(k), dv = to_device(v), dp = to_device(positions);
+    auto dt = to_device(order), dtr = to_device(std::vector<int>{0}), dr = to_device(samples), de = to_device(limits);
+    DeviceBuffer result(q.size()*2), baseline(q.size()*2), scratch(size_t(pages)*q_heads*count*4);
+    DeviceBuffer norms(size_t(2)*q_heads*count*4), mass(size_t(pages)*count*4);
+    Tensor qt(dq.p,DType::BF16,{D,q_heads,width}), kt(dk.p,DType::BF16,{D,kv_heads,width}), vt(dv.p,DType::BF16,{D,kv_heads,width});
+    Tensor ot(result.p,DType::BF16,{D,q_heads,width}), refout(baseline.p,DType::BF16,{D,q_heads,width});
+    Tensor pt(dp.p,DType::I32,{width}), rt(dtr.p,DType::I32,{1}), rr(dr.p,DType::I32,{count}), ee(de.p,DType::I32,{count});
+    Tensor st(scratch.p,DType::FP32,{pages,q_heads,count}), nt(norms.p,DType::FP32,{2,q_heads,count}), mt(mass.p,DType::FP32,{pages,count});
+    PagedKVBatchLayerView cache;
+    cache.head_dim = D; cache.num_kv_heads = kv_heads; cache.storage = storage;
+    cache.k_pages = Tensor(key_cache.p,profile.key_code_dtype,{keys,64,kv_heads,pages});
+    cache.v_pages = Tensor(value_cache.p,profile.value_code_dtype,{values,64,kv_heads,pages});
+    if (k_scales) {
+        cache.k_scale_pages = Tensor(key_scales.p,profile.key_scale_dtype,{k_scales,64,kv_heads,pages});
+        cache.v_scale_pages = Tensor(value_scales.p,profile.value_scale_dtype,{v_scales,64,kv_heads,pages});
+    }
+    cache.block_tables = Tensor(dt.p,DType::I32,{pages,1});
+    const ops::AttentionHeadGeometry geometry{D,q_heads,kv_heads};
+    const ops::CausalAttentionExecutionEnvelope envelope{unsigned(base+1),unsigned(end),fast};
+    WorkspaceArena arena(std::max<size_t>(4096,ops::causal_softmax_attention_workspace_capacity_bytes(
+        geometry,storage,envelope,1,width,width)));
+    ops::causal_softmax_attention(qt,kt,vt,pt,{},rt,geometry,1.f/16,cache,envelope,arena,refout,nullptr);
+    std::vector<float> separate;
+    if (random_q) {
+        ops::attention_page_mass(qt,rr,ee,0,cache,st,nt,mt,nullptr);
+        separate = from_device<float>(mass,mt.numel());
+    }
+    scratch.fill(0x7f);
+    constexpr std::uint32_t row_offset = 173;
+    std::vector<std::uint32_t> capture_rows;
+    for (const int sample : samples) capture_rows.push_back(row_offset + sample);
+    ops::PromptPageLse capture{.scratch=st,.device_rows=rr,.rows=capture_rows,.row_offset=row_offset};
+    ops::causal_softmax_attention_with_page_lse(qt,kt,vt,pt,{},rt,geometry,1.f/16,cache,envelope,
+                                               arena,ot,nullptr,nullptr,nullptr,&capture);
+    if (!capture.captured || from_device<std::uint16_t>(result,q.size()) !=
+                              from_device<std::uint16_t>(baseline,q.size()))
+        throw std::runtime_error("dense capture unavailable or changed attention output");
+    for (int first = 0; first < count; first += 64) {
+        const int batch = std::min(64, count - first);
+        auto sample_norms = nt.slice(2,first,batch);
+        auto sample_mass = mt.slice(1,first,batch);
+        ops::attention_page_mass_from_lse(st.slice(2,first,batch),sample_norms,sample_mass,nullptr);
+    }
+    const auto fused = from_device<float>(mass,mt.numel());
+    double worst = 0;
+    for (int i = 0; i < count; ++i) {
+        double sum = 0;
+        for (int page = 0; page < pages; ++page) {
+            const size_t index = size_t(i) * pages + page;
+            const double uniform_mass = std::clamp(limits[i] + 1 - page * 64, 0, 64) / double(limits[i] + 1);
+            const double expected = random_q ? separate[index] : uniform_mass;
+            if (!std::isfinite(fused[index]) || fused[index] < 0 || (uniform_mass == 0 && fused[index] != 0))
+                throw std::runtime_error("dense capture emitted an invalid or causally masked page mass");
+            worst = std::max(worst, std::abs(expected - fused[index]));
+            sum += fused[index];
+        }
+        if (std::abs(sum - 1) > 2e-6) throw std::runtime_error("dense capture mass is not normalized");
+    }
+    std::cout << name << " h=" << q_heads << " width=" << width << " samples=" << count << " fast=" << fast
+              << " random_q=" << random_q << " max_error=" << worst << std::endl;
+    if (worst > (random_q ? 0.007 : 2e-6)) throw std::runtime_error("dense page probability disagrees with reference");
+}
+
+int main() {
+    try {
+        if(cuda_unavailable()) return 77;
+        const auto tier=ops::current_device_tier();
+        if(tier!=ops::DeviceTier::Ampere && tier!=ops::DeviceTier::Blackwell) return 77;
+        qualify(0,99,{0,31,32,62,63,64,94,98});
+        std::vector<int> many(64); for(int i=0;i<64;++i) many[i]=2*i;
+        qualify(47,137,many);
+        qualify(1003,1024,{5,20,63,85,196,511,751,1023});
+        std::vector<int> sampled(32);for(int i=0;i<32;++i)sampled[i]=32*i+31;
+        qualify(36*1024,1024,sampled);
+        qualify_dense("fp8",KvCacheStorage::Fp8E4M3Row256,24,4,4096,false,false);
+        qualify_dense("bf16",KvCacheStorage::BFloat16,24,4,4096,false,false,16);
+        qualify_dense("bf16",KvCacheStorage::BFloat16,8,2,257,false,true);
+        for (const auto& [name,storage] : std::array{
+                 std::pair{"int8",KvCacheStorage::Int8Group64},
+                 std::pair{"rk8v4",KvCacheStorage::RotatedInt8KeyInt4ValueGroup64},
+                 std::pair{"rk4v4",KvCacheStorage::RotatedLloyd4KeyInt4Value},
+                 std::pair{"rk4v4-e8",KvCacheStorage::RotatedInt4KeyInt4ValueE8},
+                 std::pair{"rk2v4-e8",KvCacheStorage::RotatedE8RootKeyInt4Value}}) {
+            qualify_dense(name,storage,24,4,4096,true,false);
+            qualify_dense(name,storage,24,4,257,false,true);
+        }
+        qualify_dense("k8v4",KvCacheStorage::Fp8KeyNvfp4Value,24,4,4096,false,false);
+        qualify_dense("k8v4",KvCacheStorage::Fp8KeyNvfp4Value,24,4,257,false,true);
+        qualify_dense("nvfp4",KvCacheStorage::Nvfp4Group16,24,4,257,false,true);
+        qualify_dense("nvfp4",KvCacheStorage::Nvfp4Group16,24,4,4096,true,false);
+        return 0;
+    } catch(const std::exception& e){std::cerr<<e.what()<<'\n';return 1;}
+}
