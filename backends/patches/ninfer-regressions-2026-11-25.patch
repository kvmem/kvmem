+++ b/tests/models/qwen3_5/layerwise_attention_fixture.h
@@ -0,0 +1,197 @@
+#pragma once
+// Native artifact fixture shared by actual layerwise Program ownership tests.
+// Sparse BF16 projections, exact T2 output/down and joined zero Q6 FFN.
+#include "artifact/fixture.h"
+#include "artifact/binder.h"
+#include "artifact/formats.h"
+#include "ops/op_tester.h"
+#include <array>
+#include <bit>
+#include <functional>
+namespace ninfer::test::layerwise_fixture {
+namespace fixture=ninfer::test::artifact_fixture;
+using fixture::Json;
+using ninfer::test::f32_to_bf16;
+constexpr int H=128,D=256,Q=16,K=2,I=512;
+constexpr double Epsilon=1e-6;
+inline void check(bool value,const char* message) {if (!value) throw std::runtime_error(message);}
+inline double input(int token,int dim) {return double((token*7+dim*3)%17-8)/16;}
+struct ModelFixture {
+    fixture::Fixture file;
+    void tensor(const std::string& id, std::vector<uint64_t> shape,
+                const std::function<double(size_t)>& value, const std::string& use = {},
+                QType format = QType::BF16) {
+        const auto layout = format == QType::BF16 || format == QType::FP32 ? QuantLayout::Contiguous : QuantLayout::RowSplit;
+        const auto geometry = weight_geometry(format, layout, shape);
+        const auto offset = (file.payload.size() + 255) / 256 * 256;
+        file.payload.resize(offset + geometry.bytes);
+        if (format == QType::BF16) {
+            for (size_t i = 0; i < geometry.bytes / 2; ++i)
+                fixture::put_word(file.payload, offset + 2 * i, f32_to_bf16(float(value(i))), 2);
+        } else if (format == QType::FP32) {
+            for (size_t i = 0; i < geometry.bytes / 4; ++i)
+                fixture::put_word(file.payload, offset + 4 * i, std::bit_cast<uint32_t>(float(value(i))), 4);
+        } else {
+            check((format == QType::T2_G128_FP16 || format == QType::Q6_G64_FP16) && shape.size() == 2,
+                  "invalid fixture row-split format");
+            for (size_t row = 0; row < shape[0]; ++row) {
+                for (size_t column = 0; column < shape[1]; ++column) {
+                    const double scalar = value(row * shape[1] + column);
+                    if (format == QType::Q6_G64_FP16) {
+                        check(scalar == 0, "fixture Q6 supports exact signed-code zero only");
+                        continue;
+                    }
+                    check(scalar == -1 || scalar == 0 || scalar == 1, "fixture ternary coefficient is not exact");
+                    const unsigned code = scalar < 0 ? 3 : unsigned(scalar);
+                    file.payload[offset + row * geometry.code_bytes_per_row + column / 4] |=
+                        std::byte(code << (2 * (column % 4)));
+                }
+            }
+            for (size_t i = 0; i < geometry.scale_bytes / 2; ++i)
+                fixture::put_word(file.payload, offset + geometry.scale_offset + 2 * i, 0x3c00, 2);
+        }
+        file.root["objects"].push_back({{"id", id}, {"kind", "tensor"}, {"shape", shape},
+            {"format", artifact::format_name(format)},
+            {"layout", artifact::layout_name(layout)}, {"offset", offset}, {"bytes", geometry.bytes}});
+        file.root["bindings"][id] = {{"object", id}};
+        if (!use.empty()) file.root["uses"].push_back({{"parameter", id}, {"input", use}, {"activation_policy", "A16Only"}});
+    }
+    void resource(const std::string& role, const std::string& bytes) {
+        const auto offset = file.payload.size();
+        for (char c : bytes) file.payload.push_back(std::byte(c));
+        file.root["objects"].push_back({{"id", role}, {"kind", "resource"}, {"encoding", "raw_bytes_v1"},
+                                      {"offset", offset}, {"bytes", bytes.size()}});
+        file.root["components"]["text"]["resources"][role] = role;
+    }
+    void zero_ffn(const std::string& p,std::uint64_t hidden=H) {
+        const std::uint64_t H=hidden;
+        const auto zero=[](size_t){return 0.;};
+        const auto combined=p+"mlp/combined";
+        tensor(combined,{2*I,H},zero,{},QType::Q6_G64_FP16);
+        for (int half=0;half<2;++half) {
+            const auto id=p+(half?"mlp/up":"mlp/gate");
+            file.root["bindings"][id]={{"parts",Json::array({{{"object",combined},
+                {"range",{half*I*H,(half+1)*I*H}}}})}};
+            file.root["uses"].push_back({{"parameter",id},{"input",p+"ffn_input"},{"activation_policy","A16Only"}});
+        }
+        tensor(p+"mlp/down",{H,I},zero,p+"mlp/product",QType::T2_G128_FP16);
+    }
+    explicit ModelFixture(bool linear_prefix=false,std::uint32_t full_layers=1,
+                          std::string_view chat_template="{{ messages }}",int hidden=H,bool with_mtp=false) {
+        check(hidden>0 && hidden<=5120,"native fixture hidden dimension is outside its bounded scope");
+        const std::uint64_t H=static_cast<std::uint64_t>(hidden);
+        check(full_layers>0 && full_layers<=2,"fixture full-attention inventory is outside its bounded scope");
+        file.payload.clear();
+        Json config{
+            {"architectures", {"Qwen3_5ForCausalLM"}}, {"model_type", "qwen3_5_text"},
+            {"hidden_size", H}, {"vocab_size", 272}, {"num_hidden_layers", 1},
+            {"max_position_embeddings", 4096}, {"tie_word_embeddings", false}, {"rms_norm_eps", Epsilon},
+            {"layer_types", {"full_attention"}}, {"num_attention_heads", Q}, {"num_key_value_heads", K},
+            {"head_dim", D}, {"intermediate_size", I}, {"rope_parameters", {
+                {"rope_theta", 1e7}, {"partial_rotary_factor", .25}, {"mrope_section", {11, 11, 10}}}}};
+        if (linear_prefix) {
+            config["num_hidden_layers"]=2;
+            config["layer_types"]={"linear_attention","full_attention"};
+            config["linear_num_key_heads"]=4;config["linear_key_head_dim"]=128;
+            config["linear_num_value_heads"]=16;config["linear_value_head_dim"]=128;
+            config["linear_conv_kernel_dim"]=4;
+        }
+        config["num_hidden_layers"]=full_layers+(linear_prefix?1:0);
+        config["layer_types"]=Json::array();
+        if (linear_prefix) config["layer_types"].push_back("linear_attention");
+        for (std::uint32_t layer=0;layer<full_layers;++layer) config["layer_types"].push_back("full_attention");
+        file.root = {{"components", {{"text", {{"config", config}}}}},
+            {"objects", Json::array()}, {"bindings", Json::object()}, {"uses", Json::array()}};
+        const auto zero = [](size_t) { return 0.; };
+        tensor("text/token_embedding", {272, H}, [H](size_t i) { return input(int(i / H), int(i % H)); });
+        tensor("text/output_head", {272, H}, zero, "text/final_hidden");
+        // Qwen's native unit-offset norm uses gain = 1 + stored weight.
+        tensor("text/final_norm", {H}, zero);
+        if (linear_prefix) {
+            const std::string p="text/layers/0/";
+            tensor(p+"input_norm",{H},zero);tensor(p+"post_attention_norm",{H},zero);
+            // Real native GDN projections/convolution/recurrent state execute.
+            // Exact zero output isolates the attention oracle from GDN math.
+            const auto sparse=[H](size_t i){return i%H==(i/H)%H?.125:0.;};
+            tensor(p+"gdn/query",{512,H},sparse,p+"mixer_input");
+            tensor(p+"gdn/key",{512,H},sparse,p+"mixer_input");
+            tensor(p+"gdn/value",{2048,H},sparse,p+"mixer_input");
+            tensor(p+"gdn/z",{2048,H},zero,p+"mixer_input");
+            tensor(p+"gdn/a_projection",{16,H},zero,p+"mixer_input");
+            tensor(p+"gdn/b_projection",{16,H},zero,p+"mixer_input");
+            tensor(p+"gdn/a_log",{16},zero,{},QType::FP32);
+            tensor(p+"gdn/dt_bias",{16},zero,{},QType::FP32);
+            tensor(p+"gdn/convolution",{4,3072},[](size_t i){return i>=3*3072?1.:0.;});
+            tensor(p+"gdn/norm",{128},[](size_t){return 1.;});
+            tensor(p+"gdn/output",{H,2048},zero,p+"gdn/gated_output",QType::T2_G128_FP16);
+            zero_ffn(p,H);
+        }
+        for (std::uint32_t layer=0;layer<full_layers;++layer) {
+        const std::string p="text/layers/"+std::to_string(layer+(linear_prefix?1:0))+"/";
+        tensor(p + "input_norm", {H}, zero);
+        tensor(p + "post_attention_norm", {H}, zero);
+        tensor(p + "attention/query", {D * Q, H}, [H](size_t i) { return int(i % H) == int((i / H) % H) ? 1. : 0.; }, p + "mixer_input");
+        tensor(p + "attention/key", {D * K, H}, [H](size_t i) { return int(i % H) == int((i / H * 3) % H) ? 1. : 0.; }, p + "mixer_input");
+        tensor(p + "attention/gate", {D * Q, H}, zero, p + "mixer_input");
+        tensor(p + "attention/value", {D * K, H}, [H](size_t i) { return int(i % H) == int((i / H * 5) % H) ? .5 : 0.; }, p + "mixer_input");
+        tensor(p + "attention/query_norm", {D}, zero);
+        tensor(p + "attention/key_norm", {D}, zero);
+        // Tiny BF16 LinearAdd is outside the native finite registry. An exact
+        // ternary identity admits its existing generic A16 Linear+residual path.
+        tensor(p + "attention/output", {H, D * Q}, [](size_t i) { return i % (D * Q) == i / (D * Q) ? 1. : 0.; }, p + "attention/gated_output", QType::T2_G128_FP16);
+        // The native Q6 FFN uses generic Linear+SiLU, admitting a small zero
+        // block without asking a registered fused SwiGLU for an invalid shape.
+        zero_ffn(p,H);
+        }
+        if (with_mtp) {
+            check(H==2048 || H==5120,"native MTP pack fixture requires its actual registered hidden dimension");
+            file.root["components"]["mtp"]={{"target","text"},{"config",{{"architectures",{"Qwen3_5MTP"}}}}};
+            tensor("mtp/input_projection",{H,2u*H},[H](size_t i) {
+                const auto row=i/(2*H),col=i%(2*H);
+                return col==row || col==H+row?.5:0.;
+            },"mtp/stem_input");
+            for (const auto* norm:{"embedding_norm","hidden_norm","final_norm"})
+                tensor(std::string("mtp/")+norm,{H},zero);
+            const std::string p="mtp/layers/0/";
+            tensor(p+"input_norm",{H},zero);tensor(p+"post_attention_norm",{H},zero);
+            tensor(p+"attention/query",{D*Q,H},[H](size_t i){return i%H==(i/H)%H?1.:0.;},p+"mixer_input");
+            tensor(p+"attention/key",{D*K,H},[H](size_t i){return i%H==(i/H*3)%H?1.:0.;},p+"mixer_input");
+            tensor(p+"attention/gate",{D*Q,H},zero,p+"mixer_input");
+            tensor(p+"attention/value",{D*K,H},[H](size_t i){return i%H==(i/H*5)%H?.5:0.;},p+"mixer_input");
+            tensor(p+"attention/query_norm",{D},zero);tensor(p+"attention/key_norm",{D},zero);
+            tensor(p+"attention/output",{H,D*Q},[](size_t i){return i%(D*Q)==i/(D*Q)?1.:0.;},
+                p+"attention/gated_output",QType::T2_G128_FP16);
+            zero_ffn(p,H);
+            file.root["uses"].push_back({{"parameter","text/output_head"},{"input","mtp/final_hidden"},
+                {"activation_policy","A16Only"}});
+        }
+        Json vocab = Json::object(), added = Json::array(), decoder = Json::object();
+        unsigned next = 256;
+        for (unsigned byte = 0; byte < 256; ++byte) {
+            const bool visible = (byte >= 33 && byte <= 126) || (byte >= 161 && byte <= 172) || byte >= 174;
+            const unsigned cp = visible ? byte : next++;
+            std::string token;
+            if (cp < 128) token.push_back(char(cp));
+            else { token.push_back(char(0xc0 | cp >> 6)); token.push_back(char(0x80 | (cp & 63))); }
+            vocab[token] = byte;
+        }
+        const std::array specials{"<|endoftext|>", "<|im_start|>", "<|im_end|>", "<think>", "</think>",
+                                  "<|vision_start|>", "<|vision_end|>", "<|image_pad|>", "<|video_pad|>","<tool_call>","</tool_call>"};
+        for (size_t i = 0; i < specials.size(); ++i) {
+            // Qwen reasoning/tool delimiters are added ordinary tokens: the
+            // presented response must retain </think> for semantic parsing.
+            Json token{{"id", 256 + i}, {"content", specials[i]}, {"special", i!=3 && i!=4 && i!=9 && i!=10},
+                       {"single_word", false}, {"lstrip", false}, {"rstrip", false}, {"normalized", false}};
+            added.push_back(token); decoder[std::to_string(256 + i)] = token;
+        }
+        resource("tokenizer.json", Json{{"model", {{"type", "BPE"}, {"vocab", vocab}, {"merges", Json::array()}}}, {"added_tokens", added}}.dump());
+        resource("tokenizer_config.json", Json{{"added_tokens_decoder", decoder},
+            {"add_bos_token",false},{"add_prefix_space",false},{"pad_token","<|endoftext|>"}}.dump());
+        resource("generation_config.json", Json{{"eos_token_id", {256, 258}}}.dump());
+        resource("chat_template.jinja", std::string(chat_template));
+        file.root["files"] = Json::array({{{"path", nullptr}, {"payload_bytes", file.payload.size()}}});
+        file.write();
+    }
+};
+
