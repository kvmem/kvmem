@@ -0,0 +1,175 @@
+#include "ninfer/engine.h"
+#include "kvmem_test_options.h"
+#include <atomic>
+#include <iostream>
+#include <stdexcept>
+#include <string>
+
+namespace {
+void require(bool condition, const char* message) {
+    if (!condition) throw std::runtime_error(message);
+}
+ninfer::PromptInput history(const std::string& key) {
+    ninfer::PromptInput input;
+    input.context_cache.session_key = key;
+    const auto add = [&](ninfer::ChatRole role, std::string text) {
+        ninfer::ChatMessage message;
+        message.role = role;
+        message.parts.push_back({.kind = ninfer::MessagePartKind::Text, .text = std::move(text)});
+        input.messages.push_back(std::move(message));
+    };
+    add(ninfer::ChatRole::System, "Read archive " + key + " and answer briefly.");
+    for (int entry = 0; entry < 16; ++entry) {
+        std::string text = "Archive entry " + std::to_string(entry) + ". ";
+        for (int repeat = 0; repeat < 8; ++repeat)
+            text += entry < 4 ? "The violet observatory studies pulsars, cosmic rays and distant galaxies. "
+                             : "The coastal office files invoices, transport schedules and warehouse inventories. ";
+        add(ninfer::ChatRole::User, text);
+        add(ninfer::ChatRole::Assistant, "Recorded.");
+    }
+    add(ninfer::ChatRole::User, "What does the violet observatory study?");
+    return input;
+}
+struct Sink final : ninfer::OutputSink {
+    bool cancel_enabled = false;
+    ninfer::Engine* memory_probe = nullptr;
+    bool observed_active_memory = false;
+    void observe_memory() {
+        if (!memory_probe) return;
+        // Read the gauges from the same published execution boundary. The full
+        // memory_summary() takes the execution lock and can wait for completion.
+        const auto snapshot = memory_probe->runtime_stats();
+        if (snapshot.running_requests != 1) return;
+        const auto& memory = snapshot.kvmem;
+        require(memory.active_payload_reservation_bytes == 0,
+                "short request unexpectedly obtained a Host reservation");
+        require(memory.host_payload_bytes == 0,
+                "active short unretained request allocated Host archive pages");
+        observed_active_memory = true;
+    }
+    std::atomic<bool> cancelled{false};
+    void start(ninfer::GenerationStart) override {}
+    void progress(ninfer::PromptProgress) override {}
+    void publish(ninfer::OutputDelta) override { observe_memory(); }
+    void timing(ninfer::GenerationTimingObservation value) override {
+        if (value.generated_tokens) observe_memory();
+        if (cancel_enabled && value.generated_tokens >= 8) cancelled.store(true);
+    }
+};
+}
+
+int main(int argc, char** argv) {
+    try {
+        require(argc >= 3 && argc <= 5, "artifact draft-count(0..4) [bf16|int8|nvfp4|k8v4|rk8v4] [eager|graph]");
+        ninfer::EngineOptions options;
+        ninfer::test::kvmem_test_devices(options);
+        options.artifact_path = argv[1];
+        options.device_profile = "off";
+        options.max_context = 16384;
+        options.prefill_chunk = 128;
+        options.kv_cache = argc >= 4 ? ninfer::test::kvmem_test_storage(argv[3])
+                                    : ninfer::KvCacheStorage::Int8Group64;
+        if (argc == 5) options.use_cuda_graph = ninfer::test::kvmem_test_graph(argv[4]);
+        options.kv_capacity = ninfer::KvCapacityPolicy::explicit_capacity(512);
+        options.kvmem = {.selected_tokens = 384, .reserve_tokens = 128,
+            .host_bytes = ninfer::test::kvmem_test_host_bytes(230ULL << 20, options.kv_cache),
+            .retained_sessions = 3, .verify_transfers = true};
+        options.context_cache.enabled = false;
+        const auto drafts = static_cast<std::uint32_t>(std::stoul(argv[2]));
+        if (drafts) {
+            options.speculative.backend = ninfer::SpeculativeBackend::Mtp;
+            options.speculative.draft_tokens = drafts;
+        }
+        ninfer::Engine engine(options);
+        const auto run = [&](const char* name, ninfer::PromptInput input, bool expected_reuse,
+                             bool allow_reuse = true, bool cancel = false) {
+            ninfer::RequestOptions request;
+            request.execution.allow_prefix_reuse = allow_reuse;
+            request.execution.requested_output_tokens = cancel ? 130 : 24;
+            request.execution.sampling.temperature = 0;
+            request.stop.include_model_defaults = false;
+            Sink sink;
+            sink.cancel_enabled = cancel;
+            auto result = engine.submit(engine.prepare(std::move(input)), request,
+                ninfer::OutputConsumerMode::Streaming, {.live_timings = true})
+                .wait(&sink, ninfer::CancellationView([&] { return sink.cancelled.load(); }));
+            require(engine.is_available(), "Engine became unavailable");
+            require((result.reused_prompt_tokens != 0) == expected_reuse, "wrong session reuse decision");
+            require(cancel ? result.finish_reason == ninfer::FinishReason::Cancelled
+                           : result.generated_token_ids.size() == 24, "wrong termination");
+            const auto memory = engine.memory_summary().kvmem;
+            require(memory.host_payload_bytes <= options.kvmem.host_bytes, "global H exceeded");
+            require(memory.retained_sessions <= 3, "session count limit exceeded");
+            require(memory.resident_pages == 0 && memory.mtp_resident_pages == 0, "device pages leaked");
+            std::cout << "MEMORY_SESSION " << name << " reused=" << result.reused_prompt_tokens
+                      << " retained=" << memory.retained_sessions << " H=" << memory.host_payload_bytes
+                      << " evictions=" << memory.history_evictions << std::endl;
+            return result;
+        };
+        // Cross a Prefill chunk without crossing the physical window. With reuse
+        // disabled this request needs no Host reservation, even though RAM lookahead
+        // is enabled globally. Observe before terminal cleanup can hide an allocation.
+        ninfer::PromptInput short_unretained;
+        short_unretained.options.enable_thinking = false;
+        ninfer::ChatMessage short_message;
+        short_message.role = ninfer::ChatRole::User;
+        std::string short_text;
+        for (int repeat = 0; repeat < 24; ++repeat)
+            short_text += "The notebook contains ordinary observation notes. ";
+        short_text += "Continue with a detailed explanation.";
+        short_message.parts.push_back({.kind = ninfer::MessagePartKind::Text, .text = std::move(short_text)});
+        short_unretained.messages.push_back(std::move(short_message));
+        auto short_prepared = engine.prepare(std::move(short_unretained));
+        constexpr std::uint32_t short_output = 128;
+        require(short_prepared.summary().prompt_tokens > options.prefill_chunk,
+                "short-request fixture did not exercise next-chunk preparation");
+        require(short_prepared.summary().prompt_tokens + short_output <= options.kvmem.device_tokens(),
+                "short-request fixture unexpectedly requires Host archive capacity");
+        std::cout << "MEMORY_SHORT_UNRETAINED tokens=" << short_prepared.summary().prompt_tokens << std::endl;
+        ninfer::RequestOptions short_options;
+        short_options.execution.allow_prefix_reuse = false;
+        short_options.execution.requested_output_tokens = short_output;
+        short_options.execution.sampling.temperature = 0;
+        short_options.stop.include_model_defaults = false;
+        Sink short_sink;
+        short_sink.memory_probe = &engine;
+        const auto short_result = engine.submit(std::move(short_prepared), short_options,
+            ninfer::OutputConsumerMode::Streaming, {.live_timings = true})
+            .wait(&short_sink, ninfer::CancellationView([] { return false; }));
+        require(short_result.generated_token_ids.size() == short_output, "short request did not complete");
+        require(short_sink.observed_active_memory, "short request had no active memory observation");
+        require(engine.memory_summary().kvmem.host_payload_bytes == 0,
+                "short unretained request leaked Host archive pages");
+        std::cout << "MEMORY_SHORT_UNRETAINED PASS active_reservation=0 active_payload=0" << std::endl;
+        auto a = history("A"), b = history("B"), c = history("C"), d = history("D");
+        const auto first = run("A-cold", a, false);
+        run("B-cold", b, false);
+        require(first.generated_token_ids == run("A-return", a, true).generated_token_ids,
+                "A/B/A changed the trusted result");
+        run("C-cold", c, false);
+        run("D-pressure", d, false);
+        require(engine.memory_summary().kvmem.history_evictions > 0, "Host pressure did not evict");
+        run("B-evicted", b, false);
+        run("C-return", c, true);
+        run("C-cancel", c, true, true, true);
+        run("C-resume", c, true);
+        auto no_update = c;
+        no_update.context_cache.update_session_index = false;
+        no_update.messages.front().parts.front().text = "Read the temporary branch carefully.";
+        run("C-no-update", no_update, false);
+        run("C-index-preserved", c, true);
+        run("C-clear", c, false, false);
+        run("C-cleared", c, false);
+        auto other_key = c;
+        other_key.context_cache.session_key = "same-text-other-key";
+        run("different-key", other_key, false);
+        auto edited = other_key;
+        edited.messages[1].parts[0].text = "The archive was edited.";
+        run("edited-prefix", edited, false);
+        run("edited-repeat", edited, true);
+        std::cout << "MEMORY_SESSIONS PASS" << std::endl;
+    } catch (const std::exception& error) {
+        std::cerr << error.what() << '\n';
+        return 1;
+    }
+}
diff --git a/tests/experimental/memory_vision.cpp b/tests/experimental/memory_vision.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..446e6e0bad172383417233f974de738cfff7b810
--- /dev/null
+++ b/tests/experimental/memory_vision.cpp
@@ -0,0 +1,285 @@
+#include "ninfer/engine.h"
+#include "kvmem_test_options.h"
+#include <algorithm>
+#include <atomic>
+#include <cctype>
+#include <cstdlib>
+#include <filesystem>
+#include <fstream>
+#include <iostream>
+#include <iterator>
+#include <stdexcept>
+#include <string>
+
+namespace {
+void require(bool value, const char* message) {
+    if (!value) throw std::runtime_error(message);
+}
+ninfer::OwnedMedia media(const char* path) {
+    std::ifstream file(path, std::ios::binary);
+    require(file.good(), "image fixture is missing");
+    ninfer::OwnedMedia value;
+    value.bytes.assign(std::istreambuf_iterator<char>(file), {});
+    value.media_type = "image/png";
+    value.source_name = "image.png"; // Content identity must not depend on the file name.
+    return value;
+}
+void add(ninfer::PromptInput& input, ninfer::ChatRole role, std::string text,
+         std::vector<ninfer::OwnedMedia> images = {}) {
+    ninfer::ChatMessage message;
+    message.role = role;
+    for (auto& image : images)
+        message.parts.push_back({.kind = ninfer::MessagePartKind::Media, .media = std::move(image)});
+    message.parts.push_back({.kind = ninfer::MessagePartKind::Text, .text = std::move(text)});
+    input.messages.push_back(std::move(message));
+}
+void filler(ninfer::PromptInput& input) {
+    for (int index = 0; index < 12; ++index) {
+        std::string text = "Archive entry " + std::to_string(index) + ". ";
+        for (int count = 0; count < 8; ++count)
+            text += "The observatory records pulsars, galaxies, stars and meteor showers. ";
+        add(input, ninfer::ChatRole::User, text);
+        add(input, ninfer::ChatRole::Assistant, "Recorded.");
+    }
+}
+struct Sink final : ninfer::OutputSink {
+    bool cancel_enabled = false;
+    std::atomic<bool> cancelled{false};
+    void start(ninfer::GenerationStart) override {}
+    void progress(ninfer::PromptProgress) override {}
+    void publish(ninfer::OutputDelta) override {}
+    void timing(ninfer::GenerationTimingObservation value) override {
+        if (cancel_enabled && value.generated_tokens >= 12) cancelled.store(true);
+    }
+};
+}
+
+int main(int argc, char** argv) {
+    try {
+        require(argc >= 6 && argc <= 13,
+                "artifact draft-count(0..15) native|kvmem red.png blue.png [bf16|int8|fp8|nvfp4|k8v4|rk8v4|rk4v4|rk4v4-e8|rk2v4-e8] [eager|graph] [resident|cpu] [all|query-only|native-boundary|copy-compare] [fixed|adaptive] [ngram-width] [ssd-host-MiB]");
+        const auto red = media(argv[4]), blue = media(argv[5]);
+        const bool memory = std::string(argv[3]) == "kvmem";
+        const auto drafts = static_cast<std::uint32_t>(std::stoul(argv[2]));
+        ninfer::EngineOptions options;
+        ninfer::test::kvmem_test_devices(options);
+        options.artifact_path = argv[1];
+        options.device_profile = "off";
+        if (const auto* fast = std::getenv("NINFER_TEST_FAST_PREFILL")) {
+            require(std::string(fast) == "0" || std::string(fast) == "1", "NINFER_TEST_FAST_PREFILL must be 0 or 1");
+            options.fast_prefill_kernel = fast[0] == '1';
+        }
+        options.max_context = 8192;
+        options.prefill_chunk = 128;
+        options.enable_vision = true;
+        options.vision_max_merged_tokens = 256;
+        options.kv_cache = argc >= 7 ? ninfer::test::kvmem_test_storage(argv[6])
+                                    : ninfer::KvCacheStorage::Int8Group64;
+        if (argc >= 8) options.use_cuda_graph = ninfer::test::kvmem_test_graph(argv[7]);
+        options.kv_capacity = ninfer::KvCapacityPolicy::explicit_capacity(memory ? 896 : 8192);
+        options.context_cache.enabled = false;
+        if (memory) options.kvmem = {.selected_tokens = 768, .reserve_tokens = 128,
+            .host_bytes = 512ULL << 20, .retained_sessions = 4, .verify_transfers = true};
+        if (drafts) {
+            options.speculative.backend = ninfer::SpeculativeBackend::Mtp;
+            options.speculative.draft_tokens = drafts;
+        }
+        if (argc >= 9) {
+            require(std::string(argv[8]) == "cpu" || std::string(argv[8]) == "resident", "expected resident or cpu");
+            options.vision_residency = std::string(argv[8]) == "cpu" ? ninfer::VisionResidency::Cpu
+                                                                   : ninfer::VisionResidency::Resident;
+        }
+        if (argc >= 11) {
+            require(std::string(argv[10]) == "adaptive" || std::string(argv[10]) == "fixed", "expected fixed or adaptive");
+            options.speculative.mtp_policy = std::string(argv[10]) == "adaptive"
+                ? ninfer::MtpDraftPolicy::Adaptive : ninfer::MtpDraftPolicy::Fixed;
+        }
+        if (argc >= 12) options.speculative.ngram_draft_tokens = static_cast<std::uint32_t>(std::stoul(argv[11]));
+        if (argc == 13) {
+            require(memory && std::string(argv[9]) == "all", "SSD fixture requires kvmem/all");
+            options.kvmem.host_bytes = std::stoull(argv[12]) << 20;
+            options.kvmem.disk_bytes = 4ULL << 30;
+            options.kvmem.disk_path = std::filesystem::current_path() / "vision-ssd-spill";
+        }
+        std::cout << "MEMORY_FEATURE fast_prefill=" << options.fast_prefill_kernel << std::endl;
+        ninfer::Engine engine(options);
+        const auto input = [](const char* key) {
+            ninfer::PromptInput result;
+            result.options.enable_thinking = false;
+            result.context_cache.session_key = key;
+            add(result, ninfer::ChatRole::System, "Answer questions about the supplied images in English.");
+            return result;
+        };
+        const auto run = [&](const char* label, ninfer::PromptInput prompt,
+                             std::vector<std::string> expected, bool reused, bool cancel = false,
+                             std::uint32_t count = 48, float temperature = 0.0F,
+                             bool model_stops = false) {
+            ninfer::RequestOptions request;
+            request.execution.requested_output_tokens = cancel ? 160 : count;
+            request.execution.sampling.temperature = temperature;
+            request.execution.sampling.seed = 42;
+            request.execution.sampling.top_k = 20;
+            request.execution.sampling.top_p = 0.9F;
+            request.stop.include_model_defaults = model_stops;
+            Sink sink;
+            sink.cancel_enabled = cancel;
+            const auto result = engine.submit(engine.prepare(std::move(prompt)), request,
+                ninfer::OutputConsumerMode::Streaming, {.live_timings = true})
+                .wait(&sink, ninfer::CancellationView([&] { return sink.cancelled.load(); }));
+            require(engine.is_available(), "image request made Engine unavailable");
+            require((result.reused_prompt_tokens != 0) == (memory && reused), "wrong image reuse decision");
+            require(cancel ? result.finish_reason == ninfer::FinishReason::Cancelled
+                           : (!result.generated_token_ids.empty() && result.generated_token_ids.size() <= count &&
+                              (model_stops || result.generated_token_ids.size() == count)), "wrong image request termination");
+            require(result.prompt.has_media, "vision fixture lost media");
+            if (options.speculative.mtp_policy == ninfer::MtpDraftPolicy::Adaptive) {
+                require(result.speculative.adaptive, "adaptive MTP was silently disabled");
+                std::cout << "MEMORY_ADAPTIVE " << label
+                          << " transitions=" << result.speculative.window_transitions << " windows=";
+                for (auto count : result.speculative.rounds_per_window) std::cout << count << ',';
+                std::cout << std::endl;
+            }
+            auto text = result.content;
+            std::transform(text.begin(), text.end(), text.begin(), [](unsigned char c) { return std::tolower(c); });
+            for (const auto& word : expected)
+                require(text.find(word) != std::string::npos, "image answer did not match fixture");
+            if (memory) {
+                const auto usage = engine.memory_summary().kvmem;
+                require(usage.resident_pages == 0 && usage.mtp_resident_pages == 0 &&
+                    usage.host_payload_bytes <= options.kvmem.host_bytes, "image request leaked or exceeded resources");
+                require(usage.disk_payload_bytes <= options.kvmem.disk_bytes && usage.disk_errors == 0,
+                        "image request exceeded SSD quota or reported an I/O error");
+            }
+            // Stable token evidence also covers text omitted by presentation.
+            std::cout << "MEMORY_VISION_TOKENS " << label << " ids=";
+            for (auto token : result.generated_token_ids) std::cout << token << ',';
+            std::cout << std::endl;
+            std::cout << "MEMORY_VISION " << label << " reused=" << result.reused_prompt_tokens
+                      << " output=" << result.generated_token_ids.size() << " accepted="
+                      << result.speculative.accepted_tokens << " prompt=" << result.prompt.prompt_tokens
+                      << " ng_rounds=" << result.speculative.ngram_rounds
+                      << " ng_drafted=" << result.speculative.ngram_drafted_tokens
+                      << " ng_accepted=" << result.speculative.ngram_accepted_tokens
+                      << " text=" << result.content << std::endl;
+            return result;
+        };
+        const bool copy_compare = argc >= 10 && std::string(argv[9]) == "copy-compare";
+        if (options.speculative.ngram_draft_tokens || copy_compare) {
+            auto copy = input("image-copy");
+            filler(copy);
+            std::string passage = "The violet observatory opens at sunrise. ";
+            for (int i = 0; i < 12; ++i)
+                passage += "Its telescope observes distant galaxies, while the astronomers record the changing light of stars. ";
+            add(copy, ninfer::ChatRole::User,
+                "First state the image's color in English. Then copy the following passage exactly, without explanations:\n" + passage, {red});
+            const auto cold = run("image-copy-cold", copy, {"red", "violet observatory"}, false, false, 192, 0.0F, true);
+            if (memory) require(cold.prompt.prompt_tokens > options.kvmem.device_tokens(), "copy did not cross the device window");
+            if (options.speculative.ngram_draft_tokens) require(cold.speculative.ngram_rounds > 0 && cold.speculative.ngram_accepted_tokens >
+                drafts * cold.speculative.ngram_rounds, "image copy did not exercise wide accepted ngram proposals");
+            const auto repeat = run("image-copy-repeat", copy, {"red"}, true, false, 192, 0.0F, true);
+            if (cold.generated_token_ids != repeat.generated_token_ids) {
+                const auto diff = std::mismatch(cold.generated_token_ids.begin(), cold.generated_token_ids.end(),
+                    repeat.generated_token_ids.begin(), repeat.generated_token_ids.end());
+                std::cout << "MEMORY_VISION COPY_DIFFERENCE token=" << (diff.first - cold.generated_token_ids.begin())
+                          << " cold_size=" << cold.generated_token_ids.size() << " repeat_size=" << repeat.generated_token_ids.size();
+                if (diff.first != cold.generated_token_ids.end()) std::cout << " cold_token=" << *diff.first;
+                if (diff.second != repeat.generated_token_ids.end()) std::cout << " repeat_token=" << *diff.second;
+                std::cout << std::endl;
+            }
+            require(cold.generated_token_ids == repeat.generated_token_ids, "image ngram restore changed greedy output");
+            if (copy_compare) { std::cout << "MEMORY_VISION COPY_COMPARE PASS" << std::endl; return 0; }
+            run("image-copy-cancel", copy, {}, true, true, 192, 0.0F, true);
+            const auto recovered = run("image-copy-recovery", copy, {"red"}, true, false, 192, 0.0F, true);
+            require(cold.generated_token_ids == recovered.generated_token_ids, "image ngram cancellation polluted history");
+            for (auto count : {1U, 2U, 65U}) {
+                const auto limited = run("image-copy-limit", copy, {}, true, false, count, 0.0F, true);
+                require(limited.generated_token_ids.front() == cold.generated_token_ids.front(), "image ngram output limit changed first token");
+            }
+            const auto sampled = run("image-copy-sampling", copy, {}, true, false, 96, 0.8F, true);
+            const auto sampled_again = run("image-copy-sampling-repeat", copy, {}, true, false, 96, 0.8F, true);
+            require(sampled.generated_token_ids == sampled_again.generated_token_ids, "image ngram restore changed seeded sampling");
+            auto edited = copy;
+            edited.messages[1].parts[0].text = "This archive entry was replaced.";
+            run("image-copy-edited-prefix", edited, {"red", "violet observatory"}, false, false, 96, 0.0F, true);
+        }
+        if (argc >= 10 && std::string(argv[9]) != "all") {
+            const bool boundary = std::string(argv[9]) == "native-boundary";
+            require(boundary || std::string(argv[9]) == "query-only", "expected query-only or native-boundary");
+            auto query = input("query-image");
+            filler(query);
+            add(query, ninfer::ChatRole::User, "What color fills this image?", {red});
+            if (boundary) {
+                // Align the first visual embedding with a 128-token unit boundary.
+                // The preceding unit has no Main visual columns but one shifted MTP column.
+                for (int i = 0; i < 36; ++i) query.messages[0].parts[0].text += " x";
+            }
+            run("query-image-replay", query, {"red"}, false);
+            if (boundary) {
+                std::cout << "MEMORY_VISION NATIVE_BOUNDARY PASS" << std::endl;
+                return 0;
+            }
+            run("query-image-repeat", query, {"red"}, true);
+            auto multiple = input("multiple");
+            filler(multiple);
+            add(multiple, ninfer::ChatRole::User,
+                "Name the colors of the first and second images, in order.", {red, blue});
+            run("multiple-query-images", multiple, {"red", "blue"}, false);
+            run("query-cancel", multiple, {}, true, true);
+            run("query-recovery", multiple, {"red", "blue"}, true);
+            std::cout << "MEMORY_VISION QUERY PASS" << std::endl;
+            return 0;
+        }
+        auto short_image = input("short");
+        add(short_image, ninfer::ChatRole::User, "What color fills this image?", {red});
+        run("single", short_image, {"red"}, false);
+
+        auto old_image = input("old-image");
+        add(old_image, ninfer::ChatRole::User, "Remember this image for a later question.", {red});
+        add(old_image, ninfer::ChatRole::Assistant, "I will remember it.");
+        filler(old_image);
+        add(old_image, ninfer::ChatRole::User, "What color filled the image at the start?");
+        run("old-image-cold", old_image, {"red"}, false);
+        run("old-image-repeat", old_image, {"red"}, true);
+        auto replacement = old_image;
+        replacement.messages[1].parts[0].media = blue;
+        run("same-placeholder-new-media", replacement, {"blue"}, false);
+        run("replacement-repeat", replacement, {"blue"}, true);
+        run("cancel", replacement, {}, true, true);
+        run("cancel-recovery", replacement, {"blue"}, true);
+
+        auto query_image = input("query-image");
+        filler(query_image);
+        add(query_image, ninfer::ChatRole::User, "What color fills this image?", {red});
+        run("query-image-replay", query_image, {"red"}, false);
+        run("query-image-repeat", query_image, {"red"}, true);
+        auto multiple = input("multiple");
+        filler(multiple);
+        add(multiple, ninfer::ChatRole::User, "Name the colors of the first and second images, in order.", {red, blue});
+        run("multiple-query-images", multiple, {"red", "blue"}, false);
+        if (memory) {
+            auto oversized = input("over-budget");
+            add(oversized, ninfer::ChatRole::User, "Describe all three images.", {red, blue, red});
+            bool rejected = false;
+            try {
+                ninfer::RequestOptions request;
+                request.execution.requested_output_tokens = 16;
+                (void)engine.generate(engine.prepare(std::move(oversized)), request);
+            } catch (const ninfer::RequestError& error) {
+                rejected = error.kind() == ninfer::RequestErrorKind::ContextLengthExceeded;
+            }
+            require(rejected && engine.is_available(), "image budget failure was not rejected at admission");
+            // Admission rejection must preserve the earlier short-input checkpoint.
+            run("after-budget-error", short_image, {"red"}, true);
+        }
+        if (options.kvmem.disk_bytes) {
+            const auto usage = engine.memory_summary().kvmem;
+            require(usage.disk_read_bytes && usage.disk_written_bytes, "vision fixture did not exercise SSD");
+            std::cout << "MEMORY_VISION_SSD reads=" << usage.disk_read_bytes
+                      << " writes=" << usage.disk_written_bytes << std::endl;
+        }
+        std::cout << "MEMORY_VISION PASS" << std::endl;
+    } catch (const std::exception& error) {
+        std::cerr << error.what() << '\n';
+        return 1;
+    }
+}
diff --git a/tests/experimental/migration_concurrency.cpp b/tests/experimental/migration_concurrency.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..ac816726c383013471f88808d633d2d820f7014d
--- /dev/null
+++ b/tests/experimental/migration_concurrency.cpp
@@ -0,0 +1,81 @@
+#include "ninfer/engine.h"
+#include "kvmem_test_options.h"
+#include <atomic>
+#include <future>
+#include <iostream>
+#include <stdexcept>
+#include <vector>
+
+// One short C8 batch and its restored repeat cover lane ownership and scheduling
+// without repeating the long-history stress suite.
+int main(int argc, char** argv) {
+    try {
+        if (argc != 2) throw std::invalid_argument("artifact");
+        ninfer::EngineOptions o;
+        ninfer::test::kvmem_test_devices(o);
+        o.artifact_path = argv[1];
+        o.device_profile = "off";
+        o.max_context = 2048;
+        o.max_concurrency = 8;
+        o.prefill_chunk = 128;
+        o.kv_cache = ninfer::KvCacheStorage::RotatedInt8KeyInt4ValueGroup64;
+        o.kv_capacity = ninfer::KvCapacityPolicy::explicit_capacity(8 * 256);
+        o.kvmem = {.selected_tokens = 128, .reserve_tokens = 128,
+            .host_bytes = 512ULL << 20, .retained_sessions = 8, .verify_transfers = true};
+        o.context_cache.enabled = false;
+        o.use_cuda_graph = true;
+        o.speculative.backend = ninfer::SpeculativeBackend::Mtp;
+        o.speculative.draft_tokens = 4;
+        o.speculative.mtp_policy = ninfer::MtpDraftPolicy::Adaptive;
+        o.speculative.ngram_draft_tokens = 15;
+        ninfer::Engine engine(o);
+        std::vector<ninfer::PromptInput> prompts(8);
+        for (unsigned row = 0; row < 8; ++row) {
+            auto& p = prompts[row];
+            p.context_cache.session_key = "migration-lane-" + std::to_string(row);
+            p.options.enable_thinking = false;
+            ninfer::ChatMessage m;
+            m.role = ninfer::ChatRole::User;
+            m.parts.push_back({.kind = ninfer::MessagePartKind::Text,
+                .text = "List integers from " + std::to_string(100 * row) + " in order."});
+            p.messages.push_back(std::move(m));
+        }
+        std::vector<std::vector<ninfer::TokenId>> previous(8);
+        for (unsigned round = 0; round < 2; ++round) {
+            const auto before = engine.runtime_stats();
+            std::vector<std::future<ninfer::GenerationResult>> futures;
+            for (const auto& p : prompts) {
+                ninfer::RequestOptions request;
+                request.execution.requested_output_tokens = 48;
+                request.execution.sampling.temperature = 0;
+                request.stop.include_model_defaults = false;
+                auto handle = engine.submit(engine.prepare(p), request);
+                futures.push_back(std::async(std::launch::async,
+                    [h = std::move(handle)]() mutable { return h.wait(); }));
+            }
+            for (unsigned row = 0; row < 8; ++row) {
+                const auto r = futures[row].get();
+                if (r.generated_token_ids.size() != 48 || (r.reused_prompt_tokens != 0) != (round != 0))
+                    throw std::runtime_error("C8 output or checkpoint ownership changed");
+                if (round && previous[row] != r.generated_token_ids)
+                    throw std::runtime_error("C8 checkpoint replay changed greedy output");
+                previous[row] = r.generated_token_ids;
+                std::cout << "C8 round=" << round << " lane=" << row
+                          << " reused=" << r.reused_prompt_tokens << '\n';
+            }
+            const auto usage = engine.memory_summary().kvmem;
+            const auto stats = engine.runtime_stats();
+            if (stats.decode_row_rounds - before.decode_row_rounds <=
+                stats.decode_rounds - before.decode_rounds)
+                throw std::runtime_error("C8 batch did not execute concurrent decode rows");
+            if (!engine.is_available() || usage.resident_pages || usage.mtp_resident_pages ||
+                usage.host_payload_bytes > o.kvmem.host_bytes)
+                throw std::runtime_error("C8 resources leaked or exceeded Host budget");
+        }
+        std::cout << "MIGRATION_C8 PASS\n";
+        return 0;
+    } catch (const std::exception& error) {
+        std::cerr << "MIGRATION_C8 FAIL " << error.what() << '\n';
+        return 1;
+    }
+}
diff --git a/tests/experimental/nvfp4_mode_binding.cpp b/tests/experimental/nvfp4_mode_binding.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..2733b86d844d767763b90d21e9f0952e8d771010
--- /dev/null
+++ b/tests/experimental/nvfp4_mode_binding.cpp
@@ -0,0 +1,61 @@
+#include "ninfer/engine.h"
+#include <filesystem>
+#include <iostream>
+#include <stdexcept>
+
+namespace {
+void require(bool condition,const char* message) {if(!condition) throw std::runtime_error(message);}
+ninfer::EngineOptions options(const char* artifact) {
+    ninfer::EngineOptions out;
+    out.artifact_path=artifact;out.device_profile="off";out.max_context=1024;
+    out.kv_capacity=ninfer::KvCapacityPolicy::explicit_capacity(1024);out.prefill_chunk=128;
+    out.use_cuda_graph=false;out.speculative.backend=ninfer::SpeculativeBackend::None;
+    out.speculative.ngram_draft_tokens=0;out.max_concurrency=1;
+    out.context_cache.device_state_slots=1;out.context_cache.host_state_slots=0;
+    out.context_cache.host_kv_capacity_bytes=0;out.context_cache.max_private_continuations=1;
+    out.context_cache.max_shared_prefixes=0;
+    return out;
+}
+void save(ninfer::Engine& engine,const std::string& path) {
+    ninfer::PromptInput prompt;prompt.options.enable_thinking=false;
+    ninfer::ChatMessage message;message.role=ninfer::ChatRole::User;
+    message.parts.push_back({.kind=ninfer::MessagePartKind::Text,.text="Return one word."});
+    prompt.messages.push_back(std::move(message));
+    ninfer::RequestOptions request;request.execution.requested_output_tokens=2;
+    request.execution.sampling.temperature=0;request.stop.include_model_defaults=false;
+    const auto result=engine.generate(engine.prepare(prompt),request);
+    require(result.slot>=0,"fixture did not retain a native slot");
+    require(engine.save_slot(static_cast<std::uint32_t>(result.slot),path).bytes>0,"empty snapshot");
+}
+void reject(ninfer::Engine& engine,const std::string& path) {
+    bool refused=false;
+    try {(void)engine.restore_slot(0,path);} catch(const std::invalid_argument& error) {
+        refused=std::string(error.what()).find("different model")!=std::string::npos;
+    }
+    require(refused,"snapshot from another weight mode was accepted");
+}
+}
+int main(int argc,char** argv) {
+    if (argc!=3) {
+        std::cout<<"SKIP: provide artifact and output-directory for native snapshot mode binding\n";
+        return 77;
+    }
+    try {
+        const auto directory=std::filesystem::absolute(argv[2]);std::filesystem::create_directories(directory);
+        const auto base_file=(directory/"default.bin").string(),a16_file=(directory/"a16.bin").string();
+        std::string base,a16;
+        {ninfer::Engine engine(options(argv[1]));base=engine.load_summary().prefill_signature;save(engine,base_file);}
+        {auto o=options(argv[1]);o.nvfp4_w4a16=true;ninfer::Engine engine(o);
+         a16=engine.load_summary().prefill_signature;require(a16!=base,"W4A16 signature equals default");
+         reject(engine,base_file);save(engine,a16_file);}
+        {auto o=options(argv[1]);o.nvfp4_w4a8_int=true;ninfer::Engine engine(o);
+         const auto signature=engine.load_summary().prefill_signature;
+         require(signature!=base && signature!=a16,"W4A8 signature collides with another mode");
+         reject(engine,base_file);reject(engine,a16_file);}
+        {auto o=options(argv[1]);o.nvfp4_w4a16=true;o.nvfp4_w4a8_int=true;ninfer::Engine engine(o);
+         require(engine.load_summary().prefill_signature==a16,"W4A16 precedence changes signature");
+         require(engine.restore_slot(0,a16_file).tokens>0,"same effective mode restore failed");}
+        std::cout<<"NVFP4 mode signatures and native snapshot isolation passed; non-NVFP4 fixture qualifies binding only\n";
+        return 0;
+    } catch(const std::exception& error) {std::cerr<<error.what()<<'\n';return 1;}
+}
diff --git a/tests/experimental/nvfp4_native_scale.cu b/tests/experimental/nvfp4_native_scale.cu
new file mode 100644
index 0000000000000000000000000000000000000000..1f83e1b39cf09fd2743a64fe8969b77aab9b093b
--- /dev/null
+++ b/tests/experimental/nvfp4_native_scale.cu
@@ -0,0 +1,69 @@
+#include "ops/linear/nvfp4/nvfp4_codec_unified.cuh"
+#include <cuda_runtime.h>
+#include <bit>
+#include <cmath>
+#include <cstdint>
+#include <iostream>
+#include <stdexcept>
+#include <vector>
+
+namespace {
+constexpr unsigned cases = 256 * 128;
+__global__ void decode(std::uint32_t* output) {
+    const unsigned index = blockIdx.x * blockDim.x + threadIdx.x;
+    if (index >= cases) return;
+    const auto code = static_cast<std::uint8_t>(index & 255);
+    const auto scale = static_cast<std::uint8_t>(index >> 8);
+    output[5 * index] = ninfer::ops::detail::unified::nvfp4_scaled_pair_bf16(code, scale);
+    unsigned word = 0;
+    for (unsigned i = 0; i < 4; ++i) word |= unsigned(code ^ (i * 0x55u)) << (8 * i);
+    ninfer::ops::detail::unified::nvfp4_scaled_quad_bf16(word, scale, output + 5 * index + 1);
+}
+void check(cudaError_t error) {
+    if (error != cudaSuccess) throw std::runtime_error(cudaGetErrorString(error));
+}
+std::uint16_t expected(unsigned code, unsigned scale) {
+    constexpr double magnitudes[]{0, 0.5, 1, 1.5, 2, 3, 4, 6};
+    const double value = (code & 8) ? -magnitudes[code & 7] : magnitudes[code & 7];
+    const unsigned exponent = scale >> 3, mantissa = scale & 7;
+    const double multiplier = scale == 127 ? 0 : exponent == 0
+        ? std::ldexp(double(mantissa), -9)
+        : std::ldexp(1 + double(mantissa) / 8, int(exponent) - 7);
+    // These represented products need at most six significand bits and fit BF16 exactly.
+    const float represented = static_cast<float>(value * multiplier);
+    return static_cast<std::uint16_t>(std::bit_cast<std::uint32_t>(represented) >> 16);
+}
+std::uint32_t expected_pair(unsigned code, unsigned scale) {
+    return unsigned(expected(code & 15, scale)) | (unsigned(expected(code >> 4, scale)) << 16);
+}
+}
+int main() {
+    int count = 0;
+    if (cudaGetDeviceCount(&count) != cudaSuccess || count == 0) return 77;
+    std::uint32_t* device = nullptr;
+    try {
+        check(cudaMalloc(reinterpret_cast<void**>(&device), cases * 5 * sizeof(std::uint32_t)));
+        decode<<<(cases + 255) / 256, 256>>>(device);
+        check(cudaGetLastError());
+        std::vector<std::uint32_t> values(cases * 5);
+        check(cudaMemcpy(values.data(), device, values.size() * sizeof(std::uint32_t), cudaMemcpyDeviceToHost));
+        check(cudaFree(device)); device = nullptr;
+        for (unsigned index = 0; index < cases; ++index) {
+            const unsigned code = index & 255, scale = index >> 8;
+            for (unsigned part = 0; part < 5; ++part) {
+                const unsigned selected = part ? code ^ ((part - 1) * 0x55u) : code;
+                if (values[5 * index + part] != expected_pair(selected, scale)) {
+                    std::cerr << "NVFP4 scale decode differs: code=" << selected << " scale="
+                              << scale << " part=" << part << '\n';
+                    return 1;
+                }
+            }
+        }
+        std::cout << "NVFP4 pair/quad decode: all 32768 code/scale pairs match independent FP64 oracle\n";
+        return 0;
+    } catch (const std::exception& error) {
+        if (device) cudaFree(device);
+        std::cerr << error.what() << '\n';
+        return 1;
+    }
+}
diff --git a/tests/experimental/nvfp4_scope.cpp b/tests/experimental/nvfp4_scope.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..837a5c446a9b8be4b5eec67dd3013c2bfaa15a98
--- /dev/null
+++ b/tests/experimental/nvfp4_scope.cpp
@@ -0,0 +1,72 @@
+#include "ninfer/ops/linear.h"
+#include "ops/linear/common/route_table.h"
+#include "ops/common/device_route.h"
+#include <cuda_runtime.h>
+#include <cstdlib>
+#include <exception>
+#include <iostream>
+#include <stdexcept>
+#include <string_view>
+#include <utility>
+
+void check_route_selection() {
+    using namespace ninfer;
+    using namespace ops::detail;
+    if (!unified_linear_routes_here()) return;
+    const char* value = std::getenv("NINFER_LINEAR_ROUTES");
+    const std::string_view spec = value == nullptr ? "" : value;
+    const bool int8_scope = spec.starts_with("int8:");
+    const bool a16_scope = spec.starts_with("a16:");
+    if (!spec.empty() && !int8_scope && !a16_scope) {
+        throw std::invalid_argument("routing check requires default or scoped NVFP4 environment");
+    }
+    const auto forced = spec.ends_with(":unified") ? LinearRouteTable::Unified
+                                                  : LinearRouteTable::Legacy;
+    const auto int8_table = int8_scope ? forced : LinearRouteTable::Unified;
+    const auto a16_table = a16_scope ? forced : LinearRouteTable::Legacy;
+    for (int width : {1, 2, 8, 9, 32, 129, 2048}) {
+        if (linear_route_table(LinearRouteFamily::Nvfp4Int8, width) != int8_table) {
+            throw std::runtime_error("plain W4A8 selected an unexpected route");
+        }
+    }
+    if (linear_route_table(LinearRouteFamily::Nvfp4, 2048) != a16_table ||
+        linear_route_table(LinearRouteFamily::Q4, 2048) != LinearRouteTable::Legacy) {
+        throw std::runtime_error("NVFP4 override changed a different plain Linear family");
+    }
+    // Give both fused families the opposite profile schedule so a leaked scope is observable.
+    const auto baseline = forced == LinearRouteTable::Unified ? LinearRouteTable::Legacy
+                                                             : LinearRouteTable::Unified;
+    const char* schedule = baseline == LinearRouteTable::Unified ? "unified" : "";
+    for (const auto& [key, expected] : {
+             std::pair{"unified/nvfp4_linear_add", a16_scope ? forced : baseline},
+             std::pair{"nvfp4_int8/linear_add", int8_scope ? forced : baseline},
+             std::pair{"unified/fp8_linear_add", baseline}}) {
+        const ops::DeviceRouteForce route(key, schedule);
+        if (fused_route_table(key, 1) != expected) {
+            throw std::runtime_error("NVFP4 override crossed fused family boundaries");
+        }
+    }
+    bool rejected = false;
+    try {
+        const auto bytes = ops::linear_workspace_capacity_bytes(
+            QType::NVFP4, 14336, 5120, ops::LinearPolicy::AllowNvfp4Int8, 1, 129);
+        if (bytes == 0) throw std::runtime_error("W4A8 projection needs activation workspace");
+    } catch (const std::invalid_argument&) { rejected = true; }
+    if (rejected != (int8_table == LinearRouteTable::Legacy)) {
+        throw std::runtime_error("MTP-shaped W4A8 workspace admission disagrees with selected route");
+    }
+}
+
+int main() {
+    int count = 0;
+    if (cudaGetDeviceCount(&count) != cudaSuccess || count == 0) return 77;
+    if (!ninfer::ops::detail::unified_linear_routes_here()) return 77;
+    try {
+        check_route_selection();
+        std::cout << "NVFP4 default/scoped routing passed\n";
+        return 0;
+    } catch (const std::exception& error) {
+        std::cerr << error.what() << '\n';
+        return 1;
+    }
+}
diff --git a/tests/experimental/p1_engine.cpp b/tests/experimental/p1_engine.cpp
new file mode 100644
