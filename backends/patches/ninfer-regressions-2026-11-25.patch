+    expect(mx::prefill_route(type,5120,5120,256,E::BF16)==R::Tile);
+    expect(mx::prefill_route(type,5120,5120,256,E::Other)==R::Tile);
+    expect(mx::prefill_route(type,5120,255,256,E::F32)==R::Q8);
+    expect(mx::prefill_route(ops::gguf::GgmlType::Q6_K,5120,5120,256,E::F32)==R::Q8);
+    {
+        const ops::DeviceRouteForce force(mx::prefill_route_key(type,129,5120,E::F32),"q8");
+        expect(mx::prefill_route(type,129,5120,256,E::F32)==R::Tile);
+    }
+    {
+        const ops::DeviceRouteForce force(key,"invalid");
+        expect(mx::prefill_route(type,5120,5120,256,E::F32)==R::Tile);
+    }
+    profile->routes["unrelated"]={{1024,"test"}};
+    expect(mx::prefill_profile_signature(devices)==routed);
+    ops::install_device_route_profile(saved);
+    std::cout<<"MXFP8 profile width/format/epilogue/tail/signature checks passed\n";
