+void check(bool value, const char* what) { if (!value) throw std::runtime_error(what); }
+template<class F> void rejects(F&& action, const char* what) {
+    try { action(); } catch (const std::invalid_argument&) { return; }
+    catch (const std::logic_error&) { return; }
+    throw std::runtime_error(what);
+}
+double bf16(double value) { return bf16_to_f32(f32_to_bf16(float(value))); }
+double input(int token, int dim) { return double((token * 7 + dim * 3) % 17 - 8) / 16; }
+std::vector<double> fetch(const Tensor& t) {
+    if (t.dtype==DType::FP32) {
+        const auto f=ninfer::test::from_device<float>(t.data,size_t(t.numel()));
+        return {f.begin(),f.end()};
+    }
+    check(t.dtype==DType::BF16,"oracle expected BF16 or FP32 native output");
+    return ninfer::test::from_device_bf16(t.data,size_t(t.numel()));
