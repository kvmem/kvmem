+    const auto routed=mx::prefill_profile_signature(devices);
+    const auto expect=[](bool value){if(!value)throw std::runtime_error("prefill route boundary/signature");};
+    expect(plain!=routed);
+    expect(mx::prefill_route(type,5120,5120,255,E::F32)==R::Q8);
+    expect(mx::prefill_route(type,5120,5120,256,E::F32)==R::Q8);
+    expect(mx::prefill_route(type,5120,5120,257,E::F32)==R::Tile);
+    expect(mx::prefill_route(type,5120,5120,1023,E::F32)==R::Tile);
