diff --git a/tests/experimental/p1_sparse.cpp b/tests/experimental/p1_sparse.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..513086d9cbac7b0fff87b669d2dc69046130a99f
--- /dev/null
+++ b/tests/experimental/p1_sparse.cpp
@@ -0,0 +1,151 @@
+// Reuse the maintained represented-value codecs and guarded buffers, but select
+// original logical keys independently of the production compact page table.
+#include "ops/softmax_attention/causal_cache.cpp"
+#include "ops/softmax_attention/dense/causal_cache/launch.h"
+#include "kvmem_test_options.h"
+
+int sparse_case(KvCacheStorage storage, const std::vector<int>& prefix, int offset,
+                int width, bool graph, bool fast = false) {
+    const Geometry geometry = kGeometries[0]; // Qwen3.8-27B D256/H24/KV4
+    const int original_base = 6 * 64 + offset;
+    const int compact_base = static_cast<int>(prefix.size()) * 64 + offset;
+    std::vector<int> selected = prefix;
+    selected.insert(selected.end(), {6, 7, 8});
+    auto initial = storage == KvCacheStorage::RotatedLloyd4KeyInt4Value
+        ? make_cache(geometry, kPlanRk4v4, 640, 7103)
+        : storage == KvCacheStorage::RotatedInt8KeyInt4ValueGroup64
+        ? make_cache(geometry, kPlanRk8v4, 640, 7103)
+        : make_cache(geometry, storage, 640, 7103);
+    if (storage == KvCacheStorage::Nvfp4Group16 || storage == KvCacheStorage::Fp8KeyNvfp4Value) {
+        // Unwritten future cache bytes have no value contract. Poison their
+        // E4M3 scales with NaNs: causal/tile masks must keep them out of both
+        // QK and PV, even when a zero probability would otherwise multiply NaN.
+        for (int position = original_base + width; position < initial.logical_capacity; ++position) {
+            for (int head = 0; head < geometry.kv_heads; ++head) {
+                if (storage == KvCacheStorage::Fp8KeyNvfp4Value) {
+                    initial.k_scale.at(fp8_scale_index(geometry, initial.logical_capacity, head, position)) = 0x7e00;
+                }
+                for (int group = 0; group < kNvfp4QuantGroups; ++group) {
+                    const auto index = logical_plane_index(kNvfp4QuantGroups, geometry,
+                        initial.logical_capacity, head, position, group);
+                    if (storage == KvCacheStorage::Nvfp4Group16) initial.k_nvfp4_scale.at(index) = 0x7f;
+                    initial.v_nvfp4_scale.at(index) = 0xff;
+                }
+            }
+        }
+    }
+    auto expected = initial;
+    auto q = make_bf16_values(256ULL * geometry.q_heads * width, 7111, -0.25f, 0.25f);
+    auto k = make_bf16_values(256ULL * geometry.kv_heads * width, 7112, -0.25f, 0.25f);
+    auto v = make_bf16_values(256ULL * geometry.kv_heads * width, 7113, -1.0f, 1.0f);
+    std::vector<std::int32_t> original_positions, compact_positions;
+    for (int i = 0; i < width; ++i) {
+        original_positions.push_back(original_base + i);
+        compact_positions.push_back(compact_base + i);
+    }
+    append_cache(expected, k, v, original_positions);
+    // Decode actual stored codes/scales through the maintained independent FP64 oracle.
+    // Its page map selects original logical pages independently of the device's compact table.
+    const auto reference = ideal_attention(q, expected, compact_positions, &selected);
+    const int keys = compact_base + width;
+    const bool rotated_nvfp4 = storage == KvCacheStorage::Nvfp4Group16 ||
+                               storage == KvCacheStorage::Fp8KeyNvfp4Value;
+
+    DeviceCache cache(initial, MappingPattern::Fragmented);
+    auto view = cache.batch_view();
+    std::vector<std::int32_t> native(view.block_tables.ne[0]);
+    cuda_check(cudaMemcpy(native.data(), view.block_tables.data, native.size() * 4,
+                          cudaMemcpyDeviceToHost), "read physical table");
+    std::vector<std::int32_t> mapping;
+    for (auto page : selected) { mapping.push_back(native.at(page)); }
+    GuardedDeviceBuffer table(mapping.size() * 4), positions(width * 4), rows(4);
+    table.copy_from_host(mapping.data(), mapping.size() * 4);
+    positions.copy_from_host(compact_positions.data(), width * 4);
+    const std::int32_t row = 0;
+    rows.copy_from_host(&row, 4);
+    view.block_tables = Tensor(table.data(), DType::I32, {static_cast<int>(mapping.size()), 1});
+    auto qb = to_bf16_bits(q), kb = to_bf16_bits(k), vb = to_bf16_bits(v);
+    GuardedDeviceBuffer dq(qb.size() * 2), dk(kb.size() * 2), dv(vb.size() * 2), dout(qb.size() * 2);
+    dq.copy_from_host(qb.data(), qb.size() * 2);
+    dk.copy_from_host(kb.data(), kb.size() * 2);
+    dv.copy_from_host(vb.data(), vb.size() * 2);
+    Tensor tq(dq.data(), DType::BF16, {256, geometry.q_heads, width});
+    Tensor tk(dk.data(), DType::BF16, {256, geometry.kv_heads, width});
+    Tensor tv(dv.data(), DType::BF16, {256, geometry.kv_heads, width});
+    Tensor tp(positions.data(), DType::I32, {width});
+    Tensor tr(rows.data(), DType::I32, {1});
+    Tensor output(dout.data(), DType::BF16, {256, geometry.q_heads, width});
+    const ops::CausalAttentionExecutionEnvelope envelope{
+        .min_visible_keys = static_cast<unsigned>(keys),
+        .max_visible_keys = static_cast<unsigned>(keys), .fast_prompt_kernel = fast, .small_prefill = true};
+    if (fast && (ops::detail::causal_attention_resolve_route(op_geometry(geometry), width, 1, storage, envelope) !=
+                     ops::detail::CausalAttentionRoute::Prompt ||
+                 !ops::detail::causal_attention_prompt_fast_kernel(storage, true)))
+        throw std::runtime_error("Fast sparse fixture did not select the fast prompt route");
+    const auto bytes = ops::causal_softmax_attention_workspace_capacity_bytes(
+        op_geometry(geometry), storage, envelope, 1, width, width);
+    GuardedDeviceBuffer scratch(std::max<std::size_t>(bytes, 256));
+    WorkspaceArena workspace(DeviceSpan{scratch.data(), scratch.bytes()});
+    launch_attention_case([&](cudaStream_t stream) {
+        ops::causal_softmax_attention(tq, tk, tv, tp, Tensor{}, tr, op_geometry(geometry),
+            0.0625F, view, envelope, workspace, output, stream);
+    }, graph);
+    const auto actual = bf16_bits_to_double(copy_from_guarded<std::uint16_t>(dout, qb.size()));
+    const auto label = std::string("P1 sparse ") + cache_name(storage) +
+        " prefix=" + std::to_string(prefix.size()) + " offset=" + std::to_string(offset) +
+        " width=" + std::to_string(width) + " graph=" + std::to_string(graph) + (fast ? " fast=1" : "");
+    int failures = verify_attention(label, actual, reference, attention_criterion(storage));
+    failures += verify_cache(label, cache.snapshot(), expected, storage == KvCacheStorage::BFloat16 || rotated_nvfp4);
+    if (storage == KvCacheStorage::RotatedInt4KeyInt4ValueE8 ||
+        storage == KvCacheStorage::RotatedE8RootKeyInt4Value) {
+        // These codecs permit different Host/device rotation rounding. Keep the
+        // independent attention oracle and also require exact fused/append parity.
+        DeviceCache standalone(initial, MappingPattern::Fragmented);
+        GuardedDeviceBuffer original_position_buffer(original_positions.size() * 4);
+        original_position_buffer.copy_from_host(original_positions.data(), original_positions.size() * 4);
+        Tensor original_position_tensor(original_position_buffer.data(), DType::I32, {width});
+        ops::kv_cache_append(tk, tv, original_position_tensor, standalone.view(), nullptr);
+        cuda_synchronize();
+        failures += verify_cache(label + " fused/standalone bytes", cache.snapshot(), standalone.snapshot(), true);
+        failures += standalone.verify_guards(label + " standalone append");
+    }
+    failures += cache.verify_guards(label);
+    failures += table.verify_guards("compact table");
+    failures += scratch.verify_guards("workspace");
+    failures += dout.verify_guards("output");
+    std::cout << label << (failures ? " FAIL" : " PASS") << std::endl;
+    return failures;
+}
+
+int main(int argc, char** argv) {
+    try {
+        int failures = 0;
+        if (argc > 3 || (argc == 3 && std::string(argv[2]) != "fast"))
+            throw std::invalid_argument("[bf16|int8|fp8|nvfp4|k8v4|rk8v4|rk4v4|rk4v4-e8|rk2v4-e8] [fast]");
+        const bool fast = argc == 3;
+        const std::vector<int> widths = fast ? std::vector<int>{65, 127, 128, 129}
+            : std::vector<int>{1, 2, 3, 4, 5, 13, 53, 63, 64, 65};
+        const auto storages = argc >= 2
+            ? std::vector{ninfer::test::kvmem_test_storage(argv[1])}
+            : std::vector{KvCacheStorage::BFloat16, KvCacheStorage::Int8Group64, KvCacheStorage::Nvfp4Group16,
+                          KvCacheStorage::Fp8KeyNvfp4Value};
+        for (const auto storage : storages) {
+            for (const std::vector<int> pages : {std::vector<int>{0,1,2,3,4,5},
+                                               std::vector<int>{0,2,4},
+                                               std::vector<int>{4,0,2}}) {
+                for (int offset : {0, 63}) {
+                    for (int width : widths) {
+                        failures += sparse_case(storage, pages, offset, width, false, fast);
+                    }
+                }
+                for (int width : widths) {
+                    failures += sparse_case(storage, pages, 63, width, true, fast);
+                }
+            }
+        }
+        return failures ? 1 : 0;
+    } catch (const std::exception& e) {
+        std::cerr << "P1_SPARSE FAIL " << e.what() << '\n';
+        return 1;
+    }
+}
diff --git a/tests/experimental/p4_history.cpp b/tests/experimental/p4_history.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..57dffb6d2c9649007a4016274c461f2702f8d914
--- /dev/null
+++ b/tests/experimental/p4_history.cpp
@@ -0,0 +1,731 @@
+#include "ninfer/engine.h"
+#include "kvmem_test_options.h"
+#include <algorithm>
+#include <array>
+#include <atomic>
+#include <charconv>
+#include <cstdlib>
+#include <fstream>
+#include <iostream>
+#include <stdexcept>
+#include <string>
+
+namespace {
+void require(bool condition, const char* message) {
+    if (!condition) throw std::runtime_error(message);
+}
+void add(ninfer::PromptInput& p, ninfer::ChatRole role, const std::string& text) {
+    ninfer::ChatMessage m;
+    m.role = role;
+    m.parts.push_back({.kind = ninfer::MessagePartKind::Text, .text = text});
+    p.messages.push_back(std::move(m));
+}
+ninfer::PromptInput archive() {
+    ninfer::PromptInput p;
+    add(p, ninfer::ChatRole::System, "Use the archive to answer the final question.");
+    for (int entry = 0; entry < 16; ++entry) {
+        std::string text = "Archive entry " + std::to_string(entry) + ". ";
+        for (int i = 0; i < 8; ++i) text += entry < 4
+            ? "The violet observatory studies pulsars, cosmic rays and distant galaxies. "
+            : "The coastal office files invoices, transport schedules and warehouse inventories. ";
+        add(p, ninfer::ChatRole::User, text);
+        add(p, ninfer::ChatRole::Assistant, "The archive entry is recorded.");
+    }
+    add(p, ninfer::ChatRole::User, "Explain the violet observatory and its pulsars.");
+    return p;
+}
+struct Sink final : ninfer::OutputSink {
+    std::atomic<bool> cancel{false};
+    std::uint32_t cancel_prompt = 0, cancel_output = 0;
+    std::uint32_t total = 0, reused = 0, processed = 0, generated = 0;
+    int starts = 0;
+    void start(ninfer::GenerationStart s) override {
+        ++starts; reused = s.reused_prompt_tokens;
+    }
+    void progress(ninfer::PromptProgress p) override {
+        require(p.processed_prompt_tokens >= processed, "prompt progress went backwards");
+        require(p.reused_prompt_tokens == reused, "reuse accounting changed after admission");
+        require(p.processed_prompt_tokens <= p.total_prompt_tokens,
+                "query replay was counted twice");
+        total = p.total_prompt_tokens; processed = p.processed_prompt_tokens;
+        if (cancel_prompt && processed >= cancel_prompt) cancel.store(true);
+    }
+    void timing(ninfer::GenerationTimingObservation t) override {
+        require(t.generated_tokens >= generated, "output accounting went backwards");
+        generated = t.generated_tokens;
+        if (cancel_output && generated >= cancel_output) cancel.store(true);
+    }
+    void publish(ninfer::OutputDelta) override {}
+};
+
+struct InputReuseBoundary {
+    std::vector<ninfer::TokenId> tokens;
+    std::uint32_t safe = 0, input_end = 0, opener = 0;
+};
+
+InputReuseBoundary input_reuse_boundary(ninfer::Engine& engine, const ninfer::PromptInput& prompt,
+                                       std::ofstream& output, const char* name) {
+    auto prepared = engine.prepare(prompt);
+    InputReuseBoundary result;
+    result.tokens.assign(prepared.token_ids().begin(), prepared.token_ids().end());
+    // This fixture deliberately qualifies the real Qwen ChatML artifact. Decode the actual
+    // tokens, including special tokens, instead of assuming a model-specific token count.
+    std::string rendered;
+    std::vector<std::size_t> offsets{0};
+    for (auto token : result.tokens) {
+        rendered += engine.token_bytes(token);
+        offsets.push_back(rendered.size());
+    }
+    constexpr std::string_view assistant = "<|im_start|>assistant\n";
+    constexpr std::string_view close = "<|im_end|>";
+    const auto first_assistant = rendered.find(assistant);
+    const auto last_assistant = rendered.rfind(assistant);
+    require(first_assistant != std::string::npos && last_assistant > first_assistant,
+            "input-reuse fixture is not the expected real ChatML history");
+    const auto last_close = rendered.rfind(close, last_assistant);
+    require(last_close != std::string::npos && last_close < last_assistant,
+            "input-reuse history has no completed input message");
+    const auto frontier = [&](std::size_t byte) {
+        const auto found = std::lower_bound(offsets.begin(), offsets.end(), byte);
+        require(found != offsets.end() && *found == byte,
+                "fixture marker is not an exact token boundary");
+        return static_cast<std::uint32_t>(found - offsets.begin());
+    };
+    result.safe = frontier(first_assistant);
+    auto input_byte_end = last_close + close.size();
+    if (input_byte_end < rendered.size() && rendered[input_byte_end] == '\n') ++input_byte_end;
+    result.input_end = frontier(input_byte_end);
+    result.opener = frontier(last_assistant);
+    require(result.safe < result.input_end && result.input_end <= result.opener &&
+            result.opener < result.tokens.size(), "fixture input frontiers are not ordered");
+    output << "INPUT_REUSE_BOUNDARY case=" << name << " safe=" << result.safe
+           << " input_end=" << result.input_end << " opener=" << result.opener
+           << " prompt=" << result.tokens.size() << " tokens=";
+    for (auto token : result.tokens) output << token << ',';
+    output << '\n'; output.flush();
+    std::cout << "INPUT_REUSE_BOUNDARY case=" << name << " safe=" << result.safe
+              << " input_end=" << result.input_end << " opener=" << result.opener
+              << " prompt=" << result.tokens.size() << std::endl;
+    return result;
+}
+
+std::uint32_t input_reuse_limit() {
+    const char* raw = std::getenv("KVMEM_CHECKPOINT_EXTRA_RECOMPUTE_TOKENS");
+    if (!raw || !*raw) return 0;
+    const std::string_view value(raw);
+    std::uint32_t limit = 0;
+    const auto parsed = std::from_chars(value.data(), value.data()+value.size(), limit);
+    require(parsed.ec == std::errc{} && parsed.ptr == value.data()+value.size() &&
+            limit <= 2147483647U, "invalid input-reuse test recompute limit");
+    return limit;
+}
+}
+
+int main(int argc, char** argv) {
+    try {
+        if (argc < 5 || argc > 9) throw std::invalid_argument(
+            "artifact bf16|int8|fp8|nvfp4|k8v4|rk8v4|rk4v4|rk4v4-e8|rk2v4-e8 eager|graph output [drafts] [mode] [ngram-width] [wddm|adaptive|fast|adaptive-fast]");
+        ninfer::EngineOptions o;
+        ninfer::test::kvmem_test_devices(o);
+        o.artifact_path = argv[1]; o.max_context = 16384; o.device = 0;
+        o.max_concurrency = 1; o.prefill_chunk = 128;
+        o.kvmem.selected_tokens = 384; o.kvmem.reserve_tokens = 128;
+        o.kvmem.host_bytes = 2ULL << 30; o.kvmem.verify_transfers = true;
+        o.kv_capacity = ninfer::KvCapacityPolicy::explicit_capacity(512);
+        o.kv_cache = ninfer::test::kvmem_test_storage(argv[2]);
+        o.context_cache.enabled = false;
+        o.use_cuda_graph = ninfer::test::kvmem_test_graph(argv[3]); o.device_profile = "off";
+        if (argc >= 6 && std::stoul(argv[5]) != 0) {
+            o.speculative.backend = ninfer::SpeculativeBackend::Mtp;
+            o.speculative.draft_tokens = static_cast<std::uint32_t>(std::stoul(argv[5]));
+        }
+        const std::string mode = argc >= 7 ? argv[6] : "";
+        if (mode == "content-groups") {
+            o.max_concurrency = 2; o.prefill_chunk = 256;
+            o.kvmem.selected_tokens = 8192; o.kvmem.reserve_tokens = 256;
+            o.kvmem.host_bytes = 1ULL << 30; o.kvmem.retained_sessions = 8;
+            o.kv_capacity = ninfer::KvCapacityPolicy::explicit_capacity(16896);
+        }
+        if (mode.starts_with("input-fallback-disk-"))
+            throw std::invalid_argument("persistent KVMem snapshots are retired; use tests/ninfer_memory_disk.py in the parent repository for process-local SSD lifecycle checks");
+        if (mode == "prefix-anchor-ssd") {
+            // Sharing can keep this ~32 MiB archive entirely hot at 64 MiB.
+            // Keep enough transfer headroom but force actual cold KV reads.
+            o.kvmem.host_bytes = 16ULL << 20;
+            o.kvmem.disk_path = std::filesystem::path(argv[4]).parent_path() / "prefix-spill";
+            o.kvmem.disk_bytes = 1ULL << 30;
+        }
+        if (mode == "lrfu") { o.kvmem.lrfu = true; o.kvmem.score_agg_max = true; }
+        const bool input_fallback = mode == "input-fallback";
+        const bool input_reuse = mode == "input-reuse";
+        if ((mode == "endpoint" || input_fallback || input_reuse) && o.speculative.draft_tokens) {
+            o.speculative.ngram_draft_tokens = 31;
+            o.speculative.ngram_min_match = 4;
+        }
+        if (argc >= 8) o.speculative.ngram_draft_tokens = static_cast<std::uint32_t>(std::stoul(argv[7]));
+        if (argc == 9) {
+            const std::string feature = argv[8];
+            if (feature == "wddm") o.wddm_evictable_budget = true;
+            else if (feature == "adaptive" || feature == "adaptive-fast") {
+                o.speculative.mtp_policy = ninfer::MtpDraftPolicy::Adaptive;
+                o.fast_prefill_kernel = feature == "adaptive-fast";
+            } else if (feature == "fast") o.fast_prefill_kernel = true;
+            else throw std::invalid_argument("expected wddm, adaptive, fast or adaptive-fast");
+        }
+        if (input_fallback || input_reuse) o.gdn_state_fp16 = true;
+        ninfer::Engine engine(o);
+        std::cout << "FEATURE drafts=" << o.speculative.draft_tokens << " adaptive="
+                  << (o.speculative.mtp_policy == ninfer::MtpDraftPolicy::Adaptive)
+                  << " fast=" << o.fast_prefill_kernel << std::endl;
+        std::ofstream output(argv[4]);
+        std::uint32_t last_processed_prompt = 0;
+        const auto run = [&](const char* name, const ninfer::PromptInput& p, bool reuse,
+                             std::optional<bool> expected_reuse, std::uint32_t cancel_prompt = 0,
+                             std::uint32_t cancel_output = 0, std::uint32_t output_tokens = 32,
+                             bool model_stop = false) {
+            ninfer::RequestOptions request;
+            request.execution.requested_output_tokens = cancel_output ? 130 : output_tokens;
+            request.execution.sampling.temperature = mode == "stochastic" ? 0.7F : 0.0F;
+            request.execution.sampling.seed = 42;
+            request.execution.allow_prefix_reuse = reuse;
+            request.stop.include_model_defaults = model_stop;
+            Sink sink; sink.cancel_prompt = cancel_prompt; sink.cancel_output = cancel_output;
+            const auto result = engine.submit(engine.prepare(p), request,
+                ninfer::OutputConsumerMode::Streaming,
+                {.phase_timings = true, .live_timings = true, .prompt_progress = true})
