+    CUDA_CHECK(cudaMemcpyAsync(io.rope_delta.data, &zero, sizeof(zero), cudaMemcpyHostToDevice, device.stream));
+    auto hidden_buffer = ninfer::test::to_device_bf16(std::vector<float>(H * T));
+    Tensor hidden(hidden_buffer.p, DType::BF16, {H, T});
+    execution::TextContext context(device, parameters, work, decoder.text_kv.execution_view(row),
+        unused_linear, io, hidden, T, Position, {}, &decoder.text_kv);
+    context.set_cache_position_shift(Position);
+    Oracle oracle;
+    std::vector<float> input_values(oracle.residual.begin(), oracle.residual.end());
+    auto residual_buffer = ninfer::test::to_device_bf16(input_values);
+    auto cache_buffer = ninfer::test::to_device_i32({0, 1, 2});
+    auto rope_buffer = ninfer::test::to_device_i32({Position, Position + 1, Position + 2});
+    const Tensor residual(residual_buffer.p, DType::BF16, {H, T});
+    const Tensor cache(cache_buffer.p, DType::I32, {T}), rope(rope_buffer.p, DType::I32, {T});
+    Counters counters;
+    const execution::CurrentLayerQueryBoundary boundary{&counters, Counters::projected, Counters::completed};
+    context.set_current_layer_query_boundary(&boundary);
+    BundleStorage owned(T);
+    execution::PreparedLayerQuery prepared({0, 0, 0}, owned.storage);
+    context.project_query_attention(residual, cache, rope, prepared);
+    device.synchronize();
+    check(prepared.projected() && counters.projections == 1 && counters.projected_rows == T, "Query rows projected more than once");
+    check_near("normalized Q", fetch(owned.storage.query), oracle.q);
+    check_near("normalized K", fetch(owned.storage.key), oracle.k);
+    check_near("native V", fetch(owned.storage.value), oracle.v);
+    check_near("saved residual", fetch(owned.storage.residual), oracle.residual, 0);
+    const auto cache_before = ninfer::test::from_device<uint8_t>(pool.plane(0).data, pool.plane(0).bytes());
+    check(std::all_of(cache_before.begin(), cache_before.end(), [](uint8_t b) { return b == 0; }), "projection appended KV before selection");
+    rejects([&] { context.project_query_attention(residual, cache, rope, prepared); }, "second projection accepted");
+    context.consume_query_attention(prepared, io.text_kv_table_row, {T, T, false, false, true});
+    device.synchronize();
+    check(prepared.consumed() && counters.projections == 1 && counters.completions == 0, "consume projected again or claimed FFN completion");
+    // FP64 sin/cos is the independent oracle. The absolute allowance covers
+    // FP32 frequency/phase formation at positions around 2000 near cancellation.
+    check_near("original-position Q", fetch(owned.storage.query), oracle.rotated_q, 3, 1e-3);
+    check_near("original-position K", fetch(owned.storage.key), oracle.rotated_k, 3, 1e-3);
+    check_near("causal attention residual", fetch(owned.storage.residual), oracle.output, 4);
+    const auto consumed_q = fetch(owned.storage.query);
+    const auto consumed_cache = ninfer::test::from_device<uint8_t>(pool.plane(0).data, pool.plane(0).bytes());
+    rejects([&] { context.consume_query_attention(prepared, io.text_kv_table_row, {T, T}); }, "second attention consumption accepted");
+    device.synchronize();
+    check(fetch(owned.storage.query) == consumed_q, "second consumption rotated Q again");
+    check(ninfer::test::from_device<uint8_t>(pool.plane(0).data, pool.plane(0).bytes()) == consumed_cache, "second consumption mutated KV");
+    const auto physical = ninfer::test::from_device<int>(
+        decoder.text_kv.execution_tables().row(row.handle()).data, 1).front();
+    for (int kind = 0; kind < 2; ++kind) {
+        const auto& plane = pool.plane(kind);
+        const auto raw = ninfer::test::from_device<uint16_t>(plane.data, plane.bytes() / 2);
+        std::vector<double> got(T * D * K);
+        for (int t = 0; t < T; ++t) for (int h = 0; h < K; ++h) for (int d = 0; d < D; ++d) {
+            const bool page_major = pool.geometry().device_plane_order == PagedKVPlaneOrder::PageMajor;
+            const auto at = d * plane.nb[0] + t * plane.nb[1] +
+                physical * plane.nb[page_major ? 3 : 2] + h * plane.nb[page_major ? 2 : 3];
+            got[(t * K + h) * D + d] = bf16_to_f32(raw[size_t(at) / 2]);
