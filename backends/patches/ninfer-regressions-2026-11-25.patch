+        for (std::size_t i = 0; i < samples.size(); ++i) rows[i].source_position = begin + samples[i];
+        if (oracle) {
+            // Independent Q=0 reference: probability is visible token count in
+            // a page divided by the row's whole causal token count.
+            for (auto& row : rows) {
+                const auto visible = row.source_position + 1;
+                for (std::uint64_t page = 0; page * 64 < visible; ++page)
+                    row.mass.push_back({page * 64, double(std::min<std::uint64_t>(64, visible - page * 64)) / visible});
+            }
+        } else {
+            AttentionPageMassAccumulator sum(rows, pages, 3, total_heads);
+            std::vector<float> native(rows.size() * pages.size(), 0);
+            for (std::size_t i = 0; i < rows.size(); ++i) {
+                const auto visible = rows[i].source_position + 1;
+                for (std::size_t p = 0; p * 64 < visible; ++p)
+                    native[i * pages.size() + p] = float(double(std::min<std::uint64_t>(64, visible - p * 64)) / visible);
+            }
+            for (std::size_t layer = 0; layer < 3; ++layer)
+                for (const auto local_heads : heads)
+                    if (local_heads) sum.add(native, pages.size(), local_heads);
+            sum.finish();
+            for (const auto& row : rows) {
+                const auto visible = row.source_position + 1;
+                expect(row.mass.size() == (visible + 63) / 64,
+                       "rank count enlarged a complete positive attention row");
+                double total = 0;
+                for (const auto& edge : row.mass) {
+                    const auto expected = double(std::min<std::uint64_t>(64, visible - edge.target)) / visible;
+                    expect(std::abs(edge.mass - expected) <= expected * 1e-7,
+                           "native FP32 page mass disagrees with the independent token oracle");
+                    total += edge.mass;
+                }
+                expect(std::abs(total - 1) < 1e-7, "long-window sampled row lost causal mass");
+            }
+        }
+        auto next = kvmem::prepare_graph_accept(graph, graph.accepted_through, end, rows, limit);
+        result.last_extra = feedback.snapshot().bytes() + attention_feedback_workspace_bytes(rows);
+        next.reserve_extra(result.last_extra);
+        auto next_feedback = feedback;
+        std::vector<std::uint64_t> exposed;
+        for (auto page : pages) exposed.push_back(std::uint64_t(page) * 64);
+        next_feedback.observe_prefill(begin, end, chunk, rows, exposed);
+        next.include_feedback(next_feedback.snapshot().bytes());
+        graph = std::move(next);
+        feedback = std::move(next_feedback);
+        result.last_edges = 0;
+        for (const auto& row : rows) result.last_edges += row.mass.size();
+        expect(graph.accepted_through == end && budget->used() <= limit,
+               "long-window graph publication exceeded the accepted frontier or budget");
+    }
+    std::vector<std::uint64_t> pages;
+    for (std::uint64_t p = 0; p < window; p += 64) pages.push_back(p);
+    result.pressure = feedback.pressure_scores(pages);
+    return result;
+}
+
+void test_long_window() {
+    const auto reference = run_long_window(std::array{4u}, true);
+    const auto single = run_long_window(std::array{4u}, false);
+    const auto unequal = run_long_window(std::array{3u, 1u}, false);
+    const auto zero_rank = run_long_window(std::array{3u, 0u, 1u}, false);
+    for (const auto* result : {&single, &unequal, &zero_rank}) {
+        expect(result->last_edges == 132128 && result->last_extra < (8u << 20),
+               "long-window representation grows with tensor rank count");
+        expect(result->pressure.size() == reference.pressure.size(), "wrong Pressure window");
+        for (std::size_t p = 0; p < reference.pressure.size(); ++p)
+            expect(std::abs(result->pressure[p] - reference.pressure[p]) < 1e-7,
+                   "Pressure disagrees with independent uniform-token reference");
+    }
+    expect(single.last_extra == unequal.last_extra && unequal.last_extra == zero_rank.last_extra,
+           "equal logical observations have rank-dependent host memory cost");
+    std::cout << "OK: single/3:1/zero-head-rank windows reach 133120 tokens under 32 MiB; "
+              << "last edges=" << unequal.last_edges << " extra=" << unequal.last_extra << '\n';
+}
+
+int main() {
+    test_page_mass();
+    test_long_window();
+    const MemoryStatisticsPlanning plan{
+        .capacity=8192, .window_tokens=2048, .prefill_chunk=512,
+        .verify_window=7, .max_concurrency=2, .query_max_tokens=128};
+    const auto budget=memory_statistics_budget(plan,2,1024,4096,16,4,256);
+    // Hand-counted bytes for this fixture: 9 K buckets, 16 candidates,
+    // 128 Query rows, 512 capture rows at 3 layers, 32 sampled pages.
+    expect(budget.divided==15024128,"divided statistics cost omits a native buffer");
+    expect(budget.every==9216,"per-rank controls/output cost is wrong");
+    const auto scoring=kvmem::PageSoftmaxCuda::workspace_bytes(128,16,4,256);
+    expect(budget.first==2304+scoring,"rank 0 Query workspace or token capture was omitted");
+
+    LayoutBuilder actual;
+    MemoryStatisticsLayout layout;
+    layout.layers=2;
+    std::optional<TensorRegion> workspace;
+    const auto allocate=[&](MemoryStatisticsOwner,DType dtype,
+        std::initializer_list<std::int32_t> shape,const char* label) {
+        return actual.add_tensor(dtype,shape,256,label);
+    };
+    plan_memory_statistics_shard(layout,plan,1024,4096,16,allocate);
+    plan_memory_statistics_rank0(layout,workspace,plan,16,4,256,allocate);
+    expect(actual.finish(256)==budget.divided+budget.every+budget.first,
+           "estimate differs from the actual aligned allocation recipe");
+    expect(layout.key_sums.shape[1]==9 && layout.candidate_keys.shape[1]==16 &&
+           layout.query_values.shape[1]==128 && layout.attention_queries.shape[1]==512,
+           "fixture geometry differs from its hand-counted oracle");
+
+    const auto big=memory_statistics_budget(plan,2,768,3072,12,3,256);
+    const auto small=memory_statistics_budget(plan,2,256,1024,4,1,256);
+    expect(big.divided==budget.divided*3/4 && small.divided==budget.divided/4 &&
+           big.every==budget.every && small.every==budget.every,
+           "unequal heads must divide statistics and retain per-rank output/control");
+
+    // Independent hand-count of the uncached current-layer-Q plan:
+    // 9K buckets+16candidates+one geometry Q row+32page live mass scratch.
+    // Neither a public Query length nor the legacy option selects this mode.
+    auto uncached=plan;uncached.query_max_tokens=0;uncached.mean_query=false;
+    const auto uncached_budget=memory_statistics_budget(uncached,2,1024,4096,16,4,256);
+    expect(uncached_budget.divided==360448 && uncached_budget.every==budget.every &&
+           uncached_budget.first==budget.first,"current-Q plan retained legacy capture or lost live/scoring resources");
+    LayoutBuilder uncached_actual;MemoryStatisticsLayout uncached_layout;uncached_layout.layers=2;
+    std::optional<TensorRegion> uncached_workspace;
+    const auto allocate_uncached=[&](MemoryStatisticsOwner,DType dtype,
+        std::initializer_list<std::int32_t> shape,const char* label) {
+        return uncached_actual.add_tensor(dtype,shape,256,label);
+    };
+    plan_memory_statistics_shard(uncached_layout,uncached,1024,4096,16,allocate_uncached);
+    plan_memory_statistics_rank0(uncached_layout,uncached_workspace,uncached,16,4,256,allocate_uncached);
+    expect(uncached_layout.query_values.shape[1]==1 && !uncached_layout.attention_queries.region.bytes &&
+           uncached_layout.attention_output.region.bytes==layout.attention_output.region.bytes &&
+           uncached_layout.key_sums.region.bytes==layout.key_sums.region.bytes,
+           "uncached plan changed native K/live mass geometry");
+    expect(uncached_actual.finish(256)==uncached_budget.divided+uncached_budget.every+uncached_budget.first,
+           "uncached split estimate differs from actual aligned allocation");
+    const auto uncached_big=memory_statistics_budget(uncached,2,768,3072,12,3,256);
+    const auto uncached_small=memory_statistics_budget(uncached,2,256,1024,4,1,256);
+    expect(uncached_big.divided+uncached_small.divided==uncached_budget.divided &&
+           uncached_big.every==uncached_budget.every && uncached_small.every==uncached_budget.every,
+           "uncached unequal-head split lost native divided/every ownership");
+    auto mean=plan; mean.mean_query=true;
+    const auto mean_budget=memory_statistics_budget(mean,2,1024,4096,16,4,256);
+    expect(mean_budget.divided==12959744 && mean_budget.first==2304,
+           "MeanQ must use FP32 sums and omit PageSoftmax workspace");
+    auto concurrent=plan; concurrent.max_concurrency=8;
+    const auto concurrent_budget=memory_statistics_budget(concurrent,2,1024,4096,16,4,256);
+    expect(concurrent_budget.divided==budget.divided+393216 &&
+           concurrent_budget.first==budget.first,
+           "candidate columns must follow concurrency without multiplying Program-wide Query buffers");
+    auto longer=plan; longer.capacity=131072;
+    const auto long_budget=memory_statistics_budget(longer,2,1024,4096,16,4,256);
+    expect(long_budget.first>budget.first && long_budget.divided==budget.divided &&
+           long_budget.every==budget.every,
+           "logical history must size rank 0 scoring independently of resident window");
+    const auto disabled=memory_statistics_budget({},2,1024,4096,16,4,256);
+    expect(disabled.divided==0 && disabled.every==0 && disabled.first==0,
+           "KVMem disabled must not change native tensor split estimates");
+    std::cout << "OK: KVMem tensor-split costs share the exact startup allocation recipe\n";
+}
diff --git a/tests/models/qwen3_5/test_memory_statistics_layout.cpp b/tests/models/qwen3_5/test_memory_statistics_layout.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..ec83667d86ec4635e01980d82a20d8424982aabb
--- /dev/null
+++ b/tests/models/qwen3_5/test_memory_statistics_layout.cpp
@@ -0,0 +1,229 @@
+#include "models/qwen3_5/execution/memory_statistics.h"
+#include "models/qwen3_5/program/planning/memory_statistics_copy_plan.h"
+#include "models/qwen3_5/program/planning/attention_feedback_readback.h"
+#include "models/qwen3_5/program/storage/attention_feedback_mass.h"
+#include <array>
+#include <cstring>
+#include <iostream>
+#include <stdexcept>
+#include <type_traits>
+
+using namespace ninfer;
+using namespace ninfer::models::qwen3_5::execution;
+
+template<class Query>
+void check_values(bool pipeline, bool include_query, std::uint32_t accepted, bool coalesced) {
+    MemoryStatistics stats;
+    stats.layers=2; stats.key_width=8; stats.query_width=16;
+    stats.columns=3; stats.mean_query=std::is_same_v<Query,float>;
+    stats.query_columns=stats.mean_query ? 1 : 4;
+    stats.ranks.resize(3); // The last rank has no attention heads.
+    std::array<std::vector<float>,2> keys;
+    std::array<std::vector<Query>,2> queries;
+    for(int rank=0;rank<2;++rank) {
+        auto& shard=stats.ranks[rank];
+        const int width=pipeline ? 8 : rank==0 ? 6 : 2;
+        const int layers=pipeline ? 1 : 2;
+        shard.first_layer=pipeline ? rank : 0;
+        shard.key_offset=!pipeline && rank==1 ? 6 : 0;
+        shard.query_offset=shard.key_offset*2;
+        keys[rank].resize(size_t(width)*3*layers);
+        queries[rank].resize(size_t(width*2)*stats.query_columns*layers);
+        for(int l=0;l<layers;++l) {
+            // Each feature carries its global identity, independent of the
+            // host-copy plan, so a wrong layer/row/head offset is observable.
+            for(int row=0;row<3;++row) for(int feature=0;feature<width;++feature)
+                keys[rank][(size_t(l)*3+row)*width+feature]=
+                    float(1000*(shard.first_layer+l)+100*row+shard.key_offset+feature+1);
+            for(unsigned row=0;row<stats.query_columns;++row)
+                for(int feature=0;feature<width*2;++feature)
+                    queries[rank][(size_t(l)*stats.query_columns+row)*width*2+feature]=
+                        Query(1000*(shard.first_layer+l)+100*row+shard.query_offset+feature+1);
+        }
+        shard.key_sums=Tensor(keys[rank].data(),DType::FP32,{width,3,layers});
+        shard.query_values=Tensor(queries[rank].data(),stats.mean_query ? DType::FP32 : DType::BF16,
+                                  {width*2,int(stats.query_columns),layers});
+    }
+    stats.validate_layout();
+    constexpr size_t guard=32;
+    std::vector<std::byte> actual(2*guard+stats.key_bytes()+stats.query_bytes(),std::byte{0xcd});
+    auto expected=actual;
+    for(unsigned layer=0;layer<2;++layer) {
+        for(unsigned row=0;row<3;++row) for(unsigned feature=0;feature<8;++feature) {
+            const float value=float(1000*layer+100*row+feature+1);
+            const size_t at=guard+((size_t(layer)*3+row)*8+feature)*sizeof(value);
+            std::memcpy(expected.data()+at,&value,sizeof(value));
+        }
+        if(include_query) for(unsigned row=0;row<(stats.mean_query ? 1 : accepted);++row)
+            for(unsigned feature=0;feature<16;++feature) {
+                const Query value=Query(1000*layer+100*row+feature+1);
+                const size_t at=guard+stats.key_bytes()+
+                    ((size_t(layer)*stats.query_columns+row)*16+feature)*sizeof(value);
+                std::memcpy(expected.data()+at,&value,sizeof(value));
+            }
+    }
+    std::size_t copies=0;
+    auto visit=[&](const MemoryStatisticsCopy& copy) {
+        ++copies;
+        if(copy.rank>=2) throw std::runtime_error("empty rank scheduled a copy");
+        if(copy.destination_offset+(copy.rows-1)*copy.destination_pitch+copy.width_bytes>
+           stats.key_bytes()+stats.query_bytes())
+            throw std::runtime_error("statistics copy exceeds host allocation");
+        const auto* source=static_cast<const std::byte*>(copy.source);
+        for(size_t row=0;row<copy.rows;++row)
+            std::memcpy(actual.data()+guard+copy.destination_offset+row*copy.destination_pitch,
+                        source+row*copy.width_bytes,copy.width_bytes);
+    };
+    if(coalesced) ninfer::models::qwen3_5::detail::for_each_coalesced_statistics_copy(
+        stats,include_query,accepted,visit);
+    else stats.for_each_host_copy(include_query,accepted,visit);
+    if(actual!=expected)
+        throw std::runtime_error("global layer/head order or accepted Query prefix differs from oracle");
+    const auto layers=pipeline ? 1U : 2U;
+    const auto key_copies=coalesced ? 2U : 2U*layers;
+    const auto query_copies=!include_query ? 0U : coalesced &&
+        (stats.mean_query || accepted==stats.query_columns) ? 2U : 2U*layers;
+    if(copies!=key_copies+query_copies)
+        throw std::runtime_error("contiguous layers were not coalesced, or a Query tail was copied");
+    if(!stats.mean_query) for(const auto invalid:{0U,stats.query_columns+1}) {
+        bool rejected=false, copied=false;
+        try {
+            if(coalesced) ninfer::models::qwen3_5::detail::for_each_coalesced_statistics_copy(
+                stats,true,invalid,[&](const auto&) {copied=true;});
+            else stats.for_each_host_copy(true,invalid,[&](const auto&) {copied=true;});
+        }
+        catch(const std::logic_error&) {rejected=true;}
+        if(!rejected || copied) throw std::runtime_error("invalid Query prefix started a copy");
+    }
+}
+
+void check_feedback_readback(std::uint32_t layers, bool pipeline, std::uint32_t count) {
+    using namespace ninfer::models::qwen3_5::detail;
+    MemoryStatistics stats;
+    stats.layers=layers; stats.query_width=8; stats.ranks.resize(3);
+    float sentinel=0;
+    const auto split=(layers+1)/2;
+    std::array<std::array<std::vector<float>,3>,2> source;
+    const std::array<std::uint32_t,3> sampled{0,layers/2,layers-1};
+    for(std::uint32_t rank=0;rank<2;++rank) {
+        auto& shard=stats.ranks[rank];
+        const auto local_layers=pipeline ? (rank ? layers-split : split) : layers;
+        if(!local_layers) continue;
+        shard.first_layer=pipeline && rank ? split : 0;
+        shard.key_sums=Tensor(&sentinel,DType::FP32,{1,1,static_cast<int>(local_layers)});
+        const int heads=pipeline ? 4 : rank ? 1 : 3;
+        shard.attention_queries=Tensor(&sentinel,DType::BF16,{heads*2,64,3});
+        shard.attention_output=Tensor(&sentinel,DType::FP32,{static_cast<int>(5+rank),64});
+        for(std::uint32_t slot=0;slot<3;++slot) {
+            source[rank][slot].resize((5+rank)*count);
+            for(std::uint32_t row=0;row<count;++row) for(std::uint32_t p=0;p<5+rank;++p)
+                source[rank][slot][row*(5+rank)+p]=p<3 ?
+                    float((sampled[slot]+1)*1000+rank*100+row*3+p+1)/16384.0F : 0.0F;
+        }
+    }
+    const auto plan=attention_feedback_readback(stats,2,count);
+    const auto capacity=attention_feedback_readback(stats,2,64).bytes;
+    if(plan.bytes>capacity) throw std::runtime_error("attention readback exceeds startup capacity");
+    constexpr std::size_t guard=32;
+    std::vector<std::byte> staging(guard+plan.bytes+guard,std::byte{0xcd});
+    for(const auto& copy:plan.copies) {
+        const auto& input=source[copy.rank][copy.slot];
+        if(input.size()!=copy.elements || copy.host_offset+input.size()*sizeof(float)>plan.bytes)
+            throw std::runtime_error("attention readback has wrong source shape or host bounds");
+        std::memcpy(staging.data()+guard+copy.host_offset,input.data(),input.size()*sizeof(float));
+    }
+    const std::array<std::uint32_t,3> pages{2,7,19};
+    std::vector<kvmem::AcceptedAttentionRow> actual(count);
+    AttentionPageMassAccumulator accumulator(actual,pages,std::min(3U,layers),4);
+    for(const auto& copy:plan.copies)
+        accumulator.add({reinterpret_cast<const float*>(staging.data()+guard+copy.host_offset),copy.elements},
+            copy.native_pages,copy.local_heads);
+    accumulator.finish();
+    std::vector<std::array<double,3>> expected(count);
+    std::size_t cursor=0,descriptors=0;
+    for(std::uint32_t slot=0;slot<3;++slot) {
+        if(slot && sampled[slot]==sampled[slot-1]) continue;
+        for(std::uint32_t rank=0;rank<2;++rank) {
+            const bool included=!pipeline || (rank==0 ? sampled[slot]<split : sampled[slot]>=split);
+            if(!included) continue;
+            const auto heads=pipeline ? 4U : rank ? 1U : 3U;
+            const auto& copy=plan.copies.at(descriptors++);
+            if(copy.slot!=slot || copy.rank!=rank || copy.layer!=sampled[slot] || copy.host_offset!=cursor)
+                throw std::runtime_error("attention readback changed represented layer/rank order");
+            cursor+=source[rank][slot].size()*sizeof(float);
+            for(std::uint32_t row=0;row<count;++row) for(std::uint32_t p=0;p<3;++p)
+                expected[row][p]+=double(source[rank][slot][row*(5+rank)+p])*heads/(std::min(3U,layers)*4);
+        }
+    }
+    if(descriptors!=plan.copies.size() || cursor!=plan.bytes)
+        throw std::runtime_error("attention readback omitted or duplicated a sampled operand");
+    for(std::uint32_t row=0;row<count;++row) for(std::uint32_t p=0;p<3;++p)
+        if(actual[row].mass[p].target!=std::uint64_t(pages[p])*64 || actual[row].mass[p].mass!=expected[row][p])
+            throw std::runtime_error("attention readback differs from independently represented mass");
+    for(std::size_t i=0;i<guard;++i)
+        if(staging[i]!=std::byte{0xcd} || staging[guard+plan.bytes+i]!=std::byte{0xcd})
+            throw std::runtime_error("attention readback changed a host canary");
+    for(const auto invalid:{0U,65U}) {
+        bool rejected=false;
+        try { (void)attention_feedback_readback(stats,2,invalid); }
+        catch(const std::logic_error&) {rejected=true;}
+        if(!rejected) throw std::runtime_error("attention readback accepted an invalid row count");
+    }
+    auto missing=stats; missing.query_width+=2;
+    bool rejected=false;
+    try { (void)attention_feedback_readback(missing,2,count); }
+    catch(const std::logic_error&) {rejected=true;}
+    if(!rejected) throw std::runtime_error("attention readback accepted incomplete head coverage");
+}
+
+int main() {
+    // Shapes stand for 4 KV heads / 16 Query heads at head dimension 256.
+    // The two ranks hold 3:1 heads; rank 2 deliberately has no attention.
+    float sentinel = 0;
+    MemoryStatistics stats;
+    stats.layers = 2; stats.key_width = 1024; stats.query_width = 4096;
+    stats.columns = 3; stats.query_columns = 7;
+    stats.ranks.resize(3);
+    for (int rank = 0; rank < 2; ++rank) {
+        auto& shard = stats.ranks[rank];
+        const int width = rank ? 256 : 768;
+        shard.key_offset = rank ? 768 : 0;
+        shard.query_offset = shard.key_offset * 4;
+        shard.key_sums = Tensor(&sentinel, DType::FP32, {width, 3, 2});
+        shard.query_values = Tensor(&sentinel, DType::BF16, {width * 4, 7, 2});
+    }
+    stats.validate_layout();
+    for (int fault = 0; fault < 8; ++fault) {
+        auto bad = stats;
+        if (fault == 0) bad.ranks[1].key_offset = 512;
+        if (fault == 1) bad.ranks[1].query_offset = 0;
+        if (fault == 2) bad.ranks.pop_back(), bad.ranks.pop_back();
+        if (fault == 3) bad.ranks[1].first_layer = 1;
+        if (fault == 4) bad.ranks[0].key_sums.ne[1] = 2;
+        if (fault == 5) bad.ranks[0].query_values.dtype = DType::FP32;
+        if (fault == 6) bad.ranks[0].key_sums.nb[1] += sizeof(float);
+        if (fault == 7) bad.ranks[0].query_values.ne[3] = 2;
+        bool rejected = false;
+        try { bad.validate_layout(); } catch (const std::logic_error&) { rejected = true; }
+        if (!rejected) throw std::runtime_error("invalid statistics shard accepted");
+    }
+    // Layer pipeline is also a complete partition, with no head offsets.
+    for (int rank = 0; rank < 2; ++rank) {
+        auto& shard = stats.ranks[rank];
+        shard.first_layer = rank; shard.key_offset = shard.query_offset = 0;
+        shard.key_sums = Tensor(&sentinel, DType::FP32, {1024, 3, 1});
+        shard.query_values = Tensor(&sentinel, DType::BF16, {4096, 7, 1});
+    }
+    stats.validate_layout();
+    for(const bool pipeline:{false,true}) for(const bool coalesced:{false,true}) {
+        check_values<std::uint16_t>(pipeline,true,3,coalesced); // Unaccepted tail untouched.
+        check_values<std::uint16_t>(pipeline,true,4,coalesced);
+        check_values<std::uint16_t>(pipeline,false,0,coalesced); // Mean-K without Query consumers.
+        check_values<float>(pipeline,true,0,coalesced);
+        check_values<float>(pipeline,false,0,coalesced);
+    }
+    for(const auto layers:{1U,2U,5U}) for(const bool pipeline:{false,true})
+        for(const auto rows:{1U,3U,64U}) check_feedback_readback(layers,pipeline,rows);
+    std::cout << "OK: unequal heads, empty attention rank, layer pipeline, Query/MeanQ values, "
+                 "accepted prefixes and invalid coverage\n";
+}
