+    pool.zero_pages(pages, device.stream);
+    DeviceArena work(size_t(16) << 20);
+    DeviceArena io_arena(4096);
+    qwen::RoundState io;
+    io.rope_delta = io_arena.alloc(DType::I32, {1});
+    io.text_kv_table_row = io_arena.alloc(DType::I32, {1});
