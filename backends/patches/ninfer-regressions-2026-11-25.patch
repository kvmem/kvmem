+        Checkpoint cp;cp.canonical_source=source;cp.prefix.resize(64);
+        cp.identity.backend=source->descriptor.identity;cp.identity.layout=source->descriptor.layout;
+        cp.identity.stamp=source->accepted;cp.layer_views.source_epoch=5;
+        if(cold) {active={};storage.trim(0);check(storage.charged_bytes()==0,"fixture did not become cold");}
+        const auto reads=disk?disk->stats().read_bytes:0;
+        check(kvmem_checkpoint_payload_covers(cp,1,16),"canonical checkpoint was not eligible");
+        check(!kvmem_checkpoint_payload_covers(cp,2,16),"wrong page frontier was accepted");
+        check(!kvmem_checkpoint_payload_covers(cp,1,32),"wrong record geometry was accepted");
+        cp.layer_views.source_epoch=6;
+        check(!kvmem_checkpoint_payload_covers(cp,1,16),"stale layer provenance was accepted");
+        cp.layer_views.source_epoch=5;
