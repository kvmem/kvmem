+void run() {
+    DeviceContext device(0);
+    ModelFixture fixture;
+    artifact::Reader reader(fixture.file.entry);
+    auto model = qwen::materialize_model(qwen::plan_load(reader, {}, {}, qwen::rank_tiers(device)), device);
+    const execution::Parameters parameters(*model);
+    LayoutBuilder state_layout;
+    qwen::DecoderStateSpec spec;
+    spec.full_attention_layers = 1; spec.capacity = 64; spec.kv_heads = K; spec.attention_head_dim = D;
+    spec.text_physical_page_groups = 1;
+    const auto decoder_layout = qwen::plan_decoder_state(state_layout, spec);
+    const auto linear_layout = plan_linear_attention_state_pool(state_layout, {1, 1, 1, 1, 1, 1, 1});
+    DeviceArena state_arena(state_layout.finish(256));
+    const DeviceSpan backing{state_arena.base(), state_arena.capacity()};
+    qwen::DecoderState decoder(backing, decoder_layout);
+    LinearAttentionStatePool unused_linear(backing, linear_layout);
+    auto& pool = decoder.text_kv.page_pool();
+    auto reservation = pool.reserve(1);
+    check(reservation.has_value(), "fixture native page reservation failed");
+    auto page = pool.materialize_one(*reservation);
+    auto row = decoder.text_kv.execution_tables().acquire(0);
+    const std::array pages{page.handle()};
