+  --kv-dtype int8 --prefill-chunk 256 -pg '2048,256' --warmup 1 -r 3 -o json \
+  --kvmem-budget 2048 --kvmem-gen-reserve 512 --kvmem-host-mib 8192 --kvmem-lrfu
