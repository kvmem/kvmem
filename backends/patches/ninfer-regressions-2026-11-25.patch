+                                 a8(385), a8(600), a8(1007), a8(1024), Invocation{33, CallForm::Policy, ops::LinearPolicy::AllowA8Int, true},
+                                 Invocation{65, CallForm::Policy, ops::LinearPolicy::AllowA8Int, true}};
