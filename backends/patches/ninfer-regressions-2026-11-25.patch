+               {"tools",Json::array({{{"name","alpha"},{"input_schema",Json::object()}},{{"name","beta"},{"input_schema",Json::object()}}})},{"tool_choice",{{"type","any"}}}};
+    auto ar=parse_anthropic_messages_request(anth,limits).generation;
