--- /dev/null
+++ b/tests/layerwise_pressure_wait.h
@@ -0,0 +1,23 @@
+#pragma once
+#include "models/qwen3_5/program/native_layerwise_request.h"
+
+namespace ninfer::test {
+// Direct Program fixtures have no Engine scheduler. Drive exactly the private
+// pressure continuation that the scheduler normally polls between units.
+inline std::uint32_t admit_layerwise_prefill(models::qwen3_5::detail::NativeLayerwiseRequest& owner,
+    std::uint32_t desired) {
+    for (;;) {
+        const auto admitted=owner.admit_prefill(desired);
+        if (admitted || !owner.pressure_pending()) return admitted;
+        owner.wait_pressure();owner.progress_pressure();
+    }
+}
+inline std::uint32_t admit_layerwise_output(models::qwen3_5::detail::NativeLayerwiseRequest& owner,
+    std::uint32_t desired) {
+    for (;;) {
+        const auto admitted=owner.admit_output(desired);
+        if (admitted || !owner.pressure_pending()) return admitted;
+        owner.wait_pressure();owner.progress_pressure();
+    }
+}
+}
diff --git a/tests/models/qwen3_5/layerwise_attention_fixture.h b/tests/models/qwen3_5/layerwise_attention_fixture.h
