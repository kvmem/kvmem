+    auto& first_row=id.rows[0];first_row.request=17;first_row.lane_epoch=1;first_row.begin=640;
+    first_row.valid=1;first_row.table=7;first_row.source.session={9,2};
+    first_row.source.frontier=640;first_row.source.valid=true;
+    NativeGraphOutputFrame frame;const auto first=frame.arm(id);require(first==1);
+    rejects([&]{frame.arm(id);});rejects([&]{frame.release(first);});
+    auto foreign=id;foreign.rows[0].request++;rejects([&]{frame.verify(first,foreign);});
+    foreign=id;foreign.rows[0].source.session.incarnation++;rejects([&]{frame.verify(first,foreign);});
+    foreign=id;foreign.rows[0].valid=2;rejects([&]{frame.verify(first,foreign);});
+    frame.verify(first,id);frame.mark_fenced(first);frame.release(first);
+    id.rows[0].request++;const auto second=frame.arm(id);require(second==2);
+    rejects([&]{frame.verify(first,id);});frame.discard_after_drain(first);require(frame.epoch()==second);
+    frame.discard_after_drain(second);require(!frame.epoch());
+    NativeGraphOutputFrame exhausted(UINT64_MAX);rejects([&]{exhausted.arm(id);});
+    auto invalid=id;invalid.rows[0].valid=65;rejects([&]{frame.arm(invalid);});
+    invalid=id;invalid.rows[0].source.frontier++;rejects([&]{frame.arm(invalid);});
+    for (std::uint32_t physical=1;physical<=64;++physical) for (std::uint32_t valid=1;valid<=physical;++valid) {
+        NativeGraphOutputFrame each;auto next=id;next.physical=physical;next.rows[0].valid=valid;
+        const auto e=each.arm(next);each.verify(e,next);each.mark_fenced(e);each.release(e);
