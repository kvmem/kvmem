+    /// Q8-ish geometry: 2 KV heads × head_dim 64 → kw = 128; 4 query heads →
+    /// GQA group 2, qw = 256.
+    const KV_HEADS: u32 = 2;
+    const Q_HEADS: u32 = 4;
+    const HEAD_DIM: u32 = 64;
+    const KW: usize = (KV_HEADS * HEAD_DIM) as usize;
+    const QW: usize = (Q_HEADS * HEAD_DIM) as usize;
+    const BT: u32 = 128;
+
+    fn raw_cfg(n_layer: u32) -> RawStoreConfig {
+        RawStoreConfig {
+            n_layer,
+            n_embd_k: KW as u32,
+            n_embd_v: KW as u32,
+            block_tokens: BT,
+            k_row_bytes: 0,
+            k_gpu_row_bytes: 136,
+            v_gpu_row_bytes: 136,
+        }
+    }
+
+    /// Feed each block's Mean-K as a constant per-block vector so the gathered
+    /// rows are deterministic and block-distinct.
+    fn feed_mean_k(keys: &RawStore, n_blocks: u32, il: u32) {
+        let mut row = vec![0f32; KW];
+        for b in 0..n_blocks {
+            for d in 0..KW {
+                row[d] = (((b as usize * 7 + d * 3) % 17) as f32) * 0.1 - 0.8;
+            }
+            // 128 identical rows → block mean == the row vector.
+            let tile: Vec<f32> = row.iter().copied().cycle().take(BT as usize * KW).collect();
+            keys.write_layer_mean_k(b * BT, BT, il, &tile)
+                .expect("mean-k feed");
+        }
+    }
+
+    /// Build a contiguous `[rows, query_heads, head_dim]` F32 device Q tile and
+    /// its native descriptor (BYTE strides, token axis outermost here).
+    fn device_q(gpu: &mut Gpu, rows: u32) -> (rdna_compute::GpuTensor, NativeCurrentLayerQuery) {
+        let qw = QW;
+        let mut host = vec![0f32; rows as usize * qw];
+        for (i, v) in host.iter_mut().enumerate() {
+            *v = (((i * 13) % 29) as f32) * 0.05 - 0.7;
+        }
+        let t = gpu
+            .alloc_tensor(&[host.len() * 4], DType::Raw)
+            .expect("q alloc");
+        gpu.hip
+            .memcpy_htod(&t.buf, unsafe {
+                std::slice::from_raw_parts(host.as_ptr() as *const u8, host.len() * 4)
+            })
+            .expect("q h2d");
+        let q = NativeCurrentLayerQuery {
+            data: t.buf.as_ptr() as *const std::ffi::c_void,
+            bytes: host.len() * 4,
+            layer: 0,
+            rows,
+            query_heads: Q_HEADS,
+            kv_heads: KV_HEADS,
+            head_dim: HEAD_DIM,
+            attention_scale: 0.0, // → 1/sqrt(head_dim)
+            scalar: 0,            // F32
+            row_stride: qw * 4,
+            head_stride: HEAD_DIM as usize * 4,
+            dimension_stride: 4,
+        };
+        (t, q)
+    }
+
+    fn frame(n: usize, mask: &[u8]) -> (Vec<u64>, Vec<u32>, Vec<u8>, Vec<u8>) {
+        let starts: Vec<u64> = (0..n).map(|i| (i as u64) * BT as u64).collect();
+        let counts: Vec<u32> = vec![BT; n];
+        (starts, counts, mask.to_vec(), vec![0u8; n])
+    }
+
+    /// Keep-set lifecycle (design §3.10a): a Query step UNIONS the previous
+    /// resident pool with this step's restored selection (pool growth, sorted +
+    /// deduped) so cold-recalled needle pages survive continuation turns; a
+    /// Pressure step TRUNCATES to the refined selection. The MTP composite verify
+    /// regime forces Pressure/REPLACE because asymmetric trunk+aux selections
+    /// diverge the per-layer resident counts the catalog requires equal (bug #8).
+    /// Pure host logic — no GPU.
+    #[test]
+    fn combine_keep_set_query_union_pressure_truncate() {
+        let prev = vec![vec![0u64, 2, 3], vec![1, 2]];
+        let restored = vec![vec![3u64, 4, 0], vec![2, 5]];
+        // Query: union per ordinal, sorted + deduped.
+        let q = combine_keep_set(&prev, &restored, false, 2);
+        assert_eq!(q, vec![vec![0, 2, 3, 4], vec![1, 2, 5]]);
+        // Pressure: truncate to the restored selection (sorted + deduped).
+        let p = combine_keep_set(&prev, &restored, true, 2);
+        assert_eq!(p, vec![vec![0, 3, 4], vec![2, 5]]);
+        // Absent ordinal entries read as []; n_layers governs the output length.
+        let short = combine_keep_set(&[], &restored, false, 3);
+        assert_eq!(short, vec![vec![0, 3, 4], vec![2, 5], Vec::<u64>::new()]);
+        // Empty restored on a Query step keeps the previous pool.
+        let keep = combine_keep_set(&prev, &[vec![], vec![]], false, 2);
+        assert_eq!(keep, vec![vec![0, 2, 3], vec![1, 2]]);
+        // Empty restored on a Pressure step truncates to empty.
+        let empty = combine_keep_set(&prev, &[vec![], vec![]], true, 2);
+        assert_eq!(empty, vec![Vec::<u64>::new(), Vec::<u64>::new()]);
+        // Cross-layer invariant (bug #8): different page IDS, equal COUNT ⇒ equal
+        // extent survives REPLACE. A union against a shared prev pool {0,1,2}
+        // would diverge (|{0,1,2}∪{0,1,3}|=4 vs |{0,1,2}∪{4,5,6}|=6); the MTP
+        // composite path forces Pressure/REPLACE to keep both layers at 3.
+        let sel = vec![vec![0u64, 1, 3], vec![4, 5, 6]];
+        let kept = combine_keep_set(&prev, &sel, true, 2);
+        assert_eq!(
+            kept[0].len(),
+            kept[1].len(),
+            "equal extent must survive REPLACE"
+        );
+        assert_eq!(kept, vec![vec![0, 1, 3], vec![4, 5, 6]]);
+    }
+
+    /// P4.1① multi-row seam (pure host, no GPU): `bootstrap_layerwise_rows`
+    /// evaluates `width` rows at the logical frontier with an optional absolute
+    /// query intersection, while the canonical history / specs / suffix /
+    /// native_history_tokens stay WIDTH-INDEPENDENT. `width == 1, query == None`
+    /// reproduces the AR `bootstrap_layerwise` identity byte-for-byte; the
+    /// fail-closed guards mirror the core's `query ⊆ evaluation` contract.
+    #[test]
+    fn bootstrap_rows_multi_row_span_and_width_one_identity() {
+        let fa = [3u32, 7, 11];
+        let resident = vec![vec![0u64, 1], vec![1, 2], vec![2, 3]];
+        let fed = 512u32; // 4 sealed pages → frontier 512, no partial tail
+        let bt = BT as u64;
+        let frontier = (fed / BT) as u64 * bt;
+        let rows = |width: u64, query: Option<QueryRange>| {
+            bootstrap_layerwise_rows(
+                fed,
+                0,
+                0,
+                5,
+                &fa,
+                Q_HEADS,
+                KV_HEADS,
+                HEAD_DIM,
+                4,
+                278528,
+                &resident,
+                width,
+                query,
+                &[],
+            )
+        };
+
+        // width=1/None == the AR delegator, identity field-for-field (Copy+Eq).
+        let ar = bootstrap_layerwise(
+            fed, 0, 0, 5, &fa, Q_HEADS, KV_HEADS, HEAD_DIM, 4, 278528, &resident,
+        )
+        .unwrap();
+        let one = rows(1, None).unwrap();
+        assert_eq!(
+            one.identity, ar.identity,
+            "width=1 must reproduce AR identity"
+        );
+        assert_eq!(
+            one.identity.evaluation,
+            QueryRange {
+                begin: frontier,
+                end: frontier + 1
+            }
+        );
+        assert_eq!(one.identity.query, one.identity.evaluation);
+        assert_eq!(one.suffix_page, ar.suffix_page);
+        assert_eq!(one.partial_tokens, ar.partial_tokens);
+        assert_eq!(one.native_history_tokens, ar.native_history_tokens);
+        // G7 Stage D: media pins ride EVERY layer's spec, clamped to the sealed
+        // history (4 pages here) and deduped; the id past the frontier is dropped
+        // (it is the suffix stripe, never a canonical pin). Empty by default.
+        assert!(one.specs.iter().all(|s| s.mandatory.is_empty()));
+        let pinned = bootstrap_layerwise_rows(
+            fed,
+            0,
+            0,
+            5,
+            &fa,
+            Q_HEADS,
+            KV_HEADS,
+            HEAD_DIM,
+            4,
+            278528,
+            &resident,
+            1,
+            None,
+            &[1, 2, 2, 99],
+        )
+        .unwrap();
+        for spec in &pinned.specs {
+            assert_eq!(spec.mandatory, vec![1, 2], "media pins per layer");
+        }
+
+        // width=4 MTP verify span: evaluation rides [frontier, frontier+4).
+        let four = rows(4, None).unwrap();
+        assert_eq!(
+            four.identity.evaluation,
+            QueryRange {
+                begin: frontier,
+                end: frontier + 4
+            }
+        );
+        assert_eq!(four.identity.query, four.identity.evaluation);
+        // Canonical history / specs / suffix are WIDTH-INDEPENDENT (byte-neutral):
+        // only the evaluation/query span widens, never the restored history.
+        assert_eq!(four.suffix_page, one.suffix_page);
+        assert_eq!(four.partial_tokens, one.partial_tokens);
+        assert_eq!(four.native_history_tokens, one.native_history_tokens);
+        assert_eq!(four.canonical.len(), one.canonical.len());
+        for (a, b) in four.canonical.iter().zip(one.canonical.iter()) {
+            assert_eq!(a.model_layer, b.model_layer);
+            assert_eq!(a.memory.resident, b.memory.resident);
+            assert_eq!(a.memory.stamp.frontier, b.memory.stamp.frontier);
+        }
+        for (a, b) in four.specs.iter().zip(one.specs.iter()) {
+            assert_eq!(a.budget.selected_tokens, b.budget.selected_tokens);
+            assert_eq!(a.budget.device_tokens, b.budget.device_tokens);
+            assert_eq!(a.budget.host_payload_bytes, b.budget.host_payload_bytes);
+        }
+
+        // Custom absolute query intersection ⊆ evaluation (the true Query rows).
+        let sub = rows(
+            4,
+            Some(QueryRange {
+                begin: frontier,
+                end: frontier + 2,
+            }),
+        )
+        .unwrap();
+        assert_eq!(
+            sub.identity.evaluation,
+            QueryRange {
+                begin: frontier,
+                end: frontier + 4
+            }
+        );
+        assert_eq!(
+            sub.identity.query,
+            QueryRange {
+                begin: frontier,
+                end: frontier + 2
+            }
+        );
+
+        // Fail-closed guards (core query ⊆ evaluation + width ≤ suffix page).
+        assert!(rows(0, None).is_err()); // width == 0
+        assert!(rows(bt + 1, None).is_err()); // width > suffix page
+        assert!(rows(
+            4,
+            Some(QueryRange {
+                begin: frontier - 1,
+                end: frontier + 2
+            })
+        )
+        .is_err()); // begin < frontier
+        assert!(rows(
+            4,
+            Some(QueryRange {
+                begin: frontier,
+                end: frontier + 5
+            })
+        )
+        .is_err()); // end > evaluation.end
+        assert!(rows(
+            4,
+            Some(QueryRange {
+                begin: frontier + 2,
+                end: frontier + 1
+            })
+        )
+        .is_err()); // begin > end
+        assert!(bootstrap_layerwise_rows(
+            fed,
+            0,
+            0,
+            5,
+            &[],
+            Q_HEADS,
+            KV_HEADS,
+            HEAD_DIM,
+            4,
+            278528,
+            &resident,
+            1,
+            None,
+            &[]
+        )
+        .is_err()); // empty fa_layers
+        assert!(bootstrap_layerwise_rows(
+            64,
+            0,
+            0,
+            5,
+            &fa,
+            Q_HEADS,
+            KV_HEADS,
+            HEAD_DIM,
+            4,
+            278528,
+            &resident,
+            1,
+            None,
+            &[]
+        )
+        .is_err()); // fed < 128: no sealed history page
+    }
