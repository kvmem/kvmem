+        QKV_V_M, K, n,
+    ) {
+        eprintln!("  [qkv N={n} MW{waves}] MW launch FAIL: {e:?}");
+        return false;
+    }
+    gpu.hip.device_synchronize().unwrap();
+    let y_mw: [Vec<f32>; 3] = std::array::from_fn(|i| gpu.download_f32(&d_y_mw[i]).expect("dl mw"));
