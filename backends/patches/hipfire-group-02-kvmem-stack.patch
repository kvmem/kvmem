+        let layout = layout_fingerprint(&raw_config());
+        // Exact prefix (longer prompt) passes.
+        let mut prompt = toks.clone();
+        prompt.extend_from_slice(&[9, 9, 9]);
+        assert!(ckpt.validate_reuse(&prompt, layout).is_ok());
