+/// True when `incoming` covers every previous origin (nonempty, no zero IDs).
+pub fn content_snapshot_covers(incoming: &[u64], previous: &[u64]) -> bool {
+    unsafe {
+        ffi::hk_content_snapshot_covers(
+            incoming.as_ptr(),
+            incoming.len(),
+            previous.as_ptr(),
+            previous.len(),
+        ) == 1
+    }
+}
