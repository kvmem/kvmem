+        // draft-less image retires speculation for this request instead of
+        // inheriting another request's draft rows.
+        #[cfg(feature = "kvmem")]
+        if kvmem_legacy_enabled(rig) && reused == 0 && req.prompt_tokens.len() > 1 {
