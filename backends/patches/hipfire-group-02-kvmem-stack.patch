+// SPDX-License-Identifier: Apache-2.0
+// Copyright (c) 2026 The hipfire authors
+// hipfire — see LICENSE or NOTICE in the project root.
+
+//! Host-only smoke test for the core checkpoint policy wrappers: the causal
+//! capture plan (semantic cuts + periodic timing) and the coverage retention
+//! selector (count/bytes + interval spacing, protected roles). Pure metadata:
+//! no payload, catalog mutation or device work.
+
+use hipfire_kvmem::{
+    retain_checkpoint_coverage, CheckpointCapturePlan, CoverageInfo, CoveragePurpose,
+};
+
+fn info(frontier: u64, bytes: u64, identity: u64, purpose: CoveragePurpose) -> CoverageInfo {
+    CoverageInfo {
+        frontier,
+        bytes,
+        used: identity,
+        identity,
+        purpose: purpose as u32,
+        protections: 0,
+    }
+}
+
+#[test]
+fn capture_plan_cuts_at_semantic_boundaries_and_schedules_periodic() {
+    let mut plan = CheckpointCapturePlan::new(0, 256, 1024, 2048).expect("plan");
+    assert_eq!(plan.due(256).expect("due"), Some(CoveragePurpose::Periodic));
+    assert_eq!(plan.due(300).expect("due"), Some(CoveragePurpose::Periodic));
+    plan.saved(256);
+    // The periodic cursor advanced: 300 is now below the next 512 slot.
+    assert_eq!(plan.due(300).expect("due"), None);
+    assert_eq!(plan.due(512).expect("due"), Some(CoveragePurpose::Periodic));
+    // The root cut clamps a chunk that would run past it.
+    assert_eq!(plan.cut(512, 2000), 1024);
+    assert_eq!(plan.due(1024).expect("due"), Some(CoveragePurpose::Root));
+    plan.saved(1024);
+    // The tail cut is next, even with the periodic cursor behind it.
+    assert_eq!(plan.cut(1024, 3000), 2048);
+    assert_eq!(plan.due(2048).expect("due"), Some(CoveragePurpose::Tail));
+    plan.saved(2048);
+    assert_eq!(plan.cut(2048, 3000), 3000);
+    assert_eq!(plan.due(2048).expect("due"), None);
+}
+
+#[test]
+fn capture_plan_constructor_marks_passed_semantic_points_done() {
+    let plan = CheckpointCapturePlan::new(4096, 256, 0, 0).expect("plan");
+    // Both semantic points are at/below the base, so only periodic fires.
+    assert_eq!(plan.cut(4096, 8000), 8000);
+    assert_eq!(
+        plan.due(4096).expect("due"),
+        None,
+        "the periodic cursor starts one stride ahead"
+    );
+    assert_eq!(
+        plan.due(4352).expect("due"),
+        Some(CoveragePurpose::Periodic)
+    );
+}
+
+#[test]
+fn retention_applies_count_and_keeps_the_newest() {
+    let infos: Vec<CoverageInfo> = (1..=6)
+        .map(|i| info(i * 100, 10, i as u64, CoveragePurpose::Periodic))
+        .collect();
+    let keep = retain_checkpoint_coverage(&infos, 1, 10_000, 100, 0).expect("retain");
+    assert_eq!(keep, vec![5], "one slot keeps the newest frontier");
+}
+
+#[test]
+fn retention_spaces_periodic_points_by_min_gap() {
+    let infos = vec![
+        info(10, 10, 1, CoveragePurpose::Periodic),
+        info(20, 10, 2, CoveragePurpose::Periodic),
+        info(30, 10, 3, CoveragePurpose::Periodic),
+        info(40, 10, 4, CoveragePurpose::Periodic),
+    ];
+    let keep = retain_checkpoint_coverage(&infos, 10, 10_000, 100, 15).expect("retain");
+    assert_eq!(keep, vec![0, 2], "10 and 30 survive a 15-token gap");
+}
+
+#[test]
+fn retention_skips_absent_identities_and_enforces_the_byte_budget() {
+    let infos = vec![
+        info(10, 10, 0, CoveragePurpose::Periodic),
+        info(20, 10, 2, CoveragePurpose::Periodic),
+    ];
+    assert_eq!(
+        retain_checkpoint_coverage(&infos, 10, 10_000, 100, 0).expect("retain"),
+        vec![1],
+        "absent slots are never retained"
+    );
+    let infos = vec![
+        info(10, 60, 1, CoveragePurpose::Periodic),
+        info(20, 60, 2, CoveragePurpose::Periodic),
+    ];
+    assert_eq!(
+        retain_checkpoint_coverage(&infos, 10, 100, 100, 0).expect("retain"),
+        vec![1],
+        "120 bytes cannot fit a 100-byte budget; the newest survives"
+    );
+}
+
+#[test]
+fn retention_protects_the_input_and_newest_endpoint_roles() {
+    let infos = vec![
+        info(10, 10, 1, CoveragePurpose::Input),
+        info(20, 10, 2, CoveragePurpose::Periodic),
+        info(30, 10, 3, CoveragePurpose::Periodic),
+        info(40, 10, 4, CoveragePurpose::Endpoint),
+    ];
+    // Two slots: the input role and the newest endpoint bypass ordinary
+    // cost-based eviction.
+    let keep = retain_checkpoint_coverage(&infos, 2, 10_000, 100, 0).expect("retain");
+    assert!(keep.contains(&0) && keep.contains(&3), "{keep:?}");
+}
diff --git a/crates/hipfire-kvmem/tests/content_cache_smoke.rs b/crates/hipfire-kvmem/tests/content_cache_smoke.rs
new file mode 100644
index 000000000..5dae0afea
--- /dev/null
+++ b/crates/hipfire-kvmem/tests/content_cache_smoke.rs
@@ -0,0 +1,157 @@
+// SPDX-License-Identifier: Apache-2.0
+// Copyright (c) 2026 The hipfire authors
+// hipfire — see LICENSE or NOTICE in the project root.
+
+//! Host-only smoke test for the content-cache policy wrappers: cache-owner
+//! resolution, candidate ranking, snapshot coverage, directory publication /
+//! eviction and group-aware retention. Pure metadata; no payload or directory
+//! mutation happens here.
+
+use hipfire_kvmem::{
+    content_snapshot_covers, plan_content_group_publication, rank_content_candidates,
+    resolve_cache_owner, select_content_eviction, select_content_publication, ContentCandidate,
+    ContentSlot, PublicationReason,
+};
+
+fn cand(slot: u64, frontier: u64, cold: u64, used: u64, cont: bool) -> ContentCandidate {
+    ContentCandidate {
+        slot,
+        frontier,
+        cold_bytes: cold,
+        last_used: used,
+        continuation: cont as i32,
+    }
+}
+
+fn mk(occupied: bool, pinned: bool, used: u64, identity: u64, group: u64) -> ContentSlot {
+    ContentSlot {
+        occupied: occupied as i32,
+        pinned: pinned as i32,
+        last_used: used,
+        identity,
+        group,
+    }
+}
+
+#[test]
+fn ranking_filters_orders_and_caps() {
+    let c = vec![
+        cand(0, 100, 10, 5, false),
+        cand(1, 200, 20, 9, false),
+        cand(2, 0, 10, 9, true), // zero frontier is not a candidate
+        cand(3, 150, 10, 7, true),
+    ];
+    let all = rank_content_candidates(&c, true, 16).expect("rank");
+    let ids: Vec<u64> = all.iter().map(|v| v.slot).collect();
+    assert_eq!(ids, vec![1, 3, 0]);
+    // Without a new user query only proven continuations survive.
+    let cont = rank_content_candidates(&c, false, 16).expect("rank");
+    assert_eq!(cont.iter().map(|v| v.slot).collect::<Vec<_>>(), vec![3]);
+    // The cap applies after ordering.
+    let capped = rank_content_candidates(&c, true, 2).expect("rank");
+    assert_eq!(
+        capped.iter().map(|v| v.slot).collect::<Vec<_>>(),
+        vec![1, 3]
+    );
+}
+
+#[test]
+fn snapshot_coverage_requires_every_named_origin() {
+    assert!(content_snapshot_covers(&[1, 2, 3], &[1, 3]));
+    assert!(!content_snapshot_covers(&[1, 2], &[1, 3]));
+    assert!(!content_snapshot_covers(&[0, 1], &[1]), "unknown origin");
+    assert!(
+        !content_snapshot_covers(&[1], &[]),
+        "empty coverage is no proof"
+    );
+}
+
+#[test]
+fn publication_inserts_dedupes_and_replaces() {
+    let (slot, reason) = select_content_publication(&[], 4, None).expect("publication");
+    assert_eq!((slot, reason), (Some(0), PublicationReason::Inserted));
+    let slots = vec![mk(true, false, 1, 7, 0), mk(true, false, 2, 8, 0)];
+    let (slot, reason) = select_content_publication(&slots, 4, Some(7)).expect("publication");
+    assert_eq!((slot, reason), (Some(0), PublicationReason::Deduplicated));
+    let (slot, reason) = select_content_publication(&slots, 2, None).expect("publication");
+    assert_eq!(
+        (slot, reason),
+        (Some(0), PublicationReason::Replaced),
+        "LRU unpinned victim"
+    );
+    let pinned = vec![mk(true, true, 1, 7, 0), mk(true, true, 2, 8, 0)];
+    let (slot, reason) = select_content_publication(&pinned, 2, None).expect("publication");
+    assert_eq!((slot, reason), (None, PublicationReason::AllPinned));
+    let (slot, reason) = select_content_publication(&slots, 0, None).expect("publication");
+    assert_eq!((slot, reason), (None, PublicationReason::Disabled));
+}
+
+#[test]
+fn eviction_prefers_redundant_group_versions() {
+    // Group 1 has two retained versions; group 2 one. The stale redundant
+    // version goes first even though group 2 is older.
+    let slots = vec![
+        mk(true, false, 3, 10, 1),
+        mk(true, false, 9, 11, 1),
+        mk(true, false, 1, 12, 2),
+    ];
+    assert_eq!(select_content_eviction(&slots).expect("eviction"), Some(0));
+    let pinned = vec![mk(true, true, 1, 10, 1), mk(true, true, 2, 11, 1)];
+    assert_eq!(select_content_eviction(&pinned).expect("eviction"), None);
+}
+
+#[test]
+fn group_publication_retires_whole_groups() {
+    let slots = vec![
+        mk(true, false, 1, 10, 1),
+        mk(true, false, 5, 11, 1),
+        mk(true, false, 9, 12, 2),
+    ];
+    let (slot, reason, retired) =
+        plan_content_group_publication(&slots, 8, 2, 4).expect("group publication");
+    assert_eq!(retired, vec![0, 1], "the oldest whole group retires");
+    assert_eq!(slot, Some(0), "the first released slot is reused");
+    assert_eq!(reason, PublicationReason::Replaced);
+    // A pinned sole group cannot be retired for the new group.
+    let pinned = vec![mk(true, true, 1, 10, 1), mk(true, true, 5, 11, 1)];
+    let (slot, reason, retired) =
+        plan_content_group_publication(&pinned, 8, 1, 2).expect("group publication");
+    assert_eq!(
+        (slot, reason, retired),
+        (None, PublicationReason::AllPinned, vec![])
+    );
+    assert_eq!(
+        plan_content_group_publication(&slots, 8, 2, 0)
+            .expect("group publication")
+            .1,
+        PublicationReason::Incomplete,
+        "an unknown incoming group never publishes"
+    );
+}
+
+#[test]
+fn cache_owner_resolution_matches_the_core_precedence() {
+    assert_eq!(
+        resolve_cache_owner(Some("conv"), Some("p"), None, None).expect("owner"),
+        Some("conv".into())
+    );
+    assert_eq!(
+        resolve_cache_owner(None, Some("p"), Some("p"), None).expect("owner"),
+        Some("p".into())
+    );
+    assert!(resolve_cache_owner(None, Some("p"), Some("other"), None).is_err());
+    assert_eq!(
+        resolve_cache_owner(None, Some(""), None, Some("legacy")).expect("owner"),
+        Some("legacy".into())
+    );
+    assert_eq!(
+        resolve_cache_owner(None, None, None, None).expect("owner"),
+        None
+    );
+    assert!(resolve_cache_owner(Some(""), None, None, None).is_err());
+    let long = "x".repeat(300);
+    assert_eq!(
+        resolve_cache_owner(None, None, None, Some(&long)).expect("owner"),
+        None
+    );
+}
diff --git a/crates/hipfire-kvmem/tests/d3_deterministic_discriminator.rs b/crates/hipfire-kvmem/tests/d3_deterministic_discriminator.rs
new file mode 100644
index 000000000..91b162606
--- /dev/null
+++ b/crates/hipfire-kvmem/tests/d3_deterministic_discriminator.rs
@@ -0,0 +1,286 @@
+// SPDX-License-Identifier: Apache-2.0
+// Copyright (c) 2026 The hipfire authors
+// hipfire — see LICENSE or NOTICE in the project root.
+
+//! D3-A deterministic discriminator (host-only, no GPU, no model sampling).
+//!
+//! The earlier recall discriminators mixed selection quality with generation
+//! nondeterminism (near-tie sampling / carrier rebuilds). This harness isolates
+//! *selection*: attention mass is injected exactly, the production
+//! `LayerwisePrefillPressure` and the Legacy global `pick_topk_blocks` picker
+//! consume it, and the retained page sets are compared byte-for-byte across
+//! repeats.
+//!
+//! S1 (heterogeneous need): three layers each depend on a different page while
+//! the documented global budget holds two. The per-layer picker must keep each
+//! layer's needed page; the global picker drops one of the three.
+//! S2 (negative control): identical mass in every layer must not manufacture a
+//! divergence — the per-layer pickers agree with each other and keep the needed
+//! page.
+//!
+//! Outcome routing (parity audit §8.3): S1 pass + S3 attribution on the real
+//! engine ⇒ selection mechanism sound (fix quotas); S1 fail ⇒ mechanism defect.
+
+use hipfire_kvmem::{
+    BackendIdentity, BlockCopies, BlockDescriptor, KvStore, KvStoreConfig, LayerMemorySnapshot,
+    MemoryCapabilities, MemoryCatalog, MemoryDescriptor, MemorySnapshot, MemoryStamp,
+    PayloadLayout, PrefillAcceptance, PrefillMass, PrefillOptions, PrefillPressure, PressureChoice,
+    RawStoreConfig, SessionIdentity,
+};
+
+const BLOCK: u32 = 4;
+const PAGES: u64 = 8;
+const TOKENS: u64 = PAGES * BLOCK as u64; // 32
+const ROW_BYTES: usize = 36;
+const LAYERS: [u32; 3] = [0, 1, 2];
+
+fn session() -> SessionIdentity {
+    SessionIdentity {
+        id: 42,
+        incarnation: 3,
+    }
+}
+
+fn raw_config() -> RawStoreConfig {
+    RawStoreConfig {
+        n_layer: LAYERS.len() as u32,
+        n_embd_k: 8,
+        n_embd_v: 8,
+        block_tokens: BLOCK,
+        k_row_bytes: 0,
+        k_gpu_row_bytes: ROW_BYTES as u64,
+        v_gpu_row_bytes: ROW_BYTES as u64,
+    }
+}
+
+fn descriptor() -> MemoryDescriptor {
+    let layout =
+        PayloadLayout::from_raw(&raw_config(), "hipfire-q8-packed-v1", &LAYERS).expect("layout");
+    let cap = MemoryCapabilities {
+        page_tokens: BLOCK,
+        max_position: 1 << 20,
+        native_payload: 1,
+        sparse_view: 1,
+        original_rope_positions: 1,
+        pre_rope_statistics: 1,
+        state_checkpoint: 1,
+        asynchronous_transfer: 0,
+    };
+    let backend = BackendIdentity {
+        backend: "hipfire".into(),
+        revision: "kvmem-v046".into(),
+        model: "d3-three-layer-fixture".into(),
+        state_schema: "state-v1".into(),
+    };
+    MemoryDescriptor::new(&backend, &layout, &cap).expect("descriptor")
+}
+
+fn stamp() -> MemoryStamp {
+    MemoryStamp {
+        valid: 1,
+        session: session(),
+        history_revision: 7,
+        view_version: 1,
+        frontier: TOKENS,
+        execution_history: 3,
+    }
+}
+
+fn block(i: u64) -> BlockDescriptor {
+    BlockDescriptor {
+        session: session(),
+        id: i,
+        original_start: i * BLOCK as u64,
+        valid_tokens: BLOCK,
+        content_version: 1,
+        statistics_version: 1,
+    }
+}
+
+/// Every page resident in every layer, one shared accepted history.
+fn catalog() -> MemoryCatalog {
+    let blocks: Vec<BlockCopies> = (0..PAGES)
+        .map(|i| BlockCopies {
+            block: block(i),
+            host_version: 1,
+        })
+        .collect();
+    let resident: Vec<u64> = (0..PAGES).collect();
+    let layers: Vec<LayerMemorySnapshot> = LAYERS
+        .iter()
+        .map(|&model_layer| LayerMemorySnapshot {
+            model_layer,
+            memory: MemorySnapshot {
+                stamp: stamp(),
+                blocks: blocks.clone(),
+                resident: resident.clone(),
+            },
+        })
+        .collect();
+    MemoryCatalog::new(&descriptor(), &layers).expect("catalog")
+}
+
+fn pressure() -> PrefillPressure {
+    PrefillPressure::new(
+        session(),
+        &LAYERS,
+        &PrefillOptions {
+            block_tokens: BLOCK,
+            select_tokens: 2 * BLOCK as u64, // two pages per layer
+            reserve_tokens: 0,
+            interval: 1,
+            stride: 0, // sample the last row only (deterministic)
+            half_life: 8192.0,
+        },
+    )
+    .expect("pressure")
+}
+
+/// One injected row: `needed` gets `share`, the rest split the remainder.
+fn mass_row(needed: u64, share: f64) -> Vec<f64> {
+    let mut row = vec![(1.0 - share) / (PAGES - 1) as f64; PAGES as usize];
+    row[needed as usize] = share;
+    row
+}
+
+/// Accept one whole-model prefill chunk whose sampled row is the last token.
+fn accept(pressure: &mut PrefillPressure, needed: &[u64]) -> bool {
+    let rows = pressure.rows(0, TOKENS as u32, 0, false).expect("rows");
+    assert_eq!(
+        rows,
+        vec![TOKENS as u32 - 1],
+        "stride-0 samples the last row"
+    );
+    let history: Vec<u64> = (0..PAGES).map(|i| i * BLOCK as u64).collect();
+    let layers: Vec<PrefillMass> = LAYERS
+        .iter()
+        .zip(needed)
+        .map(|(&model_layer, &page)| PrefillMass {
+            model_layer,
+            starts: history.clone(),
+            history: history.clone(),
+            masses: mass_row(page, 0.4),
+        })
+        .collect();
+    pressure
+        .accept(&PrefillAcceptance {
+            history: stamp(),
+            count: TOKENS,
+            accepted: TOKENS,
+            local_begin: 0,
+            rows,
+            layers,
+        })
+        .expect("accept")
+}
+
+fn chosen(choices: &[PressureChoice], layer: u32) -> Vec<u64> {
+    choices
+        .iter()
+        .find(|c| c.model_layer == layer)
+        .expect("layer choice")
+        .selected
+        .clone()
+}
+
+/// Legacy global picker over the same canonical pages.
+fn legacy_pick(scores: &[f64]) -> Vec<u32> {
+    let store = KvStore::new(&KvStoreConfig {
+        block_tokens: BLOCK,
+        select_budget: 2 * BLOCK, // two pages, the documented global budget
+        sink_blocks: 0,
+        recent_blocks: 0,
+        ..KvStoreConfig::default()
+    })
+    .expect("legacy store");
+    store.register_append(TOKENS as u32).expect("append");
+    store.set_retrieval_scores(scores).expect("scores");
+    store.pick_topk_blocks(&[]).expect("pick")
+}
+
+#[test]
+fn s1_heterogeneous_need_separates_per_layer_from_global_selection() {
+    let mut pressure = pressure();
+    assert!(accept(&mut pressure, &[2, 5, 7]));
+    let catalog = catalog();
+    let choices = pressure
+        .select(&catalog, &[], 2 * BLOCK as u64, 0)
+        .expect("select");
+    let read = choices.read_all().expect("read");
+
+    // The per-layer picker keeps every layer's own needed page.
+    for (layer, needed) in LAYERS.iter().zip([2u64, 5, 7]) {
+        let selected = chosen(&read, *layer);
+        assert_eq!(
+            selected.len(),
+            2,
+            "layer {layer} picks two pages: {selected:?}"
+        );
+        assert!(
+            selected.contains(&needed),
+            "layer {layer} lost page {needed}: {selected:?}"
+        );
+    }
+
+    // The same canonical pages under ONE global ranking: pages 2/5/7 are the
+    // top three, the budget holds two, so one needed page is dropped.
+    let mut scores = vec![0.05f64; PAGES as usize];
+    scores[2] = 0.34;
+    scores[5] = 0.33;
+    scores[7] = 0.33;
+    let picked = legacy_pick(&scores);
+    assert_eq!(picked.len(), 2, "global budget holds two pages: {picked:?}");
+    let dropped = [2u32, 5, 7].iter().any(|id| !picked.contains(id));
+    assert!(dropped, "global picker kept every needed page: {picked:?}");
+}
+
+#[test]
+fn s2_identical_mass_does_not_manufacture_divergence() {
+    let mut pressure = pressure();
+    assert!(accept(&mut pressure, &[2, 2, 2]));
+    let catalog = catalog();
+    let choices = pressure
+        .select(&catalog, &[], 2 * BLOCK as u64, 0)
+        .expect("select");
+    let read = choices.read_all().expect("read");
+
+    let first = chosen(&read, 0);
+    assert!(first.contains(&2), "needed page retained: {first:?}");
+    for layer in [1u32, 2] {
+        assert_eq!(
+            chosen(&read, layer),
+            first,
+            "identical mass must pick identically"
+        );
+    }
+
+    // Negative control: the Legacy ranking built from the same distribution
+    // keeps the same needed page; no artificial Layerwise "win".
+    let row = mass_row(2, 0.4);
+    let picked = legacy_pick(&row.into_iter().map(|v| v).collect::<Vec<_>>());
+    assert!(
+        picked.contains(&2),
+        "legacy keeps the shared needed page: {picked:?}"
+    );
+}
+
+#[test]
+fn selection_is_byte_stable_across_repeats() {
+    let mut pressure = pressure();
+    assert!(accept(&mut pressure, &[2, 5, 7]));
+    let catalog = catalog();
+    let a = pressure
+        .select(&catalog, &[], 2 * BLOCK as u64, 0)
+        .expect("select a")
+        .read_all()
+        .expect("read a");
+    let b = pressure
+        .select(&catalog, &[], 2 * BLOCK as u64, 0)
+        .expect("select b")
+        .read_all()
+        .expect("read b");
+    assert_eq!(a, b, "identical accepted mass must select identically");
+    for layer in LAYERS {
+        assert_eq!(chosen(&a, layer), chosen(&b, layer));
+    }
+}
diff --git a/crates/hipfire-kvmem/tests/layerwise_catalog_smoke.rs b/crates/hipfire-kvmem/tests/layerwise_catalog_smoke.rs
new file mode 100644
index 000000000..d385a8b84
--- /dev/null
+++ b/crates/hipfire-kvmem/tests/layerwise_catalog_smoke.rs
@@ -0,0 +1,280 @@
+// SPDX-License-Identifier: Apache-2.0
+// Copyright (c) 2026 Kaden Schutt
+// hipfire — see LICENSE and NOTICE in the project root.
+
+//! Host-only smoke test for the layerwise catalog + planning foundation: no GPU,
+//! no model. Mirrors kvmem's LayerwiseMemoryCatalog / LayerWorkingSetPlan over the
+//! hipfire Q8 {Key,Value} layout adapter: build a two-layer canonical catalog,
+//! plan a per-layer resident swap (restore/evict, drop-evict with a sealed host
+//! archive so no spill), read the reduced plan + per-layer transfer regions, and
+//! exercise the bulk plan and the fail-closed admission rejections.
+
+use hipfire_kvmem::{
+    BackendIdentity, BlockCopies, BlockDescriptor, LayerMemorySnapshot, LayerSelection,
+    MemoryBudget, MemoryCapabilities, MemoryDescriptor, MemorySnapshot, MemoryStamp, PayloadLayout,
+    RawStoreConfig, SessionIdentity,
+};
+
+const BLOCK: u32 = 4;
+const ROW_BYTES: usize = 36;
+const LAYERS: u32 = 2;
+const RECORD_BYTES: u64 = (ROW_BYTES * BLOCK as usize * LAYERS as usize * 2) as u64; // 576
+const PLANE_BYTES: u64 = (ROW_BYTES * BLOCK as usize) as u64; // 144
+const LAYER_BYTES: u64 = PLANE_BYTES * 2; // 288 (K+V for one layer)
+
+fn raw_config() -> RawStoreConfig {
+    RawStoreConfig {
+        n_layer: LAYERS,
+        n_embd_k: 8,
+        n_embd_v: 8,
+        block_tokens: BLOCK,
+        k_row_bytes: 0,
+        k_gpu_row_bytes: ROW_BYTES as u64,
+        v_gpu_row_bytes: ROW_BYTES as u64,
+    }
+}
+
+fn backend() -> BackendIdentity {
+    BackendIdentity {
+        backend: "hipfire".into(),
+        revision: "kvmem-v046".into(),
+        model: "two-layer-fixture".into(),
+        state_schema: "state-v1".into(),
+    }
+}
+
+fn session() -> SessionIdentity {
+    SessionIdentity {
+        id: 42,
+        incarnation: 3,
+    }
+}
+
+fn descriptor() -> MemoryDescriptor {
+    let layout =
+        PayloadLayout::from_raw(&raw_config(), "hipfire-q8-packed-v1", &[0, 1]).expect("layout");
+    let cap = MemoryCapabilities {
+        page_tokens: BLOCK,
+        max_position: 1 << 20,
+        native_payload: 1,
+        sparse_view: 1,
+        original_rope_positions: 1,
+        pre_rope_statistics: 1,
+        state_checkpoint: 1,
+        asynchronous_transfer: 0,
+    };
+    MemoryDescriptor::new(&backend(), &layout, &cap).expect("descriptor")
+}
+
+/// Accepted history stamp; only `view_version` differs between target layers.
+fn stamp(view_version: u64) -> MemoryStamp {
+    MemoryStamp {
+        valid: 1,
+        session: session(),
+        history_revision: 5,
+        view_version,
+        frontier: 8,
+        execution_history: 9,
+    }
+}
+
+fn block(id: u64, start: u64, content_version: u64) -> BlockDescriptor {
+    BlockDescriptor {
+        session: session(),
+        id,
+        original_start: start,
+        valid_tokens: BLOCK,
+        content_version,
+        statistics_version: 2,
+    }
+}
+
+/// Two full blocks (100@0, 200@4), both with completed current host copies.
+fn snapshot(view_version: u64, resident: Vec<u64>) -> MemorySnapshot {
+    MemorySnapshot {
+        stamp: stamp(view_version),
+        blocks: vec![
+            BlockCopies {
+                block: block(100, 0, 1),
+                host_version: 1,
+            },
+            BlockCopies {
+                block: block(200, 4, 2),
+                host_version: 2,
+            },
+        ],
+        resident,
+    }
+}
+
+fn layers() -> Vec<LayerMemorySnapshot> {
+    vec![
+        LayerMemorySnapshot {
+            model_layer: 0,
+            memory: snapshot(6, vec![100]),
+        },
+        LayerMemorySnapshot {
+            model_layer: 1,
+            memory: snapshot(11, vec![200]),
+        },
+    ]
+}
+
+fn budget() -> MemoryBudget {
+    MemoryBudget {
+        selected_tokens: BLOCK as u64,
+        reserve_tokens: 0,
+        device_tokens: BLOCK as u64,
+        host_payload_bytes: RECORD_BYTES * 4,
+    }
+}
+
+/// Swap layer 0's resident set from [100] to [200].
+fn sel0() -> LayerSelection {
+    LayerSelection {
+        model_layer: 0,
+        expected: stamp(6),
+        selected: vec![200],
+        mandatory: vec![],
+        budget: budget(),
+    }
+}
+
+/// Swap layer 1's resident set from [200] to [100].
+fn sel1() -> LayerSelection {
+    LayerSelection {
+        model_layer: 1,
+        expected: stamp(11),
+        selected: vec![100],
+        mandatory: vec![],
+        budget: budget(),
+    }
+}
+
+#[test]
+fn catalog_snapshots_and_per_layer_plan() {
+    let desc = descriptor();
+    let catalog = hipfire_kvmem::MemoryCatalog::new(&desc, &layers()).expect("catalog");
+
+    // Catalog stored both target layers in model order with their own stamps.
+    assert_eq!(catalog.layer_count(), 2);
+    assert_eq!(catalog.model_layer(0), 0);
+    assert_eq!(catalog.model_layer(1), 1);
+    assert_eq!(catalog.snapshot_stamp(0).expect("stamp 0"), stamp(6));
+    assert_eq!(catalog.snapshot_stamp(1).expect("stamp 1"), stamp(11));
+    assert_eq!(catalog.snapshot_block_count(0), 2);
+    let b0 = catalog.snapshot_block(0, 0).expect("block 0");
+    assert_eq!(b0.block.id, 100);
+    assert_eq!(b0.host_version, 1);
+    assert_eq!(catalog.snapshot_block(0, 1).expect("block 1").block.id, 200);
+    assert_eq!(catalog.snapshot_resident_count(0), 1);
+    assert_eq!(catalog.snapshot_resident(0, 0), 100);
+    assert_eq!(catalog.snapshot_resident(1, 0), 200);
+
+    // Plan layer 0's swap: restore 200, drop-evict 100 (sealed host copy → no spill).
+    let plan = catalog.plan_layer(&sel0()).expect("plan layer 0");
+    assert_eq!(plan.model_layer(), 0);
+    assert_eq!(plan.restore_count(), 1);
+    assert_eq!(plan.restore_block(0).expect("restore").id, 200);
+    assert_eq!(plan.evict_count(), 1);
+    assert_eq!(plan.evict_block(0).expect("evict").id, 100);
+    assert_eq!(plan.spill_count(), 0);
+    assert_eq!(plan.mandatory_count(), 0);
+    assert_eq!(plan.next_visible_tokens(), BLOCK as u64);
+    assert_eq!(plan.next_block_count(), 1);
+    let nb = plan.next_block(0).expect("next block");
+    assert_eq!(nb.block.id, 200);
+    assert_eq!(nb.compact_start, 0);
+    let ns = plan.next_stamp().expect("next stamp");
+    assert_eq!(ns.view_version, 7); // 6 + 1
+    assert_eq!(ns.frontier, 8);
+    assert_eq!(ns.history_revision, 5);
+    assert_eq!(plan.restore_bytes(), LAYER_BYTES);
+    assert_eq!(plan.spill_bytes(), 0);
+    assert_eq!(plan.device_tokens_required(), BLOCK as u64);
+    assert_eq!(plan.host_payload_bytes_required(), RECORD_BYTES * 2);
+
+    // The per-layer transfer regions are a separate KvRegions handle.
+    let regions = plan.payload().expect("payload regions");
+    assert_eq!(regions.region_count(), 2);
+    assert_eq!(regions.plane_bytes(), LAYER_BYTES);
+    assert_eq!(regions.packed_bytes(), LAYER_BYTES); // alignment 1, no padding
+    assert_eq!(regions.record_bytes(), RECORD_BYTES);
+
+    // Layer 1 swaps the other way.
+    let plan1 = catalog.plan_layer(&sel1()).expect("plan layer 1");
+    assert_eq!(plan1.model_layer(), 1);
+    assert_eq!(plan1.restore_block(0).expect("restore").id, 100);
+    assert_eq!(plan1.evict_block(0).expect("evict").id, 200);
+    assert_eq!(plan1.next_stamp().expect("stamp").view_version, 12); // 11 + 1
+    assert_eq!(plan1.restore_bytes(), LAYER_BYTES);
+}
+
+#[test]
+fn bulk_plan_shared_archive_accounting() {
+    let desc = descriptor();
+    let catalog = hipfire_kvmem::MemoryCatalog::new(&desc, &layers()).expect("catalog");
+    let plan = catalog.plan(&[sel0(), sel1()]).expect("bulk plan");
+    assert_eq!(plan.layer_count(), 2);
+    let history = plan.history().expect("history");
+    assert_eq!(history.history_revision, 5);
+    assert_eq!(history.frontier, 8);
+    assert_eq!(history.view_version, 0); // bulk history identity carries no view version
+                                         // Union of canonical full-record IDs, NOT the sum of per-layer requirements.
+    assert_eq!(plan.host_payload_bytes_required(), RECORD_BYTES * 2);
+    let l0 = plan.layer(0).expect("layer 0");
+    let l1 = plan.layer(1).expect("layer 1");
+    assert_eq!(l0.model_layer(), 0);
+    assert_eq!(l1.model_layer(), 1);
+    assert_eq!(l0.restore_block(0).expect("restore").id, 200);
+    assert_eq!(l1.restore_block(0).expect("restore").id, 100);
+    assert!(plan.layer(2).is_err(), "out-of-range layer index");
+}
+
+#[test]
+fn fail_closed_admission_and_stale_selection() {
+    let desc = descriptor();
+    let catalog = hipfire_kvmem::MemoryCatalog::new(&desc, &layers()).expect("catalog");
+
+    // A stale expected view version is rejected.
+    let mut stale = sel0();
+    stale.expected.view_version = 999;
+    assert!(catalog.plan_layer(&stale).is_err(), "stale expected stamp");
+
+    // An unknown target layer is rejected.
+    let mut unknown = sel0();
+    unknown.model_layer = 5;
+    assert!(catalog.plan_layer(&unknown).is_err(), "unknown layer");
+
+    // A selection over budget is rejected (device_tokens too small for the page).
+    let mut tight = sel0();
+    tight.budget.device_tokens = 0;
+    assert!(
+        catalog.plan_layer(&tight).is_err(),
+        "device budget exceeded"
+    );
+
+    // Inconsistent resident extent between layers fails catalog admission.
+    let mut bad_extent = layers();
+    bad_extent[1].memory.resident = vec![100, 200]; // 8 tokens vs layer 0's 4
+    assert!(
+        hipfire_kvmem::MemoryCatalog::new(&desc, &bad_extent).is_err(),
+        "inconsistent resident extent"
+    );
+
+    // A divergent accepted history fails catalog admission.
+    let mut bad_history = layers();
+    bad_history[1].memory.stamp.history_revision = 6;
+    assert!(
+        hipfire_kvmem::MemoryCatalog::new(&desc, &bad_history).is_err(),
+        "divergent history"
+    );
+
+    // A cold block without a completed current host copy fails admission.
+    let mut no_host = layers();
+    no_host[0].memory.blocks[1].host_version = 0; // block 200 cold in layer 0
+    assert!(
+        hipfire_kvmem::MemoryCatalog::new(&desc, &no_host).is_err(),
+        "cold history without host copy"
+    );
+}
diff --git a/crates/hipfire-kvmem/tests/layerwise_payload_smoke.rs b/crates/hipfire-kvmem/tests/layerwise_payload_smoke.rs
new file mode 100644
index 000000000..1505ec1be
--- /dev/null
+++ b/crates/hipfire-kvmem/tests/layerwise_payload_smoke.rs
@@ -0,0 +1,321 @@
+// SPDX-License-Identifier: Apache-2.0
+// Copyright (c) 2026 Kaden Schutt
+// hipfire — see LICENSE and NOTICE in the project root.
+
+//! Host-only smoke test for the layerwise native payload foundation: no GPU, no
+//! model. Exercises the exact building blocks the packed-page driver relies on:
+//! the Q8 PayloadLayout adapter, MemoryDescriptor validation, per-layer
+//! NativeKvLayerRegions compact-extent reads from a sealed host record, the
+//! NativeKvArchive write-through store and the raw-KV export/import bridge.
+
+use hipfire_kvmem::{
+    BackendIdentity, BlockDescriptor, HostRecord, KvRegions, MemoryCapabilities, MemoryDescriptor,
+    NativeArchive, NativePayload, PayloadLayout, PayloadPlane, PayloadPlaneKind, RawStore,
+    RawStoreConfig, SessionIdentity, Storage,
+};
+
+const BLOCK: u32 = 4;
+const ROW_BYTES: usize = 36; // opaque packed Q8 row; contents only round-trip
+const LAYERS: u32 = 2;
+const RECORD_BYTES: usize = ROW_BYTES * BLOCK as usize * LAYERS as usize * 2; // K+V per layer
+
+fn raw_config() -> RawStoreConfig {
+    RawStoreConfig {
+        n_layer: LAYERS,
+        n_embd_k: 8,
+        n_embd_v: 8,
+        block_tokens: BLOCK,
+        k_row_bytes: 0,
+        k_gpu_row_bytes: ROW_BYTES as u64,
+        v_gpu_row_bytes: ROW_BYTES as u64,
+    }
+}
+
+fn backend() -> BackendIdentity {
+    BackendIdentity {
+        backend: "hipfire".into(),
+        revision: "kvmem-v046".into(),
+        model: "two-layer-fixture".into(),
+        state_schema: "state-v1".into(),
+    }
+}
+
+fn session() -> SessionIdentity {
+    SessionIdentity {
+        id: 42,
+        incarnation: 3,
+    }
+}
+
+fn block0() -> BlockDescriptor {
+    BlockDescriptor {
+        session: session(),
+        id: 0,
+        original_start: 0,
+        valid_tokens: BLOCK,
+        content_version: 1,
+        statistics_version: 1,
+    }
+}
+
+/// Deterministic packed row for (layer, kind, token): kind 0 = K, 1 = V.
+fn pack_row(layer: u32, kind: u32, token: u32) -> [u8; ROW_BYTES] {
+    let mut row = [0u8; ROW_BYTES];
+    let seed = (layer * 100 + kind * 10 + token) as u8;
+    for (i, b) in row.iter_mut().enumerate() {
+        *b = seed.wrapping_add(i as u8).wrapping_mul(7);
+    }
+    row
+}
+
+/// Write packed K/V for block 0, every layer, into the raw store.
+fn feed_block0(raw: &RawStore) {
+    for il in 0..LAYERS {
+        let mut k = Vec::new();
+        let mut v = Vec::new();
+        for t in 0..BLOCK {
+            k.extend_from_slice(&pack_row(il, 0, t));
+            v.extend_from_slice(&pack_row(il, 1, t));
+        }
+        raw.write_layer_k_gpu(0, BLOCK, il, &k).expect("feed k");
+        raw.write_layer_v_gpu(0, BLOCK, il, &v).expect("feed v");
+    }
+}
+
+#[test]
+fn layout_adapter_and_descriptor() {
+    let layout = PayloadLayout::from_raw(&raw_config(), "hipfire-q8-packed-v1", &[0, 1])
+        .expect("layout from raw");
+    assert_eq!(layout.block_tokens(), BLOCK);
+    assert_eq!(layout.record_bytes(), RECORD_BYTES as u64);
+    assert_eq!(layout.plane_count(), LAYERS * 2);
+
+    // Planes are layer-major {Key,Value}, contiguous, stride = packed row bytes.
+    let mut expect_offset = 0u64;
+    for il in 0..LAYERS {
+        for kind in [PayloadPlaneKind::Key, PayloadPlaneKind::Value] {
+            let p = layout.plane(il * 2 + kind as u32).expect("plane");
+            assert_eq!(p.layer, il);
+            assert_eq!(p.kind, kind as u32);
+            assert_eq!(p.offset, expect_offset);
+            assert_eq!(p.bytes, (ROW_BYTES * BLOCK as usize) as u64);
+            assert_eq!(p.token_stride, ROW_BYTES as u64);
+            assert_eq!(p.alignment, 1);
+            expect_offset += p.bytes;
+        }
+    }
+    assert_eq!(expect_offset, RECORD_BYTES as u64);
+
+    let cap = MemoryCapabilities {
+        page_tokens: BLOCK,
+        max_position: 1 << 20,
+        native_payload: 1,
+        sparse_view: 1,
+        original_rope_positions: 1,
+        pre_rope_statistics: 1,
+        state_checkpoint: 1,
+        asynchronous_transfer: 0,
+    };
+    let _desc = MemoryDescriptor::new(&backend(), &layout, &cap).expect("descriptor");
+
+    // An empty attention-layer list is rejected, not silently zero-sized.
+    assert!(PayloadLayout::from_raw(&raw_config(), "fmt", &[]).is_err());
+}
+
+#[test]
+fn export_regions_read_and_import_roundtrip() {
+    let storage = Storage::new_ram(1 << 30).expect("storage");
+    let raw = RawStore::new(raw_config(), Some(&storage)).expect("raw store");
+    feed_block0(&raw);
+
+    let layout =
+        PayloadLayout::from_raw(&raw_config(), "hipfire-q8-packed-v1", &[0, 1]).expect("layout");
+
+    // Export gathers all layers' packed K/V into one canonical record.
+    let payload = NativePayload::export(&raw, &backend(), &layout, &block0()).expect("export");
+    assert_eq!(payload.size(), RECORD_BYTES);
+    assert_eq!(payload.block().expect("block"), block0());
+
+    // The exported bytes are exactly the layer-major {K,V} packed rows.
+    let bytes = payload.bytes();
+    let mut expect = Vec::new();
+    for il in 0..LAYERS {
+        for t in 0..BLOCK {
+            expect.extend_from_slice(&pack_row(il, 0, t));
+        }
+        for t in 0..BLOCK {
+            expect.extend_from_slice(&pack_row(il, 1, t));
+        }
+    }
+    assert_eq!(bytes, expect.as_slice());
+
+    // Seal the canonical record as a host source, then read layer 0's compact
+    // extent (its K plane then V plane) out of the full multi-layer record.
+    let record = HostRecord::allocate(&storage, bytes).expect("allocate record");
+    record.seal().expect("seal");
+    assert_eq!(record.size(), RECORD_BYTES);
+    let source = record.source().expect("source");
+    assert_eq!(source.size(), RECORD_BYTES);
+
+    let regions = KvRegions::new(&layout, 0, None).expect("regions layer 0");
+    let plane_bytes = (ROW_BYTES * BLOCK as usize) as u64;
+    assert_eq!(regions.region_count(), 2);
+    assert_eq!(regions.plane_bytes(), 2 * plane_bytes);
+    assert_eq!(regions.packed_bytes(), 2 * plane_bytes); // alignment 1, no padding
+    assert_eq!(regions.record_bytes(), RECORD_BYTES as u64);
+    let (k_plane, k_off) = regions.region(0).expect("region 0");
+    let (v_plane, v_off) = regions.region(1).expect("region 1");
+    assert_eq!(k_plane.kind, PayloadPlaneKind::Key as u32);
+    assert_eq!(v_plane.kind, PayloadPlaneKind::Value as u32);
+    assert_eq!(k_off, 0);
+    assert_eq!(v_off, plane_bytes);
+
+    let mut staging = vec![0u8; regions.packed_bytes() as usize];
+    // Bounded reads that deliberately cross a plane boundary, like the core test.
+    let split = 13usize;
+    regions
+        .read(&source, 0, &mut staging[..split], 7)
+        .expect("read part 1");
+    regions
+        .read(&source, split as u64, &mut staging[split..], 7)
+        .expect("read part 2");
+    let mut expect_layer0 = Vec::new();
+    for t in 0..BLOCK {
+        expect_layer0.extend_from_slice(&pack_row(0, 0, t));
+    }
+    for t in 0..BLOCK {
+        expect_layer0.extend_from_slice(&pack_row(0, 1, t));
+    }
+    assert_eq!(staging, expect_layer0);
+
+    // Layer 1 reads its own stripe from the same canonical record.
+    let regions1 = KvRegions::new(&layout, 1, None).expect("regions layer 1");
+    let mut staging1 = vec![0u8; regions1.packed_bytes() as usize];
+    regions1
+        .read(&source, 0, &mut staging1, 64 << 20)
+        .expect("read layer 1");
+    let mut expect_layer1 = Vec::new();
+    for t in 0..BLOCK {
+        expect_layer1.extend_from_slice(&pack_row(1, 0, t));
+    }
+    for t in 0..BLOCK {
+        expect_layer1.extend_from_slice(&pack_row(1, 1, t));
+    }
+    assert_eq!(staging1, expect_layer1);
+
+    // Import the canonical record into a FRESH raw store and verify packed
+    // readback per layer/plane (statistics are untouched by import).
+    let raw2 = RawStore::new(raw_config(), Some(&storage)).expect("raw store 2");
+    payload.import(&raw2, &backend(), &layout).expect("import");
+    for il in 0..LAYERS {
+        assert!(raw2.has_k_gpu(0, il, BLOCK));
+        assert!(raw2.has_v_gpu(0, il, BLOCK));
+        let mut k = vec![0u8; BLOCK as usize * ROW_BYTES];
+        let mut v = vec![0u8; BLOCK as usize * ROW_BYTES];
+        assert!(raw2.copy_k_gpu(0, il, &mut k, BLOCK));
+        assert!(raw2.copy_v_gpu(0, il, &mut v, BLOCK));
+        for t in 0..BLOCK as usize {
+            assert_eq!(
+                &k[t * ROW_BYTES..(t + 1) * ROW_BYTES],
+                &pack_row(il, 0, t as u32)
+            );
+            assert_eq!(
+                &v[t * ROW_BYTES..(t + 1) * ROW_BYTES],
+                &pack_row(il, 1, t as u32)
+            );
+        }
+    }
+}
+
+#[test]
+fn archive_write_through_and_stale_rejection() {
+    let storage = Storage::new_ram(1 << 30).expect("storage");
+    let raw = RawStore::new(raw_config(), Some(&storage)).expect("raw store");
+    feed_block0(&raw);
+    let layout =
+        PayloadLayout::from_raw(&raw_config(), "hipfire-q8-packed-v1", &[0, 1]).expect("layout");
+    let payload = NativePayload::export(&raw, &backend(), &layout, &block0()).expect("export");
+
+    let archive = NativeArchive::new(&backend(), session(), &layout, (RECORD_BYTES * 4) as u64)
+        .expect("archive");
+    assert_eq!(archive.bytes(), 0);
+    archive.put(&payload).expect("put");
+    assert_eq!(archive.bytes(), RECORD_BYTES as u64);
+
+    // get returns a new caller-owned handle with identical bytes/identity.
+    let fetched = archive.get(&block0()).expect("get");
+    assert_eq!(fetched.bytes(), payload.bytes());
+    assert_eq!(fetched.block().expect("block"), block0());
+
+    // Re-putting the identical version is idempotent (no double charge).
+    archive.put(&payload).expect("idempotent put");
+    assert_eq!(archive.bytes(), RECORD_BYTES as u64);
+
+    // Upgrade to a higher content_version (replaces in place, no double charge).
+    // content_version 0 is invalid at construction, so genuine staleness must be
+    // exercised against a stored version above the minimum valid version 1.
+    let mut upgraded = block0();
+    upgraded.content_version = 2;
+    let newer = NativePayload::create(&backend(), &layout, &upgraded, payload.bytes())
+        .expect("upgraded payload");
+    archive.put(&newer).expect("upgrade put");
+    assert_eq!(archive.bytes(), RECORD_BYTES as u64);
+
+    // A stale (lower content_version) write is rejected.
+    let stale = NativePayload::create(&backend(), &layout, &block0(), payload.bytes())
+        .expect("stale payload");
+    assert!(archive.put(&stale).is_err(), "stale write must be rejected");
+
+    // A foreign backend identity is rejected.
+    let mut foreign = backend();
+    foreign.model = "other-model".into();
+    let foreign_payload =
+        NativePayload::create(&foreign, &layout, &upgraded, payload.bytes()).expect("foreign");
+    assert!(
+        archive.put(&foreign_payload).is_err(),
+        "foreign write must be rejected"
+    );
+
+    // A mismatched get identity is rejected (wrong frontier, same version).
+    let mut wrong = block0();
+    wrong.content_version = 2;
+    wrong.valid_tokens = BLOCK - 1;
+    assert!(archive.get(&wrong).is_err());
+
+    archive.erase(0);
+    assert_eq!(archive.bytes(), 0);
+    assert!(archive.get(&upgraded).is_err(), "erased record is missing");
+}
+
+#[test]
+fn generic_layout_create_matches_adapter() {
+    // Hand-build the same two-layer Q8 layout via the explicit plane builder.
+    let plane_bytes = (ROW_BYTES * BLOCK as usize) as u64;
+    let mut planes = Vec::new();
+    let mut offset = 0u64;
+    for il in 0..LAYERS {
+        for kind in [PayloadPlaneKind::Key, PayloadPlaneKind::Value] {
+            planes.push(PayloadPlane {
+                layer: il,
+                kind: kind as u32,
+                offset,
+                bytes: plane_bytes,
+                alignment: 1,
+                token_stride: ROW_BYTES as u64,
+                rank: 0,
+                head_begin: 0,
+                head_count: 0,
+            });
+            offset += plane_bytes;
+        }
+    }
+    let layout = PayloadLayout::create("hipfire-q8-packed-v1", 1, BLOCK, offset, 1, &planes)
+        .expect("generic layout");
+    assert_eq!(layout.record_bytes(), RECORD_BYTES as u64);
+    assert_eq!(layout.plane_count(), LAYERS * 2);
+    assert_eq!(layout.plane(0).expect("plane 0"), planes[0]);
+    assert!(
+        layout.plane(LAYERS * 2).is_err(),
+        "out-of-range plane index"
+    );
+}
diff --git a/crates/hipfire-kvmem/tests/layerwise_probe_smoke.rs b/crates/hipfire-kvmem/tests/layerwise_probe_smoke.rs
new file mode 100644
index 000000000..dbff10316
--- /dev/null
+++ b/crates/hipfire-kvmem/tests/layerwise_probe_smoke.rs
@@ -0,0 +1,391 @@
+// SPDX-License-Identifier: Apache-2.0
+// Copyright (c) 2026 Kaden Schutt
+// hipfire — see LICENSE and NOTICE in the project root.
+
+//! Host-only smoke test for the layerwise MTP private-probe selection
+//! (UpstreamGlobal head history): no GPU, no model. Mirrors kvmem's
+//! LayerwiseProbeSelection scalar reference over the C ABI — admit a frozen
+//! two-target probe against a finite metadata account, append the private TARGET
+//! forward's pre-RoPE Q token-major (a host Mean-K stand-in scorer), then finish
+//! to the global-reduction head-history pick. Proves the C-ABI scorer plumbing,
+//! the uniform L-layer global averaging (NOT a per-layer pick), the token-major
+//! coverage contract, tiling invariance and fail-closed abort — with no GPU and
+//! no model. The statistics oracle uses head_dim 1 (n_embd_k 1); the two target
+//! layers share one frozen page denominator.
+
+use std::cell::Cell;
+use std::ffi::c_void;
+use std::rc::Rc;
+
+use hipfire_kvmem::{
+    KvMemError, KvStore, KvStoreConfig, LayerQueryGeometry, LayerwiseIdentity, MemoryStamp,
+    NativeCurrentLayerQuery, NativeQueryScalar, ProbePhase, ProbeSelection, QueryRange,
+    QueryScoreFrame, RawStore, RawStoreConfig, SessionIdentity, Storage,
+};
+
+const BLOCK: u32 = 4;
+// evaluation span [8, 12); query span [9, 11); frontier 8 == policy.total_tokens.
+const QUERY_ROWS: u32 = 2;
+
+fn session() -> SessionIdentity {
+    SessionIdentity {
+        id: 42,
+        incarnation: 3,
+    }
+}
+
+fn stats_config() -> RawStoreConfig {
+    RawStoreConfig {
+        n_layer: 2,
+        n_embd_k: 1,
+        n_embd_v: 0,
+        block_tokens: BLOCK,
+        k_row_bytes: 0,
+        k_gpu_row_bytes: 0,
+        v_gpu_row_bytes: 0,
+    }
+}
+
+fn stamp() -> MemoryStamp {
+    MemoryStamp {
+        valid: 1,
+        session: session(),
+        history_revision: 5,
+        view_version: 6,
+        frontier: 8,
+        execution_history: 9,
+    }
+}
+
+fn identity() -> LayerwiseIdentity {
+    LayerwiseIdentity {
+        history: stamp(),
+        request: 77,
+        evaluation: QueryRange { begin: 8, end: 12 },
+        query: QueryRange { begin: 9, end: 11 },
+    }
+}
+
+fn geometry(layer: u32) -> LayerQueryGeometry {
+    LayerQueryGeometry {
+        layer,
+        query_heads: 1,
+        kv_heads: 1,
+        head_dim: 1,
+        attention_scale: 1.0,
+    }
+}
+
+fn targets() -> Vec<LayerQueryGeometry> {
+    vec![geometry(0), geometry(1)]
+}
+
+/// Sealed plain Mean-K TopK index: 2 canonical blocks of 4 tokens, budget 1 block.
+fn policy() -> KvStore {
+    let cfg = KvStoreConfig {
+        block_tokens: BLOCK,
+        select_budget: BLOCK,
+        sink_blocks: 0,
+        recent_blocks: 0,
+        ..KvStoreConfig::default()
+    };
+    let kv = KvStore::new(&cfg).expect("policy");
+    kv.register_append(2 * BLOCK).expect("append");
+    kv
+}
+
+/// block0 mean_k = -1, block1 mean_k = +1 for both statistics ordinals.
+fn keys() -> RawStore {
+    let raw = RawStore::new(stats_config(), None).expect("keys");
+    for il in 0..2u32 {
+        raw.write_layer_mean_k(0, BLOCK, il, &[-1.0; BLOCK as usize])
+            .expect("mean k block0");
+        raw.write_layer_mean_k(BLOCK, BLOCK, il, &[1.0; BLOCK as usize])
+            .expect("mean k block1");
+    }
+    raw
+}
+
+/// A finite metadata account large enough for the probe accumulator bound.
+fn metadata() -> Storage {
+    Storage::new_ram(1 << 20).expect("metadata account")
+}
+
+fn native_query(q: &[f32], ordinal: u32) -> NativeCurrentLayerQuery {
+    NativeCurrentLayerQuery {
+        data: q.as_ptr() as *const c_void,
+        bytes: q.len() * std::mem::size_of::<f32>(),
+        layer: ordinal,
+        rows: q.len() as u32,
+        query_heads: 1,
+        kv_heads: 1,
+        head_dim: 1,
+        attention_scale: 1.0,
+        scalar: NativeQueryScalar::Float32 as u32,
+        row_stride: 4,
+        head_stride: 4,
+        dimension_stride: 4,
+    }
+}
+
+/// Host reference stand-in for the GPU qualified Mean-K scorer: page mass = sum
+/// over the sliced Query rows of exp(q · mean_k · scale). Asserts the frozen frame
+/// shape and forces masked blocks to exactly 0.
+fn reference_scorer(
+    mean_k: Vec<f32>,
+) -> impl FnMut(&NativeCurrentLayerQuery, &QueryScoreFrame<'_>) -> Result<Vec<f64>, KvMemError> {
+    move |tile, frame| {
+        assert_eq!(frame.starts, &[0u64, 4], "frozen frame starts");
+        assert_eq!(frame.counts, &[4u32, 4], "frozen frame counts");
+        assert_eq!(frame.score_mask, &[1u8, 1], "frozen frame score mask");
+        assert_eq!(frame.accepted_through, 8, "frozen frame frontier");
+        let mut operands = Vec::with_capacity(tile.rows as usize);
+        for r in 0..tile.rows as usize {
+            let q = unsafe {
+                let p = (tile.data as *const u8).add(r * tile.row_stride) as *const f32;
+                *p
+            };
+            operands.push(q as f64);
+        }
+        let mut scores = Vec::with_capacity(frame.starts.len());
+        for i in 0..frame.starts.len() {
+            if frame.score_mask[i] == 0 {
+                scores.push(0.0);
+                continue;
+            }
+            let mut mass = 0.0f64;
+            for &q in &operands {
+                mass += (q * mean_k[i] as f64 * tile.attention_scale as f64).exp();
+            }
+            scores.push(mass);
+        }
+        Ok(scores)
+    }
+}
+
+/// Append one Query tile token-major: every target layer in geometry order. Both
+/// layers carry the same aligned Q (favor block1) so the global L-layer average
+/// still picks block1 — proving the reduction averages layers, not picks per-layer.
+fn append_tile(probe: &ProbeSelection, id: &LayerwiseIdentity, begin: u64, q: &[f32]) {
+    for ordinal in 0..2u32 {
+        let tile = native_query(q, ordinal);
+        probe
+            .append_native(id, begin, &tile, reference_scorer(vec![-1.0, 1.0]))
+            .expect("append_native");
+    }
+}
+
+fn admit(revision: MemoryStamp) -> (ProbeSelection, Storage, KvStore, RawStore) {
+    let meta = metadata();
+    let pol = policy();
+    let key = keys();
+    let id = identity();
+    let bound = ProbeSelection::metadata_bound(&pol, 2).expect("metadata bound");
+    assert!(bound > 0, "probe metadata bound must be positive");
+    let probe = ProbeSelection::new(&id, &pol, &key, &targets(), move || revision, &meta, &[])
+        .expect("probe create");
+    (probe, meta, pol, key)
+}
+
+#[test]
+fn global_reduction_selection_and_tiling_invariance() {
+    // Both target layers favor block1 (mean_k +1). The global average picks block1
+    // for every tiling of the query span [9, 11), and the accumulated mass is
+    // tiling-invariant (the core averages L exactly once per token row).
+    let mut reference: Option<Vec<f64>> = None;
+    for chunk in [1u32, 2] {
+        let (probe, _meta, _pol, _key) = admit(stamp());
+        assert_eq!(probe.phase(), ProbePhase::Collecting);
+        assert_eq!(probe.scored_rows(), 0);
+
+        let q = [1.0f32; QUERY_ROWS as usize];
+        let mut first = 0u32;
+        while first < QUERY_ROWS {
+            let count = chunk.min(QUERY_ROWS - first);
+            append_tile(
+                &probe,
+                &identity(),
+                9 + first as u64,
+                &q[first as usize..(first + count) as usize],
+            );
+            first += count;
+            if first != QUERY_ROWS {
+                // Token-major coverage incomplete: finish must be Pending.
+                assert!(
+                    probe.finish(&identity()).is_err(),
+                    "finish before full query coverage"
+                );
+                assert_eq!(probe.phase(), ProbePhase::Collecting);
+            }
+        }
+        assert_eq!(probe.scored_rows(), QUERY_ROWS as u64);
+        assert_eq!(
+            probe.next_layer(),
+            0,
+            "layer cursor wraps after each complete tile"
+        );
+
+        probe.finish(&identity()).expect("finish");
+        assert_eq!(probe.phase(), ProbePhase::Complete);
+
+        // Budget 1 block → exactly the aligned block1 (ordinal 1).
+        assert_eq!(probe.selected_count(), 1);
+        assert_eq!(probe.selected_ids(), vec![1u32]);
+        assert_eq!(probe.fixed_count(), 0);
+        assert_eq!(probe.historical_tokens(), BLOCK as u64);
+        assert_eq!(probe.charged_tokens(), BLOCK as u64);
+        assert_eq!(probe.score_count(), 2);
+        let s0 = probe.score(0).expect("score 0");
+        let s1 = probe.score(1).expect("score 1");
+        assert!(s0 >= 0.0 && s1 >= 0.0, "page mass non-negative: {s0} {s1}");
+        assert!(
+            s1 > s0,
+            "aligned block1 must win the global reduction: {s0} {s1}"
+        );
+        assert!(probe.score(2).is_err(), "out-of-range score index");
+
+        // Global L-layer average: 2 layers × 2 query rows × exp(±1), averaged /2.
+        let expect1 = 2.0 * (1.0f64).exp();
+        let expect0 = 2.0 * (-1.0f64).exp();
+        assert!(
+            (s1 - expect1).abs() < 1e-9,
+            "block1 global mass {s1} != {expect1}"
+        );
+        assert!(
+            (s0 - expect0).abs() < 1e-9,
+            "block0 global mass {s0} != {expect0}"
+        );
+
+        match &reference {
+            None => reference = Some(vec![s0, s1]),
+            Some(r) => assert!(
+                (r[0] - s0).abs() < 1e-9 && (r[1] - s1).abs() < 1e-9,
+                "tiling invariant"
+            ),
+        }
+    }
+}
+
+#[test]
+fn metadata_bound_requires_finite_account_and_layers() {
+    let pol = policy();
+    let bound = ProbeSelection::metadata_bound(&pol, 2).expect("bound");
+    assert!(bound > 0);
+    // Zero target layers is rejected fail-closed.
+    assert!(
+        ProbeSelection::metadata_bound(&pol, 0).is_err(),
+        "zero target layers"
+    );
+    // The bound must fit a finite account; an undersized account rejects create.
+    let tiny = Storage::new_ram(1).expect("tiny account");
+    let key = keys();
+    let id = identity();
+    let rev = stamp();
+    assert!(
+        ProbeSelection::new(&id, &pol, &key, &targets(), move || rev, &tiny, &[]).is_err(),
+        "metadata account too small for the probe bound"
+    );
+}
+
+#[test]
+fn fail_closed_revision_identity_and_coverage() {
+    let pol = policy();
+    let key = keys();
+    let id = identity();
+
+    // A source revision that advances after admission aborts at the next boundary.
+    {
+        let meta = metadata();
+        let revision = Rc::new(Cell::new(stamp()));
+        let rev = revision.clone();
+        let probe = ProbeSelection::new(&id, &pol, &key, &targets(), move || rev.get(), &meta, &[])
+            .expect("probe");
+        revision.set({
+            let mut s = stamp();
+            s.history_revision += 1;
+            s
+        });
+        let tile = native_query(&[1.0], 0);
+        assert!(
+            probe
+                .append_native(&id, 9, &tile, reference_scorer(vec![-1.0, 1.0]))
+                .is_err(),
+            "stale source revision"
+        );
+        assert_eq!(probe.phase(), ProbePhase::Aborted);
+    }
+
+    // A foreign request id is Stale; an out-of-order layer is InvalidPlan.
+    {
+        let (probe, _meta, _pol, _key) = admit(stamp());
+        let mut foreign = id;
+        foreign.request += 1;
+        let tile = native_query(&[1.0], 0);
+        assert!(
+            probe
+                .append_native(&foreign, 9, &tile, reference_scorer(vec![-1.0, 1.0]))
+                .is_err(),
+            "foreign identity"
+        );
+        // Layer 1 before layer 0 breaks token-major target coverage.
+        let wrong = native_query(&[1.0], 1);
+        assert!(
+            probe
+                .append_native(&id, 9, &wrong, reference_scorer(vec![-1.0, 1.0]))
+                .is_err(),
+            "out-of-order target layer"
+        );
+        assert_eq!(
+            probe.phase(),
+            ProbePhase::Collecting,
+            "validation must not abort"
+        );
+        probe.abort();
+        assert_eq!(probe.phase(), ProbePhase::Aborted);
+    }
+
+    // A wrong geometry (head_dim mismatch) is rejected at create.
+    {
+        let meta = metadata();
+        let rev = stamp();
+        let mut bad = targets();
+        bad[1].head_dim = 2; // kv_heads*head_dim != n_embd_k
+        assert!(
+            ProbeSelection::new(&id, &pol, &key, &bad, move || rev, &meta, &[]).is_err(),
+            "geometry differs from upstream LTHD"
+        );
+    }
+}
+
+#[test]
+fn native_scorer_fail_closed() {
+    let (probe, _meta, _pol, _key) = admit(stamp());
+    let id = identity();
+    let tile = native_query(&[1.0, 1.0], 0);
+    // A failing scorer propagates as HK_ERR (never unwinds across the C ABI). The
+    // core accumulator does NOT auto-abort — the private-probe DRIVER owns the
+    // abort/rollback envelope (mirrors ninfer native_layerwise_probe's try/catch
+    // calling selection.abort()), so the phase stays Collecting until the driver
+    // aborts. This is the contract H2's run_private_probe must honor.
+    let mut failing = |_: &NativeCurrentLayerQuery, _: &QueryScoreFrame<'_>| {
+        Err(KvMemError("scorer failed".into()))
+    };
+    assert!(
+        probe.append_native(&id, 9, &tile, &mut failing).is_err(),
+        "scorer failure"
+    );
+    assert_eq!(
+        probe.phase(),
+        ProbePhase::Collecting,
+        "core leaves abort to the driver"
+    );
+    // The driver aborts fail-closed; a closed probe rejects further projection.
+    probe.abort();
+    assert_eq!(probe.phase(), ProbePhase::Aborted);
+    assert!(
+        probe
+            .append_native(&id, 9, &tile, reference_scorer(vec![-1.0, 1.0]))
+            .is_err(),
+        "closed"
+    );
+}
