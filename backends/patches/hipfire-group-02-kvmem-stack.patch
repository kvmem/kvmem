index 000000000..3e7f6ecaa
--- /dev/null
+++ b/crates/hipfire-arch-qwen35/src/kvmem_ctl/prefix.rs
@@ -0,0 +1,646 @@
+// SPDX-License-Identifier: Apache-2.0
+// Copyright (c) 2026 Kaden Schutt
+// hipfire — see LICENSE and NOTICE in the project root.
+
+use super::*;
+
+impl KvMemCtl {
+    // ── P4.3 KVMem-native prefix sharing (host model) ─────────────────────
+    //
+    // ninfer-aligned: freeze an IMMUTABLE canonical archive at a page-aligned
+    // frontier, then reuse it across sessions via provenance-validated forks.
+    // The GPU page PIN (seal + cache refs + share_published_pages) and the
+    // DeltaNet checkpoint restore are engine-side (serve admit); these methods
+    // own the host store half. Every path is additive: with PREFIX_PIN off the
+    // engine never calls them and the catalog stays empty (byte-neutral).
+
+    /// Freeze slot `slot`'s prefix `[0, frontier)` into an immutable canonical
+    /// archive and catalog it. `frontier` must be page-aligned and `<= fed`;
+    /// `prefix_tokens` is the FULL token proof (must equal the fed prefix).
+    /// Returns `(checkpoint id, displaced entries, deduped)` — the engine must
+    /// release the displaced entries' GPU cache refs, and on `deduped` it must
+    /// NOT take new refs (the existing entry already pins the same pages).
+    /// Fail-closed before any mutation of the slot (the fork seals the source's
+    /// packed records but never changes their bytes; the source keeps appending
+    /// to fresh blocks).
+    pub fn freeze_prefix(
+        &mut self,
+        slot: usize,
+        frontier: u32,
+        prefix_tokens: &[u32],
+    ) -> Result<(u64, Vec<PrefixCheckpoint>, bool), String> {
+        self.freeze_prefix_with_media(slot, frontier, prefix_tokens, None, Vec::new())
+    }
+
+    /// G7: freeze with the image-turn media identity (digest + image token
+    /// spans) recorded in the checkpoint and the persistent pack meta. The
+    /// engine passes the session's sticky digest on image turns; text-only
+    /// freezes pass `(None, vec![])`.
+    pub fn freeze_prefix_with_media(
+        &mut self,
+        slot: usize,
+        frontier: u32,
+        prefix_tokens: &[u32],
+        media_digest: Option<u64>,
+        media_spans: Vec<(u32, u32)>,
+    ) -> Result<(u64, Vec<PrefixCheckpoint>, bool), String> {
+        let st = self
+            .slots
+            .get(slot)
+            .ok_or_else(|| format!("kvmem: freeze_prefix slot {slot} out of range"))?;
+        if frontier == 0 || frontier % PREFIX_PAGE_TOKENS != 0 {
+            return Err(format!(
+                "kvmem freeze_prefix: frontier {frontier} must be a positive multiple of \
+                 {PREFIX_PAGE_TOKENS} (GPU sharing is page-granular)"
+            ));
+        }
+        if frontier > st.fed {
+            return Err(format!(
+                "kvmem freeze_prefix: frontier {frontier} exceeds fed {}",
+                st.fed
+            ));
+        }
+        if prefix_tokens.len() != frontier as usize {
+            return Err(format!(
+                "kvmem freeze_prefix: token proof len {} != frontier {frontier}",
+                prefix_tokens.len()
+            ));
+        }
+        let layout_id = layout_fingerprint(&self.raw_cfg);
+        let fingerprint = hipfire_runtime::checkpoint_pool::prefix_fingerprint(prefix_tokens);
+        // 期2.3: the question that owns this checkpoint (import identity).
+        let original_query = st.request_query;
+        // Dedup BEFORE forking/sealing: an identical frontier+proof already
+        // pins the same pages; a second archive would double the cache refs.
+        // The catalog stays token-keyed; the media digest gates serving and
+        // scopes the pack path and the recurrent-state key.
+        if let Some(existing) = self.prefix_catalog.find_exact(frontier, fingerprint) {
+            return Ok((existing, Vec::new(), true));
+        }
+        // Canonical archive: packed records become sealed shared sources;
+        // mean-K stays private to the archive; the branch is truncated to the
+        // frontier (core fork_prefix contract). The source store keeps its
+        // own mutable statistics for blocks beyond the frontier.
+        let mut canonical = st
+            .raw
+            .fork_prefix(frontier)
+            .map_err(|e| format!("kvmem freeze_prefix fork: {e}"))?;
+        let blocks = frontier / KV_BLOCK_TOKENS as u32;
+        let mean_tail = st
+            .raw
+            .mean_checkpoint(frontier)
+            .map_err(|e| format!("kvmem freeze_prefix mean checkpoint: {e}"))?;
+        // 期3 G4: the canonical side is also the core `KvSnapshot` over the
+        // sealed packed records of the canonical's account (block-major,
+        // layer-major, K then V). The snapshot is the catalog-visible immutable
+        // object the G2/G3 directories share. Host-only fixtures without a
+        // packed archive carry no snapshot (missing records are not an error).
+        // 期3 G3 follow-up (nInfer origin inheritance): reuse the SealedKvBlock
+        // objects of this slot's previous checkpoint when the record storage
+        // identity matches (same session, shared sealed records).
+        let previous_snapshot = st
+            .last_freeze_id
+            .and_then(|pid| self.prefix_catalog.get(pid))
+            .and_then(|c| c.kv_snapshot.as_ref());
+        let kv_snapshot = if canonical.has_packed(blocks) {
+            let snapshot = canonical
+                .capture_snapshot(blocks, previous_snapshot)
+                .map_err(|e| format!("kvmem freeze_prefix snapshot: {e}"))?;
+            if !snapshot.covers_packed(blocks, self.n_record_layers as u32) {
+                return Err(format!(
+                    "kvmem freeze_prefix snapshot: incomplete {blocks}×{} packed grid",
+                    self.n_record_layers
+                ));
+            }
+            Some(snapshot)
+        } else {
+            None
+        };
+        let id = self.prefix_catalog.mint_id();
+        let mut entry = PrefixCheckpoint::new(
+            id,
+            frontier,
+            prefix_tokens.to_vec(),
+            mean_tail,
+            st.lw_incarnation,
+            layout_id,
+            canonical,
+        );
+        entry.original_query = original_query;
+        entry.group = st.convo_group;
+        entry.media_digest = media_digest;
+        entry.media_spans = media_spans.clone();
+        if self.content_groups > 0 && self.diagnostics.trace {
+            eprintln!(
+                "[kvmem-content] freeze slot={slot} frontier={frontier} group={} entries={}",
+                st.convo_group,
+                self.prefix_catalog.len()
+            );
+        }
+        entry.kv_snapshot = kv_snapshot;
+        // 期3 G3 P1.1: persist the canonical prefix as a pack file. Failure
+        // never blocks the freeze (persistence is an optional tier); the byte
+        // cap prunes the oldest packs.
+        if let Some(dir) = self.cold_dir.clone() {
+            let meta = ContentPackMeta {
+                version: ContentPackMeta::VERSION,
+                layout_id,
+                frontier,
+                tokens: entry.prefix_tokens.clone(),
+                mean_tail: entry.mean_tail.clone(),
+                group: entry.group,
+                original_query: entry.original_query,
+                n_record_layers: self.n_record_layers as u32,
+                media_digest: entry.media_digest,
+                media_spans: entry.media_spans.clone(),
+            };
+            // G7: the file name carries the media identity. Two images with
+            // the same token stream share the token fingerprint; without the
+            // digest suffix their packs would overwrite each other.
+            let media_tag = match media_digest {
+                None => String::new(),
+                Some(d) => format!("-m{d:016x}"),
+            };
+            let path = dir.join(format!(
+                "p{layout_id:016x}-{frontier:08}-{fingerprint:016x}{media_tag}.hkpack"
+            ));
+            // Idempotent publish: a previous freeze of this exact token proof
+            // already left a complete pack + recurrent sidecar pair. Reusing
+            // it avoids rewriting ~pack + DN bytes and guarantees the pair
+            // stays coherent (the sidecar is only skipped with its pack).
+            let side = sidecar_path(&path);
+            let complete_pair = self.cold_packs.contains_path(&path)
+                && std::fs::metadata(&path)
+                    .map(|m| m.len() > 0)
+                    .unwrap_or(false)
+                && std::fs::metadata(&side)
+                    .map(|m| m.len() >= SIDECAR_MIN_BYTES)
+                    .unwrap_or(false);
+            let written = if complete_pair {
+                if self.diagnostics.trace {
+                    eprintln!("[kvmem-pack] reuse complete pack+sidecar frontier={frontier}");
+                }
+                Ok(())
+            } else {
+                // A rewrite must never pair a fresh pack with a stale sidecar.
+                let _ = std::fs::remove_file(&side);
+                self.cold_packs.set_sidecar_bytes(&path, 0);
+                meta.encode().and_then(|bytes| {
+                    entry
+                        .canonical()
+                        .write_prefix_pack(blocks, &path, &bytes)
+                        .map_err(|e| e.to_string())
+                })
+            };
+            match written {
+                Ok(()) => {
+                    entry.pack_path = Some(path.clone());
+                    if !self.cold_packs.contains_path(&path) {
+                        let bytes = std::fs::metadata(&path).map(|m| m.len()).unwrap_or(0);
+                        self.cold_packs.insert(ColdPack {
+                            path: path.clone(),
+                            meta,
+                            fingerprint,
+                            bytes,
+                            sidecar_bytes: 0,
+                            draft_bytes: 0,
+                            stamp: 0,
+                        });
+                    }
+                    let removed = self.cold_packs.prune_to(self.cold_bytes);
+                    if !removed.is_empty() && self.diagnostics.trace {
+                        eprintln!(
+                            "[kvmem-pack] pruned {} pack(s), {} bytes retained",
+                            removed.len(),
+                            self.cold_packs.total_bytes()
+                        );
+                    }
+                }
+                Err(e) => eprintln!("[kvmem-pack] write skipped: {e}"),
+            }
+        }
+        // 期3 G3: group-aware publication retires the whole least-recently-used
+        // group before entry trimming; the plain LRU path stays the default.
+        let (inserted, displaced) = if self.content_groups > 0 && st.convo_group != 0 {
+            let (id, displaced, _deduped) = self
+                .prefix_catalog
+                .insert_group_aware(entry, self.content_groups)
+                .map_err(|e| format!("kvmem freeze_prefix catalog: {e}"))?;
+            self.content_retirements_total += displaced.len() as u64;
+            (id, displaced)
+        } else {
+            self.prefix_catalog
+                .insert_displacing(entry)
+                .map_err(|e| format!("kvmem freeze_prefix catalog: {e}"))?
+        };
+        if inserted.is_some() {
+            self.prefix_freezes_total += 1;
+        }
+        let frozen_id = inserted.unwrap_or(id);
+        if let Some(st) = self.slots.get_mut(slot) {
+            st.last_freeze_id = Some(frozen_id);
+        }
+
+        let mut displaced = displaced;
+        if let Some((count, bytes, interval, min_gap)) = self.checkpoint_retention {
+            let pruned = self
+                .prefix_catalog
+                .prune_policy(count, bytes, interval, min_gap);
+            self.prefix_evictions_total += pruned.len() as u64;
+            displaced.extend(pruned);
+        }
+        self.prefix_evictions_total += 0;
+        Ok((inserted.unwrap_or(id), displaced, false))
+    }
+
+    /// Look up the longest cataloged prefix fully proven by `prompt`.
+    /// Returns the checkpoint id (engine then validates + forks).
+    pub fn prefix_lookup(&mut self, prompt: &[u32]) -> Option<u64> {
+        self.prefix_lookup_media(prompt, None)
+    }
+
+    /// G7: media-aware prefix lookup. A checkpoint covering an image span is
+    /// eligible only when the incoming request's media digest matches it.
+    pub fn prefix_lookup_media(&mut self, prompt: &[u32], media: Option<u64>) -> Option<u64> {
+        let layout = layout_fingerprint(&self.raw_cfg);
+        if let Some(hit) = self.prefix_catalog.lookup_media(prompt, layout, media) {
+            self.prefix_catalog_hits_total += 1;
+            self.prefix_hits_total += 1;
+            return Some(hit);
+        }
+        // 期3 G3 P1.1: a cold pack hit loads the payload and publishes a
+        // normal catalog entry; the caller then reuses it through the usual
+        // proof path (restart reuse still needs the DN checkpoint, patch 35).
+        if let Some(index) = self.cold_packs.lookup_media(prompt, layout, media) {
+            let pack = self.cold_packs.packs()[index].clone();
+            match self.load_cold_pack(&pack) {
+                Ok(id) => {
+                    // G7 Stage C: the hot catalog is token-keyed. A pack load
+                    // can dedup into a live entry that belongs to a DIFFERENT
+                    // image (identical `image_pad` token stream). Serving it
+                    // would hand over the other image's KV — stay a miss.
+                    let identity_ok = self
+                        .prefix_catalog
+                        .get(id)
+                        .map(|e| e.media_digest == pack.meta.media_digest)
+                        .unwrap_or(false);
+                    if !identity_ok {
+                        self.cold_pack_misses_total += 1;
+                        eprintln!(
+                            "[kvmem-pack] cold load identity mismatch \
+                             (media digest) — miss"
+                        );
+                        return None;
+                    }
+                    self.cold_pack_hits_total += 1;
+                    self.prefix_hits_total += 1;
+                    if self.diagnostics.trace {
+                        eprintln!(
+                            "[kvmem-pack] cold hit frontier={} path={}",
+                            pack.meta.frontier,
+                            pack.path.display()
+                        );
+                    }
+                    return Some(id);
+                }
+                Err(e) => {
+                    self.cold_pack_misses_total += 1;
+                    eprintln!("[kvmem-pack] cold load failed: {e}");
+                }
+            }
+        }
+        // G7 Stage E probe: distinguish a media-identity refusal from a token
+        // proof miss. The candidate below proves by FULL token equality; only
+        // the image identity gate refused it. Trace-only, read-only.
+        if self.diagnostics.trace {
+            let layout = layout_fingerprint(&self.raw_cfg);
+            let rejected = self
+                .prefix_catalog
+                .probe_media_reject(prompt, layout, media)
+                .or_else(|| self.cold_packs.probe_media_reject(prompt, layout, media));
+            if let Some((frontier, digest)) = rejected {
+                let fmt = |d: Option<u64>| {
+                    d.map(|x| format!("{x:016x}"))
+                        .unwrap_or_else(|| "none".to_string())
+                };
+                eprintln!(
+                    "[kvmem-media] lookup miss: token candidate frontier={frontier} \
+                     digest={} request digest={} -> media identity gate",
+                    fmt(digest),
+                    fmt(media)
+                );
+            }
+        }
+        self.prefix_misses_total += 1;
+        None
+    }
+
+    /// Drain catalog entries displaced by a cold pack load so the engine can
+    /// release their GPU cache refs.
+    pub fn take_cold_displaced(&mut self) -> Vec<PrefixCheckpoint> {
+        std::mem::take(&mut self.cold_displaced)
+    }
+
+    /// Load one pack file into a fresh store (content account when enabled),
+    /// prove the metadata is unchanged, capture the KvSnapshot and publish the
+    /// entry into the hot catalog.
+    fn load_cold_pack(&mut self, pack: &ColdPack) -> Result<u64, String> {
+        let layout = layout_fingerprint(&self.raw_cfg);
+        if pack.meta.layout_id != layout
+            || pack.meta.n_record_layers as usize != self.n_record_layers
+            || pack.meta.frontier == 0
+            || pack.meta.frontier % KV_BLOCK_TOKENS as u32 != 0
+        {
+            return Err("pack geometry/layout mismatch".to_string());
+        }
+        let store = RawStore::new(self.raw_cfg, Some(&self.storage))
+            .map_err(|e| format!("pack store: {e}"))?;
+        let meta_bytes = store
+            .read_prefix_pack(&pack.path)
+            .map_err(|e| format!("pack read: {e}"))?;
+        let meta = ContentPackMeta::decode(&meta_bytes).map_err(|e| format!("pack meta: {e}"))?;
+        if meta.tokens != pack.meta.tokens || meta.frontier != pack.meta.frontier {
+            return Err("pack metadata changed since scan".to_string());
+        }
+        let blocks = meta.frontier / KV_BLOCK_TOKENS as u32;
+        let kv_snapshot = if store.has_packed(blocks) {
+            let snap = store
+                .capture_snapshot(blocks, None)
+                .map_err(|e| format!("pack snapshot: {e}"))?;
+            if !snap.covers_packed(blocks, self.n_record_layers as u32) {
+                return Err("pack snapshot grid incomplete".to_string());
+            }
+            Some(snap)
+        } else {
+            None
+        };
+        let id = self.prefix_catalog.mint_id();
+        let mut entry = PrefixCheckpoint::new(
+            id,
+            meta.frontier,
+            meta.tokens.clone(),
+            meta.mean_tail.clone(),
+            0,
+            layout,
+            store,
+        );
+        entry.original_query = meta.original_query;
+        entry.group = meta.group;
+        entry.media_digest = meta.media_digest;
+        entry.media_spans = meta.media_spans.clone();
+        entry.kv_snapshot = kv_snapshot;
+        entry.pack_path = Some(pack.path.clone());
+        let (inserted, displaced) = if self.content_groups > 0 && entry.group != 0 {
+            let (id, displaced, _deduped) = self
+                .prefix_catalog
+                .insert_group_aware(entry, self.content_groups)
+                .map_err(|e| format!("pack catalog: {e}"))?;
+            self.content_retirements_total += displaced.len() as u64;
+            (id, displaced)
+        } else {
+            self.prefix_catalog
+                .insert_displacing(entry)
+                .map_err(|e| format!("pack catalog: {e}"))?
+        };
+        self.cold_displaced.extend(displaced);
+        Ok(inserted.unwrap_or(id))
+    }
+
+    /// Look up the longest cataloged prefix fully proven by `prompt` whose
+    /// frontier is at most `max_frontier` (import narrowing fallback).
+    pub fn prefix_lookup_capped(&mut self, prompt: &[u32], max_frontier: u32) -> Option<u64> {
+        self.prefix_lookup_capped_media(prompt, max_frontier, None)
+    }
+
+    /// G7: media-aware capped lookup for import narrowing.
+    pub fn prefix_lookup_capped_media(
+        &mut self,
+        prompt: &[u32],
+        max_frontier: u32,
+        media: Option<u64>,
+    ) -> Option<u64> {
+        let layout = layout_fingerprint(&self.raw_cfg);
+        let hit = self
+            .prefix_catalog
+            .lookup_at_most_media(prompt, layout, max_frontier, media);
+        if hit.is_some() {
+            self.prefix_catalog_hits_total += 1;
+            self.prefix_hits_total += 1;
+        } else {
+            // G7 Stage E probe: a capped lookup narrowed to `max_frontier` can
+            // miss on the media identity alone; name the refused candidate.
+            if self.diagnostics.trace {
+                if let Some((frontier, digest)) = self
+                    .prefix_catalog
+                    .probe_media_reject(prompt, layout, media)
+                {
+                    let fmt = |d: Option<u64>| {
+                        d.map(|x| format!("{x:016x}"))
+                            .unwrap_or_else(|| "none".to_string())
+                    };
+                    eprintln!(
+                        "[kvmem-media] capped lookup miss: token candidate frontier={frontier} \
+                         digest={} request digest={} cap={max_frontier} -> media identity gate",
+                        fmt(digest),
+                        fmt(media)
+                    );
+                }
+            }
+            self.prefix_misses_total += 1;
+        }
+        hit
+    }
+
+    /// Read a cataloged checkpoint (engine attaches GPU pages / reads the
+    /// frontier + mean_tail for the DeltaNet restore pairing).
+    pub fn prefix_checkpoint(&self, id: u64) -> Option<&PrefixCheckpoint> {
+        self.prefix_catalog.get(id)
+    }
+
+    /// 期4: DFlash2 draft image instrumentation (captures / restore hits /
+    /// misses). Pure bookkeeping — never read back into selection/residency.
+    pub fn note_draft_image_capture(&mut self) {
+        self.draft_images_total += 1;
+    }
+
+    pub fn note_draft_image_hit(&mut self) {
+        self.draft_image_hits_total += 1;
+    }
+
+    pub fn note_draft_image_miss(&mut self) {
+        self.draft_image_misses_total += 1;
+    }
+
+    /// G3 follow-up: a reuse conversion proceeded without pinned pages and
+    /// restored them from the sealed archive (demoted or restart entry).
+    pub fn note_prefix_restore_hit(&mut self) {
+        self.prefix_restore_hits_total += 1;
+    }
+
+    /// Mutable access (engine attaches `gpu_pages` after sealing + cache refs).
+    pub fn prefix_checkpoint_mut(&mut self, id: u64) -> Option<&mut PrefixCheckpoint> {
+        self.prefix_catalog.get_mut(id)
+    }
+
+    /// Remove a checkpoint, returning it so the engine can release its GPU
+    /// cache refs (session close / explicit release).
+    pub fn release_prefix(&mut self, id: u64) -> Option<PrefixCheckpoint> {
+        self.prefix_catalog.remove(id)
+    }
+
+    /// Pop the LRU checkpoint (admission pressure reclaim); the engine
+    /// releases its GPU cache refs. `None` when the catalog is empty.
+    pub fn pop_lru_prefix(&mut self) -> Option<PrefixCheckpoint> {
+        let popped = self.prefix_catalog.pop_lru();
+        if popped.is_some() {
+            self.prefix_evictions_total += 1;
+        }
+        popped
+    }
+
+    /// G3 follow-up: admission-pressure residency demotion. Drops the LRU
+    /// checkpoint's pinned pages but KEEPS its catalog entry (nInfer: the
+    /// directory and GPU residency are separate), so a later reuse restores
+    /// the pages from the sealed archive under Layerwise. Returns the entry id
+    /// and the released page indices, or `None` when no entry pins any page.
+    /// Legacy keeps [`Self::pop_lru_prefix`] (its reuse needs resident pages).
+    pub fn demote_lru_prefix(&mut self) -> Option<(u64, Vec<u32>)> {
+        let demoted = self.prefix_catalog.demote_lru();
+        if demoted.is_some() {
+            self.prefix_demotions_total += 1;
+        }
+        demoted
+    }
+
+    /// Record the DFlash draft image written beside a pack. The whole cache
+    /// directory (packs + DN + draft sidecars) is re-pruned under the same cap.
+    /// When the pack disappeared meanwhile, drop the orphan draft file.
+    pub fn note_draft_sidecar(&mut self, path: &std::path::Path, bytes: u64) {
+        if !self.cold_packs.set_draft_bytes(path, bytes) {
+            let draft = crate::kvmem_prefix::draft_sidecar_path(path);
+            let _ = std::fs::remove_file(draft);
+            return;
+        }
+        self.draft_sidecars_total += 1;
+        self.draft_sidecar_bytes = self.draft_sidecar_bytes.saturating_add(bytes);
+        let removed = self.cold_packs.prune_to(self.cold_bytes);
+        if !removed.is_empty() && self.diagnostics.trace {
+            eprintln!(
+                "[kvmem-pack] pruned {} pack(s), {} disk bytes retained",
+                removed.len(),
+                self.cold_packs.disk_bytes()
+            );
+        }
+    }
+
+    /// Live observability snapshot (`/metrics` via `EngineStats.kvmem`).
+    /// Cheap integer reads from the host stores: no device work, no
+    /// allocation, and no path reads it back into selection/residency, so it
+    /// cannot change KV bytes.
+    pub fn stats(&self) -> KvMemStats {
+        let mut payload_bytes = 0u64;
+        let mut blocks = 0u64;
+        let mut tokens = 0u64;
+        for st in &self.slots {
+            payload_bytes += st.raw.payload_bytes();
+            blocks += u64::from(st.kv.block_count());
+            tokens += u64::from(st.kv.total_tokens());
+        }
+        let page_bytes = (self.k_page_bytes + self.v_page_bytes) as u64;
+        let prefix_host = self.prefix_catalog.host_accounting();
+        KvMemStats {
+            enabled: true,
+            layerwise: self.strategy.is_layerwise(),
+            trunk_managed: true,
+            mtp_head_managed: self.head_plane_enabled(),
+            dn_state_managed: false,
+            dflash_managed: false,
+            dn_state_bytes: 0,
+            dn_state_slots: 0,
+            dn_checkpoints: 0,
+            dn_checkpoint_bytes: 0,
+            media_pins: true,
+            host_charged_bytes: self.storage.charged_bytes(),
+            disk_bytes: self.storage.disk_bytes(),
+            payload_bytes,
+            blocks,
+            tokens,
+            spill_pages: self.spill_pages_total,
+            restore_pages: self.restore_pages_total,
+            spill_bytes: self.spill_pages_total.saturating_mul(page_bytes),
+            restore_bytes: self.restore_pages_total.saturating_mul(page_bytes),
+            prefix_entries: self.prefix_catalog.len() as u64,
+            prefix_pinned_pages: self.prefix_catalog.pinned_pages(),
+            prefix_host_bytes: prefix_host.unique,
+            prefix_host_bytes_gross: prefix_host.gross,
+            prefix_freezes: self.prefix_freezes_total,
+            prefix_hits: self.prefix_hits_total,
+            prefix_misses: self.prefix_misses_total,
+            prefix_evictions: self.prefix_evictions_total,
+            prefix_demotions: self.prefix_demotions_total,
+            prefix_catalog_hits: self.prefix_catalog_hits_total,
+            prefix_restore_hits: self.prefix_restore_hits_total,
+            content_groups: self.prefix_catalog.group_count() as u64,
+            content_retirements: self.content_retirements_total,
+            // Single tier: packs are files, so there is no second account.
+            content_cache_bytes: 0,
+            content_cache_disk_bytes: 0,
+            content_packs: self.cold_packs.len() as u64,
+            content_pack_bytes: self.cold_packs.total_bytes(),
+            cold_pack_hits: self.cold_pack_hits_total,
+            cold_pack_misses: self.cold_pack_misses_total,
+            draft_images: self.draft_images_total,
+            draft_image_hits: self.draft_image_hits_total,
+            draft_image_misses: self.draft_image_misses_total,
+            draft_sidecars: self.draft_sidecars_total,
+            draft_sidecar_bytes: self.draft_sidecar_bytes,
+        }
+    }
+
+    /// 期2.3: the query span stored with a cataloged checkpoint (import
+    /// identity). `None` for checkpoints frozen before a proven span existed.
+    pub fn prefix_original_query(&self, id: u64) -> Option<(u64, u64)> {
+        self.prefix_catalog.get(id).and_then(|c| c.original_query)
+    }
+
+    /// 期3 G3 P1.1: the pack file backing a cataloged checkpoint (the DN
+    /// sidecar lives beside it as `<pack>.dn`). Returns `None` once the pack
+    /// was pruned from the disk index, so callers never create an orphan
+    /// sidecar for a vanished pack.
+    pub fn prefix_pack_path(&self, id: u64) -> Option<std::path::PathBuf> {
+        let path = self
+            .prefix_catalog
+            .get(id)
+            .and_then(|c| c.pack_path.clone())?;
+        self.cold_packs.contains_path(&path).then_some(path)
+    }
+
+    /// A complete reusable pack + recurrent sidecar pair already exists for
+    /// `id` (post-freeze). The engine skips the DN export when true.
+    pub fn prefix_sidecar_ready(&self, id: u64) -> bool {
+        let Some(pack) = self.prefix_pack_path(id) else {
+            return false;
+        };
+        std::fs::metadata(sidecar_path(&pack))
+            .map(|m| m.len() >= SIDECAR_MIN_BYTES)
+            .unwrap_or(false)
+    }
+
+    /// Record the recurrent sidecar written beside a pack. The whole cache
+    /// directory (packs + sidecars) is re-pruned under `HIPFIRE_KVMEM_CACHE_BYTES`.
+    /// When the pack disappeared meanwhile, drop the orphan sidecar instead.
+    pub fn note_pack_sidecar(&mut self, path: &std::path::Path, bytes: u64) {
+        if !self.cold_packs.set_sidecar_bytes(path, bytes) {
+            let _ = std::fs::remove_file(sidecar_path(path));
+            return;
+        }
+        let removed = self.cold_packs.prune_to(self.cold_bytes);
+        if !removed.is_empty() && self.diagnostics.trace {
+            eprintln!(
+                "[kvmem-pack] pruned {} pack(s), {} disk bytes retained",
+                removed.len(),
+                self.cold_packs.disk_bytes()
+            );
+        }
+    }
+}
diff --git a/crates/hipfire-arch-qwen35/src/kvmem_ctl/slot.rs b/crates/hipfire-arch-qwen35/src/kvmem_ctl/slot.rs
new file mode 100644
index 000000000..8f730122b
--- /dev/null
+++ b/crates/hipfire-arch-qwen35/src/kvmem_ctl/slot.rs
@@ -0,0 +1,364 @@
+// SPDX-License-Identifier: Apache-2.0
+// Copyright (c) 2026 Kaden Schutt
+// hipfire — see LICENSE and NOTICE in the project root.
+
+use super::*;
+
+impl KvMemCtl {
+    /// Arm the one-shot Layerwise selection budget from the import admission
+    /// (ninfer `selection_budget`). The next Layerwise carrier selection takes
+    /// it; later selections return to the configured residential budget.
+    pub fn set_layerwise_import_blocks(&self, slot: usize, blocks: u32) -> Result<(), String> {
+        let st = self
+            .slots
+            .get(slot)
+            .ok_or_else(|| format!("kvmem: import budget slot {slot} out of range"))?;
+        st.lw_import_blocks.set(Some(blocks.max(1)));
+        Ok(())
+    }
+
+    /// Consume the one-shot import selection budget (first Layerwise selection
+    /// after a fenced import). `None` for every ordinary selection.
+    pub fn take_layerwise_import_blocks(&self, slot: usize) -> Option<u32> {
+        self.slots
+            .get(slot)
+            .and_then(|st| st.lw_import_blocks.take())
+    }
+
+    /// P2.2a fenced-import admission (ninfer `prepare_import_start`): build the
+    /// pure window/import policy from the restored exact prefix. Pure host
+    /// arithmetic; it touches no catalog, device or selection state.
+    pub fn import_window(
+        &self,
+        prompt_end: u64,
+        output_tokens: u64,
+        frontier: u32,
+        query: Option<(u64, u64)>,
+        previous_query: Option<(u64, u64)>,
+    ) -> Result<ImportDecision, String> {
+        // ninfer `state.visible_tokens` is the native extent at request start;
+        // hipfire's Layerwise driver materializes a compact view of at most the
+        // resident budget B, while the logical history may be longer.
+        let visible = (frontier as u64).min((self.budget_blocks as u64) * KV_BLOCK_TOKENS as u64);
+        layerwise_import_decision(
+            prompt_end,
+            output_tokens,
+            self.window_capacity_tokens(),
+            self.gen_reserve,
+            frontier,
+            visible,
+            query,
+            previous_query,
+            true,
+        )
+    }
+
+    /// Drop the slot's host state. Called when a fresh session takes the slot
+    /// and lazily when a closed slot is swept at step start.
+    pub fn reset_slot(&mut self, slot: usize) -> Result<(), String> {
+        if slot >= self.slots.len() {
+            return Err(format!("kvmem: reset_slot slot {slot} out of range"));
+        }
+        let raw = RawStore::new(self.raw_cfg, Some(&self.storage))
+            .map_err(|e| format!("kvmem raw store: {e}"))?;
+        let kv = KvStore::new(&self.kv_cfg).map_err(|e| format!("kvmem store: {e}"))?;
+        // A fresh store starts at the configured select_budget; re-apply the
+        // watermark keep target so a reset slot keeps the same hysteresis band.
+        if let Some((_, keep)) = self.watermark {
+            kv.set_runtime_select_budget((keep * KV_BLOCK_TOKENS) as u32)
+                .map_err(|e| format!("kvmem watermark select budget: {e}"))?;
+        }
+        // A fresh session bumps the layerwise incarnation so re-bootstrapped
+        // canonical stamps never alias the previous session's (design §3.9g).
+        let lw_incarnation = self.slots[slot].lw_incarnation + 1;
+        self.slots[slot] = self.fresh_slot_state(raw, kv, 0, 0, lw_incarnation);
+        Ok(())
+    }
+
+    /// Build a fresh session's slot state around the given stores. Shared by
+    /// [`Self::reset_slot`] (cold session, fed 0) and [`Self::fork_prefix_into`]
+    /// (P4.3 reused prefix, fed = frontier) so a reused prefix never inherits
+    /// stale selection / pressure / head state — the field initialization is
+    /// identical by construction.
+    pub(super) fn fresh_slot_state(
+        &self,
+        raw: RawStore,
+        kv: KvStore,
+        fed: u32,
+        turn_start: u32,
+        lw_incarnation: u64,
+    ) -> SlotState {
+        SlotState {
+            raw,
+            kv,
+            last_select_full: 0,
+            fed,
+            turn_start,
+            first_decode_done: false,
+            q_ring: vec![
+                0f32;
+                if self.query_span > 1 {
+                    self.n_fa_layers * self.query_span * self.q_width
+                } else {
+                    0
+                }
+            ],
+            q_ring_len: 0,
+            q_ring_cursor: 0,
+            lw_incarnation,
+            lw_seq: 0,
+            // Decision A (§3.10): a fresh session drops the pressure owner and
+            // its keep-set. The next admitted query lazily reconstructs the
+            // owner under the bumped incarnation, so accepted mass / selected
+            // pages never alias the previous session. Legacy: both stay empty.
+            lw_pressure: None,
+            lw_output_pressure: None,
+            lw_keep: Vec::new(),
+            lw_query_due: false,
+            request_query: None,
+            last_query: None,
+            convo_group: 0,
+            last_freeze_id: None,
+            lw_import_blocks: Cell::new(None),
+            lw_pending_output: None,
+            // P4.1② G3: a fresh session drops the head resident map and its
+            // per-Query binding, mirroring the trunk pressure owners. The next
+            // admitted MTP verify lazily reconstructs the map under the bumped
+            // incarnation. Legacy / AR-only: both stay None (byte-neutral).
+            lw_head: None,
+            lw_aux_selection: None,
+        }
+    }
+
+    /// P4.3 fed coordination: truncate slot `slot`'s host store to a
+    /// BLOCK-ALIGNED `frontier`. hipfire feeds mean-K as running sums only
+    /// (`add_mean_f32` keeps no raw rows), so a mid-block partial tail cannot
+    /// be reconstructed — the sum is irreversible. Block-aligned truncation
+    /// drops whole blocks and keeps every retained mean exact; a mid-block
+    /// reuse point refuses here and falls back to the cold rebuild (the
+    /// freeze granularity is page-aligned anyway, so restorable checkpoints
+    /// only ever exist at block-aligned frontiers).
+    /// The caller MUST have already restored the DeltaNet recurrent state to
+    /// the same frontier (the host store cannot rewind recurrent state — a
+    /// truncated KV paired with a stale DN state silently corrupts the
+    /// suffix). Legacy-only: Layerwise canonical views refuse truncation
+    /// until H4 wires the archive provenance.
+    pub fn truncate_slot(&mut self, slot: usize, frontier: u32) -> Result<(), String> {
+        if self.strategy.is_layerwise() {
+            return Err(
+                "kvmem truncate_slot: Layerwise canonical views refuse truncation (H4)".to_string(),
+            );
+        }
+        if frontier % KV_BLOCK_TOKENS as u32 != 0 {
+            return Err(format!(
+                "kvmem truncate_slot: frontier {frontier} is not block-aligned \
+                 (sum-only mean-K cannot reconstruct a partial tail)"
+            ));
+        }
+        let st = self
+            .slots
+            .get_mut(slot)
+            .ok_or_else(|| format!("kvmem: truncate_slot slot {slot} out of range"))?;
+        if frontier > st.fed {
+            return Err(format!(
+                "kvmem truncate_slot: frontier {frontier} exceeds fed {}",
+                st.fed
+            ));
+        }
+        if frontier == st.fed {
+            return Ok(());
+        }
+        st.raw
+            .truncate_to(frontier)
+            .map_err(|e| format!("kvmem truncate_slot raw: {e}"))?;
+        st.kv
+            .truncate_to(frontier)
+            .map_err(|e| format!("kvmem truncate_slot kv: {e}"))?;
+        st.fed = frontier;
+        // The truncated store is a new selection baseline: force a fresh
+        // decision and drop the previous request's Q span.
+        st.last_select_full = 0;
+        st.first_decode_done = false;
+        st.q_ring_len = 0;
+        st.q_ring_cursor = 0;
+        Ok(())
+    }
+
+    /// Reuse checkpoint `id` into `dst_slot`: validate the FULL provenance
+    /// (geometry + fingerprint + token proof) BEFORE any mutation, then fork
+    /// the canonical archive into a fresh branch (shared sealed packed KV,
+    /// branch-private mean-K), restore the partial-tail mean sum, and rebuild
+    /// the slot state at `fed = frontier` (incarnation bumped, all selection /
+    /// pressure / head state cleared — identical to a cold reset except the
+    /// reused prefix). Returns the frontier the suffix prefill starts from.
+    pub fn fork_prefix_into(
+        &mut self,
+        dst_slot: usize,
+        id: u64,
+        prompt: &[u32],
+    ) -> Result<u32, String> {
+        if dst_slot >= self.slots.len() {
+            return Err(format!(
+                "kvmem: fork_prefix_into slot {dst_slot} out of range"
+            ));
+        }
+        let ckpt = self
+            .prefix_catalog
+            .get(id)
+            .ok_or_else(|| format!("kvmem fork_prefix_into: checkpoint {id} not found"))?;
+        ckpt.validate_reuse(prompt, layout_fingerprint(&self.raw_cfg))
+            .map_err(|e| format!("kvmem fork_prefix_into: {e}"))?;
+        let frontier = ckpt.frontier;
+        // Single tier: every canonical lives in the session account, so reuse
+        // is always the zero-copy sealed-record fork.
+        let branch = ckpt
+            .canonical()
+            .fork_prefix(frontier)
+            .map_err(|e| format!("kvmem fork_prefix_into fork: {e}"))?;
+        if let Some(tail) = ckpt.mean_tail.as_ref() {
+            branch
+                .restore_mean_checkpoint(frontier, tail)
+                .map_err(|e| format!("kvmem fork_prefix_into mean restore: {e}"))?;
+        }
+        let kv = KvStore::new(&self.kv_cfg).map_err(|e| format!("kvmem store: {e}"))?;
+        kv.register_append(frontier)
+            .map_err(|e| format!("kvmem fork_prefix_into append: {e}"))?;
+        if let Some((_, keep)) = self.watermark {
+            kv.set_runtime_select_budget((keep * KV_BLOCK_TOKENS) as u32)
+                .map_err(|e| format!("kvmem watermark select budget: {e}"))?;
+        }
+        // A reused prefix is a NEW session: bump the incarnation so its
+        // canonical stamps never alias the source's (design §3.9g).
+        let lw_incarnation = self.slots[dst_slot].lw_incarnation + 1;
+        self.slots[dst_slot] =
+            self.fresh_slot_state(branch, kv, frontier, frontier, lw_incarnation);
+        Ok(frontier)
+    }
+
+    /// Record that a request begins on `slot` (cold prefill or a
+    /// continuation that reuses the existing prefix). Returns the store
+    /// length the request starts from — a continuation's reuse point must
+    /// equal it, because `feed_rows` only extends contiguously.
+    pub fn begin_request(&mut self, slot: usize) -> Result<u32, String> {
+        let st = self
+            .slots
+            .get_mut(slot)
+            .ok_or_else(|| format!("kvmem: begin_request slot {slot} out of range"))?;
+        st.turn_start = st.fed;
+        st.first_decode_done = false;
+        // A new turn's question must not inherit the previous turn's Q span.
+        st.q_ring_len = 0;
+        st.q_ring_cursor = 0;
+        // [P4.1② fix] arm the per-request scorer Query: the first Layerwise
+        // decode/verify step of this continuation must re-score the resident pool
+        // with the current question (ninfer per-request Query), not refine the
+        // frozen previous-turn keep-set by Pressure (which reuses a stale
+        // compact-tail binding and corrupts cross-turn recall).
+        // 期2.3 (KVMem/nInfer `layerwise_query_at_source`): skip that Query
+        // when the new question is already effective at the source — a proven
+        // span identical to the previous turn's and wholly inside the accepted
+        // prefix (`finalize_layerwise_query_source`: keep_selected). An
+        // unproven span (`None`) keeps the historical per-request Query.
+        st.lw_query_due = match st.request_query {
+            None => true,
+            Some(q) => {
+                let same = st.last_query == Some(q);
+                let inside = q.0 < q.1 && q.1 <= st.fed as u64;
+                !(same && inside)
+            }
+        };
+        Ok(st.fed)
+    }
+
+    /// 期2.3: install the current request's frontend-proven question span.
+    /// Called at admit for every request (cold, reuse, continuation) BEFORE
+    /// `begin_request` / the reuse import decision; the previous request's
+    /// span moves to `last_query` (continuation identity).
+    pub fn set_request_query(
+        &mut self,
+        slot: usize,
+        query: Option<(u64, u64)>,
+    ) -> Result<(), String> {
+        let st = self
+            .slots
+            .get_mut(slot)
+            .ok_or_else(|| format!("kvmem: set_request_query slot {slot} out of range"))?;
+        st.last_query = st.request_query;
+        st.request_query = query;
+        Ok(())
+    }
+
+    /// 期3 G3: install the request's internal content group (conversation
+    /// lineage hash). Group metadata is a capacity fairness hint only — the
+    /// reuse path still validates tokens/layout/native proofs.
+    pub fn set_request_group(&mut self, slot: usize, group: u64) -> Result<(), String> {
+        let st = self
+            .slots
+            .get_mut(slot)
+            .ok_or_else(|| format!("kvmem: set_request_group slot {slot} out of range"))?;
+        st.convo_group = group;
+        Ok(())
+    }
+
+    /// 期2.3: arm or clear the one-shot per-request scorer Query. The reuse
+    /// import uses it: a NEW question forces the Query at the first decode
+    /// step; KeepSelected (query already effective at the source) leaves it
+    /// clear.
+    pub fn set_layerwise_query_due(&mut self, slot: usize, due: bool) {
+        if let Some(st) = self.slots.get_mut(slot) {
+            st.lw_query_due = due;
+        }
+    }
+
+    /// Host-store length of `slot` (tokens whose statistics are recorded).
+    pub fn fed_tokens(&self, slot: usize) -> Option<u32> {
+        self.slots.get(slot).map(|s| s.fed)
+    }
+
+    /// Slot `slot`'s layerwise stamp counters `(incarnation, seq)` (design
+    /// §3.9g). The orchestration reads these to synthesize a fresh
+    /// `MemoryStamp` per re-bootstrapped query; `None` when out of range.
+    pub fn layerwise_counters(&self, slot: usize) -> Option<(u64, u64)> {
+        self.slots.get(slot).map(|s| (s.lw_incarnation, s.lw_seq))
+    }
+
+    /// Advance slot `slot`'s layerwise transaction counter after an admitted
+    /// query (design §3.9g). No-op when out of range. Legacy never calls it.
+    pub fn advance_layerwise_seq(&mut self, slot: usize) {
+        if let Some(st) = self.slots.get_mut(slot) {
+            st.lw_seq += 1;
+        }
+    }
+
+    /// [P4.1② fix] Consume slot `slot`'s per-request scorer-Query gate. Returns
+    /// true exactly once per continuation request (armed by `begin_request`),
+    /// then clears it so subsequent decode/verify steps of the same request
+    /// refine by Pressure. The orchestration calls this in its mutable window
+    /// before borrowing the controller for the carrier and passes the result as
+    /// `force_query`. No-op (false) when out of range / under Legacy.
+    pub fn take_layerwise_query_due(&mut self, slot: usize) -> bool {
+        match self.slots.get_mut(slot) {
+            Some(st) => std::mem::replace(&mut st.lw_query_due, false),
+            None => false,
+        }
+    }
+
+    /// Test-only: seed slot `slot`'s consumed frontier (`fed`) without the GPU
+    /// statistics-feed machinery (`feed_rows` needs live model taps). The P4.1②
+    /// G1 `engine_carrier_rows` GPU fixture populates the slot's statistics store
+    /// directly through [`Self::layerwise_stores`] and uses this to set the host
+    /// length the bootstrap reads. Never compiled into production (zero impact
+    /// on the Legacy byte-neutral spine).
+    #[cfg(test)]
+    pub(crate) fn test_set_fed(&mut self, slot: usize, fed: u32) -> Result<(), String> {
+        let st = self
+            .slots
+            .get_mut(slot)
+            .ok_or_else(|| format!("kvmem: test_set_fed slot {slot} out of range"))?;
+        st.kv
+            .register_append(fed)
+            .map_err(|e| format!("kvmem: test_set_fed append: {e}"))?;
+        st.fed = fed;
+        Ok(())
+    }
+}
diff --git a/crates/hipfire-arch-qwen35/src/kvmem_ctl/step.rs b/crates/hipfire-arch-qwen35/src/kvmem_ctl/step.rs
new file mode 100644
index 000000000..0bd3034de
--- /dev/null
+++ b/crates/hipfire-arch-qwen35/src/kvmem_ctl/step.rs
@@ -0,0 +1,410 @@
+// SPDX-License-Identifier: Apache-2.0
+// Copyright (c) 2026 Kaden Schutt
+// hipfire — see LICENSE and NOTICE in the project root.
+
+use super::*;
+
+impl KvMemCtl {
+    pub fn prepare_step(
+        &mut self,
+        gpu: &mut Gpu,
+        pool: &mut SlotPool,
+        taps: &KvMemTaps,
+        active: &[bool],
+        resident: &[bool],
+        prefill: &[bool],
+        prefill_final: &[bool],
+        k_arenas: &[GpuTensor],
+        v_arenas: &[GpuTensor],
+    ) -> Result<(), String> {
+        debug_assert!(pool.is_paged(), "kvmem requires the paged slot pool");
+        debug_assert_eq!(k_arenas.len(), self.n_fa_layers);
+        debug_assert_eq!(v_arenas.len(), self.n_fa_layers);
+        let n_slots = self.slots.len();
+        let timed = self.diagnostics.time;
+        let t_all = std::time::Instant::now();
+        let mut t_select = std::time::Duration::ZERO;
+        let mut t_spill = std::time::Duration::ZERO;
+        let mut t_restore = std::time::Duration::ZERO;
+        let mut n_spilled = 0usize;
+        let mut n_restored = 0usize;
+
+        // Return host state for slots whose session closed since last step.
+        // An idle slot that still holds a resident session keeps its state:
+        // it is the next turn's continuation prefix.
+        for s in 0..n_slots {
+            let live = active.get(s).copied().unwrap_or(false)
+                || resident.get(s).copied().unwrap_or(false);
+            if !live && (self.slots[s].fed != 0 || self.slots[s].last_select_full != 0) {
+                self.reset_slot(s)?;
+            }
+        }
+
+        // ── Pass 1: select, then spill every unselected resident full page ──
+        let mut plans: Vec<Option<StepPlan>> = (0..n_slots).map(|_| None).collect();
+        for s in 0..n_slots {
+            if !active.get(s).copied().unwrap_or(false) {
+                continue;
+            }
+            let prefill_step = prefill.get(s).copied().unwrap_or(false);
+            let (pages, live) = match pool.block_table(SlotId(s)) {
+                Some(bt) => (bt.num_pages(), bt.live_tokens()),
+                None => continue,
+            };
+            // Watermark hysteresis: when GPU_HIGH/LOW_WATERMARK is set, spill is
+            // triggered at the high-watermark page count (>= the keep target the
+            // core selection budget was narrowed to), instead of the single
+            // budget threshold. Unset => the historical budget_blocks trigger.
+            let spill_trigger = self.watermark.map(|(t, _)| t).unwrap_or(self.budget_blocks);
+            if pages <= spill_trigger {
+                continue;
+            }
+            let full_pages = live / KV_BLOCK_TOKENS;
+            // The chunk that completes the prompt gets the retrieval policy
+            // too — the tokens before it are the question, and this chunk's
+            // forward produces the logits the first answer token comes from.
+            // A slot with no fed rows has no tapped query yet (single-chunk
+            // prompt); it keeps the pressure policy.
+            let final_prefill = prefill_step
+                && prefill_final.get(s).copied().unwrap_or(false)
+                && self.slots[s].fed > self.slots[s].turn_start;
+            // The first decode step of a request takes a selection decision
+            // even when the block interval has not elapsed: the prompt-
+            // completing chunk just captured this turn's question in the Q
+            // tap, and scoring the resident set against it is what restores
+            // the page holding the answer. `fed > turn_start` rejects a
+            // stale tap from the previous request (empty continuation
+            // suffix: no rows of this turn exist to score with).
+            let first_decode = !prefill_step
+                && !self.slots[s].first_decode_done
+                && self.slots[s].fed > self.slots[s].turn_start;
+            if !final_prefill
+                && !first_decode
+                && full_pages < self.slots[s].last_select_full.saturating_add(self.interval)
+            {
+                continue;
+            }
+            let t_pick = std::time::Instant::now();
+            let picked = if prefill_step && !final_prefill {
+                self.slots[s]
+                    .kv
+                    .pick_prefill_pressure_blocks(&[])
+                    .map_err(|e| format!("kvmem prefill selection: {e}"))?
+            } else {
+                // SELECT_METHOD gates which signal feeds the shared pick_topk
+                // ranking (the core's executor-level policy). Retrieval (0, the
+                // default) scores the resident set against the tapped mean-K
+                // query. Recency (2) feeds no learned signal: zeroing the scores
+                // makes pick_topk keep sink + recent and fill the rest by recency
+                // (the core's deterministic id tie-break), and skips the Q-tap
+                // read + mean-K scoring entirely. H2O (1) is rejected at
+                // construction until the attention-heat tap lands.
+                //
+                // LRFU round lifecycle: begin before previewing scores, commit
+                // after the pick so the selector ranks the decayed candidate and
+                // the round's reinforcement is then sealed. Both are no-ops when
+                // lrfu is off, so the default Retrieval path stays byte-neutral.
+                self.slots[s]
+                    .kv
+                    .begin_retrieval_round()
+                    .map_err(|e| format!("kvmem begin round: {e}"))?;
+                if self.select_method == 2 {
+                    let zeros = vec![0.0f64; pages];
+                    self.slots[s]
+                        .kv
+                        .set_retrieval_scores(&zeros)
+                        .map_err(|e| format!("kvmem set scores: {e}"))?;
+                } else {
+                    let scores = self.refresh_scores(gpu, taps, s, pages)?;
+                    self.slots[s]
+                        .kv
+                        .set_retrieval_scores(&scores)
+                        .map_err(|e| format!("kvmem set scores: {e}"))?;
+                }
+                let picked = self.slots[s]
+                    .kv
+                    .pick_topk_blocks(&[])
+                    .map_err(|e| format!("kvmem decode selection: {e}"))?;
+                self.slots[s]
+                    .kv
+                    .commit_retrieval_round()
+                    .map_err(|e| format!("kvmem commit round: {e}"))?;
+                picked
+            };
+            if timed {
+                t_select += t_pick.elapsed();
+            }
+            let mut keep = vec![false; pages];
+            for &id in &picked {
+                if let Some(k) = keep.get_mut(id as usize) {
+                    *k = true;
+                }
+            }
+            // Collect this slot's page actions before mutating the pool.
+            let (spill, restore) = {
+                let bt = pool
+                    .block_table(SlotId(s))
+                    .expect("kvmem: block table vanished inside one step");
+                debug_assert_eq!(bt.num_pages(), pages);
+                let mut spill = Vec::new();
+                let mut restore = Vec::new();
+                for lp in 0..full_pages {
+                    if keep[lp] {
+                        if bt.is_spilled(lp) {
+                            restore.push(lp);
+                        }
+                    } else if !bt.is_spilled(lp) {
+                        match bt.physical(lp) {
+                            Some(phys) => {
+                                // P4.3 prefix PIN: a page the pool refuses to
+                                // evict (shared-prefix cache refs, or any other
+                                // non-exclusive lease) is PIN resident — force
+                                // keep instead of spilling. `stage_out_page`
+                                // would fail closed on it anyway; keeping it
+                                // here turns that hard error into the intended
+                                // residency. With no pinned pages every page
+                                // is exclusively table-owned ⇒ byte-neutral.
+                                let evictable = pool
+                                    .page_pool()
+                                    .map(|pp| pp.page_evictable(phys))
+                                    .unwrap_or(true);
+                                if evictable {
+                                    spill.push((lp, phys));
+                                } else {
+                                    keep[lp] = true;
+                                }
+                            }
+                            None => {
+                                return Err(format!(
+                                    "kvmem slot {s}: logical page {lp} is neither \
+                                     resident nor spilled"
+                                ))
+                            }
+                        }
+                    }
+                }
+                (spill, restore)
+            };
+            self.flush_spill_batch(
+                gpu,
+                pool,
+                s,
+                &spill,
+                k_arenas,
+                v_arenas,
+                timed,
+                &mut t_spill,
+                &mut n_spilled,
+            )?;
+            if self.diagnostics.trace {
+                eprintln!(
+                    "[kvmem] slot {s} ({}): {pages} pages, full {full_pages}, \
+                     budget {}, kept {}, spilled {}, restore {}",
+                    if prefill_step {
+                        if final_prefill {
+                            "prefill-final"
+                        } else {
+                            "prefill"
+                        }
+                    } else {
+                        "decode"
+                    },
+                    self.budget_blocks,
+                    keep.iter().filter(|k| **k).count(),
+                    spill.len(),
+                    restore.len(),
+                );
+                if self.diagnostics.trace_pages {
+                    eprintln!("[kvmem] slot {s} picked {picked:?} restore {restore:?}");
+                }
+            }
+            self.slots[s].last_select_full = full_pages;
+            if !prefill_step {
+                self.slots[s].first_decode_done = true;
+            }
+            plans[s] = Some(StepPlan { keep, restore });
+            // P4.1② f2 (G5 prefill seed): seed the FirstLayer head aux selection
+            // from this step's trunk working set. The first MTP draft of a request
+            // runs BEFORE any decode/verify carrier restore-hook — the draft phase
+            // precedes `prepare_step` in the serve loop and the prefill is
+            // full-resident with no carrier — so the G5 carrier binding
+            // (serve_engine decode/verify arms) has not fired yet and the draft
+            // would fall back to full-resident, overflowing the bounded head cache
+            // once `fed > window`. This is the hipfire analog of ninfer's
+            // restore-hook `bind_auxiliary_selection` (NL:9985-9990) firing on the
+            // trunk's first restored layer; the draft `take_aux_selection`s it to
+            // engage the bounded head restore. The selected pages are full pages
+            // strictly below the frontier, so the visible extent is invariant
+            // between this step's `fed` and the later draft's `fed`. Additive +
+            // gated: Legacy / AR-only (`head_plane_enabled()` false) never bind
+            // (byte-neutral); zero core C++ change.
+            if self.head_plane_enabled() {
+                let frontier = u64::from(self.slots[s].fed);
+                // The head catalog (`plan_head_plane`) spans only SEALED FULL
+                // pages (`id < frontier/128`); the partial suffix page
+                // (`id == frontier/128`) is the draft-scratch boundary handled
+                // separately by `HeadSuffix`, NOT a canonical aux block. `picked`
+                // includes that suffix, so filter it out here — mirroring
+                // `restored_keep_set()` (suffix excluded), the source the G5
+                // carrier binding uses. `auxiliary_visible_tokens` clips the
+                // suffix to the frontier so `bind` would accept it, but
+                // `plan_layer` then rejects `id == full_pages` as an "unknown
+                // selected block" (out of catalog). Filtering to full pages also
+                // keeps the visible extent invariant (each contributes exactly
+                // one block) between this step's `fed` and the later draft's.
+                let full_pages = frontier / KV_BLOCK_TOKENS as u64;
+                let mut sel: Vec<u64> = picked
+                    .iter()
+                    .map(|&id| u64::from(id))
+                    .filter(|&id| id < full_pages)
+                    .collect();
+                sel.sort_unstable();
+                sel.dedup();
+                // P4.1③ H4: branch the head-history policy. FirstLayer (the
+                // auto-default) binds the trunk working set's full pages (② G5).
+                // The A1 starvation floor is applied centrally in
+                // `layerwise_mtp_history()` (below-floor UpstreamGlobal reports
+                // FirstLayer), so this site and the serve_engine carrier hooks
+                // fall back uniformly; the UG algorithm is unchanged when engaged.
+                // UpstreamGlobal restores ALL canonical pages when the whole
+                // history fits the budget (ninfer `begin==history_tokens` fast
+                // path, NL:10058), else runs the global Mean-K probe over the
+                // captured prefill Q tap (H2b — no private forward, no rollback).
+                // The probe needs a fresh Q tap (`final_prefill`/`first_decode`
+                // ran `refresh_scores`); an intermediate prefill step with a stale
+                // tap keeps the picked seed, overwritten by the prompt-completing
+                // step's probe before the first draft. Legacy / AR-only never
+                // reach this block (byte-neutral); zero core C++ change.
+                let aux = if self.layerwise_mtp_history() == LayerwiseMtpHistory::UpstreamGlobal {
+                    if full_pages <= self.budget_blocks as u64 {
+                        let all: Vec<u64> = (0..full_pages).collect();
+                        crate::layerwise_mtp::bind_first_layer_auxiliary(
+                            &all,
+                            frontier,
+                            KV_BLOCK_TOKENS as u64,
+                        )
+                        .map_err(|e| format!("kvmem head aux restore-all (slot {s}): {e}"))?
+                    } else if final_prefill || first_decode {
+                        // The probe admits against a FRESH page-aligned sealed
+                        // Mean-K TopK index (the same `layerwise_policy` the trunk
+                        // carrier uses), NOT the slot's shared Legacy `kv` store
+                        // (which tracks all fed tokens and carries retrieval-round
+                        // state — the core rejects it as a probe index). The
+                        // identity frontier is the page-aligned `full_pages*128`
+                        // (== policy.total_tokens); the bind clips to the native
+                        // `frontier` (fed) exactly like the FirstLayer seed.
+                        let probe_frontier = full_pages * KV_BLOCK_TOKENS as u64;
+                        let probe_policy = self
+                            .layerwise_policy(self.slots[s].fed)
+                            .map_err(|e| format!("kvmem head aux probe policy (slot {s}): {e}"))?;
+                        let id = crate::layerwise_probe::probe_identity(
+                            probe_frontier,
+                            s as u64,
+                            self.slots[s].lw_incarnation,
+                            self.slots[s].lw_seq,
+                        );
+                        let q_rows = &self.sums[..self.n_fa_layers * self.q_width];
+                        crate::layerwise_probe::probe_head_history_qrows(
+                            gpu,
+                            q_rows,
+                            &id,
+                            &probe_policy,
+                            &self.slots[s].raw,
+                            self.n_heads as u32,
+                            self.n_kv_heads as u32,
+                            self.head_dim as u32,
+                            0.0, // → 1/sqrt(head_dim), the trunk scorer's default scale
+                            KV_BLOCK_TOKENS as u32,
+                            frontier,
+                        )
+                        .map_err(|e| format!("kvmem head aux probe (slot {s}): {e}"))?
+                    } else {
+                        crate::layerwise_mtp::bind_first_layer_auxiliary(
+                            &sel,
+                            frontier,
+                            KV_BLOCK_TOKENS as u64,
+                        )
+                        .map_err(|e| format!("kvmem head aux seed (slot {s}): {e}"))?
+                    }
+                } else {
+                    crate::layerwise_mtp::bind_first_layer_auxiliary(
+                        &sel,
+                        frontier,
+                        KV_BLOCK_TOKENS as u64,
+                    )
+                    .map_err(|e| format!("kvmem head aux seed (slot {s}): {e}"))?
+                };
+                self.set_aux_selection(s, aux);
+            }
+        }
+
+        // ── Pass 2: restore the selected spilled pages ──────────────────────
+        // Alloc + bind every selected page first (same order as before, so the
+        // free-list interaction is unchanged), then move all the bytes in one
+        // batched flush. No forward runs between bind and restore.
+        let mut restore_batch: Vec<(usize, usize, u32)> = Vec::new();
+        for s in 0..n_slots {
+            let Some(plan) = plans[s].take() else {
+                continue;
+            };
+            for lp in plan.restore {
+                debug_assert!(plan.keep[lp]);
+                let phys = pool
+                    .page_pool_mut()
+                    .ok_or_else(|| "kvmem restore: pool is not paged".to_string())?
+                    .alloc_page_unbound()
+                    .map_err(|e| format!("kvmem restore alloc: {e}"))?;
+                pool.bind_restored_page(SlotId(s), lp, phys)
+                    .map_err(|e| format!("kvmem restore bind: {e}"))?;
+                restore_batch.push((s, lp, phys));
+            }
+            if self.diagnostics.verify {
+                if let Some(bt) = pool.block_table(SlotId(s)) {
+                    let mut seen: std::collections::HashMap<u32, usize> =
+                        std::collections::HashMap::new();
+                    let mut dups = Vec::new();
+                    for lp in 0..bt.num_pages() {
+                        if let Some(phys) = bt.physical(lp) {
+                            if let Some(prev) = seen.insert(phys, lp) {
+                                dups.push((prev, lp, phys));
+                            }
+                        }
+                    }
+                    let mut map = Vec::with_capacity(bt.num_pages());
+                    for lp in 0..bt.num_pages() {
+                        map.push(bt.raw_entry(lp).unwrap_or(u32::MAX));
+                    }
+                    eprintln!(
+                        "[kvmem-verify] slot {s} resident {} pages, dups {dups:?} map {map:?}",
+                        seen.len()
+                    );
+                }
+            }
+        }
+        self.flush_restore_batch(
+            gpu,
+            &restore_batch,
+            k_arenas,
+            v_arenas,
+            timed,
+            &mut t_restore,
+            &mut n_restored,
+        )?;
+        // Observability counters (pure bookkeeping; no path reads them back).
+        self.spill_pages_total += n_spilled as u64;
+        self.restore_pages_total += n_restored as u64;
+        if timed && (n_spilled > 0 || n_restored > 0 || t_select > std::time::Duration::ZERO) {
+            eprintln!(
+                "[kvmem-time] prepare: total {:.1} ms (select {:.1} ms, spill {} pages \
+                 {:.1} ms, restore {} pages {:.1} ms)",
+                t_all.elapsed().as_secs_f64() * 1e3,
+                t_select.as_secs_f64() * 1e3,
+                n_spilled,
+                t_spill.as_secs_f64() * 1e3,
+                n_restored,
+                t_restore.as_secs_f64() * 1e3,
+            );
+        }
+        Ok(())
+    }
+}
diff --git a/crates/hipfire-arch-qwen35/src/kvmem_ctl/tests.rs b/crates/hipfire-arch-qwen35/src/kvmem_ctl/tests.rs
new file mode 100644
index 000000000..6779fd663
--- /dev/null
+++ b/crates/hipfire-arch-qwen35/src/kvmem_ctl/tests.rs
@@ -0,0 +1,1857 @@
+// SPDX-License-Identifier: Apache-2.0
+// Copyright (c) 2026 Kaden Schutt
+mod head_plane;
+// hipfire — see LICENSE and NOTICE in the project root.
+
+use super::*;
+use rdna_compute::DType;
+
+#[test]
+fn legacy_window_plan_keeps_budget_separate_from_reserve() {
+    let p = resolve_legacy_plan(1, 32768, 256, 8192, 1024, None).unwrap();
+    assert_eq!(p.budget_blocks, 64);
+    assert_eq!(p.pages_total, 72);
+    assert_eq!(p.grow_blocks, 2);
+    let two = resolve_legacy_plan(2, 32768, 512, 8192, 2048, None).unwrap();
+    assert_eq!(two.pages_total, 160);
+    assert_eq!(two.budget_blocks, 64);
+}
+
+#[test]
+fn legacy_window_plan_refuses_silent_budget_clamping() {
+    let error = resolve_legacy_plan(1, 65536, 256, 36864, 1024, Some(160)).unwrap_err();
+    assert!(error.contains("not reduced automatically"), "{error}");
+    assert!(resolve_legacy_plan(1, 32768, 256, 8192, 1024, Some(71)).is_err());
+    assert!(resolve_legacy_plan(1, 32768, 256, 8192, 1024, Some(72)).is_ok());
+}
+
+#[test]
+fn legacy_window_plan_checks_context_step_and_alignment() {
+    assert!(resolve_legacy_plan(1, 9216, 1024, 8192, 1024, None).is_ok());
+    assert!(resolve_legacy_plan(1, 9215, 1024, 8192, 1024, None).is_err());
+    assert!(resolve_legacy_plan(1, 32768, 1025, 8192, 1024, None).is_err());
+    assert!(resolve_legacy_plan(1, 32768, 128, 255, 1024, None).is_err());
+    assert!(resolve_legacy_plan(1, 32768, 128, 8193, 1024, None).is_err());
+    assert!(resolve_legacy_plan(1, 32768, 128, 8192, 127, None).is_err());
+    assert!(resolve_legacy_plan(0, 32768, 256, 8192, 1024, None).is_err());
