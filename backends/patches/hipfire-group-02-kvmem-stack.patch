new file mode 100644
index 000000000..d0ca78a52
--- /dev/null
+++ b/crates/rdna-compute/src/kvmem_page_mass.rs
@@ -0,0 +1,374 @@
+// SPDX-License-Identifier: Apache-2.0
+// Copyright (c) 2026 Kaden Schutt
+// hipfire — see LICENSE and NOTICE in the project root.
+
+//! KVMem layerwise pressure attention-mass tap (Rust launch seam).
+//!
+//! Drives the three HIP kernels in `kernels/src/kvmem_page_mass.hip` — a faithful
+//! port of ninfer's `attention_page_mass` recompute kernel. It samples a target
+//! layer's native Q against the represented persistent Q8_0 K cache and returns
+//! the per-page attention mass (normalized across the complete visible cache,
+//! averaged over query heads). This is a SEPARATE K-only recompute: the legacy
+//! attention kernels are untouched, so the default path stays byte-neutral.
+//!
+//! Crate boundary: `rdna-compute` has no `hipfire-kvmem` dependency. The caller
+//! (the layerwise driver in `hipfire-arch-qwen35`) owns the device Q tensor and
+//! the Q8_0 K cache, selects the sampled rows / compact causal ends / block-table
+//! row, and hands them here. Only the per-page masses cross back to the host.
+//!
+//! Operand boundary: Q is read in its native scalar (F32/F16/BF16) and converted
+//! to float; the dot is exact in float32. The warp-tree reduction differs from a
+//! host double reference only in float association order (parity within
+//! `2e-6 + 3e-5*expected`, not bit-exact). An unmapped/out-of-range VISIBLE
+//! physical page produces NaN, which this launcher rejects fail-closed.
+
+use crate::dispatch::{DType, Gpu};
+use hip_bridge::{HipError, HipResult, KernargBlob};
+use std::ffi::c_void;
+
+/// Must match `kernels/src/kvmem_page_mass.hip`.
+pub const KVMEM_PAGE_MASS_SRC: &str = include_str!("../../../kernels/src/kvmem_page_mass.hip");
+
+const MODULE: &str = "kvmem_page_mass";
+const LSE: &str = "kvmem_page_mass_lse";
+const NORMALIZE: &str = "kvmem_page_mass_normalize";
+const AVERAGE: &str = "kvmem_page_mass_average";
+
+/// hipfire layerwise page size (tokens). Must match `LAYERWISE_BLOCK_TOKENS` in
+/// hipfire-arch-qwen35/src/layerwise_layout.rs and the core catalog block_tokens.
+pub const PAGE_TOKENS: u32 = 128;
+/// ninfer sample cap: at most 64 sampled Q rows per call.
+const MAX_SAMPLES: usize = 64;
+const BLOCK: u32 = 128;
+const DIM: u32 = 256;
+
+/// Native Q scalar type; ordinals mirror `kvmem::NativeQueryScalar` (F32=0/F16=1/BF16=2).
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+#[repr(u32)]
+pub enum PageMassScalar {
+    F32 = 0,
+    F16 = 1,
+    BF16 = 2,
+}
+
+/// Borrowed native Q from exactly one target attention layer, resident on the
+/// device, contiguous `[rows, query_heads, head_dim]` (head_dim innermost). Q must
+/// be in the SAME rotational space as the stored K (post-RoPE) for the mass to
+/// reflect real attention; the caller resolves that before sampling.
+#[derive(Clone, Copy, Debug)]
+pub struct PageMassQuery {
+    pub data: *const c_void,
+    pub rows: u32,
+    pub query_heads: u32,
+    pub kv_heads: u32,
+    pub head_dim: u32,
+    /// Zero selects `1/sqrt(head_dim)`.
+    pub attention_scale: f32,
+    pub scalar: PageMassScalar,
+}
+
+impl Gpu {
+    /// Sample `rows.len()` Q rows against `pages` logical pages of the Q8_0 K
+    /// cache, writing per-page attention mass into `out` (length
+    /// `samples * pages`, sample-major then page). `keys` is the page-major Q8_0
+    /// K cache device base (`physical_pages` pages, each `PAGE_TOKENS` tokens,
+    /// token-major `kv_heads * (head_dim/32)*34` bytes/token). `table` maps each
+    /// logical page to its physical page (-1 = unmapped). `positions[s]` is the
+    /// inclusive compact causal end of sample `s` (visible = positions[s]+1).
+    ///
+    /// Mirrors ninfer `attention_page_mass`: each page's token logsumexp is
+    /// normalized across the COMPLETE visible cache, then heads are averaged.
+    /// No V read, no allocation/host-copy/state-mutation beyond the disjoint
+    /// workspaces. Runs at a post-attention boundary; the caller owns identity.
+    #[allow(clippy::too_many_arguments)]
+    pub fn kvmem_page_mass(
+        &mut self,
+        q: &PageMassQuery,
+        rows: &[i32],
+        positions: &[i32],
+        table: &[i32],
+        keys: *const c_void,
+        physical_pages: usize,
+        out: &mut [f32],
+    ) -> HipResult<()> {
+        let samples = rows.len();
+        let pages = table.len();
+        if q.data.is_null()
+            || keys.is_null()
+            || q.rows == 0
+            || q.query_heads == 0
+            || q.kv_heads == 0
+            || q.head_dim != DIM
+            || q.query_heads % q.kv_heads != 0
+            || !q.attention_scale.is_finite()
+            || q.attention_scale < 0.0
+        {
+            return Err(HipError::new(
+                0,
+                "kvmem_page_mass: invalid Query/K geometry",
+            ));
+        }
+        if samples == 0 || samples > MAX_SAMPLES || positions.len() != samples {
+            return Err(HipError::new(
+                0,
+                "kvmem_page_mass: samples must be in [1, 64] and match positions",
+            ));
+        }
+        if pages == 0 || physical_pages == 0 {
+            return Err(HipError::new(0, "kvmem_page_mass: empty page domain"));
+        }
+        if out.len() != samples * pages {
+            return Err(HipError::new(
+                0,
+                &format!(
+                    "kvmem_page_mass: out length {} != samples*pages {}",
+                    out.len(),
+                    samples * pages
+                ),
+            ));
+        }
+        let span = pages as i64 * PAGE_TOKENS as i64;
+        for s in 0..samples {
+            if rows[s] < 0 || rows[s] as u32 >= q.rows {
+                return Err(HipError::new(
+                    0,
+                    "kvmem_page_mass: sampled row out of range",
+                ));
+            }
+            if positions[s] < 0 || positions[s] as i64 >= span {
+                return Err(HipError::new(
+                    0,
+                    "kvmem_page_mass: compact causal end out of range",
+                ));
+            }
+        }
+        let distributions = samples as u32 * q.query_heads;
+        if let Some(limit) = hip_bridge::grid_yz_limit_for_arch(self.arch.as_str()) {
+            if distributions > limit || pages as u32 > limit {
+                return Err(HipError::new(
+                    0,
+                    "kvmem_page_mass: sample/page grid exceeds device limit",
+                ));
+            }
+        }
+        for v in out.iter_mut() {
+            *v = 0.0;
+        }
+
+        self.bind_thread()?;
+        self.ensure_kernel(MODULE, KVMEM_PAGE_MASS_SRC, LSE)?;
+        self.ensure_kernel(MODULE, KVMEM_PAGE_MASS_SRC, NORMALIZE)?;
+        self.ensure_kernel(MODULE, KVMEM_PAGE_MASS_SRC, AVERAGE)?;
+
+        let scratch = self.alloc_tensor(&[pages * distributions as usize * 4], DType::Raw)?;
+        let norms = self.alloc_tensor(&[2 * distributions as usize * 4], DType::Raw)?;
+        let output = self.zeros(&[pages * samples * 4], DType::Raw)?;
+        let rows_dev = self.alloc_tensor(&[samples * 4], DType::Raw)?;
+        let pos_dev = self.alloc_tensor(&[samples * 4], DType::Raw)?;
+        let table_dev = self.alloc_tensor(&[pages * 4], DType::Raw)?;
+
+        let result = (|| -> HipResult<()> {
+            self.hip.memcpy_htod(&rows_dev.buf, bytemuck_i32(rows))?;
+            self.hip
+                .memcpy_htod(&pos_dev.buf, bytemuck_i32(positions))?;
+            self.hip.memcpy_htod(&table_dev.buf, bytemuck_i32(table))?;
+
+            let scale = if q.attention_scale > 0.0 {
+                q.attention_scale
+            } else {
+                1.0 / (q.head_dim as f32).sqrt()
+            };
+            let qp = q.data;
+            let rp = rows_dev.buf.as_ptr();
+            let pp = pos_dev.buf.as_ptr();
+            let tp = table_dev.buf.as_ptr();
+            let kp = keys;
+            let sp = scratch.buf.as_ptr();
+            let np = norms.buf.as_ptr();
+            let op = output.buf.as_ptr();
+
+            self.mass_lse(
+                qp,
+                rp,
+                pp,
+                tp,
+                kp,
+                q.query_heads as i32,
+                q.kv_heads as i32,
+                pages as i32,
+                physical_pages as i32,
+                PAGE_TOKENS as i32,
+                q.head_dim as i32,
+                q.scalar as i32,
+                scale,
+                sp,
+                distributions,
+            )?;
+            self.mass_normalize(sp, pages as i32, np, distributions)?;
+            self.mass_average(
+                sp,
+                np,
+                pages as i32,
+                q.query_heads as i32,
+                op,
+                samples as u32,
+            )?;
+            self.hip.device_synchronize()?;
+
+            let mut bytes = vec![0u8; pages * samples * 4];
+            self.hip.memcpy_dtoh(&mut bytes, &output.buf)?;
+            for (j, chunk) in bytes.chunks_exact(4).enumerate() {
+                let v = f32::from_ne_bytes([chunk[0], chunk[1], chunk[2], chunk[3]]);
+                if !v.is_finite() {
+                    return Err(HipError::new(
+                        0,
+                        "kvmem_page_mass: unmapped/out-of-range visible physical page (NaN mass)",
+                    ));
+                }
+                out[j] = v;
+            }
+            Ok(())
+        })();
+
+        self.free_tensor(scratch)?;
+        self.free_tensor(norms)?;
+        self.free_tensor(output)?;
+        self.free_tensor(rows_dev)?;
+        self.free_tensor(pos_dev)?;
+        self.free_tensor(table_dev)?;
+        result
+    }
+
+    #[allow(clippy::too_many_arguments)]
+    fn mass_lse(
+        &mut self,
+        q: *const c_void,
+        rows: *mut c_void,
+        positions: *mut c_void,
+        table: *mut c_void,
+        keys: *const c_void,
+        qheads: i32,
+        kvheads: i32,
+        pages: i32,
+        physical_pages: i32,
+        page_tokens: i32,
+        dim: i32,
+        scalar: i32,
+        scale: f32,
+        scratch: *mut c_void,
+        distributions: u32,
+    ) -> HipResult<()> {
+        let mut params: Vec<*mut c_void> = vec![
+            &q as *const _ as *mut c_void,
+            &rows as *const _ as *mut c_void,
+            &positions as *const _ as *mut c_void,
+            &table as *const _ as *mut c_void,
+            &keys as *const _ as *mut c_void,
+            &qheads as *const _ as *mut c_void,
+            &kvheads as *const _ as *mut c_void,
+            &pages as *const _ as *mut c_void,
+            &physical_pages as *const _ as *mut c_void,
+            &page_tokens as *const _ as *mut c_void,
+            &dim as *const _ as *mut c_void,
+            &scalar as *const _ as *mut c_void,
+            &scale as *const _ as *mut c_void,
+            &scratch as *const _ as *mut c_void,
+        ];
+        self.launch_maybe_blob(
+            LSE,
+            [pages as u32, distributions, 1],
+            [BLOCK, 1, 1],
+            0,
+            &mut params,
+            || {
+                let mut b = KernargBlob::new();
+                b.push_ptr(q);
+                b.push_ptr(rows);
+                b.push_ptr(positions);
+                b.push_ptr(table);
+                b.push_ptr(keys);
+                b.push_i32(qheads);
+                b.push_i32(kvheads);
+                b.push_i32(pages);
+                b.push_i32(physical_pages);
+                b.push_i32(page_tokens);
+                b.push_i32(dim);
+                b.push_i32(scalar);
+                b.push_f32(scale);
+                b.push_ptr(scratch);
+                b
+            },
+        )
+    }
+
+    fn mass_normalize(
+        &mut self,
+        lse: *mut c_void,
+        pages: i32,
+        norms: *mut c_void,
+        distributions: u32,
+    ) -> HipResult<()> {
+        let mut params: Vec<*mut c_void> = vec![
+            &lse as *const _ as *mut c_void,
+            &pages as *const _ as *mut c_void,
+            &norms as *const _ as *mut c_void,
+        ];
+        self.launch_maybe_blob(
+            NORMALIZE,
+            [distributions, 1, 1],
+            [BLOCK, 1, 1],
+            0,
+            &mut params,
+            || {
+                let mut b = KernargBlob::new();
+                b.push_ptr(lse);
+                b.push_i32(pages);
+                b.push_ptr(norms);
+                b
+            },
+        )
+    }
+
+    fn mass_average(
+        &mut self,
+        lse: *mut c_void,
+        norms: *mut c_void,
+        pages: i32,
+        heads: i32,
+        output: *mut c_void,
+        samples: u32,
+    ) -> HipResult<()> {
+        let grid_x = (pages as u32).div_ceil(BLOCK);
+        let mut params: Vec<*mut c_void> = vec![
+            &lse as *const _ as *mut c_void,
+            &norms as *const _ as *mut c_void,
+            &pages as *const _ as *mut c_void,
+            &heads as *const _ as *mut c_void,
+            &output as *const _ as *mut c_void,
+        ];
+        self.launch_maybe_blob(
+            AVERAGE,
+            [grid_x, samples, 1],
+            [BLOCK, 1, 1],
+            0,
+            &mut params,
+            || {
+                let mut b = KernargBlob::new();
+                b.push_ptr(lse);
+                b.push_ptr(norms);
+                b.push_i32(pages);
+                b.push_i32(heads);
+                b.push_ptr(output);
+                b
+            },
+        )
+    }
+}
+
+/// Reinterpret an `&[i32]` as little-endian bytes for upload without a bytemuck
+/// dependency (the production launcher mirrors the scorer's no-`half` rule).
+fn bytemuck_i32(values: &[i32]) -> &[u8] {
+    // SAFETY: i32 is plain-old-data; the byte slice aliases the same memory for
+    // the lifetime of the borrow, and HIP memcpy reads it synchronously.
+    unsafe { std::slice::from_raw_parts(values.as_ptr() as *const u8, values.len() * 4) }
+}
diff --git a/crates/rdna-compute/src/kvmem_page_score.rs b/crates/rdna-compute/src/kvmem_page_score.rs
new file mode 100644
index 000000000..43080928b
--- /dev/null
+++ b/crates/rdna-compute/src/kvmem_page_score.rs
@@ -0,0 +1,497 @@
+// SPDX-License-Identifier: Apache-2.0
+// Copyright (c) 2026 Kaden Schutt
+// hipfire — see LICENSE and NOTICE in the project root.
+
+//! KVMem layerwise current-layer page-softmax scorer (Rust launch seam).
+//!
+//! Drives the four HIP kernels in `kernels/src/kvmem_page_score.hip` — a faithful
+//! port of the qualified KVMem core `PageSoftmaxCuda::score_current_layer` device
+//! orchestration (Mean GQA aggregation). The core library is left untouched
+//! (KVMEM_ROCM stays OFF); this is hipfire's own GPU scorer, called directly from
+//! Rust at an eager Query-selection boundary.
+//!
+//! Crate boundary: `rdna-compute` has no `hipfire-kvmem` dependency, so this
+//! launcher never reads a `RawKvStore`. The caller (the layerwise driver in
+//! `hipfire-arch-qwen35`) gathers the canonical Mean-K rows for the frozen score
+//! frame's enabled blocks via the shim (`hk_raw_store_mean_k`) and hands them
+//! here as a host `&[f32]` slice; the device Q tensor stays on its producing
+//! stream/device and is passed by pointer + byte strides. Only the per-page
+//! attention masses cross back to the host.
+//!
+//! Operand boundary matches the core exactly: Mean-K is rounded to FP16 on the
+//! host before upload (`f32_to_f16_rne_bits`, round-to-nearest-even, identical to
+//! `__float2half_rn(recall_fp16(x))` for in-range finite operands), and Q is
+//! rounded to FP16 by the pack kernel, so every dot product is exact in float32.
+//! The warp-tree reduction differs from the host SIMD reduction only in float
+//! association order (parity is within `2e-6 + 3e-5*expected`, not bit-exact).
+
+use crate::dispatch::{DType, Gpu};
+use hip_bridge::{HipError, HipResult, KernargBlob};
+use std::ffi::c_void;
+
+/// Must match `kernels/src/kvmem_page_score.hip`.
+pub const KVMEM_PAGE_SCORE_SRC: &str = include_str!("../../../kernels/src/kvmem_page_score.hip");
+
+const MODULE: &str = "kvmem_page_score";
+const PACK: &str = "kvmem_pack_current_query";
+const LOGITS: &str = "kvmem_page_logits";
+const NORMALIZE: &str = "kvmem_normalize_pages";
+const ACCUMULATE: &str = "kvmem_accumulate_pages";
+
+/// Core logits budget: one batch row of logits is <= 64 MiB.
+const LOGITS_LIMIT: usize = 64 << 20;
+const MAX_BATCH: u32 = 64;
+const PACK_BLOCK: u32 = 256;
+const PAGE_BLOCK: u32 = 128;
+
+/// Native Q scalar type; ordinals mirror `kvmem::NativeQueryScalar` and
+/// `hk_native_query_scalar` (F32=0, F16=1, BF16=2).
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+#[repr(u32)]
+pub enum PageQueryScalar {
+    F32 = 0,
+    F16 = 1,
+    BF16 = 2,
+}
+
+/// Borrowed normalized, pre-RoPE Q from exactly one target attention layer,
+/// resident on the device. Strides and extent are BYTES; the token axis need not
+/// be outermost. Mirrors `kvmem::NativeCurrentLayerQuery` minus the layer ordinal
+/// (the caller resolves the statistics layer before gathering Mean-K).
+#[derive(Clone, Copy, Debug)]
+pub struct PageScoreQuery {
+    pub data: *const c_void,
+    pub bytes: usize,
+    pub rows: u32,
+    pub query_heads: u32,
+    pub kv_heads: u32,
+    pub head_dim: u32,
+    /// Zero selects `1/sqrt(head_dim)`.
+    pub attention_scale: f32,
+    pub scalar: PageQueryScalar,
+    pub row_stride: usize,
+    pub head_stride: usize,
+    pub dimension_stride: usize,
+}
+
+/// Host f32->f16 round-to-nearest-even (matches `half::f16::from_f32` /
+/// `__float2half_rn` for finite values). Replicated here because `half` is a
+/// dev-only dependency; the production launcher must not depend on it.
+fn f32_to_f16_rne_bits(v: f32) -> u16 {
+    let bits = v.to_bits();
+    let sign = ((bits >> 16) & 0x8000) as u16;
+    let exp = ((bits >> 23) & 0xff) as i32;
+    let mant = bits & 0x007f_ffff;
+    if exp == 255 {
+        return if mant == 0 {
+            sign | 0x7c00
+        } else {
+            sign | 0x7e00 | ((mant >> 13) as u16 & 0x1ff)
+        };
+    }
+    let exp16 = exp - 127 + 15;
+    if exp16 >= 31 {
+        return sign | 0x7c00;
+    }
+    if exp16 <= 0 {
+        if exp16 < -10 {
+            return sign;
+        }
+        let mant_full = mant | 0x0080_0000;
+        let shift = (14 - exp16) as u32;
+        let half_mant = mant_full >> shift;
+        let rem = mant_full & ((1u32 << shift) - 1);
+        let half = half_mant as u16;
+        let round_up =
+            rem > (1u32 << (shift - 1)) || (rem == (1u32 << (shift - 1)) && (half & 1) != 0);
+        return sign | (half + u16::from(round_up));
+    }
+    let half_mant = (mant >> 13) as u16;
+    let rem = mant & 0x1fff;
+    let mut half = ((exp16 as u16) << 10) | half_mant;
+    let round_up = rem > 0x1000 || (rem == 0x1000 && (half_mant & 1) != 0);
+    if round_up {
+        half = half.wrapping_add(1);
+    }
+    sign | half
+}
+
+impl Gpu {
+    /// Score one target layer's current native Q against `blocks` enabled
+    /// canonical pages, writing per-page attention mass into `out` (length
+    /// `blocks`). `means` holds `blocks * kv_heads * head_dim` host F32 Mean-K
+    /// rows in enabled-page order (page-major, then kv-head, then channel).
+    ///
+    /// Mirrors `PageSoftmaxCuda::score_current_layer`: the Q operand is validated
+    /// for finiteness even when the score domain is empty (`blocks == 0`), in
+    /// which case every output mass is zero. Runs at an eager boundary; the
+    /// caller owns request/index identity and the frozen score frame.
+    pub fn kvmem_page_score_current_layer(
+        &mut self,
+        q: &PageScoreQuery,
+        means: &[f32],
+        blocks: usize,
+        out: &mut [f64],
+    ) -> HipResult<()> {
+        if q.data.is_null()
+            || q.rows == 0
+            || q.query_heads == 0
+            || q.kv_heads == 0
+            || q.head_dim == 0
+            || q.query_heads % q.kv_heads != 0
+            || !q.attention_scale.is_finite()
+            || q.attention_scale < 0.0
+        {
+            return Err(HipError::new(
+                0,
+                "kvmem_page_score: invalid current-layer Query geometry",
+            ));
+        }
+        if out.len() != blocks {
+            return Err(HipError::new(
+                0,
+                &format!(
+                    "kvmem_page_score: out length {} != blocks {blocks}",
+                    out.len()
+                ),
+            ));
+        }
+        let kw = q.kv_heads as usize * q.head_dim as usize;
+        let qw = q.query_heads as usize * q.head_dim as usize;
+        if means.len() != blocks * kw {
+            return Err(HipError::new(
+                0,
+                &format!(
+                    "kvmem_page_score: means length {} != blocks*kw {}",
+                    means.len(),
+                    blocks * kw
+                ),
+            ));
+        }
+        let row_logits_bytes = blocks * q.query_heads as usize * 4;
+        if blocks > 0 && row_logits_bytes > LOGITS_LIMIT {
+            return Err(HipError::new(
+                0,
+                "kvmem_page_score: needs a larger per-row logits budget",
+            ));
+        }
+        for v in out.iter_mut() {
+            *v = 0.0;
+        }
+
+        self.bind_thread()?;
+        self.ensure_kernel(MODULE, KVMEM_PAGE_SCORE_SRC, PACK)?;
+        self.ensure_kernel(MODULE, KVMEM_PAGE_SCORE_SRC, LOGITS)?;
+        self.ensure_kernel(MODULE, KVMEM_PAGE_SCORE_SRC, NORMALIZE)?;
+        self.ensure_kernel(MODULE, KVMEM_PAGE_SCORE_SRC, ACCUMULATE)?;
+
+        let batch = if blocks > 0 {
+            (MAX_BATCH as usize)
+                .min(LOGITS_LIMIT / row_logits_bytes)
+                .max(1) as u32
+        } else {
+            MAX_BATCH
+        };
+
+        // Workspace (Raw == byte-sized). queries/norms are always needed (Q is
+        // validated even for an empty domain); means/logits/output only when
+        // there is something to score.
+        let queries = self.alloc_tensor(&[batch as usize * qw * 2], DType::Raw)?;
+        let norms = self.alloc_tensor(
+            &[batch as usize * q.query_heads as usize * 2 * 4],
+            DType::Raw,
+        )?;
+        let means_dev = if blocks > 0 {
+            Some(self.alloc_tensor(&[blocks * kw * 2], DType::Raw)?)
+        } else {
+            None
+        };
+        let logits = if blocks > 0 {
+            Some(self.alloc_tensor(&[batch as usize * row_logits_bytes], DType::Raw)?)
+        } else {
+            None
+        };
+        let output = if blocks > 0 {
+            Some(self.zeros(&[blocks * 4], DType::Raw)?)
+        } else {
+            None
+        };
+
+        if let Some(md) = &means_dev {
+            let mut half_bytes = Vec::with_capacity(blocks * kw * 2);
+            for &m in means {
+                half_bytes.extend_from_slice(&f32_to_f16_rne_bits(m).to_ne_bytes());
+            }
+            self.hip.memcpy_htod(&md.buf, &half_bytes)?;
+        }
+
+        let scale = if q.attention_scale > 0.0 {
+            q.attention_scale
+        } else {
+            1.0 / (q.head_dim as f32).sqrt()
+        };
+        let weight = 1.0 / q.query_heads as f32;
+        let scalar = q.scalar as i32;
+        let finite_required = i32::from(blocks > 0);
+        let qp = queries.buf.as_ptr();
+        let np = norms.buf.as_ptr();
+        let mp = means_dev.as_ref().map(|t| t.buf.as_ptr());
+        let lp = logits.as_ref().map(|t| t.buf.as_ptr());
+        let op = output.as_ref().map(|t| t.buf.as_ptr());
+
+        let mut operand_error = false;
+        let mut first = 0u32;
+        while first < q.rows {
+            let rows = batch.min(q.rows - first);
+            // Norms are not live until after packing: borrow their first word as
+            // the operand-error flag, read it before the normalizer overwrites it.
+            self.hip.memcpy_htod(&norms.buf, &[0u8; 4])?;
+            let input = (q.data as usize + first as usize * q.row_stride) as *const c_void;
+            self.page_score_pack(
+                input,
+                qp,
+                np,
+                rows,
+                q.query_heads,
+                q.head_dim,
+                q.row_stride,
+                q.head_stride,
+                q.dimension_stride,
+                scalar,
+                finite_required,
+            )?;
+            self.hip.device_synchronize()?;
+            let mut invalid = [0u8; 4];
+            self.hip.memcpy_dtoh(&mut invalid, &norms.buf)?;
+            if u32::from_ne_bytes(invalid) != 0 {
+                operand_error = true;
+                break;
+            }
+            if blocks > 0 {
+                let distributions = rows as i32 * q.query_heads as i32;
+                if let Some(limit) = hip_bridge::grid_yz_limit_for_arch(self.arch.as_str()) {
+                    if distributions as u32 > limit {
+                        return Err(HipError::new(
+                            0,
+                            &format!(
+                                "kvmem_page_score: distributions {distributions} exceeds grid-Y limit {limit}"
+                            ),
+                        ));
+                    }
+                }
+                let mp = mp.unwrap();
+                let lp = lp.unwrap();
+                let op = op.unwrap();
+                self.page_score_logits(
+                    qp,
+                    mp,
+                    lp,
+                    blocks as i32,
+                    q.query_heads as i32,
+                    q.kv_heads as i32,
+                    q.head_dim as i32,
+                    scale,
+                    distributions,
+                )?;
+                self.page_score_normalize(lp, np, blocks as i32, distributions)?;
+                self.page_score_accumulate(lp, np, op, blocks as i32, distributions, weight)?;
+            }
+            first += rows;
+        }
+
+        if !operand_error {
+            if let Some(o) = &output {
+                self.hip.device_synchronize()?;
+                let mut scores = vec![0u8; blocks * 4];
+                self.hip.memcpy_dtoh(&mut scores, &o.buf)?;
+                for (j, chunk) in scores.chunks_exact(4).enumerate() {
+                    out[j] = f32::from_ne_bytes([chunk[0], chunk[1], chunk[2], chunk[3]]) as f64;
+                }
+            }
+        }
+
+        self.free_tensor(queries)?;
+        self.free_tensor(norms)?;
+        if let Some(t) = means_dev {
+            self.free_tensor(t)?;
+        }
+        if let Some(t) = logits {
+            self.free_tensor(t)?;
+        }
+        if let Some(t) = output {
+            self.free_tensor(t)?;
+        }
+
+        if operand_error {
+            return Err(HipError::new(
+                0,
+                "kvmem_page_score: native Query contains a nonfinite or overflowing FP16 operand",
+            ));
+        }
+        Ok(())
+    }
+
+    #[allow(clippy::too_many_arguments)]
+    fn page_score_pack(
+        &mut self,
+        input: *const c_void,
+        output: *mut c_void,
+        invalid: *mut c_void,
+        rows: u32,
+        heads: u32,
+        dim: u32,
+        row_stride: usize,
+        head_stride: usize,
+        dimension_stride: usize,
+        scalar: i32,
+        finite_required: i32,
+    ) -> HipResult<()> {
+        let count = rows as usize * heads as usize * dim as usize;
+        let grid_x = (count as u32).div_ceil(PACK_BLOCK);
+        let mut params: Vec<*mut c_void> = vec![
+            &input as *const _ as *mut c_void,
+            &output as *const _ as *mut c_void,
+            &invalid as *const _ as *mut c_void,
+            &rows as *const _ as *mut c_void,
+            &heads as *const _ as *mut c_void,
+            &dim as *const _ as *mut c_void,
+            &row_stride as *const _ as *mut c_void,
+            &head_stride as *const _ as *mut c_void,
+            &dimension_stride as *const _ as *mut c_void,
+            &scalar as *const _ as *mut c_void,
+            &finite_required as *const _ as *mut c_void,
+        ];
+        self.launch_maybe_blob(
+            PACK,
+            [grid_x, 1, 1],
+            [PACK_BLOCK, 1, 1],
+            0,
+            &mut params,
+            || {
+                let mut b = KernargBlob::new();
+                b.push_ptr(input);
+                b.push_ptr(output);
+                b.push_ptr(invalid);
+                b.push_u32(rows);
+                b.push_u32(heads);
+                b.push_u32(dim);
+                b.push_u64(row_stride as u64);
+                b.push_u64(head_stride as u64);
+                b.push_u64(dimension_stride as u64);
+                b.push_i32(scalar);
+                b.push_i32(finite_required);
+                b
+            },
+        )
+    }
+
+    #[allow(clippy::too_many_arguments)]
+    fn page_score_logits(
+        &mut self,
+        queries: *mut c_void,
+        means: *mut c_void,
+        logits: *mut c_void,
+        blocks: i32,
+        qheads: i32,
+        kvheads: i32,
+        dim: i32,
+        scale: f32,
+        distributions: i32,
+    ) -> HipResult<()> {
+        let grid_x = (blocks as u32).div_ceil(4);
+        let mut params: Vec<*mut c_void> = vec![
+            &queries as *const _ as *mut c_void,
+            &means as *const _ as *mut c_void,
+            &logits as *const _ as *mut c_void,
+            &blocks as *const _ as *mut c_void,
+            &qheads as *const _ as *mut c_void,
+            &kvheads as *const _ as *mut c_void,
+            &dim as *const _ as *mut c_void,
+            &scale as *const _ as *mut c_void,
+        ];
+        self.launch_maybe_blob(
+            LOGITS,
+            [grid_x, distributions as u32, 1],
+            [PAGE_BLOCK, 1, 1],
+            0,
+            &mut params,
+            || {
+                let mut b = KernargBlob::new();
+                b.push_ptr(queries);
+                b.push_ptr(means);
+                b.push_ptr(logits);
+                b.push_i32(blocks);
+                b.push_i32(qheads);
+                b.push_i32(kvheads);
+                b.push_i32(dim);
+                b.push_f32(scale);
+                b
+            },
+        )
+    }
+
+    fn page_score_normalize(
+        &mut self,
+        logits: *mut c_void,
+        norms: *mut c_void,
+        blocks: i32,
+        distributions: i32,
+    ) -> HipResult<()> {
+        let mut params: Vec<*mut c_void> = vec![
+            &logits as *const _ as *mut c_void,
+            &norms as *const _ as *mut c_void,
+            &blocks as *const _ as *mut c_void,
+        ];
+        self.launch_maybe_blob(
+            NORMALIZE,
+            [distributions as u32, 1, 1],
+            [PAGE_BLOCK, 1, 1],
+            0,
+            &mut params,
+            || {
+                let mut b = KernargBlob::new();
+                b.push_ptr(logits);
+                b.push_ptr(norms);
+                b.push_i32(blocks);
+                b
+            },
+        )
+    }
+
+    fn page_score_accumulate(
+        &mut self,
+        logits: *mut c_void,
+        norms: *mut c_void,
+        output: *mut c_void,
+        blocks: i32,
+        distributions: i32,
+        weight: f32,
+    ) -> HipResult<()> {
+        let grid_x = (blocks as u32).div_ceil(PAGE_BLOCK);
+        let mut params: Vec<*mut c_void> = vec![
+            &logits as *const _ as *mut c_void,
+            &norms as *const _ as *mut c_void,
+            &output as *const _ as *mut c_void,
+            &blocks as *const _ as *mut c_void,
+            &distributions as *const _ as *mut c_void,
+            &weight as *const _ as *mut c_void,
+        ];
+        self.launch_maybe_blob(
+            ACCUMULATE,
+            [grid_x, 1, 1],
+            [PAGE_BLOCK, 1, 1],
+            0,
+            &mut params,
+            || {
+                let mut b = KernargBlob::new();
+                b.push_ptr(logits);
+                b.push_ptr(norms);
+                b.push_ptr(output);
+                b.push_i32(blocks);
+                b.push_i32(distributions);
+                b.push_f32(weight);
+                b
+            },
+        )
+    }
+}
diff --git a/crates/rdna-compute/src/kvmem_tap.rs b/crates/rdna-compute/src/kvmem_tap.rs
new file mode 100644
index 000000000..469786fe0
--- /dev/null
+++ b/crates/rdna-compute/src/kvmem_tap.rs
@@ -0,0 +1,310 @@
+// SPDX-License-Identifier: Apache-2.0
+// Copyright (c) 2026 Kaden Schutt
+// hipfire — see LICENSE and NOTICE in the project root.
+
+//! KVMem statistics tap launcher (one launch per FullAttention layer).
+//!
+//! KVMem's retrieval statistics are stored in the post-RMSNorm / pre-RoPE
+//! frame (that is the frame historical K rows were summarized in), but the
+//! FA layer body applies RoPE in place to `fa_q_batch` / `fa_k_batch`. This
+//! kernel copies those rows out before the rotation, and never touches its
+//! inputs — the model arithmetic stays bit-identical to an untapped forward.
+//!
+//! See `kernels/src/kvmem_tap.hip` for the layout contract and
+//! `crates/hipfire-arch-qwen35/src/kvmem_taps.rs` for the owner of the two
+//! tap buffers.
+
+use crate::DType;
+use crate::Gpu;
+use crate::GpuTensor;
+use hip_bridge::HipError;
+use hip_bridge::HipResult;
+use std::ffi::c_void;
+
+/// Must match `kernels/src/kvmem_tap.hip`.
+pub const KVMEM_TAP_SYMBOL: &str = "kvmem_tap_f32";
+
+/// Explicit-row F32 -> BF16 Query gather; independent of the legacy slot-tail tap.
+pub const KVMEM_QUERY_CAPTURE_SYMBOL: &str = "kvmem_capture_query_bf16";
+
+const TAP_BLOCK: u32 = 256;
+
+/// Query API validation errors use hipErrorInvalidValue, never a panic or code 0.
+fn query_error(message: &str) -> HipError {
+    HipError::new(1, &format!("KVMem Query capture: {message}"))
+}
+
+/// Exact device allocation request for the optional capture, including the
+/// 256-byte minimum of each `alloc_tensor_exact` allocation. No slot or logical
+/// context multiplier: BF16 [layers, capacity, q_width] + raw u32 [capacity].
+pub fn query_capture_capacity_bytes(
+    layers: usize,
+    max_rows: usize,
+    q_width: usize,
+    capacity: usize,
+) -> HipResult<usize> {
+    if layers == 0
+        || q_width == 0
+        || q_width > i32::MAX as usize
+        || max_rows > i32::MAX as usize
+        || capacity == 0
+        || capacity > max_rows
+    {
+        return Err(query_error("invalid layers, width, max_rows or capacity"));
+    }
+    let values = layers
+        .checked_mul(capacity)
+        .and_then(|n| n.checked_mul(q_width))
+        .and_then(|n| n.checked_mul(2))
+        .ok_or_else(|| query_error("BF16 allocation size overflow"))?;
+    let indices = capacity
+        .checked_mul(std::mem::size_of::<u32>())
+        .ok_or_else(|| query_error("source-row allocation size overflow"))?;
+    values
+        .max(256)
+        .checked_add(indices.max(256))
+        .filter(|&n| n <= isize::MAX as usize)
+        .ok_or_else(|| query_error("capture allocation exceeds addressable size"))
+}
+
+/// Validate caller-selected batch rows without sorting, clipping, or allocating.
+/// Ordering is meaningful; duplicates must not count a Query token twice.
+pub fn validate_query_source_rows(
+    source_rows: &[u32],
+    max_rows: usize,
+    capacity: usize,
+) -> HipResult<()> {
+    if source_rows.len() > capacity {
+        return Err(query_error("source-row count exceeds capture capacity"));
+    }
+    for (i, &row) in source_rows.iter().enumerate() {
+        if row as usize >= max_rows {
+            return Err(query_error(&format!(
+                "source row {row} is outside {max_rows} rows"
+            )));
+        }
+        if source_rows[..i].contains(&row) {
+            return Err(query_error(&format!("duplicate source row {row}")));
+        }
+    }
+    Ok(())
+}
+
+fn query_buffer_extent(tensor: &GpuTensor, dtype: DType, bytes: usize) -> HipResult<()> {
+    let logical_bytes = tensor
+        .shape
+        .iter()
+        .try_fold(dtype.size(), |n, &dim| n.checked_mul(dim));
+    if tensor.dtype != dtype
+        || logical_bytes.is_none_or(|n| n < bytes)
+        || tensor.buf.size() < bytes
+        || tensor.buf.as_ptr().is_null()
+    {
+        return Err(query_error("invalid dtype or undersized/null buffer"));
+    }
+    Ok(())
+}
+
+fn query_buffers_overlap(a: &GpuTensor, a_bytes: usize, b: &GpuTensor, b_bytes: usize) -> bool {
+    let a_start = a.buf.as_ptr() as usize;
+    let b_start = b.buf.as_ptr() as usize;
+    match (a_start.checked_add(a_bytes), b_start.checked_add(b_bytes)) {
+        (Some(a_end), Some(b_end)) => a_start < b_end && b_start < a_end,
+        _ => true,
+    }
+}
+
+impl Gpu {
+    /// Gather explicitly selected Q rows in table order, converting only the
+    /// stored copy with HIP's `hip_bfloat16` RNE primitive. Inputs are read-only.
+    /// `source_rows` is Raw storage containing native u32 batch indices, each
+    /// `< n_rows`; the owner must validate their values before uploading them.
+    /// The destination is BF16 [capacity, q_width], with only the first
+    /// `n_query_rows` rows written. An empty selection launches nothing.
+    pub fn kvmem_capture_query_bf16(
+        &mut self,
+        q: &GpuTensor,
+        source_rows: &GpuTensor,
+        query_rows: &GpuTensor,
+        n_rows: usize,
+        n_query_rows: usize,
+        q_width: usize,
+    ) -> HipResult<()> {
+        if n_query_rows == 0 {
+            return Ok(());
+        }
+        if n_rows == 0
+            || n_rows > i32::MAX as usize
+            || n_query_rows > n_rows
+            || q_width == 0
+            || q_width > i32::MAX as usize
+        {
+            return Err(query_error("invalid gather dimensions"));
+        }
+        if hip_bridge::grid_yz_limit_for_arch(self.arch.as_str())
+            .is_some_and(|limit| n_query_rows > limit as usize)
+        {
+            return Err(query_error("selected rows exceed device grid-Y limit"));
+        }
+        let q_bytes = n_rows.checked_mul(q_width).and_then(|n| n.checked_mul(4));
+        let out_bytes = n_query_rows
+            .checked_mul(q_width)
+            .and_then(|n| n.checked_mul(2));
+        let row_bytes = n_query_rows.checked_mul(std::mem::size_of::<u32>());
+        let (Some(q_bytes), Some(out_bytes), Some(row_bytes)) = (q_bytes, out_bytes, row_bytes)
+        else {
+            return Err(query_error("gather extent overflow"));
+        };
+        query_buffer_extent(q, DType::F32, q_bytes)?;
+        query_buffer_extent(source_rows, DType::Raw, row_bytes)?;
+        query_buffer_extent(query_rows, DType::BF16, out_bytes)?;
+        if query_buffers_overlap(q, q_bytes, query_rows, out_bytes)
+            || query_buffers_overlap(source_rows, row_bytes, query_rows, out_bytes)
+            || query_buffers_overlap(q, q_bytes, source_rows, row_bytes)
+        {
+            return Err(query_error("gather buffers must not alias"));
+        }
+        self.bind_thread()?;
+        self.ensure_kernel(
+            KVMEM_QUERY_CAPTURE_SYMBOL,
+            crate::kernels::KVMEM_TAP_SRC,
+            KVMEM_QUERY_CAPTURE_SYMBOL,
+        )?;
+        let mut qp = q.buf.as_ptr();
+        let mut rp = source_rows.buf.as_ptr();
+        let mut op = query_rows.buf.as_ptr();
+        let mut nr = n_rows as i32;
+        let mut nq = n_query_rows as i32;
+        let mut qw = q_width as i32;
+        let mut params: [*mut c_void; 6] = [
+            &mut qp as *mut _ as *mut c_void,
+            &mut rp as *mut _ as *mut c_void,
+            &mut op as *mut _ as *mut c_void,
+            &mut nr as *mut _ as *mut c_void,
+            &mut nq as *mut _ as *mut c_void,
+            &mut qw as *mut _ as *mut c_void,
+        ];
+        self.launch_maybe_blob(
+            KVMEM_QUERY_CAPTURE_SYMBOL,
+            [(q_width as u32).div_ceil(TAP_BLOCK), n_query_rows as u32, 1],
+            [TAP_BLOCK, 1, 1],
+            0,
+            &mut params,
+            || {
+                let mut b = hip_bridge::KernargBlob::new();
+                b.push_ptr(qp);
+                b.push_ptr(rp);
+                b.push_ptr(op);
+                b.push_i32(nr);
+                b.push_i32(nq);
+                b.push_i32(qw);
+                b
+            },
+        )
+    }
+
+    /// Copy this step's Q/K rows into the KVMem tap buffers.
+    ///
+    /// `q` is `[n_rows, n_heads*head_dim]`, `k` is
+    /// `[n_rows, n_kv_heads*head_dim]`, both post-norm / pre-RoPE and F32.
+    /// K rows land at `k_tap[row]` for every row; Q rows land at
+    /// `q_tap[slot]` for each slot's LAST row only (`row_slot` is the
+    /// per-row slot id, packed per slot). Neither input is modified.
+    #[allow(clippy::too_many_arguments)]
+    pub fn kvmem_tap_f32(
+        &mut self,
+        q: &GpuTensor,
+        k: &GpuTensor,
+        q_tap: &GpuTensor,
+        k_tap: &GpuTensor,
+        row_slot: &GpuTensor,
+        n_rows: usize,
+        n_heads: usize,
+        n_kv_heads: usize,
+        head_dim: usize,
+        n_slots: usize,
+    ) -> HipResult<()> {
+        if n_rows == 0 || n_slots == 0 {
+            return Ok(());
+        }
+        if let Some(limit) = hip_bridge::grid_yz_limit_for_arch(self.arch.as_str()) {
+            if n_rows as u32 > limit {
+                return Err(HipError::new(
+                    0,
+                    &format!(
+                        "kvmem_tap_f32: n_rows ({n_rows}) exceeds the device grid-Y limit ({limit})"
+                    ),
+                ));
+            }
+        }
+        let q_width = n_heads * head_dim;
+        let k_width = n_kv_heads * head_dim;
+        if q.numel() < n_rows * q_width
+            || k.numel() < n_rows * k_width
+            || q_tap.numel() < n_slots * q_width
+            || k_tap.numel() < n_rows * k_width
+            || row_slot.numel() < n_rows
+        {
+            return Err(HipError::new(
+                0,
+                &format!(
+                    "kvmem_tap_f32: buffer undersized (n_rows={n_rows}, n_slots={n_slots}, \
+                     q_width={q_width}, k_width={k_width}; got q={}, k={}, q_tap={}, \
+                     k_tap={}, row_slot={})",
+                    q.numel(),
+                    k.numel(),
+                    q_tap.numel(),
+                    k_tap.numel(),
+                    row_slot.numel()
+                ),
+            ));
+        }
+        self.bind_thread()?;
+        self.ensure_kernel(
+            KVMEM_TAP_SYMBOL,
+            crate::kernels::KVMEM_TAP_SRC,
+            KVMEM_TAP_SYMBOL,
+        )?;
+        let mut qp = q.buf.as_ptr();
+        let mut kp = k.buf.as_ptr();
+        let mut qtp = q_tap.buf.as_ptr();
+        let mut ktp = k_tap.buf.as_ptr();
+        let mut rsp = row_slot.buf.as_ptr();
+        let mut nr = n_rows as i32;
+        let mut qw = q_width as i32;
+        let mut kw = k_width as i32;
+        let mut ns = n_slots as i32;
+        let mut params: Vec<*mut c_void> = vec![
+            &mut qp as *mut _ as *mut c_void,
+            &mut kp as *mut _ as *mut c_void,
+            &mut qtp as *mut _ as *mut c_void,
+            &mut ktp as *mut _ as *mut c_void,
+            &mut rsp as *mut _ as *mut c_void,
+            &mut nr as *mut _ as *mut c_void,
+            &mut qw as *mut _ as *mut c_void,
+            &mut kw as *mut _ as *mut c_void,
+            &mut ns as *mut _ as *mut c_void,
+        ];
+        let grid_x = ((q_width.max(k_width)) as u32).div_ceil(TAP_BLOCK);
+        self.launch_maybe_blob(
+            KVMEM_TAP_SYMBOL,
+            [grid_x, n_rows as u32, 2],
+            [TAP_BLOCK, 1, 1],
+            0,
+            &mut params,
+            || {
+                let mut b = hip_bridge::KernargBlob::new();
+                b.push_ptr(qp);
+                b.push_ptr(kp);
+                b.push_ptr(qtp);
+                b.push_ptr(ktp);
+                b.push_ptr(rsp);
+                b.push_i32(nr);
+                b.push_i32(qw);
+                b.push_i32(kw);
+                b.push_i32(ns);
+                b
+            },
+        )
+    }
+}
diff --git a/crates/rdna-compute/src/layerwise_pool.rs b/crates/rdna-compute/src/layerwise_pool.rs
new file mode 100644
index 000000000..dcafad451
--- /dev/null
+++ b/crates/rdna-compute/src/layerwise_pool.rs
@@ -0,0 +1,903 @@
+// SPDX-License-Identifier: Apache-2.0
+// Copyright (c) 2026 Kaden Schutt
+// hipfire — see LICENSE and NOTICE in the project root.
+
+//! Layerwise packed-page composite-slot pool + arena geometry (Phase 3.2 ①地基).
+//!
+//! This is the host substrate for the `RECALL_STRATEGY=Layerwise` subsystem. It
+//! is a CLEAN SIBLING to the legacy [`crate::page_pool::PagePool`] /
+//! [`crate::slot_pool::SlotPool`]: nothing here is wired into the live serve
+//! allocation in sub-patch ①, so the default Legacy path stays byte-neutral.
+//! Sub-patch ② drives this pool from the per-layer recall driver.
+//!
+//! # Model (ninfer-faithful packed pages, design §3.1)
+//!
+//! * One physical **composite slot** holds `block_tokens` positions × EVERY fa
+//!   layer × {Key, Value}. Its byte layout is layer-major {K, V} per layer with
+//!   `token_stride == k_gpu_row_bytes` (Q8 scales inline) — byte-for-byte the
+//!   core `raw_kv_payload_layout` record, so a sealed-archive layer region maps
+//!   straight onto a slot's layer plane with no repacking.
+//! * Each layer selects its OWN canonical pages into the shared compact extent:
+//!   slot `s`'s layer-`i` stripe comes from canonical page `pages_i[s]`, and
+//!   different layers may map different canonical pages into the same slot
+//!   (mixed-stripe destinations). A canonical page is resident iff ANY layer
+//!   selects it.
+//! * Per-layer **compact block table** = an ordered vector of physical slots
+//!   (compact position → slot); the canonical page IDs are read from the slot
+//!   stripes. This replaces the legacy one-shared-sentinel-table-per-slot.
+//! * **Shared compact extent**: every layer's `visible_tokens` is equal (the
+//!   core validates this because each layer gets an equal budget).
+//! * **Drop-evict** (design §3.7): eviction is a bare drop — the sealed host
+//!   archive is the source of truth, so there is NO write-back. A physical slot
+//!   returns to the free list only when ALL of its layer stripes have dropped.
+//!
+//! Everything here is pure host logic over plain integers (no `hipfire-kvmem`
+//! dependency): the geometry and the pool are CPU-unit-testable. The two thin
+//! GPU seams ([`PackedArenaLayout::alloc_tensor`] / [`PackedArenaLayout::stripe_views`])
+//! only apply the tested geometry through the existing `Gpu` primitives and are
+//! exercised by the sub-patch ② integration.
+
+use crate::{DType, Gpu, GpuTensor};
+use hip_bridge::HipResult;
+
+/// Tokens per composite page. Must match the engine page size
+/// ([`crate::page_pool::PAGE_TOKENS`]) and `KV_BLOCK_TOKENS` in the controller;
+/// the pool takes `block_tokens` explicitly so tests can use a small fixture.
+pub const LAYERWISE_PAGE_TOKENS: usize = 128;
+
+// =========================================================================
+// Packed arena geometry
+// =========================================================================
+
+/// Byte geometry of the shared packed arena: `n_slots` composite slots, each
+/// `block_tokens` positions × `n_layers` fa layers × {K, V}. Layer-major {K, V}
+/// per layer, matching the core `raw_kv_payload_layout` record layout exactly.
+///
+/// All sizes are pre-computed with checked arithmetic at construction, so the
+/// accessors and offset helpers cannot overflow: every offset is bounded by
+/// [`Self::arena_bytes`], which already fits `usize`.
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub struct PackedArenaLayout {
+    n_slots: usize,
+    n_layers: usize,
+    block_tokens: usize,
+    k_stride: usize,
+    v_stride: usize,
+    layer_stripe_bytes: usize,
+    slot_bytes: usize,
+    arena_bytes: usize,
+}
+
+impl PackedArenaLayout {
+    /// Resolve the geometry. Every argument must be non-zero; `n_slots` must fit
+    /// the `u32` physical-slot index space; every intermediate product is
+    /// checked. Returns `Err` (never panics) on a bad argument or overflow.
+    pub fn new(
+        n_slots: usize,
+        n_layers: usize,
+        block_tokens: usize,
+        k_stride: usize,
+        v_stride: usize,
+    ) -> Result<Self, String> {
+        if n_slots == 0 {
+            return Err("PackedArenaLayout: n_slots must be positive".to_string());
+        }
+        if n_layers == 0 {
+            return Err("PackedArenaLayout: n_layers must be positive".to_string());
+        }
+        if block_tokens == 0 {
+            return Err("PackedArenaLayout: block_tokens must be positive".to_string());
+        }
+        if k_stride == 0 {
+            return Err("PackedArenaLayout: k_stride must be positive".to_string());
+        }
+        if v_stride == 0 {
+            return Err("PackedArenaLayout: v_stride must be positive".to_string());
+        }
+        if n_slots > u32::MAX as usize {
+            return Err(format!(
+                "PackedArenaLayout: {n_slots} slots exceed the u32 slot-index space"
+            ));
+        }
+        const OVERFLOW: &str = "PackedArenaLayout: arena size overflows usize";
+        let kv_stride = k_stride
+            .checked_add(v_stride)
+            .ok_or_else(|| OVERFLOW.to_string())?;
+        let layer_stripe_bytes = block_tokens
+            .checked_mul(kv_stride)
+            .ok_or_else(|| OVERFLOW.to_string())?;
+        let slot_bytes = n_layers
+            .checked_mul(layer_stripe_bytes)
+            .ok_or_else(|| OVERFLOW.to_string())?;
+        let arena_bytes = n_slots
+            .checked_mul(slot_bytes)
+            .ok_or_else(|| OVERFLOW.to_string())?;
+        Ok(Self {
+            n_slots,
+            n_layers,
+            block_tokens,
+            k_stride,
+            v_stride,
+            layer_stripe_bytes,
+            slot_bytes,
+            arena_bytes,
+        })
+    }
+
+    pub fn n_slots(&self) -> usize {
+        self.n_slots
+    }
+    pub fn n_layers(&self) -> usize {
+        self.n_layers
+    }
+    pub fn block_tokens(&self) -> usize {
+        self.block_tokens
+    }
+    /// Per-position K row bytes (Q8: `n_kv_heads * (head_dim / 32) * 34`).
+    pub fn k_stride(&self) -> usize {
+        self.k_stride
+    }
+    /// Per-position V row bytes (Q8: equal to the K stride).
+    pub fn v_stride(&self) -> usize {
+        self.v_stride
+    }
+    /// Bytes of one layer's {K, V} stripe inside a slot
+    /// (`block_tokens * (k_stride + v_stride)`).
+    pub fn layer_stripe_bytes(&self) -> usize {
+        self.layer_stripe_bytes
+    }
+    /// Bytes of one composite slot (`n_layers * layer_stripe_bytes`). Equal to
+    /// the core record bytes for the same geometry.
+    pub fn slot_bytes(&self) -> usize {
+        self.slot_bytes
+    }
+    /// Total packed arena bytes (`n_slots * slot_bytes`).
+    pub fn arena_bytes(&self) -> usize {
+        self.arena_bytes
+    }
+    /// Bytes of one layer's K plane inside a slot (`block_tokens * k_stride`).
+    pub fn k_plane_bytes(&self) -> usize {
+        self.block_tokens * self.k_stride
+    }
+    /// Bytes of one layer's V plane inside a slot (`block_tokens * v_stride`).
+    pub fn v_plane_bytes(&self) -> usize {
+        self.block_tokens * self.v_stride
+    }
+
+    /// Byte offset of composite slot `slot` within the arena.
+    pub fn slot_base(&self, slot: usize) -> Result<usize, String> {
+        if slot >= self.n_slots {
+            return Err(format!(
+                "PackedArenaLayout: slot {slot} out of range ({} slots)",
+                self.n_slots
+            ));
+        }
+        // Bounded by arena_bytes (a valid usize), so this cannot overflow.
+        Ok(slot * self.slot_bytes)
+    }
+
+    /// Byte offset of layer `layer`'s K plane inside slot `slot`.
+    pub fn layer_k_offset(&self, slot: usize, layer: usize) -> Result<usize, String> {
+        if layer >= self.n_layers {
+            return Err(format!(
+                "PackedArenaLayout: layer {layer} out of range ({} layers)",
+                self.n_layers
+            ));
+        }
+        Ok(self.slot_base(slot)? + layer * self.layer_stripe_bytes)
+    }
+
+    /// Byte offset of layer `layer`'s V plane inside slot `slot` (its K plane
+    /// followed by `block_tokens * k_stride` bytes).
+    pub fn layer_v_offset(&self, slot: usize, layer: usize) -> Result<usize, String> {
+        Ok(self.layer_k_offset(slot, layer)? + self.k_plane_bytes())
+    }
+
+    /// Allocate the zero-filled packed arena as a raw-byte device tensor. Thin
+    /// seam over [`Gpu::zeros`]; the geometry is host-tested above. Sub-patch ②
+    /// owns the lifetime (mutually exclusive with the legacy per-layer arenas).
+    pub fn alloc_tensor(&self, gpu: &mut Gpu) -> HipResult<GpuTensor> {
+        gpu.zeros(&[self.arena_bytes], DType::Raw)
+    }
+
+    /// Non-owning {K, V} byte views of layer `layer`'s stripe inside slot `slot`.
+    /// The returned tensors are VIEWS into `arena` — never free them. Thin seam
+    /// over [`GpuTensor::sub_offset`] at the host-tested plane offsets.
+    pub fn stripe_views(
+        &self,
+        arena: &GpuTensor,
+        slot: usize,
+        layer: usize,
+    ) -> Result<(GpuTensor, GpuTensor), String> {
+        if arena.dtype != DType::Raw {
+            return Err("PackedArenaLayout: arena tensor must be DType::Raw".to_string());
+        }
+        if arena.buf.size() < self.arena_bytes {
+            return Err(format!(
+                "PackedArenaLayout: arena tensor too small ({} < {} bytes)",
+                arena.buf.size(),
+                self.arena_bytes
+            ));
+        }
+        let k_off = self.layer_k_offset(slot, layer)?;
+        let v_off = self.layer_v_offset(slot, layer)?;
+        // Raw dtype: element size 1, so offsets/lengths are byte counts.
+        Ok((
+            arena.sub_offset(k_off, self.k_plane_bytes()),
+            arena.sub_offset(v_off, self.v_plane_bytes()),
+        ))
+    }
+}
