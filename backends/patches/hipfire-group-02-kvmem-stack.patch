+            let _ = send_event(
+                &req.reply,
+                Event::Rejected {
+                    class: RejectClass::Overload,
+                    reason: format!(
+                        "page demand exceeds pool: need {needed_pages} pages, \
+                         {free} free after reclaim"
+                    ),
+                },
+            );
