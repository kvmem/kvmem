+                let _ = send_event(
+                    &req.reply,
+                    Event::Rejected {
+                        class: RejectClass::Validation,
+                        reason: format!("json_schema compile failed on admit: {e}"),
+                    },
+                );
+                release_pin_ticket(rig, &mut pin_ticket);
+                rig.sessions.close(&mut rig.pool, &mut rig.adm, id);
+                lock_stats(stats).note_rejected();
+                return None;
+            }
+        }
+    });
