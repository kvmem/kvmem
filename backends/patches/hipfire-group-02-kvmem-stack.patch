+/// Copy the thread-local error string (None when the last call succeeded).
+fn last_error() -> Option<String> {
+    let p = unsafe { ffi::hk_last_error() };
+    if p.is_null() {
+        None
+    } else {
+        Some(unsafe { CStr::from_ptr(p) }.to_string_lossy().into_owned())
+    }
+}
+
+fn err_from_last() -> KvMemError {
+    KvMemError(last_error().unwrap_or_else(|| "unknown error".to_owned()))
+}
+
+fn clear_error() {
+    unsafe { ffi::hk_clear_error() };
+}
+
+/// Run `f` with a clean diagnostic slot and map a published error to `Err`.
+fn checked(f: impl FnOnce()) -> Result<()> {
+    clear_error();
+    f();
+    match last_error() {
+        None => Ok(()),
+        Some(e) => Err(KvMemError(e)),
+    }
+}
+
+/// kvmem library/ABI version stamped by the shim.
+pub fn version() -> String {
+    let p = unsafe { ffi::hk_version() };
+    if p.is_null() {
+        String::new()
+    } else {
+        unsafe { CStr::from_ptr(p) }.to_string_lossy().into_owned()
+    }
+}
+
+/// The C ABI revision the linked shim actually implements.
+pub fn abi_version() -> u32 {
+    unsafe { ffi::hk_abi_version() }
+}
+
+/// The kvmem commit compiled into the shim (`unknown` for untracked builds).
+pub fn kvmem_commit() -> String {
+    let p = unsafe { ffi::hk_kvmem_commit() };
+    if p.is_null() {
+        String::new()
+    } else {
+        unsafe { CStr::from_ptr(p) }.to_string_lossy().into_owned()
+    }
+}
+
+fn ensure_abi() -> Result<()> {
+    let actual = abi_version();
+    if actual != HK_ABI_VERSION {
+        return Err(KvMemError(format!(
+            "C ABI version mismatch: Rust expects {HK_ABI_VERSION}, shim reports {actual}; \
+             rebuild the shim from the same kvmem checkout"
+        )));
+    }
+    Ok(())
+}
