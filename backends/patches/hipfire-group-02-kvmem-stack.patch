+    /// P4.3: fork a branch copying ONLY the mean-K index (no raw/packed KV); the
+    /// branch's payload lives in its separately shared page archive.
+    pub fn fork_mean_prefix(&self, token_pos: u32) -> Result<RawStore> {
+        clear_error();
+        let ptr = unsafe { ffi::hk_raw_store_fork_mean_prefix(self.ptr.as_ptr(), token_pos) };
+        NonNull::new(ptr)
+            .map(|ptr| Self { ptr })
+            .ok_or_else(err_from_last)
+    }
+
+    /// P4.3: export the selected packed records into an immutable snapshot.
+    pub fn export_packed(
+        &self,
+        selections: &[PackedSelection],
+        metadata_limit: usize,
+    ) -> Result<PackedSnapshot> {
+        clear_error();
+        let ptr = unsafe {
+            ffi::hk_raw_store_export_packed(
+                self.ptr.as_ptr(),
+                selections.as_ptr(),
+                selections.len(),
+                metadata_limit,
+            )
+        };
+        NonNull::new(ptr)
+            .map(|ptr| PackedSnapshot { ptr })
+            .ok_or_else(err_from_last)
+    }
+
+    /// P4.3: atomically replace ALL packed bindings from a snapshot (consumes it).
+    pub fn import_packed(&self, snapshot: PackedSnapshot, metadata_limit: usize) -> Result<()> {
+        let p = self.ptr.as_ptr();
+        let snap = snapshot.ptr.as_ptr();
+        // The shim moves out of the snapshot; forget the Rust owner so Drop does
+        // not double-free the consumed handle.
+        std::mem::forget(snapshot);
+        checked(|| unsafe { ffi::hk_raw_store_import_packed(p, snap, metadata_limit) })
+    }
+
+    /// 期3 G4: any sealed packed record in blocks `[0, blocks)`.
+    pub fn has_packed(&self, blocks: u32) -> bool {
+        unsafe { ffi::hk_raw_store_has_packed(self.ptr.as_ptr(), blocks) != 0 }
+    }
+
+    /// 期3 G3 P1.1: write this store's `blocks`-block packed prefix (K/V +
+    /// Mean-K sums) and the opaque adapter metadata into an atomic pack file.
+    pub fn write_prefix_pack(&self, blocks: u32, path: &Path, meta: &[u8]) -> Result<()> {
+        let c = CString::new(path.to_string_lossy().as_bytes())
+            .map_err(|e| KvMemError(format!("pack path: {e}")))?;
+        let p = self.ptr.as_ptr();
+        checked(|| unsafe {
+            let _ = ffi::hk_raw_store_write_prefix_pack(
+                p,
+                blocks,
+                c.as_ptr(),
+                if meta.is_empty() {
+                    ptr::null()
+                } else {
+                    meta.as_ptr()
+                },
+                meta.len(),
+            );
+        })
+    }
+
+    /// 期3 G3 P1.1: read a pack's header only (cold-index scans).
+    pub fn prefix_pack_info(path: &Path) -> Result<PrefixPackInfo> {
+        let c = CString::new(path.to_string_lossy().as_bytes())
+            .map_err(|e| KvMemError(format!("pack path: {e}")))?;
+        let mut out = PrefixPackInfo::default();
+        clear_error();
+        let rc = unsafe { ffi::hk_prefix_pack_info_read(c.as_ptr(), &mut out) };
+        if rc != 0 {
+            return Err(
+                last_error().map_or_else(|| KvMemError("pack info failed".to_string()), KvMemError)
+            );
+        }
+        Ok(out)
+    }
+
+    /// 期3 G3 P1.1: read only a pack's adapter metadata (cold-index scans;
+    /// never loads the payload).
+    pub fn prefix_pack_meta(path: &Path) -> Result<Vec<u8>> {
+        let c = CString::new(path.to_string_lossy().as_bytes())
+            .map_err(|e| KvMemError(format!("pack path: {e}")))?;
+        let info = Self::prefix_pack_info(path)?;
+        let mut meta = vec![0u8; info.meta_bytes as usize];
+        let mut meta_len = 0usize;
+        clear_error();
+        let rc = unsafe {
+            ffi::hk_prefix_pack_meta_read(
+                c.as_ptr(),
+                if meta.is_empty() {
+                    ptr::null_mut()
+                } else {
+                    meta.as_mut_ptr()
+                },
+                meta.len(),
+                &mut meta_len,
+            )
+        };
+        if rc != 0 {
+            return Err(last_error().map_or_else(
+                || KvMemError("pack meta read failed".to_string()),
+                KvMemError,
+            ));
+        }
+        meta.truncate(meta_len.min(meta.len()));
+        Ok(meta)
+    }
+
+    /// 期3 G3 P1.1: load a pack's payload into this (empty) store; geometry
+    /// must match. The adapter metadata is returned to the caller.
+    pub fn read_prefix_pack(&self, path: &Path) -> Result<Vec<u8>> {
+        let c = CString::new(path.to_string_lossy().as_bytes())
+            .map_err(|e| KvMemError(format!("pack path: {e}")))?;
+        let info = Self::prefix_pack_info(path)?;
+        let mut meta = vec![0u8; info.meta_bytes as usize];
+        let mut meta_len = 0usize;
+        let p = self.ptr.as_ptr();
+        clear_error();
+        let rc = unsafe {
+            ffi::hk_raw_store_read_prefix_pack(
+                p,
+                c.as_ptr(),
+                if meta.is_empty() {
+                    ptr::null_mut()
+                } else {
+                    meta.as_mut_ptr()
+                },
+                meta.len(),
+                &mut meta_len,
+            )
+        };
+        if rc != 0 {
+            return Err(
+                last_error().map_or_else(|| KvMemError("pack read failed".to_string()), KvMemError)
+            );
+        }
+        meta.truncate(meta_len.min(meta.len()));
+        Ok(meta)
+    }
+
+    /// 期3 G4: capture one immutable core `KvSnapshot` over the sealed packed
+    /// records of blocks `[0, blocks)` (block-major, layer-major, K then V).
+    /// `previous` lets the capture inherit a block origin when the record's
+    /// storage identity matches (no byte copy, quota charged once). The caller
+    /// has drained native writers — `fork_prefix` sealed the records.
+    pub fn capture_snapshot(
+        &self,
+        blocks: u32,
+        previous: Option<&KvSnapshot>,
+    ) -> Result<KvSnapshot> {
+        clear_error();
+        let prev = previous.map_or(ptr::null(), |s| s.ptr.as_ptr() as *const _);
+        let ptr = unsafe { ffi::hk_raw_store_capture_snapshot(self.ptr.as_ptr(), blocks, prev) };
+        NonNull::new(ptr)
+            .map(|ptr| KvSnapshot { ptr })
+            .ok_or_else(err_from_last)
+    }
+}
