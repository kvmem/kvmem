+    /// meaningful when [`Self::head_plane_enabled`].
+    pub fn aux_ordinal(&self) -> u32 {
+        self.aux_ordinal
+    }
+
+    /// P4.1② G3: lazily construct slot `slot`'s session-lifetime head resident
+    /// map (design §A.8), the head-plane sibling of
