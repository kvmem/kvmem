+            .sessions
+            .begin_turn(&mut rig.pool, id, &req.prompt_tokens)
+        {
+            Ok(p) => p,
+            Err(e) => {
+                let _ = send_event(
+                    &req.reply,
+                    Event::Rejected {
+                        class: RejectClass::Internal,
+                        reason: e,
+                    },
+                );
+                rig.sessions.close(&mut rig.pool, &mut rig.adm, id);
+                lock_stats(stats).note_rejected();
+                return;
+            }
+        };
+        plan.reused
+    };
