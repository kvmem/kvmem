-        &mut rig.gpu,
-        &rig.pool,
-        slot,
-        &rig.model.k_arenas,
-        &rig.model.v_arenas,
-        &dn_refs,
-        &tokens,
-        rig.stamp,
-    );
-    drop(dn_refs);
-
-    let evicted = match snap {
-        Ok(snap) => match rig.swap.park(victim.0, snap) {
-            Ok(()) => {
-                rig.sessions
-                    .mark_swapped(&mut rig.pool, &mut rig.adm, victim);
-                true
-            }
-            Err(e) => {
-                warn_once(
-                    &SWAP_PARK_WARNED,
