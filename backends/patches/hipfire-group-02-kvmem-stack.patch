+/// A caller-owned output pressure snapshot handle (for inspect/restore).
+pub struct OutputSnapshotRef {
+    ptr: NonNull<HkOutputSnapshot>,
+}
+
+impl OutputSnapshotRef {
+    pub fn session(&self) -> Result<SessionIdentity> {
+        let mut out: SessionIdentity = unsafe { std::mem::zeroed() };
+        let p = self.ptr.as_ptr();
+        checked(|| unsafe {
+            ffi::hk_output_snapshot_session(p, &mut out);
+        })?;
+        Ok(out)
+    }
+    pub fn layer_count(&self) -> usize {
+        unsafe { ffi::hk_output_snapshot_layer_count(self.ptr.as_ptr()) }
+    }
+
+    /// Materialize the complete owned snapshot.
+    pub fn read(&self) -> Result<OutputSnapshot> {
+        let session = self.session()?;
+        let p = self.ptr.as_ptr();
+        let mut request = 0u64;
+        let mut accepted_end = 0u64;
+        let mut active = 0 as c_int;
+        let mut thinking = 0 as c_int;
+        let mut action = 0 as c_int;
+        let mut parser_tokens = 0u64;
+        checked(|| unsafe {
+            ffi::hk_output_snapshot_meta(
+                p,
+                &mut request,
+                &mut accepted_end,
+                &mut active,
+                &mut thinking,
+                &mut action,
+                &mut parser_tokens,
+            );
+        })?;
+        let parser = OutputParserState {
+            thinking: thinking != 0,
+            action: action != 0,
+            tokens: parser_tokens,
+        };
+        let n = unsafe { ffi::hk_output_snapshot_layer_count(p) };
+        let mut layers = Vec::with_capacity(n);
+        for i in 0..n {
+            let mut model_layer = 0u32;
+            let mut samples = 0u64;
+            let mut rounds = 0u64;
+            checked(|| unsafe {
+                ffi::hk_output_snapshot_layer(p, i, &mut model_layer, &mut samples, &mut rounds);
+            })?;
+            let read_pairs = |count: usize,
+                              get: &dyn Fn(usize, &mut u64, &mut f64) -> Result<()>|
+             -> Result<Vec<(u64, f64)>> {
+                let mut v = Vec::with_capacity(count);
+                for j in 0..count {
+                    let mut start = 0u64;
+                    let mut score = 0f64;
+                    get(j, &mut start, &mut score)?;
+                    v.push((start, score));
+                }
+                Ok(v)
+            };
+            let sc = unsafe { ffi::hk_output_snapshot_score_count(p, i) };
+            let scores = read_pairs(sc, &|j, start, score| {
+                checked(|| unsafe {
+                    ffi::hk_output_snapshot_score(p, i, j, start, score);
+                })
+            })?;
+            let pc = unsafe { ffi::hk_output_snapshot_pending_count(p, i) };
+            let pending = read_pairs(pc, &|j, start, score| {
+                checked(|| unsafe {
+                    ffi::hk_output_snapshot_pending(p, i, j, start, score);
+                })
+            })?;
+            layers.push(OutputState {
+                model_layer,
+                scores,
+                pending,
+                samples,
+                rounds,
+            });
+        }
+        Ok(OutputSnapshot {
+            session,
+            layers,
+            parser,
+            request,
+            accepted_end,
+            active: active != 0,
+        })
+    }
+}
