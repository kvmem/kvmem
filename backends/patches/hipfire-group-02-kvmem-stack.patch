+/// Choose the directory slot for one publication. `None` means publish nothing
+/// (the reason explains why); a returned index equal to `slots.len()` appends.
+pub fn select_content_publication(
+    slots: &[ContentSlot],
+    max_entries: usize,
+    incoming_identity: Option<u64>,
+) -> Result<(Option<usize>, PublicationReason)> {
+    let mut reason = 0i32;
+    clear_error();
+    let slot = unsafe {
+        ffi::hk_content_publication(
+            slots.as_ptr(),
+            slots.len(),
+            max_entries,
+            incoming_identity.unwrap_or(0),
+            &mut reason,
+        )
+    };
+    if let Some(e) = last_error() {
+        return Err(KvMemError(e));
+    }
+    let slot = if slot < 0 { None } else { Some(slot as usize) };
+    let reason = PublicationReason::from_ordinal(reason)
+        .ok_or_else(|| KvMemError(format!("unknown publication reason {reason}")))?;
+    Ok((slot, reason))
+}
+
+/// Eviction victim (redundant group versions first, then LRU); `None` when
+/// nothing is evictable.
+pub fn select_content_eviction(slots: &[ContentSlot]) -> Result<Option<usize>> {
+    clear_error();
+    let v = unsafe { ffi::hk_content_eviction(slots.as_ptr(), slots.len()) };
+    if let Some(e) = last_error() {
+        return Err(KvMemError(e));
+    }
+    Ok(if v < 0 { None } else { Some(v as usize) })
+}
+
+/// Group-aware publication: chosen slot (or `slots.len()` = append), reason and
+/// the retired slots that must be released.
+pub fn plan_content_group_publication(
+    slots: &[ContentSlot],
+    max_entries: usize,
+    max_groups: usize,
+    incoming_group: u64,
+) -> Result<(Option<usize>, PublicationReason, Vec<usize>)> {
+    let mut slot = usize::MAX;
+    let mut reason = 0i32;
+    let mut count = 0usize;
+    clear_error();
+    let rc = unsafe {
+        ffi::hk_content_group_publication(
+            slots.as_ptr(),
+            slots.len(),
+            max_entries,
+            max_groups,
+            incoming_group,
+            &mut slot,
+            &mut reason,
+            ptr::null_mut(),
+            0,
+            &mut count,
+        )
+    };
+    if rc != 0 {
+        return Err(err_from_last());
+    }
+    let mut retired = vec![0usize; count];
+    let rc = unsafe {
+        ffi::hk_content_group_publication(
+            slots.as_ptr(),
+            slots.len(),
+            max_entries,
+            max_groups,
+            incoming_group,
+            &mut slot,
+            &mut reason,
+            retired.as_mut_ptr(),
+            retired.len(),
+            &mut count,
+        )
+    };
+    if rc != 0 {
+        return Err(err_from_last());
+    }
+    retired.truncate(count.min(retired.len()));
+    let slot = if slot == usize::MAX { None } else { Some(slot) };
+    let reason = PublicationReason::from_ordinal(reason)
+        .ok_or_else(|| KvMemError(format!("unknown publication reason {reason}")))?;
+    Ok((slot, reason, retired))
+}
+
+/// Mirrors `kvmem::LayerwiseSelectionPhase` ordinals (the private-probe phase).
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+#[repr(u32)]
+pub enum ProbePhase {
+    Collecting = 0,
+    Complete = 1,
+    Aborted = 2,
+}
+
+impl ProbePhase {
+    pub fn from_u32(v: u32) -> Self {
+        match v {
+            0 => Self::Collecting,
+            1 => Self::Complete,
+            _ => Self::Aborted,
+        }
+    }
+}
+
+/// The pinned upstream private-probe global Mean-K reduction for the MTP head
+/// history (UpstreamGlobal policy), mirroring `kvmem::LayerwiseProbeSelection`.
+///
+/// Scoring/selection ONLY: the hipfire driver owns the private target-layer-major
+/// forward, the exact source/rollback envelope and the GPU scorer. Each
+/// [`Self::append_native`] supplies the private TARGET forward's normalized
+/// pre-RoPE Q; the core averages the target layers (one global reduction, NOT the
+/// real fresh forward) and [`Self::finish`] picks the head history. The
+/// `policy`/`keys`/`metadata` handles are borrowed and must outlive the selection;
+/// the frozen result keeps its metadata charged until both the accumulator and
+/// the result retire (Drop). Neither `Send` nor `Sync` (the serve loop serializes
+/// the C ABI). ZERO core C++ change.
+pub struct ProbeSelection {
+    ptr: NonNull<HkProbeSelection>,
+    // Ownership anchor for the C SourceRevision trampoline's user pointer; freed
+    // only after the C++ accumulator is destroyed (see Drop).
+    #[allow(dead_code)]
+    revision: Box<RevisionState>,
+}
+
+impl ProbeSelection {
+    /// Conservative metadata bound (bytes) to reserve against an independent
+    /// FINITE metadata account BEFORE [`Self::new`].
+    pub fn metadata_bound(policy: &KvStore, target_layers: u32) -> Result<u64> {
+        let mut out = 0u64;
+        checked(|| unsafe {
+            ffi::hk_probe_metadata_bound(policy.ptr.as_ptr(), target_layers, &mut out);
+        })?;
+        Ok(out)
+    }
+
+    /// Admit a private-probe selection. `targets` are the private forward's target
+    /// FA layers in token-major scoring order; `metadata` is the finite account
+    /// reserved via [`Self::metadata_bound`]; `revision` proves the frozen index
+    /// stamp at each native boundary; `mandatory` are pinned canonical ordinals.
+    pub fn new(
+        identity: &LayerwiseIdentity,
+        policy: &KvStore,
+        keys: &RawStore,
+        targets: &[LayerQueryGeometry],
+        revision: impl FnMut() -> MemoryStamp + 'static,
+        metadata: &Storage,
+        mandatory: &[u32],
+    ) -> Result<Self> {
+        let mut state = Box::new(RevisionState {
+            f: Box::new(revision),
+        });
+        let user = &mut *state as *mut RevisionState as *mut c_void;
+        clear_error();
+        let ptr = unsafe {
+            ffi::hk_probe_create(
+                identity,
+                policy.ptr.as_ptr(),
+                keys.ptr.as_ptr(),
+                targets.as_ptr(),
+                targets.len(),
+                Some(revision_trampoline),
+                user,
+                metadata.ptr.as_ptr(),
+                mandatory.as_ptr(),
+                mandatory.len(),
+            )
+        };
+        NonNull::new(ptr)
+            .map(|ptr| Self {
+                ptr,
+                revision: state,
+            })
+            .ok_or_else(err_from_last)
+    }
+
+    /// Abort the probe (idempotent); moves the phase to `Aborted`.
+    pub fn abort(&self) {
+        unsafe { ffi::hk_probe_abort(self.ptr.as_ptr()) };
+    }
+    pub fn phase(&self) -> ProbePhase {
+        ProbePhase::from_u32(unsafe { ffi::hk_probe_phase(self.ptr.as_ptr()) })
+    }
+    pub fn scored_rows(&self) -> u64 {
+        unsafe { ffi::hk_probe_scored_rows(self.ptr.as_ptr()) }
+    }
+    pub fn next_layer(&self) -> u32 {
+        unsafe { ffi::hk_probe_next_layer(self.ptr.as_ptr()) }
+    }
+    pub fn metadata_bytes(&self) -> u64 {
+        unsafe { ffi::hk_probe_metadata_bytes(self.ptr.as_ptr()) }
+    }
+
+    /// Token-major: for each Query tile `[begin,begin+rows)` append every target
+    /// layer in geometry order, letting the owner's `scorer` compute per-block
+    /// page mass against the frozen frame. Same native scorer contract as
+    /// [`LayerwiseRequest::projected_native`]: complete the native stream before
+    /// returning and write exactly `frame.starts.len()` non-negative scores.
+    pub fn append_native<F>(
+        &self,
+        id: &LayerwiseIdentity,
+        begin: u64,
+        query: &NativeCurrentLayerQuery,
+        mut scorer: F,
+    ) -> Result<()>
+    where
+        F: FnMut(&NativeCurrentLayerQuery, &QueryScoreFrame<'_>) -> Result<Vec<f64>>,
+    {
+        let p = self.ptr.as_ptr();
+        let user = &mut scorer as *mut F as *mut c_void;
+        checked(|| unsafe {
+            ffi::hk_probe_append_native(p, id, begin, query, Some(scorer_trampoline::<F>), user);
+        })
+    }
+
+    /// Requires every Query target covered; picks the head history (phase
+    /// `Complete`). The frozen result is then readable via the accessors below.
+    pub fn finish(&self, id: &LayerwiseIdentity) -> Result<()> {
+        let p = self.ptr.as_ptr();
+        checked(|| unsafe {
+            ffi::hk_probe_finish(p, id);
+        })
+    }
+
+    // ── frozen result (available only after a successful finish) ──
+    pub fn selected_count(&self) -> usize {
+        unsafe { ffi::hk_probe_selected_count(self.ptr.as_ptr()) }
+    }
+    pub fn selected(&self, i: usize) -> u32 {
+        unsafe { ffi::hk_probe_selected(self.ptr.as_ptr(), i) }
+    }
+    /// The selected canonical head-history block IDs (chronological pick order).
+    pub fn selected_ids(&self) -> Vec<u32> {
+        (0..self.selected_count())
+            .map(|i| self.selected(i))
+            .collect()
+    }
+    pub fn fixed_count(&self) -> usize {
+        unsafe { ffi::hk_probe_fixed_count(self.ptr.as_ptr()) }
+    }
+    pub fn fixed(&self, i: usize) -> u32 {
+        unsafe { ffi::hk_probe_fixed(self.ptr.as_ptr(), i) }
+    }
+    pub fn score_count(&self) -> usize {
+        unsafe { ffi::hk_probe_score_count(self.ptr.as_ptr()) }
+    }
+    pub fn score(&self, i: usize) -> Result<f64> {
+        let mut out = 0f64;
+        let p = self.ptr.as_ptr();
+        checked(|| unsafe {
+            ffi::hk_probe_score(p, i, &mut out);
+        })?;
+        Ok(out)
+    }
+    pub fn historical_tokens(&self) -> u64 {
+        unsafe { ffi::hk_probe_historical_tokens(self.ptr.as_ptr()) }
+    }
+    pub fn charged_tokens(&self) -> u64 {
+        unsafe { ffi::hk_probe_charged_tokens(self.ptr.as_ptr()) }
+    }
+}
+
+impl Drop for ProbeSelection {
+    fn drop(&mut self) {
+        // Destroy the C++ accumulator first (its SourceRevision lambda can no
+        // longer call the trampoline); the result's metadata lease retires here
+        // too; `self.revision` is freed afterwards.
+        unsafe { ffi::hk_probe_destroy(self.ptr.as_ptr()) };
+    }
+}
+
+#[cfg(test)]
+mod legacy_ffi_tests {
+    use super::*;
+
+    fn scored_store() -> KvStore {
+        let kv = KvStore::new(&KvStoreConfig {
+            block_tokens: 4,
+            lrfu: 1,
+            lrfu_top_fraction: 1.0,
+            ..KvStoreConfig::default()
+        })
+        .unwrap();
+        kv.register_append(12).unwrap();
+        kv.begin_retrieval_round().unwrap();
+        kv.set_retrieval_scores(&[1.0, 2.0, 3.0]).unwrap();
+        assert!(kv.commit_retrieval_round().unwrap());
+        kv
+    }
+
+    #[test]
+    fn null_handles_and_outputs_never_report_success() {
+        let kv = scored_store();
+        let snapshot = kv.retrieval_checkpoint().unwrap();
+        let p = snapshot.ptr.as_ptr();
+        let k = kv.ptr.as_ptr();
+        let mut round = 0;
+        let mut committed = 0;
+        let mut count = 0;
+        let mut score = 0.0;
+        unsafe {
+            assert!(ffi::hk_kv_store_retrieval_checkpoint(ptr::null()).is_null());
+            assert!(last_error().is_some());
+            assert!(ffi::hk_retrieval_checkpoint_clone(ptr::null()).is_null());
+            assert!(last_error().is_some());
+            assert_eq!(ffi::hk_kv_store_restore_retrieval(ptr::null_mut(), p), -1);
+            assert_eq!(ffi::hk_kv_store_restore_retrieval(k, ptr::null()), -1);
+            assert_eq!(
+                ffi::hk_retrieval_checkpoint_meta(ptr::null(), &mut round, &mut committed),
+                -1
+            );
+            assert_eq!(
+                ffi::hk_retrieval_checkpoint_meta(p, ptr::null_mut(), &mut committed),
+                -1
+            );
+            assert_eq!(
+                ffi::hk_retrieval_checkpoint_meta(p, &mut round, ptr::null_mut()),
+                -1
+            );
+            assert_eq!(
+                ffi::hk_retrieval_checkpoint_scores(ptr::null(), ptr::null_mut(), 0, &mut count),
+                -1
+            );
+            assert_eq!(
+                ffi::hk_kv_store_selection_score(ptr::null(), 0, &mut score),
+                -1
+            );
+            assert_eq!(ffi::hk_kv_store_selection_score(k, 0, ptr::null_mut()), -1);
+            assert_eq!(ffi::hk_kv_store_selection_score(k, 3, &mut score), -1);
+            assert_eq!(ffi::hk_bounded_query(0, 1, 1, 1, ptr::null_mut()), -1);
+            assert_eq!(
+                ffi::hk_query_replay_plan(
+                    QueryRange { begin: 0, end: 1 },
+                    0,
+                    1,
+                    1,
+                    1,
+                    0,
+                    1,
+                    0,
+                    ptr::null_mut()
+                ),
+                -1
+            );
+            ffi::hk_retrieval_checkpoint_destroy(ptr::null_mut());
+            assert!(last_error().is_some());
+            assert_eq!(ffi::hk_kv_store_selection_score(k, 0, &mut score), 0);
+            assert_eq!(score, 1.0);
+            assert!(
+                last_error().is_none(),
+                "successful FFI clears the prior error"
+            );
+        }
+    }
+
+    fn check_output<T: Copy + PartialEq + fmt::Debug>(
+        mut f: impl FnMut(*mut T, usize, *mut usize) -> c_int,
+        expected: &[T],
+        sentinel: T,
+    ) {
+        let mut count = 0;
+        assert_eq!(f(ptr::null_mut(), 0, &mut count), 0);
+        assert_eq!(count, expected.len());
+        let mut buffer = vec![sentinel; count + 1];
+        assert_eq!(f(buffer.as_mut_ptr(), count - 1, &mut count), -2);
+        assert_eq!(count, expected.len());
+        assert!(buffer.iter().all(|v| *v == sentinel), "no partial writes");
+        assert!(last_error().unwrap().contains("capacity"));
+        assert_eq!(f(buffer.as_mut_ptr(), buffer.len(), &mut count), 0);
+        assert_eq!(&buffer[..count], expected);
+        assert_eq!(
+            buffer[count], sentinel,
+            "no write beyond the returned count"
+        );
+        assert!(last_error().is_none());
+        assert_eq!(f(ptr::null_mut(), 1, &mut count), -1);
+        assert_eq!(f(buffer.as_mut_ptr(), buffer.len(), ptr::null_mut()), -1);
+        assert_eq!(f(buffer.as_mut_ptr(), usize::MAX, &mut count), -1);
+    }
+
+    #[test]
+    fn vector_outputs_report_required_capacity_and_never_partially_write() {
+        let kv = scored_store();
+        let snapshot = kv.retrieval_checkpoint().unwrap();
+        check_output(
+            |out, capacity, count| unsafe {
+                ffi::hk_retrieval_checkpoint_scores(snapshot.ptr.as_ptr(), out, capacity, count)
+            },
+            &[1.0, 2.0, 3.0],
+            99.0,
+        );
+        check_output(
+            |out, capacity, count| unsafe {
+                ffi::hk_pressure_selection(
+                    [3, 1, 2].as_ptr(),
+                    3,
+                    [1.0; 3].as_ptr(),
+                    3,
+                    ptr::null(),
+                    0,
+                    2,
+                    out,
+                    capacity,
+                    count,
+                )
+            },
+            &[2, 3],
+            99,
+        );
+        check_output(
+            |out, capacity, count| unsafe {
+                ffi::hk_query_prefix_required(9, 4, 1, 0, ptr::null(), 0, out, capacity, count)
+            },
+            &[0, 2],
+            99,
+        );
+    }
+
+    #[test]
+    fn invalid_spans_are_rejected_before_dereferencing_or_narrowing() {
+        let mut count = 0;
+        let id = 1u32;
+        let score = 1.0f64;
+        let mut pressure = |c, nc, s, ns, m, nm| unsafe {
+            ffi::hk_pressure_selection(c, nc, s, ns, m, nm, 1, ptr::null_mut(), 0, &mut count)
+        };
+        assert_eq!(pressure(ptr::null(), 1, &score, 1, ptr::null(), 0), -1);
+        assert_eq!(pressure(&id, 1, ptr::null(), 1, ptr::null(), 0), -1);
+        assert_eq!(pressure(&id, 1, &score, 1, ptr::null(), 1), -1);
+        assert_eq!(
+            pressure(&id, usize::MAX, &score, usize::MAX, ptr::null(), 0),
+            -1
+        );
+        let misaligned = unsafe { (&id as *const u32).cast::<u8>().add(1).cast::<u32>() };
+        assert_eq!(pressure(misaligned, 1, &score, 1, ptr::null(), 0), -1);
+        let mut prefix = |media, len| unsafe {
+            ffi::hk_query_prefix_required(4, 4, 0, 0, media, len, ptr::null_mut(), 0, &mut count)
+        };
+        assert_eq!(prefix(ptr::null(), 1), -1);
+        assert_eq!(prefix(&id, usize::MAX), -1);
+        assert_eq!(prefix(misaligned, 1), -1);
+    }
+
+    #[test]
+    fn diagnostic_slots_are_thread_local_and_rust_errors_are_owned() {
+        use std::sync::mpsc;
+        let (ready_tx, ready_rx) = mpsc::channel();
+        let (done_tx, done_rx) = mpsc::channel();
+        clear_error();
+        let worker = std::thread::spawn(move || {
+            let status = unsafe { ffi::hk_bounded_query(0, 1, 1, 1, ptr::null_mut()) };
+            assert_eq!(status, -1);
+            let message = last_error().unwrap();
+            ready_tx.send(()).unwrap();
+            done_rx.recv().unwrap();
+            assert_eq!(
+                last_error().unwrap(),
+                message,
+                "other thread cannot clear this error"
+            );
+            let owned = legacy_status(status).unwrap_err();
+            bounded_query(0, 1, 1, 1).unwrap();
+            assert!(last_error().is_none());
+            owned
+        });
+        ready_rx.recv().unwrap();
+        assert!(
+            last_error().is_none(),
+            "worker's error must not leak into this thread"
+        );
+        bounded_query(0, 1, 1, 1).unwrap();
+        done_tx.send(()).unwrap();
+        assert!(worker.join().unwrap().0.contains("buffer"));
+    }
+}
