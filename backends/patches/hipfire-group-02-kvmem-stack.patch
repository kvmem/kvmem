+    /// P4.1② G4 driver-level integration: attaching the head subsystem to a real
+    /// [`LayerwiseDriver`] switches the seal/restore EXPORT manifest AND the
+    /// planning descriptor to the composite Main+aux layout, allocates the bounded
+    /// head arena, and lets BOTH planes restore byte-exact from ONE shared
+    /// composite record. Proves the ninfer-faithful shared-archive contract
+    /// end-to-end through the public driver API:
+    /// (1) a trunk [`LayerwiseDriver::restore_layer_selected`] (ordinal 0) seals the
+    ///     cold page's COMPOSITE record once and restores trunk plane 0 byte-exact —
+    ///     the composite export does NOT perturb the trunk stripe (the trunk plane
+    ///     stays byte-neutral, exactly as Legacy/AR see it);
+    /// (2) [`LayerwiseDriver::restore_head_plane`] reads the AUX region of that SAME
+    ///     cached record (no re-seal) into the bounded head arena, byte-exact at the
+    ///     aux ordinal. `sealed_records() == 1` after both confirms the trunk and
+    ///     head share ONE composite archive keyed by page id. Mirrors ninfer's single
+    ///     shared composite descriptor for both catalogs (NL:10578-10584) and the
+    ///     head aux-stripe restore (NL:10274-10287).
+    #[test]
+    #[ignore]
+    fn driver_head_plane_attach_restore_integration() {
+        let mut gpu = Gpu::init().expect("gpu");
+        let mtp =
+            LayerwiseMtpQ8Layout::resolve(KvMode::Q8, FX_LAYERS as usize, FX_KV_HEADS, FX_HEAD_DIM)
+                .expect("mtp layout");
+        let aux = mtp.head_layer();
+        let composite_record = mtp
+            .payload_layout()
+            .expect("composite manifest")
+            .record_bytes();
+        assert_eq!(composite_record, (FX_LAYERS as u64 + 1) * FX_LAYER_BYTES);
+
+        // Composite statistics store: trunk planes 0..n_fa AND the head aux plane,
+        // both canonical pages (the head co-archives into the SAME RawStore).
+        let keys_storage = Storage::new_ram(16 << 20).expect("keys storage");
+        let mut cfg = mtp.main().raw_config().clone();
+        cfg.n_layer = mtp.n_layer_total() as u32;
+        let keys = RawStore::new(cfg, Some(&keys_storage)).expect("keys");
+        keys.ensure_blocks(3).expect("ensure blocks");
+        for b in 0..2u32 {
+            for il in 0..mtp.n_layer_total() as u32 {
+                keys.write_layer_k_gpu(b * FX_BT, FX_BT, il, &fx_pack(b, il, false))
+                    .expect("K");
+                keys.write_layer_v_gpu(b * FX_BT, FX_BT, il, &fx_pack(b, il, true))
+                    .expect("V");
+            }
+        }
+        // Partial boundary page (dense ordinal 2): 64 already-fed tokens in every
+        // plane — the head draft-scratch suffix source. The rest of the page is
+        // masked by the compacted causal bound the suffix restore publishes.
+        let row_bytes = FX_PLANE as usize / FX_BT as usize;
+        for il in 0..mtp.n_layer_total() as u32 {
+            keys.write_layer_k_gpu(2 * FX_BT, 64, il, &fx_pack(2, il, false)[..64 * row_bytes])
+                .expect("partial K");
+            keys.write_layer_v_gpu(2 * FX_BT, 64, il, &fx_pack(2, il, true)[..64 * row_bytes])
+                .expect("partial V");
+        }
+
+        // Trunk driver: n_fa-layer device arena + trunk manifest (the default).
+        let q8 = fx_layout();
+        let policy = KvStore::new(&KvStoreConfig {
+            block_tokens: FX_BT,
+            select_budget: FX_BT,
+            sink_blocks: 0,
+            recent_blocks: 0,
+            ..Default::default()
+        })
+        .expect("policy");
+        policy.register_append(FX_FRONTIER as u32).expect("append");
+        let mut driver = LayerwiseDriver::new(
+            &mut gpu,
+            &keys,
+            &policy,
+            &q8,
+            fx_backend(),
+            fx_capabilities(),
+            fx_snapshots(),
+            3,
+            16 << 20,
+        )
+        .expect("driver");
+        assert!(
+            !driver.head_plane_attached(),
+            "head absent before attach (Legacy default)"
+        );
+
+        // Attach the head subsystem: composite export + descriptor, bounded head
+        // arena + its own paged block-table staging (width 1 = single draft row).
+        driver
+            .attach_head_plane(&mut gpu, &mtp, FX_KV_HEADS, FX_HEAD_DIM, 3, 1, 4096)
+            .expect("attach_head_plane");
+        assert!(driver.head_plane_attached());
+
+        // (1) Trunk restore ordinal 0, cold page 200. The budget covers the COMPOSITE
+        // record (host_records × composite record_bytes), not the trunk record.
+        let trunk_budget = MemoryBudget {
+            selected_tokens: FX_BT as u64,
+            reserve_tokens: FX_BT as u64,
+            device_tokens: 2 * FX_BT as u64,
+            host_payload_bytes: 2 * composite_record,
+        };
+        let trunk_view = driver
+            .restore_layer_selected(&mut gpu, 0, &[200], trunk_budget)
+            .expect("trunk restore");
+        assert_eq!(trunk_view.blocks.len(), 1);
+        assert_eq!(trunk_view.blocks[0].block.id, 200);
+        // The composite export sealed ONE record (the cold page); trunk plane 0 bound.
+        assert_eq!(driver.sealed_records(), 1);
+        assert_eq!(
+            driver.arena().pool_ref().canonical_pages(0).unwrap(),
+            vec![1]
+        );
+        let phys = driver.arena().pool_ref().compact_slots(0).unwrap()[0];
+        let k_off = driver
+            .arena()
+            .layout()
+            .layer_k_offset(phys as usize, 0)
+            .unwrap();
+        let v_off = driver
+            .arena()
+            .layout()
+            .layer_v_offset(phys as usize, 0)
+            .unwrap();
+        let mut k_read = vec![0u8; FX_PLANE as usize];
+        let mut v_read = vec![0u8; FX_PLANE as usize];
+        gpu.hip
+            .memcpy_dtoh_at(&mut k_read, &driver.arena().arena().buf, k_off)
+            .expect("trunk d2h K");
+        gpu.hip
+            .memcpy_dtoh_at(&mut v_read, &driver.arena().arena().buf, v_off)
+            .expect("trunk d2h V");
+        assert_eq!(
+            k_read,
+            fx_pack(1, 0, false),
+            "trunk plane 0 K byte-neutral under composite export"
+        );
+        assert_eq!(
+            v_read,
+            fx_pack(1, 0, true),
+            "trunk plane 0 V byte-neutral under composite export"
+        );
+
+        // (2) Head restore: a single-layer aux catalog over the driver's NOW-composite
+        // descriptor, selecting the SAME cold page 200. Reads the aux region of the
+        // record the trunk already sealed — no re-seal (shared composite archive).
+        let head_plan = {
+            let aux_snapshot = LayerMemorySnapshot {
+                model_layer: aux,
+                memory: MemorySnapshot {
+                    stamp: fx_stamp(),
+                    blocks: vec![
+                        BlockCopies {
+                            block: fx_block(100, 0, 1),
+                            host_version: 1,
+                        },
+                        BlockCopies {
+                            block: fx_block(200, FX_BT as u64, 2),
+                            host_version: 2,
+                        },
+                    ],
+                    resident: vec![100],
+                },
+            };
+            let aux_catalog =
+                MemoryCatalog::new(&driver.descriptor, &[aux_snapshot]).expect("aux catalog");
+            let aux_sel = LayerSelection {
+                model_layer: aux,
+                expected: fx_stamp(),
+                selected: vec![200],
+                mandatory: vec![],
+                budget: MemoryBudget {
+                    selected_tokens: FX_BT as u64,
+                    reserve_tokens: FX_BT as u64,
+                    device_tokens: 2 * FX_BT as u64,
+                    host_payload_bytes: 2 * composite_record,
+                },
+            };
+            aux_catalog.plan_layer(&aux_sel).expect("head plan")
+        };
+        assert_eq!(head_plan.model_layer(), aux);
+        assert_eq!(
+            head_plan.payload().expect("aux regions").packed_bytes(),
+            FX_LAYER_BYTES
+        );
+        let head_view = driver
+            .restore_head_plane(&mut gpu, &head_plan)
+            .expect("head restore");
+        assert_eq!(head_view.blocks.len(), 1);
+        assert_eq!(head_view.blocks[0].block.id, 200);
+        // STILL one shared record: the head read the trunk's cached composite record.
+        assert_eq!(
+            driver.sealed_records(),
+            1,
+            "trunk + head share ONE composite archive"
+        );
+        assert_eq!(head_view.visible_tokens, head_plan.next_visible_tokens());
+        assert_eq!(head_view.stamp, head_plan.next_stamp().unwrap());
+
+        // Head arena stripe (ordinal 0) holds page 200's AUX-plane K/V byte-exact.
+        {
+            let head = driver.head.as_ref().expect("head attached");
+            assert_eq!(head.arena.pool_ref().canonical_pages(0).unwrap(), vec![1]);
+            let hphys = head.arena.pool_ref().compact_slots(0).unwrap()[0];
+            let hk_off = head
+                .arena
+                .layout()
+                .layer_k_offset(hphys as usize, 0)
+                .unwrap();
+            let hv_off = head
+                .arena
+                .layout()
+                .layer_v_offset(hphys as usize, 0)
+                .unwrap();
+            let mut hk_read = vec![0u8; FX_PLANE as usize];
+            let mut hv_read = vec![0u8; FX_PLANE as usize];
+            gpu.hip
+                .memcpy_dtoh_at(&mut hk_read, &head.arena.arena().buf, hk_off)
+                .expect("head d2h K");
+            gpu.hip
+                .memcpy_dtoh_at(&mut hv_read, &head.arena.arena().buf, hv_off)
+                .expect("head d2h V");
+            assert_eq!(hk_read, fx_pack(1, aux, false), "head aux K bytes");
+            assert_eq!(hv_read, fx_pack(1, aux, true), "head aux V bytes");
+        }
+
+        // (3) Head paged views: restore_head_plane published the head's block table
+        // from the restored compact view. Prove the addressing the head attend reads
+        // — positions[] = [visible-1] (compacted causal bound), the block table maps
+        // the restored compact slot at stripe 2*slot (layer 0, n_layers 1, no suffix),
+        // the descriptor carries seq_len = visible / page_tokens 128 and points at the
+        // stable table address, and the K/V base views alias the head arena. This is
+        // the SAME staging machinery the trunk's certified paged decode (D4a) reads,
+        // so the head restore-before-attend is byte-exact by construction.
+        {
+            let views = driver.head_layer_views().expect("head layer views");
+            let (k_view, v_view) = driver.head_arena_views().expect("head arena views");
+            let head = driver.head.as_ref().expect("head attached");
+            let hphys = head.arena.pool_ref().compact_slots(0).unwrap()[0];
+            let visible = head_view.visible_tokens;
+            assert_eq!(visible, FX_BT as u64, "one full restored page");
+            // ctx_len = head_n_slots(3) × 128, the page-rounded upper bound.
+            assert_eq!(views.ctx_len, 3 * FX_BT as usize);
+            // positions[]: width 1 → [seq_len - 1] = [127] (compacted causal bound).
+            let mut pos_bytes = vec![0u8; 4];
+            gpu.hip
+                .memcpy_dtoh_at(&mut pos_bytes, &views.positions.buf, 0)
+                .expect("head positions d2h");
+            assert_eq!(
+                i32::from_le_bytes([pos_bytes[0], pos_bytes[1], pos_bytes[2], pos_bytes[3]]),
+                visible as i32 - 1,
+                "head compacted causal bound"
+            );
+            // row_slot: width 1 → [0] (single sequence).
+            let mut rs_bytes = vec![0u8; 4];
+            gpu.hip
+                .memcpy_dtoh_at(&mut rs_bytes, &views.row_slot.buf, 0)
+                .expect("head row_slot d2h");
+            assert_eq!(
+                i32::from_le_bytes([rs_bytes[0], rs_bytes[1], rs_bytes[2], rs_bytes[3]]),
+                0
+            );
+            // Block table: [2*hphys, -1, -1] — one mapped stripe, no suffix page.
+            let mut bt_bytes = vec![0u8; 12];
+            gpu.hip
+                .memcpy_dtoh_at(&mut bt_bytes, &head.staging.block_table(0).unwrap().buf, 0)
+                .expect("head block table d2h");
+            let bt: Vec<i32> = bt_bytes
+                .chunks_exact(4)
+                .map(|c| i32::from_le_bytes([c[0], c[1], c[2], c[3]]))
+                .collect();
+            assert_eq!(
+                bt,
+                vec![2 * hphys as i32, -1, -1],
+                "head stripe 2*slot, no suffix"
+            );
+            // Descriptor: seq_len = visible, page_tokens 128, stable table pointer.
+            let mut desc_buf = vec![0u8; std::mem::size_of::<KvSlotDesc>()];
+            gpu.hip
+                .memcpy_dtoh_at(&mut desc_buf, &views.descs.buf, 0)
+                .expect("head desc d2h");
+            let desc: KvSlotDesc =
+                unsafe { std::ptr::read_unaligned(desc_buf.as_ptr() as *const KvSlotDesc) };
+            assert_eq!(desc.seq_len, visible as i32);
+            assert_eq!(desc.page_tokens, FX_BT as i32);
+            assert_eq!(
+                desc.block_table,
+                head.staging.block_table(0).unwrap().buf.as_ptr() as u64
+            );
+            // K/V base views alias the head arena allocation (non-owning).
+            assert_eq!(k_view.numel(), head.arena.arena().numel());
+            assert!(v_view.numel() > 0);
+        }
+
+        // (4) Head draft-scratch suffix: restore the partial boundary page (dense
+        // ordinal 2, 64 fed tokens) into the reserved scratch slot and bind it as
+        // the staging suffix. The compacted causal bound extends by partial+rows
+        // (128+64+1=193); the block table maps the history stripe THEN the scratch
+        // stripe (2*slot, layer 0 / n_layers 1); the scratch stripe holds the
+        // boundary page's AUX K/V first 64 rows byte-exact. This is the head
+        // write+attend working set (ninfer rebuild_auxiliary_boundary + compact
+        // write pos, NL:10205-10339).
+        {
+            let suffix = HeadSuffix {
+                page: 2,
+                partial_tokens: 64,
+                rows: 1,
+            };
+            let hv = driver
+                .restore_head_plane_with_suffix(&mut gpu, &head_plan, &suffix)
+                .expect("head suffix restore");
+            assert_eq!(
+                hv.visible_tokens, head_view.visible_tokens,
+                "history view unchanged"
+            );
+            assert_eq!(
+                driver.sealed_records(),
+                2,
+                "boundary page sealed a second composite record"
+            );
+            let views = driver
+                .head_layer_views()
+                .expect("head layer views (suffix)");
+            let head = driver.head.as_ref().expect("head attached");
+            let hphys = head.arena.pool_ref().compact_slots(0).unwrap()[0];
+            let scratch = head.suffix_slot;
+            let extent = head_view.visible_tokens + 64 + 1;
+            assert_eq!(views.ctx_len, 3 * FX_BT as usize);
+            // positions[]: width 1 → [extent-1] = [192] (compacted causal bound).
+            let mut pos_bytes = vec![0u8; 4];
+            gpu.hip
+                .memcpy_dtoh_at(&mut pos_bytes, &views.positions.buf, 0)
+                .expect("head suffix positions d2h");
+            assert_eq!(
+                i32::from_le_bytes([pos_bytes[0], pos_bytes[1], pos_bytes[2], pos_bytes[3]]),
+                extent as i32 - 1,
+                "head suffix compacted causal bound"
+            );
+            // Block table: [2*hphys, 2*scratch, 2*overflow] — history,
+            // scratch and overflow stripes. The overflow page stays beyond the
+            // causal bound when unused and is therefore masked.
+            let mut bt_bytes = vec![0u8; 12];
+            gpu.hip
+                .memcpy_dtoh_at(&mut bt_bytes, &head.staging.block_table(0).unwrap().buf, 0)
+                .expect("head suffix block table d2h");
+            let bt: Vec<i32> = bt_bytes
+                .chunks_exact(4)
+                .map(|c| i32::from_le_bytes([c[0], c[1], c[2], c[3]]))
+                .collect();
+            assert_eq!(
+                bt,
+                vec![
+                    2 * hphys as i32,
+                    2 * scratch as i32,
+                    2 * head.suffix_slot_overflow as i32,
+                ],
+                "history + scratch + overflow stripes"
+            );
+            // Descriptor: seq_len = extent (visible + partial + rows).
+            let mut desc_buf = vec![0u8; std::mem::size_of::<KvSlotDesc>()];
+            gpu.hip
+                .memcpy_dtoh_at(&mut desc_buf, &views.descs.buf, 0)
+                .expect("head suffix desc d2h");
+            let desc: KvSlotDesc =
+                unsafe { std::ptr::read_unaligned(desc_buf.as_ptr() as *const KvSlotDesc) };
+            assert_eq!(desc.seq_len, extent as i32);
+            // Scratch stripe AUX K/V first 64 rows byte-exact (partial boundary page).
+            let sk_off = head
+                .arena
+                .layout()
+                .layer_k_offset(scratch as usize, 0)
+                .unwrap();
+            let sv_off = head
+                .arena
+                .layout()
+                .layer_v_offset(scratch as usize, 0)
+                .unwrap();
+            let mut sk = vec![0u8; 64 * row_bytes];
+            let mut sv = vec![0u8; 64 * row_bytes];
+            gpu.hip
+                .memcpy_dtoh_at(&mut sk, &head.arena.arena().buf, sk_off)
+                .expect("scratch K d2h");
+            gpu.hip
+                .memcpy_dtoh_at(&mut sv, &head.arena.arena().buf, sv_off)
+                .expect("scratch V d2h");
+            assert_eq!(
+                sk,
+                fx_pack(2, aux, false)[..64 * row_bytes],
+                "scratch aux K partial rows"
+            );
+            assert_eq!(
+                sv,
+                fx_pack(2, aux, true)[..64 * row_bytes],
+                "scratch aux V partial rows"
+            );
+        }
+
+        driver.free(&mut gpu).expect("free driver");
+    }
+
+    /// Full layerwise transaction on device (mirrors the core
+    /// `layerwise_request_test.cpp` `execute()` + `current_forward_and_acceptance()`):
+    /// two fa layers, each selects its COLD page via the GPU scorer, restores it
+    /// byte-exact into the composite arena, attends, and accepts. Verifies the
+    /// per-layer selection {{200},{100}}, the cumulative work counters, the
+    /// accepted resident sets {200,300}/{100,300}, frontier == evaluation.end,
+    /// the three-block catalog, the advanced stamps, the core readback equality,
+    /// and the canonical-history advance. Mean-K is fed so layer 0 favors page
+    /// 200 and layer 1 favors page 100; the shared all-+1 Q tile then selects the
+    /// cold page in each layer through the query-span intersection.
+    #[test]
+    #[ignore]
+    fn driver_end_to_end_layerwise_transaction() {
+        let mut gpu = Gpu::init().expect("gpu");
+        let q8 = fx_layout();
+        let kw = FX_KV_HEADS * FX_HEAD_DIM; // 32 (query_heads == kv_heads == 1)
+
+        // Policy: one-page selected budget, no sink/recent (pure score selection).
+        let policy = KvStore::new(&KvStoreConfig {
+            block_tokens: FX_BT,
+            select_budget: FX_BT,
+            sink_blocks: 0,
+            recent_blocks: 0,
+            ..Default::default()
+        })
+        .expect("policy");
+        policy.register_append(FX_FRONTIER as u32).expect("append");
+
+        // Statistics + packed store: both canonical pages, both layers.
+        let keys_storage = Storage::new_ram(16 << 20).expect("keys storage");
+        let keys = RawStore::new(q8.raw_config().clone(), Some(&keys_storage)).expect("keys");
+        keys.ensure_blocks(2).expect("ensure blocks");
+        for b in 0..2u32 {
+            for il in 0..FX_LAYERS {
+                keys.write_layer_k_gpu(b * FX_BT, FX_BT, il, &fx_pack(b, il, false))
+                    .expect("feed K");
+                keys.write_layer_v_gpu(b * FX_BT, FX_BT, il, &fx_pack(b, il, true))
+                    .expect("feed V");
+            }
+        }
+        // Mean-K: layer 0 favors ordinal 1 (page 200), layer 1 favors ordinal 0
+        // (page 100). sign = +1 iff (b==1) == (il==0).
+        for il in 0..FX_LAYERS {
+            for b in 0..2u32 {
+                let sign = if (b == 1) == (il == 0) {
+                    1.0f32
+                } else {
+                    -1.0f32
+                };
+                let tile: Vec<f32> = vec![sign; FX_BT as usize * kw];
+                keys.write_layer_mean_k(b * FX_BT, FX_BT, il, &tile)
+                    .expect("mean-k");
+            }
+        }
+
+        // Shared all-+1 native Q tile: 4 evaluation rows, query_heads=1.
+        let rows = 4u32;
+        let host = vec![1.0f32; rows as usize * kw];
+        let qt = gpu
+            .alloc_tensor(&[host.len() * 4], DType::Raw)
+            .expect("q alloc");
+        gpu.hip
+            .memcpy_htod(&qt.buf, unsafe {
+                std::slice::from_raw_parts(host.as_ptr() as *const u8, host.len() * 4)
+            })
+            .expect("q h2d");
+        let q_base = NativeCurrentLayerQuery {
+            data: qt.buf.as_ptr() as *const std::ffi::c_void,
+            bytes: host.len() * 4,
+            layer: 0,
+            rows,
+            query_heads: 1,
+            kv_heads: FX_KV_HEADS as u32,
+            head_dim: FX_HEAD_DIM as u32,
+            attention_scale: 0.0,
+            scalar: 0,
+            row_stride: kw * 4,
+            head_stride: FX_HEAD_DIM * 4,
+            dimension_stride: 4,
+        };
+
+        let mut driver = LayerwiseDriver::new(
+            &mut gpu,
+            &keys,
+            &policy,
+            &q8,
+            fx_backend(),
+            fx_capabilities(),
+            fx_snapshots(),
+            3,
+            16 << 20,
+        )
+        .expect("driver");
+
+        let identity = LayerwiseIdentity {
+            history: fx_stamp(),
+            request: 77,
+            evaluation: QueryRange {
+                begin: FX_FRONTIER,
+                end: FX_FRONTIER + rows as u64,
+            },
+            query: QueryRange {
+                begin: FX_FRONTIER + 1,
+                end: FX_FRONTIER + 3,
+            },
+        };
+        let geom = |ordinal: u32| LayerQueryGeometry {
+            layer: ordinal,
+            query_heads: 1,
+            kv_heads: FX_KV_HEADS as u32,
+            head_dim: FX_HEAD_DIM as u32,
+            attention_scale: 0.0,
+        };
+        let specs = vec![
+            LayerRequestSpec {
+                model_layer: 0,
+                query: geom(0),
+                budget: fx_budget(),
+                mandatory: vec![],
+            },
+            LayerRequestSpec {
+                model_layer: 1,
+                query: geom(1),
+                budget: fx_budget(),
+                mandatory: vec![],
+            },
+        ];
+        // native_history_tokens == the selected working-set extent (one page).
+        driver
+            .begin_query(identity, specs, FX_BT as u64)
+            .expect("begin_query");
+        assert_eq!(driver.phase(), Some(LayerwisePhase::BetweenLayers));
+
+        let mut selected = Vec::new();
+        for ordinal in 0..2usize {
+            let mut q = q_base;
+            q.layer = ordinal as u32;
+            let view = driver
+                .project_restore(&mut gpu, ordinal, &q)
+                .expect("project_restore");
+            let want = if ordinal == 0 { 200u64 } else { 100u64 };
+            assert_eq!(view.blocks.len(), 1, "one selected page");
+            assert_eq!(
+                view.blocks[0].block.id, want,
+                "layer {ordinal} selects the cold page"
+            );
+            assert_eq!(view.visible_tokens, FX_BT as u64);
+            selected.push(view.blocks[0].block.id);
+            // The arena stripe binds exactly the selected canonical page.
+            let page = if ordinal == 0 { 1u32 } else { 0u32 };
+            assert_eq!(
+                driver.arena().pool_ref().canonical_pages(ordinal).unwrap(),
+                vec![page]
+            );
+            driver
+                .attend_complete(ordinal, identity.evaluation.begin, rows as u64)
+                .expect("attend_complete");
+        }
+        assert_eq!(selected, vec![200u64, 100u64]);
+        assert_eq!(driver.phase(), Some(LayerwisePhase::AwaitingAcceptance));
+        let work = driver.work().expect("work");
+        assert_eq!(work.projected_rows, 8, "2 layers × 4 evaluation rows");
+        assert_eq!(work.attended_rows, 8);
+        assert_eq!(work.completed_layers, 2);
+        assert_eq!(driver.sealed_records(), 2, "both cold pages sealed once");
+
+        // Accept: evaluated native suffix (id 300) at the evaluation frontier.
+        let suffix = BlockCopies {
+            block: BlockDescriptor {
+                session: fx_session(),
+                id: 300,
+                original_start: identity.evaluation.begin,
+                valid_tokens: rows,
+                content_version: 3,
+                statistics_version: 1,
+            },
+            host_version: 0,
+        };
+        let snapshots = driver.accept(suffix).expect("accept");
+        assert_eq!(driver.phase(), Some(LayerwisePhase::Accepted));
+        let readback = driver.accepted_snapshots().expect("readback");
+        assert_eq!(readback, snapshots, "core readback == published snapshots");
+        for ordinal in 0..2usize {
+            let s = &snapshots[ordinal];
+            assert_eq!(s.model_layer, ordinal as u32);
+            assert_eq!(s.memory.stamp.frontier, identity.evaluation.end);
+            assert_eq!(
+                s.memory.stamp.history_revision,
+                fx_stamp().history_revision + 1
+            );
+            assert_eq!(
+                s.memory.stamp.execution_history,
+                fx_stamp().execution_history + 1
+            );
+            // plan.next adds one view_version, accept adds another; per-layer base diverges.
+            assert_eq!(
+                s.memory.stamp.view_version,
+                fx_stamp().view_version + ordinal as u64 + 2
+            );
+            assert_eq!(s.memory.blocks.len(), 3, "frozen prefix + evaluated suffix");
+            assert_eq!(s.memory.blocks[2].block.id, 300);
+            assert_eq!(s.memory.blocks[2].host_version, 0);
+            let want_resident = if ordinal == 0 {
+                vec![200u64, 300]
+            } else {
+                vec![100u64, 300]
+            };
+            assert_eq!(s.memory.resident, want_resident);
+        }
+        // Canonical history advanced to the accepted snapshots.
+        assert_eq!(driver.canonical(), snapshots.as_slice());
+        assert_eq!(driver.stamp(), snapshots[0].memory.stamp);
+
+        driver.end_query();
+        assert_eq!(driver.phase(), None);
+        gpu.free_tensor(qt).expect("free q");
+        driver.free(&mut gpu).expect("free driver");
+    }
+
+    /// Host-only: activation admission is fail-closed BEFORE any allocation
+    /// (ninfer-faithful, design §3.11/§5.1 E1). A too-small quota for the model
+    /// geometry yields `Err` with nothing acquired; the RAM/disk tier decision
+    /// flips on the tape peak. No GPU — `admit` is pure arithmetic plus the
+    /// shim's `metadata_bound`, so the whole admission contract is host-testable.
+    #[test]
+    fn layerwise_activation_admission_fail_closed() {
+        let id = LayerwiseIdentity {
+            history: fx_stamp(),
+            request: 91,
+            evaluation: QueryRange {
+                begin: FX_FRONTIER,
+                end: FX_FRONTIER + 1,
+            },
+            query: QueryRange {
+                begin: FX_FRONTIER,
+                end: FX_FRONTIER + 1,
+            },
+        };
+        let n_layers = 2usize;
+        let full_pages = 2u64;
+        let q_row_bytes = QW * 4; // 1024
+        let base = LayerwiseQuotas::default();
+
+        // The seeds admit the tiny geometry on the RAM tier; the plan carries the
+        // exact geometry-derived bounds the constructor will reserve.
+        let plan = LayerwiseActivation::admit(&id, n_layers, full_pages, q_row_bytes, &base)
+            .expect("admit default");
+        assert!(!plan.use_disk);
+        assert_eq!(plan.pin_bytes, q_row_bytes as u64); // one decode row
+        assert_eq!(plan.ram_tapes, base.activation_ram - plan.pin_bytes);
+        assert!(plan.control_bytes > 0);
+        assert_eq!(plan.source_bound, full_pages * SOURCE_VERSION_DESC_BYTES);
+        assert_eq!(
+            plan.frozen_bound,
+            n_layers as u64 * (FROZEN_SNAPSHOT_BASE_BYTES + full_pages * FROZEN_BLOCK_DESC_BYTES)
+        );
+        assert_eq!(plan.feedback_bound, n_layers as u64 * FEEDBACK_DESC_BYTES);
+
+        // Zero-sized geometry / empty evaluation span fail closed.
+        assert!(LayerwiseActivation::admit(&id, 0, full_pages, q_row_bytes, &base).is_err());
+        assert!(LayerwiseActivation::admit(&id, n_layers, full_pages, 0, &base).is_err());
+        let empty = LayerwiseIdentity {
+            evaluation: QueryRange {
+                begin: FX_FRONTIER,
+                end: FX_FRONTIER,
+            },
+            ..id
+        };
+        assert!(
+            LayerwiseActivation::admit(&empty, n_layers, full_pages, q_row_bytes, &base).is_err()
+        );
+
+        // activation_metadata too small (control + per-tape bounds cannot fit).
+        let mut q = base.clone();
+        q.activation_metadata = 1;
+        assert!(LayerwiseActivation::admit(&id, n_layers, full_pages, q_row_bytes, &q).is_err());
+        q.activation_metadata = 0;
+        assert!(LayerwiseActivation::admit(&id, n_layers, full_pages, q_row_bytes, &q).is_err());
+
+        // metadata envelope too small: transient partition == 0, then bounds exceed.
+        let mut q = base.clone();
+        q.metadata = 7; // 7/8 == 0 → transient zero
+        assert!(LayerwiseActivation::admit(&id, n_layers, full_pages, q_row_bytes, &q).is_err());
+        let mut q = base.clone();
+        q.metadata = 8; // transient 1; frozen_bound 512 > 1
+        assert!(LayerwiseActivation::admit(&id, n_layers, full_pages, q_row_bytes, &q).is_err());
+
+        // staging too small for the pinned Q readback.
+        let mut q = base.clone();
+        q.staging = (q_row_bytes as u64) - 1;
+        assert!(LayerwiseActivation::admit(&id, n_layers, full_pages, q_row_bytes, &q).is_err());
+
+        // activation_ram too small for even the staging slice.
+        let mut q = base.clone();
+        q.activation_ram = (q_row_bytes as u64) - 1;
+        assert!(LayerwiseActivation::admit(&id, n_layers, full_pages, q_row_bytes, &q).is_err());
+
+        // Disk tier: tape_peak = 2*1024 = 2048; pin = 1024; activation_ram = 2048
+        // → ram_tapes = 1024 < 2048 → disk. Without a directory it fails closed.
+        let mut q = base.clone();
+        q.activation_ram = 2048;
+        q.staging = 1024;
+        q.activation_disk = 4096;
+        q.disk_directory = None;
+        assert!(LayerwiseActivation::admit(&id, n_layers, full_pages, q_row_bytes, &q).is_err());
+        // With a directory the disk tier is admitted.
+        q.disk_directory = Some(std::path::PathBuf::from("/tmp/hipfire-activation-admit"));
+        let plan = LayerwiseActivation::admit(&id, n_layers, full_pages, q_row_bytes, &q)
+            .expect("admit disk tier");
+        assert!(plan.use_disk);
+        // activation_disk too small for the tape peak → fail closed.
+        q.activation_disk = 2047;
+        assert!(LayerwiseActivation::admit(&id, n_layers, full_pages, q_row_bytes, &q).is_err());
+    }
