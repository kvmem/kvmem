+        &["SINK_TOKENS", "SINK_BLOCKS"],
+    ),
+    (
+        "recent_tokens",
+        "--kvmem-recent-tokens",
+        &["RECENT_TOKENS", "RECENT_BLOCKS"],
+    ),
+    (
+        "host_bytes",
+        "--kvmem-host-mib",
+        &["HOST_MIB", "HOST_BYTES"],
+    ),
+    (
