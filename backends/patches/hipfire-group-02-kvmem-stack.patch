+#[test]
+fn native_scorer_fail_closed() {
+    let desc = descriptor();
+    let catalog = hipfire_kvmem::MemoryCatalog::new(&desc, &initial()).expect("catalog");
+    let pol = policy();
+    let key = keys();
+    let id = identity();
+    let rev = id.history;
+    let q = [-1000.0f32, 1.0, 1.0, -1000.0];
+
+    // Every scorer-side failure happens INSIDE the projection try block, so the
+    // request must terminate Aborted (never unwind across the C ABI, never pick).
+    let cases: Vec<(
+        &str,
+        Box<
+            dyn FnMut(
+                &NativeCurrentLayerQuery,
+                &QueryScoreFrame<'_>,
+            ) -> Result<Vec<f64>, KvMemError>,
+        >,
+    )> = vec![
+        (
+            "reported failure",
+            Box::new(|_, _| Err(KvMemError("scorer failed".into()))),
+        ),
+        (
+            "wrong score extent",
+            Box::new(|_, f| Ok(vec![1.0; f.starts.len() + 1])),
+        ),
+        (
+            "negative page mass",
+            Box::new(|_, f| {
+                let mut s = vec![1.0; f.starts.len()];
+                s[0] = -1.0;
+                Ok(s)
+            }),
+        ),
+        (
+            "nonfinite page mass",
+            Box::new(|_, f| {
+                let mut s = vec![1.0; f.starts.len()];
+                s[0] = f64::INFINITY;
+                Ok(s)
+            }),
+        ),
+        (
+            "panicking scorer",
+            Box::new(|_, _| panic!("native scorer panic")),
+        ),
+    ];
+    for (name, mut scorer) in cases {
+        let request = LayerwiseRequest::new(
+            &id,
+            &catalog,
+            &pol,
+            &key,
+            &specs(),
+            BLOCK as u64,
+            move || rev,
+        )
+        .expect("request");
+        request.begin_layer(&id, 2).expect("begin_layer");
+        let tile = native_query(&q, 0);
+        assert!(
+            request
+                .projected_native(&id, 8, &tile, &mut scorer)
+                .is_err(),
+            "{name} must propagate as an error"
+        );
+        assert_eq!(
+            request.phase(),
+            LayerwisePhase::Aborted,
+            "{name} must abort fail-closed"
+        );
+        // A closed request rejects further projection.
+        assert!(
+            request
+                .projected_native(&id, 8, &tile, &mut scorer)
+                .is_err(),
+            "{name}: closed"
+        );
+    }
+}
