+            .lookup(&[10, 11, 20, 21, 30, 99, 40], None, 7, false)
+            .unwrap()
+            .is_empty());
+        assert!(catalog.lookup(&[10, 11], None, 7, true).unwrap().is_empty());
+        assert_eq!(
+            catalog
+                .lookup(&[10, 11, 20, 21, 30, 31, 40], None, 7, false)
+                .unwrap(),
+            vec![a]
+        );
+        assert_eq!(
+            catalog
+                .lookup(&[10, 11, 20, 22, 30, 32, 40], None, 7, true)
+                .unwrap(),
+            vec![b]
+        );
+    }
