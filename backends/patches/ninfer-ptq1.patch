+    failures += run_shape("PTQ1_A16", ActivationCompute::A16, make_ptq1_weight,
+                          {1024, 5120, 201U, Comparison::Full, true, kDecode});
+    failures += run_shape("PTQ1_A16", ActivationCompute::A16, make_ptq1_weight,
+                          {7168, 5120, 203U, Comparison::SampledRows, false, kDecode});
+    failures += run_shape("PTQ1_A16", ActivationCompute::A16, make_ptq1_weight,
