+int test_generated_history_boundaries() {
+    const auto source = resources("");
+    const fi::Tokenizer tokenizer({source.tokenizer_json,source.tokenizer_config_json,source.generation_config_json});
+    auto prefix = std::make_shared<kvmem::GeneratedHistory::Prefix>();
+    prefix->text = "}STOPjunk";
+    prefix->ids = {kStopCutToken};
+    ninfer::history::Preparation work;
+    work.candidates.push_back(prefix);
+    work.template_eos = "<|im_end|>";
+    ninfer::history::Scope scope(&work);
+    fi::RenderedChat rendered;
+    rendered.text = prefix->text + "<|im_end|>x";
+    rendered.message_boundaries = {0, prefix->text.size()};
+    rendered.memory_query = ninfer::text::ByteSpan{rendered.text.size() - 1, rendered.text.size()};
+    auto encoded = fi::encode_rendered_chat(tokenizer, rendered, 4);
+    int failures = check(work.reused == 1 && encoded.input_ids == std::vector<int>({kStopCutToken,248046,0}) &&
+                         encoded.message_boundaries.back() == 1 && encoded.memory_query &&
+                         encoded.memory_query->begin == 2 && encoded.memory_query->count == 1,
+                         "accepted rows or native frontiers changed at exact capacity");
+    work.reused = 0;
+    encoded = fi::encode_rendered_chat(tokenizer, rendered, 3);
+    failures += check(work.reused == 0 && encoded.input_ids.front() != kStopCutToken,
+                      "over-capacity history suppressed canonical fallback");
+    rendered.literal_spans.push_back({prefix->text.size(), rendered.text.size()-1});
+    encoded = fi::encode_rendered_chat(tokenizer, rendered);
+    failures += check(work.reused == 0 && encoded.input_ids.front() != kStopCutToken,
+                      "literal user EOT became a template-owned seam");
+    rendered.literal_spans.clear();
+    work.template_eos = "<unused>";
+    encoded = fi::encode_rendered_chat(tokenizer, rendered);
+    failures += check(work.reused == 0 && encoded.input_ids.front() != kStopCutToken,
+                      "a generic special token became an accepted EOT");
+    return failures;
+}
