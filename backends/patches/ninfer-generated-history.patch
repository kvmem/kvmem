+++ b/src/runtime/generated_history.h
@@ -0,0 +1,29 @@
+#pragma once
+
+#include "kvmem/generated_history.hpp"
+#include <string_view>
+
+namespace ninfer::history {
+
+// Engine::prepare calls its frontend synchronously. This narrow scope keeps request
+// evidence out of engine state and restores the caller's scope on exceptions.
+struct Preparation {
+    std::vector<std::shared_ptr<const kvmem::GeneratedHistory::Prefix>> candidates;
+    kvmem::GeneratedHistory::Prefix prompt;
+    std::size_t reused = 0;
+    std::string_view template_eos;
+    std::size_t capacity_sentinel = SIZE_MAX;
+};
+
+inline thread_local Preparation* preparing = nullptr;
+
+class Scope {
+public:
+    explicit Scope(Preparation* current) : prior_(std::exchange(preparing, current)) {}
+    ~Scope() { preparing = prior_; }
+    Scope(const Scope&) = delete;
+    Scope& operator=(const Scope&) = delete;
+private:
+    Preparation* prior_;
+};
+} // namespace ninfer::history
