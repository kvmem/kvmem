+    const int closure = has_closure ? ids.back() : tail.input_ids.front();
+    if (std::getenv("KVMEM_TRACE_GENERATED_HISTORY")) {
+        std::fprintf(stderr,"KVMEM_HISTORY seam_bytes=%zu prefix_rows=%zu closure=%d eog=%d\n",
+                     seam, ids.size(), closure, int(is_stop(closure)));
