+// Use length-delimited fields so arbitrary bytes or separators in text cannot
+// create a second interpretation. Protocol-generated call IDs are references:
+// identify their targets by declaration order after the wire graph is validated.
+static void history_field(std::string& key, std::string_view value) {
+    key += std::to_string(value.size());
+    key += '#';
+    key.append(value);
+}
+
+using CallNumbers = std::unordered_map<std::string, std::size_t>;
+static void history_turn(std::string& key, const ChatTurn& turn, CallNumbers& calls,
+                         std::size_t& next_call) {
+    history_field(key, std::to_string(static_cast<int>(turn.role)));
+    history_field(key, turn.reasoning_content);
+    const std::size_t count = turn.content.size() == 1 && turn.content.front().text.empty()
+                                  ? 0 : turn.content.size();
+    history_field(key, std::to_string(count));
+    for (std::size_t i = 0; i < count; ++i) { history_field(key, turn.content[i].text); }
+    history_field(key, std::to_string(turn.tool_calls.size()));
+    for (const auto& call : turn.tool_calls) {
+        history_field(key, call.name);
+        history_field(key, call.arguments_json);
+        calls[call.id] = next_call++;
+    }
+    auto target = calls.find(turn.tool_call_id);
+    history_field(key, turn.tool_call_id.empty() ? "" : target == calls.end()
+                          ? "id:" + turn.tool_call_id : "call:" + std::to_string(target->second));
+    history_field(key, turn.tool_result_name.value_or(""));
+    history_field(key, turn.tool_result_is_error ? "1" : "0");
+}
+
+static history::Preparation prepare_history(kvmem::GeneratedHistory& directory, std::string& key,
+                                             const GenerationRequest& request,
+                                             const PromptInput& input) {
+    history::Preparation work;
+    // Responses assigns an internal cache session per stored response. A caller
+    // resending full messages uses the same model and authentication domain.
+    // Keep those native cache handles out of the logical transcript identity.
+    history_field(key, input.options.lora ? "explicit" : "default");
+    if (input.options.lora) {
+        history_field(key, std::to_string(input.options.lora->size()));
+        for (const auto& adapter : *input.options.lora) {
+            history_field(key, std::to_string(adapter.id));
+            history_field(key, std::to_string(std::bit_cast<std::uint32_t>(adapter.scale)));
+        }
+    }
+    history_field(key, input.options.chat_template_kwargs_json);
+    history_field(key, std::to_string(input.options.tool_jsons.size()));
+    for (const auto& tool : input.options.tool_jsons) { history_field(key, tool); }
+    std::vector<std::size_t> ends;
+    CallNumbers calls;
+    std::size_t next_call = 0;
+    for (const auto& turn : request.messages) {
+        history_turn(key, turn, calls, next_call);
+        if (turn.role == ChatRole::Assistant) { ends.push_back(key.size()); }
+    }
+    const auto last_role = request.messages.back().role;
+    if (!request.reset_generated_history &&
+        (last_role == ChatRole::User || last_role == ChatRole::Tool)) {
+        work.candidates = directory.candidates(key, ends);
+    }
+    if (std::getenv("KVMEM_TRACE_GENERATED_HISTORY")) {
+        std::fprintf(stderr,"KVMEM_HISTORY lookup_key_bytes=%zu candidates=%zu\n",key.size(),work.candidates.size());
+    }
+    return work;
+}
+
+static bool uses_history(const GenerationRequest& req, const PromptInput& input) {
+    return req.cache_prompt && !req.raw_prompt && !req.messages.empty() && req.media_item_count() == 0 &&
+           input.options.graft.empty() && req.continuation == PromptContinuationMode::NewAssistantTurn &&
+           !(req.layerwise_query && req.layerwise_query->begin);
+}
+
+static void publish_history(RequestLifetime& lifetime, const GenerationOutcome& outcome, Engine& engine,
+                            bool discarded_calls) {
+    auto prefix = std::move(lifetime.history_prompt);
+    if (prefix.ids.empty() || outcome.tokens.empty() || !outcome.branches.empty() ||
+        outcome.finish_reason == FinishReason::Cancelled || outcome.finish_reason == FinishReason::None) { return; }
+    ChatTurn reply;
+    reply.role = ChatRole::Assistant;
+    reply.reasoning_content = outcome.reasoning;
+    if (!outcome.text.empty()) { reply.content.push_back(ContentPart{.text = outcome.text}); }
+    for (const auto& call : outcome.tool_calls) {
+        reply.tool_calls.push_back({{}, call.name, call.arguments_json});
+    }
+    auto key = std::move(lifetime.history_key);
+    CallNumbers unused;
+    std::size_t index = 0;
+    history_turn(key, reply, unused, index);
+    auto& history = lifetime.capacity->history;
+    if (discarded_calls || outcome.finish_reason == FinishReason::StopString || outcome.matched_stop_string) {
+        history.mark_ambiguous(std::move(key));
+        return;
+    }
+    for (auto token : outcome.tokens) {
+        const auto bytes = engine.token_bytes(token);
+        if (bytes.empty()) { history.mark_ambiguous(std::move(key)); return; }
+        prefix.text += bytes;
+        prefix.ids.push_back(token);
+    }
+    if (std::getenv("KVMEM_TRACE_GENERATED_HISTORY")) {
+        std::fprintf(stderr,"KVMEM_HISTORY publish_key_bytes=%zu prefix_rows=%zu\n",key.size(),prefix.ids.size());
+    }
+    history.publish(std::move(key), std::move(prefix));
+}
