+}
+void hip_clear_allocation_priority() { priority_allocation_bytes=0;priority_allocation_ranges.clear(); }
+const DeviceBackend* hip_runtime_backend_if_present() {
+    std::call_once(once, [] {
+        base = hip_backend_if_present();
+        if (!base) return;
+        runtime = *base;
+        runtime.name = "hip-runtime";
+        runtime.alloc = alloc; runtime.free = free_mem;
+        runtime.stream_create = stream_create; runtime.stream_destroy = stream_destroy;
+        runtime.stream_sync = stream_sync;
+        runtime.event_create = event_create; runtime.event_destroy = event_destroy;
+        runtime.event_record = event_record; runtime.event_wait = event_wait;
+        runtime.event_query = event_query; runtime.event_sync = event_sync;
+        runtime.event_elapsed_ms = elapsed; runtime.host_wrote = host_wrote;
