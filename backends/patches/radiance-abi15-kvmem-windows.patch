@@ -0,0 +1,22 @@
+#pragma once
+#include <cstdlib>
+#ifdef _WIN32
+#include <malloc.h>
+#endif
+namespace rad::platform {
+inline void* aligned_allocate(size_t alignment, size_t bytes) {
+#ifdef _WIN32
+    return _aligned_malloc(bytes, alignment);
+#else
+    void* p = nullptr;
+    return posix_memalign(&p, alignment, bytes) == 0 ? p : nullptr;
+#endif
+}
+inline void aligned_release(void* p) {
+#ifdef _WIN32
+    _aligned_free(p);
+#else
+    std::free(p);
+#endif
+}
+}
