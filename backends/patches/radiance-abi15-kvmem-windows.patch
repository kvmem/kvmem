diff --git a/core/platform/windows_commit.h b/core/platform/windows_commit.h
new file mode 100644
index 0000000..fab542a
--- /dev/null
+++ b/core/platform/windows_commit.h
@@ -0,0 +1,23 @@
+#pragma once
+
+#ifdef _WIN32
+#include <windows.h>
+#include <cstddef>
+
+// Reserve the full loader capacity without charging all of it to system commit.
+// Committed pages remain reusable until the owner releases the whole reservation.
+inline void* rad_win_reserve_loader_region(size_t capacity) {
+    return capacity ? VirtualAlloc(nullptr, capacity, MEM_RESERVE, PAGE_READWRITE) : nullptr;
+}
+
+inline bool rad_win_commit_loader_range(void* base, size_t capacity, size_t offset, size_t bytes) {
+    if (!base || !bytes || offset > capacity || bytes > capacity - offset) return false;
+    return VirtualAlloc(static_cast<unsigned char*>(base) + offset, bytes,
+                        MEM_COMMIT, PAGE_READWRITE) != nullptr;
+}
+
+inline bool rad_win_release_loader_range(void* base, size_t capacity, size_t offset, size_t bytes) {
+    if (!base || !bytes || offset > capacity || bytes > capacity - offset) return false;
+    return VirtualFree(static_cast<unsigned char*>(base) + offset, bytes, MEM_DECOMMIT) != 0;
+}
+#endif
