+        // issue another independent offset. Handles never inherit into children.
+        HANDLE h = CreateFileW(p.c_str(), access, FILE_SHARE_READ | FILE_SHARE_WRITE | FILE_SHARE_DELETE,
+            nullptr, disposition, FILE_FLAG_OVERLAPPED | ((mode & Direct) ? FILE_FLAG_NO_BUFFERING : 0), nullptr);
+        if (h == INVALID_HANDLE_VALUE) {
+            const DWORD code = GetLastError();
+            direct_unavailable_ = (mode & Direct) &&
+                (code == ERROR_INVALID_PARAMETER || code == ERROR_NOT_SUPPORTED || code == ERROR_INVALID_FUNCTION);
+            if (error) *error = "CreateFileW error " + std::to_string(code);
+            return false;
+        }
+        native_ = reinterpret_cast<intptr_t>(h);
+    } catch (const std::exception& e) { if (error) *error = e.what(); return false; }
+#else
+    int flags = (mode & Write) ? ((mode & Read) ? O_RDWR : O_WRONLY) : O_RDONLY;
+    if (mode & Create) flags |= O_CREAT;
+    if (mode & Truncate) flags |= O_TRUNC;
+    if (mode & Direct) flags |= O_DIRECT;
+    native_ = ::open(path.c_str(), flags | O_CLOEXEC, 0600);
+    if (native_ < 0) {
+        const int code = errno;
+        direct_unavailable_ = (mode & Direct) && (code == EINVAL || code == ENOTSUP || code == EOPNOTSUPP);
+        if (error) *error = std::strerror(code);
+        return false;
+    }
+#endif
+    return true;
+}
+void File::close() {
+    if (!valid()) return;
+#ifdef _WIN32
+    CloseHandle(reinterpret_cast<HANDLE>(native_));
+#else
+    ::close(static_cast<int>(native_));
+#endif
+    native_ = -1;
+}
+int64_t File::size() const {
+    if (!valid()) return -1;
+#ifdef _WIN32
+    LARGE_INTEGER n{};
+    return GetFileSizeEx(reinterpret_cast<HANDLE>(native_), &n) ? n.QuadPart : -1;
+#else
+    struct stat s{};
+    return ::fstat(static_cast<int>(native_), &s) == 0 ? static_cast<int64_t>(s.st_size) : -1;
+#endif
+}
+namespace {
+int64_t io(intptr_t native, void* data, int64_t bytes, int64_t off, bool write) {
+    if (native == -1 || bytes < 0 || off < 0 || off > INT64_MAX-bytes || (bytes && !data)) return -1;
+    if (!bytes) return 0;
+#ifdef _WIN32
+    OVERLAPPED ov{};
+    ov.Offset = static_cast<DWORD>(off); ov.OffsetHigh = static_cast<DWORD>(static_cast<uint64_t>(off)>>32);
+    ov.hEvent = CreateEventW(nullptr, TRUE, FALSE, nullptr);
+    if (!ov.hEvent) return -1;
+    DWORD got = 0;
+    // One bounded transfer; short results are retried by the exact-I/O caller.
+    DWORD n = static_cast<DWORD>(std::min<int64_t>(bytes, 1ll<<30));
+    HANDLE h = reinterpret_cast<HANDLE>(native);
+    BOOL ok = write ? WriteFile(h, data, n, &got, &ov) : ReadFile(h, data, n, &got, &ov);
+    DWORD err = ok ? ERROR_SUCCESS : GetLastError();
+    if (!ok && err == ERROR_IO_PENDING) {
+        ok = GetOverlappedResult(h, &ov, &got, TRUE);
+        err = ok ? ERROR_SUCCESS : GetLastError();
+    }
+    CloseHandle(ov.hEvent);
+    if (!ok && !write && err == ERROR_HANDLE_EOF) return 0;
+    return ok ? static_cast<int64_t>(got) : -1;
+#else
+    ssize_t got;
+    do {
+        auto n = static_cast<size_t>(std::min<int64_t>(bytes, 1ll<<30));
+        got = write ? ::pwrite(static_cast<int>(native), data, n, off) :
+                      ::pread(static_cast<int>(native), data, n, off);
+    } while (got < 0 && errno == EINTR);
+    return got;
+#endif
+}
+}
+int64_t File::read_at(void* p, int64_t n, int64_t off) const { return io(native_,p,n,off,false); }
+int64_t File::write_at(const void* p, int64_t n, int64_t off) const { return io(native_,const_cast<void*>(p),n,off,true); }
+bool File::resize(int64_t n) {
+    if (!valid() || n < 0) return false;
+#ifdef _WIN32
+    LARGE_INTEGER off{}; off.QuadPart = n;
+    return SetFilePointerEx(reinterpret_cast<HANDLE>(native_), off, nullptr, FILE_BEGIN) &&
+           SetEndOfFile(reinterpret_cast<HANDLE>(native_));
+#else
+    return ::ftruncate(static_cast<int>(native_),n) == 0;
+#endif
+}
+bool File::flush() {
+    if (!valid()) return false;
+#ifdef _WIN32
+    return FlushFileBuffers(reinterpret_cast<HANDLE>(native_)) != 0;
+#else
+    return ::fsync(static_cast<int>(native_)) == 0;
+#endif
+}
+bool FileView::open(const File& file, int64_t offset, int64_t bytes) {
+    close();
+    const int64_t total = file.size();
+    if (offset < 0 || bytes <= 0 || offset > total || bytes > total-offset) return false;
+#ifdef _WIN32
+    SYSTEM_INFO s{}; GetSystemInfo(&s);
+    const int64_t granule = s.dwAllocationGranularity;
+#else
+    const int64_t granule = ::sysconf(_SC_PAGESIZE);
+    if (granule <= 0) return false;
+#endif
+    const int64_t aligned = offset/granule*granule;
+    const int64_t length = bytes+(offset-aligned);
+#ifdef _WIN32
+    HANDLE mapping = CreateFileMappingW(reinterpret_cast<HANDLE>(file.native_handle()), nullptr, PAGE_READONLY,0,0,nullptr);
+    if (!mapping) return false;
+    void* p = MapViewOfFile(mapping, FILE_MAP_READ, static_cast<DWORD>(static_cast<uint64_t>(aligned)>>32),
+                           static_cast<DWORD>(aligned), static_cast<SIZE_T>(length));
+    CloseHandle(mapping);
+    if (!p) return false;
+#else
+    void* p = ::mmap(nullptr,length,PROT_READ,MAP_PRIVATE,static_cast<int>(file.native_handle()),aligned);
+    if (p == MAP_FAILED) return false;
+#endif
+    raw_ = p; mapped_ = length; bytes_ = bytes;
+    data_ = static_cast<const uint8_t*>(raw_)+(offset-aligned);
+    return true;
+}
+void FileView::close() {
+    if (raw_) {
+#ifdef _WIN32
+        UnmapViewOfFile(raw_);
+#else
+        ::munmap(raw_,mapped_);
+#endif
+    }
+    raw_ = nullptr; data_ = nullptr; bytes_ = mapped_ = 0;
+}
+}
diff --git a/core/platform/file.h b/core/platform/file.h
new file mode 100644
index 0000000..bd2a81a
--- /dev/null
+++ b/core/platform/file.h
@@ -0,0 +1,47 @@
+#pragma once
+#include <cstdint>
+#include <string>
+
+namespace rad::platform {
+// OS file ownership and 64-bit positional I/O, separate from tensor/container
+// validation. A short read is returned as such; callers decide whether EOF is legal.
+class File {
+public:
+    enum : unsigned { Read=1, Write=2, Create=4, Truncate=8, Direct=16 };
+    File() = default;
+    ~File() { close(); }
+    File(const File&) = delete;
+    File& operator=(const File&) = delete;
+    bool open(const std::string& utf8_path, unsigned mode, std::string* error);
+    void close();
+    bool valid() const { return native_ != -1; }
+    bool direct_unavailable() const { return direct_unavailable_; }
+    int64_t size() const;
+    int64_t read_at(void* dst, int64_t bytes, int64_t offset) const;
+    int64_t write_at(const void* src, int64_t bytes, int64_t offset) const;
+    // Call only with exclusive ownership: resizing while another thread reads
+    // or maps the file is not an engine-supported operation.
+    bool resize(int64_t bytes);
+    bool flush();
+    intptr_t native_handle() const { return native_; }
+private:
+    intptr_t native_ = -1;
+    bool direct_unavailable_ = false;
+};
+
+class FileView {
+public:
+    FileView() = default;
+    ~FileView() { close(); }
+    FileView(const FileView&) = delete;
+    FileView& operator=(const FileView&) = delete;
+    bool open(const File& file, int64_t offset, int64_t bytes);
+    void close();
+    const uint8_t* data() const { return data_; }
+    int64_t size() const { return bytes_; }
+private:
+    void* raw_ = nullptr;
+    const uint8_t* data_ = nullptr;
+    int64_t mapped_ = 0, bytes_ = 0;
+};
+}
diff --git a/core/platform/module.cpp b/core/platform/module.cpp
new file mode 100644
index 0000000..a5b4dce
--- /dev/null
+++ b/core/platform/module.cpp
@@ -0,0 +1,52 @@
+#include "module.h"
+#include <filesystem>
+#ifdef _WIN32
+#define WIN32_LEAN_AND_MEAN
+#define NOMINMAX
+#include <windows.h>
+#else
+#include <dlfcn.h>
+#endif
+
+namespace rad::platform {
+void* module_open(const std::string& path, std::string* error) {
+    if (error) error->clear();
+#ifdef _WIN32
+    try {
+        // DLL_LOAD_DIR is valid only for an absolute path. Do not search the
+        // working directory for dependencies or alter process-wide DLL policy.
+        const auto absolute = std::filesystem::absolute(std::filesystem::path(
+            std::u8string(reinterpret_cast<const char8_t*>(path.data()), path.size())));
+        auto h = LoadLibraryExW(absolute.c_str(), nullptr,
+            LOAD_LIBRARY_SEARCH_DLL_LOAD_DIR | LOAD_LIBRARY_SEARCH_DEFAULT_DIRS);
+        if (!h && error) *error = "LoadLibraryExW error " + std::to_string(GetLastError());
+        return reinterpret_cast<void*>(h);
+    } catch (const std::exception& e) {
+        if (error) *error = e.what();
+        return nullptr;
+    }
+#else
+    dlerror();
+    auto* h = dlopen(path.c_str(), RTLD_NOW | RTLD_LOCAL);
+    if (!h && error) { const char* e = dlerror(); *error = e ? e : "dlopen failed"; }
+    return h;
+#endif
+}
+void* module_symbol(void* handle, const char* name) {
+    if (!handle || !name) return nullptr;
+#ifdef _WIN32
+    return reinterpret_cast<void*>(GetProcAddress(reinterpret_cast<HMODULE>(handle), name));
+#else
+    dlerror();
+    return dlsym(handle, name);
+#endif
+}
+void module_close(void* handle) {
+    if (!handle) return;
+#ifdef _WIN32
+    FreeLibrary(reinterpret_cast<HMODULE>(handle));
+#else
+    dlclose(handle);
+#endif
+}
+}
