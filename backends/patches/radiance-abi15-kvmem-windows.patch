+    const int small_rc=small_d2h_try(dst,dp,src,sp,w,h,s,handled);
+    if(handled||small_rc!=RAD_OK)return small_rc;
+    return result(hipMemcpy2DAsync(dst, dp, src, sp, w, h, hipMemcpyDefault,
+                                  reinterpret_cast<hipStream_t>(s)), "hipMemcpy2DAsync");
+}
+int fill(void* dst, int v, int64_t bytes, RadStream s) {
+    HostCallTrace trace(HC_FILL);
+    if (!s || bytes < 0 || (bytes && !dst)) return RAD_E_INVAL;
+    if (!bytes) return RAD_OK;
+    return result(hipMemsetAsync(dst, v, bytes, reinterpret_cast<hipStream_t>(s)), "hipMemsetAsync");
+}
+int ranges(void* dst, const void* src, int64_t prefix, const RadCopyRange* r, int n, RadStream s) {
+    HostCallTrace trace(HC_RANGES);
+    if (!s || prefix < 0 || prefix % 16 || n < 0 || (n && !r) ||
+        ((n || prefix) && (!dst || !src))) return RAD_E_INVAL;
+    if ((reinterpret_cast<uintptr_t>(dst) | reinterpret_cast<uintptr_t>(src)) & 15) return RAD_E_ALIGN;
