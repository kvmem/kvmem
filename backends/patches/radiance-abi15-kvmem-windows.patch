+}
+}
+int hip_prioritize_next_allocation(int64_t bytes,const std::vector<HipPriorityRange>& ranges) {
+    const char* fixed=std::getenv("RADIANCE_HIP_FIXED_VA");
+    if(bytes<=0 || ranges.empty() || priority_allocation_bytes || !fixed || std::strcmp(fixed,"2")!=0 ||
