+    unsigned long long* ticks = nullptr;
+    int khz = 0, count = 0;
+    bool active = false, used = false;
+    struct Entry { unsigned op; std::string name, kernel; int64_t m, n, k; };
+    std::vector<Entry> entries;
+    ~OpClockProbe() { if(ticks) hipFree(ticks); }
+};
+static thread_local OpClockProbe op_clock;
+// Diagnostic only: one main pass, completed host wall clocks, no marker kernels
+// or extra device allocation. Synchronization changes overlap, so this is not
+// uninstrumented serving throughput. Keep the failed marker method separate.
+struct OpWallProbe {
+    bool active=false, used=false;
+    std::chrono::steady_clock::time_point start;
+    struct Entry { unsigned op; std::string name, kernel; double us; };
+    std::vector<Entry> entries;
+};
+static thread_local OpWallProbe op_wall;
+static int hip_op_wall_pass(bool begin,int step,int64_t tokens,int draft,RadStream stream) {
+    static const bool enabled=[] {const char* p=std::getenv("RADIANCE_HIP_OP_WALL");return p&&p[0]=='1';}();
+    if(!enabled)return RAD_OK;
+    auto& w=op_wall;
+    if(begin){
+        w.active=false;
+        if(w.used||step!=20||tokens!=4||draft!=0)return RAD_OK;
+        if(std::getenv("RADIANCE_HIP_OP_CLOCK"))return RAD_E_INVAL;
+        if(hipStreamSynchronize(reinterpret_cast<hipStream_t>(stream))!=hipSuccess)return RAD_E_DEVICE;
+        w.entries.reserve(4096);w.used=true;w.active=true;
+    }else if(w.active){
+        w.active=false;
+        fprintf(stderr,"HIP_OP_WALL_BEGIN step=%d entries=%zu\n",step,w.entries.size());
+        for(const auto& e:w.entries)fprintf(stderr,"HIP_OP_WALL op=%u name=%s kernel=%s completed_us=%.3f\n",e.op,e.name.c_str(),e.kernel.c_str(),e.us);
+        fprintf(stderr,"HIP_OP_WALL_END step=%d\n",step);
+    }
+    return RAD_OK;
+}
+int hip_op_clock_issue(bool begin,unsigned op,const char* name,const char* kernel,
+                       const RadArgs* args,RadStream stream) {
+    if(op_wall.active){
+        auto& w=op_wall;
+        if(begin){
+            if(w.entries.size()>=4096)return RAD_E_FULL;
+            if(hipStreamSynchronize(reinterpret_cast<hipStream_t>(stream))!=hipSuccess)return RAD_E_DEVICE;
+            w.entries.push_back({op,name?name:"?",kernel?kernel:"?",0});
+            w.start=std::chrono::steady_clock::now();
+        }else{
+            if(w.entries.empty())return RAD_E_STATE;
+            if(hipStreamSynchronize(reinterpret_cast<hipStream_t>(stream))!=hipSuccess)return RAD_E_DEVICE;
+            w.entries.back().us=std::chrono::duration<double,std::micro>(std::chrono::steady_clock::now()-w.start).count();
+        }
+        return RAD_OK;
+    }
+    auto& c=op_clock;
+    if(!c.active)return RAD_OK;
+    if(begin) {
+        if(c.count>=OpClockProbe::capacity)return RAD_E_FULL;
+        int64_t m=0,n=0,k=0;
+        if(args&&args->n_t>0&&args->t[0].rank==2){m=args->t[0].shape[0];k=args->t[0].shape[1];}
+        if(args&&args->n_t>4&&args->t[4].rank==2)n=args->t[4].shape[1];
+        c.entries.push_back({op,name?name:"?",kernel?kernel:"?",m,n,k});
+    }
+    const int rc=rad_diag_clock_stamp(c.ticks,2+c.count*2+(begin?0:1),stream);
+    if(!begin)++c.count;
+    return rc;
+}
+static int hip_op_clock_pass(bool begin,int step,int64_t tokens,int draft,RadStream stream) {
+    static const bool enabled=[] {const char* p=std::getenv("RADIANCE_HIP_OP_CLOCK");return p&&p[0]=='1';}();
+    if(!enabled)return RAD_OK;
+    auto& c=op_clock;
+    if(begin) {
+        c.active=false;
+        if(c.used||step!=20||tokens!=4||draft!=0)return RAD_OK;
+        if(hipDeviceGetAttribute(&c.khz,hipDeviceAttributeWallClockRate,0)!=hipSuccess||c.khz<=0)return RAD_E_DEVICE;
+        if(hipMalloc(&c.ticks,(2+2*OpClockProbe::capacity)*sizeof(unsigned long long))!=hipSuccess)return RAD_E_NOMEM;
+        c.entries.reserve(OpClockProbe::capacity);c.count=0;c.used=true;c.active=true;
+        if(rad_diag_clock_stamp(c.ticks,0,stream)<0||rad_diag_clock_stamp(c.ticks,1,stream)<0)return RAD_E_DEVICE;
+        return RAD_OK;
+    }
+    if(!c.active)return RAD_OK;
+    c.active=false;
+    if(hipStreamSynchronize(reinterpret_cast<hipStream_t>(stream))!=hipSuccess)return RAD_E_DEVICE;
+    std::vector<unsigned long long> t(2+c.count*2);
+    if(hipMemcpy(t.data(),c.ticks,t.size()*sizeof(t[0]),hipMemcpyDeviceToHost)!=hipSuccess)return RAD_E_DEVICE;
+    if(t[1]<t[0])return RAD_E_STATE;
+    std::fprintf(stderr,"HIP_OP_CLOCK_BEGIN step=%d entries=%d khz=%d blank_us=%.3f\n",step,c.count,c.khz,double(t[1]-t[0])*1000/c.khz);
+    for(int i=0;i<c.count;i++) {
+        if(t[3+i*2]<t[2+i*2])return RAD_E_STATE;
+        auto& e=c.entries[i];
+        std::fprintf(stderr,"HIP_OP_CLOCK op=%u name=%s kernel=%s m=%lld n=%lld k=%lld steady_us=%.3f\n",e.op,e.name.c_str(),e.kernel.c_str(),(long long)e.m,(long long)e.n,(long long)e.k,double(t[3+i*2]-t[2+i*2])*1000/c.khz);
+    }
+    std::fprintf(stderr,"HIP_OP_CLOCK_END step=%d\n",step);
+    return RAD_OK;
+}
+// Bounded, opt-in pass timing. Two events per forward pass, no extra wait,
+// no per-op events, no changed ordering. GPU spans include any supply gaps;
+// they are NOT the sum of kernel execution times. Sample decode-sized passes.
+int hip_pass_timing(bool begin, int step, int64_t tokens, int draft, RadStream stream) {
+    const int span_rc=hip_pass_span(begin,step,tokens,draft,stream);
+    if(span_rc<0)return span_rc;
+    const int wall_rc=hip_op_wall_pass(begin,step,tokens,draft,stream);
+    if(wall_rc<0)return wall_rc;
+    const int clock_rc=hip_op_clock_pass(begin,step,tokens,draft,stream);
+    if(clock_rc<0)return clock_rc;
+    static const bool wall=[] {const char* p=std::getenv("RADIANCE_HIP_PASS_WALL");return p&&p[0]=='1';}();
+    if(wall&&tokens>=1&&tokens<=4){
+        // Diagnostic ONLY: synchronized wall clock bypasses unreliable PAL event
+        // timestamps. This deliberately removes overlap, not a serving change.
+        static thread_local std::chrono::steady_clock::time_point start;
+        static thread_local double drain_us=0;
+        auto s=reinterpret_cast<hipStream_t>(stream);
+        if(begin){auto t=std::chrono::steady_clock::now();if(hipStreamSynchronize(s)!=hipSuccess)return RAD_E_DEVICE;start=std::chrono::steady_clock::now();drain_us=std::chrono::duration<double,std::micro>(start-t).count();}
+        else {if(hipStreamSynchronize(s)!=hipSuccess)return RAD_E_DEVICE;double ms=std::chrono::duration<double,std::milli>(std::chrono::steady_clock::now()-start).count();
+            std::fprintf(stderr,"HIP_PASS_WALL step=%d tokens=%lld draft=%d forward_ms=%.6f preceding_drain_us=%.3f\n",step,(long long)tokens,draft,ms,drain_us);}
+        return RAD_OK;
+    }
+    static const bool enabled=[] {const char* p=std::getenv("RADIANCE_HIP_PASS_TIMING");return p&&p[0]=='1';}();
+    if(!enabled||tokens<1||tokens>4)return RAD_OK;
+    struct Slot {hipEvent_t a=nullptr,b=nullptr;bool pending=false;int step=0,draft=0;int64_t tokens=0;double cpu_us=0;std::chrono::steady_clock::time_point start;};
+    struct Ring {Slot slots[32];int next=0,active=-1;bool initialized=false;
+        ~Ring(){for(auto& s:slots){if(s.a)hipEventDestroy(s.a);if(s.b)hipEventDestroy(s.b);}}};
+    static thread_local Ring ring;
+    auto s=reinterpret_cast<hipStream_t>(stream);
+    if(begin){
+        if(!ring.initialized){for(auto& q:ring.slots)if(hipEventCreate(&q.a)!=hipSuccess||hipEventCreate(&q.b)!=hipSuccess)return RAD_E_DEVICE;ring.initialized=true;}
+        for(auto& q:ring.slots)if(q.pending){
+            auto rc=hipEventQuery(q.b);if(rc==hipErrorNotReady)continue;if(rc!=hipSuccess)return RAD_E_DEVICE;
+            float ms=0;if(hipEventElapsedTime(&ms,q.a,q.b)!=hipSuccess)return RAD_E_DEVICE;
+            std::fprintf(stderr,"HIP_PASS_TIMING step=%d tokens=%lld draft=%d gpu_ms=%.6f submit_us=%.3f\n",q.step,(long long)q.tokens,q.draft,(double)ms,q.cpu_us);q.pending=false;
+        }
+        auto& q=ring.slots[ring.next];ring.active=-1;
+        if(q.pending){std::fprintf(stderr,"HIP_PASS_TIMING skipped_full_ring\n");return RAD_OK;}
+        q.step=step;q.tokens=tokens;q.draft=draft;
+        if(hipEventRecord(q.a,s)!=hipSuccess)return RAD_E_DEVICE;
+        q.start=std::chrono::steady_clock::now();ring.active=ring.next;ring.next=(ring.next+1)%32;
+    }else if(ring.active>=0){
+        auto& q=ring.slots[ring.active];q.cpu_us=std::chrono::duration<double,std::micro>(std::chrono::steady_clock::now()-q.start).count();
+        if(hipEventRecord(q.b,s)!=hipSuccess)return RAD_E_DEVICE;
+        q.pending=true;ring.active=-1;
+    }
+    return RAD_OK;
+}
+// Opt-in model-resident GEMM microtest. Deliberately synchronizes/repeats a pure
+// matrix op, so this run is NOT a throughput baseline. No new device allocation.
+int hip_gemm_wall_probe(unsigned op,const char* kernel,RadLaunchFn launch,const RadArgs* a,RadStream stream) {
+    static const bool on=[] {const char*v=std::getenv("RADIANCE_HIP_GEMM_WALL");return v&&v[0]=='1';}();
+    if(!on||!kernel||std::strncmp(kernel,"gemm_mxfp4a8",12)!=0||!a||a->n_t<5)return RAD_OK;
+    const auto& x=a->t[0];const auto& y=a->t[4];
+    if(x.rank!=2||y.rank!=2||y.dtype!=RAD_BF16||x.shape[0]<1||x.shape[0]>4)return RAD_OK;
+    if(y.data==x.data||y.data==a->t[1].data||y.data==a->t[2].data||y.data==a->t[3].data)return RAD_E_STATE;
+    char key[160];std::snprintf(key,sizeof(key),"%s M=%lld N=%lld K=%lld",kernel,(long long)x.shape[0],(long long)y.shape[1],(long long)x.shape[1]);
+    static thread_local std::map<std::string,bool> seen;
+    if(seen[key])return RAD_OK;seen[key]=true;
+    const size_t bytes=(size_t)y.shape[0]*(size_t)y.shape[1]*2;
+    if(bytes>8ull*1024*1024)return RAD_E_INVAL;
+    std::vector<unsigned char> before(bytes),after(bytes);
+    auto s=reinterpret_cast<hipStream_t>(stream);
+    if(hipStreamSynchronize(s)!=hipSuccess||hipMemcpy(before.data(),y.data,bytes,hipMemcpyDeviceToHost)!=hipSuccess)return RAD_E_DEVICE;
+    for(int batch=0;batch<3;batch++){
+        auto begin=std::chrono::steady_clock::now();
+        for(int i=0;i<16;i++){int rc=launch(a,stream);if(rc<0)return rc;}
+        if(hipStreamSynchronize(s)!=hipSuccess)return RAD_E_DEVICE;
+        double us=std::chrono::duration<double,std::micro>(std::chrono::steady_clock::now()-begin).count()/16;
+        if(hipMemcpy(after.data(),y.data,bytes,hipMemcpyDeviceToHost)!=hipSuccess)return RAD_E_DEVICE;
+        bool same=before==after;
+        std::fprintf(stderr,"GEMM_WALL op=%u %s repeat=%d wall_us=%.3f output_equal=%d\n",op,key,batch,us,int(same));std::fflush(stderr);
+        if(!same)return RAD_E_STATE;
+    }
+    return RAD_OK;
+}
+// Read-only per-process WDDM telemetry. A separate helper's CurrentUsage is not ours.
+static void trace_residency_budget(const char* phase) {
+#ifdef _WIN32
+    if (!std::getenv("RADIANCE_HIP_DXGI_TRACE")) return;
+    static HMODULE dll=LoadLibraryW(L"dxgi.dll");
+    using Create=HRESULT(WINAPI*)(REFIID,void**);
+    auto create=dll?reinterpret_cast<Create>(GetProcAddress(dll,"CreateDXGIFactory1")):nullptr;
+    IDXGIFactory1* factory=nullptr;
+    if(!create||FAILED(create(__uuidof(IDXGIFactory1),(void**)&factory)))return;
+    for(UINT i=0;;++i){
+        IDXGIAdapter1* adapter=nullptr;
+        if(factory->EnumAdapters1(i,&adapter)==DXGI_ERROR_NOT_FOUND)break;
+        if(!adapter)break;
+        DXGI_ADAPTER_DESC1 desc{};adapter->GetDesc1(&desc);
+        IDXGIAdapter3* query=nullptr;
+        if(desc.VendorId==0x1002&&SUCCEEDED(adapter->QueryInterface(__uuidof(IDXGIAdapter3),(void**)&query))){
+            for(int segment=0;segment<2;++segment){
+                DXGI_QUERY_VIDEO_MEMORY_INFO info{};
+                HRESULT hr=query->QueryVideoMemoryInfo(0,static_cast<DXGI_MEMORY_SEGMENT_GROUP>(segment),&info);
+                fprintf(stderr,"DXGI_PROCESS phase=%s luid=%08x:%08x segment=%d hr=%08x budget=%llu usage=%llu reservation=%llu\n",phase,unsigned(desc.AdapterLuid.HighPart),unsigned(desc.AdapterLuid.LowPart),segment,unsigned(hr),(unsigned long long)info.Budget,(unsigned long long)info.CurrentUsage,(unsigned long long)info.CurrentReservation);
+            }query->Release();
+        }adapter->Release();
+    }factory->Release();fflush(stderr);
+#endif
+}
+// Opt-in diagnostic only: replay one read-only attention op against an exact
+// temporary copy of its KV layer. Not a production placement policy.
+namespace {
+std::mutex allocation_probe_mutex;
+std::map<void*,size_t> allocation_probe_ranges;
+void record_probe_allocation(void* p,size_t bytes) {
+    if(!p||bytes<64ull*1024*1024||!std::getenv("RADIANCE_HIP_ALLOCATION_SCAN"))return;
+    std::lock_guard<std::mutex> lock(allocation_probe_mutex);
+    allocation_probe_ranges[p]=bytes;
+}
+int scan_probe_allocations(RadStream stream) {
+    if(!std::getenv("RADIANCE_HIP_ALLOCATION_SCAN"))return RAD_OK;
+    auto s=reinterpret_cast<hipStream_t>(stream);
+    if(hipStreamSynchronize(s)!=hipSuccess)return RAD_E_DEVICE;
+    std::vector<std::pair<void*,size_t>> ranges;
+    {std::lock_guard<std::mutex> lock(allocation_probe_mutex);
+     for(auto r:allocation_probe_ranges)ranges.push_back(r);}
+    constexpr size_t sample=8ull*1024*1024;
+    size_t available=0,total=0;
+    if(hipMemGetInfo(&available,&total)!=hipSuccess||available<sample+128ull*1024*1024)return RAD_E_NOMEM;
+    void* scratch=nullptr;
+    if(hipMalloc(&scratch,sample)!=hipSuccess)return RAD_E_NOMEM;
+    int status=RAD_OK;
+    // Completed wall time, not PAL event timestamps. Read-only samples; this
+    // intentionally perturbs residency and must never be a throughput baseline.
+    for(auto r:ranges) {
+        const size_t stride=r.second>3ull*1024*1024*1024?256ull*1024*1024:32ull*1024*1024;
+        // Always include the physical tail: a smaller mapping can leave less
+        // than one sampling stride on the slow path.
+        for(size_t off=0;;off=(std::min)(off+stride,r.second-sample)) {
+            auto begin=std::chrono::steady_clock::now();
+            for(int repeat=0;repeat<2;repeat++) {
+                if(hipMemcpyAsync(scratch,static_cast<char*>(r.first)+off,sample,hipMemcpyDeviceToDevice,s)!=hipSuccess){status=RAD_E_DEVICE;break;}
+            }
+            if(hipStreamSynchronize(s)!=hipSuccess)status=RAD_E_DEVICE;
+            double us=std::chrono::duration<double,std::micro>(std::chrono::steady_clock::now()-begin).count()/2;
+            fprintf(stderr,"ALLOCATION_SCAN base=%p bytes=%zu offset=%zu sample=%zu wall_us=%.3f\n",r.first,r.second,off,sample,us);
+            if(status<0||off==r.second-sample)break;
+        }
+        if(status<0)break;
+    }
+    fflush(stderr);
+    if(hipFree(scratch)!=hipSuccess)status=RAD_E_DEVICE;
+    return status;
+}
+}
+int hip_attention_copy_probe(unsigned op, RadLaunchFn launch, const RadArgs* a, RadStream stream) {
+    static thread_local bool budget_seen=false;
+    if(!budget_seen){trace_residency_budget("first-attention");budget_seen=true;int rc=scan_probe_allocations(stream);if(rc<0)return rc;}
+    static const bool enabled=std::getenv("RADIANCE_HIP_ATTN_COPY_PROBE")!=nullptr;
+    static thread_local unsigned selected=0;
+    static thread_local bool short_done=false,long_done=false;
+    if(!enabled||!a||a->n_t<8||a->t[0].shape[0]>4||a->t[1].dtype!=RAD_F8E4M3)return RAD_OK;
+    if(!selected)selected=op;
+    if(op!=selected||long_done)return RAD_OK;
+    auto s=reinterpret_cast<hipStream_t>(stream);
+    int ctx=0;
+    if(hipMemcpyAsync(&ctx,a->t[3].data,4,hipMemcpyDeviceToHost,s)!=hipSuccess||hipStreamSynchronize(s)!=hipSuccess)return RAD_E_DEVICE;
+    if((ctx<8000&&short_done)||ctx<1)return RAD_OK;
+    const auto& kv=a->t[1];size_t bytes=1;
+    for(unsigned i=0;i<kv.rank;i++)bytes+=size_t(kv.shape[i]-1)*size_t(kv.stride[i]);
+    size_t free=0,total=0;
+    if(bytes>128ull*1024*1024||hipMemGetInfo(&free,&total)!=hipSuccess||free<bytes+128ull*1024*1024)return RAD_E_NOMEM;
+    size_t outbytes=2;for(unsigned i=0;i<a->t[7].rank;i++)outbytes*=size_t(a->t[7].shape[i]);
+    std::vector<unsigned char> expected(outbytes),actual(outbytes);
+    if(hipMemcpy(expected.data(),a->t[7].data,outbytes,hipMemcpyDeviceToHost)!=hipSuccess)return RAD_E_DEVICE;
+    void* copy=nullptr;hipEvent_t begin=nullptr,end=nullptr;
+    int status=RAD_OK;
+    auto run=[&]()->int {
+        if(hipMalloc(&copy,bytes)!=hipSuccess||hipEventCreate(&begin)!=hipSuccess||hipEventCreate(&end)!=hipSuccess)return RAD_E_DEVICE;
+        hipEventRecord(begin,s);
+        if(hipMemcpyAsync(copy,kv.data,bytes,hipMemcpyDeviceToDevice,s)!=hipSuccess)return RAD_E_DEVICE;
+        hipEventRecord(end,s);if(hipEventSynchronize(end)!=hipSuccess)return RAD_E_DEVICE;
+        float copy_ms=0;hipEventElapsedTime(&copy_ms,begin,end);
+        std::vector<RadTensor> ts(a->t,a->t+a->n_t);RadArgs args=*a;args.t=ts.data();
+        for(int pass=0;pass<4;pass++) {
+            int path=(pass==0||pass==3)?1:0;
+            ts[1].data=path?copy:kv.data;
+            auto wall_start=std::chrono::steady_clock::now();
+            hipEventRecord(begin,s);
+            for(int i=0;i<3;i++){int rc=launch(&args,stream);if(rc<0)return rc;}
+            hipEventRecord(end,s);if(hipEventSynchronize(end)!=hipSuccess)return RAD_E_DEVICE;
+            double wall_us=std::chrono::duration<double,std::micro>(std::chrono::steady_clock::now()-wall_start).count()/3;
+            float ms=0;hipEventElapsedTime(&ms,begin,end);
+            if(hipMemcpy(actual.data(),a->t[7].data,outbytes,hipMemcpyDeviceToHost)!=hipSuccess)return RAD_E_DEVICE;
+            const bool same=actual==expected;
+            fprintf(stderr,"ATTN_COPY_PROBE op=%u ctx=%d q=%lld bytes=%zu copy_ms=%.3f pass=%d path=%s us=%.3f wall_us=%.3f output_equal=%d\n",op,ctx,(long long)a->t[0].shape[0],bytes,copy_ms,pass,path?"copy":"original",ms*1000/3,wall_us,int(same));fflush(stderr);
+            if(!same)return RAD_E_STATE;
+        }
+        return RAD_OK;
+    };
+    status=run();
+    hipStreamSynchronize(s);
+    if(begin)hipEventDestroy(begin);if(end)hipEventDestroy(end);if(copy)hipFree(copy);
+    if(ctx>=8000)long_done=true;else short_done=true;
+    return status;
+}
+namespace {
+const DeviceBackend* base = nullptr;
+DeviceBackend runtime{};
+std::once_flag once;
