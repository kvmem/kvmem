+#pragma once
+// Compatibility for legacy writer descriptors only. Model reads use File's
+// independent OVERLAPPED offsets. These positional writer calls serialize the
+// CRT seek/read/restore sequence so concurrent plane writes cannot race.
+#ifdef _WIN32
+#include <io.h>
+#include <fcntl.h>
+#include <sys/stat.h>
+#include <algorithm>
+#include <cerrno>
+#include <cstdint>
+#include <mutex>
+using ssize_t = intptr_t;
+inline std::mutex& rad_fd_position_mutex() { static std::mutex m; return m; }
+inline ssize_t pread(int fd, void* p, size_t n, int64_t off) {
+    if(off<0) { errno=EINVAL; return -1; }
+    std::lock_guard<std::mutex> lock(rad_fd_position_mutex());
+    const auto old=_lseeki64(fd,0,SEEK_CUR);
+    if(old<0 || _lseeki64(fd,off,SEEK_SET)<0)return -1;
+    const int result=_read(fd,p,static_cast<unsigned>(std::min<size_t>(n,1u<<30)));
+    const int saved=errno;
+    if(_lseeki64(fd,old,SEEK_SET)<0)return -1;
+    errno=saved; return result;
+}
+inline ssize_t pwrite(int fd, const void* p, size_t n, int64_t off) {
+    if(off<0) { errno=EINVAL; return -1; }
+    std::lock_guard<std::mutex> lock(rad_fd_position_mutex());
+    const auto old=_lseeki64(fd,0,SEEK_CUR);
+    if(old<0 || _lseeki64(fd,off,SEEK_SET)<0)return -1;
+    const int result=_write(fd,p,static_cast<unsigned>(std::min<size_t>(n,1u<<30)));
+    const int saved=errno;
+    if(_lseeki64(fd,old,SEEK_SET)<0)return -1;
+    errno=saved; return result;
+}
+inline int ftruncate(int fd, int64_t n) { return _chsize_s(fd,n)==0 ? 0 : -1; }
+inline int fsync(int fd) { return _commit(fd); }
+// Scope of this header is limited to legacy I/O translation units.
+#define O_CLOEXEC (_O_NOINHERIT | _O_BINARY)
+#define stat _stat64
+#define fstat _fstat64
+#define lseek _lseeki64
+#endif
