+// Opt-in CPU wall-time attribution. These durations include waiting for queued
+// GPU work; they must NOT be reported as pure driver overhead or kernel time.
+// No extra GPU events, synchronization, altered fence scope or launch ordering.
+enum HostOp { HS_SYNC, HE_RECORD, HE_WAIT, HE_QUERY, HE_SYNC, HC_COPY,
+              HC_COPY2D, HC_FILL, HC_RANGES, HOST_OPS };
+struct HostCallTrace {
+    using Clock = std::chrono::steady_clock;
+    HostOp op;
+    bool enabled;
+    Clock::time_point start;
+    explicit HostCallTrace(HostOp value) : op(value) {
+        static const bool on = [] { const char* v=std::getenv("RADIANCE_HIP_HOST_TRACE");
+                                  return v && v[0]=='1'; }();
+        enabled=on;
+        if(enabled) start=Clock::now();
+    }
+    ~HostCallTrace() {
+        if(!enabled) return;
+        auto end=Clock::now();
+        struct Stats { uint64_t n[HOST_OPS]{}; double us[HOST_OPS]{}, peak[HOST_OPS]{};
+                       Clock::time_point since=Clock::now(); };
+        static thread_local Stats st;
+        double us=std::chrono::duration<double,std::micro>(end-start).count();
+        ++st.n[op];st.us[op]+=us;st.peak[op]=(std::max)(st.peak[op],us);
+        if(std::chrono::duration<double>(end-st.since).count()<1.0) return;
+        static const char* names[]={"stream_sync","event_record","event_wait",
+            "event_query","event_sync","copy","copy2d","fill","ranges"};
+        const auto thread=std::hash<std::thread::id>{}(std::this_thread::get_id());
+        for(int i=0;i<HOST_OPS;i++) if(st.n[i])
+            std::fprintf(stderr,"HIP_HOST_TRACE thread=%zu op=%s calls=%llu total_us=%.3f max_us=%.3f\n",
+                thread,names[i],(unsigned long long)st.n[i],st.us[i],st.peak[i]);
+        std::fflush(stderr);
+        st=Stats{};
+    }
+};
+
+int result(hipError_t e, const char* op) {
+    if (e == hipSuccess) return RAD_OK;
+    device_set_error("%s: %s", op, hipGetErrorString(e));
+    if (e == hipErrorOutOfMemory) return RAD_E_NOMEM;
+    if (e == hipErrorNotSupported) return RAD_E_UNSUPPORTED;
+    if (e == hipErrorInvalidValue || e == hipErrorInvalidHandle) return RAD_E_INVAL;
+    return RAD_E_DEVICE;
+}
+static thread_local int64_t priority_allocation_bytes=0;
+static thread_local std::vector<HipPriorityRange> priority_allocation_ranges;
+struct FixedVaAllocation { size_t bytes; std::vector<hipMemGenericAllocationHandle_t> handles; };
+std::mutex fixed_va_mutex;
+std::map<void*,FixedVaAllocation> fixed_va_allocations;
+void* alloc_fixed_va(size_t bytes) {
+    int dev=0; if(result(hipGetDevice(&dev),"fixed-va device")<0)return nullptr;
+    hipMemAllocationProp prop{};prop.type=hipMemAllocationTypePinned;
+    prop.location.type=hipMemLocationTypeDevice;prop.location.id=dev;
+    size_t granule=0;
+    if(result(hipMemGetAllocationGranularity(&granule,&prop,hipMemAllocationGranularityMinimum),"fixed-va granule")<0||!granule)return nullptr;
+    const char* mode=std::getenv("RADIANCE_HIP_FIXED_VA");
+    const bool segmented=mode&&mode[0]=='2';
+    size_t chunk_mib=64;
+    if(segmented)if(const char* value=std::getenv("RADIANCE_HIP_KV_CHUNK_MIB")) {
+        char* end=nullptr;const auto requested=std::strtoull(value,&end,10);
+        if(!end||*end||requested<1||requested>64||(requested&(requested-1))) {
+            device_set_error("KV physical chunk must be a power of two from1 to64MiB");return nullptr;
+        }
+        chunk_mib=static_cast<size_t>(requested);
+    }
+    size_t rounded=((bytes+granule-1)/granule)*granule;
+    size_t chunk=segmented?((chunk_mib*1024*1024+granule-1)/granule)*granule:rounded;
+    // Equal-sized mappings satisfy HIP's sub-buffer check and PAL's single-object
+    // size check. Explicitly report padding; never expose it as extra KV capacity.
+    if(segmented)rounded=((rounded+chunk-1)/chunk)*chunk;
+    void* address=nullptr;
+    if(result(hipMemAddressReserve(&address,rounded,0,nullptr,0),"fixed-va reserve")<0)return nullptr;
+    FixedVaAllocation allocation{rounded,{}};size_t mapped=0;bool access_ok=true;
+    hipMemAccessDesc access{};access.location=prop.location;access.flags=hipMemAccessFlagsProtReadWrite;
+    if(priority_allocation_bytes) {
+        if(!segmented || bytes!=static_cast<size_t>(priority_allocation_bytes)) {
+            (void)hipMemAddressFree(address,rounded);
+            device_set_error("KV priority requires matching complete segmented allocation");return nullptr;
+        }
+        const size_t count=rounded/chunk;
+        std::vector<size_t> order(count);std::vector<int> priority(count,0);
+        for(size_t i=0;i<count;++i) {
+            order[i]=i;
+            for(const auto& range:priority_allocation_ranges)
+                if(i*chunk<static_cast<size_t>(range.offset+range.bytes) &&
+                   (i+1)*chunk>static_cast<size_t>(range.offset))
+                    priority[i]=(std::max)(priority[i],range.priority);
+        }
+        std::stable_sort(order.begin(),order.end(),[&](size_t a,size_t b){return priority[a]>priority[b];});
+        allocation.handles.resize(count);
+        bool created=true;
+        for(size_t index:order) {
+            if(result(hipMemCreate(&allocation.handles[index],chunk,&prop,0),"priority physical create")<0) {
+                created=false;break;
+            }
+        }
+        if(created)for(size_t i=0;i<count;++i) {
+            if(result(hipMemMap(static_cast<char*>(address)+i*chunk,chunk,0,allocation.handles[i],0),"priority sequential map")<0)break;
+            mapped+=chunk;
+            if(result(hipMemSetAccess(static_cast<char*>(address)+i*chunk,chunk,&access,1),"priority segment access")<0){access_ok=false;break;}
+        }
+        const size_t hot=std::count_if(priority.begin(),priority.end(),[](int p){return p>0;});
+        fprintf(stderr,"HIP_KV_PRIORITY hot_bytes=%zu cold_bytes=%zu complete_bytes=%zu\n",hot*chunk,(count-hot)*chunk,rounded);fflush(stderr);
+        if(!created)access_ok=false;
+    } else
+    while(mapped<rounded){
+        size_t count=(std::min)(chunk,rounded-mapped);hipMemGenericAllocationHandle_t handle{};
+        if(result(hipMemCreate(&handle,count,&prop,0),"fixed-va create")<0)break;
+        if(result(hipMemMap(static_cast<char*>(address)+mapped,count,0,handle,0),"fixed-va map")<0){(void)hipMemRelease(handle);break;}
+        allocation.handles.push_back(handle);mapped+=count;
+        if(segmented&&result(hipMemSetAccess(static_cast<char*>(address)+mapped-count,count,&access,1),"fixed-va equal segment access")<0){access_ok=false;break;}
+    }
+    // SetAccess validates a complete set of mapped sub-buffers in HIP 7.2.
+    // Apply it once to the whole reservation, not to partial/tail mappings.
+    bool good=access_ok&&mapped==rounded&&(segmented||result(hipMemSetAccess(address,rounded,&access,1),"fixed-va whole access")==RAD_OK);
+    if(!good){
+        if(mapped)(void)hipMemUnmap(address,mapped);
+        for(auto h:allocation.handles)if(h)(void)hipMemRelease(h);
+        (void)hipMemAddressFree(address,rounded);return nullptr;
+    }
+    fprintf(stderr,"HIP_FIXED_VA bytes=%zu rounded=%zu padding=%zu chunks=%zu segmented=%d chunk_bytes=%zu\n",bytes,rounded,rounded-bytes,allocation.handles.size(),int(segmented),chunk);fflush(stderr);
+    std::lock_guard<std::mutex> lock(fixed_va_mutex);
+    fixed_va_allocations.emplace(address,std::move(allocation));return address;
+}
+bool free_fixed_va(void* p) {
+    std::lock_guard<std::mutex> lock(fixed_va_mutex);auto it=fixed_va_allocations.find(p);
+    if(it==fixed_va_allocations.end())return false;
+    if(result(hipDeviceSynchronize(),"fixed-va free sync")<0)return true;
+    if(result(hipMemUnmap(p,it->second.bytes),"fixed-va whole unmap")<0)return true;
+    for(auto h:it->second.handles)if(result(hipMemRelease(h),"fixed-va release")<0)return true;
+    if(result(hipMemAddressFree(p,it->second.bytes),"fixed-va address free")<0)return true;
+    fixed_va_allocations.erase(it);return true;
+}
+// Diagnostic alternative to manual virtual mappings: HIP owns the complete
+// allocation and backing. Synchronous allocation/free at the adapter boundary
+// preserves the existing contract for all compute and transfer streams.
+struct NativePoolAllocation { hipMemPool_t pool{}; hipStream_t stream{}; size_t live=0; };
+static std::mutex native_pool_mutex;
+static std::map<int,NativePoolAllocation> native_pools;
+static std::map<void*,int> native_pool_pointers;
+static void* alloc_native_pool(size_t bytes) {
+    std::lock_guard<std::mutex> lock(native_pool_mutex);
+    int device=0, supported=0;
+    if(result(hipGetDevice(&device),"native-pool device")<0 ||
+       result(hipDeviceGetAttribute(&supported,hipDeviceAttributeMemoryPoolsSupported,device),"native-pool support")<0) return nullptr;
+    if(!supported) {device_set_error("native stream-ordered memory pools unsupported");return nullptr;}
+    auto& entry=native_pools[device];
+    if(!entry.pool) {
+        hipMemPoolProps props{};props.allocType=hipMemAllocationTypePinned;
+        props.location.type=hipMemLocationTypeDevice;props.location.id=device;
+        if(result(hipMemPoolCreate(&entry.pool,&props),"native-pool create")<0)return nullptr;
+        if(result(hipStreamCreateWithFlags(&entry.stream,hipStreamNonBlocking),"native-pool stream")<0) {
+            hipMemPoolDestroy(entry.pool);native_pools.erase(device);return nullptr;
+        }
+    }
+    void* p=nullptr;
+    if(result(hipMallocFromPoolAsync(&p,bytes,entry.pool,entry.stream),"native-pool alloc")<0)return nullptr;
+    if(result(hipStreamSynchronize(entry.stream),"native-pool alloc complete")<0)return nullptr;
+    native_pool_pointers.emplace(p,device);++entry.live;
+    fprintf(stderr,"HIP_NATIVE_POOL bytes=%zu device=%d live=%zu\n",bytes,device,entry.live);fflush(stderr);
+    return p;
+}
+static bool free_native_pool(void* p) {
+    std::lock_guard<std::mutex> lock(native_pool_mutex);
+    auto found=native_pool_pointers.find(p);
+    if(found==native_pool_pointers.end())return false;
+    int previous=0;
+    if(result(hipGetDevice(&previous),"native-pool free device")<0)return true;
+    const int device=found->second;
+    if(result(hipSetDevice(device),"native-pool free select")<0)return true;
+    auto& entry=native_pools.at(device);
+    // Match hipFree's synchronization; never recycle a buffer still in use.
+    int rc=result(hipDeviceSynchronize(),"native-pool free wait");
+    if(rc==RAD_OK)rc=result(hipFreeAsync(p,entry.stream),"native-pool free");
+    if(rc==RAD_OK)rc=result(hipStreamSynchronize(entry.stream),"native-pool free complete");
+    if(rc==RAD_OK) {
+        native_pool_pointers.erase(found);
+        if(--entry.live==0) {
+            result(hipMemPoolDestroy(entry.pool),"native-pool destroy");
+            result(hipStreamDestroy(entry.stream),"native-pool stream destroy");
+            native_pools.erase(device);
+        }
+    }
+    if(previous!=device)result(hipSetDevice(previous),"native-pool restore device");
+    return true;
+}
+void* alloc_impl(int64_t bytes, int kind) {
+    if (bytes <= 0) return nullptr;
+    const char* native_pool=std::getenv("RADIANCE_HIP_NATIVE_POOL");
+    if(kind==RAD_MEM_DEVICE && bytes>=64ll*1024*1024 && native_pool && std::strcmp(native_pool,"1")==0) {
+        void* p=alloc_native_pool(static_cast<size_t>(bytes));
+        record_probe_allocation(p,static_cast<size_t>(bytes));return p;
+    }
+    const char* fixed=std::getenv("RADIANCE_HIP_FIXED_VA");
+    // Opt-in allocation experiment: segment large workspace allocations too.
+    // Segmenting KV alone can leave the later activation arena on a slow heap.
+    // This size-based switch is diagnostic, not a production allocation-role API.
+    // Keep weights (>3GiB), host buffers, sizes and all logical offsets unchanged.
+    const char* workspace=std::getenv("RADIANCE_HIP_SEGMENT_WORKSPACE");
+    const bool segment_workspace=workspace&&std::strcmp(workspace,"1")==0;
+    const char* all_large=std::getenv("RADIANCE_HIP_SEGMENT_ALL_LARGE");
+    const bool segment_all=all_large&&std::strcmp(all_large,"1")==0;
+    const int64_t fixed_min=(segment_workspace||segment_all)?64ll*1024*1024:1024ll*1024*1024;
+    if((segment_workspace||segment_all)&&(!fixed||std::strcmp(fixed,"2")!=0)) {
+        device_set_error("segmented workspace/weights requires RADIANCE_HIP_FIXED_VA=2");
+        return nullptr;
+    }
+    if(kind==RAD_MEM_DEVICE&&bytes>=fixed_min&&(segment_all||bytes<=3ll*1024*1024*1024)&&fixed&&(fixed[0]=='1'||fixed[0]=='2')) {
+        void* p=alloc_fixed_va(static_cast<size_t>(bytes));
+        record_probe_allocation(p,static_cast<size_t>(bytes));return p;
+    }
+    if (kind != RAD_MEM_HOST_PINNED && kind != RAD_MEM_HOST_MAPPED) {
+        void* allocated=base->alloc(bytes, kind);
+        if(kind==RAD_MEM_DEVICE)record_probe_allocation(allocated,static_cast<size_t>(bytes));
+        if(kind==RAD_MEM_DEVICE&&bytes>64*1024*1024)trace_residency_budget("device-allocation");
+        return allocated;
+    }
+    void* p = nullptr;
+    // Both classes must be GPU accessible; the pinned class is used by ranged
+    // copies as well as DMA. hipHostMalloc owns both the pinning and lifetime.
+    if (result(hipHostMalloc(&p, static_cast<size_t>(bytes),
+                            hipHostMallocPortable | hipHostMallocMapped), "hipHostMalloc") < 0)
+        return nullptr;
+    return p;
+}
+void free_mem(void* p, int kind) {
+    if (!p) return;
+    small_d2h_forget(p);
+    if(kind==RAD_MEM_DEVICE&&std::getenv("RADIANCE_HIP_ALLOCATION_SCAN")){
+        std::lock_guard<std::mutex> lock(allocation_probe_mutex);allocation_probe_ranges.erase(p);
+    }
+    if(kind==RAD_MEM_DEVICE&&free_native_pool(p))return;
+    if(kind==RAD_MEM_DEVICE&&free_fixed_va(p))return;
+    if (kind == RAD_MEM_HOST_PINNED || kind == RAD_MEM_HOST_MAPPED)
+        result(hipHostFree(p), "hipHostFree");
+    else base->free(p, kind);
+}
+void* alloc(int64_t bytes, int kind) {
+    void* p=alloc_impl(bytes,kind);
+    if(p && small_d2h_register(p,bytes,kind)!=RAD_OK) {
+        free_mem(p,kind);
+        device_set_error("small D2H allocation alias registration failed");
+        return nullptr;
+    }
+    return p;
+}
+int stream_create(RadStream* out, int high) {
+    if (!out) return RAD_E_INVAL;
+    *out = nullptr;
+    int least = 0, greatest = 0;
+    if (high) {
+        int rc = result(hipDeviceGetStreamPriorityRange(&least, &greatest), "stream priority");
+        if (rc < 0) return rc;
+    }
+    hipStream_t s = nullptr;
+    int rc = result(hipStreamCreateWithPriority(&s, hipStreamNonBlocking, high ? greatest : 0),
+                    "hipStreamCreateWithPriority");
+    if (rc == RAD_OK) *out = reinterpret_cast<RadStream>(s);
+    return rc;
+}
+void stream_destroy(RadStream s) {
+    if (s) result(hipStreamDestroy(reinterpret_cast<hipStream_t>(s)), "hipStreamDestroy");
+}
+int stream_sync(RadStream s) {
+    CpuSpan cpu_span("hip_stream_sync");
+    HostCallTrace trace(HS_SYNC);
+    return s ? result(hipStreamSynchronize(reinterpret_cast<hipStream_t>(s)), "hipStreamSynchronize") : RAD_E_INVAL;
+}
+struct Event { hipEvent_t handle = nullptr; unsigned flags = 0; };
+int event_create(RadEvent* out, unsigned flags) {
+    if (!out || (flags & ~(RAD_EVENT_LOCAL | RAD_EVENT_HOST_WAIT))) return RAD_E_INVAL;
+    *out = nullptr;
+    auto* e = new(std::nothrow) Event;
+    if (!e) return RAD_E_NOMEM;
+    // Deliberately retain system visibility even for local events. A stronger
+    // fence is safe; do not claim AQL's cheaper agent-only scope on this path.
+    unsigned hip_flags = hipEventDefault;
+    // Opt-in diagnostic matching RAD_EVENT_LOCAL's existing single-card
+    // contract. Never weaken host-readback/host-wait events.
+    const char* local_release = std::getenv("RADIANCE_HIP_LOCAL_RELEASE");
+    if (flags == RAD_EVENT_LOCAL && local_release && local_release[0] == '1')
+        hip_flags |= hipEventDisableSystemFence;
+    int rc = result(hipEventCreateWithFlags(&e->handle, hip_flags), "hipEventCreate");
+    if (rc < 0) { delete e; return rc; }
+    e->flags = flags;
+    *out = e;
+    return RAD_OK;
+}
+void event_destroy(RadEvent p) {
+    auto* e = static_cast<Event*>(p);
+    if (e) { result(hipEventDestroy(e->handle), "hipEventDestroy"); delete e; }
+}
+int event_record(RadEvent e, RadStream s) {
+    CpuSpan cpu_span("hip_event_record");
+    HostCallTrace trace(HE_RECORD);
+    return e && s ? result(hipEventRecord(static_cast<Event*>(e)->handle,
+        reinterpret_cast<hipStream_t>(s)), "hipEventRecord") : RAD_E_INVAL;
+}
+int event_wait(RadStream s, RadEvent e) {
+    CpuSpan cpu_span("hip_event_wait");
+    HostCallTrace trace(HE_WAIT);
+    return e && s ? result(hipStreamWaitEvent(reinterpret_cast<hipStream_t>(s),
+        static_cast<Event*>(e)->handle, 0), "hipStreamWaitEvent") : RAD_E_INVAL;
+}
+int event_query(RadEvent e) {
+    HostCallTrace trace(HE_QUERY);
+    if (!e) return RAD_E_INVAL;
+    auto rc = hipEventQuery(static_cast<Event*>(e)->handle);
+    if (rc == hipSuccess) return 1;
+    if (rc == hipErrorNotReady) return 0;
+    return result(rc, "hipEventQuery");
+}
+int event_sync(RadEvent e) {
+    CpuSpan cpu_span("hip_event_sync");
+    HostCallTrace trace(HE_SYNC);
+    if (!e || !(static_cast<Event*>(e)->flags & RAD_EVENT_HOST_WAIT)) return RAD_E_INVAL;
+    return result(hipEventSynchronize(static_cast<Event*>(e)->handle), "hipEventSynchronize");
+}
+int elapsed(RadEvent a, RadEvent b, float* out) {
+    if (!a || !b || !out) return RAD_E_INVAL;
+    return result(hipEventElapsedTime(out, static_cast<Event*>(a)->handle,
+                                      static_cast<Event*>(b)->handle), "hipEventElapsedTime");
+}
+void host_wrote() { std::atomic_thread_fence(std::memory_order_seq_cst); }
+int copy(void* dst, const void* src, int64_t bytes, RadStream s) {
+    HostCallTrace trace(HC_COPY);
+    if (!s || bytes < 0 || (bytes && (!dst || !src))) return RAD_E_INVAL;
+    if (!bytes) return RAD_OK;
+    return result(hipMemcpyAsync(dst, src, bytes, hipMemcpyDefault,
+                                reinterpret_cast<hipStream_t>(s)), "hipMemcpyAsync");
+}
+int copy2d(void* dst, int64_t dp, const void* src, int64_t sp,
+           int64_t w, int64_t h, RadStream s) {
+    HostCallTrace trace(HC_COPY2D);
+    if (!s || w < 0 || h < 0 || dp < w || sp < w || (w && h && (!dst || !src))) return RAD_E_INVAL;
+    if (!w || !h) return RAD_OK;
