diff --git a/core/device/cpu_span.h b/core/device/cpu_span.h
new file mode 100644
index 0000000..9e2fc44
--- /dev/null
+++ b/core/device/cpu_span.h
@@ -0,0 +1,48 @@
+#pragma once
+// Opt-in host timeline only. No device calls, extra fences, or math changes.
+// Nested spans overlap: their durations must not be blindly summed.
+#include <chrono>
+#include <cstdio>
+#include <cstdlib>
+#include <cstdint>
+#include <functional>
+#include <cstring>
+#include <thread>
+#include <vector>
+namespace rad {
+struct CpuSpan {
+    using Clock = std::chrono::steady_clock;
+    struct Entry { const char* name; int step, draft; int64_t tokens, begin, end; };
+    struct Buffer {
+        std::vector<Entry> entries;
+        size_t dropped = 0;
+        void flush() {
+            const auto tid = std::hash<std::thread::id>{}(std::this_thread::get_id());
+            for (const auto& e : entries)
+                std::fprintf(stderr, "CPU_SPAN thread=%zu name=%s step=%d draft=%d tokens=%lld begin_ns=%lld end_ns=%lld\n",
+                    tid,e.name,e.step,e.draft,(long long)e.tokens,(long long)e.begin,(long long)e.end);
+            std::fprintf(stderr,"CPU_SPAN_DONE thread=%zu count=%zu dropped=%zu\n",tid,entries.size(),dropped);
+            entries.clear();
+        }
+        ~Buffer() { if(!entries.empty())flush(); }
+    };
+    static bool enabled() {
+        static const bool on=[] { const char* p=std::getenv("RADIANCE_CPU_SPANS");return p&&p[0]=='1'; }();
+        return on;
+    }
+    static int64_t now() { return std::chrono::duration_cast<std::chrono::nanoseconds>(Clock::now().time_since_epoch()).count(); }
+    bool on; Entry e;
+    explicit CpuSpan(const char* name,int step=-1,int64_t tokens=0,int draft=-1)
+        :on(enabled()),e{name,step,draft,tokens,0,0} { if(on)e.begin=now(); }
+    ~CpuSpan() {
+        if(!on)return;
+        e.end=now();
+        static thread_local Buffer buffer;
+        if(buffer.entries.size()<65536)buffer.entries.push_back(e);else ++buffer.dropped;
+        // The harness terminates the HTTP child after its last response. Emit at
+        // pass/collection boundaries rather than depending on TLS destruction.
+        if(!std::strcmp(e.name,"forward_submit") || !std::strcmp(e.name,"collect_step") ||
+           !std::strcmp(e.name,"draft_submit") || buffer.entries.size()>=4096)buffer.flush();
+    }
+};
+}
