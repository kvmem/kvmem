+// TP prefill splits one logical chunk into pieces on the same compute stream.
+// Positions, page bins and compact Query rows must still describe that whole
+// chunk, including when a piece boundary crosses a KV page or Query boundary.
+void check_pieces(int channels, const std::vector<int>& sizes, int block, bool graph) {
+    int tokens = 0;
+    for (int size : sizes) tokens += size;
+    const int buckets = block ? (tokens + 2 * block - 2) / block : 1;
+    const int capacity = tokens;
+    constexpr int guard = 64;
+    std::mt19937 rng(251U + channels + tokens);
+    std::uniform_real_distribution<float> random(-4.0F, 4.0F);
+    std::vector<std::uint16_t> represented(std::size_t(channels) * tokens);
+    for (auto& value : represented) value = f32_to_bf16(random(rng));
+    auto x = to_device(represented);
+    auto origin_buffer = to_device(std::vector<int>{0});
+    auto range_buffer = to_device(std::vector<int>{0, 0});
+    auto sums_buffer = to_device(std::vector<float>(std::size_t(channels) * buckets + guard, 12345.0F));
+    auto query_buffer = to_device(std::vector<std::uint16_t>(std::size_t(channels) * capacity + guard, 0xA55A));
+    auto mean_buffer = to_device(std::vector<float>(channels + guard, 12345.0F));
+    Tensor input(x.p, DType::BF16, {channels, tokens});
+    Tensor origin(origin_buffer.p, DType::I32, {1});
+    Tensor range(range_buffer.p, DType::I32, {2});
+    Tensor sums(sums_buffer.p, DType::FP32, {channels, buckets});
+    Tensor query(query_buffer.p, DType::BF16, {channels, capacity});
+    Tensor mean(mean_buffer.p, DType::FP32, {channels, 1});
+    cudaStream_t stream = nullptr;
+    cuda_check(cudaStreamCreate(&stream), "pieces stream");
+    const auto execute = [&] {
+        int offset = 0;
+        for (int size : sizes) {
+            auto piece = input.slice(1, offset, size);
+            ops::token_sums(piece, origin, range, block, sums, stream, offset, tokens);
+            ops::capture_query_rows(piece, origin, range, query, stream, offset, tokens);
+            ops::accumulate_query_sum(piece, origin, range, mean, stream, offset, tokens);
+            offset += size;
+        }
+    };
+    cudaGraph_t captured = nullptr;
+    cudaGraphExec_t executable = nullptr;
+    if (graph) {
+        cuda_check(cudaStreamBeginCapture(stream, cudaStreamCaptureModeGlobal), "pieces capture");
+        execute();
+        cuda_check(cudaStreamEndCapture(stream, &captured), "pieces capture end");
+        cuda_check(cudaGraphInstantiate(&executable, captured, nullptr, nullptr, 0), "pieces instantiate");
+    }
+    const int spans[][2] = {{0, tokens}, {sizes.front()-7, tokens-13},
+                           {-17, sizes.front()+9}, {tokens+1, tokens+9}, {tokens-19, tokens+7}};
+    for (int pass = 0; pass < 5; ++pass) {
+        const int start = 498 + pass * 37;
+        const int limits[] = {start + spans[pass][0], start + spans[pass][1]};
+        origin_buffer.copy_from_host(&start, sizeof(start));
+        range_buffer.copy_from_host(limits, sizeof(limits));
+        std::vector<float> sequential_mean(channels, 1.25F);
+        mean_buffer.copy_from_host(sequential_mean.data(), channels*sizeof(float));
+        if (graph) cuda_check(cudaGraphLaunch(executable, stream), "pieces replay");
+        else execute();
+        cuda_check(cudaStreamSynchronize(stream), "pieces completion");
+        const auto actual_sums = from_device<float>(sums_buffer, sums.numel()+guard);
+        const auto actual_query = from_device<std::uint16_t>(query_buffer, query.numel()+guard);
+        const auto actual_mean = from_device<float>(mean_buffer, channels+guard);
+        std::vector<float> sequential_sums(sums.numel(), 0.0F);
+        std::vector<double> reference(sums.numel()), absolute(sums.numel());
+        std::vector<std::uint16_t> expected_query(query.numel(), 0);
+        int query_row = 0;
+        for (int row = 0; row < tokens; ++row) {
+            if (start+row < limits[0] || start+row >= limits[1]) continue;
+            const int bucket = block ? (start+row)/block-start/block : 0;
+            for (int channel = 0; channel < channels; ++channel) {
+                const auto bits = represented[std::size_t(row)*channels+channel];
+                const float value = bf16_to_f32(bits);
+                const auto cell = std::size_t(bucket)*channels+channel;
+                sequential_sums[cell] += value;
+                reference[cell] += value;
+                absolute[cell] += std::abs(value);
+                sequential_mean[channel] += value;
+                expected_query[std::size_t(query_row)*channels+channel] = bits;
+            }
+            ++query_row;
+        }
+        for (std::size_t cell = 0; cell < sums.numel(); ++cell) {
+            const double bound = 2.0*tokens*std::numeric_limits<float>::epsilon()*absolute[cell];
+            if (actual_sums[cell] != sequential_sums[cell] ||
+                !std::isfinite(actual_sums[cell]) ||
+                std::abs(actual_sums[cell]-reference[cell]) > std::max(1e-6, bound))
+                throw std::runtime_error("piece key sums differ from chronological/FP64 oracle");
+        }
+        if (!std::equal(expected_query.begin(), expected_query.end(), actual_query.begin()) ||
+            !std::equal(sequential_mean.begin(), sequential_mean.end(), actual_mean.begin()))
+            throw std::runtime_error("piece Query capture or Mean-Q differs from whole-chunk oracle");
+        if (!std::all_of(actual_sums.begin()+sums.numel(), actual_sums.end(), [](float x) { return x == 12345.0F; }) ||
+            !std::all_of(actual_mean.begin()+channels, actual_mean.end(), [](float x) { return x == 12345.0F; }) ||
+            !std::all_of(actual_query.begin()+query.numel(), actual_query.end(), [](auto x) { return x == 0xA55A; }))
+            throw std::runtime_error("piece statistics wrote beyond output");
+    }
+    if (executable) cuda_check(cudaGraphExecDestroy(executable), "pieces destroy executable");
+    if (captured) cuda_check(cudaGraphDestroy(captured), "pieces destroy graph");
+    cuda_check(cudaStreamDestroy(stream), "pieces destroy stream");
+}
