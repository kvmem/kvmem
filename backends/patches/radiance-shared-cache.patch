+TEST(shared_input_points_obey_native_quantum_and_are_not_resampled) {
+    Fixture f;
+    f.build(4096,64,128);
+    f.cfg.prefix_cache=false;f.cfg.max_seqs=1;f.pc.allow_checkpoints=false;
+    CHECK_OK(f.start());
+    const auto id=f.submit(273,4);
+    auto* request=f.sch.find(id);
+    request->history_end=269;request->history_reuse_end=269;request->history_fallback_end=93;
+    int64_t accepted=0;
+    for(int round=0;accepted<273 && round<12;++round) {
+        REQUIRE(f.sch.step()!=nullptr);
+        const auto& entry=f.sch.plan().e[0];
+        const auto quantum=f.sch.geometry().quantum;
+        CHECK_EQ(request->history_fallback_end,93/quantum*quantum);
+        CHECK_EQ(request->history_reuse_end,269/quantum*quantum);
+        accepted+=entry.n_tokens;
+        CHECK(accepted==273 || accepted%quantum==0);
+        CHECK_EQ(entry.produces_token,accepted==273);
+        f.commit_plain(42);
+    }
+    CHECK_EQ(accepted,273);
+    CHECK_EQ(request->output.size(),size_t(1));
+}
