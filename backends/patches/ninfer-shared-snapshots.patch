@@ -0,0 +1,84 @@
+#include "models/qwen3_5/program/storage/kvmem_snapshot.h"
+#include "kvmem/spill_io.hpp"
+#include <array>
+#include <iostream>
+#include <thread>
+#include <stdexcept>
+#include <future>
+#include <atomic>
+using namespace kvmem;
+using namespace ninfer::models::qwen3_5;
+void require(bool ok) { if (!ok) throw std::runtime_error("snapshot invariant failed"); }
+int main() {
+    HostKvStorage storage(4096);
+    {
+        std::array<uint8_t,16> bytes{}; bytes.fill(7);
+        std::vector<HostKvRecord> archive;
+        for (int i=0;i<3;++i) { archive.push_back(storage.allocate(16,bytes.data())); archive.back().seal(); }
+        auto a=capture_kvmem_snapshot(archive,3,true,storage);
+        require(kvmem_snapshot_covers(a,3,16));
+        require(!kvmem_snapshot_covers(a,2,24) && !kvmem_snapshot_covers(a,4,16));
+        require(!kvmem_snapshot_covers({},3,16) && !kvmem_snapshot_covers(a,SIZE_MAX,16));
+        auto old=a->read();
+        auto b=capture_kvmem_snapshot(archive,3,true,storage,a);
+        require(a->blocks()[0]==b->blocks()[0] && a->blocks()[1]==b->blocks()[1]);
+        require(a->blocks()[2]!=b->blocks()[2]);
+        require(storage.charged_bytes()==80);
+        uint8_t changed=99; archive[2].write(3,&changed,1); archive[2].seal();
+        auto c=capture_kvmem_snapshot(archive,3,true,storage,b);
+        require(a->read()==old && b->read()==old && c->read()!=old);
+        require(storage.charged_bytes()==96);
+        // Same logical page index after replay is a new allocation/version.
+        archive[0]=storage.allocate(16,bytes.data()); archive[0].seal();
+        auto replay=capture_kvmem_snapshot(archive,3,true,storage,c);
+        require(replay->blocks()[0]!=c->blocks()[0]);
+        // Independent branches can mutate while their retained source is read.
+        auto left=fork_kvmem_snapshot(*a), right=fork_kvmem_snapshot(*a);
+        std::thread l([&]{uint8_t v=31;left[0].write(0,&v,1);});
+        std::thread r([&]{uint8_t v=32;right[0].write(0,&v,1);});
+        l.join();r.join();require(a->read()==old);
+        require(left[0].data()[0]==31 && right[0].data()[0]==32);
+    }
+    require(storage.charged_bytes()==0);
+    {
+        HostKvStorage tight(16); std::array<uint8_t,16> bytes{};
+        std::vector<HostKvRecord> records; records.push_back(tight.allocate(16,bytes.data()));records[0].seal();
+        bool capture_failed=false;
+        try { capture_kvmem_snapshot(records,1,true,tight); }
+        catch(const MemoryError& e){capture_failed=e.code()==MemoryErrorCode::BudgetExceeded;}
+        require(capture_failed && tight.charged_bytes()==16);
+        auto snapshot=capture_kvmem_snapshot(records,1,false,tight);
+        uint8_t v=1;bool failed=false;
+        try {records[0].write(0,&v,1);} catch(const MemoryError& e){failed=e.code()==MemoryErrorCode::BudgetExceeded;}
+        require(failed && snapshot->read()==std::vector<uint8_t>(16) && tight.charged_bytes()==16);
+    }
+    {
+        auto disk=std::make_shared<SpillFile>(std::filesystem::temp_directory_path(),4096);
+        HostKvStorage cold(32,disk);std::array<uint8_t,16> bytes{};bytes.fill(23);
+        std::vector<HostKvRecord> records;
+        for(int i=0;i<2;++i){records.push_back(cold.allocate(16,bytes.data()));records.back().seal();}
+        auto snapshot=capture_kvmem_snapshot(records,2,false,cold);
+        auto expected=snapshot->read();records.clear();cold.trim(0);
+        require(cold.charged_bytes()==0 && disk->charged_bytes()==32);
+        auto owners=fork_kvmem_snapshot(*snapshot);
+        require(snapshot->read()==expected && cold.charged_bytes()==0);
+        require(disk->stats().read_bytes>=32 && disk->stats().written_bytes==32);
+        owners.clear();snapshot.reset();require(disk->charged_bytes()==0);
+    }
+    {
+        // Cancellation cannot publish queued work or release a running lease.
+        HostKvStorage held(16);std::array<uint8_t,16> bytes{};
+        std::vector<HostKvRecord> records;records.push_back(held.allocate(16,bytes.data()));records[0].seal();
+        auto snapshot=capture_kvmem_snapshot(records,1,false,held);records.clear();
+        StorageIoQueue queue(2,32,1);std::promise<void> started,release;
+        auto gate=release.get_future().share();std::atomic<bool> published{false};
+        auto running=queue.submit(16,[snapshot,&started,gate]{started.set_value();gate.wait();require(snapshot->read().size()==16);});
+        started.get_future().wait();
+        auto queued=queue.submit(16,[snapshot,&published]{published=true;});
+        require(queued.cancel());snapshot.reset();
+        require(held.charged_bytes()==16);
+        release.set_value();running.wait();try{queued.wait();}catch(const std::exception&){}
+        require(!published && held.charged_bytes()==0 && queue.pinned_bytes()==0);
+    }
+    std::cout << "NInfer snapshot host invariants passed (RAM, SSD, cancellation)\n";
+}
