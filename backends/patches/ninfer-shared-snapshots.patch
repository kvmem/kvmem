diff --git a/src/models/qwen3_5/program/storage/kvmem_snapshot.h b/src/models/qwen3_5/program/storage/kvmem_snapshot.h
new file mode 100644
index 00000000..dabe058a
--- /dev/null
+++ b/src/models/qwen3_5/program/storage/kvmem_snapshot.h
@@ -0,0 +1,75 @@
+#pragma once
+#include "kvmem/kv_snapshot.hpp"
+#include <unordered_map>
+
+namespace ninfer::models::qwen3_5 {
+// The native manifest is one complete, sealed record per logical page. Check
+// this without allocating owner handles, reading SSD, or promoting cold data.
+inline bool kvmem_snapshot_covers(const std::shared_ptr<const kvmem::KvSnapshot>& snapshot,
+                                  size_t pages, size_t stride) {
+    if (!snapshot || !pages || !stride || pages > SIZE_MAX / stride ||
+        snapshot->size() != pages * stride || snapshot->blocks().size() != pages ||
+        snapshot->spans().size() != pages) return false;
+    for (size_t page = 0; page < pages; ++page) {
+        const auto& block = snapshot->blocks()[page];
+        const auto& span = snapshot->spans()[page];
+        if (block->size() != stride || !block->ready() || span.block != page ||
+            span.source || span.destination != page * stride || span.bytes != stride) return false;
+    }
+    return true;
+}
+
+// Called after native accepted-boundary capture. Archive records include all
+// attention/scale/MTP planes. Only live allocation identity proves reuse.
+inline std::shared_ptr<const kvmem::KvSnapshot> capture_kvmem_snapshot(
+    const std::vector<kvmem::HostKvRecord>& archive, size_t pages, bool partial_tail,
+    kvmem::HostKvStorage& storage,
+    const std::shared_ptr<const kvmem::KvSnapshot>& previous = {}) {
+    if (!pages || pages > archive.size())
+        throw std::logic_error("NInfer snapshot has incomplete archive coverage");
+    std::unordered_map<const void*, std::shared_ptr<kvmem::SealedKvBlock>> inherited;
+    if (previous) for (const auto& origin : previous->blocks()) {
+        auto record = origin->record();
+        if (record) inherited.emplace(record.storage_identity(), origin);
+    }
+    std::vector<std::shared_ptr<kvmem::SealedKvBlock>> blocks;
+    std::vector<kvmem::KvSnapshot::Span> spans;
+    blocks.reserve(pages); spans.reserve(pages);
+    size_t bytes = 0;
+    for (size_t page = 0; page < pages; ++page) {
+        const auto& record = archive[page];
+        if (!record || record.size() > SIZE_MAX - bytes)
+            throw std::logic_error("NInfer snapshot has invalid native record");
+        std::shared_ptr<kvmem::SealedKvBlock> origin;
+        if (!(partial_tail && page + 1 == pages)) {
+            auto found = inherited.find(record.storage_identity());
+            if (found != inherited.end()) origin = found->second;
+        }
+        if (partial_tail && page + 1 == pages) {
+            // Pay for the private tail now, not during the next append. The
+            // active archive keeps its independent mutable allocation.
+            auto source=record.lease();
+            auto tail=storage.allocate(record.size());
+            source.read(0,tail.writable_data(),tail.size());
+            tail.seal();
+            origin=std::make_shared<kvmem::SealedKvBlock>(tail);
+        } else if (!origin) origin = std::make_shared<kvmem::SealedKvBlock>(record);
+        blocks.push_back(std::move(origin));
+        spans.push_back({page, 0, bytes, record.size()});
+        bytes += record.size();
+    }
+    return std::make_shared<kvmem::KvSnapshot>(std::move(blocks), std::move(spans), bytes);
+}
+
+// Prepare private owner handles before publication; cold records stay cold.
+inline std::vector<kvmem::HostKvRecord> fork_kvmem_snapshot(const kvmem::KvSnapshot& snapshot) {
+    std::vector<kvmem::HostKvRecord> result;
+    result.reserve(snapshot.blocks().size());
+    for (const auto& block : snapshot.blocks()) {
+        auto record = block->record();
+        if (!record) throw std::logic_error("NInfer snapshot is not sealed");
+        result.push_back(std::move(record));
+    }
+    return result;
+}
+} // namespace ninfer::models::qwen3_5
