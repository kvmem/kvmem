+        KernelRow row;
+        for (int i=1;i<5;++i) { Band b;b.dom[RAD_DOMAIN_HOST].row=&row;b.dom[RAD_DOMAIN_DEVICE].row=&row;p.ops[i].bands.push_back(b); }
