+// Independent arithmetic oracle: libref and libavx used to share the alias bug.
+#include "rad_abi.h"
+#include "rad_plugin.h"
+#include "platform/module.h"
+#include <algorithm>
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <stdexcept>
+#include <string>
+#include <vector>
+
+struct Storage {
+    uint32_t dtype;
+    std::vector<uint32_t> words;
+    Storage(uint32_t dt, int n):dtype(dt),words(n,0){}
+    void* ptr(int offset=0) {return reinterpret_cast<char*>(words.data())+offset*(dtype==RAD_F32?4:2);}
+    void put(int i,float value) {
+        if(dtype==RAD_F32)std::memcpy(ptr(i),&value,4);
+        else {uint16_t v=rad_f32_to_bf16(value);std::memcpy(ptr(i),&v,2);}
+    }
+    float get(int i) {
+        if(dtype==RAD_F32){float v;std::memcpy(&v,ptr(i),4);return v;}
+        uint16_t v;std::memcpy(&v,ptr(i),2);return rad_bf16_to_f32(v);
+    }
+};
+static RadTensor tensor(Storage& s,int m,int n,int pitch,int cs=1,int offset=0) {
+    RadTensor t{};t.data=s.ptr(offset);t.dtype=s.dtype;t.rank=2;
+    t.shape[0]=m;t.shape[1]=n;t.stride[0]=pitch;t.stride[1]=cs;return t;
+}
+static float round_to(float x,uint32_t dt){return dt==RAD_F32?x:rad_bf16_to_f32(rad_f32_to_bf16(x));}
+static float activate(float x,int act){
+    if(act==1)return .5f*x*(1.f+std::erf(x*.70710678118654752f));
+    if(act==2)return .5f*x*(1.f+std::tanh(.7978845608028654f*(x+.044715f*x*x*x)));
+    return x;
+}
+static void run_case(const RadKernelInfo* kernel,uint32_t dt,int act,int mode,int shape) {
+    const int M=shape?3:1,N=shape?7:2,K=shape?33:2;
+    const int cs=mode==3?2:1,pitch=mode==3?2*N+3:N;
+    Storage a(dt,M*K),w(dt,N*K),bias(dt,N),res(dt,M*pitch+N*cs+8),out(dt,M*pitch+N*cs+8);
+    for(int i=0;i<M*K;++i)a.put(i,shape?float(i%13-6)/16:float(i+1));
+    for(int i=0;i<N*K;++i)w.put(i,shape?float(i%9-4)/8:float(i+3));
+    for(int n=0;n<N;++n)bias.put(n,shape?float(n%3-1)/128:0.f);
+    std::vector<float> expected(M*N);
+    for(int m=0;m<M;++m)for(int n=0;n<N;++n){
+        const float r=shape?float((m*N+n)%11-5)/16:float(100*(n+1));
+        res.put(m*pitch+n*cs,r);
+        float product=0;
+        for(int k=0;k<K;++k)product+=a.get(m*K+k)*w.get(n*K+k);
+        float v=round_to(product+bias.get(n),dt);
+        v=round_to(activate(v,act),dt);
+        expected[m*N+n]=mode==4?v:round_to(v+round_to(r,dt),dt);
+    }
+    RadTensor y=mode==0||mode==4?tensor(out,M,N,pitch,cs):tensor(res,M,N,pitch,cs,mode==2?1:0);
+    RadTensor t[]={tensor(a,M,K,K),tensor(w,N,K,K),tensor(bias,1,N,N),tensor(res,M,N,pitch,cs),y};
+    if(mode==4)t[3].data=nullptr;
+    const char* acts[]={"none","gelu","gelu_tanh"};
+    RadParam params[]={RAD_INT("M",M),RAD_INT("N",N),RAD_INT("K",K),RAD_STR("dtype",dt==RAD_F32?"f32":"bf16"),RAD_STR("act",acts[act])};
+    RadArgs args{};args.t=t;args.n_t=5;args.p=params;args.n_p=5;
+    const int rc=kernel->launch(&args,nullptr);
+    if(rc<0)throw std::runtime_error("kernel refused alias test: "+std::to_string(rc));
+    Storage& actual=mode==0||mode==4?out:res;
+    for(int m=0;m<M;++m)for(int n=0;n<N;++n){
+        float v=actual.get(m*pitch+n*cs+(mode==2?1:0)),want=expected[m*N+n];
+        const float tolerance=dt==RAD_F32?2e-5f:0.f;
+        if(!std::isfinite(v)||std::abs(v-want)>tolerance){
+            std::fprintf(stderr,"%s dtype=%u act=%d alias=%d shape=%d at=%d,%d actual=%.9g expected=%.9g\n",kernel->name,dt,act,mode,shape,m,n,v,want);
+            throw std::runtime_error("independent residual arithmetic check failed");
+        }
+    }
+}
+int main(int argc,char** argv) try {
+    const char* home=std::getenv("RADIANCE_HOME");
+    const std::string root=argc>1?argv[1]:(home?home:"radiance_home");
+    int total=0;
+    for(const char* name:{"libavx","libref"}){
+        std::string error;void* handle=rad::platform::module_open(root+"/kernels/"+name+rad::platform::module_suffix,&error);
+        if(!handle)throw std::runtime_error(error);
+        auto open=(int(*)())rad::platform::module_symbol(handle,"rad_plugin_open");
+        if(open&&open()<0)throw std::runtime_error("plugin open failed");
+        auto count=(int(*)())rad::platform::module_symbol(handle,"rad_kernel_count");
+        auto at=(const RadKernelInfo*(*)(int))rad::platform::module_symbol(handle,"rad_kernel_at");
+        auto force=(int(*)(int))rad::platform::module_symbol(handle,"avx_isa_force");
+        auto detect=(int(*)())rad::platform::module_symbol(handle,"avx_isa_detect");
+        const RadKernelInfo* kernel=nullptr;
+        for(int i=0;i<count();++i){auto row=at(i);if(!std::strcmp(row->op,"gemm_nt_bias")){kernel=row;break;}}
+        if(!kernel)throw std::runtime_error("no CPU GEMM kernel");
+        const int cap=detect?detect():0;
+        for(int level=0;level<=cap;++level){
+            if(force&&force(level)!=level)throw std::runtime_error("ISA level not actually selected");
+            int cases=0;
+            for(uint32_t dt:{RAD_F32,RAD_BF16})for(int act=0;act<3;++act)for(int mode=0;mode<5;++mode)for(int shape=0;shape<2;++shape){run_case(kernel,dt,act,mode,shape);++cases;}
+            std::printf("PASS %s ISA=%d cases=%d (disjoint, exact/partial/strided alias, absent residual; F32/BF16; none/GELU/tanh GELU)\n",name,level,cases);total+=cases;
+        }
+    }
+    std::printf("PASS total independent arithmetic cases=%d\n",total);return 0;
+}catch(const std::exception& e){std::fprintf(stderr,"FAIL %s\n",e.what());return 1;}
