+
+// Only buffers with an audited row-prefix lifetime use these allocations. Persistent KVMem statistics,
+// attention score scratch, KV and recurrent state remain resident. Addresses never change, including the
+// prefixes captured in decode graphs; a prompt cannot launch until its complete ranges are mapped again.
+void* Engine::elastic_alloc(size_t bytes, size_t decode_bytes, const char* what) {
+    if (!elastic_enabled_ || decode_bytes >= bytes) return dmalloc(bytes, what);
+    elastic_workspaces_.emplace_back();
+    Workspace& w = elastic_workspaces_.back();
+    w.full = up_to(std::max<size_t>(bytes, 256), grain_);
+    w.keep = std::min(w.full, up_to(std::max<size_t>(decode_bytes, 256), grain_));
+    w.name = what;
+    vmm_reserve(w, w.full);
+    // A separate first piece makes the retained prefix an exact unmap boundary.
+    vmm_map(w, w.keep, SIZE_MAX, what);
+    vmm_map(w, w.full, kArenaPiece, what);
+    return reinterpret_cast<void*>(w.base);
+}
+
+float* Engine::elastic_fbuf(size_t n, size_t decode_n) {
+    if (!elastic_enabled_ || decode_n >= n) return fbuf(n);
+    // alloc() counts the ordinary scratch first, then assigns both sorts of pointers.
+    if (!scratch_) return nullptr;
+    return static_cast<float*>(elastic_alloc(n * sizeof(float), decode_n * sizeof(float), "elastic scratch"));
+}
+
+void Engine::elastic_info() const {
+    if (!elastic_enabled_) return;
+    size_t mapped=0, full=0;
+    for (const auto& w : elastic_workspaces_) { mapped+=w.mapped; full+=w.full; }
+    std::printf("INFO elastic_experts=1 expert_slots=%d expert_cache_mib=%lld expert_cache_mapped_mib=%zu "
+                "elastic_workspace_mib=%zu elastic_workspace_full_mib=%zu vram_free_mib=%lld\n", cached_,
+                (long long)(exp_at_ >> 20), arena_.mapped >> 20, mapped >> 20, full >> 20, (long long)vram_free_mib());
+}
+
+void Engine::elastic_report(const char* phase, double ms) {
+    if (!opt_.elastic_experts && !std::getenv("STRATA_ELASTIC_TRACE")) return;
+    size_t full = 0, mapped = 0, keep = 0, free_b = 0, total_b = 0;
+    for (const auto& w : elastic_workspaces_) { full += w.full; mapped += w.mapped; keep += w.keep; }
+    ck(cudaMemGetInfo(&free_b, &total_b), "elastic memory sample");
+    std::fprintf(stderr, "ELASTIC phase=%s enabled=%d token=%lld cache_bytes=%zu expert_bytes=%zu experts=%d "
+                 "workspace_bytes=%zu workspace_full=%zu workspace_keep=%zu free_bytes=%zu ms=%.3f "
+                 "clock_ms=%.3f cpu_ms=%.3f gpu_experts=%lld cpu_experts=%lld\n",
+                 phase, int(elastic_enabled_), (long long)pos_, arena_.mapped, exp_at_, cached_, mapped,
+                 full, keep, free_b, ms, std::chrono::duration<double, std::milli>(Clock::now().time_since_epoch()).count(),
+                 stats_.cpu_ms, (long long)stats_.gpu_experts, (long long)stats_.cpu_experts);
+}
+
+void Engine::elastic_workspace(bool full) {
+    if (!elastic_enabled_ || elastic_full_ == full) return;
+    const auto started = Clock::now();
+    // The prompt pipeline uses up_ and rs_ as well as st_. No unmap may race its copies or kernels.
+    settle_swaps();
+    if (up_) ck(cudaStreamSynchronize(cs(up_)), "elastic workspace uploads");
+    if (rs_) ck(cudaStreamSynchronize(cs(rs_)), "elastic workspace reads");
+    ck(cudaStreamSynchronize(cs(st_)), "elastic workspace compute");
+    if (full) {
+        size_t need = 0, free_b = 0, total_b = 0;
+        for (const auto& w : elastic_workspaces_) need += w.full - w.mapped;
+        ck(cudaMemGetInfo(&free_b, &total_b), "elastic workspace admission");
+        const size_t guard = size_t(std::max(reserve_mib_, 256)) << 20;
+        if (need + guard > free_b) shrink_cache(need + guard - free_b);
+        held_is_budget();
+        try {
+            for (auto& w : elastic_workspaces_) {
+#ifdef STRATA_ELASTIC_TESTING
+                if (elastic_fail_after_ == 0) throw std::runtime_error("injected elastic admission failure");
+                if (elastic_fail_after_ > 0) --elastic_fail_after_;
+#endif
+                vmm_map(w, w.full, kArenaPiece, w.name);
+            }
+        } catch (...) {
+            // No dependent work has been submitted. Undo a partially completed admission and fail this
+            // request safely; the next request may retry after external pressure has subsided.
+            for (auto& w : elastic_workspaces_) vmm_unmap(w, w.keep);
+            elastic_report("admission_failed", ms_since(started));
+            throw;
+        }
+    } else {
+        for (auto& w : elastic_workspaces_) vmm_unmap(w, w.keep);
+    }
+    staged_il_ = -1;
+    elastic_full_ = full;
+    elastic_ticks_ = 0;
+    elastic_report(full ? "prefill" : "decode", ms_since(started));
+}
+
+void Engine::elastic_tick() {
+    if (!elastic_enabled_ || elastic_full_ || freeze_experts_) return;
+    // A bounded upload every 16 decode calls. The idle gap amortizes both driver calls and expert reads.
+    if (elastic_ticks_++ % 16 != 0) return;
+    size_t free_b = 0, total_b = 0;
+    ck(cudaMemGetInfo(&free_b, &total_b), "elastic cache budget");
+    const size_t guard = size_t(std::max(reserve_mib_, 256)) << 20;
+    const auto started = Clock::now();
+    if (free_b < guard / 2) {
+        shrink_cache(guard - free_b);
+        held_is_budget();
+        elastic_report("shrink", ms_since(started));
+    } else if (free_b >= guard + kArenaPiece && arena_.mapped < arena_.reserved) {
+        const int added = grow_cache(kArenaPiece);
+        elastic_report(added ? "grow" : "grow_empty", ms_since(started));
+    } else if (elastic_ticks_ % 128 == 1) {
+        elastic_report("steady");
+    }
+}
