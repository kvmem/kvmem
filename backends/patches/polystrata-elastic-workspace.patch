+namespace strata::poly {
+struct KvmemTestAccess {
+    static std::vector<uint8_t> kv(KvmemMemory& m) {
+        std::vector<uint8_t> result(m.visible_ * (m.descriptor_.layout.record_bytes / KvmemMemory::block_tokens));
+        m.save_view(result.data());
+        return result;
+    }
+    static std::vector<float> means(KvmemMemory& m) {
+        std::vector<float> result(m.versions_.size() * m.planes_.size() * m.key_width_);
+        for (uint32_t b=0; b<m.versions_.size(); ++b)
+            for (uint32_t il=0; il<m.planes_.size(); ++il)
+                m.statistics_->mean_k(b, il, result.data() + (b*m.planes_.size()+il)*m.key_width_);
+        return result;
+    }
+};
+struct ElasticTestAccess {
+    static void workspace(Engine& e, bool full) { e.elastic_workspace(full); }
+    static void freeze(Engine& e, bool frozen) { e.freeze_experts_ = frozen; }
+    static void enabled(Engine& e, bool on) { e.elastic_enabled_ = on; }
+    static void fail_after(Engine& e, int count) { e.elastic_fail_after_ = count; }
+    static size_t mapped(Engine& e) {
+        size_t total=0; for(const auto& w:e.elastic_workspaces_)total+=w.mapped; return total;
+    }
+    static void verify(Engine& e) {
+        check(e.elastic_enabled_, "elastic feature did not activate");
+        check(!e.elastic_workspaces_.empty(), "no elastic workspace");
+        size_t cache=0; for(const auto& p:e.arena_.pieces)cache+=p.second;
+        check(cache==e.arena_.mapped, "cache allocation ledger mismatch");
+        int count=0;
+        for(const auto& layer:e.layers_)for(const auto* slot:layer.slot)if(slot) {
+            ++count;
+            check(slot>=e.exp_ && size_t(slot-e.exp_)+layer.slot_bytes<=e.arena_.mapped,
+                  "expert references unmapped cache pages");
+        }
+        check(count==e.cached_, "published expert count mismatch");
+        for(const auto& w:e.elastic_workspaces_) {
+            size_t physical=0;for(const auto& p:w.pieces)physical+=p.second;
+            check(physical==w.mapped,"workspace allocation ledger mismatch");
+            check(w.mapped==(e.elastic_full_?w.full:w.keep), "workspace lease incomplete");
+        }
+    }
+};
+}
