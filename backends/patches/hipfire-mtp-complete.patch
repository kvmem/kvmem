+    const Q_HEADS: u32 = 4;
+    const HEAD_DIM: u32 = 64;
+    const KW: usize = (KV_HEADS * HEAD_DIM) as usize;
+    const QW: usize = (Q_HEADS * HEAD_DIM) as usize;
+    const BT: u32 = 128;
