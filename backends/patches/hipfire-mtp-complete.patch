+            gpu.hip.memcpy_htod(&t.buf, &bytes).expect("q h2d");
+            let q = NativeCurrentLayerQuery {
+                data: t.buf.as_ptr() as *const std::ffi::c_void,
+                bytes: bytes.len(),
+                layer: ordinal as u32,
+                rows: 1,
+                query_heads: Q_HEADS,
+                kv_heads: KV_HEADS,
+                head_dim: HEAD_DIM,
+                attention_scale: 1.0,
+                scalar: 0,
+                row_stride: QW * 4,
+                head_stride: HEAD_DIM as usize * 4,
