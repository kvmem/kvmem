+            history_revision: 5,
+            view_version: 6,
+            frontier: FRONTIER,
+            execution_history: 9,
+        }
+    }
+
+    fn identity() -> LayerwiseIdentity {
+        LayerwiseIdentity {
+            history: stamp(),
+            request: 92,
+            evaluation: QueryRange { begin: FRONTIER, end: FRONTIER + 1 },
+            query: QueryRange { begin: FRONTIER, end: FRONTIER + 1 },
