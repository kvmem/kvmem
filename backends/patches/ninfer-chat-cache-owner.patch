diff --git a/src/serve/openai_chat_request.cpp b/src/serve/openai_chat_request.cpp
index c180fffd608285bdd31ddc80d3e3f63297b5c017..55fb07ec5fb1446469d902f99623a966ed7eb92b 100644
--- a/src/serve/openai_chat_request.cpp
+++ b/src/serve/openai_chat_request.cpp
@@ -1004,9 +1004,44 @@ OpenAIChatRequest parse_chat_completion_request(const Json& body, const RequestL
     // message, so a tool-calling exchange (many requests, no new user turn between them) would
     // otherwise resume from the start of the exchange instead of from the previous request.
     output.generation.private_cache_boundary_at_prompt_end =
-        body.contains("prompt_cache_key") && body.at("prompt_cache_key").is_string() &&
-        !body.at("prompt_cache_key").get_ref<const std::string&>().empty();
+        parse_chat_context_cache_hints(body).session_key.has_value();
     return output;
 }
 
+ContextCacheHints parse_chat_context_cache_hints(const RequestJson& body) {
+    ContextCacheHints hints;
+    const auto key = [&](const RequestJson& value, const char* field, bool allow_empty) {
+        if (!value.is_string()) { bad_request(std::string(field) + " must be a string", field); }
+        auto result = value.get<std::string>();
+        if ((!allow_empty && result.empty()) || result.size() > ninfer::kMaximumContextCacheSessionKeyBytes) {
+            bad_request(std::string(field) + " must contain " + (allow_empty ? "0" : "1") +
+                            " to " + std::to_string(ninfer::kMaximumContextCacheSessionKeyBytes) + " bytes",
+                        field);
+        }
+        return result;
+    };
+    // OpenCode's openai-compatible adapter forwards the SDK spelling unchanged.
+    for (const char* field : {"prompt_cache_key", "promptCacheKey"}) {
+        if (!body.contains(field) || body.at(field).is_null()) { continue; }
+        auto value = key(body.at(field), field, true);
+        if (value.empty()) { continue; }
+        if (hints.session_key && *hints.session_key != value) {
+            bad_request("prompt_cache_key and promptCacheKey must agree", field);
+        }
+        hints.session_key = std::move(value);
+    }
+    if (body.contains("kvmem") && !body.at("kvmem").is_null()) {
+        const auto& extension = body.at("kvmem");
+        if (!extension.is_object()) { bad_request("kvmem must be an object", "kvmem"); }
+        if (extension.contains("conversation_id") && !extension.at("conversation_id").is_null()) {
+            hints.session_key = key(extension.at("conversation_id"), "kvmem.conversation_id", false);
+        }
+    }
+    if (hints.session_key) {
+        hints.retention = CacheRetentionHint::LiveSession;
+        hints.update_session_index = true;
+    }
+    return hints;
+}
+
 } // namespace ninfer::serve
diff --git a/tests/test_openai_schema.cpp b/tests/test_openai_schema.cpp
index d302d86560c51655a2b71d49a407ac7ec8dea9a3..357dd10790bcd8ed061b670b3b6d07ee0e6014f4 100644
--- a/tests/test_openai_schema.cpp
+++ b/tests/test_openai_schema.cpp
@@ -1770,6 +1770,62 @@ int test_prompt_cache_key_grants_long_anchor() {
     return failures;
 }
 
+int test_chat_cache_session_binding() {
+    int failures = 0;
+    Json body = base_request();
+    const auto anonymous = parse_chat_context_cache_hints(body);
+    failures += check(!anonymous.session_key && anonymous.retention == ninfer::CacheRetentionHint::Default,
+                      "unkeyed Chat preserves anonymous cache semantics");
+    body["prompt_cache_key"] = "opencode-session-a";
+    auto hints = parse_chat_context_cache_hints(body);
+    failures += check(hints.session_key == "opencode-session-a" &&
+                          hints.retention == ninfer::CacheRetentionHint::LiveSession && hints.update_session_index,
+                      "Chat cache key binds a retained, advancing session lineage");
+    body["store"] = false;
+    failures += check(parse_chat_context_cache_hints(body).session_key == hints.session_key,
+                      "Chat store:false does not disable cache identity");
+    body["prompt_cache_key"] = "opencode-session-b";
+    failures += check(parse_chat_context_cache_hints(body).session_key != hints.session_key,
+                      "different client keys remain distinct owners");
+    body["promptCacheKey"] = "opencode-session-b";
+    failures += check(parse_chat_context_cache_hints(body).session_key == "opencode-session-b",
+                      "matching SDK and wire cache keys are accepted");
+    body["promptCacheKey"] = "different-owner";
+    failures += check(api_error([&] { (void)parse(body); }).param == "promptCacheKey",
+                      "conflicting SDK and wire keys are rejected");
+    body.erase("prompt_cache_key");
+    body["promptCacheKey"] = "opencode-session-b";
+    failures += check(parse_chat_context_cache_hints(body).session_key == "opencode-session-b" &&
+                          parse(body).generation.private_cache_boundary_at_prompt_end,
+                      "OpenCode compatible SDK spelling binds the session and anchor");
+    body["promptCacheKey"] = 17;
+    failures += check(api_error([&] { (void)parse(body); }).param == "promptCacheKey",
+                      "malformed SDK cache key rejected");
+    body.erase("promptCacheKey");
+    body["prompt_cache_key"] = "opencode-session-b";
+    body["kvmem"] = Json{{"conversation_id", "explicit-owner"}};
+    failures += check(parse_chat_context_cache_hints(body).session_key == "explicit-owner",
+                      "explicit conversation identity takes precedence over cache affinity");
+    body.erase("prompt_cache_key");
+    failures += check(parse(body).generation.private_cache_boundary_at_prompt_end,
+                      "explicit owner gets an endpoint anchor without a cache key");
+    for (const auto& invalid : std::vector<Json>{"", 17, std::string(257, 'x')}) {
+        body["kvmem"]["conversation_id"] = invalid;
+        failures += check(api_error([&] { (void)parse(body); }).param == "kvmem.conversation_id",
+                          "invalid explicit owner rejected before execution");
+    }
+    body.erase("kvmem");
+    for (const auto& empty : std::vector<Json>{nullptr, ""}) {
+        body["prompt_cache_key"] = empty;
+        failures += check(!parse_chat_context_cache_hints(body).session_key,
+                          "empty or null cache key preserves anonymous behavior");
+    }
+    body["prompt_cache_key"] = 17;
+    failures += check(api_error([&] { (void)parse_chat_context_cache_hints(body); }).param == "prompt_cache_key",
+                      "non-string cache key rejected");
+    return failures;
+}
+
