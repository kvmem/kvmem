diff --git a/tools/convert/nvfp4.py b/tools/convert/nvfp4.py
new file mode 100644
index 0000000000000000000000000000000000000000..0549f71fb6e1d8b97b62db111b7cb656637c216b
--- /dev/null
+++ b/tools/convert/nvfp4.py
@@ -0,0 +1,52 @@
+"""Bounded weight-only NVFP4 round-to-nearest conversion for optional draft matrices."""
+import struct
+import torch
+
+
+def quantize_rows(values, divisor):
+    """Return packed E2M1 codes and natural E4M3 scale words; ties round to even."""
+    values = values.to(torch.float32) * divisor
+    if not torch.isfinite(values).all():
+        raise ValueError('NVFP4 input must be finite')
+    n, k = values.shape
+    groups = values.reshape(n, k // 16, 16)
+    scales = (groups.abs().amax(-1) / 6).to(torch.float8_e4m3fn)
+    scales32 = scales.float()
+    normalized = groups / torch.where(scales32 == 0, 1., scales32).unsqueeze(-1)
+    magnitude = normalized.abs()
+    midpoints = torch.tensor([.25, .75, 1.25, 1.75, 2.5, 3.5, 5.], device=values.device)
+    codes = torch.bucketize(magnitude.contiguous(), midpoints)
+    codes += ((codes < 7) & (codes.remainder(2) == 1) &
+              (magnitude == midpoints[codes.clamp(max=6)])).long()
+    codes = (codes | (normalized.signbit().long() << 3)).to(torch.uint8).reshape(n, k)
+    packed = codes[:, 0::2] | (codes[:, 1::2] << 4)
+    return packed.cpu(), scales.view(torch.uint8).cpu()
+
+
+def nvfp4_maxabs(request):
+    if request.target.format != 'nvfp4' or len(request.target.shape) != 2:
+        raise ValueError('nvfp4_maxabs requires an NVFP4 matrix')
+    n, k = request.target.shape
+    if n % 128 or k % 64:
+        raise ValueError('NVFP4 matrix requires N % 128 == 0 and K % 64 == 0')
+    if any(policy != 'A16Only' for policy in request.policies.values()):
+        raise ValueError('nvfp4_maxabs is weight-only; use A16Only')
+    chunk = max(128, request.rows_per_chunk // 128 * 128)
+    maximum = 0.
+    for begin in range(0, n, chunk):
+        values = request.values(begin*k, min(n, begin+chunk)*k).float()
+        if not torch.isfinite(values).all():
+            raise ValueError('NVFP4 input must be finite')
+        maximum = max(maximum, values.abs().max().item())
+    divisor = struct.unpack('<f', struct.pack('<f', 2688. / maximum if maximum else 1.))[0]
+    if not (0 < divisor < float('inf')):
+        raise ValueError('NVFP4 weight divisor is not representable in FP32')
+    word = struct.pack('<f', divisor)
+
+    def produce(output):
+        for begin in range(0, n, chunk):
+            end = min(n, begin+chunk)
+            values = request.values(begin*k, end*k).reshape(end-begin, k)
+            codes, scales = quantize_rows(values, divisor)
+            output.write_codes(begin, codes, scales, word)
+    return request.job(produce=produce)
diff --git a/tools/convert/recipes/dflash2_import_nvfp4.py b/tools/convert/recipes/dflash2_import_nvfp4.py
new file mode 100644
index 0000000000000000000000000000000000000000..4a1cf1cdb16a0d8e18f3e39e2c4909b4aad6ac9f
--- /dev/null
+++ b/tools/convert/recipes/dflash2_import_nvfp4.py
@@ -0,0 +1,42 @@
+"""Import the DFlash2 module's NVFP4 weights verbatim from a ModelOpt source.
+
+Unlike ``dflash2_nvfp4.py`` (which re-quantises a BF16/FP8 companion), this override
+keeps the source's NVFP4 codes and block scales, and converts its multiplicative
+global scale to the equivalent native divisor. Use it when the
+companion checkpoint is already ModelOpt NVFP4, e.g.
+``maurienne-ai/Qwen3.8-27B-DFlash2-NVFP4-RTNcal``.
+
+The supported large projections use NVFP4: ``attention/output`` and ``mlp/down``
+import the source's codes and block scales verbatim, while ``feature_projection`` and the selector hidden
+projection (BF16 in the checkpoint) are quantised to NVFP4. QKV keeps Q8 because the
+fused attention input projection only admits that format, and the convolution kernel
+projections stay BF16 because their prepare path has no NVFP4 kernel.
+"""
+from tools.convert.methods import import_encoded
+from tools.convert.nvfp4 import nvfp4_maxabs
+
+# The engine's native QKV input projection requires Q8_G32_FP16.
+_KEPT_Q8 = ('/attention/query', '/attention/key', '/attention/value')
+
+# BF16 in the ModelOpt checkpoint; quantise the supported projections to NVFP4.
+_REQUANTISE = (
+    'dflash2/feature_projection',
+    'dflash2/candidate_selector/hidden_projection',
+)
+
+
+def configure(model, recipe, sources):
+    if 'dflash2' not in model.components:
+        raise ValueError('DFlash2 NVFP4 import requires the DFlash2 component')
+    for name, parameter in model.parameters.items():
+        if not name.startswith('dflash2/') or not parameter.projection:
+            continue
+        if 'conv' in name or '/attention/context_' in name:
+            continue
+        if any(name.endswith(suffix) for suffix in _KEPT_Q8):
+            continue
+        if name in _REQUANTISE:
+            recipe.assign(name, format='nvfp4', method=nvfp4_maxabs,
+                          activation_policy='A16Only')
+            continue
+        recipe.assign(name, format='nvfp4', method=import_encoded)
