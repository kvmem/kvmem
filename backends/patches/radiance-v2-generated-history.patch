+void publish_generated_history(const OaiDeps& d, const OaiRequest& r, const ParsedMessage& msg,
+                               const std::string& raw, const std::vector<int32_t>& gen, Finish finish) {
+    if (!d.generated_history || r.generated_history_key.empty() || r.prompts.size() != 1 ||
+            msg.open_call || (finish != Finish::Stop && finish != Finish::StopString && finish != Finish::Length))
+        return;
+    json assistant{{"role", "assistant"}, {"content", msg.content}};
+    if (!msg.reasoning.empty()) assistant["reasoning_content"] = msg.reasoning;
+    if (!msg.tool_calls.empty()) assistant["tool_calls"] = tool_calls_json(msg.tool_calls);
+    auto key = r.generated_history_key + history_message(std::move(assistant));
+    // The scheduler can deliver its last EOS to the sink even on a length
+    // finish. It has no reply bytes. The renderer must supply this same EOT
+    // at the seam; saving it here as well would replay it twice.
+    auto end = gen.end();
+    const auto vi = d.tok->vocab_info();
+    const int32_t turn_end = vi.eot >= 0 ? vi.eot : vi.eos;
+    if (end != gen.begin() && gen.back() == turn_end && d.tok->reply_bytes(gen.back()).empty()) --end;
+    size_t offset = 0;
+    for (auto it = gen.begin(); it != end; ++it) {
+        const int32_t id = *it;
+        auto piece = d.tok->token_bytes(id);
+        if (piece.empty() || raw.compare(offset, piece.size(), piece) != 0) {
+            d.generated_history->mark_ambiguous(std::move(key)); return;
+        }
+        offset += piece.size();
+    }
+    if (offset != raw.size() || finish == Finish::StopString) {
+        d.generated_history->mark_ambiguous(std::move(key)); return;
+    }
+    if (end == gen.begin()) return;
+    const auto& prompt = r.prompts.front();
+    kvmem::GeneratedHistory::Prefix prefix{prompt.text + raw, prompt.tokens};
+    prefix.ids.insert(prefix.ids.end(), gen.begin(), end);
+    d.generated_history->publish(std::move(key), std::move(prefix));
 }
 
