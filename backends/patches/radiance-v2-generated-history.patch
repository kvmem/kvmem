+// rad::json preserves insertion order. Object member order is irrelevant to
+// a transcript, including for nested tool call objects.
+static std::string history_json(const json& value) {
+    if (value.is_object()) {
+        std::map<std::string, std::string> fields;
+        for (auto it = value.begin(); it != value.end(); ++it) fields[it.key()] = history_json(*it);
+        std::string result = "{";
+        for (const auto& field : fields) {
+            if (result.size() > 1) result += ",";
+            result += json(field.first).dump() + ":" + field.second;
+        }
+        return result + "}";
+    }
+    if (value.is_array()) {
+        std::string result = "[";
+        for (const auto& item : value) {
+            if (result.size() > 1) result += ",";
+            result += history_json(item);
+        }
+        return result + "]";
+    }
+    return value.dump();
+}
+static std::string history_message(json msg) {
+    if (msg.contains("reasoning") && msg["reasoning"].is_string()) {
+        if (!msg.contains("reasoning_content")) msg["reasoning_content"] = msg.at("reasoning").get<std::string>();
+        if (msg.at("reasoning_content") == msg.at("reasoning")) msg.erase("reasoning");
+    }
+    auto c = msg.find("content");
+    if (c != msg.end() && c->is_array() && c->size() == 1) {
+        const auto& first = (*c)[0];
+        if (first.is_object() && first.size() == 2 && str_or(first,"type") == "text" &&
+                first.contains("text") && first.at("text").is_string()) {
+            const std::string value = first.at("text").get<std::string>();
+            *c = value;
+        }
+    }
+    if (msg.contains("tool_calls") && (!msg.contains("content") || msg.at("content").is_null()))
+        msg["content"] = "";
+    return history_json(msg) + "\n";
+}
