diff --git a/vendor/llama/common/chat-origin.h b/vendor/llama/common/chat-origin.h
new file mode 100644
--- /dev/null
+++ b/vendor/llama/common/chat-origin.h
@@ -0,0 +1,32 @@
+#pragma once
+#include <algorithm>
+#include <cstddef>
+#include <string>
+#include <utility>
+#include <vector>
+
+// Optional per-thread probe of an exact rendering. Only the Jinja runtime knows
+// whether a delimiter came from a message or from the template itself.
+namespace chat_origin {
+struct Probe {
+    explicit Probe(const std::string & text) : expected(text), previous(current) { current = this; }
+    ~Probe() { current = previous; }
+    Probe(const Probe &) = delete;
+    const std::string & expected;
+    Probe * previous;
+    inline static thread_local Probe * current = nullptr;
+    using Ranges = std::vector<std::pair<size_t, size_t>>;
+    Ranges literals;
+    bool seen = false;
+    void observe(Ranges ranges) {
+        if (!seen) literals = std::move(ranges);
+        else if (literals != ranges) literals.clear();
+        seen = true;
+    }
+    bool owns(size_t begin, size_t end) const {
+        return std::any_of(literals.begin(), literals.end(), [&](const auto & r) {
+            return r.first <= begin && end <= r.second;
+        });
+    }
+};
+}
