--- a/src/serve/request_validation.cpp
+++ b/src/serve/request_validation.cpp
@@ -44,6 +44,20 @@ void parse_tool_constraints(const RequestJson& body, GenerationRequest& request)
     else bad_request("tool_constraints must be 'basic' or 'auto'", "tool_constraints");
 }
 
+void apply_default_tool_constraints(const RequestJson& body, const RequestLimits& limits,
+                                    GenerationRequest& request) {
+    // The server default upgrades only requests that declare tools and can still call them;
+    // tool_choice "none" keeps its dedicated native path, and an explicit request field parsed
+    // by parse_tool_constraints always wins.
+    if (!limits.default_tool_constraints.has_value()) { return; }
+    if (body.contains("tool_constraints") && !body.at("tool_constraints").is_null()) { return; }
+    if (!body.contains("tools") || !body.at("tools").is_array() || body.at("tools").empty()) {
+        return;
+    }
+    if (request.tool_choice.mode == ToolChoiceMode::None) { return; }
+    request.tool_choice.constraints = *limits.default_tool_constraints;
+}
+
 std::optional<int> optional_int(const RequestJson& object, const char* key) {
     if (!object.contains(key) || object.at(key).is_null()) { return std::nullopt; }
     const RequestJson& value = object.at(key);
