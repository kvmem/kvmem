+            ctl.note_state_demotion(host_bytes);
+        }
+        eprintln!(
+            "[kvmem-dn] idle demote slot={slot} session={} frontier={frontier} bytes={host_bytes}",
+            session.0
+        );
+    }
+    #[cfg(not(feature = "kvmem"))]
+    {
+        let _ = (rig, slot, session);
+    }
