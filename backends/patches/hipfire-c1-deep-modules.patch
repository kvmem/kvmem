+    let slot = match rig.sessions.get(id).and_then(|s| s.slot) {
+        Some(s) => s,
+        None => {
+            let _ = send_event(
+                &req.reply,
+                Event::Rejected {
+                    class: RejectClass::Internal,
+                    reason: "admitted session holds no slot".to_string(),
+                },
+            );
+            lock_stats(stats).note_rejected();
+            return;
+        }
+    };
