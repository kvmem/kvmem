+    let dn_disk = env_u64("HIPFIRE_KVMEM_DN_DISK_MIB", 0) > 0
+        || hipfire_config::developer_var("HIPFIRE_KVMEM_DN_RING_DIR")
+            .is_ok_and(|v| !v.trim().is_empty());
+    kvmem_fit_ledger_text(
+        cfg!(feature = "kvmem"),
+        enabled,
+        strategy,
