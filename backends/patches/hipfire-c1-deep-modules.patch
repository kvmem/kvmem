+        };
+        #[cfg(feature = "kvmem")]
+        {
+            rig.legacy_spec_kind[slot.0] = work[slot.0].spec;
+        }
+        rig.spec_counters[slot.0] = SpecCounters {
+            requested: work[slot.0].spec.active(),
+            ..Default::default()
+        };
