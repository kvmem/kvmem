+                    // restore attempt is over (or was skipped) either way,
+                    // so release it on every Ok(plan) exit path.
+                    if plan.boundary > 0 {
+                        ckpt_pool.unpin(
+                            domain,
+                            plan.boundary,
+                            crate::checkpoint::prefix_fingerprint(
+                                &req.prompt_tokens[..plan.boundary as usize],
+                            ),
