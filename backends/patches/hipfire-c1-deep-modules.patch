+                        return;
+                    }
+                }
+            }
+            // WaitQueue disabled (should not happen — Rig::build refuses
+            // zero caps): fall back to the original immediate reject.
+            let _ = send_event(
+                &req.reply,
+                Event::Rejected {
+                    class: RejectClass::Internal,
+                    reason: format!("{e:?}"),
+                },
+            );
+            lock_stats(stats).note_rejected();
+            return;
+        }
+    };
