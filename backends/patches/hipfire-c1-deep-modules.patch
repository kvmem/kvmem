-        rig.session_max
-    };
-    let closed = rig.sessions.sweep_expired(
-        &mut rig.pool,
-        &mut rig.adm,
-        std::time::Instant::now(),
-        ttl,
-        cap,
-    );
-    if closed.is_empty() {
-        return;
-    }
-    if let Ok(mut ids) = rig.closed_sessions.lock() {
-        ids.extend(closed.iter().map(|id| id.0));
-    }
-    if rig.gpu.slot_trace() {
