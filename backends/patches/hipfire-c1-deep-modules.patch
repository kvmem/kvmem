+                                     // KVMem, so `reused > 0` here is always a P4.3 canonical reuse.
+        let kvmem_lw_reuse = kvmem_hooks::layerwise_reuse(rig);
+        let mtp_ok = rig.model.mtp_head.is_some()
+            && rig.model.mtp_k > 0
+            && !grammar_constrained
