+    {
+        let Some(ctl) = rig.model.kvmem.as_ref() else {
+            return;
+        };
+        if !ctl.dn_idle_enabled() || rig.model.dn_states[slot].is_empty() {
+            return;
+        }
+        let Some(frontier) = ctl.fed_tokens(slot).filter(|f| *f > 0) else {
+            return;
+        };
