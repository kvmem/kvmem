+
+void causal_attention_small_t_load_modules(AttentionHeadGeometry geometry, KvCacheStorage storage,
+                                           bool cached_input, std::int32_t max_width) {
+    if (!kv_cache_is_int8_family(storage) || geometry.query_heads / geometry.kv_heads == 4) { return; }
+    with_causal_small_t_geometry(geometry.query_heads, geometry.kv_heads, [&]<typename Geometry>() {
+        constexpr int widest = Geometry::GroupSize == 6 ? 8 : 6;
+        const auto load = [&]<typename Input>(std::int32_t last) {
+            [&]<int... Index>(std::integer_sequence<int, Index...>) {
+                ((Index < last ? load_small_t_i8<Geometry, Index + 1, Input>() : void()), ...);
+            }(std::make_integer_sequence<int, widest>{});
+        };
+        if (cached_input) {
+            load.template operator()<CausalCachedInput>(std::min(max_width, widest));
+            return;
+        }
+        load.template operator()<CausalAppendInput>(std::min(max_width, widest));
+        std::int32_t cached_width = 0;
+        for (std::int32_t width = 4; width <= std::min(max_width, 2 * widest); ++width) {
+            cached_width = std::max(cached_width,
+                causal_attention_parallel_tile_width(geometry, width, 1, storage));
+        }
+        load.template operator()<CausalCachedInput>(cached_width);
     });
 }
 
