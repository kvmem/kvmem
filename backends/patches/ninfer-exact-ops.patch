diff --git a/tests/ops/test_int4_value_exact.cu b/tests/ops/test_int4_value_exact.cu
new file mode 100644
--- /dev/null
+++ b/tests/ops/test_int4_value_exact.cu
@@ -0,0 +1,36 @@
+#include "ops/kv_cache/int8_g64_codec.cuh"
+#include <cuda_runtime.h>
+#include <cstdio>
+
+// Every finite nonnegative FP16 scale and every byte's two signed int4 codes. The independent
+// reference is an exact integer times the represented scale, rounded to FP16 once.
+__global__ void verify_int4(unsigned* failures) {
+    const unsigned item=blockIdx.x*blockDim.x+threadIdx.x;
+    if(item>=0x7c00u*256u)return;
+    const unsigned short bits=static_cast<unsigned short>(item/256u);
+    const __half scale=__ushort_as_half(bits);
+    const unsigned byte=item%256u;
+    const unsigned packed=byte*0x01010101u;
+    const int4 result=ninfer::ops::kv_cache_int4_dequant_f16x8_from(
+        reinterpret_cast<const std::uint8_t*>(&packed),scale);
+    const unsigned* words=reinterpret_cast<const unsigned*>(&result);
+    const int a=(byte&15u)>=8u?int(byte&15u)-16:int(byte&15u);
+    const int b=(byte>>4)>=8u?int(byte>>4)-16:int(byte>>4);
+    const unsigned expected=unsigned(__half_as_ushort(__float2half_rn(float(a)*__half2float(scale))))|
+        (unsigned(__half_as_ushort(__float2half_rn(float(b)*__half2float(scale))))<<16);
+    for(int i=0;i<4;++i)if(words[i]!=expected)atomicAdd(failures,1u);
+}
+int main(){
+    int devices=0;
+    if(cudaGetDeviceCount(&devices)!=cudaSuccess || devices==0)return 77;
+    unsigned* errors=nullptr;
+    if(cudaMallocManaged(&errors,sizeof(unsigned))!=cudaSuccess)return 1;
+    *errors=0;
+    verify_int4<<<(0x7c00u*256u+255u)/256u,256>>>(errors);
+    const auto status=cudaDeviceSynchronize();
+    const unsigned count=*errors;
+    cudaFree(errors);
+    std::printf("INT4 exact decode: %u mismatches over 8126464 scale/code pairs; CUDA %s\n",
+        count,cudaGetErrorString(status));
+    return status==cudaSuccess&&count==0?0:1;
+}
