+    // The caller has drained the model. No sampler, draft, or output token was
+    // issued for this probe, and no other sequence shares this prefill step.
+    s.entry=-1;s.sched_tokens=0;step_open_=false;step_prefill_tok_=step_decode_tok_=0;
