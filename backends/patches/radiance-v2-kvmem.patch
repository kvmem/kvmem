+                      status==RAD_E_IO ? "KVMem backing storage failed for this request" : "KVMem shared cache capacity is exhausted for this request");
+        ++m_.failed;completed_.push_back(id);
+    }
+    sweep_deferred();return RAD_OK;
+}
