+}
+
+int KVManager::restore_full_tables(uint64_t id, int64_t expected, int64_t frontier,
+                                   int64_t visible, const std::vector<FullTable>& tables) {
+    const Seq* s = find(id);
+    if (!s || !s->canonical || expected < 0 || expected > 1 || frontier <= expected) return RAD_E_STATE;
+    return replace_full_tables(id, expected, frontier, visible, tables, true);
+}
+
+int KVManager::replace_full_tables(uint64_t id, int64_t expected, int64_t frontier,
+                                   int64_t visible, const std::vector<FullTable>& tables, bool restoring) {
+    Seq* s = find(id);
+    if (!s) return RAD_E_NOTFOUND;
+    if (expected != s->n_tokens || (!restoring && frontier > expected) || frontier < 0 || visible < 0 || visible > frontier)
+        return RAD_E_STATE;
+    for (const auto& w : s->win) if (w.set) return RAD_E_UNSUPPORTED;
+    // Copy and validate before changing any reference count or sequence table.
+    // The offset only maps the new contiguous tail; the adapter owns historical
+    // positions and must prove partial-tail identity before asking to publish.
+    auto next = tables;
+    std::vector<bool> seen(plans_.size(), false);
+    const int64_t offset = frontier - visible;
+    for (const auto& t : next) {
+        const KVGroupPlan* p = plan(t.group);
+        if (!p || p->kind != RAD_KV_FULL || seen[(size_t)t.group] ||
+            p->block_size <= 0 || offset % p->block_size ||
+            (int64_t)t.blocks.size() != ceil_div(visible, p->block_size)) return RAD_E_INVAL;
+        seen[(size_t)t.group] = true;
+        std::set<int32_t> unique;
+        for (auto b : t.blocks) {
+            if (b < 0 || b >= live_blocks(t.group) ||
+                refcount_[(size_t)t.group][(size_t)b] <= 0 || !unique.insert(b).second)
+                return RAD_E_INVAL;
+        }
+    }
+    bool any = false;
+    for (const auto& p : plans_) {
+        if (p.kind == RAD_KV_FULL) {
+            if (!seen[(size_t)p.index]) return RAD_E_INVAL;
+            any = true;
+        }
+    }
+    if (!any) return RAD_E_UNSUPPORTED;
+    // reserve_specific_block leaves stale heap entries behind. The free heap can
+    // therefore exceed n_blocks when old pages are released: reserve its actual
+    // worst-case growth BEFORE changing tables, so bad_alloc cannot half-publish.
+    for (const auto& t : next) {
+        auto& free = free_blocks_[(size_t)t.group];
+        free.reserve(free.size() + s->blocks[(size_t)t.group].size());
+    }
+    // Rolling windows are never in the sparse full-attention view. At the
+    // same frontier they stay untouched. A rewind/resume invalidates their
+    // old timeline; the native drafter refills from the resumed frontier and
+    // its coverage gate declines proposals until its own window is available.
+    const bool reset_windows = restoring || frontier != expected;
+    const bool has_windows = std::any_of(plans_.begin(), plans_.end(), [](const auto& p) { return p.kind == RAD_KV_WINDOW; });
+    if (reset_windows && has_windows && s->window_epoch == UINT64_MAX) return RAD_E_STATE;
+    if (reset_windows) for (const auto& p : plans_) if (p.kind == RAD_KV_WINDOW) {
+        auto& free = free_blocks_[(size_t)p.index];
+        free.reserve(free.size() + s->blocks[(size_t)p.index].size());
+    }
+    // No allocations/fallible operations after this point. References to retained
+    // pages are taken before old references are dropped, including identical IDs.
+    for (auto& t : next) {
+        for (auto b : t.blocks) add_ref((size_t)t.group, b);
+        s->blocks[(size_t)t.group].swap(t.blocks);
+        for (auto b : t.blocks) drop_block(t.group, b);
+        s->dirty_from[(size_t)t.group] = 0;
+    }
+    if (reset_windows) for (const auto& p : plans_) if (p.kind == RAD_KV_WINDOW) {
+        for (auto b : s->blocks[(size_t)p.index]) drop_block(p.index, b);
+        s->blocks[(size_t)p.index].clear();
+        s->first_block_pos[(size_t)p.index] = frontier / p.block_size * p.block_size;
+        s->dirty_from[(size_t)p.index] = 0;
+    }
+    if (reset_windows && has_windows) {
+        ++s->window_epoch;
+        s->window_floor = frontier;
+    }
+    s->full_offset = offset;
+    s->sparse_anchor = frontier;
+    s->n_tokens = frontier;
+    s->canonical = !restoring && s->canonical && offset == 0;
+    return RAD_OK;
+}
