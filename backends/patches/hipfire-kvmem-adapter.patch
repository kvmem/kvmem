+
+    pub fn mean_k_tokens(&self, block: u32, il: u32) -> u32 {
+        unsafe { ffi::hk_raw_store_mean_k_tokens(self.ptr.as_ptr(), block, il) }
+    }
+
+    pub fn n_tokens(&self, block: u32) -> u32 {
+        unsafe { ffi::hk_raw_store_n_tokens(self.ptr.as_ptr(), block) }
+    }
