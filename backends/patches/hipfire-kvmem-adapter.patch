+/// GQA score aggregation for [`mean_key_retrieval_scores`] (Mean = 0, Max = 1).
+#[derive(Debug, Clone, Copy, PartialEq, Eq)]
+pub enum GqaAggregation {
+    Mean,
+    Max,
+}
+
+impl GqaAggregation {
+    fn as_u32(self) -> u32 {
+        match self {
+            GqaAggregation::Mean => 0,
+            GqaAggregation::Max => 1,
+        }
+    }
+}
