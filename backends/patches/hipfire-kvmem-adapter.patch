+/// Block repository + working-set selection for one engine sequence.
+pub struct KvStore {
+    ptr: NonNull<HkKvStore>,
+}
+
+impl KvStore {
+    pub fn new(cfg: &KvStoreConfig) -> Result<Self> {
+        clear_error();
+        let ptr = unsafe { ffi::hk_kv_store_create(cfg) };
+        NonNull::new(ptr)
+            .map(|ptr| Self { ptr })
+            .ok_or_else(err_from_last)
+    }
+
+    pub fn register_append(&self, n_new_tokens: u32) -> Result<()> {
+        let p = self.ptr.as_ptr();
+        checked(|| unsafe { ffi::hk_kv_store_register_append(p, n_new_tokens) })
+    }
+
+    pub fn truncate_to(&self, token_pos: u32) -> Result<()> {
+        let p = self.ptr.as_ptr();
+        checked(|| unsafe { ffi::hk_kv_store_truncate_to(p, token_pos) })
+    }
+
+    pub fn block_count(&self) -> u32 {
+        unsafe { ffi::hk_kv_store_block_count(self.ptr.as_ptr()) }
+    }
+
+    pub fn total_tokens(&self) -> u32 {
+        unsafe { ffi::hk_kv_store_total_tokens(self.ptr.as_ptr()) }
+    }
+
+    pub fn select_budget_tokens(&self) -> u32 {
+        unsafe { ffi::hk_kv_store_select_budget_tokens(self.ptr.as_ptr()) }
+    }
+
+    pub fn set_runtime_select_budget(&self, tokens: u32) -> Result<()> {
+        let p = self.ptr.as_ptr();
+        checked(|| unsafe { ffi::hk_kv_store_set_runtime_select_budget(p, tokens) })
+    }
+
+    pub fn pick_topk_blocks(&self, mandatory: &[u32]) -> Result<Vec<u32>> {
+        let p = self.ptr.as_ptr();
+        pick(|out, cap| unsafe {
+            ffi::hk_kv_store_pick_topk_blocks(p, mandatory.as_ptr(), mandatory.len() as u32, out, cap)
+        })
+    }
+
+    pub fn pick_prefill_pressure_blocks(&self, mandatory: &[u32]) -> Result<Vec<u32>> {
+        let p = self.ptr.as_ptr();
+        pick(|out, cap| unsafe {
+            ffi::hk_kv_store_pick_prefill_pressure_blocks(
+                p,
+                mandatory.as_ptr(),
+                mandatory.len() as u32,
+                out,
+                cap,
+            )
+        })
+    }
+
+    pub fn set_retrieval_scores(&self, scores: &[f64]) -> Result<()> {
+        let p = self.ptr.as_ptr();
+        checked(|| unsafe {
+            ffi::hk_kv_store_set_retrieval_scores(p, scores.as_ptr(), scores.len() as u32)
+        })
+    }
+
+    pub fn prefill_needs_offload(
+        &self,
+        resident_tokens: u32,
+        incoming_tokens: u32,
+        pool_tokens: u32,
+    ) -> bool {
+        unsafe {
+            ffi::hk_kv_store_prefill_needs_offload(
+                self.ptr.as_ptr(),
+                resident_tokens,
+                incoming_tokens,
+                pool_tokens,
+            ) != 0
+        }
+    }
+
+    pub fn gpu_high_watermark_tokens(&self, pool_tokens: u32) -> u32 {
+        unsafe { ffi::hk_kv_store_gpu_high_watermark_tokens(self.ptr.as_ptr(), pool_tokens) }
+    }
+
+    pub fn gpu_low_watermark_tokens(&self, pool_tokens: u32) -> u32 {
+        unsafe { ffi::hk_kv_store_gpu_low_watermark_tokens(self.ptr.as_ptr(), pool_tokens) }
+    }
+
+    pub fn allocated_bytes(&self) -> u64 {
+        unsafe { ffi::hk_kv_store_allocated_bytes(self.ptr.as_ptr()) }
+    }
+}
+
+impl Drop for KvStore {
+    fn drop(&mut self) {
+        unsafe { ffi::hk_kv_store_destroy(self.ptr.as_ptr()) };
+    }
+}
+
+/// Two-call selection helper: `pick` writes the required count on out=NULL.
+fn pick(mut f: impl FnMut(*mut u32, u32) -> u32) -> Result<Vec<u32>> {
+    clear_error();
+    let needed = f(ptr::null_mut(), 0);
+    if needed == u32::MAX {
+        return Err(err_from_last());
+    }
+    if needed == 0 {
+        return match last_error() {
+            None => Ok(Vec::new()),
+            Some(e) => Err(KvMemError(e)),
+        };
+    }
+    let mut ids = vec![0u32; needed as usize];
+    clear_error();
+    let written = f(ids.as_mut_ptr(), needed);
+    if written != needed {
+        return Err(KvMemError(format!(
+            "selection count changed between calls ({needed} -> {written})"
+        )));
+    }
+    if let Some(e) = last_error() {
+        return Err(KvMemError(e));
+    }
+    Ok(ids)
+}
+
+/// Score every historical block against a post-RMSNorm/pre-RoPE query sum.
+///
+/// `sums` is `layers * query_heads * head_dim` FP32 elements (layer-major);
+/// `token_counts` has one entry per layer and must match the store's
+/// `n_layer`. Returns one score per block.
+pub fn mean_key_retrieval_scores(
+    keys: &RawStore,
+    blocks: u32,
+    sums: &[f32],
+    token_counts: &[u32],
+    layers: u32,
+    head_dim: u32,
+    query_heads: u32,
+    kv_heads: u32,
+    aggregation: GqaAggregation,
+) -> Result<Vec<f64>> {
+    let need = layers as usize * query_heads as usize * head_dim as usize;
+    if sums.len() < need {
+        return Err(KvMemError(format!(
+            "query sums too short: {} < {need}",
+            sums.len()
+        )));
+    }
+    if token_counts.len() < layers as usize {
+        return Err(KvMemError(format!(
+            "token_counts too short: {} < {layers}",
+            token_counts.len()
+        )));
+    }
+    let mut out = vec![0.0f64; blocks as usize];
+    clear_error();
+    let rc = unsafe {
+        ffi::hk_mean_key_retrieval_scores(
+            keys.ptr.as_ptr(),
+            blocks,
+            sums.as_ptr(),
+            token_counts.as_ptr(),
+            layers,
+            head_dim,
+            query_heads,
+            kv_heads,
+            aggregation.as_u32(),
+            out.as_mut_ptr(),
+        )
+    };
+    if rc != 0 {
+        return Err(err_from_last());
+    }
+    Ok(out)
+}
diff --git a/crates/hipfire-kvmem/tests/shim_smoke.rs b/crates/hipfire-kvmem/tests/shim_smoke.rs
new file mode 100644
index 000000000..efe2e147b
--- /dev/null
+++ b/crates/hipfire-kvmem/tests/shim_smoke.rs
@@ -0,0 +1,180 @@
+// SPDX-License-Identifier: Apache-2.0
+// Copyright (c) 2026 Kaden Schutt
+// hipfire — see LICENSE and NOTICE in the project root.
+
+//! Host-only smoke test for the KVMem C ABI adapter: no GPU, no model.
+//!
+//! Exercises the exact contracts the serve controller relies on: mean-K
+//! statistics, packed K/V spill + readback, block selection budgets, the
+//! retrieval scorer and truncation checkpoints.
+
+use hipfire_kvmem::{
+    mean_key_retrieval_scores, GqaAggregation, KvStore, KvStoreConfig, RawStore, RawStoreConfig,
+    Storage,
+};
+
+const BLOCK: u32 = 4;
+const K_WIDTH: usize = 8;
+const ROW_BYTES: usize = 36; // opaque packed row; contents only round-trip
+const LAYERS: u32 = 2;
+
+fn raw_config() -> RawStoreConfig {
+    RawStoreConfig {
+        n_layer: LAYERS,
+        n_embd_k: K_WIDTH as u32,
+        n_embd_v: K_WIDTH as u32,
+        block_tokens: BLOCK,
+        k_row_bytes: 0,
+        k_gpu_row_bytes: ROW_BYTES as u64,
+        v_gpu_row_bytes: ROW_BYTES as u64,
+    }
+}
+
+fn kv_config(budget_tokens: u32) -> KvStoreConfig {
+    KvStoreConfig {
+        block_tokens: BLOCK,
+        select_budget: budget_tokens,
+        sink_blocks: 1,
+        recent_blocks: 1,
+        ..KvStoreConfig::default()
+    }
+}
+
+fn pack_row(seed: u8) -> [u8; ROW_BYTES] {
+    let mut row = [0u8; ROW_BYTES];
+    for (i, b) in row.iter_mut().enumerate() {
+        *b = seed.wrapping_add(i as u8).wrapping_mul(3);
+    }
+    row
+}
+
+#[test]
+fn statistics_packed_roundtrip_and_selection() {
+    let storage = Storage::new_ram(1 << 30).expect("storage");
+    assert_eq!(storage.charged_bytes(), 0);
+
+    let raw = RawStore::new(raw_config(), Some(&storage)).expect("raw store");
+
+    // ── Mean-K statistics: 4 tokens of layer 0 ──
+    let mut k = Vec::with_capacity(BLOCK as usize * K_WIDTH);
+    for t in 0..BLOCK as usize {
+        for d in 0..K_WIDTH {
+            k.push((t * K_WIDTH + d) as f32);
+        }
+    }
+    raw.write_layer_mean_k(0, BLOCK, 0, &k).expect("mean k");
+    assert_eq!(raw.mean_k_tokens(0, 0), BLOCK);
+    let mut mean = vec![f32::NAN; K_WIDTH];
+    raw.mean_k(0, 0, &mut mean);
+    for (d, m) in mean.iter().enumerate() {
+        let expect = (0..BLOCK as usize).map(|t| (t * K_WIDTH + d) as f32).sum::<f32>()
+            / BLOCK as f32;
+        assert!((m - expect).abs() < 1e-6, "dim {d}: {m} vs {expect}");
+    }
+
+    // ── Packed Q8 spill + readback, all layers of block 1 ──
+    for il in 0..LAYERS {
+        let mut rows = Vec::new();
+        for t in 0..BLOCK {
+            rows.extend_from_slice(&pack_row((il as u8 + 1) * 10 + t as u8));
+        }
+        raw.write_layer_k_gpu(BLOCK, BLOCK, il, &rows).expect("spill k");
+        raw.write_layer_v_gpu(BLOCK, BLOCK, il, &rows).expect("spill v");
+    }
+    for il in 0..LAYERS {
+        assert!(raw.has_k_gpu(1, il, BLOCK));
+        assert!(raw.has_v_gpu(1, il, BLOCK));
+        let mut out = vec![0u8; BLOCK as usize * ROW_BYTES];
+        assert!(raw.copy_k_gpu(1, il, &mut out, BLOCK));
+        for t in 0..BLOCK as usize {
+            assert_eq!(&out[t * ROW_BYTES..(t + 1) * ROW_BYTES],
+                       &pack_row((il as u8 + 1) * 10 + t as u8));
+        }
+    }
+
+    // ── Block repository: 12 tokens = 3 blocks ──
+    let kv = KvStore::new(&kv_config(2 * BLOCK)).expect("kv store");
+    kv.register_append(12).expect("append");
+    assert_eq!(kv.block_count(), 3);
+    assert_eq!(kv.total_tokens(), 12);
+
+    // Sink (block 0) + newest block under a 2-block budget.
+    let picked = kv.pick_prefill_pressure_blocks(&[]).expect("pressure pick");
+    assert_eq!(picked, vec![0, 2], "pressure selection keeps sink + newest");
+
+    // ── Retrieval scorer: query aligned with block 1's mean key ──
+    // Put layer-0/1 statistics on every block so has_block() is true.
+    for block in 0..3u32 {
+        for il in 0..LAYERS {
+            let pos = block * BLOCK;
+            let rows: Vec<f32> = (0..BLOCK as usize * K_WIDTH)
+                .map(|i| if block == 1 { 1.0 } else { 0.0 } + i as f32 * 0.0)
+                .collect();
+            raw.write_layer_mean_k(pos, BLOCK, il, &rows).expect("mean k");
+        }
+    }
+    let sums = vec![1.0f32; LAYERS as usize * K_WIDTH];
+    let counts = vec![BLOCK; LAYERS as usize];
+    let scores = mean_key_retrieval_scores(
+        &raw,
+        3,
+        &sums,
+        &counts,
+        LAYERS,
+        K_WIDTH as u32,
+        1,
+        1,
+        GqaAggregation::Mean,
+    )
+    .expect("scores");
+    assert_eq!(scores.len(), 3);
+    assert!(scores[1] > scores[2], "aligned block should win: {scores:?}");
+
+    // Bad geometry is an error, not a silent zero.
+    assert!(mean_key_retrieval_scores(
+        &raw,
+        3,
+        &sums,
+        &counts,
+        LAYERS,
+        K_WIDTH as u32 + 1,
+        1,
+        1,
+        GqaAggregation::Mean,
+    )
+    .is_err());
+
+    // ── Truncation: drop 2 partial tokens of the trailing block ──
+    assert_eq!(raw.n_tokens(1), BLOCK);
+    raw.truncate_to(10).expect("truncate raw");
+    assert_eq!(raw.n_tokens(1), BLOCK); // block 1 untouched (full)
+    kv.truncate_to(10).expect("truncate kv");
+    assert_eq!(kv.total_tokens(), 10);
+    assert_eq!(kv.block_count(), 3);
+
+    // Checkpoint of a partial tail: block 2 keeps only 2 of its 4 written
+    // tokens, so truncate_to cleared its statistics...
+    let stride = 1 + K_WIDTH;
+    let mut ckpt = raw
+        .mean_checkpoint(10)
+        .expect("checkpoint query")
+        .expect("block-aligned position still has a state vector");
+    assert_eq!(ckpt.len(), LAYERS as usize * stride);
+    for il in 0..LAYERS as usize {
+        assert_eq!(ckpt[il * stride], 0.0, "tail statistics must be cleared");
+    }
+
+    // ...and restoring a saved checkpoint reinstates the partial tail.
+    // Checkpoint layout is count + SUM per layer, so 1.0 over 2 tokens = 0.5.
+    for il in 0..LAYERS as usize {
+        ckpt[il * stride] = 2.0;
+        for d in 0..K_WIDTH {
+            ckpt[il * stride + 1 + d] = 1.0;
+        }
+    }
+    raw.restore_mean_checkpoint(10, &ckpt).expect("restore");
+    assert_eq!(raw.mean_k_tokens(2, 0), 2);
+    let mut restored = vec![f32::NAN; K_WIDTH];
+    raw.mean_k(2, 0, &mut restored);
+    assert!(restored.iter().all(|v| (*v - 0.5).abs() < 1e-6));
+}
