# Draft projections only. Generated from checkpoint text_config.
# Native libquant/libr4d recipe; requires rad-convert --plan-only first.
# Target weights, BF16 mtp.fc, norms and existing U2 draft head are unchanged.
blk.64.attn_qg.weight rtn codes=fp4_e2m1 group=32 scale=e8m0
blk.64.attn_k.weight rtn codes=fp4_e2m1 group=32 scale=e8m0
blk.64.attn_v.weight rtn codes=fp4_e2m1 group=32 scale=e8m0
blk.64.attn_output.weight rtn codes=fp4_e2m1 group=32 scale=e8m0
blk.64.ffn_gate_up.weight rtn codes=fp4_e2m1 group=32 scale=e8m0
blk.64.ffn_down.weight rtn codes=fp4_e2m1 group=32 scale=e8m0

# Original target/output/draft-head rules follow unchanged.
# Target rules from StillDeadcode/Radiance's q38-27b-quark-mxfp4-df2.recipe.
# Preserve AMD MXFP4 target linear payloads; only native output/SSM conversion.
blk.*.ssm_ab.weight cast dtype=bf16
output.weight rtn codes=fp8_e4m3 block=128x128 scale=bf16

# Native MTP draft-head rule from upstream q36-35b-a3b-fp8.recipe.
# Dedicated draft output head remains U2; the six projections above are MXFP4.
mtp.draft_head.weight rtn codes=u2 zero=u8 group=128 scale=f16
