{
  "description": "Radiance v2 RX7800M 12GiB IQ2R text profile; TP1/C1, BF16 KV, bounded Query/Pressure, optional embedded DFlash2.",
  "default_drafter": "off",
  "max_draft_tokens": 7,
  "allowed_drafters": ["off", "dflash2"],
  "drafter_overrides": {
    "dflash2": {"--kvmem-budget": 3072, "--kvmem-recent-tokens": 2176}
  },
  "architecture_plugins": ["qwen35_w8a8"],
  "kernel_plugins": ["libr3diqr", "libr3d"],
  "arguments": [
    "--kernels", "libr3diqr,libr3d",
    "--tp", "1", "--max-num-seqs", "1", "--max-model-len", "8192",
    "--max-num-batched-tokens", "256", "--gpu-headroom-mib", "160",
    "--kv-cache-dtype", "bf16", "--state-cache-dtype", "f32",
    "--num-speculative-tokens", "0", "--mm-max-patches", "0",
    "--no-prefix-cache", "--prefix-cache-mib", "0", "--deterministic",
    "--kvmem-budget", "1024", "--kvmem-block-tokens", "128",
    "--kvmem-replay-tokens", "512", "--kvmem-query-tokens", "256",
    "--kvmem-query-replay-tokens", "512", "--kvmem-host-mib", "2048",
    "--kvmem-sink-tokens", "128", "--kvmem-recent-tokens", "256",
    "--kvmem-rolling-generation"
  ],
  "environment": {"KVMEM_CAPTURE_EARLY_SEAL": "1", "OMP_NUM_THREADS": "2"},
  "environment_reset": []
}
