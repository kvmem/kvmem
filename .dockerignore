# Build-context filter for the KVMem NInfer image (Dockerfile).
# Sources must be prepared on the host first: python3 scripts/prepare-backends.py --backend ninfer

# The Dockerfile itself is not source; excluding it keeps Dockerfile edits from invalidating
# the COPY layer (and therefore the whole compilation) on the next build.
Dockerfile
.dockerignore

# Git metadata and submodule pointers are not needed: compilation uses the prepared work tree.
.git
.gitmodules
**/.git
**/.gitignore

# Local build trees, toolchains and test artifacts.
/build*/
/build-ui*/
/dist/
/artifacts/
/results/
/.venv/
/.tools/
/workers/
/ui/node_modules/
**/__pycache__/
*.pyc
*.log

# Weights and local sessions never belong in the image.
*.ninfer
*.gguf
*.safetensors
*.nkm

# Docs are not build inputs (the image gets the README only); keeping them out means a
# documentation edit does not invalidate the COPY layer and rebuild the engine.
/docs/
